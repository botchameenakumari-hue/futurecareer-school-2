# Normalize line endings for text files so editors/tools on different OSes
# (and different tools within the same session) stop producing huge diffs
# that are purely CRLF vs LF, not real content changes.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
