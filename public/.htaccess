RewriteEngine On

# Serve the branded 404 page (built by src/pages/404.astro) with a real 404 status,
# instead of falling back to Apache's generic default error page.
ErrorDocument 404 /404.html

# Compress text assets when Apache exposes mod_deflate.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Astro fingerprints files in /_astro/, so those assets are safe to cache immutably.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_astro/" astro_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=astro_asset

  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Consolidate alternate brand-domain traffic into the canonical .com domain.
RewriteCond %{HTTP_HOST} ^(www\.)?futurecareerschool\.in$ [NC]
RewriteRule ^ https://futurecareerschool.com%{REQUEST_URI} [R=301,L]

# Canonicalize the primary production host.
RewriteCond %{HTTP_HOST} ^www\.futurecareerschool\.com$ [NC]
RewriteRule ^ https://futurecareerschool.com%{REQUEST_URI} [R=301,L]

# Force HTTPS on the canonical host.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?futurecareerschool\.com$ [NC]
RewriteRule ^ https://futurecareerschool.com%{REQUEST_URI} [R=301,L]

# Retired route kept for inbound links and old bookmarks.
RewriteRule ^topics-index/?$ /career-resources/ [R=301,L]
RewriteRule ^topics-index\.html$ /career-resources/ [R=301,L]

# Consolidated assessment keyword URLs. Keep these as one-hop permanent redirects.
