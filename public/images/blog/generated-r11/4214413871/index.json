            "needId": "checklist:3",
            "type": "checklist",
            "heading": "What to Leave Out",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Exact tools the post names, if you have used them (Excel, Tally, SQL, Figma, AutoCAD)."
              },
              {
                "heading": "",
                "text": "Working methods tied to an output (data cleaning, reconciliation, technical drawing, copywriting)."
              },
              {
                "heading": "",
                "text": "Languages you can actually work in, with an honest level in words."
              },
              {
                "heading": "",
                "text": "One or two soft skills only where an example sits elsewhere on the page."
              }
            ],
            "sourceSectionId": "list-or-leave",
