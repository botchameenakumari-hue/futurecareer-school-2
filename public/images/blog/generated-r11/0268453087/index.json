      "content": {
        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "Retail management careers run from store operations and visual merchandising to category management, supply planning and e-commerce operations, and they reward people who can read daily sales, manage a team on their feet and keep stock, service and cost in balance."
          },
          {
            "heading": "",
            "text": "Start in a store or a fulfilment role, learn how sales, stock and staffing connect, then move toward area, category or planning roles."
          },
          {
            "heading": "",
            "text": "Ask for written terms before accepting a role."
          }
        ]
      },
      "type": "proof",
      "title": "Course Fees and the 10 Percent Test"
