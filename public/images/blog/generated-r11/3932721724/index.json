        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "It is not the same exam as NEET, even though both PCB students sit a biology-heavy paper."
              },
              {
                "heading": "",
                "text": "It is not one single exam covering every health and science course, nursing runs on its own separate CET."
              }
            ],
            "sourceSectionId": "what-is-cet",
            "sourceNeedIndex": 1
          },
          {
            "needId": "chain:3",
            "type": "chain",
            "heading": "Sequence to Try",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "BSc Nursing."
              },
              {
                "heading": "",
                "text": "D.Pharm (Diploma in Pharmacy)."
              },
              {
                "heading": "",
                "text": "BAMS, BHMS, BUMS (AYUSH courses)."
              },
              {
                "heading": "",
                "text": "MBBS and BDS."
              },
              {
                "heading": "",
                "text": "BPT and most allied-health diplomas."
              }
            ],
            "sourceSectionId": "not-admit",
            "sourceNeedIndex": 3
          },
          {
            "needId": "checklist:5",
            "type": "checklist",
            "heading": "One National Exam 720",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "One national exam, 720 marks, negative marking on every wrong answer."
              },
              {
                "heading": "",
                "text": "Opens MBBS, BDS, and AYUSH courses across the whole country."
              },
              {
                "heading": "",
                "text": "A single all-India rank drives admission almost everywhere."
              },
              {
                "heading": "",
                "text": "Very high stakes per question; one bad guess costs you real rank."
              }
            ],
            "sourceSectionId": "cet-vs-neet",
            "sourceNeedIndex": 5
          },
          {
            "needId": "chain:7",
            "type": "chain",
            "heading": "CET Registration to an Actual Admitted Seat",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Register on the official CET Cell portal during the January-February window."
              },
              {
                "heading": "",
                "text": "Sit the PCB paper in the April exam window."
              },
              {
                "heading": "",
                "text": "Wait for the result and your percentile, not a raw score."
              },
              {
                "heading": "",
                "text": "Register for CAP (Centralised Admission Process) and fill your choices."
              },
              {
                "heading": "",
                "text": "Work through the CAP rounds and confirm your seat."
              }
            ],
            "sourceSectionId": "process",
            "sourceNeedIndex": 7
          },
          {
            "needId": "checklist:8",
            "type": "checklist",
            "heading": "Actually Choose the MHT-CET PCB Route",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Your actual interest is medicines, farming systems, food science, or lab biology, not treating patients."
              },
              {
                "heading": "",
                "text": "You live in or plan to study in Maharashtra, where the state-quota advantage, lower government-aided fees, and the sheer number of seats work in your favour."
              },
              {
                "heading": "",
                "text": "You want a lower-stakes, no-negative-marking exam rather than betting everything on a single national rank."
              }
            ],
            "sourceSectionId": "fit",
            "sourceNeedIndex": 8
          },
          {
            "needId": "checklist:10",
            "type": "checklist",
            "heading": "Applying to MHT-CET From Outside Maharashtra",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "The exam itself, no domicile requirement to register and appear."
              },
              {
                "heading": "",
                "text": "The All India Quota share of seats at participating colleges."
              },
              {
                "heading": "",
                "text": "Any vacant seats released in later CAP rounds after Maharashtra-domicile candidates are allotted."
              }
            ],
            "sourceSectionId": "outside-state",
            "sourceNeedIndex": 10
          }
        ]
      },
