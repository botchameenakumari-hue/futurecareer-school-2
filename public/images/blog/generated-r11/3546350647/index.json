      "file": "is-petroleum-engineering-a-good-career-in-india-checklist.webp",
      "mobile": "is-petroleum-engineering-a-good-career-in-india-checklist-mobile.webp",
      "alt": "Decision checklist for Is Petroleum Engineering.",
      "caption": "Questions to use before deciding.",
      "heading": "Who Should Skip",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 4,
        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "Is Petroleum Engineering",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "You like modelling, physics and data, and want subsurface or wells work specifically."
              },
              {
                "heading": "",
                "text": "You can win a seat at a strong, low-cost institute, or you can pick mechanical or chemical and still aim at ONGC through GATE."
              },
              {
                "heading": "",
                "text": "You accept remote postings and rotation-based work, and you will build a second skill outside oil."
              }
            ],
            "sourceSectionId": "short-answer",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:7",
            "type": "checklist",
            "heading": "Offshore and Field Life, and Safety",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Remote postings away from family and big cities."
              },
              {
                "heading": "",
                "text": "Shift and rotation schedules, and being on call during well problems."
              },
              {
                "heading": "",
                "text": "Strict medical standards (ONGC's notices require them) and safety training."
              },
              {
                "heading": "",
                "text": "Weather and sea conditions for offshore work."
              }
            ],
            "sourceSectionId": "field-life",
            "sourceNeedIndex": 7
          },
          {
            "needId": "checklist:9",
            "type": "checklist",
            "heading": "AI and the Digital Oilfield",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Routine log interpretation and report drafting."
              },
              {
                "heading": "",
                "text": "Manual monitoring of well data that sensors and software can watch."
              },
              {
                "heading": "",
                "text": "Fixed-recipe drilling parameter choices."
              }
            ],
            "sourceSectionId": "ai",
            "sourceNeedIndex": 9
          },
          {
            "needId": "checklist:11",
            "type": "checklist",
            "heading": "How They Find and Trust You: Referrals",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "First skill worth learning: positioning."
              },
              {
                "heading": "",
                "text": "Then: a simple offer (one clear deliverable and a price), follow-up after every project, and a polite ask for an introduction."
              },
              {
                "heading": "",
                "text": "One number to watch: how many technical conversations turn into a paid first project."
              }
            ],
            "sourceSectionId": "business-layer",
            "sourceNeedIndex": 11
          }
        ]
      },
      "type": "checklist",
      "title": "Who Should Skip"
    },
