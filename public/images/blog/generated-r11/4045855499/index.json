        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "Goal-setting skills mean turning a vague wish into a clear outcome, breaking it into steps you can act on, reviewing progress honestly and adjusting when facts change, and the habit shows in results you can describe rather than in a list of ambitions."
          },
          {
            "heading": "",
            "text": "Write one outcome, define the next three actions, review on a fixed day and adjust without drama."
          },
          {
            "heading": "",
            "text": "Treat targets as plans to test and review them against facts."
          }
        ]
      },
      "type": "proof",
