            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "CUET UG for BSc life sciences at central universities, and the ICAR route into agriculture degrees."
              },
              {
                "heading": "",
                "text": "IISER Aptitude Test for the five-year BS-MS science programmes."
              },
              {
                "heading": "",
                "text": "Every BSc, BA, BCom, BBA, law and design route that has no stream rule at all."
              }
            ],
            "sourceSectionId": "not-a-career",
            "sourceNeedIndex": 1
          },
          {
            "needId": "chain:11",
            "type": "chain",
            "heading": "Ask for the Approval",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Ask for the approval, not the brochure."
              },
              {
                "heading": "",
                "text": "Do the total-cost sum for every year."
              },
              {
                "heading": "",
                "text": "Keep one backup running in parallel."
              },
              {
                "heading": "",
                "text": "Let the student describe the daily work."
              }
            ],
            "sourceSectionId": "parents",
            "sourceNeedIndex": 11
          },
          {
            "needId": "chain:12",
            "type": "chain",
            "heading": "First Short Test",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Pick two lanes, not five."
              },
              {
                "heading": "",
                "text": "Read the real eligibility page for each."
              },
              {
                "heading": "",
                "text": "See the work once."
              },
              {
                "heading": "",
                "text": "Make one small proof piece per lane."
              },
              {
                "heading": "",
                "text": "Decide, write it down and tell your family."
              }
