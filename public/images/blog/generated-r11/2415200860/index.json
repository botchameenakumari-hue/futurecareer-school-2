        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "IoT and embedded systems careers reward people who can program a microcontroller in C, read a datasheet, connect sensors and communication modules, debug hardware and software together and show a working device with documentation."
          },
          {
            "heading": "",
            "text": "Learn C, one microcontroller family, basic electronics and one wireless protocol, then build two working devices with a clear write-up."
          },
          {
            "heading": "",
            "text": "Check datasheets and live notices for the platforms your target employers use."
          }
        ]
      },
