    {
      "file": "law-career-options-checklist.webp",
      "mobile": "law-career-options-checklist-mobile.webp",
      "alt": "Decision checklist for Law Career Options.",
      "caption": "Questions to use before deciding.",
      "heading": "Own Chambers or a Boutique Firm",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 4,
        "blocks": [
          {
            "needId": "checklist:6",
            "type": "checklist",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Pick one court or one practice area and become the name for it, instead of taking every brief."
              },
              {
                "heading": "",
                "text": "Turn repeat work (notices, agreements, filings, compliance checks) into fixed-fee packages with a written scope, so you quote once and deliver faster each time."
              },
              {
                "heading": "",
                "text": "Write down how you do each recurring task as a short checklist."
              },
              {
                "heading": "",
                "text": "Take a deposit or part payment on larger engagements, price change requests separately, and keep business money apart from personal money."
              },
              {
                "heading": "",
                "text": "Check current GST, tax and registration rules for professional services on the official portals."
              },
              {
                "heading": "",
                "text": "Do not depend on one senior, one platform or one client for all your work."
              }
            ],
            "sourceSectionId": "own-practice",
            "sourceNeedIndex": 6
          },
          {
            "needId": "checklist:7",
            "type": "checklist",
            "heading": "Bar Council Rules on Advertising and Jobs",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Soliciting work or advertising, directly or indirectly, through circulars, advertisements, touts or interviews not warranted by personal relations."
              },
              {
                "heading": "",
                "text": "Sign-boards, name-plates or stationery that claim a specialisation, a past Bar Council post or a judgeship."
              },
              {
                "heading": "",
                "text": "Photographs in connection with cases you handled."
              },
              {
                "heading": "",
                "text": "Promotional videos, social media campaigns and influencer or celebrity endorsements."
              }
            ],
            "sourceSectionId": "bar-council-rules",
            "sourceNeedIndex": 7
          },
          {
            "needId": "checklist:9",
            "type": "checklist",
            "heading": "What AI Changes, Route By Route",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Use AI for first drafts, summaries and a search starting point, then check every citation and clause yourself."
              },
              {
                "heading": "",
                "text": "Never paste client documents into a tool without checking how it stores data, because client confidentiality is a professional duty."
              },
              {
                "heading": "",
                "text": "Keep a short log of what the tool got wrong."
              }
            ],
            "sourceSectionId": "ai-by-route",
            "sourceNeedIndex": 9
          },
