        "blocks": [
          {
            "type": "summary",
            "heading": "Key ideas from this article",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Most \"career options\" lists name the same jobs and stop."
              },
              {
                "heading": "",
                "text": "Your stage decides your next legal entry requirement."
              },
              {
                "heading": "",
                "text": "Almost every route has a second filter hiding behind the first."
              }
            ]
          },
          {
            "needId": "detail:4",
            "type": "detail",
            "heading": "Lot of Advice Online Still Repeats",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "For many years a fresh law graduate could sit the Civil Judge exam straight out of college in most states."
              },
              {
                "heading": "",
                "text": "In All India Judges Association v."
              }
            ],
            "sourceSectionId": "judiciary-change",
            "sourceNeedIndex": 4
          },
          {
            "needId": "detail:12",
            "type": "detail",
            "heading": "Pick Your Route with the Four Questions",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Run each shortlisted route through the four questions: your fit, your situation, the job market and AI-proofing."
              },
              {
                "heading": "",
                "text": "Court days start early, include long waiting and need stamina."
              },
              {
                "heading": "",
                "text": "If long waiting and standing drain you, test a desk route before you commit years to chambers."
              }
            ],
            "sourceSectionId": "checkpoint",
            "sourceNeedIndex": 12
          },
          {
            "needId": "detail:13",
            "type": "detail",
            "heading": "Pass Three Proofs Before You Commit",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "The four questions says whether a route fits on paper."
              },
              {
                "heading": "",
                "text": "Do not lock in an LLM, a coaching fee or a chamber before passing all three proofs."
              },
              {
                "heading": "",
                "text": "Do one real task in the route: draft a legal notice, summarise a judgment for a layperson, write a one-page DPDP compliance checklist, or review one contract."
              }
            ],
            "sourceSectionId": "gates",
            "sourceNeedIndex": 13
          },
          {
            "needId": "detail:14",
            "type": "detail",
            "heading": "Expensive Wrong Turns",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Rule 49 says an advocate cannot be a full-time salaried employee and continue to practise."
              },
              {
                "heading": "",
                "text": "Rule 36 bans advertising and solicitation, and the Bar Council warned against social media promotion in March 2025."
              }
            ],
            "sourceSectionId": "mistakes",
            "sourceNeedIndex": 14
          }
        ]
      },
      "type": "summary",
      "title": "What Each Law Degree Stage Unlocks"
