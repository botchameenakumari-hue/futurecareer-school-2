      "content": {
        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "Becoming a judge in India usually follows two broad routes: entering the lower judiciary through a state judicial services examination after a law degree, or being appointed to higher courts after years of legal practice or service, and each route has its own official eligibility rules."
          },
          {
            "heading": "",
            "text": "Complete a recognised law degree, read the current notice of the state judicial service you want, prepare in stages and keep a legal practice or related career as backup."
          },
          {
            "heading": "",
            "text": "Use only the official notice of the high court or public service commission."
          }
        ]
      },
      "type": "proof",
      "title": "Course Fees and the 10 Percent Test"
