    {
      "file": "safe-career-options-for-girls-in-india-chain.webp",
      "mobile": "safe-career-options-for-girls-in-india-chain-mobile.webp",
      "alt": "Planning steps for Safe Career Options for Girls.",
      "caption": "Steps in the order they happen.",
      "heading": "Safe-Career Trap Nobody Names Out Loud",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 4,
        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "It Repeats \"Teaching, Nursing, Government Job\"",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "It skips the actual laws that protect you at work - so you cannot tell a genuinely protected employer from one that just sounds calm."
              },
              {
                "heading": "",
                "text": "It never mentions that \"safe\" fields often carry a lower pay ceiling as a direct trade-off, not a coincidence."
              },
              {
                "heading": "",
                "text": "It treats family approval as the only safety that matters, when income and legal protection matter just as much for your actual life."
              }
            ],
            "sourceSectionId": "why",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:5",
            "type": "checklist",
            "heading": "Safety 3: Commute and Physical Safety",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "56% of women report facing sexual harassment while travelling for work or study, and 52% say they have declined an education or employment opportunity specifically over commute safety."
              },
              {
                "heading": "",
                "text": "Public transport is flagged as a harassment hotspot in about 29% of reported cases - more than any single other setting."
              },
              {
                "heading": "",
                "text": "Roughly 40% of women in Indian cities report feeling unsafe generally, a number that rises sharply after dark."
              }
            ],
            "sourceSectionId": "physical",
            "sourceNeedIndex": 5
          },
          {
            "needId": "chain:6",
            "type": "chain",
            "heading": "\"Safe Field\" Ceiling",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "The \"safe field\" ceiling."
              },
              {
                "heading": "",
                "text": "The entry-door trap."
              },
              {
                "heading": "",
                "text": "The flexibility penalty."
              },
              {
                "heading": "",
                "text": "The mid-career cliff."
              },
              {
                "heading": "",
                "text": "The one-safety trap."
              },
              {
                "heading": "",
                "text": "Government, banking and civil-service exams can narrow choices."
              }
            ],
            "sourceSectionId": "trap",
            "sourceNeedIndex": 6
          },
          {
            "needId": "checklist:9",
            "type": "checklist",
            "heading": "Family Without It Turning Into a Fight",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Name the specific safety measure, not a vague reassurance: \"This bank branch has fixed 9-to-5 hours and no late shifts\" beats \"don't worry, it's fine.\""
              },
              {
                "heading": "",
                "text": "Bring the legal protection by name: mention the POSH Act and ask the employer directly whether their Internal Complaints Committee is active - families relax when they see you already checked."
              },
              {
                "heading": "",
                "text": "Separate the four safeties out loud, so your family sees you have actually audited the decision, not just picked a job you like."
              },
              {
                "heading": "",
                "text": "Offer one already-working local example - a woman in the extended family or community already doing this job safely."
              }
            ],
            "sourceSectionId": "script",
            "sourceNeedIndex": 9
          }
        ]
      },
      "type": "chain",
      "title": "Safe-Career Trap Nobody Names Out Loud"
    }
