    {
      "file": "iti-career-options-summary.webp",
      "mobile": "iti-career-options-summary-mobile.webp",
      "alt": "A short visual summary of ITI Career Options.",
      "caption": "Key points at a glance.",
      "heading": "SCVT and the Certificate",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 4,
        "blocks": [
          {
            "type": "summary",
            "heading": "Key ideas from this article",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "An Industrial Training Institute teaches a trade through mostly workshop practice."
              },
              {
                "heading": "",
                "text": "A trade name tells you little."
              },
              {
                "heading": "",
                "text": "Entry is Class 8 for a few trades and Class 10 for most."
              }
            ]
          },
          {
            "needId": "detail:4",
            "type": "detail",
            "heading": "ITI Career Options",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Use this on every trade you shortlist."
              },
              {
                "heading": "",
                "text": "Spend a day with an electrician, mechanic, welder or plumber."
              },
              {
                "heading": "",
                "text": "Many students pick a trade by name."
              }
            ],
            "sourceSectionId": "check",
            "sourceNeedIndex": 4
          },
          {
            "needId": "detail:5",
            "type": "detail",
            "heading": "Fake ITI Affiliation",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Private ITIs now outnumber government ones by the non-profit's count, and many are genuine."
              },
              {
                "heading": "",
                "text": "Search the NCVT MIS site (ncvtmis.gov.in) by state and district."
              },
              {
                "heading": "",
                "text": "Affiliation is given by trade and unit, and DGT orders list them one ITI at a time."
              }
            ],
            "sourceSectionId": "fake",
            "sourceNeedIndex": 5
          },
          {
            "needId": "detail:9",
            "type": "detail",
            "heading": "Layers on Top of an ITI Trade",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "You do not need to own a shop."
              },
              {
                "heading": "",
                "text": "A fitter, turner, machinist or welder who has worked in a factory can take small jobs from nearby units."
              },
              {
                "heading": "",
                "text": "Wiring, plumbing, fit-out and fabrication jobs for housing societies and builders."
              }
            ],
            "sourceSectionId": "business",
            "sourceNeedIndex": 9
          },
          {
            "needId": "detail:10",
            "type": "detail",
            "heading": "Electric Vehicles, Solar, AI and Automation",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Rooftop solar and electric two-wheelers need people who can install, test and repair them."
              },
              {
                "heading": "",
                "text": "AI helps with fault lookup, estimates and manuals."
              },
              {
                "heading": "",
                "text": "Read circuit and service manuals with an AI tool, then check the answer against your trainer."
              }
            ],
            "sourceSectionId": "ai",
            "sourceNeedIndex": 10
          }
        ]
      },
      "type": "summary",
      "title": "SCVT and the Certificate"
    },
