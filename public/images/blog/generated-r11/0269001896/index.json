            "heading": "Three Age Cliffs",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Age is the one thing you cannot train for."
              },
              {
                "heading": "",
                "text": "NDA II 2026 accepted candidates born from 2 January 2008 to 1 January 2011."
              },
              {
                "heading": "",
                "text": "Watch out: Miss it by one day of birth and the door is shut."
              }
            ],
            "sourceSectionId": "age",
            "sourceNeedIndex": 4
