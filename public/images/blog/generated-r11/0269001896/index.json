          {
            "needId": "detail:7",
            "type": "detail",
            "heading": "Four Questions Before You Pick a Door",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Before you commit, check your fit, your situation, the job market and AI-proofing."
              },
              {
                "heading": "",
                "text": "Can you sit for long drawing and design sessions, a slow research ladder, a uniform and a barracks, or months at sea."
              },
              {
                "heading": "",
                "text": "A door you respect but dread at 7 a.m. will not survive year two."
              }
            ],
            "sourceSectionId": "checkpoint",
            "sourceNeedIndex": 7
          },
          {
            "needId": "detail:8",
            "type": "detail",
            "heading": "Headroom, and What Caps the Rest",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Several doors here have two hard filters: getting in, then getting the first strong placement, licence or rank."
              },
              {
                "heading": "",
                "text": "A strong design portfolio or a real data project can earn work before you graduate, and the ceiling is set by proof, not by a pay band."
              },
              {
                "heading": "",
                "text": "Best for: students who will build visible work every week."
              }
            ],
            "sourceSectionId": "ceilings",
            "sourceNeedIndex": 8
          }
        ]
