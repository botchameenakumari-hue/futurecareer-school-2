        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "Whether Real Employers or Clients Currently Pay",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Whether you can tolerate the boring, repetitive part of the work - the 80% that never shows up in the daydream version."
              },
              {
                "heading": "",
                "text": "Whether the field has any real room to grow, or caps out at a fixed ceiling within a few years."
              }
            ],
            "sourceSectionId": "myth",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:5",
            "type": "checklist",
            "heading": "Hours, Travel, On-Call Load, and Shift Patterns",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "The unglamorous 80% of the work - the paperwork, the repetition, the waiting - that never appears in the highlight-reel version."
              },
              {
                "heading": "",
                "text": "Whether the role fits how you personally recharge: deep solo focus, constant people contact, or a mix."
              }
            ],
            "sourceSectionId": "sustain",
            "sourceNeedIndex": 5
          },
          {
            "needId": "chain:8",
            "type": "chain",
            "heading": "List Your Shortlisted Options",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "List your shortlisted options side by side."
              },
              {
                "heading": "",
                "text": "Score each of the 8 factors 1 to 5 for how much it matters to you right now."
              },
              {
                "heading": "",
                "text": "Score each option 1 to 5 on each factor, using real evidence."
              },
              {
                "heading": "",
                "text": "Multiply your importance score by each option's factor score, then add the totals."
              },
              {
                "heading": "",
                "text": "Re-run it after any real test."
              }
            ],
            "sourceSectionId": "weigh",
            "sourceNeedIndex": 8
          },
          {
            "needId": "checklist:9",
            "type": "checklist",
            "heading": "Check the Sources Behind These Claims",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Herzberg's two-factor (motivation-hygiene) theory overview."
              },
              {
                "heading": "",
                "text": "Kahneman and Deaton (2010) on income and well-being."
              },
              {
                "heading": "",
                "text": "Global skills-change and AI-disruption outlook."
              },
              {
                "heading": "",
                "text": "Free interest and skill-matching assessment built on RIASEC research."
              },
              {
