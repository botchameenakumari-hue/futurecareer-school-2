      "mobile": "career-options-in-science-chain-mobile.webp",
      "alt": "Planning steps for Career Options in Science.",
      "caption": "Steps in the order they happen.",
      "heading": "Five Rules for Choosing Between Lanes",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 4,
        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "Science Is the Safe Stream",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "\"The stream is the career.\" A stream is a key that fits some steps and not others."
              },
              {
                "heading": "",
                "text": "\"Respected means scalable.\" We rate each lane on how far skills, proof and a business layer can grow income, not on prestige."
              }
            ],
            "sourceSectionId": "two-decisions",
            "sourceNeedIndex": 1
          },
          {
            "needId": "chain:9",
            "type": "chain",
            "heading": "Start From the Lane",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Start from the lane, then work back to the stream."
              },
              {
                "heading": "",
                "text": "Be strict before choosing PCB."
              },
              {
                "heading": "",
                "text": "Use PCMB for a short delay, not as a plan."
              },
              {
                "heading": "",
                "text": "Write a second route, whatever you choose."
              }
            ],
            "sourceSectionId": "rules",
            "sourceNeedIndex": 9
          },
          {
            "needId": "chain:10",
            "type": "chain",
            "heading": "Expensive Wrong Turns",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Choosing the stream for the exam, not the lane."
              },
              {
                "heading": "",
                "text": "Confusing safe with scalable."
              },
              {
                "heading": "",
                "text": "Paying a large fee before checking approval."
              },
              {
                "heading": "",
                "text": "A postgraduate degree to postpone the decision."
              },
              {
                "heading": "",
                "text": "Treating one certificate as proof."
              },
              {
                "heading": "",
                "text": "Debt for a vague path."
              }
            ],
            "sourceSectionId": "wrong-turns",
            "sourceNeedIndex": 10
          },
