      "content": {
        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "Yoga and wellness careers include teaching, studio work, corporate wellness, retreat and tourism roles, and support roles alongside health professionals, and they require honest scope limits, recognised training, safety awareness and slow reputation building."
          },
          {
            "heading": "",
            "text": "Choose recognised training, practise teaching with small groups, keep within your scope and build repeat students before investing in a studio."
          },
          {
            "heading": "",
            "text": "Check the certifying body and avoid health claims you cannot support."
          }
        ]
      },
      "type": "proof",
      "title": "Course Fees and the 10 Percent Test"
