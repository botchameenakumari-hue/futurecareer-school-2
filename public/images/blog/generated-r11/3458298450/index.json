      "content": {
        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "An MBA can help career switchers when the target role expects a management credential or a campus recruiting route, but it is often not the only way, so compare the MBA with direct moves, skill proof and part-time options before taking on fees or a loan."
          },
          {
            "heading": "",
            "text": "Define the target role, check what people actually in that role studied and compare the MBA with a direct switch using proof of work."
          },
          {
            "heading": "",
            "text": "Ask for verifiable alumni outcomes and never rely on average salary headlines."
          }
        ]
      },
      "type": "proof",
      "title": "Course Fees and the 10 Percent Test"
