          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "It Either Ignores Gender Entirely",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "It skips the scholarships that exist specifically for girls, so families assume ambitious paths are unaffordable."
              },
              {
                "heading": "",
                "text": "It treats \"family will not allow it\" as a dead end instead of a negotiation that has a real playbook."
              },
              {
                "heading": "",
                "text": "It rarely mentions where women are already winning with hard numbers, aviation, civil services, NEET performance, because those facts undercut the \"safe list\" framing."
              }
            ],
            "sourceSectionId": "why",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:5",
            "type": "checklist",
            "heading": "Government Routes for Girls After 12th",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Army Wing: open to girls from any stream, age 16.5-19.5, after clearing UPSC's NDA exam."
              },
              {
                "heading": "",
                "text": "Navy and Air Force Wings: require Physics and Mathematics in Class 12."
              },
              {
                "heading": "",
                "text": "This route opened to women only after a 2021 Supreme Court ruling, it is a genuinely new option, not a long-standing one."
              }
            ],
            "sourceSectionId": "defence",
            "sourceNeedIndex": 5
          },
          {
            "needId": "checklist:7",
            "type": "checklist",
            "heading": "Pressure Without Turning It Into a Fight",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Concrete numbers: fees, scholarship coverage, hostel cost, and expected timeline to first income."
              },
              {
                "heading": "",
                "text": "A specific, named safety plan, hostel type, city safety infrastructure, and a support contact, not vague reassurance."
              },
              {
                "heading": "",
                "text": "A short trial: one semester, one certificate, or one visible project before asking for full multi-year buy-in."
              },
              {
                "heading": "",
                "text": "Involving one respected extended-family or community voice who already supports working women."
              }
            ],
            "sourceSectionId": "family",
            "sourceNeedIndex": 7
          },
