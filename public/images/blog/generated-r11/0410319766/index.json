        "kind": "items",
        "items": [
          {
            "heading": "",
            "text": "CFA versus MBA in finance is a choice between a self-paced professional exam path focused on investment analysis and an institution-based degree that offers a broader network and management training, and the better choice depends on your target role, your funds, your study discipline and what employers in that role value."
          },
          {
            "heading": "",
            "text": "Read ten notices in your target role to see which credential they ask for, count total cost and time, and test your interest with a small valuation exercise."
          },
          {
            "heading": "",
            "text": "Check the official bodies and institutions and verify claims about placements."
          }
        ]
      },
      "type": "proof",
      "title": "Course Fees and the 10 Percent Test"
