      "file": "career-options-after-12th-commerce-without-maths-checklist.webp",
      "mobile": "career-options-after-12th-commerce-without-maths-checklist-mobile.webp",
      "alt": "Decision checklist for Career Options After 12th Commerce.",
      "caption": "Questions to use before deciding.",
      "heading": "Guides Mix 2026-27 Dates with 2027-28 Dates",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 8,
        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "Many Guides Mix",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Some popular course pages list salary ranges with no source, and one still lists DU JAT as a B.Com route, although DU's 2026-27 admission runs on CUET scores."
              }
            ],
            "sourceSectionId": "stand",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:3",
            "type": "checklist",
            "heading": "One Five-Test Set for Three DU Lines",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "B.Com (Hons), Combination II: language + Accountancy + two List B subjects (Business Studies and Economics)."
              },
              {
                "heading": "",
                "text": "B.Com (General), Combination II: language + one List B subject + General Aptitude Test."
              }
            ],
            "sourceSectionId": "five-slots",
            "sourceNeedIndex": 3
          },
          {
            "needId": "chain:5",
            "type": "chain",
            "heading": "Any University's CUET Line in Three Steps",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Find the programme-specific line."
              },
              {
                "heading": "",
                "text": "Check each subject against your marksheet."
              },
              {
                "heading": "",
                "text": "Check for extra sections."
              }
            ],
            "sourceSectionId": "read-line",
            "sourceNeedIndex": 5
          },
          {
            "needId": "checklist:8",
            "type": "checklist",
            "heading": "CA, CS and CMA: Timing, Not Eligibility",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "CA Foundation: you must register at least four months before the exam."
              },
              {
                "heading": "",
                "text": "CMA Foundation: the December 2026 exam is reported for 13 December, with a registration deadline of 10 October and a late-fee window to 17 October."
              },
              {
                "heading": "",
                "text": "CSEET (CS entry): ICSI's February 2027 session has conflicting registration dates in public sources, so confirm on icsi.edu before you rely on either."
              }
            ],
            "sourceSectionId": "pro",
            "sourceNeedIndex": 8
          },
          {
            "needId": "checklist:9",
            "type": "checklist",
            "heading": "Three Plans for This Cycle",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Choose a five-test CUET set that covers three DU lines at once (see the five-test set above)."
              },
              {
                "heading": "",
                "text": "Mark the first dates: CLAT on 31 October if law interests you, CMA on 10 October if you want an early start."
              },
              {
                "heading": "",
                "text": "Decide by December whether the May 2027 CA Foundation sitting is realistic next to boards and CUET."
              },
              {
                "heading": "",
                "text": "Keep one skill project running that is not an exam."
              }
            ],
            "sourceSectionId": "plans",
            "sourceNeedIndex": 9
          },
          {
            "needId": "chain:10",
            "type": "chain",
            "heading": "Gap Year or Settle: the Arithmetic",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "A specific target."
              },
              {
                "heading": "",
                "text": "A realistic gain."
              },
              {
                "heading": "",
                "text": "A parallel track."
              }
            ],
            "sourceSectionId": "drop",
            "sourceNeedIndex": 10
          },
          {
            "needId": "chain:14",
            "type": "chain",
            "heading": "Short First Test You Can Run Alone",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Write down your subject list."
              },
              {
                "heading": "",
                "text": "Match it to the combination table."
              },
              {
                "heading": "",
                "text": "Sit one timed sample paper for the weakest subject."
              },
              {
                "heading": "",
                "text": "Build one small piece of proof."
              },
              {
                "heading": "",
                "text": "Ask one direct question."
              },
              {
                "heading": "",
                "text": "Decide, then review."
              }
            ],
            "sourceSectionId": "test",
            "sourceNeedIndex": 14
          },
          {
            "needId": "chain:15",
            "type": "chain",
            "heading": "What Parents Can Check Before Spending",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Ask for the exact line in the bulletin."
              },
              {
                "heading": "",
                "text": "A date for the 2026-27 cycle does not apply to the child who finishes Class 12 in 2027."
              },
              {
