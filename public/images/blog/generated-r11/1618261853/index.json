    {
      "file": "resume-tips-for-freshers-india-checklist.webp",
      "mobile": "resume-tips-for-freshers-india-checklist-mobile.webp",
      "alt": "Decision checklist for Resume Tips for Freshers India.",
      "caption": "Questions to use before deciding.",
      "heading": "Move Skills and Projects Above Education",
      "content": {
        "kind": "bundle",
        "sourceNeedCount": 5,
        "blocks": [
          {
            "needId": "checklist:1",
            "type": "checklist",
            "heading": "Do Not Open with Objective",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Treat internships, even short or unpaid ones, with the same outcome-first structure you would use for a real job."
              },
              {
                "heading": "",
                "text": "Use coursework and extracurriculars only when they support a specific claim, not as filler to make the page look fuller."
              }
            ],
            "sourceSectionId": "no-experience-structure",
            "sourceNeedIndex": 1
          },
          {
            "needId": "checklist:4",
            "type": "checklist",
            "heading": "Projects Section That Pulls Its Weight",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Name the problem first."
              },
              {
                "heading": "",
                "text": "Name the tools honestly."
              },
              {
                "heading": "",
                "text": "End with a result."
              },
              {
                "heading": "",
                "text": "Keep it to your strongest 2-4 projects."
              }
            ],
            "sourceSectionId": "projects-section",
            "sourceNeedIndex": 4
          },
          {
            "needId": "checklist:5",
            "type": "checklist",
            "heading": "Coursework and Extracurriculars, Used Correctly",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Listing every course from your syllabus, including generic ones every student in your program also took."
              },
              {
                "heading": "",
                "text": "\"Member, college coding club\" with no context on what that involvement actually produced."
              },
              {
                "heading": "",
                "text": "Hobbies listed without any connection to the role you are applying for."
              }
            ],
            "sourceSectionId": "coursework-extracurriculars",
            "sourceNeedIndex": 5
          },
          {
            "needId": "checklist:6",
            "type": "checklist",
            "heading": "Genuinely Have No Numbers Yet",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "Scale: dataset size, number of users, number of test cases, number of pages, number of items processed."
              },
              {
                "heading": "",
                "text": "Accuracy or performance: model accuracy, load time improvement, error rate reduction, even at a small, honest scale."
              },
              {
                "heading": "",
                "text": "Rank or recognition: hackathon placement, competition standing, shortlist or finalist status."
              },
              {
                "heading": "",
                "text": "Reach: people who used, viewed, or attended something you built or organized."
              },
              {
                "heading": "",
                "text": "Time or effort: duration of the project, team size you coordinated, number of iterations you shipped."
              }
            ],
            "sourceSectionId": "quantify",
            "sourceNeedIndex": 6
          },
          {
            "needId": "checklist:10",
            "type": "checklist",
            "heading": "What to Do Next",
            "kind": "items",
            "items": [
              {
                "heading": "",
                "text": "If your skills section feels thin, read skills for a resume for freshers for ideas."
              },
              {
                "heading": "",
                "text": "For branch-wise starting lists, read technical skills for a fresher resume by branch."
              },
              {
                "heading": "",
                "text": "To practise structured answers, read analytical skills interview questions for freshers."
              },
              {
                "heading": "",
                "text": "For two-sentence answers by reason, read how to explain a career gap."
              },
              {
                "heading": "",
                "text": "For wording, honest levels and proof lines, read how to list computer, Excel and language skills on a resume."
              },
              {
                "heading": "",
                "text": "For patterns and checks, read career objective for commerce, accounting, finance and law graduates."
              }
            ],
            "sourceSectionId": "next-step",
            "sourceNeedIndex": 10
          }
        ]
      },
