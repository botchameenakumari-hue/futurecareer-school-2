---
export interface StepItem {
  title: string;
  body: string;
}

export interface Props {
  sectionId?: string;
  sectionClass?: string;
  title: string;
  subtitle?: string;
  items: StepItem[];
}

const {
  sectionId,
  sectionClass = '',
  title,
  subtitle,
  items,
} = Astro.props;

---

<section id={sectionId} class:list={['bofu-step-flow-section', sectionClass]}>
  <div class="container">
    <div class="step-intro card">
      <div class="step-intro-copy">
        <h2 class="section-headline">{title}</h2>
      </div>
      {subtitle && <p class="section-sub">{subtitle}</p>}
    </div>
    <div class="step-flow-grid">
      {items.map((item, index) => (
        <article class="step-flow-card card">
          <div class="step-flow-no">{String(index + 1).padStart(2, '0')}</div>
          <div class="step-flow-rule"></div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
    <slot />
  </div>
</section>

<style>
  .bofu-step-flow-section {
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
  }
  .bofu-step-flow-section .step-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, .92fr);
    gap: 1rem 1.2rem;
    align-items: end;
    padding: 1.35rem 1.35rem 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: 26px;
    border: 1px solid rgba(255,255,255,.12);
    background:
      radial-gradient(620px 220px at 100% 0%, rgba(229,184,74,.1), transparent 72%),
      linear-gradient(160deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
    box-shadow: 0 22px 48px rgba(0,0,0,.22);
    position: relative;
    overflow: hidden;
  }
  .bofu-step-flow-section .step-intro::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(229,184,74,.96), rgba(45,212,191,.86));
  }
  .bofu-step-flow-section .section-headline {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -.03em;
    color: #fff;
    margin: 0;
    text-align: left;
    text-wrap: balance;
  }
  .bofu-step-flow-section .section-sub {
    font-size: clamp(15px, 2vw, 17px);
    color: rgba(255,255,255,.62);
    max-width: 52ch;
    margin: 0;
    text-align: left;
    line-height: 1.78;
  }
  .bofu-step-flow-section .step-flow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  .bofu-step-flow-section .step-flow-card {
    position: relative;
    padding: 1.45rem 1.15rem 1.15rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.1);
    background:
      radial-gradient(340px 150px at 100% 0%, rgba(229,184,74,.12), transparent 72%),
      linear-gradient(150deg, rgba(255,255,255,.04), rgba(255,255,255,.012));
    box-shadow: 0 18px 38px rgba(0,0,0,.22);
    overflow: visible;
  }
  .bofu-step-flow-section .step-flow-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 40%);
  }
  .bofu-step-flow-section .step-flow-no {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    border: 1px solid rgba(229,184,74,.32);
    background: rgba(229,184,74,.14);
    color: #f6db95;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    margin-bottom: .75rem;
    box-shadow: 0 0 0 7px rgba(255,255,255,.03);
  }
  .bofu-step-flow-section .step-flow-rule {
    width: 76px;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(229,184,74,.92), rgba(45,212,191,.72));
    margin-bottom: .95rem;
  }
  .bofu-step-flow-section .step-flow-card h3 {
    color: #fff;
    font-size: 1.1rem;
    line-height: 1.42;
    margin-bottom: .55rem;
    max-width: 22ch;
    text-wrap: balance;
  }
  .bofu-step-flow-section .step-flow-card p {
    color: rgba(255,255,255,.71);
    font-size: 14.5px;
    line-height: 1.82;
    max-width: 42ch;
  }

  @media (max-width: 980px) {
    .bofu-step-flow-section .step-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .bofu-step-flow-section .step-flow-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .bofu-step-flow-section {
      padding: 4.8rem 0;
    }
    .bofu-step-flow-section .step-intro {
      padding: 1.05rem 1rem 1rem 1.12rem;
      border-radius: 20px;
      margin-bottom: 1rem;
    }
    .bofu-step-flow-section .step-flow-card {
      padding: 1.45rem 1rem 1rem;
      border-radius: 20px;
    }
  }
</style>
