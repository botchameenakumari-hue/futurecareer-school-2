---
const path = Astro.url.pathname;
const visual = path.includes('/assessments') ? ['context-assessment-map.webp', 'An assessment signal map showing how results become questions, experiments, and direction']
  : /neet|bds|medical|healthcare|pcb/.test(path) ? ['context-healthcare-aspirant.webp', 'A healthcare career visual showing patients, science, skills, and paths']
  : /first-generation|tier-2|low-cgpa|backlogs/.test(path) ? ['context-first-generation.webp', 'A first-generation career visual showing context, capability, proof, and mobility']
  : /government-exam|government-jobs|upsc|law|policy/.test(path) ? ['context-law-policy.webp', 'A law and policy career visual showing impact, fit, runway, and options']
  : /arts|media|creative|communication/.test(path) ? ['context-creative-media.webp', 'A creative career visual showing idea, craft, audience, and value']
  : /study-abroad|nri-students/.test(path) ? ['context-study-abroad.webp', 'A study-abroad decision visual comparing cost, outcome, risk, and fit']
  : /government-exam|government-jobs|upsc|low-board-scores|low-cgpa|dropouts|backlogs/.test(path) ? ['context-exam-pressure.webp', 'A career setback visual showing attempts, time, runway, and options']
  : /engineering|b-tech|computer-science|it-professionals/.test(path) ? ['context-engineering-tech.webp', 'An engineering career visual showing foundations, projects, proof, and roles']
  : /women-returning|career-coaching-for-women|career-counselling-for-women/.test(path) ? ['context-women-returning.webp', 'A return-to-work visual showing experience, rebuilding, flexibility, and income']
  : /entrepreneur|hire-a-career-coach/.test(path) ? ['context-entrepreneur-path.webp', 'An entrepreneurship visual showing problem, skill, offer, and revenue']
  : /career-planning|career-mentoring|career-guidance-session|career-counselling-session/.test(path) ? ['context-career-plan.webp', 'A career plan visual showing now, next, proof, and review']
  : path.includes('career-counselling-helpline') ? ['context-helpline.webp', 'A helpline visual showing how one honest question can become understanding and a decision']
  : path.includes('/locations/') ? ['context-location-online.webp', 'A local search and online guidance visual showing city access to one online service']
  : /career-counselling-online|career-guidance-online|online-career|virtual-career|video/.test(path) ? ['context-online-session.webp', 'An online guidance visual showing live conversation, shared screen, and a clear next step']
  : /cost|fees|pricing|affordable|package|subscription/.test(path) ? ['context-pricing-value.webp', 'A pricing visual showing clarity, a skill plan, and follow-through as the value of guidance']
  : /best-|compare-|questions-for-students|platform-review|where-to-get/.test(path) ? ['context-evaluation-checklist.webp', 'A checklist visual for evaluating real career guidance evidence and trade-offs']
  : /arts|commerce|pcm|pcb|stream|neet|ca-aspirants/.test(path) ? ['context-stream-choice.webp', 'A stream decision visual showing science, commerce, arts, and skill-building routes']
  : /after-10th|school-students|class-10|parents|students/.test(path) ? ['context-student-parent-map.webp', 'A student and parent career decision map from noticing strengths to building skills']
  : /after-12th|11th|12th|stream|pcm|pcb|commerce|arts/.test(path) ? ['context-after-12th.webp', 'A career decision map for comparing work, routes, capability, and evidence after 12th']
  : /graduate|graduation|freshers|college|b-tech|bba|bcom|bsc|mba/.test(path) ? ['context-graduate-pathway.webp', 'A graduate pathway from degree and capability gaps to proof and opportunity']
  : /professional|career-change|executive|adult|women-returning|entrepreneur/.test(path) ? ['context-professional-pivot.webp', 'A working professional career pivot map from reality to transferable skills and leverage']
  : ['context-holistic-framework.webp', 'A holistic career decision framework covering person, options, market, skills, and money'];
---
<figure class="bofu-context-visual">
  <img src={`/images/bofu/${visual[0]}`} alt={visual[1]} title={visual[1]} width="1600" height="900" loading="lazy" decoding="async" />
  <figcaption>{visual[1]}</figcaption>
</figure>
<style>
  .bofu-context-visual { margin: 32px auto 0; max-width: 1120px; padding: 0 16px; }
  .bofu-context-visual img { width: 100%; height: auto; display: block; border-radius: 22px; border: 1px solid rgba(229,184,74,.16); }
  .bofu-context-visual figcaption { margin-top: 10px; color: rgba(255,255,255,.62); font-size: 13px; line-height: 1.5; }
</style>
