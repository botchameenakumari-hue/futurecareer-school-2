const path = Astro.url.pathname;
const visual = path.includes('/assessments') ? ['context-assessment-map.svg', 'An assessment signal map showing how results become questions, experiments, and direction']
  : /after-10th|school-students|class-10|parents|students/.test(path) ? ['context-student-parent-map.svg', 'A student and parent career decision map from noticing strengths to building skills']
  : /after-12th|11th|12th|stream|pcm|pcb|commerce|arts/.test(path) ? ['context-after-12th.svg', 'A career decision map for comparing work, routes, capability, and evidence after 12th']
  : /graduate|graduation|freshers|college|b-tech|bba|bcom|bsc|mba/.test(path) ? ['context-graduate-pathway.svg', 'A graduate pathway from degree and capability gaps to proof and opportunity']
  : /professional|career-change|executive|adult|women-returning|entrepreneur/.test(path) ? ['context-professional-pivot.svg', 'A working professional career pivot map from reality to transferable skills and leverage']
  : ['context-holistic-framework.svg', 'A holistic career decision framework covering person, options, market, skills, and money'];
---
<figure class="bofu-context-visual">
  <img src={`/images/bofu/${visual[0]}`} alt={visual[1]} width="1600" height="760" loading="lazy" decoding="async" />
</figure>
<style>
  .bofu-context-visual { margin: 32px auto 0; max-width: 1120px; padding: 0 16px; }
  .bofu-context-visual img { width: 100%; height: auto; display: block; border-radius: 22px; border: 1px solid rgba(229,184,74,.16); }
</style>
