---
import StudentGuidancePlan from './StudentGuidancePlan.astro';
import WorkingProfessionalGuidancePlan from './WorkingProfessionalGuidancePlan.astro';

export interface Props {
  sectionId?: string;
  audience?: 'student' | 'professional' | 'mixed';
  serviceLabel?: string;
  title?: string;
}

const {
  sectionId = 'plans',
  audience = 'mixed',
  serviceLabel = 'Career Guidance',
  title = `${serviceLabel} Plans`,
} = Astro.props;

const showStudent = audience === 'student' || audience === 'mixed';
const showProfessional = audience === 'professional' || audience === 'mixed';
---

<section id={sectionId} class="guidance-plans-band">
  <div class="container">
    <div class="guidance-plans-head">
      <h2>{title}</h2>
    </div>

    <div class:list={['guidance-plans-grid', audience !== 'mixed' && 'guidance-plans-grid--single']}>
      {showStudent && <StudentGuidancePlan serviceLabel={serviceLabel} />}
      {showProfessional && <WorkingProfessionalGuidancePlan serviceLabel={serviceLabel} />}
    </div>
  </div>
</section>

<style>
  .guidance-plans-band {
    padding: 5.5rem 0 6rem;
    background:
      radial-gradient(860px 340px at 12% 0%, rgba(45, 212, 191, 0.1), transparent 72%),
      radial-gradient(860px 340px at 88% 0%, rgba(229, 184, 74, 0.14), transparent 72%),
      rgba(255, 255, 255, 0.012);
  }

  .guidance-plans-head {
    max-width: min(960px, 100%);
    margin: 0 auto 1.35rem;
    text-align: center;
  }

  .guidance-plans-head h2 {
    margin: 0;
    font-size: clamp(1.85rem, 3.1vw, 2.55rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: #fff;
    text-wrap: balance;
  }

  .guidance-plans-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .guidance-plans-grid--single {
    grid-template-columns: minmax(0, 1100px);
    justify-content: center;
  }

  .guidance-plans-grid :global(.plan-card) {
    position: relative;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
      rgba(8, 10, 15, 0.92);
    box-shadow: 0 30px 80px -52px rgba(0, 0, 0, 0.92);
  }

  .guidance-plans-grid :global(.plan-card::before) {
    content: "";
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    top: 0;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.3), rgba(255,255,255,0));
    opacity: 0.45;
  }

  .guidance-plans-grid :global(.plan-card--student::before) {
    background: linear-gradient(90deg, rgba(45, 212, 191, 0), rgba(45, 212, 191, 0.95), rgba(45, 212, 191, 0));
  }

  .guidance-plans-grid :global(.plan-card--professional::before) {
    background: linear-gradient(90deg, rgba(229, 184, 74, 0), rgba(229, 184, 74, 0.95), rgba(229, 184, 74, 0));
  }

  .guidance-plans-grid :global(.plan-card--student) {
    border-color: rgba(45, 212, 191, 0.22);
    background:
      radial-gradient(420px 210px at 0% 0%, rgba(45, 212, 191, 0.13), transparent 74%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
      rgba(8, 10, 15, 0.94);
  }

  .guidance-plans-grid :global(.plan-card--professional) {
    border-color: rgba(229, 184, 74, 0.24);
    background:
      radial-gradient(420px 210px at 100% 0%, rgba(229, 184, 74, 0.14), transparent 74%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
      rgba(8, 10, 15, 0.94);
  }

  .guidance-plans-grid :global(.plan-card__meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 1.05rem;
    flex-wrap: wrap;
  }

  .guidance-plans-grid :global(.plan-card__eyebrow) {
    margin: 0;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.54);
  }

  .guidance-plans-grid :global(.plan-card__tag) {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.84);
  }

  .guidance-plans-grid :global(.plan-card__hero) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(258px, 294px);
    gap: 1.3rem;
    align-items: start;
  }

  .guidance-plans-grid :global(.plan-card__hero-copy) {
    min-width: 0;
    display: grid;
    gap: 0.7rem;
  }

  .guidance-plans-grid :global(.plan-card__title) {
    margin: 0 0 0.45rem;
    font-size: clamp(1.42rem, 2vw, 1.78rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }

  .guidance-plans-grid :global(.plan-card__summary) {
    margin: 0;
    max-width: 33ch;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.48;
    color: rgba(255, 255, 255, 0.92);
    text-wrap: balance;
  }

  .guidance-plans-grid :global(.plan-card__fact-list) {
    display: grid;
    grid-auto-rows: auto;
    gap: 0.95rem;
    margin-top: 1.35rem;
    align-content: start;
    flex: 1;
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__fact-list) {
    gap: 1.08rem;
    grid-template-rows: repeat(3, minmax(0, 1fr));
  }

  .guidance-plans-grid :global(.plan-card__fact) {
    display: grid;
    grid-template-columns: 1fr;
    align-content: start;
    gap: 0.4rem;
    align-items: start;
    padding: 1rem 1rem 1.04rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    min-width: 0;
  }

  .guidance-plans-grid :global(.plan-card__fact--edge) {
    padding: 1.05rem 1.05rem 1.08rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    box-shadow: 0 16px 40px -30px rgba(0, 0, 0, 0.9);
  }

  .guidance-plans-grid :global(.plan-card__fact--featured) {
    padding: 1.05rem 1.05rem 1.08rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.012));
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__fact--edge) {
    background: linear-gradient(90deg, rgba(45, 212, 191, 0.15), rgba(45, 212, 191, 0.03));
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__fact--edge) {
    background: linear-gradient(90deg, rgba(229, 184, 74, 0.17), rgba(229, 184, 74, 0.03));
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__fact--featured) {
    background: linear-gradient(90deg, rgba(45, 212, 191, 0.1), rgba(45, 212, 191, 0.02));
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__fact--featured) {
    background: linear-gradient(90deg, rgba(229, 184, 74, 0.12), rgba(229, 184, 74, 0.02));
  }

  .guidance-plans-grid :global(.plan-card__fact-label) {
    display: inline-block;
    width: fit-content;
    padding: 0;
    min-height: 0;
    border: 0;
    background: transparent;
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .guidance-plans-grid :global(.plan-card__fact p) {
    margin: 0;
    max-width: none;
    font-size: 14px;
    line-height: 1.38;
    color: rgba(255, 255, 255, 0.86);
    text-wrap: pretty;
  }

  .guidance-plans-grid :global(.plan-card__fact--edge p) {
    font-size: 14.45px;
    font-weight: 700;
    line-height: 1.42;
    color: rgba(255, 255, 255, 0.96);
  }

  .guidance-plans-grid :global(.plan-card__fact-actions) {
    display: grid;
    justify-items: start;
    margin-top: 0.48rem;
  }

  .guidance-plans-grid :global(.plan-card__spotlight) {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 0.94rem;
    padding: 1.18rem 1.06rem 1.06rem;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.045)),
      rgba(255, 255, 255, 0.055);
    text-align: left;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .guidance-plans-grid :global(.plan-card__spotlight::after) {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -88px;
    top: -88px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__spotlight) {
    border-color: rgba(45, 212, 191, 0.2);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 18px 36px -26px rgba(45, 212, 191, 0.75);
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__spotlight) {
    border-color: rgba(229, 184, 74, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 18px 36px -26px rgba(229, 184, 74, 0.75);
  }

  .guidance-plans-grid :global(.plan-card__spotlight-copy) {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.24rem;
  }

  .guidance-plans-grid :global(.plan-card__offer) {
    width: fit-content;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.94);
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__offer) {
    background: rgba(45, 212, 191, 0.18);
    color: rgba(222, 255, 248, 0.98);
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__offer) {
    background: rgba(229, 184, 74, 0.18);
    color: rgba(255, 246, 217, 0.98);
  }

  .guidance-plans-grid :global(.plan-card__compare-price) {
    margin-top: 0.22rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.48);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .guidance-plans-grid :global(.plan-card__price) {
    font-family: "Sora", sans-serif;
    font-size: clamp(3.15rem, 5.8vw, 4.15rem);
    line-height: 0.88;
    letter-spacing: -0.072em;
    color: #fff;
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__price) {
    text-shadow: 0 0 28px rgba(45, 212, 191, 0.2);
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__price) {
    text-shadow: 0 0 28px rgba(229, 184, 74, 0.22);
  }

  .guidance-plans-grid :global(.plan-card__price-note) {
    margin-top: 0.12rem;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__price-note) {
    color: rgba(45, 212, 191, 0.9);
  }

  .guidance-plans-grid :global(.plan-card--professional .plan-card__price-note) {
    color: rgba(229, 184, 74, 0.92);
  }

  .guidance-plans-grid :global(.plan-card__support-line) {
    margin: 0;
    max-width: 22ch;
    font-size: 12.6px;
    font-weight: 700;
    line-height: 1.42;
    color: rgba(255, 255, 255, 0.84);
  }

  .guidance-plans-grid :global(.plan-card__featured-pricing) {
    display: grid;
    gap: 0.4rem;
    margin: 0.08rem 0 0.08rem;
    padding: 0.8rem 0.88rem 0.88rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
  }

  .guidance-plans-grid :global(.plan-card--student .plan-card__featured-pricing) {
    border-color: rgba(45, 212, 191, 0.18);
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.14), rgba(45, 212, 191, 0.04));
  }

  .guidance-plans-grid :global(.plan-card__featured-offer) {
    width: fit-content;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.28);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  .guidance-plans-grid :global(.plan-card__featured-price-row) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .guidance-plans-grid :global(.plan-card__featured-compare) {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.46);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .guidance-plans-grid :global(.plan-card__featured-price) {
    font-family: "Sora", sans-serif;
    font-size: clamp(2rem, 4.6vw, 2.6rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
    color: #fff;
    text-shadow: 0 0 24px rgba(45, 212, 191, 0.18);
  }

  .guidance-plans-grid :global(.plan-card__featured-note) {
    margin: 0;
    font-size: 0.77rem;
    font-weight: 700;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }

  .guidance-plans-grid :global(.plan-card__spotlight-actions) {
    display: grid;
    gap: 0.58rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .guidance-plans-grid :global(.plan-card__availability) {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.6);
  }

  .guidance-plans-grid :global(.plan-card__spotlight .btn-gold),
  .guidance-plans-grid :global(.plan-card__spotlight .btn-outline),
  .guidance-plans-grid :global(.plan-card__fact .btn-outline),
  .guidance-plans-grid :global(.plan-card__fact .btn-gold) {
    min-height: 46px;
    justify-content: center;
    font-size: 12.5px;
    line-height: 1.2;
    text-align: center;
  }

  .guidance-plans-grid :global(.plan-card__spotlight .btn-gold),
  .guidance-plans-grid :global(.plan-card__spotlight .btn-outline) {
    width: 100%;
  }

  .guidance-plans-grid :global(.plan-card__fact .btn-outline),
  .guidance-plans-grid :global(.plan-card__fact .btn-gold) {
    width: fit-content;
    min-width: 0;
    max-width: 100%;
    margin-top: 0;
    padding-inline: 0.95rem;
    white-space: normal;
  }

  @media (max-width: 1080px) {
    .guidance-plans-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .guidance-plans-band {
      padding: 5rem 0;
    }

    .guidance-plans-grid :global(.plan-card) {
      padding: 1.18rem;
      border-radius: 24px;
    }

    .guidance-plans-grid :global(.plan-card__hero) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .guidance-plans-grid :global(.plan-card__spotlight) {
      order: 0;
      padding: 1rem;
    }

    .guidance-plans-grid :global(.plan-card--professional .plan-card__fact-list) {
      grid-template-rows: none;
    }

    .guidance-plans-grid :global(.plan-card__fact) {
      gap: 0.3rem;
    }
  }

  @media (max-width: 560px) {
    .guidance-plans-head {
      margin-bottom: 1.5rem;
    }

    .guidance-plans-head h2 {
      font-size: clamp(1.84rem, 8vw, 2.35rem);
    }

    .guidance-plans-grid :global(.plan-card__meta) {
      align-items: flex-start;
      flex-direction: column;
    }

    .guidance-plans-grid :global(.plan-card__tag) {
      min-height: 0;
      padding: 0.45rem 0.75rem;
      border-radius: 14px;
      line-height: 1.4;
    }

    .guidance-plans-grid :global(.plan-card__spotlight) {
      gap: 0.65rem;
    }

    .guidance-plans-grid :global(.plan-card__fact--edge),
    .guidance-plans-grid :global(.plan-card__fact--featured) {
      padding: 0.92rem 0.95rem 0.95rem;
    }
  }
</style>
