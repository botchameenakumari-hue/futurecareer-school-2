---
import { BOFU_PAYMENT_LINKS, type BofuAudience } from '../../config/bofu';

export interface Props {
  sectionId?: string;
  sectionClass?: string;
  eyebrow?: string;
  title?: string;
  highlight?: string;
  subtitle?: string;
  audience?: BofuAudience;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  tertiaryHref?: string;
  tertiaryLabel?: string;
  studentHref?: string;
  studentLabel?: string;
  professionalHref?: string;
  professionalLabel?: string;
}

const {
  sectionId = 'final-cta',
  sectionClass = '',
  eyebrow = 'Next step',
  title = 'Take the next step with more clarity and less guesswork',
  highlight = '',
  subtitle = 'Move forward when the next decision matters enough that delay, confusion, or another wrong turn is already getting expensive.',
  audience = 'mixed',
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  tertiaryHref,
  tertiaryLabel,
  studentHref = BOFU_PAYMENT_LINKS.students,
  studentLabel = 'Get Student Career Guidance',
  professionalHref = BOFU_PAYMENT_LINKS.workingProfessionals,
  professionalLabel = 'Get Working Professional Career Guidance',
} = Astro.props;

const explicitActionItems = [
  primaryHref && primaryLabel
    ? { href: primaryHref, label: primaryLabel, className: 'btn-gold pulse' }
    : null,
  secondaryHref && secondaryLabel
    ? { href: secondaryHref, label: secondaryLabel, className: 'btn-outline' }
    : null,
  tertiaryHref && tertiaryLabel
    ? { href: tertiaryHref, label: tertiaryLabel, className: 'btn-outline' }
    : null,
].filter((item): item is { href: string; label: string; className: string } => Boolean(item));

const audienceActionItems =
  audience === 'student'
    ? [{ href: studentHref, label: studentLabel, className: 'btn-gold pulse' }]
    : audience === 'professional'
      ? [{ href: professionalHref, label: professionalLabel, className: 'btn-gold pulse' }]
      : [
          { href: studentHref, label: studentLabel, className: 'btn-gold pulse' },
          {
            href: professionalHref,
            label: professionalLabel,
            className: 'btn-outline',
          },
        ];

const actionItems = explicitActionItems.length > 0 ? explicitActionItems : audienceActionItems;
---

<section id={sectionId} class:list={['bofu-final-cta-section', sectionClass]}>
  <div class="container">
    <div class="final-cta-inner card">
      <div class="final-copy">
        <div class="pill final-pill">
          <span class="pill-dot"></span>
          {eyebrow}
        </div>
        <h2 class="final-title">
          {title}
          {highlight && <span class="gold-text"> {highlight}</span>}
        </h2>
        <p class="final-sub">{subtitle}</p>
      </div>
      <div class="final-action-panel">
        <div class="final-actions">
          {actionItems.map((item) => (
            <a href={item.href} class={item.className}>{item.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bofu-final-cta-section {
    position: relative;
    overflow: hidden;
    padding: 5.4rem 0;
    scroll-margin-top: 108px;
  }
  .bofu-final-cta-section .final-cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, .9fr);
    gap: 1.1rem 1.4rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: 28px;
    border: 1px solid rgba(255,255,255,.12);
    background:
      radial-gradient(620px 240px at 0% 0%, rgba(45,212,191,.09), transparent 72%),
      radial-gradient(560px 220px at 100% 100%, rgba(229,184,74,.12), transparent 74%),
      linear-gradient(150deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
    box-shadow: 0 24px 52px rgba(0,0,0,.24);
    position: relative;
    overflow: hidden;
  }
  .bofu-final-cta-section .final-cta-inner::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(229,184,74,.96), rgba(45,212,191,.86));
  }
  .bofu-final-cta-section .final-copy {
    text-align: left;
  }
  .bofu-final-cta-section .final-pill {
    width: fit-content;
    margin: 0 0 1rem;
  }
  .bofu-final-cta-section .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
  }
  .bofu-final-cta-section .final-title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.08;
    color: #fff;
    letter-spacing: -.03em;
    margin-bottom: .85rem;
    text-wrap: balance;
  }
  .bofu-final-cta-section .final-sub {
    max-width: 55ch;
    margin: 0;
    color: rgba(255,255,255,.68);
    line-height: 1.8;
  }
  .bofu-final-cta-section .final-action-panel {
    padding: 1rem;
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.045);
  }
  .bofu-final-cta-section .final-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 14px;
  }
  .bofu-final-cta-section .btn-gold,
  .bofu-final-cta-section .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    text-align: center;
    min-height: 52px;
  }

  @media (max-width: 900px) {
    .bofu-final-cta-section .final-cta-inner {
      grid-template-columns: 1fr;
    }
    .bofu-final-cta-section .final-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .bofu-final-cta-section {
      padding: 4.7rem 0;
    }
    .bofu-final-cta-section .final-cta-inner {
      padding: 1.05rem;
      border-radius: 22px;
    }
    .bofu-final-cta-section .final-action-panel {
      padding: .88rem;
      border-radius: 18px;
    }
  }
</style>
