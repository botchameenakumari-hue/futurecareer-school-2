---
export interface ProcessItem {
  title: string;
  body: string;
}

export interface StageCard {
  kicker: string;
  title: string;
  body: string;
}

export interface Props {
  sectionId?: string;
  sectionClass?: string;
  title?: string;
  subtitle?: string;
  stageCards?: StageCard[];
  processItems?: ProcessItem[];
}

const defaultStageCards: StageCard[] = [
  {
    kicker: 'Clarity',
    title: 'Map your profile, pressure, and real decision',
    body: 'Start by understanding strengths, work style, current pressure, and the decision that matters most before another wrong turn becomes expensive.',
  },
  {
    kicker: 'Direction',
    title: 'Choose higher-value skill direction with better trade-offs',
    body: 'The goal is not generic advice. It is stronger path decisions around skill direction, market reality, risk, and long-term upside.',
  },
  {
    kicker: 'Growth',
    title: 'Build proof, positioning, and stronger financial direction',
    body: 'Good guidance should move toward proof of work, stronger positioning, income growth, and a more realistic path toward achieving earlier financial freedom.',
  },
];

const defaultProcessItems: ProcessItem[] = [
  {
    title: '1. Profile, Preferences, and Work-Style Mapping',
    body: 'Map strengths, preferences, thinking style, and decision pressure before major commitments.',
  },
  {
    title: '2. High-Leverage Decision Support',
    body: 'Judge path, skill, and risk trade-offs before doubling down on the wrong direction.',
  },
  {
    title: '3. High-Value Skill Direction',
    body: 'Choose skill paths based on fit, market value, and long-term leverage.',
  },
  {
    title: '4. Proof of Work and Market Validation',
    body: 'Build practical signals that help the market see more than your degree alone.',
  },
  {
    title: '5. Learning Path, Personal Branding, and Tech Leverage',
    body: 'Use focused learning, clearer positioning, stronger personal branding, and practical tech leverage.',
  },
  {
    title: '6. Career Growth and Financial Freedom Planning',
    body: 'Connect skill choices to stronger income growth, optionality, and a clearer route toward achieving earlier financial freedom.',
  },
];

const trimStepNumber = (value: string) => value.replace(/^\d+\.\s*/, '');
const formatIndex = (index: number) => String(index + 1).padStart(2, '0');

const {
  sectionId = 'how-guidance-works',
  sectionClass = '',
  title = 'How practical career guidance should work',
  subtitle = 'The process should help you make better decisions, build stronger skill direction, create proof of work, and move toward achieving earlier financial freedom.',
  stageCards = defaultStageCards,
  processItems = defaultProcessItems,
} = Astro.props;
---

<section id={sectionId} class:list={['bofu-guidance-model-section', sectionClass]}>
  <div class="container">
    <h2 class="section-headline">{title}</h2>
    <p class="section-sub">{subtitle}</p>

    <div class="guidance-layout">
      <section class="journey-panel stage-panel" aria-labelledby={`${sectionId}-stages`}>
        <div class="panel-copy">
          <h3 id={`${sectionId}-stages`} class="panel-title">The shift should feel clear before it feels big</h3>
          <p class="panel-sub">
            Good guidance should reduce noise in the right order. First the situation gets clearer. Then the direction gets stronger. Then the growth path becomes easier to act on.
          </p>
        </div>

        <div class="stage-sequence">
          {stageCards.map((card, index) => (
            <article class:list={['stage-card card', index === 1 && 'is-featured']}>
              <div class="stage-topline">
                <span class="stage-index">{formatIndex(index)}</span>
                <span class="stage-kicker">{card.kicker}</span>
              </div>
              <h4>{card.title}</h4>
              <p>{card.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="journey-panel roadmap-panel" aria-labelledby={`${sectionId}-roadmap`}>
        <div class="panel-copy">
          <h3 id={`${sectionId}-roadmap`} class="panel-title">Then the work should connect like a roadmap</h3>
          <p class="panel-sub">
            Each step should build into the next one. It should look and feel like a path that moves forward, not like scattered advice that leaves you stitching things together yourself.
          </p>
        </div>

        <div class="roadmap-timeline">
          {processItems.map((item, index) => (
            <article class:list={['roadmap-step', index % 2 === 0 ? 'is-left' : 'is-right']}>
              <div class="roadmap-node" aria-hidden="true">
                <span>{formatIndex(index)}</span>
              </div>
              <div class="roadmap-card card">
                <h4>{trimStepNumber(item.title)}</h4>
                <p>{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .bofu-guidance-model-section {
    position: relative;
    overflow: hidden;
    padding: 5.8rem 0;
    scroll-margin-top: 108px;
  }

  .bofu-guidance-model-section .section-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -.03em;
    color: #fff;
    margin-bottom: .9rem;
    text-wrap: balance;
  }

  .bofu-guidance-model-section .section-sub {
    font-size: clamp(15px, 2vw, 17px);
    color: rgba(255,255,255,.68);
    line-height: 1.8;
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .guidance-layout {
    display: grid;
    gap: 1.45rem;
  }

  .journey-panel {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: 30px;
    border: 1px solid rgba(255,255,255,.12);
    background:
      radial-gradient(860px 240px at 14% -10%, rgba(45,212,191,.08), transparent 70%),
      radial-gradient(860px 260px at 88% -14%, rgba(229,184,74,.12), transparent 72%),
      linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,.018));
    box-shadow: 0 22px 56px rgba(0,0,0,.26);
  }

  .journey-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 30%);
    pointer-events: none;
  }

  .panel-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: .52rem;
    margin-bottom: 1.2rem;
  }

  .panel-title {
    font-size: clamp(1.16rem, 2vw, 1.45rem);
    line-height: 1.24;
    letter-spacing: -.02em;
    color: #fff;
    text-wrap: balance;
  }

  .panel-sub {
    max-width: 780px;
    color: rgba(255,255,255,.65);
    font-size: 14px;
    line-height: 1.76;
  }

  .stage-sequence {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .stage-card {
    position: relative;
    padding: 1.18rem 1.15rem 1.15rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.1);
    background: linear-gradient(155deg, rgba(255,255,255,.045), rgba(255,255,255,.016));
    box-shadow: 0 16px 36px rgba(0,0,0,.22);
  }

  .stage-card.is-featured {
    border-color: rgba(229,184,74,.32);
    background:
      radial-gradient(220px 120px at 50% -12%, rgba(229,184,74,.17), transparent 76%),
      linear-gradient(155deg, rgba(255,255,255,.052), rgba(255,255,255,.018));
  }

  .stage-card:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -.78rem;
    width: .82rem;
    height: 2px;
    background: linear-gradient(90deg, rgba(45,212,191,.65), rgba(229,184,74,.78));
    transform: translateY(-50%);
    z-index: 2;
  }

  .stage-card:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    right: -1.05rem;
    width: .45rem;
    height: .45rem;
    border-top: 2px solid rgba(229,184,74,.78);
    border-right: 2px solid rgba(229,184,74,.78);
    transform: translateY(-50%) rotate(45deg);
    z-index: 2;
  }

  .stage-topline {
    display: flex;
    align-items: center;
    gap: .72rem;
    margin-bottom: .9rem;
  }

  .stage-index {
    flex: 0 0 auto;
    min-width: 52px;
    padding: .46rem .72rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(45,212,191,.98), rgba(229,184,74,.96));
    color: #06101d;
    font-size: .86rem;
    font-weight: 900;
    letter-spacing: -.04em;
    text-align: center;
    box-shadow: 0 12px 24px rgba(0,0,0,.22);
  }

  .stage-kicker {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 .85rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.05);
    color: rgba(255,255,255,.7);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .stage-card.is-featured .stage-kicker {
    border-color: rgba(229,184,74,.26);
    background: rgba(229,184,74,.13);
    color: #f8df9b;
  }

  .stage-card h4 {
    font-size: 1.06rem;
    line-height: 1.46;
    color: #fff;
    margin-bottom: .5rem;
    text-wrap: balance;
  }

  .stage-card p {
    color: rgba(255,255,255,.72);
    font-size: 14px;
    line-height: 1.78;
  }

  .roadmap-timeline {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    padding: .2rem 0;
  }

  .roadmap-timeline::before {
    content: '';
    position: absolute;
    top: .35rem;
    bottom: .35rem;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(45,212,191,.7), rgba(229,184,74,.86));
    box-shadow: 0 0 0 6px rgba(255,255,255,.02);
  }

  .roadmap-step {
    position: relative;
    width: calc(50% - 1.65rem);
  }

  .roadmap-step.is-left {
    justify-self: start;
  }

  .roadmap-step.is-right {
    justify-self: end;
  }

  .roadmap-step::before {
    content: '';
    position: absolute;
    top: 1.55rem;
    width: 1.2rem;
    height: 2px;
    background: linear-gradient(90deg, rgba(45,212,191,.62), rgba(229,184,74,.86));
  }

  .roadmap-step.is-left::before {
    right: -1.2rem;
  }

  .roadmap-step.is-right::before {
    left: -1.2rem;
  }

  .roadmap-node {
    position: absolute;
    top: 1.55rem;
    width: 50px;
    height: 50px;
    border-radius: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(45,212,191,.98), rgba(229,184,74,.96));
    color: #06101d;
    font-size: .92rem;
    font-weight: 900;
    letter-spacing: -.04em;
    box-shadow: 0 0 0 6px rgba(10,15,28,.92), 0 14px 28px rgba(0,0,0,.28);
    z-index: 2;
  }

  .roadmap-step.is-left .roadmap-node {
    right: -1.65rem;
    transform: translate(50%, -50%);
  }

  .roadmap-step.is-right .roadmap-node {
    left: -1.65rem;
    transform: translate(-50%, -50%);
  }

  .roadmap-card {
    position: relative;
    padding: 1.12rem 1.12rem 1rem;
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,.1);
    background: linear-gradient(155deg, rgba(12,18,31,.9), rgba(255,255,255,.03));
    box-shadow: 0 18px 36px rgba(0,0,0,.24);
  }

  .roadmap-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid transparent;
    background: linear-gradient(135deg, rgba(45,212,191,.16), rgba(229,184,74,.08)) border-box;
    -webkit-mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .roadmap-card h4 {
    font-size: 1rem;
    line-height: 1.44;
    color: #fff;
    margin-bottom: .46rem;
    text-wrap: balance;
  }

  .roadmap-card p {
    color: rgba(255,255,255,.7);
    font-size: 13.85px;
    line-height: 1.76;
  }

  @media (max-width: 980px) {
    .stage-sequence {
      grid-template-columns: 1fr;
      gap: .9rem;
      padding-left: 1.4rem;
    }

    .stage-card:not(:last-child)::after,
    .stage-card:not(:last-child)::before {
      display: none;
    }

    .stage-card {
      padding: 1rem 1rem 1rem 1.05rem;
    }

    .stage-card::before {
      content: '';
      position: absolute;
      top: 1.2rem;
      left: -1.4rem;
      width: 1rem;
      height: 2px;
      background: linear-gradient(90deg, rgba(45,212,191,.6), rgba(229,184,74,.82));
    }

    .roadmap-timeline {
      gap: .9rem;
      padding-left: 1.3rem;
    }

    .roadmap-timeline::before {
      left: 1rem;
      transform: none;
    }

    .roadmap-step,
    .roadmap-step.is-left,
    .roadmap-step.is-right {
      width: 100%;
      justify-self: stretch;
    }

    .roadmap-step::before {
      top: 1.3rem;
      left: -1.3rem;
      right: auto;
      width: .98rem;
    }

    .roadmap-step.is-left .roadmap-node,
    .roadmap-step.is-right .roadmap-node {
      left: 1rem;
      right: auto;
      transform: translate(-50%, -50%);
    }

    .roadmap-card {
      margin-left: 1.85rem;
      padding: 1rem 1rem 1rem 1.02rem;
    }
  }

  @media (max-width: 560px) {
    .bofu-guidance-model-section {
      padding: 4.8rem 0;
    }

    .journey-panel {
      padding: 1rem .92rem;
      border-radius: 24px;
    }

    .panel-title {
      font-size: 1.08rem;
    }

    .panel-sub {
      font-size: 13.5px;
      line-height: 1.72;
    }

    .stage-card {
      padding: 1rem .92rem .96rem;
    }

    .stage-topline {
      flex-wrap: wrap;
      gap: .6rem;
      margin-bottom: .75rem;
    }

    .stage-index {
      min-width: 48px;
      padding: .42rem .64rem;
      font-size: .82rem;
    }

    .stage-kicker {
      min-height: 32px;
      padding: 0 .72rem;
      font-size: 10.5px;
      letter-spacing: .08em;
    }

    .stage-card h4,
    .roadmap-card h4 {
      font-size: .96rem;
    }

    .stage-card p,
    .roadmap-card p {
      font-size: 13.2px;
    }

    .roadmap-timeline {
      padding-left: 1.12rem;
    }

    .roadmap-timeline::before {
      left: .84rem;
    }

    .roadmap-step::before {
      left: -1.12rem;
      width: .86rem;
    }

    .roadmap-step.is-left .roadmap-node,
    .roadmap-step.is-right .roadmap-node {
      left: .84rem;
    }

    .roadmap-node {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      font-size: .82rem;
      box-shadow: 0 0 0 5px rgba(10,15,28,.92), 0 12px 24px rgba(0,0,0,.24);
    }

    .roadmap-card {
      margin-left: 1.7rem;
      padding: .94rem .92rem .94rem 1rem;
    }
  }
</style>
