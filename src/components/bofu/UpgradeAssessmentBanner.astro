---
// A prominent cross-sell card pointing a visitor on one of the shorter,
// single-purpose quizzes (aptitude-only or stream-only, ~15 questions)
// toward the main, full-depth stage assessment instead. Placed just below
// the hero on the shorter quiz's own page, before the visitor invests time
// answering questions on the narrower test.
interface Props {
  href: string;
  quizName: string;
  points: string[];
  ctaLabel?: string;
}

const { href, quizName, points, ctaLabel = 'Take the Full Assessment — Free' } = Astro.props;
---

<section class="upgrade-banner-wrap">
  <div class="container">
    <a href={href} class="upgrade-banner card">
      <div class="upgrade-banner-badge">
        <span class="dot"></span>
        Recommended · Goes Deeper Than This Quiz
      </div>
      <h2 class="upgrade-banner-title">
        Before you start, see the <span class="gold-text">complete picture</span>
      </h2>
      <p class="upgrade-banner-body">
        {quizName} looks at one thing. Our main Class 10 and Below Assessment is the
        all-in-one report — it includes everything this quiz checks, plus a lot more, in a
        single free result.
      </p>
      <ul class="upgrade-banner-points">
        {points.map((point) => (
          <li><span class="check-icon">✓</span>{point}</li>
        ))}
      </ul>
      <span class="btn-gold upgrade-banner-cta">{ctaLabel}</span>
      <span class="upgrade-banner-note">34 insight sections · Free · Instant result</span>
    </a>
  </div>
</section>

<style>
  .upgrade-banner-wrap { padding: 0 0 1rem; }
  .upgrade-banner {
    display: block;
    padding: 1.75rem 2rem;
    border: 1px solid rgba(229, 184, 74, 0.35);
    background: linear-gradient(135deg, rgba(229, 184, 74, 0.09), rgba(45, 212, 191, 0.05));
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .upgrade-banner:hover {
    transform: translateY(-2px);
    border-color: rgba(229, 184, 74, 0.6);
    box-shadow: 0 10px 32px rgba(229, 184, 74, 0.18);
  }
  .upgrade-banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }
  .upgrade-banner-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
  }
  .upgrade-banner-title {
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }
  .upgrade-banner-body {
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 1rem;
    max-width: 62ch;
  }
  .upgrade-banner-points {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 1.5rem;
    margin: 0 0 1.35rem;
    padding: 0;
    max-width: 56rem;
  }
  .upgrade-banner-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }
  .upgrade-banner-points .check-icon {
    color: var(--teal);
    font-weight: 800;
    flex-shrink: 0;
  }
  .upgrade-banner-cta {
    display: inline-flex;
    margin-right: 0.9rem;
  }
  .upgrade-banner-note {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .upgrade-banner { padding: 1.4rem 1.3rem; }
    .upgrade-banner-points { grid-template-columns: 1fr; }
    .upgrade-banner-cta { display: flex; justify-content: center; margin: 0 0 0.75rem; }
    .upgrade-banner-note { display: block; text-align: center; }
  }
</style>
