---
import fs from 'node:fs';
import path from 'node:path';
import { BOFU_IMAGE_ALT, BOFU_IMAGE_TITLE, BOFU_PAGE_IMAGES } from '../../config/bofuImages';

export interface Props {
  slug?: string;
  eager?: boolean;
}

const base = '/services/career-counselling-and-career-guidance/';
const { slug: slugProp, eager = true } = Astro.props;
const pathname = Astro.url.pathname;
const slug = slugProp ?? (pathname.startsWith(base) ? pathname.slice(base.length).replace(/\/$/, '') : '');
const id = pathname === '/services/' || pathname === '/services'
  ? 'hero-hub'
  : pathname.startsWith('/services/assessments/')
    ? 'hero-assessment'
    : BOFU_PAGE_IMAGES[slug];
const exists = id ? fs.existsSync(path.join(process.cwd(), 'public', 'images', 'bofu', `${id}.webp`)) : false;
const alt = id ? (BOFU_IMAGE_ALT[id] ?? '') : '';
const showDiagrams = slug === '' || slug === 'career-guidance';
---

{exists && (
  <figure class="bofu-image">
    <img
      src={`/images/bofu/${id}.webp`}
      alt={alt}
      title={BOFU_IMAGE_TITLE[id] ?? alt}
      width="1600"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <figcaption>{alt}</figcaption>
  </figure>
)}

{showDiagrams && (
  <div class="bofu-diagrams" aria-label="Career guidance diagrams">
    <figure class="bofu-image"><img src="/images/bofu/session-flow.svg" alt="Five-stage career guidance session flow from context to review" title="How a guidance session moves from context to review" width="1600" height="720" loading="lazy" /><figcaption>A guidance session moves from context to clarity, options, a skill plan and review.</figcaption></figure>
    <figure class="bofu-image"><img src="/images/bofu/skill-portfolio-chain.svg" alt="Skill portfolio chain from strengths to financial freedom" title="How strengths become skills, proof, paid work and freedom" width="1600" height="720" loading="lazy" /><figcaption>Strengths become skills, skills become visible proof, and proof leads to paid work and more freedom.</figcaption></figure>
  </div>
)}

<style>
  .bofu-image {
    margin: 24px auto 0;
    max-width: 960px;
    padding: 0 16px;
  }
  .bofu-image figcaption {
    margin-top: 10px;
    color: rgba(255,255,255,.62);
    font-size: 13px;
    line-height: 1.5;
  }
  .bofu-image img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
  }
</style>
