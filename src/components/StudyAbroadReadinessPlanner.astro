<section class="sar" id="study-abroad-readiness-planner" aria-labelledby="sar-title">
  <p class="eyebrow">INTERNATIONAL STUDY DUE DILIGENCE</p>
  <h2 id="sar-title">Check the whole study-abroad decision</h2>
  <p>Turn an attractive offer or destination into a reviewable plan: verify the institution, total cost, immigration conditions, daily-life support and a backup or return route.</p>
  <p class="sar-note"><b>Limit:</b> this tool does not recommend a country, verify a visa, predict a job, or replace an official university or government notice. Rules and costs change.</p>
  <form id="sar-form" class="sar-form" novalidate>
    <label>Course, institution or destination<input name="route" maxlength="180" placeholder="Use the exact name you are researching" required /></label>
    <label>How strong is your official-source check?<select name="source"><option value="0">I have only promotional information</option><option value="1">I found official pages but need to date-check them</option><option value="2">I saved current institution and government sources</option></select></label>
    <label>How clear is the full cost?<select name="cost"><option value="0">Only tuition is known</option><option value="1">Tuition plus some living costs</option><option value="2">Tuition, living, travel, deposits and contingency are mapped</option></select></label>
    <label>How clear are the conditions after study?<select name="conditions"><option value="0">I am relying on hearsay</option><option value="1">I found general information</option><option value="2">I checked current official visa, work and return conditions</option></select></label>
    <label>What is your backup or return question?<textarea name="backup" rows="3" maxlength="600" placeholder="For example: what happens if funding, visa, health or employment plans change?"></textarea></label>
    <div class="sar-actions"><button class="sar-primary" type="submit">Create readiness plan</button><button type="button" data-sar="clear">Clear</button></div>
    <p id="sar-status" class="sar-status" role="status" aria-live="polite"></p>
  </form>
  <div id="sar-result" class="sar-result" hidden></div>
</section>
<script>
  const sarForm = document.querySelector<HTMLFormElement>('#sar-form');
  const sarResult = document.querySelector<HTMLDivElement>('#sar-result');
  const sarStatus = document.querySelector<HTMLParagraphElement>('#sar-status');
  const sarClear = document.querySelector<HTMLButtonElement>('[data-sar="clear"]');
  if (!sarForm || !sarResult || !sarStatus || !sarClear) throw new Error('Study-abroad readiness planner markup is incomplete.');
  const sarEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  sarForm.addEventListener('submit', (event) => { event.preventDefault(); if (!sarForm.checkValidity()) { sarForm.reportValidity(); return; } const data = Object.fromEntries([...sarForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea')].map((field) => [field.name, field.value])); const score = Number(data.source) + Number(data.cost) + Number(data.conditions); const band = score >= 5 ? 'ready for a final evidence review' : score >= 3 ? 'partly researched-close the gaps' : 'early stage-do not commit yet'; const first = Number(data.source) < 2 ? 'Save the current institution, immigration and regulator pages, including dates and who issued each rule.' : Number(data.cost) < 2 ? 'Build a total-cost sheet covering tuition, living, travel, deposits, insurance, currency movement and a contingency.' : Number(data.conditions) < 2 ? 'Verify current visa, work, renewal and return conditions from the relevant government sources.' : 'Ask an independent person to challenge the assumptions and confirm your backup route.'; sarResult.innerHTML = `<div class="sar-lead"><span>${sarEsc(data.route)} · readiness signal</span><h3>${sarEsc(band)} · ${score}/6</h3><p>This signal measures checklist completion, not admission, visa or employment probability.</p></div><div class="sar-grid"><article><b>First action</b><p>${sarEsc(first)}</p></article><article><b>Backup or return question</b><p>${data.backup ? sarEsc(data.backup) : 'Write what you would do if the primary study, funding or work plan changes.'}</p></article></div><div class="sar-next"><h3>Before paying a deposit</h3><ul><li>Check the current offer, recognition, refund terms and total cost with the issuing institution.</li><li>Verify visa, work, health-insurance and post-study conditions on the relevant official government source.</li><li>Separate a course’s marketing claims from evidence about teaching, support and outcomes.</li><li>Keep a lower-cost, staged or return route visible; do not treat migration or employment as guaranteed.</li></ul></div>`; sarResult.hidden = false; sarStatus.textContent = 'Readiness plan created from your entries; nothing was sent.'; });
  sarClear.addEventListener('click', () => { sarForm.reset(); sarResult.hidden = true; sarStatus.textContent = 'Cleared.'; });
</script>
<style>
  .sar{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.sar h2{margin:.2rem 0 .6rem}.sar>p{max-width:800px;line-height:1.65}.sar-note,.sar-status{color:rgba(255,255,255,.68);font-size:.88rem}.sar-form{display:grid;gap:1rem;margin-top:1.4rem}.sar-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.sar-form input,.sar-form select,.sar-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.sar-actions{display:flex;gap:.6rem;flex-wrap:wrap}.sar-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.sar-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.sar-result{margin-top:1.3rem}.sar-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.sar-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.sar-lead h3{margin:.4rem 0;font-size:1.5rem}.sar-lead p,.sar-grid p,.sar-next li{line-height:1.6;color:rgba(255,255,255,.75)}.sar-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.sar-grid article,.sar-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.sar-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.sar-next h3{margin-top:0}@media(max-width:650px){.sar-grid{grid-template-columns:1fr}}
</style>
