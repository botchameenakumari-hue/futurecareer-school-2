---
import {
  Activity,
  BarChart3,
  BriefcaseBusiness,
  CalendarDays,
  CircleAlert,
  ArrowLeft,
  BookOpen,
  Building2,
  Check,
  ChevronRight,
  ClipboardCheck,
  Clock,
  Compass,
  Copy,
  Eye,
  FlaskConical,
  GraduationCap,
  House,
  KeyRound,
  Layers3,
  LayoutDashboard,
  ListChecks,
  ListPlus,
  Lightbulb,
  Lock,
  LogOut,
  Mail,
  Megaphone,
  Menu,
  Plus,
  Printer,
  RefreshCw,
  Route,
  Search,
  ShieldCheck,
  SlidersHorizontal,
  Target,
  UserPlus,
  Users,
  Wrench,
  X,
} from '@lucide/astro';

const showRoleLab = import.meta.env.DEV;
---

<div id="hierarchy-workspace" class="hierarchy-workspace" data-dev-role-lab={showRoleLab ? 'true' : 'false'}>
  <div id="workspace-boot" class="workspace-boot" aria-live="polite">
    <span class="brand-mark" aria-hidden="true"><Compass size={22} stroke-width={2.2} /></span>
    <span class="boot-copy"><strong>Future Career School</strong><small>Opening your workspace</small></span>
    <span class="boot-loader" aria-hidden="true"></span>
  </div>

  <section id="auth-shell" class="auth-shell" aria-labelledby="auth-title" hidden>
    <div class="auth-context">
      <a class="back-link" href="/"><ArrowLeft size={16} aria-hidden="true" /> Future Career School</a>
      <div class="auth-brand"><span class="brand-mark"><Compass size={24} /></span><strong>Career Operations</strong></div>
      <div class="auth-message">
        <p class="eyebrow">School workspace</p>
        <h1 id="auth-title">Your career workspace, ready when you are.</h1>
        <p>Sign in to continue your work and keep every student record in one place.</p>
      </div>
    </div>

    <div class="auth-entry">
      <div class="auth-entry-inner">
        <div id="auth-mode-tabs" class="auth-mode-tabs" role="tablist" aria-label="Account access">
          <button class="is-active" type="button" role="tab" aria-selected="true" data-auth-mode="sign-in">Sign in</button>
          <button type="button" role="tab" aria-selected="false" data-auth-mode="recovery">Set or reset password</button>
        </div>

        <div id="sign-in-panel">
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><Lock size={19} /></span>
            <div><p class="eyebrow">Approved access</p><h2>Sign in</h2></div>
          </div>
          <p class="auth-note">Use the email address and password for your approved account.</p>

          <form id="sign-in-form" class="stack-form" novalidate>
            <label>
              <span>Email</span>
              <span class="input-shell"><Mail size={17} aria-hidden="true" /><input id="sign-in-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" /></span>
            </label>
            <label>
              <span>Password</span>
              <span class="input-shell"><KeyRound size={17} aria-hidden="true" /><input id="sign-in-password" name="password" type="password" autocomplete="current-password" minlength="4" required placeholder="Your password" /><button class="icon-button input-action" id="password-toggle" type="button" aria-label="Show password" title="Show password"><Eye size={17} /></button></span>
            </label>
            <button id="sign-in-submit" class="primary-button full-button" type="submit">Sign in <ChevronRight size={17} /></button>
          </form>
          <p class="account-policy-note">New accounts are created and approved by your school.</p>
          <div id="auth-status" class="form-status" aria-live="polite"></div>
        </div>

        <div id="recovery-request-panel" hidden>
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><KeyRound size={19} /></span>
            <div><p class="eyebrow">Account access</p><h2>Set or reset password</h2></div>
          </div>
          <p class="auth-note">Enter the email address on your approved account.</p>
          <form id="recovery-request-form" class="stack-form" novalidate>
            <label>
              <span>Email</span>
              <span class="input-shell"><Mail size={17} aria-hidden="true" /><input id="recovery-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" /></span>
            </label>
            <button id="recovery-submit" class="primary-button full-button" type="submit">Email secure link <ChevronRight size={17} /></button>
          </form>
          <div id="recovery-status" class="form-status" aria-live="polite"></div>
        </div>

        <div id="config-warning" class="notice danger" hidden>
          <CircleAlert size={17} aria-hidden="true" /> The workspace connection is missing.
        </div>
        <div id="load-warning" class="notice warning" hidden>
          <CircleAlert size={17} aria-hidden="true" /> The workspace did not finish opening.
          <button id="reload-workspace" class="text-button" type="button">Reload</button>
        </div>

        {showRoleLab && (
          <section id="quick-role-access" class="quick-role-access" hidden aria-labelledby="quick-role-title">
            <div class="section-heading compact"><div><p class="eyebrow">Local Role Lab</p><h3 id="quick-role-title">Test another role</h3></div><FlaskConical size={18} /></div>
            <div id="quick-role-buttons" class="quick-role-buttons"></div>
          </section>
        )}

        <div id="password-setup-panel" hidden>
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><ShieldCheck size={19} /></span>
            <div><p id="password-setup-eyebrow" class="eyebrow">Invitation accepted</p><h2 id="password-setup-title">Choose your first password</h2></div>
          </div>
          <p id="password-setup-note" class="auth-note">Secure this account for future sign-ins.</p>

          <form id="password-setup-form" class="stack-form" novalidate>
            <input id="password-setup-email" name="email" type="email" autocomplete="username" hidden />
            <label>
              <span>New password</span>
              <span class="input-shell"><KeyRound size={17} aria-hidden="true" /><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="4" required placeholder="Create a password" /><button class="icon-button input-action" id="new-password-toggle" type="button" aria-label="Show passwords" title="Show passwords"><Eye size={17} /></button></span>
            </label>
            <div id="password-requirements" class="password-requirements" aria-label="Password requirements">
              <span data-password-check="length">At least 4 characters. Any characters are fine.</span>
            </div>
            <label>
              <span>Confirm password</span>
              <span class="input-shell"><Check size={17} aria-hidden="true" /><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="4" required placeholder="Repeat your password" /></span>
            </label>
            <button id="password-setup-submit" class="primary-button full-button" type="submit">Save password <ChevronRight size={17} /></button>
            <button id="password-setup-sign-out" class="text-button" type="button">Use another account</button>
          </form>
          <div id="password-setup-status" class="form-status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="access-shell" class="access-shell" hidden aria-labelledby="access-title">
    <span class="access-icon"><ShieldCheck size={26} /></span>
    <p class="eyebrow">Account access</p>
    <h1 id="access-title">This account is not active</h1>
    <p id="access-message">Ask the Admin to review this account.</p>
    <button id="access-sign-out" class="secondary-button" type="button"><LogOut size={16} /> Sign out</button>
  </section>

  <div id="workspace-shell" class="workspace-shell" hidden>
    <aside class="workspace-sidebar">
      <a class="sidebar-brand" href="/dashboard"><span class="brand-mark"><Compass size={21} /></span><span><strong>Future Career School</strong><small>Career Operations</small></span></a>

      <div class="sidebar-scope">
        <span id="sidebar-initials" class="avatar">FC</span>
        <span><strong id="sidebar-user-name">Your account</strong><small id="sidebar-role">Workspace member</small></span>
      </div>

      <div id="sidebar-branch-context" class="sidebar-branch-context">
        <Building2 size={16} aria-hidden="true" />
        <span><small>Operating scope</small><strong id="sidebar-branch-name">All branches</strong></span>
        <code id="sidebar-branch-code">ORG</code>
      </div>

      <nav class="workspace-nav" aria-label="Workspace navigation">
        <button class="nav-item is-active" type="button" data-view-target="overview" data-roles="all" aria-current="page"><LayoutDashboard size={18} /><span>Overview</span></button>
        <button class="nav-item" type="button" data-view-target="caseload" data-roles="admin,branch_head,head_coach,coach"><BriefcaseBusiness size={18} /><span>Caseload</span><span id="caseload-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="cohorts" data-roles="admin,branch_head,head_coach,coach"><Layers3 size={18} /><span>Cohorts</span><span id="cohort-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="people" data-roles="admin,branch_head,head_coach,coach"><Users size={18} /><span>People & access</span><span id="people-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="accounts" data-roles="admin,branch_head,head_coach,coach"><ClipboardCheck size={18} /><span>Account requests</span><span id="request-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="branches" data-roles="admin"><Building2 size={18} /><span>Branches</span></button>
        <button class="nav-item" type="button" data-view-target="activity" data-roles="admin,branch_head"><Activity size={18} /><span>Activity log</span></button>
        <button class="nav-item" type="button" data-view-target="career" data-roles="student"><Target size={18} /><span>My coaching plan</span></button>
        <button class="nav-item" type="button" data-view-target="constraints" data-roles="student"><SlidersHorizontal size={18} /><span>My context</span></button>
        {showRoleLab && <button class="nav-item role-lab-nav" type="button" data-view-target="role-lab" data-roles="admin"><FlaskConical size={18} /><span>Role Lab</span></button>}
      </nav>

      <div class="sidebar-foot">
        <a href="/" class="site-link"><House size={16} /> Main website homepage</a>
        <button id="sign-out-button" class="sign-out-button" type="button"><LogOut size={16} /><span>Sign out</span></button>
      </div>
    </aside>

    <header class="mobile-header">
      <button id="mobile-menu-button" class="icon-button" type="button" aria-label="Open navigation" title="Navigation"><Menu size={20} /></button>
      <a class="mobile-brand" href="/dashboard"><span class="brand-mark"><Compass size={18} /></span><strong>Career Operations</strong></a>
      <span id="mobile-initials" class="avatar small">FC</span>
    </header>

    <main class="workspace-main">
      <header class="workspace-topbar">
        <div class="topbar-copy">
          <div><p id="view-eyebrow" class="eyebrow">Workspace</p><h1 id="view-title">Overview</h1><p id="view-subtitle" class="view-subtitle"></p></div>
          <div id="workspace-branch-context" class="workspace-branch-context"><Building2 size={14} aria-hidden="true" /><span id="workspace-branch-name">All branches</span><code id="workspace-branch-code">ORG</code></div>
        </div>
        <div class="topbar-actions">
          <button id="refresh-button" class="icon-button" type="button" aria-label="Refresh workspace" title="Refresh"><RefreshCw size={17} /></button>
          <button id="new-branch-button" class="secondary-button" type="button" data-roles="admin"><Building2 size={16} /><span>New branch</span></button>
          <button id="new-account-button" class="primary-button" type="button" data-roles="admin,branch_head,head_coach,coach"><UserPlus size={16} /><span id="new-account-label">Create account</span></button>
        </div>
      </header>

      <div id="workspace-status" class="workspace-status" aria-live="polite"></div>
      <div id="coaching-schema-warning" class="notice warning coaching-schema-warning" hidden><CircleAlert size={17} aria-hidden="true" /><span>The coaching workspace is ready in this build. Apply the included Supabase migration before using its records in production.</span></div>

      <section class="workspace-view is-active" data-workspace-view="overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="sr-only">Overview</h2>
        <div id="overview-metrics" class="metric-grid"></div>
        <div class="overview-grid">
          <section class="work-panel attention-panel"><div class="section-heading"><div><p class="eyebrow">Now</p><h2 id="attention-title">Needs attention</h2></div><Clock size={19} /></div><div id="attention-list" class="attention-list"></div></section>
          <section class="work-panel structure-panel"><div class="section-heading"><div><p class="eyebrow">Structure</p><h2 id="structure-title">Your scope</h2></div><Users size={19} /></div><div id="structure-list" class="structure-list"></div></section>
        </div>
        <section id="student-focus" class="student-focus" hidden><div><p class="eyebrow">Next useful move</p><h2 id="student-focus-title">Complete your career context</h2><p id="student-focus-copy"></p></div><button id="student-focus-action" class="primary-button" type="button">Continue <ChevronRight size={16} /></button></section>
      </section>

      <section class="workspace-view" data-workspace-view="caseload" aria-labelledby="caseload-heading" hidden>
        <div class="view-toolbar">
          <div><p class="eyebrow">Coaching operations</p><h2 id="caseload-heading">Student caseload</h2><p class="view-copy">Prioritise reviews, decisions, skill gaps, and follow-through across your scope.</p></div>
          <div class="filter-row">
            <label class="search-field"><Search size={16} /><span class="sr-only">Search students</span><input id="caseload-search" type="search" placeholder="Search students" /></label>
            <label><span class="sr-only">Filter coaching stage</span><select id="caseload-stage-filter"><option value="all">All stages</option><option value="intake">Intake</option><option value="self-discovery">Self-discovery</option><option value="career-exploration">Career exploration</option><option value="option-validation">Option validation</option><option value="decision">Decision</option><option value="execution">Execution</option><option value="follow-up">Follow-up</option></select></label>
            <label><span class="sr-only">Filter attention</span><select id="caseload-attention-filter"><option value="all">All students</option><option value="needs-attention">Needs attention</option><option value="overdue">Overdue actions</option><option value="no-session">No cohort session announced</option><option value="skill-gaps">Core skill gaps</option></select></label>
          </div>
        </div>
        <div id="caseload-summary" class="caseload-summary"></div>
        <div class="table-shell caseload-table-shell"><table><thead><tr><th>Student</th><th>Coaching stage</th><th>Decision work</th><th>Skills</th><th>Follow-through</th><th>Next contact</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="caseload-table-body"></tbody></table><div id="caseload-empty" class="empty-state" hidden>No students match this view.</div></div>
      </section>

      <section class="workspace-view" data-workspace-view="cohorts" aria-labelledby="cohorts-heading" hidden>
        <div id="cohort-index-view">
          <div class="view-toolbar">
            <div><p class="eyebrow">Group coaching delivery</p><h2 id="cohorts-heading">Cohorts and session announcements</h2><p class="view-copy">Place every student in a working group, announce the next session, and keep delivery visible.</p></div>
            <button id="new-cohort-button" class="primary-button" type="button"><Plus size={16} /> New cohort</button>
          </div>
          <div id="cohort-summary" class="caseload-summary"></div>
          <div class="filter-row cohort-filter-row">
            <label class="search-field"><Search size={16} /><span class="sr-only">Search cohorts</span><input id="cohort-search" type="search" placeholder="Search cohorts" /></label>
            <label><span class="sr-only">Filter cohort status</span><select id="cohort-status-filter"><option value="all">All statuses</option><option value="active">Active</option><option value="upcoming">Upcoming</option><option value="completed">Completed</option><option value="archived">Archived</option></select></label>
          </div>
          <div class="table-shell cohort-table-shell"><table><thead><tr><th>Cohort</th><th>Programme</th><th>Lead</th><th>Students</th><th>Next session</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="cohort-table-body"></tbody></table><div id="cohort-empty" class="empty-state" hidden>No cohorts match this view.</div></div>
        </div>
        <div id="cohort-detail-view" hidden>
          <div class="record-navigation"><button id="cohort-detail-back" class="back-button" type="button"><ArrowLeft size={16} /> Cohorts</button><span class="row-actions"><button id="edit-cohort-button" class="secondary-button" type="button">Edit cohort</button><button id="announce-session-button" class="primary-button" type="button"><Megaphone size={16} /> Announce session</button></span></div>
          <header class="record-header cohort-detail-header"><div><p class="eyebrow">Cohort workspace</p><h2 id="cohort-detail-name">Cohort</h2><p id="cohort-detail-meta"></p></div><div class="record-header-status"><span id="cohort-detail-stage" class="stage-badge"></span><span id="cohort-detail-status" class="status-badge"></span></div></header>
          <div id="cohort-detail-summary" class="student-plan-summary"></div>
          <div class="cohort-detail-grid">
            <section class="cohort-roster-band"><div class="section-heading"><div><p class="eyebrow">Active membership</p><h3>Student roster</h3></div><button id="move-student-button" class="secondary-button" type="button"><Plus size={16} /> Add or move student</button></div><div id="cohort-roster" class="cohort-roster"></div></section>
            <section class="cohort-session-band"><div class="section-heading"><div><p class="eyebrow">Coaching delivery</p><h3>Announcements and attendance</h3></div><CalendarDays size={18} /></div><div id="cohort-session-list" class="session-list"></div></section>
          </div>
        </div>
      </section>

      <section class="workspace-view" data-workspace-view="people" aria-labelledby="people-heading" hidden>
        <div class="view-toolbar">
          <div><p class="eyebrow">Accounts and reporting lines</p><h2 id="people-heading">People & access</h2></div>
          <div class="filter-row">
            <label class="search-field"><Search size={16} /><span class="sr-only">Search people</span><input id="people-search" type="search" placeholder="Search name or email" /></label>
            <label><span class="sr-only">Filter role</span><select id="people-role-filter"><option value="all">All roles</option><option value="branch_head">Branch Heads</option><option value="head_coach">Head Coaches</option><option value="coach">Coaches</option><option value="student">Students</option></select></label>
          </div>
        </div>
        <div class="table-shell"><table><thead><tr><th>Person</th><th>Role</th><th>Branch</th><th>Reports to</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="people-table-body"></tbody></table><div id="people-empty" class="empty-state" hidden>No matching people.</div></div>
      </section>

      <section class="workspace-view" data-workspace-view="accounts" aria-labelledby="accounts-heading" hidden>
        <div class="view-toolbar"><div><p class="eyebrow">Account control</p><h2 id="accounts-heading">Account requests</h2></div><span id="account-scope-note" class="scope-note"></span></div>
        <div id="approval-summary" class="approval-summary" hidden></div>
        <div id="request-list" class="request-list"></div>
        <div id="request-empty" class="empty-state" hidden>No account requests in this view.</div>
      </section>

      <section class="workspace-view" data-workspace-view="branches" aria-labelledby="branches-heading" hidden>
        <div class="view-toolbar"><div><p class="eyebrow">Organisation</p><h2 id="branches-heading">Branches</h2></div></div>
        <div id="branch-list" class="branch-list"></div>
      </section>

      <section class="workspace-view" data-workspace-view="activity" aria-labelledby="activity-heading" hidden>
        <div class="view-toolbar"><div><p class="eyebrow">Accountability</p><h2 id="activity-heading">Activity log</h2><p class="view-copy">Security and operational changes inside your visible scope.</p></div></div>
        <div id="activity-list" class="activity-list"></div>
        <div id="activity-empty" class="empty-state" hidden>No activity has been recorded yet.</div>
      </section>

<section class="workspace-view" data-workspace-view="student-record" aria-labelledby="student-record-heading" hidden>
  <div class="record-navigation">
    <button id="student-record-back" class="back-button" type="button"><ArrowLeft size={16} /> Caseload</button>
    <button id="print-student-brief" class="secondary-button" type="button"><Printer size={16} /> Print coaching brief</button>
  </div>
  <header class="record-header">
    <div><p class="eyebrow">Student coaching record</p><h2 id="student-record-heading">Student</h2><p id="student-record-meta"></p></div>
    <div class="record-header-status"><span id="student-record-stage" class="stage-badge"></span><span id="student-record-status" class="status-badge"></span></div>
  </header>

  <nav class="record-tabs" aria-label="Student record sections">
    <button class="is-active" type="button" data-record-tab="summary" aria-selected="true"><BarChart3 size={16} /> Summary</button>
    <button type="button" data-record-tab="careers" aria-selected="false"><Route size={16} /> Career options</button>
    <button type="button" data-record-tab="skills" aria-selected="false"><Wrench size={16} /> Skills</button>
    <button type="button" data-record-tab="sessions" aria-selected="false"><CalendarDays size={16} /> Sessions</button>
    <button type="button" data-record-tab="actions" aria-selected="false"><ListChecks size={16} /> Actions</button>
    <button type="button" data-record-tab="context" aria-selected="false"><SlidersHorizontal size={16} /> Context</button>
    <button type="button" data-record-tab="notes" aria-selected="false"><BookOpen size={16} /> Staff notes</button>
  </nav>

  <div class="record-pane is-active" data-record-pane="summary">
    <section class="case-control-band">
      <div class="section-heading"><div><p class="eyebrow">Case management</p><h3>Direction and review rhythm</h3></div><Target size={18} /></div>
      <form id="student-case-form" class="case-form">
        <div class="form-grid four">
          <label>Coaching stage<select name="coaching_stage"><option value="intake">Intake</option><option value="self-discovery">Self-discovery</option><option value="career-exploration">Career exploration</option><option value="option-validation">Option validation</option><option value="decision">Decision</option><option value="execution">Execution</option><option value="follow-up">Follow-up</option></select></label>
          <label>Case status<select name="case_status"><option value="active">Active</option><option value="on-hold">On hold</option><option value="completed">Completed</option></select></label>
          <label>Priority<select name="priority"><option value="standard">Standard</option><option value="high">High</option><option value="urgent">Urgent</option></select></label>
          <label>Review every<input name="review_cadence_days" type="number" min="1" max="180" /><span class="field-suffix">days</span></label>
        </div>
        <div class="form-grid two"><label>Decision deadline<input name="decision_deadline" type="date" /></label><label>Next review<input name="next_review_at" type="datetime-local" /></label></div>
        <div class="guided-inline-presets">
          <label>Goal starter<select id="case-goal-preset"><option value="">Choose a coaching outcome</option></select></label>
          <label>Progress starter<select id="progress-update-preset"><option value="">Choose a factual update</option></select></label>
        </div>
        <label>Coaching goal<textarea name="goal_summary" rows="2" maxlength="2000" placeholder="The concrete decision, capability, or transition this plan must deliver"></textarea></label>
        <label>Current progress summary<textarea name="progress_note" rows="3" maxlength="2000" placeholder="Progress, evidence, blocker, and next commitment"></textarea></label>
        <div class="form-actions"><span id="student-case-saved-at"></span><button class="primary-button" type="submit"><Check size={16} /> Save case</button></div>
      </form>
    </section>
    <div id="record-decision-summary" class="decision-summary"></div>
    <section class="record-timeline-band"><div class="section-heading"><div><p class="eyebrow">Coaching pulse</p><h3>Recent movement</h3></div><CalendarDays size={18} /></div><div id="record-timeline" class="record-timeline"></div></section>
  </div>

  <div class="record-pane" data-record-pane="careers" hidden>
    <div class="pane-heading"><div><p class="eyebrow">Decision workspace</p><h3>Primary direction and alternatives</h3><p>Concentrate most effort on one primary direction while keeping deliberate alternatives alive.</p></div><button class="primary-button" type="button" data-open-career-dialog><Plus size={16} /> Add option</button></div>
    <div id="record-career-focus-summary" class="career-focus-summary"></div>
    <div id="record-career-list" class="career-option-list"></div>
  </div>

  <div class="record-pane" data-record-pane="skills" hidden>
