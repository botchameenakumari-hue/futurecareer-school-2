  <form id="cohort-membership-form" method="dialog" class="dialog-form">
    <header><div><p class="eyebrow">Cohort membership</p><h2>Add or move student</h2></div><button class="icon-button" type="button" data-close-dialog="cohort-membership-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
    <div class="dialog-body"><input name="cohort_id" type="hidden" /><p id="membership-context" class="dialog-context"></p><label>Student<select id="membership-student" name="student_id" required></select></label><div id="membership-status" class="form-status"></div></div>
    <footer><button class="secondary-button" type="button" data-close-dialog="cohort-membership-dialog">Cancel</button><button class="primary-button" type="submit"><Check size={16} /> Confirm membership</button></footer>
  </form>
</dialog>

<dialog id="attendance-dialog" class="workspace-dialog detail-dialog">
  <form id="attendance-form" method="dialog" class="dialog-form">
    <header><div><p class="eyebrow">Session delivery</p><h2>Attendance</h2></div><button class="icon-button" type="button" data-close-dialog="attendance-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
    <div class="dialog-body"><input name="session_id" type="hidden" /><p id="attendance-context" class="dialog-context"></p><div id="attendance-roster" class="attendance-roster"></div><div id="attendance-status" class="form-status"></div></div>
    <footer><button class="secondary-button" type="button" data-close-dialog="attendance-dialog">Cancel</button><button class="primary-button" type="submit"><Check size={16} /> Save attendance</button></footer>
  </form>
</dialog>
      <section class="workspace-view" data-workspace-view="constraints" aria-labelledby="constraints-heading" hidden>
        <div class="view-toolbar"><div><p class="eyebrow">Career context</p><h2 id="constraints-heading">My real-world constraints</h2><p class="view-copy">Keep this current so recommendations fit your actual choices.</p></div></div>
        <form id="constraints-form" class="constraints-form">
          <fieldset><legend>Time and money</legend><div class="form-grid three"><label>Budget range<select name="budget_range"><option value="not-set">Not set</option><option value="very-limited">Very limited</option><option value="limited">Limited</option><option value="moderate">Moderate</option><option value="flexible">Flexible</option></select></label><label>Hours available each week<input name="available_hours_per_week" type="number" min="0" max="100" /></label><label>Maximum commute (minutes)<input name="max_commute_minutes" type="number" min="0" max="360" /></label></div><label>Education timeline<input name="education_timeline" maxlength="500" placeholder="What timing are you working with?" /></label></fieldset>
          <fieldset><legend>Location and access</legend><div class="form-grid three"><label>Willing to relocate<select name="willing_to_relocate"><option value="">Not sure</option><option value="true">Yes</option><option value="false">No</option></select></label><label>Device access<select name="device_access"><option value="not-set">Not set</option><option value="shared-phone">Shared phone</option><option value="personal-phone">Personal phone</option><option value="shared-computer">Shared computer</option><option value="personal-computer">Personal computer</option></select></label><label>Internet access<select name="internet_access"><option value="not-set">Not set</option><option value="limited">Limited</option><option value="mobile-only">Mobile only</option><option value="reliable">Reliable</option></select></label></div><div class="form-grid two"><label>Relocation preferences<input name="relocation_preferences" maxlength="300" placeholder="Cities or regions, separated by commas" /></label><label>Preferred languages<input name="preferred_languages" maxlength="300" placeholder="Languages, separated by commas" /></label></div></fieldset>
          <fieldset><legend>Personal context</legend><div class="form-grid two"><label>Family expectations<textarea name="family_expectations" rows="3" maxlength="1000"></textarea></label><label>Work or care responsibilities<textarea name="work_or_care_responsibilities" rows="3" maxlength="1000"></textarea></label><label>Accessibility support<textarea name="accessibility_support" rows="3" maxlength="1000"></textarea></label><label>Schedule or health considerations<textarea name="schedule_or_health_considerations" rows="3" maxlength="1000"></textarea></label></div></fieldset>
          <fieldset><legend>Decision boundaries</legend><div class="form-grid two"><label>Risk comfort (1-5)<input name="risk_tolerance" type="range" min="1" max="5" value="3" /><output id="risk-value">3</output></label><label>Study abroad interest<select name="study_abroad_interest"><option value="not-sure">Not sure</option><option value="no">No</option><option value="maybe">Maybe</option><option value="yes">Yes</option></select></label></div><div class="preset-input-stack"><label>Non-negotiables<input name="non_negotiables" maxlength="500" placeholder="Add your own, separated by commas" /></label><label>Add a common boundary<select id="non-negotiable-preset"><option value="">Choose and add</option></select></label></div><label>Anything else your coach should understand<textarea name="student_notes" rows="4" maxlength="2000"></textarea></label></fieldset>
          <div class="sticky-form-actions"><span id="constraints-saved-at"></span><button id="save-constraints" class="primary-button" type="submit"><Check size={16} /> Save context</button></div>
        </form>
      </section>

      {showRoleLab && (
        <section class="workspace-view" data-workspace-view="role-lab" aria-labelledby="role-lab-heading" hidden>
          <div class="view-toolbar"><div><p class="eyebrow">Local testing</p><h2 id="role-lab-heading">Role Lab</h2><p class="view-copy">Fresh private passwords are generated each time this lab is prepared.</p></div><button id="seed-role-lab" class="primary-button" type="button"><FlaskConical size={16} /> Prepare test roles</button></div>
          <div class="notice secure"><ShieldCheck size={18} /><span>Available only from this local dashboard. Production builds omit this screen.</span></div>
          <div id="role-lab-credentials" class="credential-grid"></div>
          <section class="lab-approval-strip"><div><p class="eyebrow">Approval test</p><h3>Riya Approval Student</h3><p>A pending student request appears in Accounts after the lab is prepared.</p></div><button class="secondary-button" type="button" data-open-view="accounts">Open accounts <ChevronRight size={16} /></button></section>
        </section>
      )}
    </main>

    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile workspace navigation"></nav>
  </div>

  <dialog id="account-dialog" class="workspace-dialog">
    <form id="account-form" method="dialog" class="dialog-form">
      <header><div><p id="account-dialog-eyebrow" class="eyebrow">Hierarchy account</p><h2 id="account-dialog-title">Create account</h2></div><button class="icon-button" type="button" data-close-dialog="account-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
      <div class="dialog-body">
        <div id="account-dialog-policy" class="notice secure"><ShieldCheck size={17} aria-hidden="true" /><span>Only the Admin can activate an account.</span></div>
        <div class="form-grid two"><label>Full name<input name="fullName" maxlength="100" required /></label><label>Email<input name="email" type="email" maxlength="254" required /></label></div>
        <div class="form-grid two"><label>Role<select id="account-role" name="role" required></select></label><label>Branch<select id="account-branch" name="branchId" required></select></label></div>
        <label>Reports to<select id="account-supervisor" name="supervisorId" required></select></label>
        <label id="approve-now-row" class="switch-row"><span><strong>Approve immediately</strong><small>Create the approved login and start password setup.</small></span><input name="approveNow" type="checkbox" checked /></label>
        <div id="account-form-status" class="form-status" aria-live="polite"></div>
      </div>
      <footer><button class="secondary-button" type="button" data-close-dialog="account-dialog">Cancel</button><button id="account-submit" class="primary-button" type="submit"><UserPlus size={16} /><span id="account-submit-label">Create account</span></button></footer>
    </form>
  </dialog>

  <dialog id="branch-dialog" class="workspace-dialog small-dialog">
    <form id="branch-form" method="dialog" class="dialog-form">
      <header><div><p class="eyebrow">Organisation</p><h2 id="branch-dialog-title">New branch</h2></div><button class="icon-button" type="button" data-close-dialog="branch-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
      <div class="dialog-body"><input id="branch-id" name="branchId" type="hidden" /><label>Branch name<input id="branch-name" name="name" maxlength="100" required /></label><div class="form-grid two"><label>Branch code<input id="branch-code" name="code" maxlength="20" placeholder="Automatic" /></label><label>City<input id="branch-city" name="city" maxlength="100" /></label></div><label id="branch-status-row" hidden>Status<select id="branch-status" name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label><div id="branch-form-status" class="form-status"></div></div>
      <footer><button class="secondary-button" type="button" data-close-dialog="branch-dialog">Cancel</button><button id="branch-submit" class="primary-button" type="submit"><Plus size={16} /><span id="branch-submit-label">Create branch</span></button></footer>
    </form>
  </dialog>

  <dialog id="manage-account-dialog" class="workspace-dialog">
    <form id="manage-account-form" method="dialog" class="dialog-form">
      <header><div><p class="eyebrow">Admin account control</p><h2>Manage account</h2></div><button class="icon-button" type="button" data-close-dialog="manage-account-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
      <div class="dialog-body">
        <input id="managed-user-id" name="userId" type="hidden" />
        <div class="managed-identity"><span id="managed-user-initials" class="avatar">FC</span><span><strong id="managed-user-heading">Account holder</strong><small id="managed-user-meta"></small></span></div>
        <label>Full name<input id="managed-full-name" name="fullName" maxlength="100" required /></label>
        <div class="form-grid two"><label>Branch<select id="managed-branch" name="branchId" required></select></label><label>Reports to<select id="managed-supervisor" name="supervisorId" required></select></label></div>
        <div class="notice warning"><Building2 size={17} aria-hidden="true" /><span>Move direct reports first before changing a manager's branch.</span></div>
        <div id="manage-account-status" class="form-status" aria-live="polite"></div>
      </div>
      <footer><button class="secondary-button" type="button" data-close-dialog="manage-account-dialog">Cancel</button><button id="manage-account-submit" class="primary-button" type="submit"><Check size={16} /> Save changes</button></footer>
    </form>
  </dialog>

  <dialog id="reject-dialog" class="workspace-dialog small-dialog">
    <form id="reject-form" method="dialog" class="dialog-form">
      <header><div><p class="eyebrow">Admin review</p><h2>Reject request</h2></div><button class="icon-button" type="button" data-close-dialog="reject-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
      <div class="dialog-body"><input id="reject-request-id" name="requestId" type="hidden" /><label>Reason<textarea name="note" rows="4" maxlength="500" required></textarea></label><div id="reject-form-status" class="form-status"></div></div>
      <footer><button class="secondary-button" type="button" data-close-dialog="reject-dialog">Cancel</button><button class="danger-button" type="submit">Reject request</button></footer>
    </form>
  </dialog>

  <dialog id="temporary-password-dialog" class="workspace-dialog small-dialog">
    <div class="dialog-form">
      <header><div><p class="eyebrow">One-time access</p><h2>Temporary password</h2></div><button class="icon-button" type="button" data-close-dialog="temporary-password-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
      <div class="dialog-body">
        <div class="credential-recipient"><strong id="temporary-password-name">Account holder</strong><small id="temporary-password-email">email@example.com</small></div>
        <div class="one-time-password"><code id="temporary-password-value"></code><button id="copy-temporary-password" class="icon-button" type="button" aria-label="Copy temporary password" title="Copy password"><Copy size={17} /></button></div>
        <div class="notice warning"><Lock size={17} aria-hidden="true" /><span>This password is shown once. The account holder must replace it after signing in.</span></div>
        <div id="temporary-password-status" class="form-status" aria-live="polite"></div>
      </div>
      <footer><button class="primary-button" type="button" data-close-dialog="temporary-password-dialog">Done</button></footer>
    </div>
  </dialog>
</div>

<script is:inline>
  window.setTimeout(() => {
    const root = document.getElementById('hierarchy-workspace');
    if (!root || root.dataset.ready === 'true') return;
    const boot = document.getElementById('workspace-boot');
    const auth = document.getElementById('auth-shell');
    const warning = document.getElementById('load-warning');
    if (boot) boot.hidden = true;
    if (auth) auth.hidden = false;
    if (warning) warning.hidden = false;
  }, 7000);
</script>

<script>
  import { startHierarchyWorkspace } from '../../scripts/hierarchyWorkspace';
  void startHierarchyWorkspace();
</script>
