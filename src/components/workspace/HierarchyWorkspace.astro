<script is:inline>
  window.setTimeout(() => {
    const root = document.getElementById('hierarchy-workspace');
    if (!root || root.dataset.ready === 'true') return;
    const boot = document.getElementById('workspace-boot');
    const auth = document.getElementById('auth-shell');
    const warning = document.getElementById('load-warning');
    if (boot) boot.hidden = true;
    if (auth) auth.hidden = false;
    if (warning) warning.hidden = false;
    document.querySelector('.auth-entry-inner')?.classList.add('is-loading-fallback');
  }, 7000);
</script>

<script>
  import { startHierarchyWorkspace } from '../../scripts/hierarchyWorkspace';
  void startHierarchyWorkspace();
</script>
