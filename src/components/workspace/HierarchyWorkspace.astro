---
import {
  Activity,
  ChartNoAxesCombined,
  BriefcaseBusiness,
  CalendarDays,
  CircleAlert,
  ArrowLeft,
  BookOpen,
  Building2,
  Check,
  ChevronRight,
  ClipboardCheck,
  Clock,
  Compass,
  Copy,
  Download,
  Eye,
  FlaskConical,
  GraduationCap,
  House,
  KeyRound,
  Layers,
  LayoutDashboard,
  ListChecks,
  ListPlus,
  Lightbulb,
  Lock,
  MessageSquareText,
  LogOut,
  Mail,
  Megaphone,
  Menu,
  Plus,
  Printer,
  RefreshCw,
  Route,
  Search,
  ShieldCheck,
  Target,
  UserRound,
  UserPlus,
  Users,
  Wrench,
  X,
} from '@lucide/astro';
import { guidedCareerPresets } from '../../data/coachingPlaybooks';

const showRoleLab = true;
const { careerDecisionPage = false } = Astro.props;
---

<div id="hierarchy-workspace" class="hierarchy-workspace" data-dev-role-lab={showRoleLab ? 'true' : 'false'} data-career-decision-page={careerDecisionPage ? 'true' : 'false'}>
  <div id="workspace-boot" class="workspace-boot" aria-live="polite">
    <span class="brand-mark" aria-hidden="true"><Compass size={22} stroke-width={2.2} /></span>
    <span class="boot-copy"><strong>Future Career School</strong><small>Opening your workspace</small></span>
    <span class="boot-loader" aria-hidden="true"></span>
  </div>

  <section id="auth-shell" class="auth-shell" aria-labelledby="auth-title" hidden>
    <div class="auth-context">
      <a class="back-link" href="/"><ArrowLeft size={16} aria-hidden="true" /> Future Career School</a>
      <div class="auth-brand"><span class="brand-mark"><Compass size={24} /></span><strong>Coaching workspace</strong></div>
      <div class="auth-message">
        <p class="eyebrow">School workspace</p>
        <h1 id="auth-title">Your coaching plan, in one place.</h1>
        <p>Sign in to continue your career planning, skill development, and coaching conversations securely.</p>
      </div>
    </div>

    <div class="auth-entry">
      <div class="auth-entry-inner">
        <div id="auth-mode-tabs" class="auth-mode-tabs" role="tablist" aria-label="Account access">
          <button id="auth-sign-in-tab" class="is-active" type="button" role="tab" aria-selected="true" aria-controls="sign-in-panel" data-auth-mode="sign-in">Sign in</button>
          <button id="auth-recovery-tab" type="button" role="tab" aria-selected="false" aria-controls="recovery-request-panel" data-auth-mode="recovery">Set or reset password</button>
        </div>

        <div id="sign-in-panel" role="tabpanel" aria-labelledby="auth-sign-in-tab">
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><Lock size={19} /></span>
            <div><p class="eyebrow">Approved access</p><h2>Sign in</h2></div>
          </div>
          <p class="auth-note">Use the email address for your approved account. If this is your first sign-in, use the secure setup link or the one-time password from the staff member who created or approved your account. Students cannot register themselves.</p>

          <form id="sign-in-form" class="stack-form" novalidate>
            <label>
              <span>Email</span>
              <span class="input-shell"><Mail size={17} aria-hidden="true" /><input id="sign-in-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" /></span>
            </label>
            <label>
              <span>Password</span>
              <span class="input-shell"><KeyRound size={17} aria-hidden="true" /><input id="sign-in-password" name="password" type="password" autocomplete="current-password" minlength="4" required placeholder="Your password" /><button class="icon-button input-action" id="password-toggle" type="button" aria-label="Show password" title="Show password"><Eye size={17} /></button></span>
            </label>
            <div class="auth-inline-help"><span>First sign-in or forgotten password?</span><button id="sign-in-recovery-link" class="text-button" type="button">Set or reset your password</button></div>
            <button id="sign-in-submit" class="primary-button full-button" type="submit">Sign in <ChevronRight size={17} /></button>
          </form>
          <p class="account-policy-note">New accounts are created and approved by your school. If your account was just created, sign in with the one-time password from the staff member who created or approved it, or use the secure setup link sent to your email.</p>
          <div id="auth-status" class="form-status" aria-live="polite"></div>
        </div>

        <div id="recovery-request-panel" role="tabpanel" aria-labelledby="auth-recovery-tab" hidden>
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><KeyRound size={19} /></span>
            <div><p class="eyebrow">Account access</p><h2>Set or reset password</h2></div>
          </div>
          <p class="auth-note">Enter the email address on your approved account. We will send a secure link so you can choose a new password.</p>
          <form id="recovery-request-form" class="stack-form" novalidate>
            <label>
              <span>Email</span>
              <span class="input-shell"><Mail size={17} aria-hidden="true" /><input id="recovery-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" /></span>
            </label>
            <button id="recovery-submit" class="primary-button full-button" type="submit">Email secure link <ChevronRight size={17} /></button>
          </form>
          <div id="recovery-status" class="form-status" aria-live="polite"></div>
        </div>

        <div id="config-warning" class="notice danger" hidden>
          <CircleAlert size={17} aria-hidden="true" /> <span>The workspace connection is missing. An administrator needs to add the Supabase project URL and public key before anyone can sign in.</span>
        </div>
          <div id="load-warning" class="notice warning" hidden>
            <CircleAlert size={17} aria-hidden="true" /> <span>The workspace did not finish opening. Check your connection, then try again. If this keeps happening, ask an administrator to check the Supabase connection and database setup.</span>
          <button id="reload-workspace" class="text-button" type="button">Reload</button>
        </div>

        <section id="quick-role-access" class="quick-role-access" hidden aria-labelledby="quick-role-title">
            <div class="section-heading compact"><div><p class="eyebrow">Access preview</p><h3 id="quick-role-title">Preview another role</h3></div><FlaskConical size={18} /></div>
            <div id="quick-role-buttons" class="quick-role-buttons"></div>
          </section>

        <div id="password-setup-panel" role="tabpanel" aria-labelledby="auth-recovery-tab" hidden>
          <div class="auth-heading">
            <span class="auth-icon" aria-hidden="true"><ShieldCheck size={19} /></span>
            <div><p id="password-setup-eyebrow" class="eyebrow">Invitation accepted</p><h2 id="password-setup-title">Choose your first password</h2></div>
          </div>
          <p id="password-setup-note" class="auth-note">Secure this account for future sign-ins.</p>

          <form id="password-setup-form" class="stack-form" novalidate>
            <input id="password-setup-email" name="email" type="email" autocomplete="username" hidden />
            <label>
              <span>New password</span>
              <span class="input-shell"><KeyRound size={17} aria-hidden="true" /><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters" /><button class="icon-button input-action" id="new-password-toggle" type="button" aria-label="Show passwords" title="Show passwords"><Eye size={17} /></button></span>
            </label>
            <div id="password-requirements" class="password-requirements" aria-label="Password requirements">
              <span data-password-check="length">At least 8 characters. Any characters are fine.</span>
            </div>
            <label>
              <span>Confirm password</span>
              <span class="input-shell"><Check size={17} aria-hidden="true" /><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required placeholder="Repeat your password" /></span>
            </label>
            <button id="password-setup-submit" class="primary-button full-button" type="submit">Save password <ChevronRight size={17} /></button>
            <button id="password-setup-sign-out" class="text-button" type="button">Use another account</button>
          </form>
          <div id="password-setup-status" class="form-status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="access-shell" class="access-shell" hidden aria-labelledby="access-title">
    <span class="access-icon"><ShieldCheck size={26} /></span>
    <p class="eyebrow">Account access</p>
    <h1 id="access-title">This account is not active</h1>
    <p id="access-message">Ask the Admin to review this account.</p>
    <button id="access-sign-out" class="secondary-button" type="button"><LogOut size={16} /> Sign out</button>
  </section>

  <div id="workspace-shell" class="workspace-shell" hidden>
    <a class="skip-link" href="#workspace-main">Skip to main content</a>
    <section id="career-route-fallback" class="career-route-fallback" aria-labelledby="career-route-fallback-title">
      <p class="eyebrow">Career planning</p><h1 id="career-route-fallback-title">Choose a career option to explore</h1><p>Read the practical work, choose a small test, and record what you learn.</p><button class="primary-button" type="button" data-open-career-dialog><Route size={16} /> Open career planner</button>
    </section>
    <aside class="workspace-sidebar">
      <a class="sidebar-brand" href="/dashboard"><span class="brand-mark"><Compass size={21} /></span><span><strong>Future Career School</strong><small id="sidebar-brand-label">Coaching workspace</small></span></a>

      <div class="sidebar-scope">
        <span id="sidebar-initials" class="avatar">FC</span>
        <span><strong id="sidebar-user-name">Your account</strong><small id="sidebar-role">Workspace member</small></span>
      </div>

      <div id="sidebar-branch-context" class="sidebar-branch-context">
        <Building2 size={16} aria-hidden="true" />
        <span><small>Your coaching area</small><strong id="sidebar-branch-name">All branches</strong></span>
        <code id="sidebar-branch-code">ORG</code>
      </div>

      <nav class="workspace-nav" aria-label="Workspace navigation">
        <button class="nav-item is-active" type="button" data-view-target="overview" data-roles="all" aria-current="page"><LayoutDashboard size={18} /><span>Overview</span></button>
        <button class="nav-item" type="button" data-view-target="caseload" data-roles="admin,branch_head,head_coach,coach"><BriefcaseBusiness size={18} /><span>Caseload</span><span id="caseload-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="cohorts" data-roles="admin,branch_head,head_coach,coach"><Layers size={18} /><span>Cohorts</span><span id="cohort-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="people" data-roles="admin,branch_head,head_coach,coach"><Users size={18} /><span>People & access</span><span id="people-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="accounts" data-roles="admin,branch_head,head_coach,coach"><ClipboardCheck size={18} /><span>Account requests</span><span id="request-nav-count" class="nav-count">0</span></button>
        <button class="nav-item" type="button" data-view-target="branches" data-roles="admin"><Building2 size={18} /><span>Branches</span></button>
        <button class="nav-item" type="button" data-view-target="activity" data-roles="admin,branch_head"><Activity size={18} /><span>Activity log</span></button>
        <button class="nav-item" type="button" data-view-target="career" data-roles="student"><Target size={18} /><span>My coaching plan</span></button>
        <button class="nav-item" type="button" data-view-target="profile" data-roles="student"><UserRound size={18} /><span>Profile</span></button>
        <button class="nav-item role-lab-nav" type="button" data-view-target="role-lab" data-roles="admin" data-local-only="true"><FlaskConical size={18} /><span>Access preview</span></button>
      </nav>

      <div class="sidebar-foot">
        <button id="help-button" class="sign-out-button" type="button"><Lightbulb size={16} /><span>Help & definitions</span></button>
        <a href="/" class="site-link"><House size={16} /> Main website homepage</a>
        <button id="sign-out-button" class="sign-out-button" type="button"><LogOut size={16} /><span>Sign out</span></button>
      </div>
    </aside>
    <button class="mobile-menu-scrim" type="button" aria-label="Close navigation"></button>

    <header class="mobile-header">
      <button id="mobile-menu-button" class="icon-button" type="button" aria-label="Open navigation" title="Navigation"><Menu size={20} /></button>
      <a class="mobile-brand" href="/dashboard"><span class="brand-mark"><Compass size={18} /></span><strong id="mobile-brand-label">Coaching workspace</strong></a>
      <span id="mobile-initials" class="avatar small">FC</span>
    </header>

    <main id="workspace-main" class="workspace-main">
      <header class="workspace-topbar">
        <div class="topbar-copy">
          <div><p id="view-eyebrow" class="eyebrow">Workspace</p><h1 id="view-title">Overview</h1><p id="view-subtitle" class="view-subtitle"></p></div>
          <div id="workspace-branch-context" class="workspace-branch-context"><Building2 size={14} aria-hidden="true" /><span id="workspace-branch-name">All branches</span><code id="workspace-branch-code">ORG</code></div>
        </div>
        <div class="topbar-actions">
          <button id="refresh-button" class="icon-button" type="button" aria-label="Refresh workspace" title="Refresh"><RefreshCw size={17} /><span class="topbar-refresh-label">Refresh</span></button>
          <button id="new-branch-button" class="secondary-button" type="button" data-roles="admin" aria-label="Create a new branch" title="Create a new branch"><Building2 size={16} /><span>New branch</span></button>
          <button id="new-account-button" class="primary-button" type="button" data-roles="admin,branch_head,head_coach,coach" aria-label="Create an account" title="Create an account"><UserPlus size={16} /><span id="new-account-label">Create account</span></button>
        </div>
      </header>

      <div id="view-guide" class="view-guide" aria-live="polite"><Lightbulb size={16} aria-hidden="true" /><span><strong>Start here</strong><span id="view-guide-copy"></span></span></div>
      <div id="workspace-status" class="workspace-status" aria-live="polite"></div>
      <div id="coaching-schema-warning" class="notice warning coaching-schema-warning" hidden><CircleAlert size={17} aria-hidden="true" /><span>The coaching tools are ready, but the database upgrade is not active yet. Ask an administrator to apply the included Supabase migrations before saving coaching records.</span><button id="coaching-schema-retry" class="secondary-button" type="button">Try again</button></div>

      <section class="workspace-view is-active" data-workspace-view="overview" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="sr-only">Overview</h2>
        <section id="student-focus" class="student-focus" hidden><div><p class="eyebrow">Your plan</p><h2 id="student-focus-title">Choose your first career option</h2><p id="student-focus-copy"></p></div><button id="student-focus-action" class="primary-button" type="button">Continue <ChevronRight size={16} /></button></section>
        <div id="overview-metrics" class="metric-grid"></div>
        <section class="overview-shortcuts" aria-labelledby="overview-shortcuts-title">
          <div class="section-heading compact"><div><p class="eyebrow">Quick access</p><h2 id="overview-shortcuts-title">Go straight to the work</h2><p class="field-help">Open the area you need without searching through the dashboard.</p></div></div>
          <div class="overview-shortcut-grid">
            <button class="overview-shortcut" type="button" data-open-view="career" data-plan-shortcut-tab="options" data-roles="student"><span class="shortcut-icon">01</span><span><strong>Career options</strong><small>Explore and compare careers by interests, strengths, and practical routes.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="career" data-plan-shortcut-tab="skills" data-roles="student"><span class="shortcut-icon">02</span><span><strong>Skills to practise</strong><small>Review your current skills, add evidence, and share feedback.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="career" data-plan-shortcut-tab="growth" data-roles="student"><span class="shortcut-icon">03</span><span><strong>Career growth</strong><small>Turn a career option into skill proof and safer earning choices.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="career" data-plan-shortcut-tab="actions" data-roles="student"><span class="shortcut-icon">04</span><span><strong>Actions to take</strong><small>Choose or describe one practical next action.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="career" data-plan-shortcut-tab="sessions" data-roles="student"><span class="shortcut-icon">05</span><span><strong>Cohort community</strong><small>Share updates, ask for help, and follow group commitments.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="caseload" data-roles="admin,branch_head,head_coach,coach"><span class="shortcut-icon">01</span><span><strong>Student caseload</strong><small>Open records, priorities, skills, and follow-through.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="cohorts" data-roles="admin,branch_head,head_coach,coach"><span class="shortcut-icon">02</span><span><strong>Cohort communities</strong><small>Shared updates, group commitments, and useful information.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="people" data-roles="admin,branch_head,head_coach,coach"><span class="shortcut-icon">03</span><span><strong>People and access</strong><small>Check reporting lines and account readiness.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
            <button class="overview-shortcut" type="button" data-open-view="accounts" data-roles="admin,branch_head,head_coach,coach"><span class="shortcut-icon">04</span><span><strong>Account requests</strong><small>Review approvals and keep access moving.</small></span><ChevronRight size={16} aria-hidden="true" /></button>
          </div>
        </section>
        <div class="overview-grid">
          <section class="work-panel attention-panel"><div class="section-heading"><div><p class="eyebrow">Now</p><h2 id="attention-title">Needs attention</h2></div><Clock size={19} /></div><div id="attention-list" class="attention-list"></div></section>
          <section class="work-panel structure-panel"><div class="section-heading"><div><p class="eyebrow">Structure</p><h2 id="structure-title">Your scope</h2></div><Users size={19} /></div><div id="structure-list" class="structure-list"></div></section>
        </div>
        <section id="orientation-card" class="orientation-card" aria-labelledby="orientation-title"><div class="section-heading"><div><p class="eyebrow">A simple way forward</p><h2 id="orientation-title">Move forward one step at a time</h2><p id="orientation-copy">Explore a few career options, try one small step, and bring what you learn to your coach.</p></div><Compass size={19} /></div><ol><li><strong id="orientation-step-one-title">Choose career options to explore</strong><span id="orientation-step-one-copy">Keep one or more serious career options in your plan, and leave useful alternatives open.</span></li><li><strong id="orientation-step-two-title">Take one small next step</strong><span id="orientation-step-two-copy">Choose a date and record what you actually did.</span></li><li><strong id="orientation-step-three-title">Review it with your coach</strong><span id="orientation-step-three-copy">Add evidence or feedback when you have something real to share.</span></li></ol><div class="orientation-actions" aria-label="Suggested starting views"><button class="secondary-button" type="button" data-roles="admin,branch_head,head_coach,coach" data-open-view="caseload">Open caseload</button><button class="secondary-button" type="button" data-roles="admin,branch_head,head_coach,coach" data-open-view="people">Open people &amp; access</button><button class="secondary-button" type="button" data-roles="student" data-open-view="career" data-plan-shortcut-tab="options">Open career options</button></div></section>
      </section>

      <section class="workspace-view" data-workspace-view="caseload" aria-labelledby="caseload-heading" hidden>
        <div class="view-toolbar">
          <div><p class="eyebrow">Coaching operations</p><h2 id="caseload-heading">Student caseload</h2><p class="view-copy">Prioritise reviews, decisions, skill gaps, and follow-through across your scope.</p><p class="field-help">Only active student accounts appear here. Suspended accounts keep their history and can be opened from People &amp; access when you need to review it.</p></div>
          <div class="filter-row">
            <label class="search-field"><Search size={16} /><span class="sr-only">Search students</span><input id="caseload-search" type="search" placeholder="Search students" /></label>
            <label><span class="sr-only">Filter coaching stage</span><select id="caseload-stage-filter"><option value="all">All stages</option><option value="intake">Intake</option><option value="self-discovery">Self-discovery</option><option value="career-exploration">Career exploration</option><option value="option-validation">Option validation</option><option value="decision">Decision</option><option value="execution">Execution</option><option value="follow-up">Follow-up</option></select></label>
            <label><span class="sr-only">Filter cohort</span><select id="caseload-cohort-filter"><option value="all">All cohorts</option></select></label>
            <label><span class="sr-only">Filter attention</span><select id="caseload-attention-filter"><option value="all">All active students</option><option value="needs-attention">Needs attention</option><option value="overdue">Overdue actions</option><option value="no-cohort">No active cohort</option><option value="no-session">No cohort session announced</option><option value="skill-gaps">Core skill gaps</option></select></label>
          </div>
        </div>
        <div id="caseload-summary" class="caseload-summary"></div>
        <div class="table-shell caseload-table-shell"><table><thead><tr><th>Student</th><th>Coaching stage</th><th>Decision work</th><th>Skills</th><th>Follow-through</th><th>Next contact</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="caseload-table-body"></tbody></table><div id="caseload-empty" class="empty-state" hidden>No students match this view.</div></div>
        <div id="caseload-pagination" class="workspace-pagination-host"></div>
      </section>

      <section class="workspace-view" data-workspace-view="cohorts" aria-labelledby="cohorts-heading" hidden>
        <div id="cohort-index-view">
          <div class="view-toolbar">
            <div><p class="eyebrow">Group coaching community</p><h2 id="cohorts-heading">Cohort communities</h2><p class="view-copy">Give each cohort one shared space for useful information, group commitments, and visible progress.</p></div>
            <button id="new-cohort-button" class="primary-button" type="button"><Plus size={16} /> New cohort</button>
          </div>
          <div id="cohort-summary" class="caseload-summary"></div>
          <div class="filter-row cohort-filter-row">
            <label class="search-field"><Search size={16} /><span class="sr-only">Search cohorts</span><input id="cohort-search" type="search" placeholder="Search cohorts" /></label>
            <label><span class="sr-only">Filter cohort status</span><select id="cohort-status-filter"><option value="all">All statuses</option><option value="active">Active</option><option value="upcoming">Upcoming</option><option value="completed">Completed</option><option value="archived">Archived</option></select></label>
          </div>
          <div class="table-shell cohort-table-shell"><table><thead><tr><th>Cohort</th><th>Programme</th><th>Lead</th><th>Students</th><th>Latest activity</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="cohort-table-body"></tbody></table><div id="cohort-empty" class="empty-state" role="status" hidden><strong>No cohorts match this view.</strong><span>Try a different status or search term, or create a new cohort.</span></div></div>
          <div id="cohort-pagination" class="workspace-pagination-host"></div>
        </div>
        <div id="cohort-detail-view" hidden>
          <div class="record-navigation"><button id="cohort-detail-back" class="back-button" type="button"><ArrowLeft size={16} /> Cohorts</button><span class="row-actions"><button id="edit-cohort-button" class="secondary-button" type="button">Edit cohort</button></span></div>
          <header class="record-header cohort-detail-header"><div><p class="eyebrow">Cohort workspace</p><h2 id="cohort-detail-name">Cohort</h2><p id="cohort-detail-meta"></p></div><div class="record-header-status"><span id="cohort-detail-stage" class="stage-badge"></span><span id="cohort-detail-status" class="status-badge"></span></div></header>
          <div id="cohort-detail-summary" class="student-plan-summary"></div>
          <div class="cohort-detail-grid">
             <section class="cohort-roster-band"><div class="section-heading"><div><p class="eyebrow">Active membership</p><h3>Student roster</h3></div><button id="move-student-button" class="secondary-button" type="button"><Plus size={16} /> Add or move student</button></div><div id="cohort-roster" class="cohort-roster"></div></section>
