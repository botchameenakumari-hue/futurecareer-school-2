        <div id="account-form-status" class="form-status" aria-live="polite"></div>
      </div>
      <footer><button class="secondary-button" type="button" data-close-dialog="account-dialog">Cancel</button><button id="account-submit" class="primary-button" type="submit"><UserPlus size={16} /><span id="account-submit-label">Create account</span></button></footer>
