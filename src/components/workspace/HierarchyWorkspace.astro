     <header><div><p class="eyebrow">Session delivery</p><h2 id="attendance-dialog-title">Attendance</h2></div><button class="icon-button" type="button" data-close-dialog="attendance-dialog" aria-label="Close" title="Close"><X size={18} /></button></header>
