---
type QueueRecord = { id: string; course: string; status: string; owner: string; requiredFields: readonly string[]; note: string };
interface Props { queue: QueueRecord[] }
const { queue } = Astro.props;
const fields = ['exact_institute_or_authority', 'eligibility_and_marks', 'subject_combination', 'entrance_route_and_year', 'age_category_and_domicile', 'source_url_and_last_verified_date', 'named_verifier_and_correction_path'];
---
<section class="cvw" id="course-verification-workbench" aria-labelledby="cvw-title">
  <div class="cvw-head"><div><p class="cvw-kicker">EDITORIAL VERIFICATION WORKBENCH · BROWSER-LOCAL</p><h2 id="cvw-title">Prepare one course-rule review packet</h2><p>Use this worksheet to check one exact authority or institute notice before any admission-rule claim is published. It does not verify sources, alter the finder or publish a record.</p></div><p class="cvw-note"><b>Private by design:</b> drafts stay in this browser unless you export them.</p></div>
  <form id="cvw-form">
    <label>Queued course or route<select id="cvw-record">{queue.map((record) => <option value={record.id}>{record.course}</option>)}</select></label>
    <div class="cvw-grid"><label>Named reviewer<input id="cvw-reviewer" maxlength="120" placeholder="Person responsible for checking"></label><label>Review date<input id="cvw-date" type="date"></label></div>
    <label>Exact authority or institute notice URLs<textarea id="cvw-sources" rows="3" placeholder="One http(s) URL per line"></textarea></label>
    <label>Conflict, uncertainty or withdrawal note<textarea id="cvw-conflict" rows="3" placeholder="Record what remains unclear or why publication should wait"></textarea></label>
    <fieldset><legend>Fields checked against the current source</legend><div class="cvw-checks">{fields.map((field) => <label><input type="checkbox" value={field} data-cvw-field> {field}</label>)}</div></fieldset>
    <fieldset><legend>Evidence note for each field</legend><p class="cvw-help">Record the exact rule, source section or uncertainty. A note is a review record, not independent verification.</p><div class="cvw-details">{fields.map((field) => <label>{field}<textarea rows="2" maxlength="600" data-cvw-detail={field} placeholder={`What the source says about ${field}`}></textarea></label>)}</div></fieldset>
    <div class="cvw-actions"><button type="submit">Save local draft</button><button type="button" class="cvw-secondary" id="cvw-export">Export review JSON</button><button type="button" class="cvw-secondary" id="cvw-clear">Clear draft</button></div>
  </form>
  <p id="cvw-status" class="cvw-status" aria-live="polite">No draft loaded. A saved draft is not verified admission data.</p>
  <script type="application/json" id="cvw-data" set:html={JSON.stringify(queue).replace(/</g, '\\u003c')}></script>
</section>
<script>
  const app = document.querySelector<HTMLElement>('#course-verification-workbench');
  if (app) {
    type Queue = { id: string; course: string; status: string; owner: string; requiredFields: string[]; note: string };
    type Draft = { id: string; reviewer: string; reviewDate: string; sources: string; conflict: string; checked: string[]; details: Record<string, string>; savedAt: string };
    const fields = ['exact_institute_or_authority', 'eligibility_and_marks', 'subject_combination', 'entrance_route_and_year', 'age_category_and_domicile', 'source_url_and_last_verified_date', 'named_verifier_and_correction_path'];
    const node = app.querySelector<HTMLScriptElement>('#cvw-data'); const record = app.querySelector<HTMLSelectElement>('#cvw-record'); const reviewer = app.querySelector<HTMLInputElement>('#cvw-reviewer'); const date = app.querySelector<HTMLInputElement>('#cvw-date'); const sources = app.querySelector<HTMLTextAreaElement>('#cvw-sources'); const conflict = app.querySelector<HTMLTextAreaElement>('#cvw-conflict'); const status = app.querySelector<HTMLElement>('#cvw-status'); const form = app.querySelector<HTMLFormElement>('#cvw-form'); const storageKey = 'fcs-course-eligibility-verification-drafts-v1';
    if (!node || !record || !reviewer || !date || !sources || !conflict || !status || !form) throw new Error('Course verification workbench markup is incomplete.');
    const queue = JSON.parse(node.textContent || '[]') as Queue[];
    const loadAll = (): Record<string, Draft> => { try { return JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch { return {}; } };
    const checked = () => Array.from(app.querySelectorAll<HTMLInputElement>('[data-cvw-field]:checked')).map((input) => input.value);
    const details = () => Object.fromEntries(Array.from(app.querySelectorAll<HTMLTextAreaElement>('[data-cvw-detail]')).map((input) => [input.dataset.cvwDetail || '', input.value.trim()]));
    const render = () => { const draft = loadAll()[record.value]; reviewer.value = draft?.reviewer || ''; date.value = draft?.reviewDate || ''; sources.value = draft?.sources || ''; conflict.value = draft?.conflict || ''; app.querySelectorAll<HTMLInputElement>('[data-cvw-field]').forEach((input) => { input.checked = !!draft?.checked?.includes(input.value); }); app.querySelectorAll<HTMLTextAreaElement>('[data-cvw-detail]').forEach((input) => { input.value = draft?.details?.[input.dataset.cvwDetail || ''] || ''; }); status.textContent = draft ? `Local draft loaded for ${queue.find((item) => item.id === record.value)?.course || record.value}; it is not verified admission data.` : 'No draft loaded. A saved draft is not verified admission data.'; };
    const current = (): Draft => ({ id: record.value, reviewer: reviewer.value.trim(), reviewDate: date.value, sources: sources.value.trim(), conflict: conflict.value.trim(), checked: checked(), details: details(), savedAt: new Date().toISOString() });
    form.addEventListener('submit', (event) => { event.preventDefault(); const all = loadAll(); all[record.value] = current(); localStorage.setItem(storageKey, JSON.stringify(all)); status.textContent = 'Saved a browser-local review draft. It is not verified or published.'; });
    record.addEventListener('change', render);
    app.querySelector<HTMLButtonElement>('#cvw-clear')?.addEventListener('click', () => { const all = loadAll(); delete all[record.value]; localStorage.setItem(storageKey, JSON.stringify(all)); render(); });
    app.querySelector<HTMLButtonElement>('#cvw-export')?.addEventListener('click', () => { const draft = current(); const validSources = draft.sources.split(/\s+/).filter(Boolean).every((value) => { try { const parsed = new URL(value); return parsed.protocol === 'https:' || parsed.protocol === 'http:'; } catch { return false; } }); const missing = fields.filter((field) => !draft.checked.includes(field) || !draft.details[field]); if (!draft.reviewer || !draft.reviewDate || !validSources || missing.length) { status.textContent = `Review packet is incomplete: add a reviewer, date, valid source URL(s), and evidence notes for ${missing.length ? missing.join(', ') : 'all checked fields'}. Nothing was exported.`; return; } const payload = { queueRecord: queue.find((item) => item.id === record.value), draft, publicationStatus: 'not-published', reviewReadiness: 'complete-for-human-review' }; const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${record.value}-course-review.json`; link.click(); URL.revokeObjectURL(link.href); status.textContent = 'Exported a complete review packet. It remains a draft and is not admission data.'; });
    render();
  }
</script>
<style>
  .cvw{margin:2rem 0;padding:clamp(1.1rem,3vw,2rem);border:1px solid rgba(18,154,141,.42);border-radius:22px;background:linear-gradient(145deg,rgba(18,154,141,.1),rgba(255,255,255,.03));color:#f8fafc}.cvw-head{display:grid;grid-template-columns:1fr minmax(210px,300px);gap:1.2rem}.cvw-kicker{margin:0;color:#8de4d8;font-size:.76rem;font-weight:800;letter-spacing:.1em}.cvw h2{margin:.45rem 0}.cvw p{line-height:1.65;color:rgba(255,255,255,.7)}.cvw-note{padding:.85rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.04);font-size:.86rem}.cvw form{display:grid;gap:.9rem;margin-top:1.2rem}.cvw label,.cvw legend{display:grid;gap:.35rem;color:#fff;font-size:.86rem;font-weight:700}.cvw input,.cvw select,.cvw textarea{width:100%;padding:.55rem .7rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:#101927;color:#fff;font:inherit}.cvw-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.cvw fieldset{border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:.8rem}.cvw-checks{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:.6rem}.cvw-checks label{display:block;font-weight:500}.cvw-checks input{width:auto}.cvw-help{margin:.55rem 0 0;font-size:.82rem}.cvw-details{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-top:.7rem}.cvw-actions{display:flex;gap:.6rem;flex-wrap:wrap}.cvw-actions button{min-height:44px;padding:.55rem .85rem;border:0;border-radius:10px;background:#e5b84a;color:#17130a;font-weight:800;cursor:pointer}.cvw-actions .cvw-secondary{border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff}.cvw-status{font-size:.88rem}.cvw input:focus-visible,.cvw select:focus-visible,.cvw textarea:focus-visible,.cvw button:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}@media(max-width:700px){.cvw-head,.cvw-grid,.cvw-details{grid-template-columns:1fr}.cvw-checks{grid-template-columns:repeat(2,1fr)}}
</style>
