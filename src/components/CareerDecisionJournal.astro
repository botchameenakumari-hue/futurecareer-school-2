<section class="cdj" aria-labelledby="cdj-title">
  <div class="cdj-intro">
    <p class="eyebrow">PRIVATE, BROWSER-LOCAL WORKSHEET</p>
    <h2 id="cdj-title">Make a career decision testable</h2>
    <p>Write what you believe, run one small test, write what you really learned and pick a review date. You can keep several entries and add the review date to your phone calendar.</p>
    <p class="cdj-note"><b>Privacy:</b> entries stay in this browser only. They are not uploaded or shared. If you use a shared phone or computer, tap "Clear everything" when you finish. Do not write health, money or other private details.</p>
  </div>
  <form id="cdj-form" class="cdj-form" novalidate>
    <button type="button" class="cdj-example" data-cdj="example">Try an example</button>
    <label><span>What direction are you testing?</span><input name="direction" maxlength="160" autocomplete="off" placeholder="For example: data analysis, or B.Sc Botany" required /></label>
    <label><span>What do you believe right now?</span><textarea name="hypothesis" rows="3" maxlength="600" placeholder="For example: I think I will enjoy this because I like working with numbers" required></textarea></label>
    <label><span>What would change your mind?</span><textarea name="evidence" rows="3" maxlength="600" placeholder="A real task, a talk with someone who does the work, an official rule or a cost check" required></textarea></label>
    <label><span>What small test will you run?</span><textarea name="experiment" rows="3" maxlength="600" placeholder="Say what you will make or do, who will look at it and what you will watch for" required></textarea></label>
    <div class="cdj-grid">
      <label><span>Review date</span><input name="reviewDate" type="date" required /></label>
      <label><span>Status</span><select name="status"><option value="not-started">Not started</option><option value="in-progress">In progress</option><option value="complete">Complete</option><option value="paused">Paused</option></select></label>
    </div>
    <div class="cdj-quick" aria-label="Quick review dates"><span>Quick dates:</span><button type="button" data-cdj-days="14">In 2 weeks</button><button type="button" data-cdj-days="30">In 1 month</button><button type="button" data-cdj-days="60">In 2 months</button></div>
    <label><span>What did you learn, or what is still unclear? (fill this in after the test)</span><textarea name="learning" rows="3" maxlength="800" placeholder="Write only what really happened. Do not guess the result before you do the test"></textarea></label>
    <label><span>What will you do next?</span><select name="decision"><option value="continue-test">Run another small test</option><option value="deeper-research">Research this route more carefully</option><option value="compare">Compare it with another route</option><option value="pause">Pause or leave this direction for now</option></select></label>
    <div class="cdj-actions"><button class="cdj-primary" type="submit">Save this entry</button><button type="button" data-cdj="new">Start a new entry</button></div>
    <p id="cdj-status" class="cdj-status" role="status" aria-live="polite"></p>
  </form>
  <div id="cdj-summary" class="cdj-summary" hidden></div>
  <div id="cdj-history" class="cdj-history" hidden></div>
  <div class="cdj-actions cdj-tools"><button type="button" data-cdj="backup">Download a backup file</button><label class="cdj-file">Open a backup file<input type="file" accept="application/json,.json" data-cdj="restore" /></label><button type="button" data-cdj="clear">Clear everything</button></div>
</section>

<script>
  import { esc, fmtDate, addDays, isoDate, parseIso, copyText, printSheet, tidy, type Sheet } from '../scripts/counsellingToolKit';
  type Entry = Record<string, string>;
  const form = document.querySelector<HTMLFormElement>('#cdj-form');
  const summary = document.querySelector<HTMLDivElement>('#cdj-summary');
  const historyBox = document.querySelector<HTMLDivElement>('#cdj-history');
  const status = document.querySelector<HTMLParagraphElement>('#cdj-status');
  if (!form || !summary || !historyBox || !status) throw new Error('Career decision journal markup is incomplete.');
  const root = form.closest('section') as HTMLElement;
  const KEY = 'fcs-career-decision-journal-v2';
  const OLD_KEY = 'fcs-career-decision-journal-v1';
  const URL_ = 'https://futurecareerschool.com/tools/career-decision-journal/';
  const MAX_HISTORY = 20;
  const STATUS: Record<string, string> = { 'not-started': 'Not started', 'in-progress': 'In progress', complete: 'Complete', paused: 'Paused' };
  const DECISION: Record<string, string> = { 'continue-test': 'Run another small test', 'deeper-research': 'Research this route more carefully', compare: 'Compare it with another route', pause: 'Pause or leave this direction for now' };
  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select')];
  let history: Entry[] = [];
  const read = (): Entry => Object.fromEntries(fields.map((f) => [f.name, f.value]));
  const apply = (data: Entry) => fields.forEach((f) => { f.value = data[f.name] ?? (f.tagName === 'SELECT' ? (f as HTMLSelectElement).options[0].value : ''); f.classList.remove('cdj-bad'); });
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify({ current: read(), history })); } catch { /* storage may be blocked */ } };
  const defaultDate = () => { (form.elements.namedItem('reviewDate') as HTMLInputElement).value = isoDate(addDays(14)); };
  const reviewNote = (data: Entry) => {
    const date = parseIso(data.reviewDate || '');
    if (!date) return 'Choose a review date so the test has an end.';
    const days = Math.round((date.getTime() - addDays(0).getTime()) / 86400000);
    return days < 0 ? `Review date was ${fmtDate(date)}. It has passed: write what you learned now.` : days === 0 ? 'Review is today.' : `Review ${fmtDate(date)}, in ${days} day${days === 1 ? '' : 's'}.`;
  };
  const sheetOf = (data: Entry): Sheet => ({
    title: `Decision journal: ${data.direction || 'my direction'}`,
    sub: `Status: ${STATUS[data.status] || data.status}. ${reviewNote(data)}`,
    sections: [
      { h: 'What I believe now', p: [data.hypothesis || 'Not written yet'] },
      { h: 'What would change my mind', p: [data.evidence || 'Not written yet'] },
      { h: 'My small test', p: [data.experiment || 'Not written yet'] },
      { h: 'What I learned', p: [data.learning || 'To be written after the test'] },
      { h: 'My next decision', p: [DECISION[data.decision] || ''] },
      { h: 'Remember', p: ['One test is a signal, not proof of fit. Compare it with your constraints, the official rules for the route and a second source of evidence, such as a person who does this work.'] },
    ],
  });
  let lastSheet: Sheet | null = null;
  const calendarLinks = (data: Entry) => {
    const date = parseIso(data.reviewDate || ''); if (!date) return '';
    const ymd = (d: Date) => isoDate(d).replace(/-/g, '');
    const next = addDays(1, date);
    const text = encodeURIComponent(`Review my career test: ${data.direction}`);
    const details = encodeURIComponent('Write what I learned and choose my next step. Made with https://futurecareerschool.com/tools/career-decision-journal/');
    return `<a class="cdj-link" target="_blank" rel="noopener noreferrer" href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&details=${details}&dates=${ymd(date)}/${ymd(next)}">Add review date to Google Calendar</a>`;
  };
  const render = (data: Entry) => {
    if (!data?.direction) { summary.hidden = true; summary.innerHTML = ''; lastSheet = null; return; }
    lastSheet = sheetOf(data);
    summary.innerHTML = `<h3>${esc(data.direction)}</h3><p><b>Status:</b> ${esc(STATUS[data.status] || data.status)} · ${esc(reviewNote(data))}</p><div class="cdj-summary-grid"><article><b>What I believe</b><p>${esc(data.hypothesis || 'Not written yet')}</p></article><article><b>My small test</b><p>${esc(data.experiment || 'Not written yet')}</p></article><article><b>What would change my mind</b><p>${esc(data.evidence || 'Not written yet')}</p></article><article><b>What I learned</b><p>${esc(data.learning || 'Write this after the test')}</p></article></div><p><b>Next:</b> ${esc(DECISION[data.decision] || '')}</p><p class="cdj-boundary"><b>Review rule:</b> one test is a signal, not proof of career fit. Compare it with your constraints, the official rules for the route and a second source of evidence.</p><div class="cdj-actions"><button type="button" data-cdj="copy">Copy as text</button><button type="button" data-cdj="print">Print or save as PDF</button>${calendarLinks(data)}</div>`;
    summary.hidden = false;
  };
  const renderHistory = () => {
    historyBox.hidden = history.length === 0;
    historyBox.innerHTML = history.length ? `<h3>Earlier entries (${history.length})</h3><ul>${history.map((h, i) => `<li><div><b class="cdj-wrap">${esc(h.direction)}</b><small>${esc(STATUS[h.status] || h.status)} · review ${esc(parseIso(h.reviewDate || '') ? fmtDate(parseIso(h.reviewDate) as Date) : 'not set')}</small></div><div class="cdj-row"><button type="button" data-cdj-open="${i}">Open</button><button type="button" data-cdj-del="${i}">Delete</button></div></li>`).join('')}</ul>` : '';
  };
  const say = (t: string) => { status.textContent = t; };

  // Load, with a one-time move from the first version of the journal.
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) { const s = JSON.parse(raw); history = Array.isArray(s.history) ? s.history.slice(0, MAX_HISTORY) : []; apply(s.current || {}); }
    else { const old = localStorage.getItem(OLD_KEY); if (old) apply(JSON.parse(old)); }
  } catch { /* ignore */ }
  if (!(form.elements.namedItem('reviewDate') as HTMLInputElement).value) defaultDate();
  render(read()); renderHistory();

  form.addEventListener('input', (e) => { (e.target as HTMLElement).classList.remove('cdj-bad'); save(); render(read()); });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const bad = fields.filter((f) => f.hasAttribute('required') && !f.value.trim());
    fields.forEach((f) => f.classList.toggle('cdj-bad', bad.includes(f)));
    if (bad.length) { say(`Please fill in: ${bad.map((f) => f.closest('label')?.querySelector('span')?.textContent || f.name).join('; ')}. Tap "Try an example" to see how it works.`); bad[0].focus(); return; }
    save(); render(read()); say('Saved in this browser. The entry is shown below.');
    summary.scrollIntoView({ block: 'nearest' });
  });
  root.addEventListener('click', async (event) => {
    const t = event.target as HTMLElement;
    const act = t.closest<HTMLElement>('[data-cdj]')?.dataset.cdj;
    const days = t.closest<HTMLElement>('[data-cdj-days]')?.dataset.cdjDays;
    const open = t.closest<HTMLElement>('[data-cdj-open]')?.dataset.cdjOpen;
    const del = t.closest<HTMLElement>('[data-cdj-del]')?.dataset.cdjDel;
    if (days) { (form.elements.namedItem('reviewDate') as HTMLInputElement).value = isoDate(addDays(Number(days))); save(); render(read()); say('Review date set.'); return; }
    if (open !== undefined) { const i = Number(open); const chosen = history[i]; if (!chosen) return; const cur = read(); history.splice(i, 1); if (cur.direction?.trim() && history.length < MAX_HISTORY) history.unshift(cur); apply(chosen); save(); render(read()); renderHistory(); say('Entry opened. Your previous entry moved to the list.'); form.scrollIntoView({ block: 'start' }); return; }
    if (del !== undefined) { history.splice(Number(del), 1); save(); renderHistory(); say('Entry deleted.'); return; }
    if (act === 'example') { apply({ direction: 'Data analysis', hypothesis: 'I think I will enjoy finding patterns in numbers, but I have never tried it for a full week.', evidence: 'If I get bored cleaning data after one hour, or if a senior cannot understand my summary, I will rethink.', experiment: 'Make a one-page summary of three findings from a free public data sheet and show it to a senior.', reviewDate: isoDate(addDays(14)), status: 'not-started', learning: '', decision: 'continue-test' }); save(); render(read()); say('Example filled in. Change anything, then tap "Save this entry".'); return; }
    if (act === 'new') { const cur = read(); if (cur.direction?.trim()) { if (history.length >= MAX_HISTORY) { say(`You have ${MAX_HISTORY} saved entries. Delete one first.`); return; } history.unshift(cur); } apply({}); defaultDate(); save(); render(read()); renderHistory(); say('Your last entry moved to the list. Start the new one above.'); form.scrollIntoView({ block: 'start' }); return; }
    if (act === 'copy' && lastSheet) { say((await copyText(`${lastSheet.title}\n${lastSheet.sub || ''}\n\n` + lastSheet.sections.map((s) => `*${s.h}*\n${(s.p || []).join('\n')}`).join('\n\n') + `\n\nMade with the free tool at ${URL_}`)) ? 'Copied. Paste it into WhatsApp or a note.' : 'Copy did not work. Use Print or save as PDF instead.'); return; }
    if (act === 'print' && lastSheet) { printSheet(lastSheet, URL_); say('Opening print. Choose "Save as PDF" to keep a copy.'); return; }
    if (act === 'backup') { const blob = new Blob([JSON.stringify({ current: read(), history }, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'career-decision-journal-backup.json'; link.click(); window.setTimeout(() => URL.revokeObjectURL(link.href), 1000); say('Backup downloaded. Keep the file somewhere private. Use "Open a backup file" to bring it back.'); return; }
    if (act === 'clear') { try { localStorage.removeItem(KEY); localStorage.removeItem(OLD_KEY); } catch { /* ignore */ } history = []; apply({}); defaultDate(); render(null as unknown as Entry); renderHistory(); say('Everything was cleared from this browser.'); }
  });
  root.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.dataset.cdj !== 'restore' || !input.files?.[0]) return;
    const reader = new FileReader();
    reader.onload = () => { try { const s = JSON.parse(String(reader.result)); if (!s || typeof s !== 'object') throw new Error('bad'); history = Array.isArray(s.history) ? s.history.slice(0, MAX_HISTORY) : []; apply(s.current && typeof s.current === 'object' ? s.current : s); if (!(form.elements.namedItem('reviewDate') as HTMLInputElement).value) defaultDate(); save(); render(read()); renderHistory(); say('Backup opened.'); } catch { say('That file could not be read. Choose a backup file made by this journal.'); } input.value = ''; };
    reader.readAsText(input.files[0]);
  });
</script>

<style is:global>
  .cdj{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.cdj-intro h2{margin:.2rem 0 .6rem}.cdj-intro p{max-width:760px;line-height:1.65}.cdj-note,.cdj-status{color:rgba(255,255,255,.72);font-size:.9rem}.cdj-form{display:grid;gap:1rem;margin-top:1.2rem}.cdj-form label{display:grid;gap:.4rem;font-weight:650;font-size:.95rem}.cdj-form input,.cdj-form textarea,.cdj-form select{width:100%;min-height:44px;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.25);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;font-weight:400}.cdj-form select option{color:#111}.cdj-bad{border-color:#ffb0b0!important;box-shadow:0 0 0 2px rgba(255,176,176,.35)}.cdj-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.cdj-quick{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;font-size:.9rem}.cdj-quick button,.cdj-actions button,.cdj-example,.cdj-file,.cdj-link,.cdj-row button{min-height:44px;padding:.55rem .95rem;border:1px solid rgba(255,255,255,.28);border-radius:10px;background:rgba(255,255,255,.08);color:#fff;font:inherit;cursor:pointer;display:inline-flex;align-items:center;text-decoration:none}.cdj-example{justify-self:start;border-style:dashed;color:#f7d88c;font-weight:650}.cdj-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.4rem}.cdj-actions .cdj-primary{background:#129a8d;border-color:#129a8d;font-weight:700}.cdj-file input{position:absolute;opacity:0;width:1px;height:1px}.cdj-file:focus-within{outline:3px solid #e5b84a}.cdj-summary{margin-top:1.3rem;padding:1.1rem;border:1px solid rgba(229,184,74,.42);border-radius:14px;background:rgba(229,184,74,.08);scroll-margin-top:5rem}.cdj-summary h3{margin:.1rem 0 .35rem;overflow-wrap:anywhere}.cdj-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.cdj-summary-grid article{padding:.8rem;border:1px solid rgba(255,255,255,.18);border-radius:10px}.cdj-summary-grid p,.cdj-boundary,.cdj-summary p{line-height:1.6;color:rgba(255,255,255,.82);overflow-wrap:anywhere}.cdj-history{margin-top:1.2rem}.cdj-history ul{list-style:none;margin:0;padding:0;display:grid;gap:.6rem}.cdj-history li{display:flex;justify-content:space-between;gap:.8rem;flex-wrap:wrap;padding:.7rem .8rem;border:1px solid rgba(255,255,255,.16);border-radius:10px}.cdj-history small{display:block;color:rgba(255,255,255,.65)}.cdj-wrap{overflow-wrap:anywhere}.cdj-row{display:flex;gap:.5rem}.cdj-tools{margin-top:1.2rem}.cdj-link{color:#8de4d8}@media(max-width:650px){.cdj{padding:1rem}.cdj-grid,.cdj-summary-grid{grid-template-columns:1fr}}
</style>
