---
// Page frame shared by /tools/career-guidance-after-12th-pdf/ and /tools/career-guidance-after-10th-pdf/.
// The two page files hold only their own copy (title, intro, FAQs, sources) and pass it in, so a layout
// or behaviour fix applies to both. The working tool is CareerGuidanceBooklet.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ToolNextStep from './ToolNextStep.astro';
import CareerGuidanceBooklet from './CareerGuidanceBooklet.astro';
import { SCALE, SCALE_RULE } from '../config/scalability.mjs';
import { CHECKED_ON, PAY_LINE } from '../data/careerGuidanceBooklet.mjs';

const { page } = Astro.props;
const { stage, title, description, pageUrl } = page;

const marks = [
  { mark: SCALE.high.label, meaning: 'Income and reach can grow through skills, proof of work and paid projects, not only through hours worked.', risk: 'It needs steady learning and visible proof. A title or certificate alone does not make a route scalable.', step: 'Name who pays, how they find and trust you, one piece of proof and a simple follow-up habit.' },
  { mark: SCALE.mid.label, meaning: 'A job or degree is the way in, and a consulting practice, studio, clinic, agency or product on top can make it scalable.', risk: 'Without that extra layer, growth stays tied to one employer or to the hours you can work.', step: 'Plan the business layer early: who would pay, how they would find and trust you, and what proof you can show.' },
  { mark: SCALE.low.label, meaning: 'Growth is capped by seats, hours or a single employer. Examples are MBBS and BDS, NDA, government exams, integrated law, pilot training, merchant navy and pure research.', risk: 'Competition at several levels, many years before pay grows, and few people reaching the top. Effort alone does not guarantee a result.', step: 'Write a second route and keep a skill running that can grow on its own.' },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: page.appName,
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any modern web browser',
    description,
    isAccessibleForFree: true,
    inLanguage: 'en-IN',
    dateModified: '2026-11-17',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    publisher: { '@type': 'Organization', name: 'FutureCareerSchool', url: 'https://futurecareerschool.com' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Career resources', item: 'https://futurecareerschool.com/career-resources/' },
      { '@type': 'ListItem', position: 3, name: page.breadcrumbLabel, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} jsonLd={jsonLd}>
  <Nav activePage="tools" />
  <slot name="note" />
  <main>
    <section class="cp-hero container">
      <nav class="cp-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">/</span><span aria-current="page">{page.breadcrumbLabel}</span></nav>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1} <span>{page.h1Span}</span></h1>
      {page.lead.map((p, i) => <p class={i === 0 ? 'lead' : 'lead lead--small'}>{p}</p>)}
      <p class="cp-jump"><a href="#career-guidance-booklet">Go straight to the booklet builder</a></p>
      <p class="cp-service">{page.serviceLink.before} <a href={page.serviceLink.href}>{page.serviceLink.label}</a>{page.serviceLink.after}</p>
      <p class="cp-limits"><b>Private by design:</b> the booklet is built in your browser. It does not ask for a phone number or email, and it does not upload your answers.</p>
    </section>

    <section class="container cp-shell cgb-shell" aria-label={page.appName}>
      <CareerGuidanceBooklet stage={stage} />
    </section>

    <section class="container cp-section" id="how-to-use">
      <h2>{page.stepsTitle}</h2>
      <ol class="cp-steps">
        {page.steps.map((s) => <li><h3>{s.h}</h3><p>{s.p}</p></li>)}
      </ol>
    </section>

    <section class="container cp-section" id="inside">
      <h2>{page.insideTitle}</h2>
      <div class="cp-grid">
        {page.inside.map((s) => <article><h3>{s.h}</h3><p>{s.p}</p></article>)}
      </div>
    </section>

    <section class="container cp-section" id="how-answers-change-it">
      <h2>{page.changesTitle}</h2>
      <p>{page.changesIntro}</p>
      <ul class="cp-list">
        {page.changes.map((s) => <li><b>{s.h}.</b> {s.p}</li>)}
      </ul>
    </section>

    <section class="container cp-section" id="growth-marks">
      <h2>{page.marksTitle}</h2>
      <p>{page.marksIntro}</p>
      <p>{SCALE_RULE}</p>
      <div class="cp-tablewrap">
        <table class="cp-table">
          <thead><tr><th scope="col">Mark</th><th scope="col">What it means</th><th scope="col">Risk shown</th><th scope="col">Basic sales and marketing step</th></tr></thead>
          <tbody>
            {marks.map((m) => (
              <tr>
                <th scope="row" data-label="Mark">{m.mark}</th>
                <td data-label="What it means">{m.meaning}</td>
                <td data-label="Risk shown">{m.risk}</td>
                <td data-label="Basic sales and marketing step">{m.step}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>{PAY_LINE}</p>
    </section>

    <section class="container cp-section" id="limits">
      <h2>{page.limitsTitle}</h2>
      <div class="cp-grid">
        {page.limits.map((s) => <article><h3>{s.h}</h3><p>{s.p}</p></article>)}
      </div>
    </section>

    <section class="container cp-section" id="check-before-you-commit">
      <h2>Check before you commit</h2>
      <p>{page.checks.intro}</p>
      <h3 class="cp-sub">Four questions</h3>
      <div class="cp-grid cp-grid--4">
        {page.checks.questions.map((s) => <article><h4>{s.h}</h4><p>{s.p}</p></article>)}
      </div>
      <h3 class="cp-sub">Three proofs</h3>
      <div class="cp-grid cp-grid--3">
        {page.checks.proofs.map((s) => <article><h4>{s.h}</h4><p>{s.p}</p></article>)}
      </div>
    </section>

    <section class="container cp-section" id="money-check">
      <h2>Money check before you pay</h2>
      <p>{page.moneyLead}</p>
      <p>Our strongest suggestion: keep a course or degree fee near a tenth of the family education budget, and treat spending above roughly a fifth as a caution that needs course-specific evidence. This does not apply to very cheap online courses. Free YouTube lessons and low-priced courses on sites like Udemy or Coursera need little budget care, and the same course through a university certificate can cost 30 to 100 times more.</p>
      <p>An illustration, not a real fee: on a Rs 3 lakh education budget, a tenth is Rs 30,000 for the main course and a fifth is Rs 60,000. Spend the rest on tools, practice and a reserve.</p>
      <p>{page.moneySafety}</p>
    </section>

    <section class="container cp-section" id="full-chart">
      <h2>{page.chartBox.h}</h2>
      <p>{page.chartBox.p}</p>
      <p><a class="cp-cta" href={page.chartBox.href}>{page.chartBox.label}</a></p>
    </section>

    <section class="container cp-section" id="faq">
      <h2>{page.faqTitle}</h2>
      <div class="cp-faq">
        {page.faqs.map((f) => (
          <details class="faq-item" open>
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cp-section" id="sources">
      <h2>Sources and checks</h2>
      <p>{page.sourcesIntro}</p>
      <div class="cp-tablewrap">
        <table class="cp-table cp-table--sources">
          <thead><tr><th scope="col">Source</th><th scope="col">What it supports</th><th scope="col">Checked</th></tr></thead>
          <tbody>
            {page.sources.map((s) => (
              <tr>
                <th scope="row" data-label="Source"><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a><br /><span class="cp-url">{s.url}</span></th>
                <td data-label="What it supports">{s.supports}</td>
                <td data-label="Checked">{s.checked || CHECKED_ON}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>{page.sourcesNote}</p>
    </section>

    <section class="container cp-section cp-last" id="related">
      <h2>Related tools and pages</h2>
      <ul class="cp-list">
        {page.related.map((r) => <li><a href={r.href}>{r.label}</a>: {r.why}</li>)}
      </ul>
    </section>
  <ToolNextStep toolName={stage === '10' || stage === 'after10' || stage === 10 ? 'Career Guidance Booklet After 10th' : 'Career Guidance Booklet After 12th'} audience={stage === '10' || stage === 'after10' || stage === 10 ? 'after10' : 'after12'} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .cp-hero{padding:2rem 1.25rem 1.5rem}.cp-hero h1{max-width:880px;overflow-wrap:anywhere;font-size:clamp(1.75rem,7.2vw,2.8rem);line-height:1.15}.cp-jump{margin:.6rem 0}.cp-jump a{display:inline-flex;align-items:center;min-height:44px;color:#f3cf70;font-weight:700}.cp-hero h1 span{color:var(--gold,#e5b84a)}
  .cp-crumbs{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1.2rem;font-size:.85rem;color:rgba(255,255,255,.8)}.cp-crumbs a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}
  .lead{max-width:780px;font-size:1.12rem;line-height:1.7}.lead--small{font-size:1rem;color:rgba(255,255,255,.88)}
  .cp-service{max-width:780px;line-height:1.7}.cp-service a,.cp-section a{color:#f3cf70;font-weight:700}
  .cp-limits{max-width:780px;font-size:.9rem;line-height:1.6;color:rgba(255,255,255,.8)}
  .cp-shell{max-width:1050px}
  .cp-section{max-width:1050px;padding:1.5rem 1.25rem}.cp-section h2{margin-top:0}.cp-section p,.cp-section li{line-height:1.7;max-width:820px}.cp-section>p{margin:.7rem 0}
  .cp-last{padding-bottom:5rem}
  .cp-steps{list-style:none;margin:1rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:1rem;counter-reset:step}
  .cp-steps li{counter-increment:step;padding:1rem;border:1px solid rgba(255,255,255,.16);border-radius:14px}
  .cp-steps li::before{content:counter(step);display:inline-grid;place-items:center;width:1.9rem;height:1.9rem;margin-bottom:.4rem;border-radius:50%;background:#0b766d;color:#fff;font-weight:800}
  .cp-steps h3{margin:.1rem 0 .3rem}.cp-steps p{margin:0}
  .cp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}
  .cp-grid--4{grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr))}.cp-grid--3{grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr))}
  .cp-grid article{padding:1rem;border:1px solid rgba(255,255,255,.16);border-radius:14px}.cp-grid h3,.cp-grid h4{margin:0 0 .3rem}.cp-grid p{margin:0;line-height:1.65}
  .cp-sub{margin:1.2rem 0 .5rem}
  .cp-list{padding-left:1.2rem}.cp-list li{margin-bottom:.5rem}
  .cp-tablewrap{margin:1rem 0;max-width:100%}
  .cp-table{width:100%;border-collapse:collapse;font-size:.92rem}
  .cp-table th,.cp-table td{padding:.7rem;border:1px solid rgba(255,255,255,.2);text-align:left;vertical-align:top;line-height:1.55;overflow-wrap:anywhere}
  .cp-table thead th{background:rgba(18,154,141,.22)}
  .cp-url{font-size:.78rem;font-weight:400;color:rgba(255,255,255,.75);overflow-wrap:anywhere}
  .cp-cta{display:inline-flex;align-items:center;min-height:46px;padding:.55rem 1rem;border:1px solid #2dd4bf;border-radius:10px;background:#0b766d;color:#fff!important;text-decoration:none}
  .cp-faq{display:grid;gap:.7rem}
  .faq-item{padding:.8rem 1rem;border:1px solid rgba(255,255,255,.16);border-radius:12px;background:rgba(255,255,255,.03)}
  .faq-item summary{cursor:pointer;font-weight:700;line-height:1.5;min-height:44px;display:flex;align-items:center}
  .faq-item summary:focus-visible,.cp-section a:focus-visible,.cp-crumbs a:focus-visible{outline:3px solid #e5b84a;outline-offset:3px}
  .faq-item p{margin:.3rem 0 .2rem;line-height:1.7;overflow-wrap:anywhere;max-width:none}
  @media(max-width:720px){
    .cp-hero{padding-top:1.5rem}
    .cp-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    .cp-table,.cp-table tbody,.cp-table tr,.cp-table th,.cp-table td{display:block;width:100%}
    .cp-table tr{margin-bottom:1rem;border:1px solid rgba(255,255,255,.2);border-radius:12px;overflow:hidden}
    .cp-table th,.cp-table td{border:0;border-bottom:1px solid rgba(255,255,255,.12)}
    .cp-table th::before,.cp-table td::before{content:attr(data-label);display:block;margin-bottom:.15rem;font-size:.75rem;font-weight:700;color:#f3cf70}
  }
</style>
