---
import { MAX_ROWS, MAX_BOARD_ROWS, MAX_AVG_ROWS } from '../scripts/marksTarget.mjs';
---

<section class="mt" id="marks-target-calculator" aria-labelledby="mt-title">
  <h2 id="mt-title">Work out your marks, percentage or attendance</h2>
  <p class="mt-note"><b>Private by design:</b> everything you type stays in this browser and is not sent to this site. Your numbers are saved on this device so they are still there when you come back. Press Clear my data to remove them.</p>

  <p class="mt-example"><button type="button" class="mt-btn" data-act="example">Try an example</button> <span class="mt-hint">Fills the open tab with sample numbers so you see an answer straight away. Then type your own.</span></p>

  <form class="mt-form" id="mt-form" novalidate onsubmit="return false">
    <div class="mt-tabs" role="tablist" aria-label="Choose what to work out">
      <button type="button" role="tab" id="mt-tab-need" aria-controls="mt-panel-need" aria-selected="true" data-mt-tab="need">Marks needed</button>
      <button type="button" role="tab" id="mt-tab-overall" aria-controls="mt-panel-overall" aria-selected="false" tabindex="-1" data-mt-tab="overall">Overall percentage</button>
      <button type="button" role="tab" id="mt-tab-att" aria-controls="mt-panel-att" aria-selected="false" tabindex="-1" data-mt-tab="att">Attendance</button>
      <button type="button" role="tab" id="mt-tab-board" aria-controls="mt-panel-board" aria-selected="false" tabindex="-1" data-mt-tab="board">Best of five</button>
      <button type="button" role="tab" id="mt-tab-avg" aria-controls="mt-panel-avg" aria-selected="false" tabindex="-1" data-mt-tab="avg">Average</button>
    </div>

    <div id="mt-panel-need" role="tabpanel" aria-labelledby="mt-tab-need" class="mt-panel">
      <p class="mt-hint">Type your target and the marks you already have. Leave the marks box empty for the part still to come, usually the final exam, and the calculator tells you what you need in it.</p>
      <div class="mt-grid">
        <label for="mt-need-target">Target overall percentage
          <input id="mt-need-target" type="text" inputmode="decimal" autocomplete="off" maxlength="8" data-fld="need.target" placeholder="for example 75">
        </label>
        <label for="mt-need-mode">How do the parts combine?
          <select id="mt-need-mode" data-fld="need.mode">
            <option value="weights">Percent weights that add up to 100, for example 30 and 70</option>
            <option value="addup">Marks simply add up, so the out-of marks are the weights</option>
          </select>
        </label>
      </div>
      <label for="mt-need-split" id="mt-need-split-label">Quick split (optional)
        <select id="mt-need-split" data-act-change="split">
          <option value="">Choose a split</option>
          <option value="30-70">Internal 30 and final exam 70</option>
          <option value="40-60">Internal 40 and final exam 60</option>
          <option value="50-50">Internal 50 and final exam 50</option>
          <option value="20-80">Internal 20 and final exam 80</option>
        </select>
      </label>
      <p class="mt-hint">A split fills the weights of the first two parts. These splits are only starting points. Use the split your school or college uses, and change the names and weights below.</p>
      <ol class="mt-rows" id="mt-rows-need"></ol>
      <button type="button" class="mt-btn" id="mt-add-need" data-act="add-row" data-list="need">Add a part</button>
      <label for="mt-need-pass">Pass mark in the part still to come (optional, percent of that part)
        <input id="mt-need-pass" type="text" inputmode="decimal" autocomplete="off" maxlength="8" data-fld="need.pass" placeholder="for example 40">
      </label>
      <div class="mt-out" id="mt-out-need" aria-live="polite"></div>
    </div>

    <div id="mt-panel-overall" role="tabpanel" aria-labelledby="mt-tab-overall" class="mt-panel" hidden>
      <p class="mt-hint">Type each subject with the marks you scored and the maximum marks. Subjects can have different maximums. The weight or credits box is optional: fill it for every subject or leave all of them empty.</p>
      <ol class="mt-rows" id="mt-rows-overall"></ol>
      <button type="button" class="mt-btn" id="mt-add-overall" data-act="add-row" data-list="overall">Add a subject</button>
      <div class="mt-out" id="mt-out-overall" aria-live="polite"></div>
    </div>

    <div id="mt-panel-att" role="tabpanel" aria-labelledby="mt-tab-att" class="mt-panel" hidden>
      <p class="mt-hint">Use whole numbers, counted the way your school or college counts them, as classes or as days. If it counts half days, double every number.</p>
      <div class="mt-grid">
        <label for="mt-att-attended">Classes you attended
          <input id="mt-att-attended" type="text" inputmode="numeric" autocomplete="off" maxlength="7" data-fld="att.attended" placeholder="for example 45">
        </label>
        <label for="mt-att-held">Classes held so far
          <input id="mt-att-held" type="text" inputmode="numeric" autocomplete="off" maxlength="7" data-fld="att.held" placeholder="for example 60">
        </label>
        <label for="mt-att-target">Attendance target (percent)
          <input id="mt-att-target" type="text" inputmode="decimal" autocomplete="off" maxlength="8" data-fld="att.target" placeholder="75">
        </label>
        <label for="mt-att-total">Classes in the whole term (optional)
          <input id="mt-att-total" type="text" inputmode="numeric" autocomplete="off" maxlength="7" data-fld="att.total" placeholder="for example 100">
        </label>
      </div>
      <div class="mt-out" id="mt-out-att" aria-live="polite"></div>
    </div>

    <div id="mt-panel-board" role="tabpanel" aria-labelledby="mt-tab-board" class="mt-panel" hidden>
      <p class="mt-hint">Type your subjects and marks, then say how many of them count. The best ones by percentage are counted. Tick Must count for a subject that has to be included, such as a language, if your college asks for it.</p>
      <div class="mt-grid">
        <label for="mt-board-count">How many subjects count?
          <input id="mt-board-count" type="text" inputmode="numeric" autocomplete="off" maxlength="3" data-fld="board.count" placeholder="5">
        </label>
      </div>
      <ol class="mt-rows" id="mt-rows-board"></ol>
      <button type="button" class="mt-btn" id="mt-add-board" data-act="add-row" data-list="board">Add a subject</button>
      <div class="mt-out" id="mt-out-board" aria-live="polite"></div>
    </div>

    <div id="mt-panel-avg" role="tabpanel" aria-labelledby="mt-tab-avg" class="mt-panel" hidden>
      <p class="mt-hint">Type the marks or values you want to average. Add a weight to every row for a weighted average, or leave the weights empty for a plain average.</p>
      <ol class="mt-rows" id="mt-rows-avg"></ol>
      <button type="button" class="mt-btn" id="mt-add-avg" data-act="add-row" data-list="avg">Add a row</button>
      <fieldset class="mt-box">
        <legend>Average you still need (optional)</legend>
        <p class="mt-hint">Every test counts the same here. Type the average you are aiming for and how many more tests are still to come.</p>
        <div class="mt-grid">
          <label for="mt-avg-target">Average you are aiming for
            <input id="mt-avg-target" type="text" inputmode="decimal" autocomplete="off" maxlength="12" data-fld="avg.target" placeholder="for example 70">
          </label>
          <label for="mt-avg-more">Tests still to come
            <input id="mt-avg-more" type="text" inputmode="numeric" autocomplete="off" maxlength="3" data-fld="avg.more" placeholder="for example 2">
          </label>
        </div>
      </fieldset>
      <div class="mt-out" id="mt-out-avg" aria-live="polite"></div>
    </div>
  </form>

  <div class="mt-sheetwrap">
    <div class="mt-screen">
      <h3 class="mt-sheethead">Result sheet</h3>
      <p class="mt-hint">The PDF and the printout use exactly this sheet, for the tab that is open. It shows your numbers and every step.</p>
    </div>
    <article class="mt-doc" id="mt-sheet" aria-label="Preview of the result sheet"></article>
    <div class="mt-actions mt-screen">
      <button type="button" class="mt-btn mt-btn--primary" data-act="pdf">Download result sheet (PDF)</button>
      <button type="button" class="mt-btn" data-act="print">Print result sheet</button>
      <button type="button" class="mt-btn" data-act="copy">Copy my result for WhatsApp</button>
      <button type="button" class="mt-btn" data-act="wa">Open WhatsApp with my result</button>
      <button type="button" class="mt-btn mt-btn--warn" data-act="clear">Clear my data</button>
    </div>
    <p class="mt-status mt-screen" id="mt-status" role="status" aria-live="polite"></p>
  </div>

  <noscript><p class="mt-note">This calculator needs JavaScript. The formulas on this page are simple enough to work out on paper.</p></noscript>
  <script is:inline type="application/json" id="mt-limits" set:html={JSON.stringify({ need: MAX_ROWS, overall: MAX_ROWS, board: MAX_BOARD_ROWS, avg: MAX_AVG_ROWS })} />
</section>

<script>
  // @ts-nocheck
  import { marksNeeded, overallPercent, attendance, boardBest, averageCalc, MAX_ROWS, MAX_BOARD_ROWS, MAX_AVG_ROWS } from '../scripts/marksTarget.mjs';
  import { sheetModel, modelToHtml, esc, buildPdf, hasUnsupportedText, prepareUnicodePdf, errorLine, nextStep, resultText } from '../scripts/marksTargetSheet.mjs';

  const KEY = 'fcs-marks-target-v1';
  const root = document.getElementById('marks-target-calculator');
  if (root) {
    const TABS = ['need', 'overall', 'att', 'board', 'avg'];
    const LIMIT = { need: MAX_ROWS, overall: MAX_ROWS, board: MAX_BOARD_ROWS, avg: MAX_AVG_ROWS };
    const ROW_WORD = { need: 'part', overall: 'subject', board: 'subject', avg: 'row' };
    const blankRow = (list, i) => {
      if (list === 'need') return { name: '', got: '', max: '', weight: '' };
      if (list === 'overall') return { name: '', got: '', max: '', weight: '' };
      if (list === 'board') return { name: '', got: '', max: '100', must: false };
      return { name: '', value: '', weight: '' };
    };
    const blank = () => ({
      tab: 'need',
      need: { target: '', mode: 'weights', pass: '', rows: [{ name: 'Internal marks', got: '', max: '', weight: '30' }, { name: 'Final exam', got: '', max: '', weight: '70' }] },
      overall: { rows: [blankRow('overall'), blankRow('overall'), blankRow('overall')] },
      att: { attended: '', held: '', target: '75', total: '' },
      board: { count: '5', rows: [blankRow('board'), blankRow('board'), blankRow('board'), blankRow('board'), blankRow('board'), blankRow('board')] },
      avg: { rows: [blankRow('avg'), blankRow('avg'), blankRow('avg')], target: '', more: '' },
    });
    const str = (v) => (typeof v === 'string' ? v.slice(0, 120) : '');
    const cleanRows = (list, rows, fallback) => {
      if (!Array.isArray(rows) || !rows.length) return fallback;
      return rows.slice(0, LIMIT[list]).map((r) => {
        const b = blankRow(list);
        Object.keys(b).forEach((k) => { b[k] = k === 'must' ? !!(r && r.must) : str(r && r[k]); });
        return b;
      });
    };
    let state = blank();
    try {
      const raw = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (raw && typeof raw === 'object') {
        const b = blank();
        state = {
          tab: TABS.includes(raw.tab) ? raw.tab : b.tab,
          need: { target: str(raw.need && raw.need.target), mode: raw.need && raw.need.mode === 'addup' ? 'addup' : 'weights', pass: str(raw.need && raw.need.pass), rows: cleanRows('need', raw.need && raw.need.rows, b.need.rows) },
          overall: { rows: cleanRows('overall', raw.overall && raw.overall.rows, b.overall.rows) },
          att: { attended: str(raw.att && raw.att.attended), held: str(raw.att && raw.att.held), target: raw.att && typeof raw.att.target === 'string' ? str(raw.att.target) : '75', total: str(raw.att && raw.att.total) },
          board: { count: raw.board && typeof raw.board.count === 'string' ? str(raw.board.count) : '5', rows: cleanRows('board', raw.board && raw.board.rows, b.board.rows) },
          avg: { rows: cleanRows('avg', raw.avg && raw.avg.rows, b.avg.rows), target: str(raw.avg && raw.avg.target), more: str(raw.avg && raw.avg.more) },
        };
      }
    } catch (e) {}

    const $ = (sel) => root.querySelector(sel);
    const persist = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} };
    const say = (t) => { $('#mt-status').textContent = t; };

    const bad = (msg) => '<p class="mt-err"><b>Check this:</b> ' + esc(msg) + '</p>';
    const steps = (list) => '<h4 class="mt-h4">Working, step by step</h4><ol class="mt-steps">' + list.map((s) => '<li>' + esc(s) + '</li>').join('') + '</ol>';
    const big = (t) => '<p class="mt-big">' + esc(t) + '</p>';
    const sub = (t) => '<p class="mt-sub">' + esc(t) + '</p>';
    const empty = (t) => '<p class="mt-empty">' + esc(t) + '</p>';

    function compute(tab) {
      if (tab === 'need') return marksNeeded({ target: state.need.target, mode: state.need.mode, rows: state.need.rows, pass: state.need.pass });
      if (tab === 'overall') return overallPercent({ rows: state.overall.rows });
      if (tab === 'att') return attendance({ attended: state.att.attended, held: state.att.held, target: state.att.target, total: state.att.total });
      if (tab === 'board') return boardBest({ count: state.board.count, rows: state.board.rows });
      return averageCalc({ rows: state.avg.rows, targetAvg: state.avg.target, moreTests: state.avg.more });
    }

    const EMPTY_TEXT = {
      need: 'Type your target percentage, then the marks you have for each part. Leave the marks empty for the part still to come.',
      overall: 'Type the marks you scored and the maximum marks for at least one subject.',
      att: 'Type the classes you attended and the classes held so far.',
      board: 'Type at least the number of subjects you want counted, and the marks for each subject.',
      avg: 'Type at least one value.',
    };

    function outNeed(res) {
      if (!res.ok) return res.error === 'nothing-yet' ? empty(EMPTY_TEXT.need) : bad(errorLine(res));
      const todo = res.parts.filter((u) => u.got === null);
      let head = '';
      if (res.status === 'all-done') {
        head = big('Overall: ' + res.overall + ' percent') + sub(res.met ? 'You have reached your target of ' + res.target + ' percent.' : 'You are ' + res.shortfall + ' points short of your target of ' + res.target + ' percent. Every part is already filled in, so nothing is left to change.');
      } else if (res.status === 'not-possible') {
        head = big('Not possible') + sub('The highest you can reach is ' + res.highest + ' percent, even with full marks in everything still to come. Your target of ' + res.target + ' percent would need ' + res.neededPercentOfRemaining + ' percent of the remaining parts, which is more than 100.') + sub('If you scored 0 in what is left, you would end at ' + res.lowest + ' percent.');
      } else {
        if (res.status === 'already-met') head = big('Target already reached') + sub('Even 0 in the remaining parts keeps you at ' + res.lowest + ' percent, which is above your target of ' + res.target + ' percent.');
        else {
          head = todo.map((u) => big('Score at least ' + u.neededMarks + ' out of ' + u.maxText + (todo.length > 1 ? ' in ' + u.name : ''))).join('');
          const first = todo[0];
          const wholeDiffers = first.neededWhole !== null && first.neededWhole !== first.neededMarks;
          head += sub('That is ' + first.neededPct + ' percent of ' + (todo.length > 1 ? 'each remaining part' : first.name) + '. Scoring exactly that lands on ' + res.overall + ' percent overall.' + (wholeDiffers && res.wholeOverall ? ' If marks are given in whole numbers, aim for ' + first.neededWhole + ', which gives ' + res.wholeOverall + ' percent.' : ''));
          if (res.passBinds) head += sub('Your pass mark of ' + res.passText + ' percent is higher than the target needs, so the pass mark sets this figure.');
        }
        head += sub('Lowest you could end at: ' + res.lowest + ' percent. Highest you could reach: ' + res.highest + ' percent.');
      }
      return head + steps(res.steps);
    }

    function table(headers, rows) {
      return '<div class="mt-tablewrap"><table class="mt-table"><thead><tr>' + headers.map((h) => '<th scope="col">' + esc(h) + '</th>').join('') + '</tr></thead><tbody>' +
        rows.map((r) => '<tr>' + r.map((c, i) => '<td data-label="' + esc(headers[i]) + '">' + esc(c) + '</td>').join('') + '</tr>').join('') + '</tbody></table></div>';
    }

    function outOverall(res) {
      if (!res.ok) return res.error === 'nothing-yet' ? empty(EMPTY_TEXT.overall) : bad(errorLine(res));
      let h = big('Overall: ' + res.overall + ' percent');
      h += sub(res.method === 'weighted' ? 'A weighted average of your subject percentages.' : 'Total marks scored (' + res.sumGot + ') over total marks available (' + res.sumMax + ').');
      if (res.best.length) h += sub('Biggest gain from 10 more points: ' + res.best.map((x) => x.name + ' (overall +' + x.gain + ' points, to ' + x.newOverall + ' percent)').join('; ') + '.');
      else h += sub('Every subject is at full marks, so there is nothing to gain.');
      h += '<h4 class="mt-h4">Where a gain is biggest</h4>' + table(['Subject', 'Your percent', 'Counts for', 'Marks available', 'Overall rise per extra mark', 'Gain from +10 points', 'Gain at full marks'], res.rows.map((r) => [r.name, r.pct + '%', r.share + '%', r.room, '+' + r.perMark, '+' + r.gainPlus10, '+' + r.gainFull]));
      h += '<p class="mt-fine">Gains are in percentage points of the overall result. +10 points means 10 more percent in that subject, stopping at full marks. Sorted with the biggest gain first.</p>';
      return h + steps(res.steps);
    }

    function outAtt(res) {
      if (!res.ok) return res.error === 'nothing-yet' ? empty(EMPTY_TEXT.att) : bad(errorLine(res));
      let h = '';
      if (res.kind === 'attend') h = big('Attend the next ' + res.more + ' class' + (res.more === '1' ? '' : 'es') + ' in a row') + sub('You are at ' + res.now + ' percent, below your target of ' + res.target + ' percent. After ' + res.more + ' more classes, all attended, you would be at ' + res.after + ' percent.');
      else if (res.kind === 'miss') h = big('You can miss up to ' + res.miss + ' class' + (res.miss === '1' ? '' : 'es')) + sub('You are at ' + res.now + ' percent, at or above your target of ' + res.target + ' percent. Missing ' + res.miss + ' of the next classes would leave you at ' + res.after + ' percent.');
      else h = big('Not possible') + sub('You are at ' + res.now + ' percent. A target of 100 percent cannot be reached again after a class is missed.');
      if (res.term) {
        h += res.term.possible
          ? sub('Over the whole term of ' + res.term.total + ' classes: attend at least ' + res.term.requiredAttended + ' in all, so ' + res.term.needMore + ' more of the ' + res.term.remaining + ' left. You can miss at most ' + res.term.canMiss + '.')
          : sub('Over the whole term of ' + res.term.total + ' classes this target is not possible. You need ' + res.term.needMore + ' more but only ' + res.term.remaining + ' are left. Attending all of them gives ' + res.term.bestFinish + ' percent.');
      }
      h += '<h4 class="mt-h4">The same numbers for other targets</h4>' + table(['If the target were', 'What it would mean for you'], res.table.map((r) => [r.target + ' percent', r.text]));
      return h + steps(res.steps);
    }

    function outBoard(res) {
      if (!res.ok) return res.error === 'nothing-yet' ? empty(EMPTY_TEXT.board) : bad(errorLine(res));
      let h = big(res.percent + ' percent');
      h += sub('Best ' + res.count + ' of ' + res.parts.length + ' subjects' + (res.mustCount ? ', with ' + res.mustCount + ' marked must count' : '') + ': ' + res.gotCounted + ' out of ' + res.maxCounted + ' marks. All ' + res.parts.length + ' subjects together give ' + res.percentAll + ' percent.');
      h += table(['Subject', 'Marks scored', 'Out of', 'Percent', 'Counted?'], res.parts.map((u) => [u.name, u.got, u.max, u.pct + '%', u.counted ? (u.must ? 'Yes, must count' : 'Yes') : 'No']));
      return h + steps(res.steps);
    }

    function outAvg(res) {
      if (!res.ok) return res.error === 'nothing-yet' ? empty(EMPTY_TEXT.avg) : bad(errorLine(res));
      let h = big('Average: ' + res.average);
      h += sub(res.n + ' value' + (res.n === 1 ? '' : 's') + ', total ' + res.sum + '.');
      if (res.weighted) h += sub('Weighted average: ' + res.weightedAverage + ' (weights add up to ' + res.weightSum + ').');
      if (res.need) {
        h += res.need.status === 'already'
          ? sub('Target average ' + res.need.target + ' is already reached, even with 0 in the ' + res.need.more + ' remaining test' + (res.need.more === '1' ? '' : 's') + '.')
          : sub('To reach an average of ' + res.need.target + ', score at least ' + res.need.average + ' in each of the ' + res.need.more + ' remaining test' + (res.need.more === '1' ? '' : 's') + ' (they must add up to ' + res.need.total + ').');
      }
      return h + steps(res.steps);
    }

    const OUT = { need: outNeed, overall: outOverall, att: outAtt, board: outBoard, avg: outAvg };
    const results = {};

    function markInvalid(tab, res) {
      root.querySelectorAll('#mt-panel-' + tab + ' [aria-invalid]').forEach((el) => { el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby'); });
      if (!res || res.ok) return;
      let el = null;
      if (res.row) el = root.querySelector('#mt-' + tab + '-' + (res.row - 1) + '-' + res.field);
      else if (tab === 'need' && res.error.startsWith('target')) el = root.querySelector('#mt-need-target');
      else if (tab === 'need' && res.error.startsWith('pass')) el = root.querySelector('#mt-need-pass');
      else if (tab === 'att') el = root.querySelector('#mt-att-' + res.field);
      else if (tab === 'board') el = root.querySelector('#mt-board-count');
      else if (tab === 'avg') el = root.querySelector('#mt-avg-' + (res.field === 'target' ? 'target' : 'more'));
      if (el) { el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', 'mt-out-' + tab); }
    }

    function renderPanel(tab) {
      let res;
      try { res = compute(tab); } catch (err) { console.error('Marks calculator error:', err); res = { ok: false, error: 'bad' }; }
      results[tab] = res;
      let html = OUT[tab](res);
      const next = nextStep(tab, res);
      if (next) {
        const nextHtml = '<p class="mt-next"><b>What to do next:</b> ' + esc(next).replace(/https:\/\/futurecareerschool\.com\/[^\s<]*[^\s<.,]/g, (u) => '<a href="' + u + '">' + u + '</a>') + '</p>';
        const lead = html.match(/^(?:<p class="mt-(?:big|sub)">[\s\S]*?<\/p>)+/);
        html = lead ? lead[0] + nextHtml + html.slice(lead[0].length) : html + nextHtml;
      }
      $('#mt-out-' + tab).innerHTML = html;
      markInvalid(tab, res);
      return res;
    }

    function renderSheet() {
      const res = results[state.tab];
      const model = sheetModel({ tab: state.tab, res, today: new Date() });
      $('#mt-sheet').innerHTML = modelToHtml(model);
      return model;
    }

    function renderAll() {
      TABS.forEach(renderPanel);
      renderSheet();
    }

    // ---------- rows ----------
    const inp = (list, i, f, label, extra) => '<label for="mt-' + list + '-' + i + '-' + f + '"' + ((extra && extra.cls) ? ' class="' + extra.cls + '"' : '') + ((extra && extra.hidden) ? ' hidden' : '') + '>' + label + '<input id="mt-' + list + '-' + i + '-' + f + '" type="text" ' + ((extra && extra.text) ? '' : 'inputmode="decimal" ') + 'autocomplete="off" maxlength="' + ((extra && extra.max) || 12) + '" data-list="' + list + '" data-i="' + i + '" data-f="' + f + '" value="' + esc(state[list].rows[i][f]) + '"' + ((extra && extra.ph) ? ' placeholder="' + esc(extra.ph) + '"' : '') + '></label>';

    function rowHtml(list, i) {
      const word = ROW_WORD[list];
      const n = i + 1;
      const rows = state[list].rows;
      let grid = '';
      if (list === 'need') {
        grid = inp(list, i, 'name', 'Name (optional)', { text: true, max: 60, cls: 'mt-span2', ph: 'for example Internal marks' }) +
          inp(list, i, 'got', 'Marks scored', { ph: 'still to come' }) +
          inp(list, i, 'max', 'Out of', { ph: 'for example 30' }) +
          inp(list, i, 'weight', 'Weight (percent)', { hidden: state.need.mode === 'addup', ph: 'for example 30' });
      } else if (list === 'overall') {
        grid = inp(list, i, 'name', 'Subject name (optional)', { text: true, max: 60, cls: 'mt-span2', ph: 'for example Maths' }) +
          inp(list, i, 'got', 'Marks scored', {}) +
          inp(list, i, 'max', 'Out of', {}) +
          inp(list, i, 'weight', 'Weight or credits (optional)', { cls: 'mt-span2' });
      } else if (list === 'board') {
        grid = inp(list, i, 'name', 'Subject name (optional)', { text: true, max: 60, cls: 'mt-span2', ph: 'for example Physics' }) +
          inp(list, i, 'got', 'Marks scored', {}) +
          inp(list, i, 'max', 'Out of', {}) +
          '<label class="mt-check mt-span2" for="mt-board-' + i + '-must"><input id="mt-board-' + i + '-must" type="checkbox" data-list="board" data-i="' + i + '" data-f="must"' + (rows[i].must ? ' checked' : '') + '> Must count (include this subject)</label>';
      } else {
        grid = inp(list, i, 'name', 'Label (optional)', { text: true, max: 60, cls: 'mt-span2', ph: 'for example Test 1' }) +
          inp(list, i, 'value', 'Value or marks', {}) +
          inp(list, i, 'weight', 'Weight (optional)', {});
      }
      return '<li class="mt-row"><fieldset class="mt-rowset"><legend>' + word.charAt(0).toUpperCase() + word.slice(1) + ' ' + n + '</legend><div class="mt-rowgrid">' + grid + '</div>' +
        '<button type="button" class="mt-mini" data-act="remove-row" data-list="' + list + '" data-i="' + i + '" aria-label="Remove ' + word + ' ' + n + '"' + (rows.length <= 1 ? ' disabled' : '') + '>Remove</button></fieldset></li>';
    }

    function renderRows(list) {
      const active = document.activeElement && root.contains(document.activeElement) ? document.activeElement.id : '';
      const el = $('#mt-rows-' + list);
      el.innerHTML = state[list].rows.map((_, i) => rowHtml(list, i)).join('');
      $('#mt-add-' + list).disabled = state[list].rows.length >= LIMIT[list];
      if (active) { const f = document.getElementById(active); if (f) f.focus(); }
    }

    function fillFixed() {
      root.querySelectorAll('[data-fld]').forEach((el) => {
        const [grp, key] = el.getAttribute('data-fld').split('.');
        el.value = state[grp][key] == null ? '' : state[grp][key];
      });
      ['need', 'overall', 'board', 'avg'].forEach(renderRows);
    }

    // ---------- tabs ----------
    function showTab(name, focusTab) {
      state.tab = name;
      TABS.forEach((t) => {
        const on = t === name;
        const btn = $('#mt-tab-' + t);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
        $('#mt-panel-' + t).hidden = !on;
      });
      if (focusTab) $('#mt-tab-' + name).focus();
      persist();
      renderSheet();
    }
    root.querySelectorAll('[data-mt-tab]').forEach((btn) => {
      btn.addEventListener('click', () => showTab(btn.getAttribute('data-mt-tab')));
      btn.addEventListener('keydown', (e) => {
        const i = TABS.indexOf(state.tab);
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % TABS.length;
        else if (e.key === 'ArrowLeft') n = (i + TABS.length - 1) % TABS.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = TABS.length - 1;
        if (n >= 0) { e.preventDefault(); showTab(TABS[n], true); }
      });
    });

    // ---------- typing ----------
    function onField(e) {
      const el = e.target;
      if (el.hasAttribute('data-act-change')) return;
      if (typeof exampleTabs !== 'undefined') exampleTabs[state.tab] = false;
      if (el.hasAttribute('data-fld')) {
        const [grp, key] = el.getAttribute('data-fld').split('.');
        state[grp][key] = el.value;
        if (grp === 'need' && key === 'mode') {
          renderRows('need');
        }
      } else if (el.hasAttribute('data-list')) {
        const list = el.getAttribute('data-list');
        const i = Number(el.getAttribute('data-i'));
        const f = el.getAttribute('data-f');
        if (!state[list].rows[i]) return;
        state[list].rows[i][f] = el.type === 'checkbox' ? el.checked : el.value;
      } else return;
      persist();
      renderPanel(state.tab);
      renderSheet();
    }
    root.addEventListener('input', onField);
    root.addEventListener('change', (e) => {
      const el = e.target;
      if (el.hasAttribute('data-act-change') && el.getAttribute('data-act-change') === 'split') {
        const v = el.value;
        if (!v) return;
        const [a, b] = v.split('-');
        const rows = state.need.rows;
        while (rows.length < 2) rows.push(blankRow('need'));
        rows[0].name = 'Internal marks'; rows[0].weight = a;
        rows[1].name = 'Final exam'; rows[1].weight = b;
        state.need.mode = 'weights';
        el.value = '';
        fillFixed(); persist(); renderPanel('need'); renderSheet();
        say('Weights set to ' + a + ' and ' + b + '. You can still edit them below.');
        return;
      }
      onField(e);
    });

    // ---------- actions ----------
    let pdfBusy = false;
    async function downloadPdf() {
      if (pdfBusy) return;
      pdfBusy = true;
      try {
        renderPanel(state.tab);
        const model = renderSheet();
        if (!model.any) { say('Enter your numbers first, so the sheet has a result to download.'); return; }
        let unicodeReady = false;
        const needsFont = hasUnsupportedText(model);
        if (needsFont) {
          say('Loading a font for your Telugu, Hindi or other text...');
          unicodeReady = await prepareUnicodePdf(model);
          if (!unicodeReady) { say('This device could not draw some of your text into the PDF. Use Print and choose Save as PDF instead, which keeps every script.'); return; }
        }
        say('Preparing the PDF...');
        const mod = await import('jspdf');
        const pdf = buildPdf(mod.jsPDF, model, unicodeReady);
        pdf.save(model.fileName);
        say(needsFont
          ? 'PDF downloaded. Telugu, Hindi or other script text is drawn as pictures so the letters keep their shape, so that text cannot be selected or copied. It was made in this browser and not uploaded.'
          : 'PDF downloaded. It was made in this browser and not uploaded.');
      } catch (err) {
        console.error('Unable to create the marks result sheet PDF:', err);
        say('The PDF could not be made. Use Print and choose Save as PDF instead.');
      } finally {
        pdfBusy = false;
      }
    }

    function printSheet() {
      renderPanel(state.tab);
      renderSheet();
      document.body.setAttribute('data-mt-print', 'sheet');
      const done = () => { document.body.removeAttribute('data-mt-print'); window.removeEventListener('afterprint', done); };
      window.addEventListener('afterprint', done);
      window.print();
    }

    const EXAMPLES = {
      need: () => ({ target: '75', mode: 'weights', pass: '', rows: [{ name: 'Internal marks', got: '24', max: '30', weight: '30' }, { name: 'Final exam', got: '', max: '100', weight: '70' }] }),
      overall: () => ({ rows: [{ name: 'Maths', got: '78', max: '100', weight: '' }, { name: 'Science', got: '66', max: '100', weight: '' }, { name: 'English', got: '82', max: '100', weight: '' }] }),
      att: () => ({ attended: '42', held: '60', target: '75', total: '' }),
      board: () => ({ count: '5', rows: [82, 76, 91, 68, 88, 79].map((g, i) => ({ name: 'Subject ' + (i + 1), got: String(g), max: '100', must: false })) }),
      avg: () => ({ rows: [{ name: 'Test 1', value: '62', weight: '' }, { name: 'Test 2', value: '71', weight: '' }, { name: 'Test 3', value: '68', weight: '' }], target: '70', more: '2' }),
    };
    function hasTyped(tab) {
      const g = state[tab];
      const rows = g.rows || [];
      return rows.some((r) => ['got', 'max', 'value'].some((k) => r[k] && String(r[k]).trim() && !(tab === 'board' && k === 'max' && r[k] === '100'))) ||
        ['target', 'attended', 'held', 'more', 'total'].some((k) => g[k] && String(g[k]).trim() && !(tab === 'att' && k === 'target' && g[k] === '75'));
    }
    const exampleTabs = {};
    function useExample() {
      const tab = state.tab;
      if (hasTyped(tab) && !exampleTabs[tab] && !window.confirm('Replace the numbers on this tab with a sample? Your own numbers on this tab will be lost.')) return;
      state[tab] = EXAMPLES[tab]();
      exampleTabs[tab] = true;
      fillFixed(); persist(); renderAll();
      say('Sample numbers are filled in on this tab. Change any box to use your own numbers.');
    }

    async function copyResult() {
      renderPanel(state.tab);
      const model = renderSheet();
      const text = model.any ? resultText(model) : '';
      if (!text) { say('Enter your numbers first, so there is a result to copy.'); return; }
      let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; } catch (e) {}
      if (!ok) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0, ta.value.length);
          ok = document.execCommand('copy'); document.body.removeChild(ta);
        } catch (e) {}
      }
      say(ok ? 'Copied. Open WhatsApp and paste it into any chat.' : 'Your browser did not allow copying. Use Open WhatsApp with my result instead.');
    }

    function openWhatsApp() {
      renderPanel(state.tab);
      const model = renderSheet();
      const text = model.any ? resultText(model) : '';
      if (!text) { say('Enter your numbers first, so there is a result to send.'); return; }
      const w = window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank', 'noopener');
      say(w ? 'WhatsApp is opening. Pick a chat to send your result to.' : 'Your browser blocked the new tab. Use Copy my result for WhatsApp instead.');
    }

    function clearData() {
      state = blank();
      try { localStorage.removeItem(KEY); } catch (e) {}
      fillFixed(); showTab('need'); renderAll();
      try { localStorage.removeItem(KEY); } catch (e) {}
      say('Your numbers were cleared from this browser.');
      const f = $('#mt-need-target'); if (f) f.focus();
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act]');
      if (!btn || btn.disabled) return;
      const a = btn.getAttribute('data-act');
      if (a === 'pdf') downloadPdf();
      else if (a === 'print') printSheet();
      else if (a === 'clear') clearData();
      else if (a === 'example') useExample();
      else if (a === 'copy') copyResult();
      else if (a === 'wa') openWhatsApp();
      else if (a === 'add-row') {
        const list = btn.getAttribute('data-list');
        if (state[list].rows.length < LIMIT[list]) {
          state[list].rows.push(blankRow(list));
          persist(); renderRows(list); renderPanel(state.tab); renderSheet();
          const first = $('#mt-' + list + '-' + (state[list].rows.length - 1) + '-' + 'name');
          if (first) first.focus();
        }
      } else if (a === 'remove-row') {
        const list = btn.getAttribute('data-list');
        const i = Number(btn.getAttribute('data-i'));
        if (state[list].rows.length > 1) {
          state[list].rows.splice(i, 1);
          persist(); renderRows(list); renderPanel(state.tab); renderSheet();
          const next = $('#mt-' + list + '-' + Math.min(i, state[list].rows.length - 1) + '-name');
          if (next) next.focus();
        }
      }
    });

    fillFixed();
    renderAll();
    showTab(state.tab);
  }
</script>

