---
// The working tool for /tools/career-guidance-questionnaire-for-students/.
// The form is built in the browser from src/data/careerQuestionnaire.mjs by src/scripts/careerQuestionnaire.ts.
import { STAGES, STAGE_KEYS, ALL_SECTIONS, byStage } from '../data/careerQuestionnaire.mjs';

const sectionChoices = ALL_SECTIONS.map((s) => ({ id: s.id, label: byStage(s.title, 'school') === 'My subjects' ? 'My subjects or course' : byStage(s.title, 'school') }));
---

<section class="cq" id="career-questionnaire" aria-labelledby="cq-title">
  <h2 id="cq-title">Career guidance questionnaire: answer online or print a blank form</h2>
  <p class="cq-note"><b>Private by design:</b> your answers stay in this browser. The tool asks for no phone number or email, a first name is optional, and nothing is sent to this site. On a shared computer, press Clear my answers when you finish.</p>

  <div class="cq-setup">
    <fieldset class="cq-box cq-stage">
      <legend>1. Who is it for?</legend>
      <div class="cq-stage-row">
        {STAGE_KEYS.map((k) => (
          <label class="cq-pill cq-pill--wide">
            <input type="radio" name="cq-stage" value={k} checked={k === 'school'} />
            <span>{STAGES[k].short}</span>
          </label>
        ))}
      </div>
      <p class="cq-hint">Changing the stage changes the wording of some questions, such as subjects and course. Your answers are kept.</p>
    </fieldset>

    <fieldset class="cq-box cq-secpick">
      <legend>2. Which sections?</legend>
      <div class="cq-secgrid">
        {sectionChoices.map((s) => (
          <label class="cq-opt">
            <input type="checkbox" data-cq-section={s.id} />
            <span>{s.label}</span>
          </label>
        ))}
      </div>
      <div class="cq-actions cq-actions--tight">
        <button type="button" class="cq-btn" data-cq="set-class">Use the 20-minute class set</button>
        <button type="button" class="cq-btn" data-cq="set-all">Use every section</button>
      </div>
      <p class="cq-hint" id="cq-secstatus" role="status" aria-live="polite"></p>
    </fieldset>

    <div class="cq-box cq-paper">
      <h3>3. Want paper?</h3>
      <p class="cq-hint">The blank form is an A4 paper survey with tick boxes, number scales and writing lines. It uses the stage and sections you chose above.</p>
      <div class="cq-actions">
        <button type="button" class="cq-btn cq-btn--primary" data-cq="pdf-blank">Download blank PDF</button>
        <button type="button" class="cq-btn" data-cq="print-blank">Print blank form</button>
        <button type="button" class="cq-btn" data-cq="preview-blank" aria-expanded="false" aria-controls="cq-blankwrap">Preview the paper form</button>
      </div>
      <p class="cq-status" id="cq-status-blank" role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="cq-blankwrap" id="cq-blankwrap" hidden>
    <article class="cq-doc cq-doc--form" id="cq-doc-blank" aria-label="Preview of the blank paper form"></article>
  </div>

  <div class="cq-tabs" role="tablist" aria-label="Answer online or see the summary">
    <button type="button" role="tab" id="cq-tab-answer" aria-controls="cq-panel-answer" aria-selected="true" data-cq-tab="answer">4. Answer online</button>
    <button type="button" role="tab" id="cq-tab-summary" aria-controls="cq-panel-summary" aria-selected="false" data-cq-tab="summary" tabindex="-1">5. Summary and PDF</button>
  </div>

  <div id="cq-panel-answer" role="tabpanel" aria-labelledby="cq-tab-answer" class="cq-panel cq-panel-answer">
    <p class="cq-hint cq-scalehint">You can skip any question. To clear a 1 to 5 line or a one-choice answer, tap the selected answer again, or press Delete on a keyboard.</p>
    <form id="cq-form" novalidate onsubmit="return false"></form>
    <p class="cq-progress" id="cq-progress" role="status" aria-live="polite"></p>
    <div class="cq-actions">
      <button type="button" class="cq-btn cq-btn--primary" data-cq="see-summary">See my summary</button>
      <button type="button" class="cq-btn cq-btn--warn" data-cq="clear">Clear my answers</button>
    </div>
    <p class="cq-status" id="cq-status-answer" role="status" aria-live="polite"></p>
  </div>

  <div id="cq-panel-summary" role="tabpanel" aria-labelledby="cq-tab-summary" class="cq-panel cq-panel-summary" hidden>
    <div class="cq-screen">
      <h3 id="cq-summary-head" tabindex="-1">Your one-page summary</h3>
      <p class="cq-hint">It repeats what you ticked and typed, groups it by section and lists a few questions to talk about. It gives no score and names no careers.</p>
      <div class="cq-actions">
        <button type="button" class="cq-btn cq-btn--primary" data-cq="pdf-filled">Download filled PDF</button>
        <button type="button" class="cq-btn" data-cq="pdf-summary">Download summary only</button>
        <button type="button" class="cq-btn" data-cq="print-summary">Print summary</button>
        <button type="button" class="cq-btn cq-btn--warn" data-cq="clear">Clear my answers</button>
      </div>
      <p class="cq-status" id="cq-status-summary" role="status" aria-live="polite"></p>
      <p class="cq-hint">The filled PDF has the summary first, then the same paper form with your answers marked.</p>
    </div>
    <article class="cq-doc" id="cq-doc-summary" aria-label="Preview of the summary"></article>
  </div>

  <noscript><p class="cq-note">This tool needs JavaScript. The questions are listed on this page under What the questionnaire asks, and you can copy them onto paper.</p></noscript>
</section>

<script>
  // @ts-nocheck
  import {
    STORAGE_KEY, STAGES, STAGE_KEYS, ALL_SECTIONS, SECTION_ORDER, DEFAULT_SECTIONS, CLASS_SET, START, SCALE_LABELS, MARKS,
    blankState, normaliseState, sectionsToShow, sectionTitle, sectionIntro, qLabel, qOptions, scaleLabels, getAnswer, countAnswered,
    summaryModel, summaryHtml, formHtml, esc, byStage, buildPdf, pdfFileName, hasUnsupportedText, prepareUnicodePdf, todayLabel, OPTION_ROWS,
  } from '../scripts/careerQuestionnaire';

  const root = document.getElementById('career-questionnaire');
  if (root) {
    let state = blankState();
    try {
      const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (raw) state = normaliseState(raw);
    } catch (e) {}

    const $ = (sel) => root.querySelector(sel);
    const form = $('#cq-form');
    const docSummary = $('#cq-doc-summary');
    const docBlank = $('#cq-doc-blank');
    const blankWrap = $('#cq-blankwrap');
    const statusEl = { blank: $('#cq-status-blank'), answer: $('#cq-status-answer'), summary: $('#cq-status-summary'), sec: $('#cq-secstatus') };
    let tab = 'answer';

    const persist = () => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {} };
    const say = (which, text) => { statusEl[which].textContent = text; };

    // ---------- build the form ----------
    const optHtml = (q, id, label, checked, type, disabled) =>
      '<label class="cq-opt"><input type="' + type + '" data-q="' + q.id + '" data-t="' + q.type + '" ' + (type === 'radio' ? 'name="cq-' + q.id + '" ' : '') + 'value="' + esc(id) + '"' + (checked ? ' checked' : '') + (disabled ? ' disabled' : '') + ' /><span>' + esc(label) + '</span></label>';

    function questionHtml(q, n) {
      const stage = state.stage;
      const label = qLabel(q, stage);
      if (q.type === 'tick') {
        const sel = getAnswer(state, q);
        const full = q.max && sel.length >= q.max;
        return '<fieldset class="cq-qf" data-max="' + (q.max || 0) + '"><legend class="cq-ql"><b>' + n + '</b> ' + esc(label) + '</legend><div class="cq-optgrid">' +
          qOptions(q, stage).map((o) => optHtml(q, o[0], o[1], sel.includes(o[0]), 'checkbox', full && !sel.includes(o[0]))).join('') + '</div></fieldset>';
      }
      if (q.type === 'choice') {
        const sel = getAnswer(state, q);
        return '<fieldset class="cq-qf"><legend class="cq-ql"><b>' + n + '</b> ' + esc(label) + '</legend><div class="cq-optgrid">' +
          qOptions(q, stage).map((o) => optHtml(q, o[0], o[1], sel === o[0], 'radio', false)).join('') + '</div></fieldset>';
      }
      if (q.type === 'scale') {
        const sel = getAnswer(state, q); const lab = scaleLabels(q);
        return '<fieldset class="cq-qf"><legend class="cq-ql"><b>' + n + '</b> ' + esc(label) + '</legend><div class="cq-scale">' +
          [1, 2, 3, 4, 5].map((k) => '<label class="cq-pill"><input type="radio" name="cq-' + q.id + '" data-q="' + q.id + '" data-t="scale" value="' + k + '"' + (sel === String(k) ? ' checked' : '') + ' aria-label="' + k + ' of 5, ' + (k === 1 ? esc(lab[0]) : k === 5 ? esc(lab[1]) : 'in between') + '" /><span>' + k + '</span></label>').join('') +
          '</div><div class="cq-ends" aria-hidden="true"><span>1 = ' + esc(lab[0]) + '</span><span>5 = ' + esc(lab[1]) + '</span></div></fieldset>';
      }
      if (q.type === 'text') {
        return '<label class="cq-textlab"><span class="cq-ql"><b>' + n + '</b> ' + esc(label) + '</span><textarea data-q="' + q.id + '" data-t="text" rows="' + (q.lines > 2 ? 3 : 2) + '" maxlength="' + (q.max || 200) + '" autocomplete="off">' + esc(getAnswer(state, q)) + '</textarea></label>';
      }
      if (q.type === 'options') {
        return '<fieldset class="cq-qf"><legend class="cq-ql"><b>' + n + '</b> ' + esc(label) + '</legend><p class="cq-hint">If you are not sure of the mark, leave it as Not yet checked and work it out with the counsellor. A mark describes the route, not you.</p>' +
          state.opts.map((o, i) => '<div class="cq-optrow"><label>Option ' + (i + 1) + '<input type="text" data-opt="' + i + '" data-f="name" maxlength="120" autocomplete="off" value="' + esc(o.name) + '" /></label>' +
            '<label>Growth mark<select data-opt="' + i + '" data-f="mark">' + Object.keys(MARKS).map((k) => '<option value="' + k + '"' + (o.mark === k ? ' selected' : '') + '>' + esc(MARKS[k]) + '</option>').join('') + '</select></label>' +
            '<label>Main risk I know of<input type="text" data-opt="' + i + '" data-f="risk" maxlength="160" autocomplete="off" value="' + esc(o.risk) + '" /></label></div>').join('') + '</fieldset>';
      }
      return '';
    }

    function startHtml() {
      const stage = state.stage;
      return '<fieldset class="cq-box"><legend>Start here</legend>' +
        '<label class="cq-textlab"><span class="cq-ql">' + esc(START.name.label) + '</span><input type="text" data-start="name" maxlength="' + START.name.max + '" autocomplete="off" value="' + esc(state.name) + '" /></label>' +
        '<fieldset class="cq-qf"><legend class="cq-ql">' + esc(byStage(START.year.label, stage)) + '</legend><div class="cq-optgrid">' +
        byStage(START.year.options, stage).map((o) => '<label class="cq-opt"><input type="radio" name="cq-year" data-start="year" value="' + o[0] + '"' + (state.year === o[0] ? ' checked' : '') + ' /><span>' + esc(o[1]) + '</span></label>').join('') + '</div></fieldset>' +
        '<label class="cq-textlab"><span class="cq-ql">' + esc(byStage(START.focus.label, stage)) + '</span><input type="text" data-start="focus" maxlength="' + START.focus.max + '" autocomplete="off" value="' + esc(state.focus) + '" /></label></fieldset>';
    }

    function renderForm() {
      const stage = state.stage;
      let num = 0;
      const parts = [startHtml()];
      sectionsToShow(state).forEach((sec) => {
        num += 1;
        parts.push('<fieldset class="cq-box cq-sec" id="cq-sec-' + sec.id + '"><legend>' + num + '. ' + esc(sectionTitle(sec, stage)) + '</legend><p class="cq-hint">' + esc(sectionIntro(sec, stage)) + '</p>' +
          sec.questions.map((q, i) => questionHtml(q, num + '.' + (i + 1))).join('') + '</fieldset>');
      });
      form.innerHTML = parts.join('');
    }

    function syncControls() {
      root.querySelectorAll('input[name="cq-stage"]').forEach((el) => { el.checked = el.value === state.stage; });
      root.querySelectorAll('[data-cq-section]').forEach((el) => { el.checked = !!state.sections[el.getAttribute('data-cq-section')]; });
    }

    function renderProgress() {
      const c = countAnswered(state);
      $('#cq-progress').textContent = c.done + ' of ' + c.total + ' questions answered. Skipping questions is fine.';
    }

    function renderDocs() {
      docSummary.innerHTML = summaryHtml(summaryModel(state, todayLabel()));
      docBlank.innerHTML = formHtml(state, false);
    }

    function refreshAll() { renderForm(); syncControls(); renderDocs(); renderProgress(); }

    // ---------- tabs ----------
    function showTab(name) {
      tab = name;
      ['answer', 'summary'].forEach((t) => {
        const on = t === name;
        const btn = $('#cq-tab-' + t);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
        $('#cq-panel-' + t).hidden = !on;
      });
    }
    root.querySelectorAll('[data-cq-tab]').forEach((btn) => {
      btn.addEventListener('click', () => showTab(btn.getAttribute('data-cq-tab')));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const next = tab === 'answer' ? 'summary' : 'answer'; showTab(next); $('#cq-tab-' + next).focus(); }
      });
    });

    // ---------- reading the form ----------
    function updateTickLimit(fs) {
      const max = Number(fs.getAttribute('data-max') || 0);
      if (!max) return;
      const boxes = fs.querySelectorAll('input[type="checkbox"]');
      const n = Array.from(boxes).filter((b) => b.checked).length;
      boxes.forEach((b) => { b.disabled = n >= max && !b.checked; });
    }

    function onChange(e) {
      const el = e.target;
      if (el.hasAttribute('data-cq-section')) {
        const id = el.getAttribute('data-cq-section');
        state.sections[id] = el.checked;
        if (!SECTION_ORDER.concat(['parent']).some((s) => state.sections[s])) {
          state.sections[id] = true; el.checked = true;
          say('sec', 'Keep at least one section.');
          return;
        }
        say('sec', sectionsToShow(state).length + ' sections chosen.');
        persist(); refreshAll();
        return;
      }
      if (el.name === 'cq-stage') {
        state.stage = el.value;
        persist(); refreshAll();
        say('sec', 'Questions now use the wording for ' + STAGES[state.stage].long + '.');
        return;
      }
      if (el.hasAttribute('data-start')) {
        state[el.getAttribute('data-start')] = el.value;
      } else if (el.hasAttribute('data-opt')) {
        state.opts[Number(el.getAttribute('data-opt'))][el.getAttribute('data-f')] = el.value;
      } else if (el.hasAttribute('data-q')) {
        const id = el.getAttribute('data-q'); const t = el.getAttribute('data-t');
        if (t === 'tick') {
          const fs = el.closest('fieldset');
          state.a[id] = Array.from(fs.querySelectorAll('input[type="checkbox"]')).filter((b) => b.checked).map((b) => b.value);
          updateTickLimit(fs);
        } else state.a[id] = el.value;
      } else return;
      persist(); renderDocs(); renderProgress();
    }
    root.addEventListener('input', (e) => { if (e.target.matches('input[type="text"], textarea')) onChange(e); });
    root.addEventListener('change', onChange);

    // Tap a selected radio again to clear it, so a question can be skipped after answering.
    root.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof HTMLInputElement) || el.type !== 'radio') return;
      let cur = '';
      if (el.hasAttribute('data-q')) cur = state.a[el.getAttribute('data-q')];
      else if (el.getAttribute('data-start') === 'year') cur = state.year;
      else return;
      if (cur === el.value) {
        el.checked = false;
        if (el.hasAttribute('data-q')) state.a[el.getAttribute('data-q')] = '';
        else state.year = '';
        persist(); renderDocs(); renderProgress();
      }
    });

    root.addEventListener('keydown', (e) => {
      const el = e.target;
      if ((e.key !== 'Delete' && e.key !== 'Backspace') || !(el instanceof HTMLInputElement) || el.type !== 'radio') return;
      if (el.hasAttribute('data-q')) state.a[el.getAttribute('data-q')] = '';
      else if (el.getAttribute('data-start') === 'year') state.year = '';
      else return;
      e.preventDefault();
      el.closest('fieldset').querySelectorAll('input[type="radio"]').forEach((r) => { r.checked = false; });
      persist(); renderDocs(); renderProgress();
    });

    // ---------- actions ----------
    let pdfBusy = false;
    async function downloadPdf(mode, out) {
      if (pdfBusy) return;
      pdfBusy = true;
      try {
        const needsFont = hasUnsupportedText(state, mode);
        let unicodeReady = false;
        if (needsFont) {
          say(out, 'Loading a font for your Telugu, Hindi or other text...');
          unicodeReady = await prepareUnicodePdf(state);
          if (!unicodeReady) { say(out, 'This device could not draw some of your text into the PDF. Use Print and choose Save as PDF instead, which keeps every script.'); return; }
        }
        say(out, 'Preparing the PDF...');
        const mod = await import('jspdf');
        const pdf = buildPdf(mod.jsPDF, state, mode, unicodeReady);
        pdf.save(pdfFileName(state, mode));
        say(out, (mode === 'blank' ? 'Blank PDF downloaded.' : 'PDF downloaded.') + (needsFont ? ' Text in Telugu, Hindi or other scripts is drawn as pictures so the letters keep their shape, so that text cannot be selected or copied from the PDF.' : '') + ' It was made in this browser and not uploaded.');
      } catch (err) {
        console.error('Unable to create the questionnaire PDF:', err);
        say(out, 'The PDF could not be made. Use Print and choose Save as PDF instead.');
      } finally { pdfBusy = false; }
    }

    function printDoc(kind) {
      renderDocs();
      const wasHidden = blankWrap.hidden; const wasTab = tab;
      if (kind === 'blank') blankWrap.hidden = false; else showTab('summary');
      document.body.setAttribute('data-cq-print', kind);
      const done = () => {
        document.body.removeAttribute('data-cq-print');
        blankWrap.hidden = wasHidden && !previewOn;
        if (wasTab !== tab) showTab(wasTab);
        window.removeEventListener('afterprint', done);
      };
      window.addEventListener('afterprint', done);
      window.print();
    }

    let previewOn = false;
    function togglePreview() {
      previewOn = !previewOn;
      blankWrap.hidden = !previewOn;
      const btn = $('[data-cq="preview-blank"]');
      btn.setAttribute('aria-expanded', previewOn ? 'true' : 'false');
      btn.textContent = previewOn ? 'Hide the paper form' : 'Preview the paper form';
      if (previewOn) { renderDocs(); blankWrap.scrollIntoView({ block: 'start' }); }
    }

    function clearAll() {
      if (!window.confirm('Clear all answers, the name and the section choices from this browser? This cannot be undone.')) return;
      state = blankState();
      try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
      refreshAll(); showTab('answer');
      say('answer', 'All answers were cleared from this browser.'); say('summary', 'All answers were cleared from this browser.');
      const first = form.querySelector('input, textarea'); if (first) first.focus();
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-cq]');
      if (!btn) return;
      const a = btn.getAttribute('data-cq');
      if (a === 'pdf-blank') downloadPdf('blank', 'blank');
      else if (a === 'print-blank') printDoc('blank');
      else if (a === 'preview-blank') togglePreview();
      else if (a === 'set-class') { SECTION_ORDER.concat(['parent']).forEach((id) => { state.sections[id] = CLASS_SET.includes(id); }); persist(); refreshAll(); say('sec', 'The 20-minute class set is on: ' + CLASS_SET.length + ' sections.'); }
      else if (a === 'set-all') { SECTION_ORDER.concat(['parent']).forEach((id) => { state.sections[id] = DEFAULT_SECTIONS.includes(id); }); persist(); refreshAll(); say('sec', 'Every student section is on. The parent or guardian section stays off unless you tick it.'); }
      else if (a === 'see-summary') { renderDocs(); showTab('summary'); const h = $('#cq-summary-head'); h.scrollIntoView({ block: 'start' }); h.focus({ preventScroll: true }); }
      else if (a === 'pdf-filled') downloadPdf('filled', 'summary');
      else if (a === 'pdf-summary') downloadPdf('summary', 'summary');
      else if (a === 'print-summary') printDoc('summary');
      else if (a === 'clear') clearAll();
    });

    refreshAll();
    persist();
  }
</script>

<style is:global>
  .cq{margin:2rem 0;padding:1.3rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05);min-width:0}
  .cq h2{margin:0 0 .6rem}
  .cq h3{margin:.1rem 0 .4rem}
  .cq p,.cq li{line-height:1.65}
  .cq-note,.cq-hint,.cq-status,.cq-progress{font-size:.88rem;color:rgba(255,255,255,.78)}
  .cq-hint{margin:.2rem 0 .7rem}
  .cq-status,.cq-progress{min-height:1.4em;color:#9ff3e6;margin:.6rem 0 0}
  .cq-setup{display:grid;gap:1rem;margin-top:1rem}
  .cq-box{min-width:0;margin:0 0 1rem;padding:1rem;border:1px solid rgba(255,255,255,.3);border-radius:12px}
  .cq-setup .cq-box{margin:0}
  .cq-box>legend{padding:0 .4rem;font-weight:700}
  .cq-stage-row{display:flex;flex-wrap:wrap;gap:.5rem}
  .cq-secgrid,.cq-optgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .9rem}
  .cq-opt{display:flex;align-items:flex-start;gap:.6rem;min-height:44px;padding:.5rem .3rem;font-size:.92rem;line-height:1.4;cursor:pointer;min-width:0}
  .cq-opt input{flex:0 0 1.35rem;width:1.35rem;height:1.35rem;margin:.1rem 0 0;accent-color:#2dd4bf}
  .cq-opt span{min-width:0;overflow-wrap:anywhere}
  .cq-pill{position:relative;display:inline-flex}
  .cq-pill input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .cq-pill span{display:grid;place-items:center;min-width:44px;min-height:44px;padding:.2rem .6rem;border:2px solid rgba(255,255,255,.55);border-radius:12px;background:rgba(255,255,255,.05);font-weight:700;font-size:1rem}
  .cq-pill--wide span{padding:.4rem 1rem;font-size:.95rem}
  .cq-pill input:checked+span{background:#0b766d;border-color:#2dd4bf;color:#fff}
  .cq-pill input:focus-visible+span{outline:3px solid #e5b84a;outline-offset:2px}
  .cq-scale{display:flex;gap:.45rem}
  .cq-ends{display:flex;justify-content:space-between;gap:.5rem;margin-top:.3rem;font-size:.8rem;color:rgba(255,255,255,.78)}
  .cq-qf{min-width:0;margin:1rem 0 0;padding:0;border:0}
  .cq-ql{display:block;padding:0;margin-bottom:.35rem;font-weight:600;font-size:.95rem;line-height:1.5}
  .cq-ql b{color:#f3cf70;margin-right:.25rem}
  .cq-qf>legend{float:left;width:100%;padding:0;margin-bottom:.35rem}
  .cq-qf>legend+*{clear:both}
  .cq-textlab{display:grid;gap:.3rem;margin:1rem 0 0;min-width:0}
  .cq input[type="text"],.cq textarea,.cq select{width:100%;min-width:0;max-width:100%;box-sizing:border-box;min-height:44px;padding:.55rem .7rem;border:1px solid rgba(255,255,255,.5);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;font-weight:400}
  .cq textarea{resize:vertical;min-height:70px}
