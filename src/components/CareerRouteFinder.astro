---
type RouteRecord = {
  key: string;
  featured?: boolean;
  title: string;
  category: string;
  summary: string;
  routeSummary: string;
  entryRoutes: string[];
  nextStep: string;
  tags: string[];
  suitableStages: string[];
  workSetting: string;
  routeLength: string;
  regulated: boolean;
  dataConfidence: string;
  scalability: 'high' | 'mid' | 'low';
  scalabilityLabel: string;
  scalabilityTip: string;
  scalabilityWhy: string;
};

interface Props {
  routes: RouteRecord[];
}

const { routes } = Astro.props;
const routeData = routes.map(({ key, featured, title, category, summary, routeSummary, entryRoutes, nextStep, tags, suitableStages, workSetting, routeLength, regulated, dataConfidence, scalability, scalabilityLabel, scalabilityTip, scalabilityWhy }) => ({
  key, featured: !!featured, title, category, summary, routeSummary, entryRoutes, nextStep, tags, suitableStages, workSetting, routeLength, regulated, dataConfidence, scalability, scalabilityLabel, scalabilityTip, scalabilityWhy,
}));
const categories = [...new Set(routes.map((route) => route.category))].sort();
---

<section class="crf" id="career-route-finder" aria-labelledby="crf-title">
  <div class="crf-head">
    <div>
      <p class="crf-kicker">Editorial career catalogue · browser-local</p>
      <h2 id="crf-title">Search the route catalogue</h2>
      <p>Type the kind of work or subject you like, in English. Tap Compare on up to three results, then copy your shortlist or print it. These are starting points from the school’s editorial catalogue; they do not rank people or promise a job. Your search stays in this browser.</p>
    </div>
  </div>
  <form class="crf-form" id="crf-form">
    <label>What are you exploring?
      <input id="crf-query" type="search" maxlength="80" placeholder="For example: design, nursing, data, teaching" autocomplete="off" enterkeyhint="search">
    </label>
    <label>Stage or route context
      <select id="crf-stage">
        <option value="">Any stage</option>
        <option value="after-10th">After Class 10</option>
        <option value="after-12th-science">After Class 12 science</option>
        <option value="after-12th-commerce">After Class 12 commerce</option>
        <option value="after-12th-humanities">After Class 12 arts or humanities</option>
        <option value="college">College or graduate</option>
        <option value="working">Working or changing direction</option>
      </select>
    </label>
    <label>Category
      <select id="crf-category">
        <option value="">All categories</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </label>
    <button type="submit">Show routes</button>
    <button type="reset" class="crf-secondary">Reset</button>
  </form>
  <div class="crf-chips" id="crf-chips"><span>Try:</span>{['design', 'data', 'teaching', 'nursing', 'accounting', 'mechanical', 'marketing', 'agriculture'].map((word) => <button type="button" data-crf-try={word}>{word}</button>)}</div>
  <p class="crf-status" id="crf-status" aria-live="polite">Showing featured routes to start. Type what you like, or tap an example above.</p>
  <div class="crf-results" id="crf-results" aria-live="polite"></div>
  <details class="crf-info"><summary>How to read the labels, and privacy</summary>
    <p class="crf-scale-note"><b>Scalability lens:</b> every route is marked <b>Scalable</b>, <b>Scalable with a business layer</b> or <b>Not so scalable</b>. The last label keeps the option visible but flags fixed ladders, severe competition or saturation; a title, promotion or consistency alone is not treated as scalability.</p>
    <p class="crf-note"><b>Private by design:</b> your search stays in this browser and is not saved or sent.</p>
  </details>
  <section class="crf-compare" id="crf-compare" aria-live="polite" hidden></section>
  <script type="application/json" id="crf-data" set:html={JSON.stringify(routeData).replace(/</g, '\\u003c')}></script>
</section>

<script>
  import { esc as escapeHtml, fmtDate, addDays, copyText, printSheet, type Sheet } from '../scripts/counsellingToolKit';
  const app = document.querySelector<HTMLElement>('#career-route-finder');
  if (app) {
    type Route = {
      key: string; featured: boolean; title: string; category: string; summary: string; routeSummary: string;
      entryRoutes: string[]; nextStep: string; tags: string[]; suitableStages: string[];
      workSetting: string; routeLength: string; regulated: boolean; dataConfidence: string;
      scalability: 'high' | 'mid' | 'low'; scalabilityLabel: string; scalabilityTip: string; scalabilityWhy: string;
    };
    const dataNode = app.querySelector<HTMLScriptElement>('#crf-data');
    const form = app.querySelector<HTMLFormElement>('#crf-form');
    const results = app.querySelector<HTMLElement>('#crf-results');
    const status = app.querySelector<HTMLElement>('#crf-status');
    const query = app.querySelector<HTMLInputElement>('#crf-query');
    const stage = app.querySelector<HTMLSelectElement>('#crf-stage');
    const category = app.querySelector<HTMLSelectElement>('#crf-category');
    const compare = app.querySelector<HTMLElement>('#crf-compare');
    const chips = app.querySelector<HTMLElement>('#crf-chips');
    if (!dataNode || !form || !results || !status || !query || !stage || !category || !compare || !chips) throw new Error('Career route finder markup is incomplete.');
    const routes = JSON.parse(dataNode.textContent || '[]') as Route[];
    const URL_ = 'https://futurecareerschool.com/tools/career-route-finder/';
    const PAGE = 12;
    const MAX_COMPARE = 3;
    const compareKeys: string[] = [];
    let shown = PAGE;
    let timer = 0;
    const escape = escapeHtml;
    const confidence: Record<string, string> = { 'role-specific': 'Written for this role.', 'family-guided': 'Based on the wider job family, so check the details for this exact role.', exploratory: 'An emerging role. Details are still changing.' };
    const confText = (route: Route) => confidence[route.dataConfidence] || route.dataConfidence;
    const regText = (route: Route) => route.regulated ? 'Regulated or licensed route: confirm the current rule with the official authority before you pay for anything.' : 'Confirm the current course, employer and licensing rules before you decide.';
    const label = (route: Route, level: string) => level ? `<span class="crf-badge">${escape(level)}</span>` : '';
    const card = (route: Route, level: string) => `<article class="crf-card"><div class="crf-card-top"><span>${escape(route.category)}</span></div>${label(route, level)}${route.regulated ? '<span class="crf-badge crf-badge--reg">Regulated route</span>' : ''}<h3>${escape(route.title)}</h3><p>${escape(route.summary)}</p><p class="crf-scale crf-scale--${route.scalability}"><b>Scalability: ${escape(route.scalabilityLabel)}.</b> ${escape(route.scalabilityWhy)} <b>Growth move:</b> ${escape(route.scalabilityTip)}</p><dl><div><dt>Useful route lens</dt><dd>${escape(route.routeSummary)}</dd></div><div><dt>Work setting</dt><dd>${escape(route.workSetting)}</dd></div><div><dt>Route length</dt><dd>${escape(route.routeLength)}</dd></div></dl><p class="crf-next"><b>First test:</b> ${escape(route.nextStep)}</p><p class="crf-entry"><b>Possible entry routes:</b> ${route.entryRoutes.slice(0, 2).map(escape).join(' · ')}</p><button type="button" class="crf-compare-button" data-compare="${escape(route.key)}" aria-pressed="${compareKeys.includes(route.key)}">${compareKeys.includes(route.key) ? 'Selected for comparison' : 'Compare this route'}</button><small>${escape(regText(route))} ${escape(confText(route))}</small></article>`;
    const sheetFor = (selected: Route[]): Sheet => {
      const t = new Date(); const d = (n: number) => fmtDate(addDays(n, t));
      return {
        title: `Career routes to test: ${selected.map((r) => r.title).join(', ')}`,
        sub: `Made on ${d(0)}. From the school's editorial catalogue. This is not a ranking and not a job or salary database.`,
        sections: [
          { h: 'My next three steps', ol: [`By ${d(3)}: choose the route you most want to test. Read its entry routes and check the current rules on the official college, exam body or regulator website.`, `By ${d(10)}: do the first test for ${selected[0].title}. ${selected[0].nextStep}`, `By ${d(30)}: write what you enjoyed, what you avoided and what you could improve. Talk about it with a teacher, a counsellor or someone who does this work.`] },
          ...selected.map((r) => ({ h: r.title, p: [r.summary], ul: [`Type of work: ${r.category}`, `Entry routes: ${r.entryRoutes.slice(0, 3).join('; ')}`, `First test: ${r.nextStep}`, `Work setting: ${r.workSetting}`, `Route length: ${r.routeLength}`, `Scalability: ${r.scalabilityLabel}. ${r.scalabilityWhy}`, `Growth move: ${r.scalabilityTip}`, regText(r), confText(r)] })),
          { h: 'Honest limits', p: ['Pay, fees and entry rules change. Confirm them on the official source before you decide, and talk to a counsellor, teacher or someone who works in the role.'] },
        ],
      };
    };
    const renderComparison = () => {
      const selected = compareKeys.map((key) => routes.find((route) => route.key === key)).filter((route): route is Route => !!route);
      if (!selected.length) { compare.hidden = true; compare.innerHTML = ''; return; }
      compare.hidden = false;
      const cell = (route: Route, field: keyof Route) => field === 'dataConfidence' ? escape(confText(route)) : Array.isArray(route[field]) ? (route[field] as string[]).slice(0, 3).map(escape).join(' · ') : escape(String(route[field] ?? 'Not listed'));
      compare.innerHTML = `<div class="crf-compare-head"><div><p class="crf-kicker">Decision worksheet · browser-local</p><h3>Compare ${selected.length} route${selected.length === 1 ? '' : 's'}</h3><p>${selected.length === 1 ? 'Select one more result to compare side by side, or copy this one now. ' : ''}This is a trade-off worksheet, not a recommendation or ranking. You can compare up to ${MAX_COMPARE}.</p></div><button type="button" class="crf-clear" data-clear-compare>Clear</button></div><div class="crf-compare-actions"><button type="button" data-crf-act="copy">Copy my shortlist</button><button type="button" data-crf-act="print">Print or save as PDF</button></div><p class="crf-hint">On a small phone, swipe the table sideways to see every route.</p><div class="crf-compare-table-wrap"><table><thead><tr><th>Lens</th>${selected.map((route) => `<th>${escape(route.title)}</th>`).join('')}</tr></thead><tbody>${[['Scalability', 'scalabilityLabel'], ['Scalability reason', 'scalabilityWhy'], ['Work setting', 'workSetting'], ['Route length', 'routeLength'], ['Entry routes', 'entryRoutes'], ['First test', 'nextStep'], ['Stage fit', 'suitableStages'], ['Catalogue confidence', 'dataConfidence']].map(([rowLabel, field]) => `<tr><th>${rowLabel}</th>${selected.map((route) => `<td>${cell(route, field as keyof Route)}</td>`).join('')}</tr>`).join('')}</tbody></table></div><h4>Your next three steps</h4><ol class="crf-steps"><li>By ${escape(fmtDate(addDays(3)))}: read the entry routes and check the current rules on the official college, exam body or regulator site.</li><li>By ${escape(fmtDate(addDays(10)))}: do the first test for ${escape(selected[0].title)}.</li><li>By ${escape(fmtDate(addDays(30)))}: write what you enjoyed and avoided, then talk to a teacher, counsellor or someone who does this work.</li></ol><p class="crf-status" id="crf-compare-status" role="status" aria-live="polite"></p>`;
    };
    const tokens = (text: string) => (text.toLowerCase().match(/[\p{L}\p{N}]+/gu) || []).filter((t) => t.length > 1);
    const haystackOf = (route: Route) => [route.title, route.category, route.summary, route.routeSummary, route.workSetting, ...route.tags, ...route.entryRoutes].join(' ').toLowerCase();
    const matches = () => {
      const words = tokens(query.value);
      const chosenStage = stage.value; const chosenCategory = category.value;
      const pool = routes.filter((route) => (!chosenCategory || route.category === chosenCategory) && (!chosenStage || route.suitableStages.includes(chosenStage)));
      if (!words.length) {
        // No search yet: show one route from each category in turn so the first screen is broad, not alphabetical.
        const groups = new Map<string, Route[]>();
        [...pool].sort((x, y) => Number(y.featured) - Number(x.featured) || x.title.localeCompare(y.title)).forEach((route) => { const g = groups.get(route.category) || []; g.push(route); groups.set(route.category, g); });
        const lists = [...groups.entries()].sort((x, y) => x[0].localeCompare(y[0])).map(([, list]) => list);
        const mixed: Route[] = [];
        for (let i = 0; mixed.length < pool.length; i += 1) lists.forEach((list) => { if (list[i]) mixed.push(list[i]); });
        return mixed.map((route) => ({ route, level: route.featured ? 'Featured' : '', score: 0 }));
      }
      const scored = pool.map((route) => {
        const title = route.title.toLowerCase(); const hay = haystackOf(route);
        let inTitle = 0; let inAny = 0;
        for (const w of words) { if (title.includes(w)) { inTitle += 1; inAny += 1; } else if (hay.includes(w)) inAny += 1; }
        return { route, inTitle, inAny, score: inTitle * 8 + (inAny - inTitle) * 5 };
      }).filter((x) => x.inAny > 0);
      const all = scored.filter((x) => x.inAny === words.length);
      const list = all.length ? all : scored;
      return list.sort((a, b) => b.score - a.score || a.route.title.localeCompare(b.route.title)).map((x) => ({ route: x.route, score: x.score, level: x.inTitle === words.length ? 'Strong match' : x.inAny === words.length ? 'Good match' : 'Partial match' }));
    };
    const render = () => {
      const ranked = matches();
      const visible = ranked.slice(0, shown);
      const anyFilter = query.value.trim() || stage.value || category.value;
      status.textContent = ranked.length ? `Showing ${visible.length} of ${ranked.length} routes${anyFilter ? '' : ' (a mix of fields to start)'}. Change one filter to stress-test your shortlist.` : 'No route matched.';
      results.innerHTML = ranked.length ? visible.map(({ route, level }) => card(route, level)).join('') + (ranked.length > visible.length ? `<button type="button" class="crf-more" data-crf-more>Show ${Math.min(PAGE, ranked.length - visible.length)} more routes</button>` : '') : '<p class="crf-empty">No route matched those filters. The catalogue is written in English, so try one English word such as design, nursing, data or teaching. You can also choose “Any stage” and “All categories”.</p>';
      renderComparison();
    };
    const reset = () => { shown = PAGE; render(); };
    results.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-crf-more]')) { shown += PAGE; render(); return; }
      const button = target.closest<HTMLButtonElement>('[data-compare]');
      if (!button) return;
      const key = button.dataset.compare;
      if (!key) return;
      const at = compareKeys.indexOf(key);
      let note = '';
      if (at >= 0) compareKeys.splice(at, 1);
      else if (compareKeys.length < MAX_COMPARE) compareKeys.push(key);
      else note = `You can compare at most ${MAX_COMPARE} routes. Clear one first.`;
      const y = window.scrollY; render(); window.scrollTo({ top: y });
      if (note) status.textContent = note;
    });
    compare.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-clear-compare]')) { compareKeys.length = 0; render(); return; }
      const act = target.closest<HTMLElement>('[data-crf-act]')?.dataset.crfAct;
      if (!act) return;
      const selected = compareKeys.map((key) => routes.find((route) => route.key === key)).filter((route): route is Route => !!route);
      if (!selected.length) return;
      const note = compare.querySelector('#crf-compare-status');
      if (act === 'print') { printSheet(sheetFor(selected), URL_); if (note) note.textContent = 'Opening print. Choose "Save as PDF" to keep a copy.'; return; }
      const sheet = sheetFor(selected);
      const text = [`*${sheet.title}*`, sheet.sub || '', ...sheet.sections.flatMap((s) => ['', `*${s.h}*`, ...(s.p || []), ...(s.ul || []).map((l) => `• ${l}`), ...(s.ol || []).map((l, i) => `${i + 1}. ${l}`)]), '', `Made with the free tool at ${URL_}`].join('\n');
      if (note) note.textContent = (await copyText(text)) ? 'Copied. Paste it into WhatsApp.' : 'Copy did not work. Use Print or save as PDF instead.';
    });
    chips.addEventListener('click', (event) => { const word = (event.target as HTMLElement).closest<HTMLElement>('[data-crf-try]')?.dataset.crfTry; if (!word) return; query.value = word; reset(); });
    query.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(reset, 250); });
    stage.addEventListener('change', reset);
    category.addEventListener('change', reset);
    form.addEventListener('submit', (event) => { event.preventDefault(); window.clearTimeout(timer); reset(); });
    form.addEventListener('reset', () => { window.setTimeout(reset, 0); });
    render();
  }
</script>

<style is:global>
  .crf{margin:2rem 0;padding:clamp(1.1rem,3vw,2rem);border:1px solid rgba(18,154,141,.42);border-radius:22px;background:linear-gradient(145deg,rgba(18,154,141,.1),rgba(255,255,255,.03));color:#f8fafc}.crf-head{display:grid;grid-template-columns:1fr minmax(210px,300px);gap:1.2rem;align-items:start}.crf-kicker{margin:0;color:#8de4d8;font-size:.76rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.crf h2{margin:.45rem 0 .55rem;color:#fff}.crf-head p:not(.crf-kicker),.crf-note{line-height:1.65;color:rgba(255,255,255,.68)}.crf-note,.crf-scale-note{padding:.85rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.04);font-size:.86rem}.crf-scale-note{border-left:4px solid #e5b84a}.crf-form{display:grid;grid-template-columns:2fr 1fr 1fr auto auto;gap:.7rem;margin:1.25rem 0}.crf-form label{display:grid;gap:.35rem;color:#fff;font-size:.86rem;font-weight:700}.crf-form input,.crf-form select{min-height:44px;width:100%;padding:.55rem .7rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:#101927;color:#fff;font:inherit}.crf-form button,.crf-compare-button,.crf-clear{align-self:end;min-height:44px;padding:.55rem .85rem;border:0;border-radius:10px;background:#e5b84a;color:#17130a;font-weight:800;cursor:pointer}.crf-form .crf-secondary,.crf-clear{border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff}.crf-status{color:rgba(255,255,255,.62);font-size:.88rem}.crf-results{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:1rem}.crf-card{padding:1rem;border:1px solid rgba(255,255,255,.13);border-radius:15px;background:rgba(0,0,0,.16)}.crf-card-top{display:flex;justify-content:space-between;gap:.5rem;color:#8de4d8;font-size:.72rem}.crf-card-top b{color:#f7d88c}.crf-card h3{margin:.65rem 0 .4rem;color:#fff;font-size:1.05rem}.crf-card p,.crf-card dd{color:rgba(255,255,255,.67);line-height:1.55;font-size:.87rem}.crf-scale{padding:.7rem;border-left:3px solid #8de4d8;background:rgba(18,154,141,.08)}.crf-scale--low{border-left-color:#ffb0b0;background:rgba(221,93,93,.1)}.crf-scale--mid{border-left-color:#f7d88c;background:rgba(229,184,74,.08)}.crf-card dl{display:grid;gap:.55rem;margin:.85rem 0}.crf-card dl div{padding:.55rem;border-radius:9px;background:rgba(255,255,255,.04)}.crf-card dt{color:#8de4d8;font-size:.72rem;font-weight:800}.crf-card dd{margin:.2rem 0 0}.crf-next{padding:.65rem;border-left:3px solid #e5b84a;background:rgba(229,184,74,.08)}.crf-entry{font-size:.8rem!important}.crf-card small{display:block;color:rgba(255,255,255,.45);line-height:1.5}.crf-empty{grid-column:1/-1;padding:1rem;border:1px dashed rgba(255,255,255,.2);border-radius:12px;color:rgba(255,255,255,.7)}.crf-compare{margin-top:1.2rem;padding:1rem;border:1px solid rgba(229,184,74,.42);border-radius:15px;background:rgba(229,184,74,.07)}.crf-compare-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.crf-compare h3{margin:.35rem 0;color:#fff}.crf-compare p{color:rgba(255,255,255,.68);line-height:1.55}.crf-compare-table-wrap{overflow:auto}.crf-compare table{width:100%;min-width:620px;border-collapse:collapse}.crf-compare th,.crf-compare td{padding:.65rem;border:1px solid rgba(255,255,255,.16);text-align:left;vertical-align:top;line-height:1.5}.crf-compare th{color:#fff}.crf-compare td{color:rgba(255,255,255,.72)}.crf-form input:focus-visible,.crf-form select:focus-visible,.crf-form button:focus-visible,.crf-compare-button:focus-visible,.crf-clear:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}@media(max-width:900px){.crf-form{grid-template-columns:repeat(2,1fr)}.crf-form label:first-child{grid-column:1/-1}.crf-results{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.crf-head,.crf-form,.crf-results{grid-template-columns:1fr}.crf-form label:first-child{grid-column:auto}.crf-form button{align-self:stretch}}
  .crf-head{grid-template-columns:1fr}.crf-info{margin:1.2rem 0;padding:.4rem .9rem;border:1px solid rgba(255,255,255,.14);border-radius:12px}.crf-info summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-weight:700}.crf-chips{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:-.4rem 0 .8rem;font-size:.9rem;color:rgba(255,255,255,.75)}.crf-chips button{min-height:44px;padding:.4rem .9rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.07);color:#f7d88c;font:inherit;font-weight:650;cursor:pointer}.crf-badge{display:inline-block;margin:0 .4rem .4rem 0;padding:.15rem .55rem;border-radius:999px;border:1px solid rgba(255,255,255,.25);font-size:.74rem;font-weight:700;color:#fff}.crf-badge--reg{border-color:#ffb0b0;color:#ffd3d3}.crf-more{grid-column:1/-1;justify-self:center;min-height:44px;padding:.55rem 1.2rem;border:1px solid rgba(255,255,255,.28);border-radius:10px;background:rgba(255,255,255,.08);color:#fff;font:inherit;font-weight:700;cursor:pointer}.crf-compare-actions{display:flex;flex-wrap:wrap;gap:.6rem;margin:.8rem 0}.crf-compare-actions button{min-height:44px;padding:.55rem .95rem;border:1px solid rgba(255,255,255,.28);border-radius:10px;background:rgba(255,255,255,.08);color:#fff;font:inherit;font-weight:650;cursor:pointer}.crf-compare-actions button:first-child{background:#129a8d;border-color:#129a8d}.crf-hint{font-size:.85rem;color:rgba(255,255,255,.7)}.crf-steps{margin:.6rem 0 0;padding-left:1.2rem;line-height:1.6;color:rgba(255,255,255,.82)}.crf-card h3,.crf-card p,.crf-card dd,.crf-compare td{overflow-wrap:anywhere}.crf-chips button:focus-visible,.crf-more:focus-visible,.crf-compare-actions button:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}
</style>
