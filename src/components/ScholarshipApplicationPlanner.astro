---
const docs = [
  { id: 'aadhaar', label: 'Aadhaar card of the student, with the mobile number linked' },
  { id: 'bank', label: 'Bank account in the student\'s own name (many schemes pay by bank transfer and want it linked to Aadhaar)' },
  { id: 'marks', label: 'Marksheet of the last exam passed (Class 10, Class 12 or last semester)' },
  { id: 'admission', label: 'Admission letter or bonafide certificate from the current school or college' },
  { id: 'fee', label: 'Fee receipt for the current year' },
  { id: 'income', label: 'Income certificate (only if the scheme has an income limit)' },
  { id: 'category', label: 'Caste or category certificate (only for category-based schemes)' },
  { id: 'residence', label: 'Residence or domicile certificate (only for state schemes)' },
  { id: 'photo', label: 'Recent passport-size photo and a scanned signature' },
];
---
<section class="sap" id="scholarship-application-planner" aria-labelledby="sap-title">
  <h2 id="sap-title">Build a scholarship application plan</h2>
  <p>Enter the scholarship name and the deadline from the official notice. You get a dated plan, a list of documents still to collect and the money you will still need if the award is not enough.</p>
  <p class="sap-note">This tool does not list scholarships or check if you qualify. Apply only on the official website of the scheme. No real scholarship asks you to pay to be selected.</p>
  <form id="sap-form" class="sap-form" novalidate>
    <div id="sap-ex-slot"></div>
    <div class="sap-grid2">
      <label for="sap-award">Scholarship name<input id="sap-award" name="award" maxlength="160" autocomplete="off" placeholder="Exact name from the official notice" /></label>
      <label for="sap-deadline">Last date to apply<input id="sap-deadline" name="deadline" type="date" aria-describedby="sap-deadline-h" /><span class="sap-h" id="sap-deadline-h">From the official notice. Leave empty if you do not know yet, and the plan will have no dates.</span></label>
      <label for="sap-source">Have you saved the official notice?<select id="sap-source" name="source"><option value="0">No</option><option value="1">I found a page but have not checked its date</option><option value="2">Yes, with its date and the name of the issuing body</option></select></label>
      <label for="sap-eligibility">Do you match the eligibility rules?<select id="sap-eligibility" name="eligibility"><option value="0">I do not know yet</option><option value="1">Some rules match</option><option value="2">I checked every rule against the notice</option><option value="3">I checked every rule and know which proof is needed</option></select></label>
    </div>
    <fieldset class="sap-docs">
      <legend>Tick each document you hold, or that does not apply to you</legend>
      {docs.map((d) => (
        <label class="sap-check" for={`sap-doc-${d.id}`}><input id={`sap-doc-${d.id}`} type="checkbox" name="doc" value={d.id} data-label={d.label} /><span>{d.label}</span></label>
      ))}
      <p class="sap-h">These are commonly asked for. Your notice decides the real list.</p>
    </fieldset>
    <div class="sap-grid2">
      <label for="sap-cost">Your cost for one year, fees and living (₹, optional)<input id="sap-cost" name="cost" type="text" inputmode="numeric" autocomplete="off" placeholder="120000" /></label>
      <label for="sap-amount">Scholarship amount for one year (₹, optional)<input id="sap-amount" name="amount" type="text" inputmode="numeric" autocomplete="off" placeholder="30000" aria-describedby="sap-amount-h" /><span class="sap-h" id="sap-amount-h">From the notice. Use 0 if the amount is not fixed.</span></label>
    </div>
    <label for="sap-gap">Anything else that could go wrong? (optional)<textarea id="sap-gap" name="gap" rows="3" maxlength="600" placeholder="Award paid late, needs renewal with marks, deposit due before the award"></textarea></label>
    <div class="sap-actions"><button class="sap-primary" type="submit">Show my plan</button><button type="button" data-sap="clear">Clear</button></div>
    <p id="sap-error" hidden></p>
    <p id="sap-status" class="sap-status" role="status" aria-live="polite"></p>
  </form>
  <div id="sap-result" class="sap-result" hidden></div>
</section>
<script>
  import { esc, inr, num1, parseNum, MAX_MONEY, dayLabel, stageDates, parseDateInput, startOfToday, daysBetween, addResultTools, showError, exampleButton } from '../scripts/moneyToolKit';

  const form = document.querySelector<HTMLFormElement>('#sap-form');
  const result = document.querySelector<HTMLDivElement>('#sap-result');
  const status = document.querySelector<HTMLParagraphElement>('#sap-status');
  const errBox = document.querySelector<HTMLElement>('#sap-error');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-sap="clear"]');
  const slot = document.querySelector<HTMLElement>('#sap-ex-slot');
  if (!form || !result || !status || !clearBtn || !slot) throw new Error('Scholarship application planner markup is incomplete.');
  const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`)!;
  const checks = () => [...form.querySelectorAll<HTMLInputElement>('input[name="doc"]')];

  slot.appendChild(exampleButton('Try an example', 'The example is made up to show how the tool works. The scholarship name and amounts are not real.', () => {
    const d = new Date(); d.setDate(d.getDate() + 30);
    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    field('award').value = 'Example: post-matric scholarship for a first-year degree student';
    field('deadline').value = iso; field('source').value = '1'; field('eligibility').value = '2';
    checks().forEach((c) => { c.checked = ['aadhaar', 'marks', 'photo', 'admission'].includes(c.value); });
    field('cost').value = '120000'; field('amount').value = '30000'; field('gap').value = 'Award may come after the first fee is due';
    showError(errBox, '');
    form.requestSubmit();
  }));

  const readMoney = (key: string, label: string): number => {
    const v = parseNum(field(key).value);
    if (v === null) return 0;
    if (Number.isNaN(v)) throw { msg: `${label}: please type numbers only, for example 30000.`, key };
    if (v < 0) throw { msg: `${label}: the number cannot be below 0.`, key };
    if (v > MAX_MONEY) throw { msg: `${label}: this number is too large. Please check it.`, key };
    return v;
  };

  const compute = () => {
    const award = field('award').value.trim();
    if (!award) throw { msg: 'Please type the name of the scholarship, as written in the official notice.', key: 'award' };
    const source = Number(field('source').value) || 0;
    const eligibility = Number(field('eligibility').value) || 0;
    const boxes = checks();
    const have = boxes.filter((c) => c.checked).length;
    const missing = boxes.filter((c) => !c.checked).map((c) => c.dataset.label || c.value);
    const docScore = have >= boxes.length ? 3 : have >= Math.ceil(boxes.length * 0.66) ? 2 : have >= Math.ceil(boxes.length * 0.33) ? 1 : 0;
    const score = source + eligibility + docScore;
    const band = score >= 7 ? 'Nearly ready, do a final check' : score >= 4 ? 'Partly ready, close the gaps below' : 'Early stage, verify before you apply';
    const cost = readMoney('cost', 'Your cost for one year');
    const amount = readMoney('amount', 'Scholarship amount');
    const gapText = field('gap').value.trim();
    const dl = parseDateInput(field('deadline').value);
    if (field('deadline').value && !dl) throw { msg: 'Last date to apply: please pick a valid date.', key: 'deadline' };
    const today = startOfToday();
    const daysLeft = dl ? daysBetween(today, dl) : null;
    const st = dl ? stageDates(dl, today) : null;

    const steps: string[] = [];
    let dateNote = '';
    if (dl && daysLeft !== null && daysLeft < 1) {
      dateNote = daysLeft === 0 ? 'The last date is today. Open the official website now and apply if the portal is still open.' : 'The date you entered has passed. Check the official website for an extended date or the next round. Do not trust a message or agent that says you can still apply.';
      steps.push(dateNote);
      steps.push('Collect the documents listed below so you are ready for the next round.');
      steps.push('Save the official notice with its date so you can see the next dates early.');
    } else if (st) {
      steps.push(`By ${dayLabel(st.s1)}: open the official notice, save it with its date, and match every eligibility rule to a document. ${source < 2 ? 'Right now you have not saved a dated notice, so start here.' : ''}`.trim());
      steps.push(`By ${dayLabel(st.s2)}: collect and scan the documents still missing${missing.length ? ` (${missing.length} left in the list below)` : ''}. Give each file a clear name, such as marksheet-class12.pdf.`);
      steps.push(`By ${dayLabel(st.s3)}: fill the form, check that name, date of birth, Aadhaar and bank details match your documents letter for letter, submit, and save the acknowledgement. The days up to ${dayLabel(dl!)} are your spare time for portal problems and corrections.`);
    } else {
      steps.push('Open the official notice, save it with its date, and match every eligibility rule to a document.');
      steps.push(`Collect and scan the documents still missing${missing.length ? ` (${missing.length} left in the list below)` : ''}. Give each file a clear name.`);
      steps.push('Add the last date from the notice to this tool to get a dated plan. Submit well before the last day, and save the acknowledgement.');
    }

    let money = '';
    let moneyShort = 0;
    if (cost > 0) {
      moneyShort = Math.max(0, cost - amount);
      money = amount > 0
        ? `The award of ${inr(amount)} covers about ${num1(Math.min(100, (amount / cost) * 100))}% of your yearly cost of ${inr(cost)}. You still need ${inr(moneyShort)} a year from family, savings or another source.`
        : `No award amount was entered, so plan for the full yearly cost of ${inr(cost)} until the notice names an amount.`;
    }

    const lines = [
      `${award}: scholarship application plan`,
      `Result: ${band} (${score} of 8 checklist points)`,
      ...(dl ? [`Last date: ${dayLabel(dl)}${daysLeft !== null && daysLeft >= 0 ? ` (${daysLeft} day${daysLeft === 1 ? '' : 's'} left)` : ' (passed)'}`] : []),
      '',
      'Next three steps:',
      ...steps.map((s, i) => `${i + 1}. ${s}`),
      '',
      `Documents in hand: ${have} of ${boxes.length}`,
      ...(missing.length ? ['Still to collect:', ...missing.map((m) => `- ${m}`)] : []),
      ...(money ? ['', money] : []),
      ...(gapText ? ['', `Other risk: ${gapText}`] : []),
      '',
      'Apply only on the official website. No real scholarship asks for money to select you. Free planner: https://futurecareerschool.com/tools/scholarship-application-planner/',
    ];

    const html = `<div class="sap-lead"><span>${esc(award)}</span><h3>${esc(band)} (${score} of 8)</h3><p>${dl && daysLeft !== null && daysLeft >= 0 ? `${daysLeft} day${daysLeft === 1 ? '' : 's'} left until ${esc(dayLabel(dl))}. ` : ''}This score counts how ready your checklist is. It does not show if you will win an award.</p></div>
      <div class="mtk-steps"><h3>Your next three steps${st ? ', with dates' : ''}</h3><ol>${steps.map((s) => `<li>${esc(s)}</li>`).join('')}</ol></div>
      <div class="sap-grid"><article><b>Documents in hand: ${have} of ${boxes.length}</b>${missing.length ? `<ul>${missing.map((m) => `<li>${esc(m)}</li>`).join('')}</ul>` : '<p>Everything on the list is ticked. Check that each scan is clear and the names match.</p>'}</article>
      <article><b>Money after the award</b><p>${money ? esc(money) : 'Add your yearly cost and the award amount to see how much you would still need.'}</p>${moneyShort > 0 ? '<p>To compare a loan for the rest, use the <a href="https://futurecareerschool.com/tools/education-loan-emi-calculator/">education loan EMI calculator</a>.</p>' : ''}${gapText ? `<p><b>Other risk you noted:</b> ${esc(gapText)}</p>` : ''}</article></div>
      <div class="sap-next"><h3>Before you submit</h3><ul><li>Apply only on the official website named in the notice. For central schemes that is usually the National Scholarship Portal (scholarships.gov.in), and your state may have its own portal.</li><li>Keep a copy of the submitted form and the acknowledgement. Note the application number.</li><li>An award is final only when you get the official award message or letter. Do not pay a deposit assuming it will come.</li><li>Keep a lower-cost or staged route ready in case the award is partial, late or not renewed.</li></ul></div>`;
    return { text: lines.join('\n'), html };
  };

  let lastText = '';
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const out = compute();
      showError(errBox, '');
      lastText = out.text;
      result.innerHTML = out.html;
      addResultTools(result, () => lastText, 'My scholarship application plan');
      result.hidden = false;
      status.textContent = 'Your plan is ready below. Nothing was sent anywhere.';
    } catch (e) {
      const err = e as { msg?: string; key?: string };
      if (!err || !err.msg) throw e;
      result.hidden = true;
      showError(errBox, err.msg, err.key ? field(err.key) : null);
      status.textContent = '';
    }
  });
  clearBtn.addEventListener('click', () => { form.reset(); result.hidden = true; result.innerHTML = ''; showError(errBox, ''); status.textContent = 'Cleared.'; });
</script>
<style is:global>
  .sap{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.sap h2{margin:.2rem 0 .6rem}.sap>p{max-width:800px;line-height:1.65}.sap-note,.sap-status{color:rgba(255,255,255,.68);font-size:.88rem}.sap-form{display:grid;gap:1rem;margin-top:1.2rem}.sap-grid2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.sap-form label{display:grid;gap:.4rem;font-weight:650;font-size:.95rem;align-content:start}.sap-h{font-weight:400;font-size:.82rem;color:rgba(255,255,255,.62);line-height:1.45}.sap-form input:not([type=checkbox]),.sap-form select,.sap-form textarea{width:100%;min-height:44px;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.25);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-size:1rem;font-weight:400}.sap-form select option{color:#111}.sap-docs{margin:0;padding:.9rem;border:1px solid rgba(255,255,255,.2);border-radius:12px;display:grid;gap:.2rem}.sap-docs legend{padding:0 .4rem;font-weight:700}.sap-form label.sap-check{display:flex;gap:.7rem;align-items:flex-start;min-height:44px;padding:.35rem 0;font-weight:400;line-height:1.45;cursor:pointer}.sap-check input{flex:0 0 24px;width:24px;height:24px;margin-top:.1rem;accent-color:#2dd4bf}.sap-actions{display:flex;gap:.6rem;flex-wrap:wrap}.sap-actions button{min-height:44px;padding:.55rem .95rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.sap-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.sap-result{margin-top:1.3rem}.sap-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.sap-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;overflow-wrap:anywhere}.sap-lead h3{margin:.4rem 0;font-size:1.4rem}.sap-lead p,.sap-grid p,.sap-grid li,.sap-next li{line-height:1.6;color:rgba(255,255,255,.78)}.sap-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.sap-grid article,.sap-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px;min-width:0;overflow-wrap:anywhere}.sap-grid ul{margin:.4rem 0 0;padding-left:1.1rem}.sap-grid a{color:#8de4d8}.sap-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.sap-next h3{margin-top:0}@media(max-width:650px){.sap{padding:1.1rem}.sap-grid,.sap-grid2{grid-template-columns:1fr}}
</style>
