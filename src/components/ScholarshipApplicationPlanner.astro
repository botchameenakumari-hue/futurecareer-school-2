<section class="sap" id="scholarship-application-planner" aria-labelledby="sap-title">
  <p class="eyebrow">FUNDING DUE-DILIGENCE TOOL</p>
  <h2 id="sap-title">Build a scholarship application plan</h2>
  <p>Turn a scholarship notice into a dated checklist: confirm eligibility, save the official source, prepare documents, and name the funding gap if the award does not cover everything.</p>
  <p class="sap-note"><b>Limit:</b> this tool does not list scholarships, verify eligibility, or promise an award. Check the current official scheme notice and never pay an intermediary to guarantee selection.</p>
  <form id="sap-form" class="sap-form" novalidate>
    <label>Scholarship or funding opportunity<input name="award" maxlength="160" placeholder="Use the exact name from the official notice" required /></label>
    <label>Have you saved the current official notice or application page?<select name="source"><option value="0">No</option><option value="1">I found a page but have not checked its date</option><option value="2">Yes, with the current date and issuing body</option></select></label>
    <label>How clear is your eligibility evidence?<select name="eligibility"><option value="0">Unclear</option><option value="1">Some criteria match</option><option value="2">Criteria checked against the notice</option><option value="3">Criteria and required proof checked</option></select></label>
    <label>How ready are your documents?<select name="documents"><option value="0">Not collected</option><option value="1">Some collected</option><option value="2">Collected but need checking</option><option value="3">Complete, readable and consistently named</option></select></label>
    <label>What cost remains if the award is partial or delayed?<textarea name="gap" rows="3" maxlength="600" placeholder="Tuition, living, travel, deposit, deadline or backup funding question"></textarea></label>
    <div class="sap-actions"><button class="sap-primary" type="submit">Create application plan</button><button type="button" data-sap="clear">Clear</button></div>
    <p id="sap-status" class="sap-status" role="status" aria-live="polite"></p>
  </form>
  <div id="sap-result" class="sap-result" hidden></div>
</section>
<script>
  type SapField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type SapForm = Omit<HTMLFormElement, 'querySelectorAll'> & { querySelectorAll(selectors: string): NodeListOf<SapField> };
  const sapForm = document.querySelector<HTMLFormElement>('#sap-form') as SapForm | null;
  const sapResult = document.querySelector<HTMLDivElement>('#sap-result');
  const sapStatus = document.querySelector<HTMLParagraphElement>('#sap-status');
  const sapClear = document.querySelector<HTMLButtonElement>('[data-sap="clear"]');
  if (!sapForm || !sapResult || !sapStatus || !sapClear) throw new Error('Scholarship application planner markup is incomplete.');
  const sapEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  sapForm.addEventListener('submit', (event) => { event.preventDefault(); if (!sapForm.checkValidity()) { sapForm.reportValidity(); return; } const data = Object.fromEntries([...sapForm.querySelectorAll('input,select,textarea')].map((field) => [field.name, field.value])); const score = Number(data.source || 0) + Number(data.eligibility || 0) + Number(data.documents || 0); const band = score >= 7 ? 'ready for a final review' : score >= 4 ? 'partly prepared-close the gaps' : 'early stage-verify before applying'; const first = Number(data.source) < 2 ? 'Save and date the official scheme notice, issuing body, deadline and application instructions.' : Number(data.eligibility) < 2 ? 'Map every eligibility line to a document or official confirmation.' : Number(data.documents) < 2 ? 'Collect, scan and consistently name each required document before the deadline.' : 'Run a final cross-check and keep a backup funding plan.'; sapResult.innerHTML = `<div class="sap-lead"><span>${sapEsc(data.award)} · application signal</span><h3>${sapEsc(band)} · ${score}/8</h3><p>This signal describes checklist completion, not award probability or eligibility.</p></div><div class="sap-grid"><article><b>First action</b><p>${sapEsc(first)}</p></article><article><b>Funding gap to resolve</b><p>${data.gap ? sapEsc(data.gap) : 'Write what remains unfunded if the award is partial, delayed or not renewed.'}</p></article></div><div class="sap-next"><h3>Before submitting</h3><ul><li>Check the official deadline, issuing body, eligibility, document format and correction process.</li><li>Keep copies of the submitted form and proof of submission.</li><li>A scholarship is not guaranteed until the official award communication is received.</li><li>Prepare a lower-cost, staged or alternate funding route before committing money.</li></ul></div>`; sapResult.hidden = false; sapStatus.textContent = 'Application plan created from your entries; nothing was sent.'; });
  sapClear.addEventListener('click', () => { sapForm.reset(); sapResult.hidden = true; sapStatus.textContent = 'Cleared.'; });
</script>
<style>
  .sap{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.sap h2{margin:.2rem 0 .6rem}.sap>p{max-width:800px;line-height:1.65}.sap-note,.sap-status{color:rgba(255,255,255,.68);font-size:.88rem}.sap-form{display:grid;gap:1rem;margin-top:1.4rem}.sap-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.sap-form input,.sap-form select,.sap-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.sap-actions{display:flex;gap:.6rem;flex-wrap:wrap}.sap-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.sap-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.sap-result{margin-top:1.3rem}.sap-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.sap-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.sap-lead h3{margin:.4rem 0;font-size:1.5rem}.sap-lead p,.sap-grid p,.sap-next li{line-height:1.6;color:rgba(255,255,255,.75)}.sap-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.sap-grid article,.sap-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.sap-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.sap-next h3{margin-top:0}@media(max-width:650px){.sap-grid{grid-template-columns:1fr}}
</style>
