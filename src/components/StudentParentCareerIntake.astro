<section class="spi" id="student-parent-career-intake" aria-labelledby="spi-title">
  <h2 id="spi-title">Student–parent career guidance intake</h2>
  <p>Use this short worksheet before a counselling conversation or a stream, course or career decision. It turns two different viewpoints into one next step; it does not choose a career for you. You can write in Telugu, Hindi or English. A good way to start is to read each question aloud together and then write.</p>
  <p class="spi-note"><b>Privacy:</b> this intake stays in this browser. It does not ask for names, marks, contact details or family notes, and it does not send entries to the site.</p>
  <div id="spi-app"></div>
  <noscript><p class="spi-info">This intake needs JavaScript. You can use the questions as a handwritten conversation guide.</p></noscript>
</section>

<script>
  import { fmtDate, addDays, isoDate, parseIso, printSheet, plainText, copyText } from '../scripts/counsellingToolKit';
  // @ts-nocheck
  const app = document.getElementById('spi-app');
  if (!app) throw new Error('Worksheet container #spi-app was not found.');
  const setStatus = (message) => { const status = document.getElementById('spi-status'); if (status) status.textContent = message; };
  const KEY = 'fcs-student-parent-intake-v1';
  const blank = () => ({ stage: 'after-10th', decision: 'not-sure', studentGoal: '', studentQuestion: '', parentConcern: '', evidence: '', nextStep: '', reviewDate: isoDate(addDays(14)) });
  let state = blank();
  try { const raw = localStorage.getItem(KEY); if (raw) state = Object.assign(blank(), JSON.parse(raw)); } catch (e) {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} };
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
  const select = (key, label, options) => '<label>' + esc(label) + '<select data-spi="' + key + '">' + options.map(([value, text]) => '<option value="' + esc(value) + '"' + (state[key] === value ? ' selected' : '') + '>' + esc(text) + '</option>').join('') + '</select></label>';
  const field = (key, label, placeholder) => '<label>' + esc(label) + '<textarea data-spi="' + key + '" rows="3" maxlength="500" placeholder="' + esc(placeholder) + '">' + esc(state[key]) + '</textarea></label>';
  function formHtml() {
    return '<form class="spi-form" novalidate>' +
      '<button type="button" class="spi-btn spi-btn--ghost" data-spi-action="example">Try an example</button>' +
      '<div class="spi-grid">' +
      select('stage', 'Which situation fits best?', [['after-10th', 'Choosing a stream or route after Class 10'], ['after-12th', 'Choosing a course, college or route after Class 12'], ['college', 'Already in college, training or an internship'], ['adult', 'Working, changing direction or returning to work']]) +
      select('decision', 'What is the main decision today?', [['not-sure', 'We are not sure what to decide first'], ['explore', 'Explore interests, strengths or career options'], ['course', 'Compare courses, colleges or entrance routes'], ['family', 'Reduce disagreement between the student and family'], ['action', 'Turn a decision into a practical next step']]) +
      '</div>' +
      '<div class="spi-columns"><fieldset><legend>Student voice</legend>' +
      field('studentGoal', 'What do I want to explore or test?', 'A subject, type of work, stream, course or skill') +
      field('studentQuestion', 'What question do I want answered?', 'What am I still unsure or worried about?') +
      '</fieldset><fieldset><legend>Parent or supporter voice</legend>' +
      field('parentConcern', 'What concern should the conversation respect?', 'Cost, safety, marks, location, confidence, time or another constraint') +
      field('evidence', 'What evidence would help us compare fairly?', 'An official rule, fee, deadline, conversation, project or course detail') +
      '</fieldset></div>' +
      field('nextStep', 'What small step will we complete next?', 'One official page, conversation, experiment or comparison table') +
      '<label>When will we sit together to look at what we found?<input data-spi="reviewDate" type="date" value="' + esc(state.reviewDate) + '"></label>' +
      '<div class="spi-actions"><button type="button" class="spi-btn spi-btn--primary" data-spi-action="save">Save in this browser</button><button type="button" class="spi-btn" data-spi-action="copy">Copy as text</button><button type="button" class="spi-btn" data-spi-action="print">Print or save as PDF</button><button type="button" class="spi-btn" data-spi-action="clear">Clear intake</button></div>' +
      '<p class="spi-status" id="spi-status" role="status"></p></form>';
  }
  function route() {
    if (state.decision === 'family') return { title: 'Start with a shared conversation', href: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-questions-for-students/', label: 'Review the questions for a counselling conversation', text: 'Bring one student question, one family concern and one evidence item into the conversation.' };
    if (state.decision === 'course' || state.stage === 'after-12th') return { title: 'Compare the route before debating the label', href: 'https://futurecareerschool.com/tools/course-entrance-exam-finder/', label: 'Open the course and entrance-exam finder', text: 'Use the current subject and exam screen, then open the official source attached to each route.' };
    if (state.stage === 'after-10th') return { title: 'Start with stage-appropriate student signals', href: 'https://futurecareerschool.com/services/assessments/class-10-and-below/', label: 'Take the Class 10 and below assessment', text: 'Use the result as a starting signal, then compare it with real subjects, route rules and a small experiment.' };
    if (state.stage === 'adult') return { title: 'Start with work and transition evidence', href: 'https://futurecareerschool.com/services/assessments/working-professionals-and-career-changers/', label: 'Take the working-professional assessment', text: 'Use current skills, constraints and a small transition experiment rather than relying on a job title alone.' };
    return { title: 'Start with a broader direction check', href: 'https://futurecareerschool.com/services/assessments/graduates-and-early-professionals/', label: 'Take the graduates and early-professionals assessment', text: 'Use the result to choose one skill or role hypothesis to test with evidence.' };
  }
  function steps() {
    const t = new Date(); const d = (n) => fmtDate(addDays(n, t)); const review = parseIso(state.reviewDate || '');
    return [
      'By ' + d(2) + ': the student and the parent each fill in their own side first, without reading the other side.',
      'By ' + (review ? fmtDate(addDays(-1, review)) : d(10)) + ': complete the evidence step: ' + (state.nextStep || 'one official page, one conversation or one small test') + '.',
      (review ? 'On ' + fmtDate(review) : 'On a date you choose') + ': sit together for 30 minutes. Show what you found, then decide one next step.',
    ];
  }
  function sheet() {
    const next = route();
    return { title: 'Student and parent career intake', sub: 'Made on ' + fmtDate(new Date()) + '. Suggested next tool: ' + next.label + '.', sections: [
      { h: 'The question', p: [state.studentQuestion || 'Not written yet'] },
      { h: 'The student wants to explore', p: [state.studentGoal || 'Not written yet'] },
      { h: 'The family concern to respect', p: [state.parentConcern || 'Not written yet'] },
      { h: 'Evidence that would help both sides', p: [state.evidence || 'Not written yet'] },
      { h: 'Our next three steps', ol: steps() },
      { h: 'Remember', p: ['This worksheet does not choose a career. Check fees, rules and dates on official sources, and speak to a teacher or counsellor if you are stuck.'] },
    ] };
  }
  function summaryHtml() {
    const next = route();
    const complete = state.studentGoal && state.studentQuestion && state.parentConcern && state.evidence && state.nextStep;
    return '<div class="spi-summary"><h3>' + esc(next.title) + '</h3><p>' + (complete ? 'You have one student question, one family constraint and one evidence-led next step.' : 'Complete the two voices and the next-step field before treating this as a shared plan.') + '</p><p>' + esc(next.text) + '</p><a class="spi-link" href="' + next.href + '">' + esc(next.label) + ' &rarr;</a><ul><li><b>Student question:</b> ' + esc(state.studentQuestion || 'Add the question the student wants answered.') + '</li><li><b>Evidence:</b> ' + esc(state.evidence || 'Name the evidence that would help both sides compare.') + '</li><li><b>Next step:</b> ' + esc(state.nextStep || 'Write one small step and a date.') + '</li></ul><h4>Our next three steps</h4><ol>' + steps().map((t) => '<li>' + esc(t) + '</li>').join('') + '</ol></div>';
  }
  function render() { app.innerHTML = formHtml() + summaryHtml(); }
  app.addEventListener('input', (event) => { const target = event.target; if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return; const key = target.getAttribute('data-spi'); if (key) { state[key] = target.value; save(); const summary = app.querySelector('.spi-summary'); if (summary) summary.outerHTML = summaryHtml(); setStatus('Saved locally.'); } });
  app.addEventListener('click', (event) => { const target = event.target; if (!(target instanceof Element)) return; const button = target.closest('[data-spi-action]'); if (!(button instanceof HTMLButtonElement)) return; const action = button.getAttribute('data-spi-action'); if (action === 'save') { save(); setStatus('Saved in this browser.'); } if (action === 'print') { save(); try { printSheet(sheet(), 'https://futurecareerschool.com/tools/student-parent-career-intake/'); } catch (e) { window.print(); } setStatus('Opening print. Choose Save as PDF to keep a copy.'); }
    if (action === 'copy') { copyText(plainText(sheet(), 'https://futurecareerschool.com/tools/student-parent-career-intake/')).then((ok) => { setStatus(ok ? 'Copied. Paste it into WhatsApp.' : 'Copy did not work. Use Print or save as PDF.'); }); }
    if (action === 'example') { Object.assign(state, { stage: 'after-10th', decision: 'explore', studentGoal: 'I want to test whether I would enjoy computers or design before choosing a stream.', studentQuestion: 'Which stream keeps both options open, and what will it cost?', parentConcern: 'We need to keep the total fee within what the family can plan for, and we worry about a stream with very hard entrance exams.', evidence: 'The official fee list and subject rules from two schools, and one talk with a senior who chose each stream.', nextStep: 'Visit two school offices and write down the fees and subjects in a table.' }); save(); render(); setStatus('Example filled in. Change anything you like.'); } if (action === 'clear') { state = blank(); save(); render(); setStatus('Cleared.'); } });
  render();
</script>

<style is:global>
  .spi{margin:2.2rem 0;padding:1.4rem;border:1px solid rgba(18,154,141,.38);border-radius:18px;background:rgba(18,154,141,.045)}.spi h2{margin-top:0}.spi p,.spi li{line-height:1.65}.spi-note,.spi-info{font-size:.86rem;color:rgba(255,255,255,.7)}.spi-form{display:grid;gap:.9rem;margin:1.1rem 0}.spi-grid,.spi-columns{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}.spi-form fieldset{border:1px solid rgba(255,255,255,.17);border-radius:12px;padding:1rem}.spi-form legend{font-weight:700;padding:0 .3rem}.spi-form label{display:grid;gap:.35rem;font-size:.9rem;font-weight:600;margin:.65rem 0}.spi-form input,.spi-form textarea,.spi-form select{width:100%;padding:.55rem .7rem;min-height:44px;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400;resize:vertical}.spi-form textarea{min-height:78px}.spi-actions{display:flex;flex-wrap:wrap;gap:.6rem}.spi-btn{min-height:44px;padding:.5rem .85rem;border:1px solid rgba(255,255,255,.22);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:600 .9rem inherit;cursor:pointer}.spi-btn--ghost{justify-self:start;border-style:dashed;color:#f7d88c}.spi-summary ol{margin:.4rem 0 0;padding-left:1.2rem}.spi-summary li{overflow-wrap:anywhere}.spi-btn--primary{background:linear-gradient(135deg,#129a8d,#0b766d);border:0;color:#fff}.spi-status{min-height:1.3em;color:#9ff3e6;font-size:.85rem}.spi-summary{padding:1rem 1.1rem;border:1px solid rgba(229,184,74,.4);border-radius:14px;background:rgba(229,184,74,.08)}.spi-summary h3{margin:.1rem 0 .4rem}.spi-link{display:inline-block;margin:.35rem 0 .8rem;color:#f3cf70;font-weight:700}.spi-form select:focus-visible,.spi-form textarea:focus-visible,.spi-btn:focus-visible,.spi-link:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}@media(max-width:650px){.spi{padding:1rem}.spi-grid,.spi-columns{grid-template-columns:1fr}}@media print{.spi{color:#111;background:#fff;border:1px solid #999}.spi-form input,.spi-form textarea,.spi-form select{color:#111;background:#fff;border-color:#999}.spi-btn{display:none}.spi-note{color:#444}}
</style>
