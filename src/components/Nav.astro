---
import { CONTACT } from '../config/site';

export interface Props {
  activePage?: string;
}
const { activePage } = Astro.props;
---

<header id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Future Career School Home">
      Future<span class="gold-text"> Career</span> School
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="/services" class:list={[activePage === 'services' ? 'nav-active' : '']}>Services</a>
      <a href="/services/career-counselling-and-career-guidance" class:list={[activePage === 'career-guidance' ? 'nav-active' : '']}>Career Guidance</a>
      <a href="/skill-finder" class:list={[activePage === 'skill-finder' ? 'nav-active' : '']}>Skill Finder</a>
      <a href="/career-resources" class:list={[activePage === 'topics' ? 'nav-active' : '']}>Career Resources</a>
      <a href="/blog" class:list={[activePage === 'blog' ? 'nav-active' : '']}>Blog</a>
    </nav>

    <div class="nav-ctas">
      <a href={`tel:${CONTACT.phoneE164}`} class="nav-phone" aria-label="Call us">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {CONTACT.phoneDisplay}
      </a>
      <a
        href="/services/career-counselling-and-career-guidance"
        class="nav-book-btn pulse"
        aria-label="Get career guidance"
      >
        Get Career Guidance
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <!-- Mobile -->
    <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href="/services">Services</a>
      <a href="/services/career-counselling-and-career-guidance">Career Guidance</a>
      <a href="/skill-finder">Skill Finder</a>
      <a href="/career-resources">Career Resources</a>
      <a href="/blog">Blog</a>
    </nav>
    <a
      href="/services/career-counselling-and-career-guidance"
      class="mobile-cta"
    >Get Career Guidance</a>
  </div>
</header>

<style>
  #nav {
    position: fixed;
    inset-x: 0; top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(8,12,24,.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,.06);
    transition: background .4s, box-shadow .4s, border-color .4s;
  }
  #nav.scrolled {
    background: rgba(8,12,24,.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 1px 0 rgba(229,184,74,.12), 0 8px 32px rgba(0,0,0,.4);
    border-bottom-color: rgba(255,255,255,.09);
  }
  .nav-inner {
    width: 100%;
    max-width: 100%;
    padding: 0 1.5rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
  }
  .nav-logo {
    font-family: "Sora", sans-serif;
    font-weight: 800;
    font-size: clamp(15px, 3.5vw, 20px);
    color: #fff;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: -.03em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }
  .nav-links a {
    font-size: 12.5px;
    color: rgba(255,255,255,.5);
    font-weight: 500;
    transition: color .2s, background .2s;
    padding: 6px 10px;
    border-radius: 8px;
    letter-spacing: .01em;
  }
  .nav-links a:hover { color: rgba(255,255,255,.9); background: rgba(255,255,255,.06); }
  .nav-active { color: var(--gold) !important; }
  .nav-ctas { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
  .nav-phone {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: rgba(255,255,255,.35);
    font-weight: 500;
    transition: color .2s;
    padding: 6px 10px;
  }
  .nav-phone:hover { color: rgba(255,255,255,.7); }
  .nav-book-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: 10px;
    background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
    color: #080c18;
    font-family: "Sora", sans-serif;
    font-weight: 700;
    font-size: 13px;
    transition: all .3s;
    box-shadow: 0 4px 16px rgba(229,184,74,.3);
    white-space: nowrap;
  }
  .nav-book-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 28px rgba(229,184,74,.5); }

  /* Mobile */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    cursor: pointer;
  }
  .hamburger span {
    display: block; width: 20px; height: 2px;
    background: rgba(255,255,255,.7);
    border-radius: 2px;
    transition: all .3s;
  }
  .hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0;
    background: rgba(8,12,24,.98);
    border-top: 1px solid transparent;
    padding: 0 20px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: max-height .35s ease, opacity .22s ease, transform .22s ease, padding .22s ease, border-color .22s ease;
  }
  .mobile-menu.open {
    max-height: 600px;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    border-top-color: rgba(255,255,255,.07);
    padding: 14px 20px 20px;
  }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 4px; margin-bottom: 20px; }
  .mobile-menu a {
    font-size: 15px;
    color: rgba(255,255,255,.6);
    padding: 12px 8px;
    border-bottom: 1px solid rgba(255,255,255,.05);
    transition: color .2s;
  }
  .mobile-menu a:hover { color: var(--gold); }
  .mobile-cta {
    display: block !important;
    padding: 14px 20px;
    background: linear-gradient(135deg,#e5b84a,#f5d98c,#c49a2a);
    color: #080c18 !important;
    font-family: "Sora", sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-align: center;
    border-radius: 12px;
    border-bottom: none !important;
  }

  :global(body.nav-menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1080px) {
    .nav-inner { padding: 0 1.25rem; }
    .nav-links a { padding: 6px 8px; }
    .nav-phone { display: none; }
    .nav-book-btn { padding: 8px 15px; font-size: 12.5px; }
  }

  @media (max-width: 920px) {
    .nav-links { display: none; }
    .nav-ctas { display: none; }
    .hamburger { display: flex; }
    .mobile-menu { display: flex; }
  }

  @media (max-width: 560px) {
    .nav-inner {
      padding: 0 .95rem;
      height: 64px;
      gap: 10px;
    }
    .nav-logo {
      font-size: clamp(14px, 4.8vw, 17px);
      max-width: calc(100% - 52px);
      white-space: normal;
      line-height: 1.05;
    }
    .hamburger { padding: 7px; }
    .mobile-menu { padding: 12px 16px 18px; }
    .mobile-menu a { padding: 13px 6px; }
    .mobile-cta {
      padding: 13px 16px;
      font-size: 13px;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('a') ?? [];
  const desktopBreakpoint = 920;

  const setMenuState = (isOpen) => {
    hamburger?.classList.toggle('open', isOpen);
    mobileMenu?.classList.toggle('open', isOpen);
    hamburger?.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
    document.body.classList.toggle('nav-menu-open', isOpen);
  };

  const closeMenu = () => setMenuState(false);

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 30);
  }, { passive: true });

  hamburger?.addEventListener('click', () => {
    const isOpen = !hamburger.classList.contains('open');
    setMenuState(isOpen);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    if (!hamburger || !mobileMenu) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (hamburger.contains(target) || mobileMenu.contains(target)) return;
    closeMenu();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > desktopBreakpoint) closeMenu();
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
