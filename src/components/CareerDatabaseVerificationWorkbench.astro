---
type SourceHint = { status: 'source-mapped-not-verified'; sources: { authority: string; url: string; coverage: string }[]; limits: string };
type QueueRecord = { key: string; title: string; status: string; owner: string; reviewCadence: string; requiredFields: readonly string[]; note: string; sourceHints: SourceHint | null };
interface Props { queue: readonly QueueRecord[] }
const { queue } = Astro.props;
const fields = ['eligibility', 'entryRoutes', 'costs', 'regulation', 'aiImpact', 'sources', 'lastVerified', 'verifier'];
---
<section class="cdw" id="career-database-workbench" aria-labelledby="cdw-title">
  <div class="cdw-head"><div><p class="cdw-kicker">EDITORIAL VERIFICATION WORKBENCH · BROWSER-LOCAL</p><h2 id="cdw-title">Prepare one queued record for review</h2><p>Use this worksheet to collect evidence before a career record can be considered for publication. It does not change the public catalogue, verify sources automatically or publish a database entry.</p></div><p class="cdw-note"><b>Private by design:</b> drafts stay in this browser unless you export them.</p></div>
  <form id="cdw-form">
    <label>Queued route<select id="cdw-route">{queue.map((record) => <option value={record.key}>{record.title}</option>)}</select></label>
    <aside id="cdw-source-hints" class="cdw-hints" aria-live="polite"></aside>
    <div class="cdw-grid"><label>Named verifier<input id="cdw-verifier" maxlength="120" placeholder="Person responsible for checking"></label><label>Review date<input id="cdw-date" type="date"></label></div>
    <label>Primary or official source URLs<textarea id="cdw-sources" rows="3" placeholder="One URL per line"></textarea></label>
    <label>Conflict, uncertainty or withdrawal note<textarea id="cdw-conflict" rows="3" placeholder="Record disagreements, missing notices or why publication should wait"></textarea></label>
    <fieldset><legend>Fields checked against a source</legend><div class="cdw-checks">{fields.map((field) => <label><input type="checkbox" value={field} data-cdw-field> {field}</label>)}</div></fieldset>
    <fieldset><legend>Evidence note for each field</legend><p class="cdw-help">Write the exact rule, source date or uncertainty you found. A note is a review record, not independent verification.</p><div class="cdw-details">{fields.map((field) => <label>{field}<textarea rows="2" maxlength="600" data-cdw-detail={field} placeholder={`What the source says about ${field}`}></textarea></label>)}</div></fieldset>
    <div class="cdw-actions"><button type="submit">Save local draft</button><button type="button" class="cdw-secondary" id="cdw-export">Export review JSON</button><button type="button" class="cdw-secondary" id="cdw-clear">Clear draft</button></div>
  </form>
  <p id="cdw-status" class="cdw-status" aria-live="polite">No draft loaded. A saved draft is not a verified record.</p>
  <script type="application/json" id="cdw-data" set:html={JSON.stringify(queue).replace(/</g, '\\u003c')}></script>
</section>
<script>
    const app = document.querySelector<HTMLElement>('#career-database-workbench');
  if (app) {
    type SourceHint = { status: 'source-mapped-not-verified'; sources: { authority: string; url: string; coverage: string }[]; limits: string };
    type Queue = { key: string; title: string; status: string; owner: string; reviewCadence: string; requiredFields: readonly string[]; note: string; sourceHints: SourceHint | null };
    type Draft = { key: string; verifier: string; reviewDate: string; sources: string; conflict: string; checked: string[]; details: Record<string, string>; savedAt: string };
    const fields = ['eligibility', 'entryRoutes', 'costs', 'regulation', 'aiImpact', 'sources', 'lastVerified', 'verifier'];
    const dataNode = app.querySelector<HTMLScriptElement>('#cdw-data');
    const route = app.querySelector<HTMLSelectElement>('#cdw-route'); const verifier = app.querySelector<HTMLInputElement>('#cdw-verifier'); const date = app.querySelector<HTMLInputElement>('#cdw-date'); const sources = app.querySelector<HTMLTextAreaElement>('#cdw-sources'); const conflict = app.querySelector<HTMLTextAreaElement>('#cdw-conflict'); const status = app.querySelector<HTMLElement>('#cdw-status'); const hints = app.querySelector<HTMLElement>('#cdw-source-hints'); const form = app.querySelector<HTMLFormElement>('#cdw-form'); const storageKey = 'fcs-career-database-verification-drafts-v1';
    if (!dataNode || !route || !verifier || !date || !sources || !conflict || !status || !hints || !form) throw new Error('Career database workbench markup is incomplete.');
    const queue = JSON.parse(dataNode.textContent || '[]') as Queue[];
    const loadAll = (): Record<string, Draft> => { try { return JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch { return {}; } };
    const checked = () => Array.from(app.querySelectorAll<HTMLInputElement>('[data-cdw-field]:checked')).map((input) => input.value);
    const details = () => Object.fromEntries(Array.from(app.querySelectorAll<HTMLTextAreaElement>('[data-cdw-detail]')).map((input) => [input.dataset.cdwDetail || '', input.value.trim()]));
    const render = () => { const draft = loadAll()[route.value]; const record = queue.find((item) => item.key === route.value); verifier.value = draft?.verifier || ''; date.value = draft?.reviewDate || ''; sources.value = draft?.sources || ''; conflict.value = draft?.conflict || ''; app.querySelectorAll<HTMLInputElement>('[data-cdw-field]').forEach((input) => { input.checked = !!draft?.checked?.includes(input.value); }); app.querySelectorAll<HTMLTextAreaElement>('[data-cdw-detail]').forEach((input) => { input.value = draft?.details?.[input.dataset.cdwDetail || ''] || ''; }); hints.innerHTML = record?.sourceHints ? `<b>Primary-source starting points · ${record.sourceHints.status}</b><ul>${record.sourceHints.sources.map((source) => `<li><a href="${source.url}" target="_blank" rel="noreferrer">${source.authority}</a>, ${source.coverage}</li>`).join('')}</ul><small>${record.sourceHints.limits}</small>` : '<b>No source map prepared for this route.</b> Build the evidence packet from current primary sources.'; status.textContent = draft ? `Local draft loaded for ${record?.title || route.value}; it is not a verified record.` : 'No draft loaded. A saved draft is not a verified record.'; };
    const current = (): Draft => ({ key: route.value, verifier: verifier.value.trim(), reviewDate: date.value, sources: sources.value.trim(), conflict: conflict.value.trim(), checked: checked(), details: details(), savedAt: new Date().toISOString() });
    form.addEventListener('submit', (event) => { event.preventDefault(); const all = loadAll(); all[route.value] = current(); localStorage.setItem(storageKey, JSON.stringify(all)); status.textContent = `Saved a browser-local draft for ${queue.find((item) => item.key === route.value)?.title || route.value}. It is not a verified record and is not published.`; });
    route.addEventListener('change', render);
    app.querySelector<HTMLButtonElement>('#cdw-clear')?.addEventListener('click', () => { const all = loadAll(); delete all[route.value]; localStorage.setItem(storageKey, JSON.stringify(all)); render(); });
    app.querySelector<HTMLButtonElement>('#cdw-export')?.addEventListener('click', () => { const draft = current(); const validSources = draft.sources.split(/\s+/).filter(Boolean).every((value) => { try { const parsed = new URL(value); return parsed.protocol === 'https:' || parsed.protocol === 'http:'; } catch { return false; } }); const missing = fields.filter((field) => !draft.checked.includes(field) || !draft.details[field]); if (!draft.verifier || !draft.reviewDate || !validSources || missing.length) { status.textContent = `Review packet is incomplete: add a verifier, date, valid source URL(s), and evidence notes for ${missing.length ? missing.join(', ') : 'all checked fields'}. Nothing was exported.`; return; } const payload = { queueRecord: queue.find((item) => item.key === route.value), draft, publicationStatus: 'not-published', reviewReadiness: 'complete-for-human-review' }; const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${route.value}-verification-review.json`; link.click(); URL.revokeObjectURL(link.href); status.textContent = 'Exported a complete review packet. It remains a draft and is not a database publication.'; });
    render();
  }
</script>
<style>
  .cdw{margin:2rem 0;padding:clamp(1.1rem,3vw,2rem);border:1px solid rgba(18,154,141,.42);border-radius:22px;background:linear-gradient(145deg,rgba(18,154,141,.1),rgba(255,255,255,.03));color:#f8fafc}.cdw-head{display:grid;grid-template-columns:1fr minmax(210px,300px);gap:1.2rem}.cdw-kicker{margin:0;color:#8de4d8;font-size:.76rem;font-weight:800;letter-spacing:.1em}.cdw h2{margin:.45rem 0}.cdw p{line-height:1.65;color:rgba(255,255,255,.7)}.cdw-note{padding:.85rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.04);font-size:.86rem}.cdw-help{margin:.55rem 0 0;font-size:.82rem}.cdw-hints{padding:.8rem;border:1px solid rgba(229,184,74,.35);border-radius:12px;background:rgba(229,184,74,.08);font-size:.86rem;line-height:1.55}.cdw-hints ul{margin:.45rem 0;padding-left:1.2rem}.cdw-hints a{color:#ffe08a}.cdw form{display:grid;gap:.9rem;margin-top:1.2rem}.cdw label,.cdw legend{display:grid;gap:.35rem;color:#fff;font-size:.86rem;font-weight:700}.cdw input,.cdw select,.cdw textarea{width:100%;padding:.55rem .7rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:#101927;color:#fff;font:inherit}.cdw-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.cdw fieldset{border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:.8rem}.cdw-checks{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem;margin-top:.6rem}.cdw-checks label{display:block;font-weight:500}.cdw-checks input{width:auto}.cdw-details{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-top:.7rem}.cdw-details label{font-weight:600}.cdw-actions{display:flex;gap:.6rem;flex-wrap:wrap}.cdw-actions button{min-height:44px;padding:.55rem .85rem;border:0;border-radius:10px;background:#e5b84a;color:#17130a;font-weight:800;cursor:pointer}.cdw-actions .cdw-secondary{border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff}.cdw-status{font-size:.88rem}.cdw input:focus-visible,.cdw select:focus-visible,.cdw textarea:focus-visible,.cdw button:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}@media(max-width:700px){.cdw-head,.cdw-grid,.cdw-details{grid-template-columns:1fr}.cdw-checks{grid-template-columns:repeat(2,1fr)}}
</style>
