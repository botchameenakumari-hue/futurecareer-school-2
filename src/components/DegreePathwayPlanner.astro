---
import { DEGREE_PATHWAY_PLANNER_PRESETS } from '../config/degreePathwayPlanner';
const embeddedData = JSON.stringify(DEGREE_PATHWAY_PLANNER_PRESETS).replace(/</g, '\\u003c');
---
<section class="dpp" id="degree-pathway-planner" aria-labelledby="dpp-title">
  <div class="dpp-head"><div><p class="dpp-kicker">Subject → work pattern → evidence</p><h2 id="dpp-title">Turn a degree interest into a small project</h2><p>Select the subject family you are considering and the work signals you want to test. The planner gives a project and route checks—not a guaranteed career match.</p></div><p class="dpp-note"><b>Private by design:</b> this worksheet runs in your browser. No answers are saved or sent.</p></div>
  <form id="dpp-form" class="dpp-form">
    <label>Subject or degree family<select data-dpp="preset">{DEGREE_PATHWAY_PLANNER_PRESETS.map((preset) => <option value={preset.id}>{preset.label}</option>)}</select></label>
    <label>What work signal do you want to test?<select data-dpp="signal"><option value="">Choose one</option>{DEGREE_PATHWAY_PLANNER_PRESETS[0].workSignals.map((signal) => <option value={signal}>{signal}</option>)}</select></label>
    <label>Current stage<select data-dpp="stage"><option>Still comparing subjects</option><option>Already studying this subject</option><option>Considering a change</option><option>Preparing for a first project</option></select></label>
    <button type="submit">Build my project brief</button>
  </form>
  <div id="dpp-result" class="dpp-result" aria-live="polite" hidden><p class="dpp-result-kicker">Your evidence-building brief</p><h3 data-dpp-out="title"></h3><div class="dpp-columns"><div><h4>Work signals to notice</h4><ul data-dpp-out="signals"></ul></div><div><h4>Role families worth exploring</h4><ul data-dpp-out="roles"></ul></div></div><div class="dpp-project"><h4>30-day project</h4><p data-dpp-out="project"></p><p><b>Evidence to keep:</b> <span data-dpp-out="evidence"></span></p></div><div class="dpp-checks"><div><h4>Route check</h4><p data-dpp-out="route"></p></div><div><h4>Watch out</h4><p data-dpp-out="watch"></p></div></div><p class="dpp-stage" data-dpp-out="stage"></p></div>
  <p class="dpp-source">These are editorial planning prompts, not occupational licensing advice, admissions rulings, salary data or a validated aptitude instrument.</p>
</section>
<script id="dpp-data" type="application/json" set:html={embeddedData}></script>
<script>
  const planner = document.querySelector<HTMLElement>('#degree-pathway-planner');
  if (planner) {
    const form = planner.querySelector<HTMLFormElement>('#dpp-form'); const result = planner.querySelector<HTMLElement>('#dpp-result');
    const presetField = planner.querySelector<HTMLSelectElement>('[data-dpp="preset"]'); const signalField = planner.querySelector<HTMLSelectElement>('[data-dpp="signal"]'); const stageField = planner.querySelector<HTMLSelectElement>('[data-dpp="stage"]');
    if (!form || !result || !presetField || !signalField || !stageField) throw new Error('Degree pathway planner markup is incomplete.');
    const dataNode = document.querySelector<HTMLScriptElement>('#dpp-data');
    if (!dataNode) throw new Error('Degree pathway planner data is missing.');
    const presets = JSON.parse(dataNode.textContent || '[]') as Array<{id:string;label:string;subject:string;workSignals:string[];roleFamilies:string[];project:string;evidence:string;routeCheck:string;watchOut:string}>;
    const out = (key: string) => { const node = planner.querySelector<HTMLElement>(`[data-dpp-out="${key}"]`); if (!node) throw new Error(`Degree pathway planner output is missing: ${key}`); return node; };
    const list = (key: string, values: string[]) => { out(key).innerHTML = values.map((value) => `<li>${value.replace(/[&<>"']/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[character] || character)}</li>`).join(''); };
    const syncSignals = () => { const preset = presets.find((item) => item.id === presetField.value) || presets[0]; signalField.innerHTML = `<option value="">Choose one</option>${preset.workSignals.map((signal) => `<option value="${signal}">${signal}</option>`).join('')}`; };
    presetField.addEventListener('change', syncSignals); syncSignals();
    form.addEventListener('submit', (event) => { event.preventDefault(); const preset = presets.find((item) => item.id === presetField.value) || presets[0]; const signal = signalField.value || preset.workSignals[0]; out('title').textContent = `${preset.label}: test ${signal}`; list('signals', preset.workSignals); list('roles', preset.roleFamilies); out('project').textContent = preset.project; out('evidence').textContent = preset.evidence; out('route').textContent = preset.routeCheck; out('watch').textContent = preset.watchOut; out('stage').textContent = `Stage selected: ${stageField.value}. Keep a dated note after each session, then decide whether to deepen, redirect or stop.`; result.hidden = false; });
  }
</script>
<style is:global>
  .dpp{margin:2rem 0;padding:clamp(1.1rem,3vw,2rem);border:1px solid rgba(109,213,237,.38);border-radius:22px;background:linear-gradient(145deg,rgba(109,213,237,.1),rgba(255,255,255,.03));color:#f8fafc}.dpp-head{display:grid;grid-template-columns:1fr minmax(210px,300px);gap:1.2rem}.dpp-kicker{margin:0;color:#8de4d8;font-size:.76rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.dpp h2{margin:.45rem 0 .55rem;color:#fff}.dpp p{color:rgba(255,255,255,.68);line-height:1.65}.dpp-note{padding:.85rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.04);font-size:.86rem}.dpp-form{display:grid;grid-template-columns:2fr 1.5fr 1.4fr auto;gap:.75rem;margin:1.25rem 0}.dpp-form label{display:grid;gap:.35rem;color:#fff;font-size:.86rem;font-weight:700}.dpp-form select{min-height:44px;width:100%;padding:.55rem .7rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:#101927;color:#fff;font:inherit}.dpp-form button{align-self:end;min-height:44px;padding:.55rem .85rem;border:0;border-radius:10px;background:#e5b84a;color:#17130a;font-weight:800;cursor:pointer}.dpp-result{padding:1rem;border-radius:15px;background:rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.14)}.dpp-result h3{margin:.2rem 0 1rem;color:#fff}.dpp-result-kicker{margin:0;color:#f7d88c!important;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.dpp-columns,.dpp-checks{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.dpp-columns>div,.dpp-checks>div{padding:.85rem;border-radius:12px;background:rgba(255,255,255,.04)}.dpp h4{margin:.1rem 0 .55rem;color:#fff}.dpp li,.dpp-checks p,.dpp-project p{color:rgba(255,255,255,.7);line-height:1.55}.dpp li+li{margin-top:.35rem}.dpp-project{margin:.8rem 0;padding:1rem;border-left:3px solid #e5b84a;background:rgba(229,184,74,.08)}.dpp-stage,.dpp-source{font-size:.82rem}.dpp-source{color:rgba(255,255,255,.5)!important}.dpp-form select:focus-visible,.dpp-form button:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}@media(max-width:900px){.dpp-form{grid-template-columns:1fr 1fr}.dpp-form button{align-self:stretch}}@media(max-width:620px){.dpp-head,.dpp-form,.dpp-columns,.dpp-checks{grid-template-columns:1fr}}
</style>
