<section class="iip" id="informational-interview-planner" aria-labelledby="iip-title">
  <p class="eyebrow">RESEARCH BEFORE A COSTLY DECISION</p>
  <h2 id="iip-title">Plan an informational interview</h2>
  <p>Prepare a respectful conversation with someone who actually does the work, then turn what you learn into a next experiment.</p>
  <p class="iip-note"><b>Boundary:</b> this is research, not a disguised job request. Do not ask for confidential information, pressure anyone to reply, or treat one person’s experience as a universal rule.</p>
  <form id="iip-form" class="iip-form" novalidate>
    <label>What work or route are you researching?<input name="direction" maxlength="160" placeholder="For example, data analysis, nursing or UX design" required /></label>
    <label>What do you want to learn most?<select name="goal"><option value="daily">What the daily work is really like</option><option value="entry">How people build an entry route</option><option value="friction">What is harder than outsiders expect</option><option value="evidence">What proof or practice helps first</option></select></label>
    <label>How will you protect the other person’s time and privacy?<select name="respect"><option value="0">I have not planned this</option><option value="1">I will ask for a short conversation</option><option value="2">I have a specific request and will not seek confidential details</option></select></label>
    <label>What will you do with the learning?<textarea name="next" rows="3" maxlength="600" placeholder="Compare another perspective, run a small task, or update your route questions"></textarea></label>
    <div class="iip-actions"><button class="iip-primary" type="submit">Create interview plan</button><button type="button" data-iip="clear">Clear</button></div>
    <p id="iip-status" class="iip-status" role="status" aria-live="polite"></p>
  </form>
  <div id="iip-result" class="iip-result" hidden></div>
</section>
<script>
  type IipField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type IipForm = Omit<HTMLFormElement, 'querySelectorAll'> & { querySelectorAll(selectors: string): NodeListOf<IipField> };
  const iipForm = document.querySelector<HTMLFormElement>('#iip-form') as IipForm | null;
  const iipResult = document.querySelector<HTMLDivElement>('#iip-result');
  const iipStatus = document.querySelector<HTMLParagraphElement>('#iip-status');
  const iipClear = document.querySelector<HTMLButtonElement>('[data-iip="clear"]');
  if (!iipForm || !iipResult || !iipStatus || !iipClear) throw new Error('Informational interview planner markup is incomplete.');
  const iipEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  iipForm.addEventListener('submit', (event) => { event.preventDefault(); if (!iipForm.checkValidity()) { iipForm.reportValidity(); return; } const data = Object.fromEntries([...iipForm.querySelectorAll('input,select,textarea')].map((field) => [field.name, field.value])); const goal = { daily: 'Ask what a normal week contains, including the repetitive or inconvenient parts.', entry: 'Ask which first steps, qualifications and proof helped—and which were unnecessary.', friction: 'Ask what surprised them, what is difficult to sustain, and what outsiders misunderstand.', evidence: 'Ask what a beginner could make or practise to receive useful feedback.' }[data.goal]; const first = Number(data.respect) < 2 ? 'Write a short request that names the topic, time needed and permission to decline.' : 'Send the focused request and prepare three open questions before the conversation.'; iipResult.innerHTML = `<div class="iip-lead"><span>${iipEsc(data.direction)} · research plan</span><h3>One conversation, one next test</h3><p>This plan helps you collect a perspective; it does not prove that the route fits you or predict an outcome.</p></div><div class="iip-grid"><article><b>First action</b><p>${iipEsc(first)}</p></article><article><b>Learning question</b><p>${iipEsc(goal)}</p></article><article><b>Your follow-up</b><p>${data.next ? iipEsc(data.next) : 'Write what you will test or verify after the conversation.'}</p></article></div><div class="iip-next"><h3>Question set</h3><ul><li>What does a typical week involve, and which part takes more time than people expect?</li><li>What did you have to learn or prove before someone trusted you with real work?</li><li>What would you test for two weeks before paying for a course or leaving another route?</li><li>What should I verify from an official source rather than rely on personal experience?</li><li>May I send one brief follow-up question, and is it okay if I do not quote you publicly?</li></ul></div>`; iipResult.hidden = false; iipStatus.textContent = 'Interview plan created from your answers; nothing was sent.'; });
  iipClear.addEventListener('click', () => { iipForm.reset(); iipResult.hidden = true; iipStatus.textContent = 'Cleared.'; });
</script>
<style>
  .iip{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.iip h2{margin:.2rem 0 .6rem}.iip>p{max-width:800px;line-height:1.65}.iip-note,.iip-status{color:rgba(255,255,255,.68);font-size:.88rem}.iip-form{display:grid;gap:1rem;margin-top:1.4rem}.iip-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.iip-form input,.iip-form select,.iip-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.iip-actions{display:flex;gap:.6rem;flex-wrap:wrap}.iip-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.iip-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.iip-result{margin-top:1.3rem}.iip-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.iip-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.iip-lead h3{margin:.4rem 0;font-size:1.5rem}.iip-lead p,.iip-grid p,.iip-next li{line-height:1.6;color:rgba(255,255,255,.75)}.iip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin-top:.8rem}.iip-grid article,.iip-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.iip-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.iip-next h3{margin-top:0}@media(max-width:760px){.iip-grid{grid-template-columns:1fr}}
</style>
