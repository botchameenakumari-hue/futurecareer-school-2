---
import { CONTACT } from '../config/site';
import { BOFU_INTERNAL_LINKS } from '../config/bofu';
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div>
        <div class="footer-logo">Future<span class="gold-text"> Career</span> School</div>
        <p class="footer-desc">India's practical career guidance platform helping students and professionals build high-value skill paths and work toward earlier financial freedom.</p>
        <div class="footer-contact">
          <address>
            <svg width="13" height="13" fill="none" stroke="rgba(229,184,74,.55)" stroke-width="1.8" viewBox="0 0 24 24" style="flex-shrink:0;margin-top:2px" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>13-420, Durga Nagar, Arilova,<br/>Visakhapatnam, AP 530040</span>
          </address>
          <a href={`tel:${CONTACT.phoneE164}`}>
            <svg width="13" height="13" fill="none" stroke="rgba(229,184,74,.55)" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {CONTACT.phoneDisplay}
          </a>
          <a href={`mailto:${CONTACT.email}`}>
            <svg width="13" height="13" fill="none" stroke="rgba(229,184,74,.55)" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {CONTACT.email}
          </a>
        </div>
      </div>

      <!-- By Career Stage -->
      <nav class="footer-nav" aria-label="By Career Stage">
        <h4>By Career Stage</h4>
        <ul>
          <li><a href={BOFU_INTERNAL_LINKS.students}>Student Career Guidance</a></li>
          <li><a href={BOFU_INTERNAL_LINKS.workingProfessionals}>Professional Career Guidance</a></li>
          <li><a href={BOFU_INTERNAL_LINKS.after12th}>Career Guidance After 12th</a></li>
          <li><a href="/career-resources?audience=professional&topic=career-planning&q=career%20change">Career Change Guide</a></li>
        </ul>
      </nav>

      <!-- Top Skills -->
      <nav class="footer-nav" aria-label="Top Skills">
        <h4>Top Skills</h4>
        <ul>
          <li><a href="/career-resources?topic=skills&q=data%20science">Data Science Roadmap</a></li>
          <li><a href="/career-resources?topic=skills&q=digital%20marketing">Digital Marketing</a></li>
          <li><a href="/career-resources?topic=skills&q=prompt%20engineering">AI &amp; Prompt Engineering</a></li>
          <li><a href="/career-resources?topic=skills&q=sales">Sales &amp; Closing Skills</a></li>
        </ul>
      </nav>

      <!-- Resources -->
      <nav class="footer-nav" aria-label="Resources">
        <h4>Resources</h4>
        <ul>
          <li><a href="/services/assessments#psychometric-career-test">Psychometric Career Test</a></li>
          <li><a href="/services/assessments">Assessments and Career Tests</a></li>
          <li><a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a></li>
          <li><a href="/career-resources?type=tool">Career Tools</a></li>
          <li><a href="/career-resources?topic=skills&type=roadmap">Skill Roadmaps</a></li>
          <li><a href="/career-resources">Career Resources</a></li>
        </ul>
      </nav>

      <!-- City Guides -->
      <nav class="footer-nav" aria-label="City Guides">
        <h4>Counselors In</h4>
        <ul>
          <li><a href="/locations">All Cities</a></li>
          <li><a href="/locations#visakhapatnam">Visakhapatnam</a></li>
          <li><a href="/locations#hyderabad">Hyderabad</a></li>
          <li><a href="/locations#bangalore">Bangalore</a></li>
          <li><a href="/locations#delhi">Delhi</a></li>
          <li><a href="/locations#mumbai">Mumbai</a></li>
        </ul>
      </nav>

      <!-- Company -->
      <nav class="footer-nav" aria-label="Company">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/about#team">Our Team</a></li>
          <li><a href="/about#vision">Our Vision</a></li>
          <li><a href="/about#reviews">Client Reviews</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bar">
      <p class="footer-copy">&copy; Future Career School. All rights reserved. Registered in Visakhapatnam, Andhra Pradesh, India.</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/services">Services</a>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling</a>
        <a href="/services/assessments">Assessments</a>
        <a href="/services/career-counselling-and-career-guidance#guidance-process">Guidance Model</a>
        <a href="/career-skills-compass">Career & Skills Compass</a>
        <a href="/career-resources">Career Resources</a>
        <a href="/blog">Blog</a>
        <a href="/locations">Locations</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #040710;
    border-top: 1px solid rgba(255,255,255,.06);
    padding: 72px 0 36px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr 1fr;
    gap: 28px;
    margin-bottom: 48px;
  }
  .footer-logo {
    font-family: "Sora", sans-serif;
    font-weight: 800;
    font-size: 17px;
    margin-bottom: 14px;
    letter-spacing: -.02em;
  }
  .footer-desc {
    font-size: 12px;
    color: rgba(255,255,255,.28);
    line-height: 1.7;
    max-width: 220px;
    margin-bottom: 20px;
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .footer-contact a,
  .footer-contact address {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 12px;
    color: rgba(255,255,255,.3);
    font-style: normal;
    transition: color .2s;
    line-height: 1.5;
  }
  .footer-contact a:hover { color: var(--gold); }
  .footer-nav h4 {
    font-family: "Sora", sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 16px;
    letter-spacing: .02em;
  }
  .footer-nav ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .footer-nav a {
    font-size: 12px;
    color: rgba(255,255,255,.3);
    transition: color .2s;
    line-height: 1.4;
  }
  .footer-nav a:hover { color: var(--gold); }
  .footer-bar {
    border-top: 1px solid rgba(255,255,255,.07);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .footer-copy { font-size: 11px; color: rgba(255,255,255,.2); }
  .footer-legal { display: flex; gap: 20px; flex-wrap: wrap; row-gap: 8px; }
  .footer-legal a { font-size: 11px; color: rgba(255,255,255,.2); transition: color .2s; }
  .footer-legal a:hover { color: var(--gold); }

  @media (max-width: 1100px) { .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 24px; } }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
  @media (max-width: 640px) {
    footer { padding: 56px 0 28px; }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 22px;
      margin-bottom: 34px;
    }
    .footer-desc { max-width: 100%; }
    .footer-bar {
      padding-top: 22px;
      align-items: flex-start;
      gap: 10px;
    }
    .footer-copy {
      max-width: 34ch;
      line-height: 1.6;
    }
    .footer-legal { gap: 10px 14px; }
  }
</style>
