  .spt-how{display:flex;flex-wrap:wrap;gap:.6rem;list-style:none;padding:0;margin:1.2rem 0}
  .spt-how li{border:1px solid var(--border);background:var(--card);border-radius:999px;padding:.4rem .9rem;font-size:.9rem}
  .spt-note{max-width:720px;font-size:.88rem;color:rgba(255,255,255,.6)}
  .spt-section{padding:40px 0 72px}
