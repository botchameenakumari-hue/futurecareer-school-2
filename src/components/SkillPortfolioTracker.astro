  .spt-eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(229,184,74,.35);border-radius:999px;padding:.35rem .9rem;margin-bottom:1rem}
  .spt-hero h1{font-size:clamp(2rem,5vw,3rem);max-width:820px}
