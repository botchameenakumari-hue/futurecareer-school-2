---
// One page template for the self-rating tests defined in src/config/skillSelfTests.ts.
// Each test supplies its own questions, score areas, interpretation and FAQ;
// this file only provides the layout, the quiz and the result screen.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import AssessmentReportTools from './AssessmentReportTools.astro';
import MainAssessmentFunnel from './bofu/MainAssessmentFunnel.astro';
import MainAssessmentRibbon from './bofu/MainAssessmentRibbon.astro';
import MainAssessmentPicker from './bofu/MainAssessmentPicker.astro';
import MainAssessmentCompare from './bofu/MainAssessmentCompare.astro';
import AssessmentGuidanceCta from './bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from './bofu/GuidancePlansSection.astro';
import LinkDirectorySection from './LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../config/assessmentPlans';
import { SKILL_TESTS, type SkillTestId } from '../config/skillSelfTests';
import { SKILL_TEST_DEPTH } from '../config/skillSelfTestDepth';

interface Props {
  testId: SkillTestId;
}

const { testId } = Astro.props;
const test = SKILL_TESTS[testId];
const depth = SKILL_TEST_DEPTH[testId];
const isStudent = test.main === 'class10';
const plansConfig = getAssessmentPlansConfig(isStudent ? 'student' : 'mixed');

const clientData = {
  id: test.id,
  scoreLabel: test.scoreLabel,
  resultKicker: test.resultKicker,
  bands: test.bands,
  limits: test.limits,
  domains: test.domains,
  questions: test.questions,
  reportTitle: test.reportTitle,
  reportFile: test.reportFile,
  isStudent,
  depth,
  related: test.related,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments/' },
      { '@type': 'ListItem', position: 4, name: test.breadcrumbName, item: test.pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: test.breadcrumbName,
    description: test.webAppDescription,
    url: test.pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: test.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={test.metaTitle}
  description={test.metaDescription}
  canonical={test.pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main class="sst">
    <section id="hero" class="sst-hero">
      <div class="container sst-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments/">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">{test.breadcrumbName}</span>
        </nav>
        <div class="sst-eyebrow">{test.eyebrow}</div>
        <h1>{test.h1Lead} <span>{test.h1Accent}</span></h1>
        <p class="sst-hero-sub">{test.heroSub}</p>
        <div class="sst-stats" aria-label="Assessment details">
          {test.stats.map((s) => <div><strong>{s.value}</strong><span>{s.label}</span></div>)}
        </div>
        <div class="sst-hero-actions">
          <a href="#assessment" class="btn-gold">Start the test ↓</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <MainAssessmentRibbon main={test.main} />
        <p class="sst-note">Self-rating tool for reflection. It is not a clinical, hiring or selection test.</p>
      </div>
    </section>

    {isStudent
      ? <MainAssessmentCompare main="class10" narrowName={test.breadcrumbName} narrowChecks={test.mainChecks} />
      : <MainAssessmentPicker />}

    <div class="assessment-first-flow">
      <section id="assessment" class="sst-section sst-quiz-section">
        <div class="container">
          <div class="sst-heading">
            <span class="sst-kicker">Rate each statement honestly</span>
            <h2>How true is each statement for you?</h2>
            <p>There are no right answers. Think of your usual pattern, not your best day.</p>
          </div>
          <div id="start-shell" class="sst-start">
            <h3 class="sst-stage-title">{depth.stageHeading}</h3>
            <p class="sst-stage-note">{depth.stageNote}</p>
            <div class="sst-stages" role="radiogroup" aria-label={depth.stageHeading}>
              {depth.stages.map((st) => (
                <button type="button" class="sst-stage" data-stage={st.key} role="radio" aria-checked="false"><strong>{st.label}</strong><span>{st.description}</span></button>
              ))}
            </div>
            <button id="start-button" type="button" class="sst-btn sst-btn--primary" disabled>Choose where you are to begin</button>
          </div>
          <div id="quiz-shell" class="sst-quiz" hidden>
            <div class="sst-topline"><span id="area-label"></span><span id="question-counter"></span></div>
            <div class="sst-progress" role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="progress-fill"></span></div>
            <p id="question-prompt" class="sst-prompt" tabindex="-1"></p>
            <div id="scale-options" class="sst-scale" role="radiogroup" aria-label="Choose how true this is for you">
              <button type="button" data-value="1" role="radio" aria-checked="false"><strong>1</strong><span>Not true</span></button>
              <button type="button" data-value="2" role="radio" aria-checked="false"><strong>2</strong><span>Rarely true</span></button>
              <button type="button" data-value="3" role="radio" aria-checked="false"><strong>3</strong><span>Sometimes</span></button>
              <button type="button" data-value="4" role="radio" aria-checked="false"><strong>4</strong><span>Mostly true</span></button>
              <button type="button" data-value="5" role="radio" aria-checked="false"><strong>5</strong><span>Very true</span></button>
            </div>
            <div class="sst-nav">
              <button id="back-button" type="button" class="sst-btn sst-btn--ghost" disabled>Back</button>
              <button id="next-button" type="button" class="sst-btn sst-btn--primary" disabled>Next</button>
            </div>
          </div>
          <div id="result-shell" class="sst-result" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label={test.reportTitle}></div>
        </div>
      </section>
    </div>

    <section class="sst-section sst-alt">
      <div class="container">
        <div class="sst-heading">
          <span class="sst-kicker">What is scored</span>
          <h2>{test.domainsHeading}</h2>
          <p>{test.domainsIntro}</p>
        </div>
        <div class="sst-domains">
          {test.domains.map((d) => (
            <article>
              <h3>{d.name}</h3>
              <p class="sst-domain-short">{d.short}</p>
              <p><strong>High score:</strong> {d.strong}</p>
              <p><strong>Low score:</strong> {d.weak}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sst-section">
      <div class="container sst-reading">
        <h2>{test.readingTitle}</h2>
        {test.readingSections.map((s) => (
          <div>
            <h3>{s.title}</h3>
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        ))}
        <h3>Limits to keep in mind</h3>
        <ul>{test.limits.map((l) => <li>{l}</li>)}</ul>
      </div>
    </section>

    <section id="faq" class="sst-section sst-alt">
      <div class="container">
        <div class="sst-heading"><span class="sst-kicker">Common questions</span><h2>Before you take the test</h2></div>
        <div class="sst-faq">
          {test.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <LinkDirectorySection
      sectionId="related-assessments"
      title="Related free assessments and guides"
      subtitle="Go deeper on the area your result points to."
      items={test.related}
    />
    <AssessmentGuidanceCta mode={isStudent ? 'student' : 'mixed'} sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title={test.reportTitle}
    fileName={test.reportFile}
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker={test.reportKicker}
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <MainAssessmentFunnel
    containerId="result-shell"
    main={test.main}
    narrowName={test.breadcrumbName}
    narrowChecks={test.mainChecks}
  />
  <script type="application/json" id="sst-data" set:html={JSON.stringify(clientData)} />
  <Footer />
</BaseLayout>

<style is:global>
  .sst{background:#080c18;color:rgba(255,255,255,.86)}
  .sst h1,.sst h2,.sst h3{color:#fff}
  .sst-hero{padding:128px 0 64px;background:linear-gradient(165deg,#07101f 0%,#0d1a33 60%,#1b1608 100%)}
  .sst-hero .breadcrumb{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.85rem;color:rgba(255,255,255,.6);margin-bottom:1.2rem}
  .sst-hero .breadcrumb a:hover{color:var(--gold)}
  .sst-eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(229,184,74,.35);border-radius:999px;padding:.35rem .9rem;margin-bottom:1rem}
  .sst-hero h1{font-size:clamp(2rem,5vw,3.2rem);max-width:820px}
  .sst-hero h1 span{background:linear-gradient(135deg,#e5b84a,#f5d98c);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .sst-hero-sub{max-width:760px;margin-top:1.1rem;font-size:1.05rem;line-height:1.65;color:rgba(255,255,255,.78)}
  .sst-stats{display:flex;flex-wrap:wrap;gap:1rem;margin:1.6rem 0}
  .sst-stats div{border:1px solid var(--border);background:var(--card);border-radius:14px;padding:.7rem 1.1rem;min-width:110px}
  .sst-stats strong{display:block;font-family:"Sora",sans-serif;font-size:1.4rem;color:var(--gold)}
  .sst-stats span{font-size:.82rem;color:rgba(255,255,255,.65)}
  .sst-hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-bottom:1.1rem}
  .sst-note{margin-top:1rem;font-size:.85rem;color:rgba(255,255,255,.55);max-width:720px}
  .sst-section{padding:64px 0}
  .sst-alt{background:#0a1020}
  .sst-heading{max-width:760px;margin-bottom:1.6rem}
  .sst-heading h2{font-size:clamp(1.5rem,3.2vw,2.1rem);margin:.5rem 0}
  .sst-heading p{line-height:1.65;color:rgba(255,255,255,.72)}
  .sst-kicker{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal)}
  .sst-btn{border:0;border-radius:12px;padding:.85rem 1.4rem;font:600 1rem "DM Sans",sans-serif;cursor:pointer}
  .sst-btn--primary{background:linear-gradient(135deg,#e5b84a,#c49a2a);color:#14110a}
  .sst-btn--ghost{background:transparent;color:#fff;border:1px solid var(--border)}
  .sst-btn:disabled{opacity:.45;cursor:not-allowed}
  .sst-btn:focus-visible,.sst-scale button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
  .sst-stage-title{font-size:1.2rem;margin-bottom:.4rem}
  .sst-stage-note{color:rgba(255,255,255,.7);line-height:1.6;max-width:720px;margin-bottom:1rem}
  .sst-stages{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.7rem;max-width:860px;margin-bottom:1.2rem}
  .sst-stage{text-align:left;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:14px;color:#fff;padding:.9rem 1rem;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;gap:.25rem}
  .sst-stage span{font-size:.82rem;color:rgba(255,255,255,.65)}
  .sst-stage[aria-checked="true"]{border-color:var(--gold);background:rgba(229,184,74,.16)}
  .sst-stage:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
  .sst-quiz,.sst-result{border:1px solid var(--border);background:var(--card);border-radius:18px;padding:1.4rem;max-width:860px;scroll-margin-top:92px}
  .sst-topline{display:flex;justify-content:space-between;gap:1rem;font-size:.88rem;color:rgba(255,255,255,.65);margin-bottom:.7rem}
  .sst-progress{height:8px;background:rgba(255,255,255,.1);border-radius:99px;overflow:hidden;margin-bottom:1.3rem}
  .sst-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--teal),var(--gold));transition:width .25s}
  .sst-prompt{font-family:"Sora",sans-serif;font-size:clamp(1.15rem,2.6vw,1.45rem);line-height:1.4;color:#fff;margin-bottom:1.3rem;outline:none}
  .sst-scale{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem}
  .sst-scale button{background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:12px;color:#fff;padding:.8rem .3rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.3rem;font-family:inherit}
  .sst-scale button strong{font-size:1.2rem}
  .sst-scale button span{font-size:.75rem;color:rgba(255,255,255,.7)}
  .sst-scale button[aria-checked="true"]{background:rgba(229,184,74,.18);border-color:var(--gold)}
  .sst-nav{display:flex;justify-content:space-between;margin-top:1.4rem}
  .sst-domains{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem}
  .sst-domains article{border:1px solid var(--border);background:var(--card);border-radius:16px;padding:1.2rem}
  .sst-domains h3{font-size:1.1rem;margin-bottom:.3rem}
  .sst-domain-short{color:var(--teal);font-size:.88rem;margin-bottom:.6rem}
  .sst-domains p{line-height:1.55;font-size:.95rem;margin-bottom:.5rem}
  .sst-reading{max-width:820px}
  .sst-reading h2{font-size:clamp(1.5rem,3vw,2rem);margin-bottom:1rem}
  .sst-reading h3{font-size:1.15rem;margin:1.4rem 0 .5rem}
  .sst-reading p,.sst-reading li{line-height:1.7;color:rgba(255,255,255,.78);margin-bottom:.7rem}
  .sst-reading ul{padding-left:1.2rem}
  .sst-faq{max-width:820px;display:grid;gap:.7rem}
  .sst-faq details{border:1px solid var(--border);background:var(--card);border-radius:14px;padding:1rem 1.2rem}
  .sst-faq summary{cursor:pointer;font-weight:600;color:#fff}
  .sst-faq p{margin-top:.7rem;line-height:1.65;color:rgba(255,255,255,.78)}
  .sst-result .result-head{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;margin-bottom:1.2rem}
  .sst-result .score-mark{width:112px;height:112px;border-radius:50%;border:4px solid var(--gold);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0}
  .sst-result .score-mark strong{font-family:"Sora",sans-serif;font-size:1.7rem;color:var(--gold)}
  .sst-result .score-mark span{font-size:.7rem;text-align:center;color:rgba(255,255,255,.7)}
  .sst-result .result-kicker{font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal)}
  .sst-result h3{font-size:1.4rem;margin:.2rem 0 .4rem}
  .sst-result .result-section{margin-top:1.5rem}
  .sst-result .result-section h4{font-family:"Sora",sans-serif;font-size:1.1rem;color:#fff;margin-bottom:.6rem}
  .sst-result .result-section p,.sst-result .result-section li{line-height:1.65;color:rgba(255,255,255,.8)}
  .sst-result ul{padding-left:1.2rem;display:grid;gap:.4rem}
  .sst-bar-row{margin-bottom:.9rem}
  .sst-bar-label{display:flex;justify-content:space-between;gap:.8rem;font-size:.95rem;margin-bottom:.3rem}
  .sst-bar-label b{color:#fff}
  .sst-bar{height:10px;background:rgba(255,255,255,.1);border-radius:99px;overflow:hidden}
  .sst-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--gold));border-radius:99px}
  .sst-bar-note{font-size:.85rem;color:rgba(255,255,255,.62);margin-top:.25rem}
  .sst-low-group{margin:.8rem 0}
  .sst-low-group h5{font-size:1rem;color:#fff;margin-bottom:.4rem}
  .sst-low-item{border-left:3px solid var(--gold);padding:.4rem .9rem;margin-bottom:.6rem;background:rgba(255,255,255,.03);border-radius:0 10px 10px 0}
  .sst-low-item p{margin-bottom:.25rem}
  .sst-resp{display:grid;gap:.4rem}
  .sst-resp div{display:flex;gap:.7rem;font-size:.92rem;line-height:1.5}
  .sst-resp b{min-width:1.8rem;color:var(--gold)}
  .sst-result .result-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}
  @media(max-width:620px){
    .sst-hero{padding-top:108px}
    .sst-scale{grid-template-columns:1fr;gap:.5rem}
    .sst-scale button{flex-direction:row;justify-content:flex-start;gap:.8rem;padding:.7rem 1rem}
    .sst-quiz,.sst-result{padding:1.1rem}
    .sst-topline{flex-direction:column;gap:.2rem}
  }
</style>

<script>
  // @ts-nocheck
  var dataEl = document.getElementById('sst-data');
  if (dataEl) {
    var D = JSON.parse(dataEl.textContent);
    var Q = D.questions, DOMS = D.domains, DEPTH = D.depth, TOTAL = Q.length;
    var startShell = document.getElementById('start-shell'), quizShell = document.getElementById('quiz-shell'), resultShell = document.getElementById('result-shell');
    var startBtn = document.getElementById('start-button'), nextBtn = document.getElementById('next-button'), backBtn = document.getElementById('back-button');
    var prompt = document.getElementById('question-prompt'), counter = document.getElementById('question-counter'), areaLabel = document.getElementById('area-label');
    var fill = document.getElementById('progress-fill'), track = fill.parentElement, scale = document.getElementById('scale-options');
    var guidanceHref = resultShell.dataset.guidanceHref || '#plans', guidanceLabel = resultShell.dataset.guidanceLabel || 'See guidance plans';
    var current = 0, answers = new Array(TOTAL).fill(null), stage = null;

    function esc(v) { return String(v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function avg(a) { return a.length ? a.reduce(function (x, y) { return x + y; }, 0) / a.length : 0; }
    function itemScore(q, v) { var raw = (v - 1) * 25; return q.reverse ? 100 - raw : raw; }
    function reveal(el, focusEl) { var top = el.getBoundingClientRect().top + window.scrollY - 84; window.scrollTo({ top: Math.max(0, top), behavior: 'instant' }); (focusEl || el).focus({ preventScroll: true }); }
    function lc(t) { return t.charAt(0).toLowerCase() + t.slice(1); }
    function band(score) { return score >= 70 ? 'high' : score >= 45 ? 'mid' : 'low'; }
    function list(items) { return '<ul>' + items.map(function (i) { return '<li>' + esc(i) + '</li>'; }).join('') + '</ul>'; }
    var RATING = { 1: 'Not true', 2: 'Rarely true', 3: 'Sometimes', 4: 'Mostly true', 5: 'Very true' };

    document.querySelectorAll('.sst-stage').forEach(function (b) {
      b.addEventListener('click', function () {
        stage = b.dataset.stage;
        document.querySelectorAll('.sst-stage').forEach(function (x) { x.setAttribute('aria-checked', String(x === b)); });
        startBtn.disabled = false;
        startBtn.textContent = 'Start: ' + TOTAL + ' statements';
      });
    });

    function render() {
      var q = Q[current], pct = Math.round((current + 1) / TOTAL * 100);
      areaLabel.textContent = 'Statement ' + (current + 1);
      counter.textContent = (current + 1) + ' of ' + TOTAL;
      fill.style.width = pct + '%';
      track.setAttribute('aria-valuenow', String(pct));
      prompt.textContent = q.text;
      scale.querySelectorAll('button').forEach(function (b) { b.setAttribute('aria-checked', String(Number(b.dataset.value) === answers[current])); });
      backBtn.disabled = current === 0;
      nextBtn.disabled = answers[current] === null;
      nextBtn.textContent = current === TOTAL - 1 ? 'See my result' : 'Next';
    }

    startBtn.addEventListener('click', function () { if (!stage) return; startShell.hidden = true; quizShell.hidden = false; render(); reveal(quizShell, prompt); });
    scale.querySelectorAll('button').forEach(function (b) { b.addEventListener('click', function () { answers[current] = Number(b.dataset.value); render(); }); });
    backBtn.addEventListener('click', function () { if (current > 0) { current -= 1; render(); prompt.focus({ preventScroll: true }); } });
    nextBtn.addEventListener('click', function () {
      if (answers[current] === null) return;
      if (current < TOTAL - 1) { current += 1; render(); prompt.focus({ preventScroll: true }); } else { showResult(); }
    });

    function showResult() {
      var results = DOMS.map(function (d, order) {
        var scores = [];
        Q.forEach(function (q, i) { if (q.d === d.key) scores.push(itemScore(q, answers[i])); });
        return { d: d, order: order, score: Math.round(avg(scores)), dd: DEPTH.domains[d.key] };
      });
      var overall = Math.round(avg(results.map(function (r) { return r.score; })));
      var ranked = results.slice().sort(function (a, b) { return a.score - b.score || a.order - b.order; });
      var lowest = ranked[0], second = ranked[1], highest = ranked[ranked.length - 1];
      var gap = highest.score - lowest.score;
      var st = DEPTH.stages.filter(function (x) { return x.key === stage; })[0] || DEPTH.stages[0];
      var headline = D.isStudent ? 'Your biggest source of confusion: ' + lc(lowest.d.name) : 'Best place to build first: ' + lc(lowest.d.name);
      var overallText = overall >= 70 ? 'Your answers describe fairly strong habits overall.' : overall >= 45 ? 'Your answers describe a mixed pattern, with some strengths and some gaps.' : 'Your answers show several areas that need attention. That is a starting point, not a verdict.';
      var gapText = gap >= 35 ? 'Your areas differ a lot (' + gap + ' points between your highest and lowest), so focused work on ' + lc(lowest.d.name) + ' should make a clear difference.' : gap >= 15 ? 'Your areas differ moderately (' + gap + ' points). Start with ' + lc(lowest.d.name) + ' and keep ' + lc(highest.d.name) + ' going.' : 'Your areas are close together (' + gap + ' points), so pick the one that matters most for your next step.';

      var bars = results.map(function (r) {
        var b = band(r.score);
        return '<div class="sst-bar-row"><div class="sst-bar-label"><span><b>' + esc(r.d.name) + '</b> - ' + esc(r.d.short) + '</span><span>' + r.score + '%</span></div>' +
          '<div class="sst-bar" aria-hidden="true"><i style="width:' + r.score + '%"></i></div>' +
          '<p class="sst-bar-note">' + esc(D.bands[b]) + ' ' + esc(b === 'low' ? r.d.weak : b === 'high' ? r.d.strong : r.dd.midStep) + '</p></div>';
      }).join('');

      // Statements that scored low, grouped by area, each with its own tip.
      var lowGroups = results.map(function (r) {
        var items = [];
        Q.forEach(function (q, i) { if (q.d === r.d.key && itemScore(q, answers[i]) <= 25) items.push({ q: q, i: i }); });
        if (!items.length) return '';
        return '<div class="sst-low-group"><h5>' + esc(r.d.name) + '</h5>' + items.map(function (it) {
          return '<div class="sst-low-item"><p><b>Statement ' + (it.i + 1) + ':</b> ' + esc(it.q.text) + '</p><p>You answered: ' + esc(RATING[answers[it.i]]) + '. <b>Try this:</b> ' + esc(DEPTH.tips[it.i]) + '</p></div>';
        }).join('') + '</div>';
      }).join('');
      var lowCount = Q.filter(function (q, i) { return itemScore(q, answers[i]) <= 25; }).length;
      var lowSection = lowCount
        ? '<div class="result-section"><h4>Your lowest-rated statements and what to do about each</h4><p>' + lowCount + ' of ' + TOTAL + ' statements scored low. Each one comes with a specific step so you can act on it instead of only reading a score.</p>' + lowGroups + '</div>'
        : '<div class="result-section"><h4>Your lowest-rated statements</h4><p>No statement scored low. That is a strong pattern. The next step is to back it with examples and feedback from other people.</p></div>';

      var strongItems = [];
      Q.forEach(function (q, i) { if (itemScore(q, answers[i]) >= 100) strongItems.push(q.text); });
      var strongSection = '<div class="result-section"><h4>Keep using ' + esc(lc(highest.d.name)) + '</h4><p>' + esc(highest.d.strong) + ' ' + esc(highest.dd.why) + '</p>' +
        (strongItems.length ? '<p>Statements you rated as fully true:</p>' + list(strongItems.slice(0, 6)) : '') +
        '<p>How to use it:</p>' + list(highest.dd.talkingPoints.concat(highest.dd.proof)) + '</div>';

      var nextStep = lowest.d.next ? '<p><a class="btn-gold" href="' + lowest.d.next.href + '">' + esc(lowest.d.next.label) + '</a></p>' : '';
      var deep = '<div class="result-section"><h4>Deep dive: ' + esc(lc(lowest.d.name)) + '</h4><p>' + esc(lowest.dd.why) + '</p>' +
        '<p><b>Your 14-day routine</b></p>' + list(lowest.dd.routine) +
        '<p><b>Common mistakes to avoid</b></p>' + list(lowest.dd.mistakes) +
        '<p><b>How to show progress to others</b></p>' + list(lowest.dd.proof) + nextStep + '</div>';

      var secondSection = '<div class="result-section"><h4>Then work on ' + esc(lc(second.d.name)) + ' (' + second.score + '%)</h4><p>' + esc(second.dd.why) + '</p>' + list(second.d.plan) + '<p><b>One move to try first:</b> ' + esc(second.dd.midStep) + '</p></div>';

      var guide = '<div class="result-section"><h4>Area-by-area guide</h4>' + results.map(function (r) {
        var b = band(r.score);
        return '<p><b>' + esc(r.d.name) + ' (' + r.score + '%):</b> ' + esc(b === 'low' ? r.d.weak : b === 'high' ? r.d.strong : r.d.strong + ' There is still room to grow here.') + ' <b>Next move:</b> ' + esc(r.dd.midStep) + '</p>';
      }).join('') + '</div>';

      var careers = '<div class="result-section"><h4>Where these areas matter</h4><p>' + esc(lowest.d.name) + ' (your lowest area):</p>' + list(lowest.dd.roles) +
        '<p>' + esc(highest.d.name) + ' (your strongest area):</p>' + list(highest.dd.roles) + '</div>';

      var others = '<div class="result-section"><h4>Check your result with other people</h4><p>Self-ratings are one view. Ask someone who knows you well one question per area and compare with your score.</p>' + list(results.map(function (r) { return r.d.name + ': ' + r.dd.askOthers; })) + '</div>';

      var plan = '<div class="result-section"><h4>Your 30-day plan</h4>' + list(DEPTH.thirtyDay) + '</div>';

      var related = '<div class="result-section"><h4>Free next steps</h4><p>These free tools and guides go deeper on what your result points to:</p><ul>' + D.related.map(function (l) { return '<li><a href="' + l.href + '">' + esc(l.title) + '</a>: ' + esc(l.description) + '</li>'; }).join('') + '</ul></div>';

      var neutral = answers.filter(function (v) { return v === 3; }).length, extreme = answers.filter(function (v) { return v === 1 || v === 5; }).length;
      var quality = neutral >= Math.ceil(TOTAL * 0.4)
        ? 'You chose the middle rating on ' + neutral + ' of ' + TOTAL + ' statements. That can mean real uncertainty. Re-read those statements and think of one recent real example for each before relying on the scores.'
        : extreme >= Math.ceil(TOTAL * 0.75)
          ? 'You chose the lowest or highest rating on ' + extreme + ' of ' + TOTAL + ' statements. Check a few of them against real examples, because very strong views about yourself are not always accurate.'
          : 'You used a good spread of ratings (' + neutral + ' middle, ' + extreme + ' at the extremes out of ' + TOTAL + '), which gives the scores more meaning.';
      var qualitySection = '<div class="result-section"><h4>How to read your answer pattern</h4><p>' + esc(quality) + '</p></div>';

      var retake = '<div class="result-section"><h4>When to retake</h4>' + list(['Retake after two to three weeks of practising your lowest area.', 'Compare area by area, not only the overall score.', 'Ask two people who know you well to rate you on the same areas and compare their view with yours.']) + '</div>';
      var limits = '<div class="result-section"><h4>What this result cannot tell you</h4>' + list(D.limits) + '</div>';
      var review = '<div class="result-section"><h4>All your responses</h4><div class="sst-resp">' + Q.map(function (q, i) {
        var dn = DOMS.filter(function (d) { return d.key === q.d; })[0].name;
        return '<div><b>' + (i + 1) + '.</b><span>' + esc(q.text) + ' (' + esc(dn) + ') - ' + esc(RATING[answers[i]]) + '</span></div>';
      }).join('') + '</div></div>';
      var stageSection = '<div class="result-section"><h4>' + esc(st.title) + '</h4><p>' + esc(st.label) + '. ' + esc(st.body) + '</p>' + list(st.actions) + '</div>';

      resultShell.innerHTML =
        '<div class="result-head"><div class="score-mark"><strong>' + overall + '%</strong><span>' + esc(D.scoreLabel) + '</span></div>' +
        '<div><span class="result-kicker">' + esc(D.resultKicker) + '</span><h3>' + esc(headline) + '</h3><p>' + esc(overallText) + ' ' + esc(gapText) + '</p></div></div>' +
        '<div class="result-section"><h4>Your scores by area</h4><p>Scores come only from your own ratings and are not compared with other people.</p>' + bars + '</div>' +
        stageSection + lowSection + deep + secondSection + strongSection + guide + careers + others + plan + related + qualitySection + retake + limits + review +
        '<div class="result-actions"><button id="download-button" type="button" class="sst-btn sst-btn--primary">Download Detailed PDF</button><a href="' + guidanceHref + '" class="btn-gold">' + esc(guidanceLabel) + '</a><button id="retake-button" type="button" class="sst-btn sst-btn--ghost">Retake</button></div>';

      quizShell.hidden = true; resultShell.hidden = false; reveal(resultShell);
      document.getElementById('download-button').addEventListener('click', function () {
        if (window.downloadAssessmentReportPdf) window.downloadAssessmentReportPdf({ container: resultShell, title: D.reportTitle, fileName: D.reportFile });
      });
      document.getElementById('retake-button').addEventListener('click', function () {
        current = 0; answers = new Array(TOTAL).fill(null); resultShell.hidden = true; quizShell.hidden = false; render(); reveal(quizShell, prompt);
      });
    }
  }
</script>
