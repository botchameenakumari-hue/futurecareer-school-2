<section class="epp" id="education-payback-planner" aria-labelledby="epp-title">
  <h2 id="epp-title">Education cost and payback planner</h2>
  <p>Enter the figures your family is considering. The planner adds what you spend to what you give up while studying, then shows how long it may take to earn that money back.</p>
  <p class="epp-note">Everything stays in your browser and nothing is saved or sent. This is a planning model, not a salary or investment forecast.</p>
  <form class="epp-form" id="epp-form" novalidate>
    <div class="epp-ex-slot" id="epp-ex-slot"></div>
    <label for="epp-name">Route or course name (optional)<input id="epp-name" data-epp="name" type="text" maxlength="80" autocomplete="off" placeholder="For example: B.Tech or B.Com"></label>
    <label for="epp-fees">Total tuition and compulsory fees for the whole course (₹)<input id="epp-fees" data-epp="fees" type="text" inputmode="numeric" autocomplete="off" placeholder="400000"></label>
    <label for="epp-years">Course duration (years)<input id="epp-years" data-epp="years" type="text" inputmode="decimal" autocomplete="off" value="3"></label>
    <label for="epp-living">Monthly living and travel cost while studying (₹)<input id="epp-living" data-epp="living" type="text" inputmode="numeric" autocomplete="off" placeholder="6000"><span class="epp-h">Leave empty if the cost is zero.</span></label>
    <label for="epp-opportunity">Monthly income you would earn if you worked instead (₹)<input id="epp-opportunity" data-epp="opportunity" type="text" inputmode="numeric" autocomplete="off" placeholder="0"><span class="epp-h">Use 0 if you would not work at this age. Use your current pay if you are leaving a job to study.</span></label>
    <label for="epp-aid">Scholarship or aid already confirmed (₹)<input id="epp-aid" data-epp="aid" type="text" inputmode="numeric" autocomplete="off" placeholder="0"><span class="epp-h">Count only an award letter you hold.</span></label>
    <label for="epp-income">Expected monthly in-hand pay after the course (₹)<input id="epp-income" data-epp="income" type="text" inputmode="numeric" autocomplete="off" placeholder="30000"><span class="epp-h">The money that reaches the bank, not the package. See the <a href="https://futurecareerschool.com/tools/ctc-to-in-hand-salary-calculator/">CTC to in-hand salary calculator</a>.</span></label>
    <label for="epp-essentials">Monthly essential spending after you start work (₹)<input id="epp-essentials" data-epp="essentials" type="text" inputmode="numeric" autocomplete="off" placeholder="15000"><span class="epp-h">Rent, food, travel, phone, family support.</span></label>
    <div class="epp-actions"><button type="submit">Show my result</button><button type="button" class="epp-secondary" id="epp-reset">Clear</button></div>
    <p id="epp-error" hidden></p>
  </form>
  <div class="epp-results" id="epp-results" aria-live="polite" hidden></div>
</section>

<script>
  import { esc, inr, num1, parseNum, MAX_MONEY, addResultTools, showError, exampleButton, fillFields } from '../scripts/moneyToolKit';

  const form = document.querySelector<HTMLFormElement>('#epp-form');
  const result = document.querySelector<HTMLElement>('#epp-results');
  const errBox = document.querySelector<HTMLElement>('#epp-error');
  const resetBtn = document.querySelector<HTMLButtonElement>('#epp-reset');
  const slot = document.querySelector<HTMLElement>('#epp-ex-slot');
  if (!form || !result || !resetBtn || !slot) throw new Error('Education payback planner markup is incomplete.');
  const field = (key: string) => form.querySelector<HTMLInputElement>(`[data-epp="${key}"]`)!;

  const EXAMPLE = { name: 'Example: 4-year engineering degree', fees: '400000', years: '4', living: '6000', opportunity: '0', aid: '0', income: '30000', essentials: '15000' };
  slot.appendChild(exampleButton('Try an example', 'The example numbers are made up to show how the tool works. They are not real fees or salaries.', () => {
    fillFields(form, (k) => `[data-epp="${k}"]`, EXAMPLE);
    showError(errBox, '');
    form.requestSubmit();
  }));

  const read = (key: string, label: string, opts: { required?: boolean; min?: number; max?: number } = {}): number => {
    const v = parseNum(field(key).value);
    if (v === null) { if (opts.required) throw { msg: `Please fill in: ${label}.`, key }; return 0; }
    if (Number.isNaN(v)) throw { msg: `${label}: please type numbers only, for example 400000.`, key };
    if (v < (opts.min ?? 0)) throw { msg: `${label}: the number cannot be below ${opts.min ?? 0}.`, key };
    if (v > (opts.max ?? MAX_MONEY)) throw { msg: `${label}: this number is too large. Please check it.`, key };
    return v;
  };
  const payback = (amount: number, surplus: number) => {
    if (amount <= 0) return 'Nothing to pay back';
    if (surplus <= 0) return 'Not possible at this pay';
    const m = amount / surplus;
    return m < 24 ? `${num1(m)} months` : `${num1(m / 12)} years`;
  };

  type Run = { name: string; direct: number; exposure: number; surplus: number; pbDirect: string; pbTotal: string; key: string };
  let runs: Run[] = [];
  let lastText = '';

  const compute = () => {
    const fees = read('fees', 'Total tuition and compulsory fees', { required: true });
    const years = read('years', 'Course duration', { required: true, min: 0.25, max: 12 });
    const living = read('living', 'Monthly living and travel cost');
    const opp = read('opportunity', 'Monthly income you would earn instead');
    const aid = read('aid', 'Scholarship or aid');
    const income = read('income', 'Expected monthly in-hand pay after the course', { required: true });
    const essentials = read('essentials', 'Monthly essential spending after you start work');
    const name = field('name').value.trim() || 'This route';

    const months = years * 12;
    const direct = Math.max(0, fees + living * months - aid);
    const opportunity = opp * months;
    const exposure = direct + opportunity;
    const surplus = income - essentials;
    const half = surplus / 2;
    const lower = income * 0.8 - essentials;
    const lateExposure = exposure + essentials * 6;

    let meaning: string;
    if (surplus <= 0) meaning = `At ${inr(income)} in hand and ${inr(essentials)} of essential spending, nothing is left each month, so this route cannot pay itself back on these numbers.`;
    else meaning = `You would spend about ${inr(direct)} on the course${opportunity > 0 ? ` and give up about ${inr(opportunity)} of pay` : ''}. With ${inr(surplus)} left each month after essentials, the ${inr(direct)} comes back in about ${payback(direct, surplus)} of work if every spare rupee goes to it.`;

    const steps: string[] = [];
    if (surplus <= 0) {
      steps.push('Check the pay figure first. Ask two or three people who finished this course in the last few years what they take home in the first year.');
      steps.push('Run a lower-cost course, a part-time route or a work-first route, and compare with the table below.');
      steps.push('Do not take a loan for this route until the monthly surplus is positive on a cautious pay figure.');
    } else {
      steps.push('Check the pay figure. Ask two or three people who finished this course recently what they take home, and use the lowest answer.');
      steps.push('Press Show my result again with a lower pay and a lower-cost course. The table below keeps each run so you can compare.');
      steps.push('If you will borrow, check the EMI with the education loan EMI calculator. The loan interest is not in these numbers.');
    }

    const runKey = JSON.stringify([name, fees, years, living, opp, aid, income, essentials]);
    if (!runs.length || runs[runs.length - 1].key !== runKey) {
      runs.push({ name, direct, exposure, surplus, pbDirect: payback(direct, surplus), pbTotal: payback(exposure, surplus), key: runKey });
      if (runs.length > 4) runs = runs.slice(-4);
    }

    const stress = [
      ['If only half of the spare money goes to repayment', payback(direct, half), half],
      ['If your in-hand pay is 20% lower', payback(direct, lower), lower],
      ['If the first job starts 6 months late (you cover essentials meanwhile)', surplus > 0 ? payback(direct + essentials * 6, surplus) : 'Not possible at this pay', surplus],
    ] as const;

    const lines = [
      `${name}: education cost and payback (a planning estimate)`,
      `Spent on the course: ${inr(direct)} (fees plus living cost, minus aid)`,
      `Pay given up while studying: ${inr(opportunity)}`,
      `Total to compare: ${inr(exposure)}`,
      `Left each month after essentials: ${inr(surplus)}`,
      `Spent money comes back in: ${payback(direct, surplus)}`,
      `Spent money plus pay given up comes back in: ${payback(exposure, surplus)}`,
      '',
      meaning,
      '',
      'Stress tests (illustrations, direct cost only):',
      ...stress.map(([l, v]) => `- ${l}: ${v}`),
      '',
      'Next three steps:',
      ...steps.map((s, i) => `${i + 1}. ${s}`),
      ...(runs.length > 1 ? ['', 'Runs compared this visit:', ...runs.map((r) => `- ${r.name}: spend ${inr(r.direct)}, total ${inr(r.exposure)}, monthly left ${inr(r.surplus)}, payback ${r.pbDirect}`)] : []),
      '',
      'Not counted: tax, inflation, loan interest, job gaps, family help. Free planner: https://futurecareerschool.com/tools/education-cost-payback-planner/',
    ];

    const cell = (l: string, v: string, tone = '') => `<div><span>${esc(l)}</span><strong${tone ? ` class="${tone}"` : ''}>${esc(v)}</strong></div>`;
    const html = `<p class="epp-result-title">${esc(name)}: your result</p>
      <p class="epp-meaning">${esc(meaning)}</p>
      <div class="epp-grid">
        ${cell('Spent on the course', inr(direct))}
        ${cell('Pay given up while studying', inr(opportunity))}
        ${cell('Total to compare', inr(exposure))}
        ${cell('Left each month after essentials', inr(surplus), surplus < 0 ? 'epp-bad' : '')}
        ${cell('Spent money comes back in', payback(direct, surplus))}
        ${cell('Spent money plus pay given up', payback(exposure, surplus))}
      </div>
      <div class="mtk-steps"><h3>Your next three steps</h3><ol>${steps.map((s) => `<li>${esc(s)}</li>`).join('')}</ol></div>
      <h3 class="epp-h3">Stress tests (example scenarios, direct cost only)</h3>
      <div class="mtk-wrap"><table class="mtk-table"><thead><tr><th scope="col">What if</th><th scope="col">Spent money comes back in</th></tr></thead><tbody>${stress.map(([l, v]) => `<tr><td>${esc(l)}</td><td>${esc(v)}</td></tr>`).join('')}</tbody></table></div>
      ${runs.length > 1 ? `<h3 class="epp-h3">Runs you compared this visit</h3><div class="mtk-wrap"><table class="mtk-table"><thead><tr><th scope="col">Route</th><th scope="col">Spent</th><th scope="col">Total</th><th scope="col">Left a month</th><th scope="col">Payback</th></tr></thead><tbody>${runs.map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(inr(r.direct))}</td><td>${esc(inr(r.exposure))}</td><td>${esc(inr(r.surplus))}</td><td>${esc(r.pbDirect)}</td></tr>`).join('')}</tbody></table></div>` : ''}
      <p class="epp-method">Spent on the course = fees + living cost × months studying − aid. Pay given up = monthly pay you would earn × months studying. Payback = money to recover ÷ monthly money left after essentials, counted from the day you start work.</p><p class="epp-method">It leaves out tax, inflation, loan interest, job gaps and family support. Not financial advice.</p>`;
    return { text: lines.join('\n'), html };
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const out = compute();
      showError(errBox, '');
      lastText = out.text;
      result.innerHTML = out.html;
      addResultTools(result, () => lastText, 'My education cost and payback result');
      result.hidden = false;
    } catch (e) {
      const err = e as { msg?: string; key?: string };
      if (!err || !err.msg) throw e;
      result.hidden = true;
      showError(errBox, err.msg, err.key ? field(err.key) : null);
    }
  });
  resetBtn.addEventListener('click', () => { form.reset(); runs = []; result.hidden = true; result.innerHTML = ''; showError(errBox, ''); });
</script>

<style is:global>
  .epp{margin:2.2rem 0;padding:1.4rem;border:1px solid rgba(18,154,141,.42);border-radius:18px;background:rgba(18,154,141,.06)}.epp h2{margin-top:0}.epp p{line-height:1.65}.epp-note,.epp-method{font-size:.86rem;color:rgba(255,255,255,.7)}.epp-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:.9rem;margin:1.1rem 0}.epp-form label{display:grid;gap:.35rem;font-weight:600;font-size:.95rem;align-content:start}.epp-h{font-weight:400;font-size:.82rem;color:rgba(255,255,255,.62);line-height:1.45}.epp-h a{color:#8de4d8}.epp-form input{min-height:44px;width:100%;padding:.5rem .7rem;border-radius:10px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:#fff;font:inherit;font-size:1rem}.epp-ex-slot,#epp-error{grid-column:1/-1}.epp-actions{display:flex;flex-wrap:wrap;gap:.6rem;grid-column:1/-1}.epp-actions button{min-height:44px;border:0;border-radius:10px;background:#e5b84a;color:#17130a;padding:.5rem .95rem;font:inherit;font-weight:800;cursor:pointer}.epp-actions .epp-secondary{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2)}.epp-results{margin-top:1.2rem;padding:1rem;border-radius:14px;background:rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.14)}.epp-result-title{font-weight:800;color:#fff;overflow-wrap:anywhere}.epp-meaning{padding:.8rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.epp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:.7rem}.epp-grid>div{padding:.75rem;border:1px solid rgba(255,255,255,.13);border-radius:10px;min-width:0}.epp-grid span,.epp-grid strong{display:block}.epp-grid span{font-size:.8rem;color:rgba(255,255,255,.62)}.epp-grid strong{margin-top:.35rem;color:#9ff3e6;font-size:1.1rem}.epp-grid strong.epp-bad{color:#ffb4a8}.epp-h3{font-size:1.02rem;margin:1rem 0 .2rem}.epp-form input:focus-visible,.epp-actions button:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}
</style>
