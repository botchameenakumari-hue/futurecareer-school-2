<section class="cpc" id="course-provider-comparison" aria-labelledby="cpc-title">
  <p class="eyebrow">DUE-DILIGENCE WORKSHEET</p>
  <h2 id="cpc-title">Compare a course provider before paying</h2>
  <p>Use the same questions for two or more providers. Record what is official, written, dated, unclear or missing instead of letting branding decide.</p>
  <p class="cpc-note"><b>Limit:</b> this worksheet does not rank providers and does not verify a claim for you. Check the current institution, regulator and programme sources directly.</p>
  <form id="cpc-form" class="cpc-form" novalidate>
    <label>Provider or course name<input name="provider" maxlength="160" placeholder="For your private comparison notes" required /></label>
    <label>Recognition and progression evidence<select name="recognition"><option value="0">Unclear or only a verbal claim</option><option value="1">Some information, not independently checked</option><option value="2">Current official source saved</option><option value="3">Official source plus a second confirmation</option></select></label>
    <label>Complete cost and refund terms<select name="cost"><option value="0">Headline fee only</option><option value="1">Some extras are listed</option><option value="2">Written total and refund terms</option><option value="3">Written, dated and comparable with another provider</option></select></label>
    <label>Practical work and feedback<select name="practice"><option value="0">No clear work or feedback model</option><option value="1">Exercises are described</option><option value="2">Work, review and delivery are clear</option><option value="3">You inspected sample work and feedback details</option></select></label>
    <label>Outcome or placement evidence<select name="outcomes"><option value="0">Guaranteed or vague claim</option><option value="1">Testimonials only</option><option value="2">Method and dates are partly visible</option><option value="3">Comparable, dated evidence with limitations</option></select></label>
    <label>What must you verify next?<textarea name="next" rows="3" maxlength="600" placeholder="Write the missing source, question or document before paying"></textarea></label>
    <div class="cpc-actions"><button class="cpc-primary" type="submit">Create comparison brief</button><button type="button" data-cpc="clear">Clear</button></div>
    <p id="cpc-status" class="cpc-status" role="status" aria-live="polite"></p>
  </form>
  <div id="cpc-result" class="cpc-result" hidden></div>
</section>
<script>
  type CpcField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type CpcForm = Omit<HTMLFormElement, 'querySelectorAll'> & { querySelectorAll(selectors: string): NodeListOf<CpcField> };
  const cpcForm = document.querySelector<HTMLFormElement>('#cpc-form') as CpcForm | null;
  const cpcResult = document.querySelector<HTMLDivElement>('#cpc-result');
  const cpcStatus = document.querySelector<HTMLParagraphElement>('#cpc-status');
  const cpcClear = document.querySelector<HTMLButtonElement>('[data-cpc="clear"]');
  if (!cpcForm || !cpcResult || !cpcStatus || !cpcClear) throw new Error('Course provider comparison markup is incomplete.');
  const cpcEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  cpcForm.addEventListener('submit', (event) => { event.preventDefault(); if (!cpcForm.checkValidity()) { cpcForm.reportValidity(); return; } const data = Object.fromEntries([...cpcForm.querySelectorAll('input,select,textarea')].map((field) => [field.name, field.value])); const checks = [['recognition','recognition and progression'],['cost','complete cost and refund terms'],['practice','practical work and feedback'],['outcomes','outcome evidence']]; const score = checks.reduce((sum, [,key]) => sum + Number(data[key] || 0), 0); const missing = checks.filter(([,key]) => Number(data[key] || 0) < 2).map(([,key]) => key); const signal = score >= 10 ? 'evidence worth comparing carefully' : score >= 6 ? 'incomplete evidence-verify before paying' : 'high decision risk-pause and verify'; cpcResult.innerHTML = `<div class="cpc-lead"><span>${cpcEsc(data.provider)} · comparison signal</span><h3>${cpcEsc(signal)} · ${score}/12</h3><p>This signal describes the evidence you entered, not provider quality or likely outcomes.</p></div><div class="cpc-grid"><article><b>Evidence still needed</b><p>${missing.length ? cpcEsc(missing.join(', ')) : 'No major evidence gap was marked in this worksheet.'}</p></article><article><b>Next written question</b><p>${data.next ? cpcEsc(data.next) : 'Ask for the missing source, total cost or outcome method in writing.'}</p></article></div><div class="cpc-next"><h3>Use the same checklist for a second option</h3><ul><li>Save the official programme, recognition, fee and refund pages with their dates.</li><li>Ask what learners actually submit, who reviews it and how feedback is delivered.</li><li>Separate measured outcomes from testimonials and guaranteed-placement language.</li><li>Do not pay under time pressure when basic identity, recognition or refund terms remain unclear.</li></ul></div>`; cpcResult.hidden = false; cpcStatus.textContent = 'Comparison brief created from your notes; nothing was sent.'; });
  cpcClear.addEventListener('click', () => { cpcForm.reset(); cpcResult.hidden = true; cpcStatus.textContent = 'Cleared.'; });
</script>
<style>
  .cpc{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.cpc h2{margin:.2rem 0 .6rem}.cpc>p{max-width:800px;line-height:1.65}.cpc-note,.cpc-status{color:rgba(255,255,255,.68);font-size:.88rem}.cpc-form{display:grid;gap:1rem;margin-top:1.4rem}.cpc-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.cpc-form input,.cpc-form select,.cpc-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.cpc-actions{display:flex;gap:.6rem;flex-wrap:wrap}.cpc-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.cpc-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.cpc-result{margin-top:1.3rem}.cpc-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.cpc-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.cpc-lead h3{margin:.4rem 0;font-size:1.5rem}.cpc-lead p,.cpc-grid p,.cpc-next li{line-height:1.6;color:rgba(255,255,255,.75)}.cpc-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.cpc-grid article,.cpc-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.cpc-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.cpc-next h3{margin-top:0}@media(max-width:650px){.cpc-grid{grid-template-columns:1fr}}
</style>
