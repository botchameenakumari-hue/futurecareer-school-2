---
const flags = [
  { id: 'guarantee', label: 'They promise a job, a salary or a placement' },
  { id: 'pressure', label: 'They say the offer ends today or the seat will go' },
  { id: 'personal', label: 'They ask for payment to a personal account or a personal UPI ID' },
  { id: 'norefund', label: 'There is no written refund rule' },
  { id: 'recognition', label: 'They cannot name who approves or recognises the course' },
  { id: 'nofee', label: 'The total fee is not given in writing' },
];
---
<section class="cpc" id="course-provider-comparison" aria-labelledby="cpc-title">
  <h2 id="cpc-title">Compare a course provider before paying</h2>
  <p>Fill this in for one provider, press the button, then change the name and the answers for the next provider. Every provider you check stays in one table so you can compare.</p>
  <p class="cpc-note">This worksheet does not rank providers and cannot check a claim for you. Check the official website of the regulator or the college yourself, and get answers in writing.</p>
  <form id="cpc-form" class="cpc-form" novalidate>
    <div id="cpc-ex-slot"></div>
    <div class="cpc-grid2">
      <label for="cpc-provider">Provider and course name<input id="cpc-provider" name="provider" maxlength="160" autocomplete="off" placeholder="For example: Provider A, data analytics course" /></label>
      <label for="cpc-fee">Total fee in writing (₹, optional)<input id="cpc-fee" name="fee" type="text" inputmode="numeric" autocomplete="off" placeholder="60000" /></label>
      <label for="cpc-budget">Money your family keeps for education (₹, optional)<input id="cpc-budget" name="budget" type="text" inputmode="numeric" autocomplete="off" placeholder="600000" aria-describedby="cpc-budget-h" /><span class="cpc-h" id="cpc-budget-h">The whole amount set aside for studies, not only this course. Used for the money check below.</span></label>
    </div>
    <label for="cpc-recognition">Recognition and what the course leads to<select id="cpc-recognition" name="recognition"><option value="0">Unclear, or only a spoken claim</option><option value="1">Some information, not checked by me</option><option value="2">I saved the official source with its date</option><option value="3">Official source and a second confirmation</option></select></label>
    <label for="cpc-cost">Full cost and refund terms<select id="cpc-cost" name="cost"><option value="0">Only the headline fee</option><option value="1">Some extras are listed</option><option value="2">Total and refund rule in writing</option><option value="3">In writing, dated, and I can compare it with another provider</option></select></label>
    <label for="cpc-practice">Practical work and feedback<select id="cpc-practice" name="practice"><option value="0">No clear way of practice or feedback</option><option value="1">Exercises are described</option><option value="2">Work, review and delivery are clear</option><option value="3">I saw sample work and how feedback is given</option></select></label>
    <label for="cpc-outcomes">Evidence of what past learners achieved<select id="cpc-outcomes" name="outcomes"><option value="0">A guarantee or a vague claim</option><option value="1">Testimonials only</option><option value="2">The method and dates are partly shown</option><option value="3">Dated evidence I can compare, with its limits</option></select></label>
    <fieldset class="cpc-flags">
      <legend>Tick anything that has happened</legend>
      {flags.map((f) => (
        <label class="cpc-check" for={`cpc-flag-${f.id}`}><input id={`cpc-flag-${f.id}`} type="checkbox" name="flag" value={f.id} data-label={f.label} /><span>{f.label}</span></label>
      ))}
    </fieldset>
    <label for="cpc-next">What will you check next? (optional)<textarea id="cpc-next" name="next" rows="3" maxlength="600" placeholder="The missing paper, answer or document before you pay"></textarea></label>
    <div class="cpc-actions"><button class="cpc-primary" type="submit">Add this provider to my comparison</button><button type="button" data-cpc="clear">Clear everything</button></div>
    <p id="cpc-error" hidden></p>
    <p id="cpc-status" class="cpc-status" role="status" aria-live="polite"></p>
  </form>
  <div id="cpc-result" class="cpc-result" hidden></div>
</section>
<script>
  import { esc, inr, num1, parseNum, MAX_MONEY, addResultTools, copyText, showError, exampleButton, fillFields } from '../scripts/moneyToolKit';

  const form = document.querySelector<HTMLFormElement>('#cpc-form');
  const result = document.querySelector<HTMLDivElement>('#cpc-result');
  const status = document.querySelector<HTMLParagraphElement>('#cpc-status');
  const errBox = document.querySelector<HTMLElement>('#cpc-error');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-cpc="clear"]');
  const slot = document.querySelector<HTMLElement>('#cpc-ex-slot');
  if (!form || !result || !status || !clearBtn || !slot) throw new Error('Course provider comparison markup is incomplete.');
  const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`)!;
  const flagBoxes = () => [...form.querySelectorAll<HTMLInputElement>('input[name="flag"]')];

  slot.appendChild(exampleButton('Try an example', 'The example is made up to show how the tool works. It is not a real provider or fee.', () => {
    fillFields(form, (k) => `[name="${k}"]`, { provider: 'Example: Provider A, data analytics certificate', fee: '60000', budget: '600000', recognition: '1', cost: '1', practice: '2', outcomes: '0', next: 'Ask for the refund rule and a sample of learner work' });
    flagBoxes().forEach((c) => { c.checked = ['guarantee', 'pressure'].includes(c.value); });
    showError(errBox, '');
    form.requestSubmit();
  }));

  const CHECKS: [string, string][] = [['recognition', 'recognition'], ['cost', 'full cost and refund terms'], ['practice', 'practical work and feedback'], ['outcomes', 'outcome evidence']];
  type Run = { provider: string; fee: number; ratio: number | null; score: number; flags: number; weakest: string; key: string };
  let runs: Run[] = [];
  let lastText = '';
  let messageText = '';

  const readMoney = (key: string, label: string): number => {
    const v = parseNum(field(key).value);
    if (v === null) return 0;
    if (Number.isNaN(v)) throw { msg: `${label}: please type numbers only, for example 60000.`, key };
    if (v < 0) throw { msg: `${label}: the number cannot be below 0.`, key };
    if (v > MAX_MONEY) throw { msg: `${label}: this number is too large. Please check it.`, key };
    return v;
  };

  const compute = () => {
    const provider = field('provider').value.trim();
    if (!provider) throw { msg: 'Please type the provider and course name, so you can tell the providers apart later.', key: 'provider' };
    const fee = readMoney('fee', 'Total fee');
    const budget = readMoney('budget', 'Education money');
    const vals = CHECKS.map(([k]) => { const v = Number(field(k).value); return Number.isInteger(v) && v >= 0 && v <= 3 ? v : 0; });
    const score = vals.reduce((a, b) => a + b, 0);
    const flagged = flagBoxes().filter((c) => c.checked).map((c) => c.dataset.label || c.value);
    const missing = CHECKS.filter((_, i) => vals[i] < 2).map(([, label]) => label);
    const next = field('next').value.trim();
    const weakest = missing.length ? missing[0] : 'none';
    const signal = flagged.length >= 2 || score <= 5 ? 'High risk: pause and check before you pay' : flagged.length === 1 || score <= 9 ? 'Evidence is incomplete: check before you pay' : 'Evidence worth comparing carefully';

    let ratio: number | null = null;
    let moneyLine = '';
    if (fee > 0 && budget > 0) {
      ratio = fee / budget;
      const pct = num1(ratio * 100);
      if (ratio <= 0.1) moneyLine = `This fee is ${pct}% of your education money, which is within our suggestion of about a tenth. Keep the rest for tools, practice and a reserve.`;
      else if (ratio <= 0.2) moneyLine = `This fee is ${pct}% of your education money. Our suggestion is to keep a fee near a tenth, so ask for course-specific proof before you go above it.`;
      else moneyLine = `This fee is ${pct}% of your education money. Above about a fifth is a caution: only go ahead with strong proof for this exact course, and look at free or low-priced options first.`;
    } else if (fee > 0) {
      moneyLine = `The fee is ${inr(fee)}. Add your education money to see how large a share it is. Our suggestion is to keep a fee near a tenth of it.`;
    }

    const key = JSON.stringify([provider, fee, budget, ...vals, flagged]);
    if (!runs.length || runs[runs.length - 1].key !== key) {
      runs.push({ provider, fee, ratio, score, flags: flagged.length, weakest, key });
      if (runs.length > 4) runs = runs.slice(-4);
    }

    const steps: string[] = [];
    if (flagged.length) steps.push('Do not pay yet. Several things you ticked are warning signs. Pay only to the institution\'s own official account, never to a person, and get a receipt.');
    else steps.push('Do not pay under time pressure. A genuine provider will wait while you check the papers.');
    steps.push(missing.length ? `Ask the provider, in writing, for what is missing: ${missing.join(', ')}. Use the message below.` : 'Compare the written fee, refund rule and recognition with one other provider before you decide.');
    steps.push('Check who approves or recognises the course on that body\'s own website, for example UGC for universities, AICTE for technical courses, or the awarding body named on a skills certificate. Save the page with its date.');

    messageText = `Hello, I am considering ${provider}. Please reply in writing to these points:\n1. The total fee, with GST and every compulsory extra.\n2. The refund rule if I leave or the batch does not start.\n3. Who approves or recognises this course, and where I can check it.\n4. What I will make during the course, who reviews it and how feedback is given.\n5. How you measure learners' results, for which batch and which dates.\nThank you.`;

    const lines = [
      `${provider}: course provider check`,
      `Signal: ${signal}`,
      `Evidence score: ${score} of 12 (recognition ${vals[0]}, cost ${vals[1]}, practice ${vals[2]}, outcomes ${vals[3]} out of 3)`,
      ...(flagged.length ? ['Warning signs ticked:', ...flagged.map((f) => `- ${f}`)] : ['No warning signs ticked.']),
      ...(moneyLine ? ['', moneyLine] : []),
      '',
      'Next three steps:',
      ...steps.map((s, i) => `${i + 1}. ${s}`),
      ...(next ? ['', `I will check next: ${next}`] : []),
      ...(runs.length > 1 ? ['', 'Providers compared this visit:', ...runs.map((r) => `- ${r.provider}: fee ${r.fee ? inr(r.fee) : 'not entered'}, evidence ${r.score} of 12, warning signs ${r.flags}`)] : []),
      '',
      'Not a ranking of providers. Free worksheet: https://futurecareerschool.com/tools/course-provider-comparison/',
    ];

    const html = `<div class="cpc-lead"><span>${esc(provider)}</span><h3>${esc(signal)}</h3><p>Evidence score ${score} of 12 and ${flagged.length} warning sign${flagged.length === 1 ? '' : 's'}. This describes the evidence you entered, not how good the provider is or what you will earn.</p></div>
      ${flagged.length ? `<div class="cpc-bad"><b>Warning signs you ticked</b><ul>${flagged.map((f) => `<li>${esc(f)}</li>`).join('')}</ul></div>` : ''}
      ${moneyLine ? `<div class="cpc-money"><b>Money check before you pay</b><p>${esc(moneyLine)}</p><p class="cpc-small">An illustration, not a real fee: with ₹6,00,000 kept for education, a fee near ₹60,000 is a tenth, and ₹1,20,000 is a fifth. Free lessons on YouTube and low-priced courses on sites like Udemy or Coursera need little budget care, and the same subject sold as a university certificate can cost many times more.</p></div>` : ''}
      <div class="mtk-steps"><h3>Your next three steps</h3><ol>${steps.map((s) => `<li>${esc(s)}</li>`).join('')}</ol></div>
      <div class="cpc-msg"><h3>Message to send the provider</h3><pre>${esc(messageText)}</pre><button type="button" class="mtk-btn" data-cpc-msg="copy">Copy this message</button><span class="mtk-msg" role="status" aria-live="polite" id="cpc-msg-status"></span></div>
      ${next ? `<p class="cpc-small"><b>You will check next:</b> ${esc(next)}</p>` : ''}
      ${runs.length > 1 ? `<h3 class="cpc-h3">Providers you compared this visit</h3><div class="mtk-wrap"><table class="mtk-table"><thead><tr><th scope="col">Provider</th><th scope="col">Fee</th><th scope="col">Evidence</th><th scope="col">Warning signs</th><th scope="col">Weakest</th></tr></thead><tbody>${runs.map((r) => `<tr><td>${esc(r.provider)}</td><td>${r.fee ? esc(inr(r.fee)) : 'not entered'}</td><td>${r.score} of 12</td><td>${r.flags}</td><td>${esc(r.weakest)}</td></tr>`).join('')}</tbody></table></div>` : '<p class="cpc-small">To compare, change the name and answers for the next provider and press the button again. Both appear in a table here.</p>'}
      <p class="cpc-small">Not covered: whether the teaching is good, or whether the course suits you. Ask learners who finished it recently, and for a big fee talk to a counsellor or someone who works in the field.</p>`;
    return { text: lines.join('\n'), html };
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const out = compute();
      showError(errBox, '');
      lastText = out.text;
      result.innerHTML = out.html;
      addResultTools(result, () => lastText, 'My course provider check');
      const mb = result.querySelector<HTMLButtonElement>('[data-cpc-msg="copy"]');
      const ms = result.querySelector<HTMLElement>('#cpc-msg-status');
      if (mb && ms) mb.addEventListener('click', async () => { ms.textContent = (await copyText(messageText)) ? 'Message copied. Paste it into WhatsApp or email.' : 'Copy did not work. Select the text and copy it by hand.'; });
      result.hidden = false;
      status.textContent = 'Added to your comparison. Nothing was sent anywhere.';
    } catch (e) {
      const err = e as { msg?: string; key?: string };
      if (!err || !err.msg) throw e;
      result.hidden = true;
      showError(errBox, err.msg, err.key ? field(err.key) : null);
      status.textContent = '';
    }
  });
  clearBtn.addEventListener('click', () => { form.reset(); runs = []; result.hidden = true; result.innerHTML = ''; showError(errBox, ''); status.textContent = 'Cleared.'; });
</script>
<style is:global>
  .cpc{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.cpc h2{margin:.2rem 0 .6rem}.cpc>p{max-width:800px;line-height:1.65}.cpc-note,.cpc-status{color:rgba(255,255,255,.68);font-size:.88rem}.cpc-form{display:grid;gap:1rem;margin-top:1.2rem}.cpc-grid2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.cpc-form label{display:grid;gap:.4rem;font-weight:650;font-size:.95rem;align-content:start}.cpc-h{font-weight:400;font-size:.82rem;color:rgba(255,255,255,.62);line-height:1.45}.cpc-form input:not([type=checkbox]),.cpc-form select,.cpc-form textarea{width:100%;min-height:44px;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.25);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-size:1rem;font-weight:400}.cpc-form select option{color:#111}.cpc-flags{margin:0;padding:.9rem;border:1px solid rgba(255,138,128,.4);border-radius:12px;display:grid;gap:.2rem}.cpc-flags legend{padding:0 .4rem;font-weight:700}.cpc-form label.cpc-check{display:flex;gap:.7rem;align-items:flex-start;min-height:44px;padding:.35rem 0;font-weight:400;line-height:1.45;cursor:pointer}.cpc-check input{flex:0 0 24px;width:24px;height:24px;margin-top:.1rem;accent-color:#ff8a80}.cpc-actions{display:flex;gap:.6rem;flex-wrap:wrap}.cpc-actions button{min-height:44px;padding:.55rem .95rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.cpc-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.cpc-result{margin-top:1.3rem}.cpc-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.cpc-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;overflow-wrap:anywhere}.cpc-lead h3{margin:.4rem 0;font-size:1.4rem}.cpc-lead p,.cpc-money p,.cpc-bad li{line-height:1.6;color:rgba(255,255,255,.78)}.cpc-bad,.cpc-money,.cpc-msg{margin-top:.8rem;padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.cpc-bad{border-color:rgba(255,138,128,.5);background:rgba(255,138,128,.07)}.cpc-money{border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.cpc-msg h3,.cpc-h3{margin:.1rem 0 .4rem;font-size:1.02rem}.cpc-msg pre{white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 .6rem;padding:.7rem;border-radius:8px;background:rgba(0,0,0,.25);font:inherit;font-size:.9rem;line-height:1.55;color:rgba(255,255,255,.85)}.cpc-small{margin-top:.8rem;font-size:.88rem;line-height:1.6;color:rgba(255,255,255,.72)}@media(max-width:650px){.cpc{padding:1.1rem}.cpc-grid2{grid-template-columns:1fr}}
</style>
