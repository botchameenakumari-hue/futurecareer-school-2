---
const category = Astro.url.pathname.split('/').filter(Boolean)[1] ?? 'career-guidance';
const copy: Record<string, { file: string; alt: string; caption: string; supportFile: string; supportAlt: string; supportCaption: string }> = {
  'ai-future': { file: 'ai-future-editorial-cover.webp', alt: 'Indian professional considering how AI is changing work and skills', caption: 'AI changes the task mix; human judgment turns the change into a career decision.', supportFile: 'ai-future-editorial-support.webp', supportAlt: 'Notebook showing the relationship between an AI task, human judgment, and career proof', supportCaption: 'The practical question is not whether AI exists; it is what human judgment and proof remain valuable.' },
  'career-change': { file: 'career-change-editorial-cover.webp', alt: 'Indian professional planning a deliberate career change', caption: 'A career change becomes safer when the next capability is tested before the old path is abandoned.', supportFile: 'career-change-editorial-support.webp', supportAlt: 'Paper bridge connecting an existing work identity to a new skill path', supportCaption: 'Transferable strengths, small tests, and evidence make a career change more deliberate.' },
  'career-guidance': { file: 'career-guidance-editorial-cover.webp', alt: 'Career decision notes and realistic options arranged on a desk', caption: 'Good career guidance makes trade-offs visible before they become expensive.', supportFile: 'career-guidance-editorial-support.webp', supportAlt: 'Compass surrounded by career decision cards for fit, market, skills, and proof', supportCaption: 'A useful decision weighs fit, market reality, skill-building, and proof together.' },
  'career-options': { file: 'career-options-editorial-cover.webp', alt: 'Several Indian career routes represented by real work objects on a table', caption: 'Compare the work and the skill portfolio, not only the course label.', supportFile: 'career-options-editorial-support.webp', supportAlt: 'Three career route cards compared through fit, effort, outcome, and proof', supportCaption: 'Good options become clearer when the route is compared by work, effort, outcome, and proof.' },
  'college-degrees': { file: 'college-degrees-editorial-cover.webp', alt: 'Indian graduate weighing a degree against practical skills and opportunity', caption: 'A degree is a starting point; capability and proof shape the opportunity that follows.', supportFile: 'college-degrees-editorial-support.webp', supportAlt: 'Degree materials, a practical prototype, and a portfolio connected as a capability chain', supportCaption: 'The useful chain is degree, capability, evidence, and opportunity—not the credential alone.' },
  'freelancing-business': { file: 'freelancing-business-editorial-cover.webp', alt: 'Indian freelancer assembling a client project and portfolio at home', caption: 'A service becomes a business when useful capability is packaged and proven.', supportFile: 'freelancing-business-editorial-support.webp', supportAlt: 'Freelance business sequence from a client problem to an offer, delivery, and repeat work', supportCaption: 'Freelancing becomes more durable when a real problem is matched to a clear offer and repeatable delivery.' },
  'government-jobs': { file: 'government-jobs-editorial-cover.webp', alt: 'Indian graduate comparing public-service preparation with private-sector work', caption: 'Prestige, stability, income, and fit belong in the same decision.', supportFile: 'government-jobs-editorial-support.webp', supportAlt: 'Balanced comparison of career stability, income, time, and fit', supportCaption: 'Career choices improve when stability, income, time, and fit are considered together.' },
  'interviews': { file: 'interviews-editorial-cover.webp', alt: 'Indian fresher preparing an interview portfolio on a real desk', caption: 'The strongest interview answers are backed by work you can show.', supportFile: 'interviews-editorial-support.webp', supportAlt: 'Interview notebook organized around a claim, example, evidence, and reflection', supportCaption: 'A clear answer connects a claim to a concrete example, evidence, and reflection.' },
  'job-search': { file: 'job-search-editorial-cover.webp', alt: 'Indian graduate building a structured first-job search plan', caption: 'A job search gets stronger when applications are connected to evidence.', supportFile: 'job-search-editorial-support.webp', supportAlt: 'Focused job search sequence from target roles to proof, application, and learning', supportCaption: 'A focused search links target roles to proof, tailored applications, and feedback.' },
  'linkedin-networking': { file: 'linkedin-networking-editorial-cover.webp', alt: 'Indian professional preparing real project evidence for an online profile', caption: 'Credibility online is built from useful work, not an inflated profile.', supportFile: 'linkedin-networking-editorial-support.webp', supportAlt: 'Professional networking sequence connecting work, signal, conversation, and opportunity', supportCaption: 'Useful work creates a signal; thoughtful conversations turn that signal into opportunity.' },
  'medical-careers': { file: 'medical-careers-editorial-cover.webp', alt: 'Indian healthcare student comparing medical and allied-health career paths', caption: 'Healthcare offers more than one route to meaningful, skilled work.', supportFile: 'medical-careers-editorial-support.webp', supportAlt: 'Healthcare career materials showing laboratory, patient-care, coding, and course routes', supportCaption: 'Healthcare careers can be compared by the work, setting, training, and responsibility each route involves.' },
  'parents': { file: 'parents-editorial-cover.webp', alt: 'Indian parent and teenager having a calm career conversation', caption: 'The best parent conversation replaces pressure with evidence and a next step.', supportFile: 'parents-editorial-support.webp', supportAlt: 'Parent and student career conversation organized around listening, comparison, testing, and support', supportCaption: 'Support works best when it makes room to listen, compare, test, and move forward.' },
  'portfolio-proof-of-work': { file: 'portfolio-proof-of-work-editorial-cover.webp', alt: 'Real project samples and feedback being assembled into a portfolio', caption: 'Proof makes a skill portable across applications, clients, and roles.', supportFile: 'portfolio-proof-of-work-editorial-support.webp', supportAlt: 'Project brief, draft, feedback, and finished artifact arranged as proof of work', supportCaption: 'A portfolio becomes persuasive when it shows the brief, the work, the feedback, and the result.' },
  'resume': { file: 'resume-editorial-cover.webp', alt: 'Indian fresher improving a resume beside project evidence', caption: 'A resume is strongest when every important claim points to proof.', supportFile: 'resume-editorial-support.webp', supportAlt: 'Resume notes connecting a claim to a project, result, and link', supportCaption: 'Strong resume writing connects a claim to a project, a result, and proof someone can inspect.' },
  'skill-roadmaps': { file: 'skill-roadmaps-editorial-cover.webp', alt: 'Learner building a structured skill roadmap with milestones and work samples', caption: 'A roadmap turns learning into a sequence of testable, visible moves.', supportFile: 'skill-roadmaps-editorial-support.webp', supportAlt: 'Skill roadmap organized from baseline through a sprint, artifact, and review', supportCaption: 'A useful roadmap moves from a baseline to focused practice, a visible artifact, and review.' },
  'skills': { file: 'skills-editorial-cover.webp', alt: 'Indian learner practising a high-value skill with a real work draft', caption: 'High-value skills grow through focused practice tied to real problems.', supportFile: 'skills-editorial-support.webp', supportAlt: 'Skill-building sequence from learning and practice to verification and showing the work', supportCaption: 'Learning compounds when practice is verified and turned into work other people can see.' },
  'stream-selection': { file: 'stream-selection-editorial-cover.webp', alt: 'Indian senior-school student comparing science, commerce, and arts materials', caption: 'A stream is a starting point, not a complete career decision.', supportFile: 'stream-selection-editorial-support.webp', supportAlt: 'School stream decision cards comparing interest, ability, options, and evidence', supportCaption: 'Stream selection is stronger when interest and ability are tested against real options and evidence.' },
  'study-abroad': { file: 'study-abroad-editorial-cover.webp', alt: 'Indian student and parent comparing study-abroad costs, outcomes, and fit', caption: 'Study abroad is a decision about cost, outcome, risk, and fit—not a default upgrade.', supportFile: 'study-abroad-editorial-support.webp', supportAlt: 'Study-abroad decision materials comparing cost, outcome, risk, and fit', supportCaption: 'A study-abroad choice deserves a clear comparison of cost, outcome, risk, and personal fit.' },
};
const selected = copy[category] ?? copy['career-guidance'];
const categorySupportExtensions: Record<string, { file: string; alt: string; caption: string }[]> = {
  'ai-future': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'ai-future-proof.webp', alt: 'AI career decision desk separating routine tasks, human judgment, and proof of work', caption: 'The valuable move is to separate routine tasks from judgment and build proof around the part people still trust.' },
    { file: 'ai-future-assistant.webp', alt: 'Indian professional checking an AI assistant output against notes and real evidence', caption: 'AI becomes leverage when a professional can question, verify, and improve its output.' },
    { file: 'ai-future-portfolio.webp', alt: 'Editorial skill portfolio connecting domain skill, AI fluency, human trust, and a work sample', caption: 'A resilient portfolio combines domain depth, AI fluency, human trust, and visible work.' },
    { file: 'ai-future-experiment.webp', alt: 'Career experiment sequence from noticing a change to testing, showing, and reflecting on work', caption: 'Small experiments turn a vague fear about AI into a practical next skill and a piece of evidence.' },
  ],
  'career-guidance': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'career-guidance-framework.webp', alt: 'Career guidance framework comparing person, options, market, skills, and money', caption: 'Good guidance makes the person, options, market, skills, and money visible in one decision.' },
    { file: 'career-guidance-conversation.webp', alt: 'Indian career counsellor listening to a student beside notes and work samples', caption: 'A useful conversation starts with listening to the person’s reality, not handing over a generic course list.' },
    { file: 'career-guidance-experiment.webp', alt: 'Career decision sequence from a question to an experiment, proof, and opportunity', caption: 'A decision becomes clearer when a question is tested through a small experiment and visible proof.' },
    { file: 'career-guidance-evidence.webp', alt: 'Indian learner comparing job descriptions, a project artifact, and a learning plan', caption: 'Real job descriptions and real work samples turn abstract career advice into evidence.' },
  ],
  'career-change': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'career-change-bridge.webp', alt: 'Career change bridge from a current role through transferable skills to a next role', caption: 'A deliberate switch starts by naming what can travel from the current role to the next one.' },
    { file: 'career-change-mapping.webp', alt: 'Indian professional mapping transferable skills beside a real project sample', caption: 'Transferable skills become credible when they are connected to work someone can inspect.' },
    { file: 'career-change-sequence.webp', alt: 'Career switch sequence from reality and skill gap to a small test and proof', caption: 'The safest sequence is reality, skill gap, small test, proof, then a larger move.' },
    { file: 'career-change-experiment.webp', alt: 'Indian professional conducting a low-risk career experiment at a real desk', caption: 'A low-risk experiment tests the daily work before an irreversible resignation.' },
  ],
  'parents': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'parents-listen.webp', alt: 'Indian parent and student sharing a calm career decision notebook at home', caption: 'Listening first gives the family a better starting point than repeating a preferred answer.' },
    { file: 'parents-conversation.webp', alt: 'Indian parent listening calmly while a teenager explains a career idea', caption: 'A useful parent conversation leaves room for the student to explain the work, not only the degree.' },
    { file: 'parents-framework.webp', alt: 'Family career decision framework comparing fit, cost, demand, and skills', caption: 'Fit, cost, demand, and skills make a family decision concrete without turning it into pressure.' },
    { file: 'parents-compare.webp', alt: 'Parent and student comparing a small project, job postings, and a course budget', caption: 'A project, real postings, and a budget create shared evidence before a large commitment.' },
  ],
  'career-options': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'career-options-work.webp', alt: 'Career options compared through daily work, skills, demand, and proof', caption: 'Compare options by the work and skill portfolio they require, not only by the course label.' },
    { file: 'career-options-compare.webp', alt: 'Indian student comparing several career paths through the work each involves', caption: 'The daily work is the most useful test of whether an option deserves more research.' },
    { file: 'career-options-framework.webp', alt: 'Career options framework comparing daily work, training, market, and upside', caption: 'Training, market, and upside become clearer when they are placed beside the daily work.' },
    { file: 'career-options-test.webp', alt: 'Indian learner testing a career option through a small real project', caption: 'A small project turns a promising option into something the learner can actually test.' },
  ],
  'college-degrees': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'college-degrees-chain.webp', alt: 'Degree-to-opportunity chain connecting credential, capability, proof, and opportunity', caption: 'A degree is valuable when it connects to capability, proof, and a real opportunity.' },
    { file: 'college-degrees-compare.webp', alt: 'Indian student and parent comparing colleges through placement data, projects, cost, and commute', caption: 'College comparison should include outcome evidence and total cost, not only reputation.' },
    { file: 'college-degrees-proof.webp', alt: 'Degree pathway diagram linking credential, skill, project, feedback, and role', caption: 'The credential becomes stronger when each year also produces a skill, project, and feedback loop.' },
    { file: 'college-degrees-portfolio.webp', alt: 'Indian learner building a portfolio artifact alongside coursework and internship notes', caption: 'A portfolio makes the capability underneath the degree visible to employers and clients.' },
  ],
  'freelancing-business': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'freelancing-business-sequence.webp', alt: 'Freelance business sequence from a client problem to an offer, delivery, and repeat work', caption: 'A freelance business becomes durable when a real problem is matched to a clear offer and repeatable delivery.' },
    { file: 'freelancing-business-offer.webp', alt: 'Indian freelancer turning a client brief into a clear service offer', caption: 'A clear offer translates a useful capability into something a client can understand and buy.' },
    { file: 'freelancing-business-proof.webp', alt: 'Freelance credibility chain connecting skill, sample, result, and testimonial', caption: 'Samples, results, and testimonials make an independent service easier to trust.' },
    { file: 'freelancing-business-delivery.webp', alt: 'Indian independent consultant reviewing feedback while delivering a client project', caption: 'The work after the sale—delivery, feedback, and improvement—is where repeat work is earned.' },
  ],
  'job-search': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'job-search-sequence.webp', alt: 'Focused job-search sequence from a target role to proof, application, feedback, and interview', caption: 'A focused search connects target roles to proof, tailored applications, feedback, and conversations.' },
    { file: 'job-search-research.webp', alt: 'Indian graduate matching real job descriptions to project evidence', caption: 'Real job descriptions show which evidence and skills an application needs to surface.' },
    { file: 'job-search-loop.webp', alt: 'Job-search loop connecting target, evidence, application, conversation, and learning', caption: 'Each application should produce learning that improves the next one.' },
    { file: 'job-search-interview.webp', alt: 'Indian fresher preparing an interview story from a real project and evidence', caption: 'The strongest interview story is anchored in work the candidate can actually show.' },
  ],
  'resume': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'resume-proof.webp', alt: 'Resume claim connected to a project, result, and inspectable proof', caption: 'A strong resume claim points to work, a result, and proof someone can inspect.' },
    { file: 'resume-editing.webp', alt: 'Indian fresher improving a resume beside project evidence and feedback notes', caption: 'Editing is easier when every line is tested against real evidence.' },
    { file: 'resume-sequence.webp', alt: 'Resume sequence from claim and action to result and proof', caption: 'The useful structure is claim, action, result, and proof—not a list of duties.' },
    { file: 'resume-select.webp', alt: 'Indian job seeker selecting relevant projects for a focused resume', caption: 'Relevance beats volume: select the few projects that support the target role.' },
  ],
  'skills': [
    { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
    { file: 'skills-stack.webp', alt: 'Skill portfolio stack connecting a core skill, multiplier, practice, and proof', caption: 'A high-value skill becomes more useful when a multiplier and visible proof sit beside it.' },
    { file: 'skills-practice.webp', alt: 'Indian learner practising a high-value skill on a real problem with a draft artifact', caption: 'Practice compounds faster when it is tied to a real problem rather than passive consumption.' },
    { file: 'skills-roadmap.webp', alt: 'Skill-building roadmap from baseline through a focused sprint, artifact, and review', caption: 'A roadmap should move from a baseline to focused practice, an artifact, and review.' },
    { file: 'skills-feedback.webp', alt: 'Indian learner showing a finished work sample to a mentor for feedback', caption: 'Feedback turns a private exercise into a stronger, more market-ready capability.' },
  ],
};
const supportVisuals = categorySupportExtensions[category] ?? [
  { file: selected.supportFile, alt: selected.supportAlt, caption: selected.supportCaption },
];
const articlePath = Astro.url.pathname.split('/').filter(Boolean);
const excludedPillarSlugs = new Set([
  'career-options-after-12th-science', 'career-options-after-12th-commerce', 'career-options-after-10th', 'best-career-options-with-high-salary',
  'what-career-should-i-choose', 'how-to-find-the-right-career-for-me-india', 'how-to-choose-a-career-after-12th',
  'best-courses-after-12th-for-high-salary-india', 'best-mba-specializations-india', 'career-after-bcom-in-india',
  'best-skills-for-high-salary-in-india', 'high-income-skills-without-a-degree-india', 'how-to-become-a-data-scientist-india',
  'cybersecurity-roadmap-india', 'full-stack-developer-roadmap-india', 'how-to-get-a-job-without-experience-india',
  'first-job-after-graduation-india', 'resume-tips-for-freshers-india', 'good-career-objective-for-resume',
  'interview-preparation-for-freshers-india', 'linkedin-profile-tips-for-freshers-india', 'govt-vs-private-job-india',
  'government-jobs-after-engineering-india', 'banking-sector-career-india', 'careers-that-will-survive-ai-india',
  'ai-and-human-skills-needed-india', 'artificial-intelligence-career-paths', 'how-to-start-freelancing',
  'best-freelance-skills-in-demand-india', 'freelancing-vs-job-india-which-is-better', 'career-change-at-30-india',
  'career-change-after-5-years-india', 'scholarships-for-study-abroad-india', 'is-ms-in-usa-worth-it-india',
  'canada-vs-germany-for-masters-india', 'career-options-in-medical-field-other-than-doctor-india',
  'best-paramedical-courses-scope-in-india', 'medical-coding-career-india'
]);
const isArticle = articlePath.length >= 3 && !excludedPillarSlugs.has(articlePath.at(-1) ?? '');
---
{isArticle && (
  <div class="blog-fallback-visual-group" data-blog-fallback-group>
    <figure class="blog-fallback-visual">
      <img src={`/images/blog/category/${selected.file}`} alt={selected.alt} title={selected.alt} width="1600" height="1000" loading="lazy" decoding="async" />
      <figcaption>{selected.caption}</figcaption>
    </figure>
    {supportVisuals.map((visual) => (
      <figure class="blog-fallback-visual">
        <img src={`/images/blog/category/${visual.file}`} alt={visual.alt} title={visual.alt} width="1600" height="1000" loading="lazy" decoding="async" />
        <figcaption>{visual.caption}</figcaption>
      </figure>
    ))}
  </div>
)}
<style>
  .blog-fallback-visual-group { display: none; }
  .blog-fallback-visual-group.is-visible { display: block; }
  .blog-fallback-visual { margin: 1.8rem 0 2.2rem; }
  .blog-fallback-visual img { width: 100%; height: auto; display: block; border-radius: 18px; border: 1px solid rgba(255,255,255,.1); }
  .blog-fallback-visual figcaption { margin-top: .6rem; color: rgba(255,255,255,.52); font-size: 12px; line-height: 1.55; }
  .blog-fallback-visual.is-visible { display: block; }
</style>
