<section class="crc" id="career-change-runway-calculator" aria-labelledby="crc-title">
  <p class="eyebrow">ASSUMPTION-BASED CALCULATOR</p>
  <h2 id="crc-title">Estimate a transition runway</h2>
  <p>Use conservative figures to see how long your savings might cover the gap between essential monthly costs and reliable income while you test a career change.</p>
  <p class="crc-note"><b>Important:</b> this is arithmetic, not financial advice or permission to resign. Keep taxes, debt, dependants, healthcare and an emergency reserve outside the optimistic case.</p>
  <form id="crc-form" class="crc-form" novalidate>
    <div class="crc-grid">
      <label>Accessible savings for the transition (₹)<input name="savings" type="number" min="0" step="1000" placeholder="300000" required /></label>
      <label>Essential monthly expenses (₹)<input name="expenses" type="number" min="0" step="500" placeholder="30000" required /></label>
      <label>Reliable monthly income during the transition (₹)<input name="income" type="number" min="0" step="500" value="0" required /></label>
      <label>Expected monthly transition cost (₹)<input name="transition" type="number" min="0" step="500" value="0" required /></label>
    </div>
    <label>What evidence do you already have?<select name="evidence"><option value="none">Only an interest or idea</option><option value="early">Some learning or an early project</option><option value="tested">A project or conversation tested with feedback</option><option value="strong">Relevant work evidence and a staged next opportunity</option></select></label>
    <label>What would make you pause before making an irreversible move?<textarea name="pause" rows="3" maxlength="600" placeholder="A minimum reserve, offer, project result, family condition or review date"></textarea></label>
    <div class="crc-actions"><button class="crc-primary" type="submit">Calculate runway</button><button type="button" data-crc="clear">Clear</button></div>
    <p id="crc-status" class="crc-status" role="status" aria-live="polite"></p>
  </form>
  <div id="crc-result" class="crc-result" hidden></div>
</section>
<script>
  const crcForm = document.querySelector<HTMLFormElement>('#crc-form');
  const crcResult = document.querySelector<HTMLDivElement>('#crc-result');
  const crcStatus = document.querySelector<HTMLParagraphElement>('#crc-status');
  const crcClear = document.querySelector<HTMLButtonElement>('[data-crc="clear"]');
  if (!crcForm || !crcResult || !crcStatus || !crcClear) throw new Error('Career runway calculator markup is incomplete.');
  const crcEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  const crcMoney = (value: number) => `₹${Math.round(value || 0).toLocaleString('en-IN')}`;
  crcForm.addEventListener('submit', (event) => { event.preventDefault(); if (!crcForm.checkValidity()) { crcForm.reportValidity(); return; } const data = Object.fromEntries([...crcForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea')].map((field) => [field.name, field.value])); const savings = Number(data.savings) || 0, expenses = Number(data.expenses) || 0, income = Number(data.income) || 0, transition = Number(data.transition) || 0, gap = Math.max(0, expenses + transition - income), months = gap > 0 ? savings / gap : Infinity, display = Number.isFinite(months) ? `${months.toFixed(1)} months` : 'no entered monthly gap'; const evidence = data.evidence === 'none' ? 'Create a small work sample and speak with practitioners before increasing financial risk.' : data.evidence === 'early' ? 'Test the early project with feedback and define a threshold before committing more time or money.' : 'Write the evidence threshold for the next staged commitment and keep a backup route visible.'; crcResult.innerHTML = `<div class="crc-lead"><span>Entered-assumption estimate</span><h3>${crcEsc(display)} at the current gap</h3><p>This uses ${crcMoney(savings)} accessible savings, ${crcMoney(expenses)} essential expenses, ${crcMoney(transition)} transition cost and ${crcMoney(income)} reliable monthly income. It does not account for every real-life cost.</p></div><div class="crc-grid-result"><article><b>Monthly gap</b><strong>${crcMoney(gap)}</strong><small>Expenses and transition costs minus reliable income</small></article><article><b>Evidence before escalation</b><p>${crcEsc(evidence)}</p></article></div><div class="crc-next"><h3>Safer sequence</h3><ul><li>Keep an emergency reserve and include debt, tax, health and family obligations.</li><li>Run a defined experiment or portfolio project while protecting essential income where possible.</li><li>Speak with people doing the target work and verify the entry route.</li><li>Set a review date and a stop or pause threshold before making an irreversible move.</li></ul>${data.pause ? `<p><b>Your pause condition:</b> ${crcEsc(data.pause)}</p>` : ''}</div>`; crcResult.hidden = false; crcStatus.textContent = 'Runway estimated from your entries; nothing was sent.'; });
  crcClear.addEventListener('click', () => { crcForm.reset(); crcResult.hidden = true; crcStatus.textContent = 'Cleared.'; });
</script>
<style>
  .crc{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.crc h2{margin:.2rem 0 .6rem}.crc>p{max-width:800px;line-height:1.65}.crc-note,.crc-status{color:rgba(255,255,255,.68);font-size:.88rem}.crc-form{display:grid;gap:1rem;margin-top:1.4rem}.crc-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.crc-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.crc-form input,.crc-form select,.crc-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.crc-actions{display:flex;gap:.6rem;flex-wrap:wrap}.crc-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.crc-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.crc-result{margin-top:1.3rem}.crc-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.crc-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.crc-lead h3{margin:.4rem 0;font-size:1.5rem}.crc-lead p,.crc-grid-result p,.crc-next li,.crc-next p{line-height:1.6;color:rgba(255,255,255,.75)}.crc-grid-result{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.crc-grid-result article,.crc-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.crc-grid-result strong{display:block;margin-top:.3rem;color:#f5d98c;font-size:1.3rem}.crc-grid-result small{display:block;color:rgba(255,255,255,.65);margin-top:.2rem}.crc-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.crc-next h3{margin-top:0}@media(max-width:650px){.crc-grid,.crc-grid-result{grid-template-columns:1fr}}
</style>
