---
import { SCALE, SCALE_TIPS } from '../config/scalability.mjs';

const scaleData = {
  labels: { high: SCALE.high.label, mid: SCALE.mid.label, low: SCALE.low.label },
  tips: { high: SCALE_TIPS.high, mid: SCALE_TIPS.mid, low: SCALE_TIPS.low },
};
const actionRows = [0, 1, 2, 3];
---

<section class="smr" id="student-mentoring-form" aria-labelledby="smr-title">
  <h2 id="smr-title">Mentoring session record and report builder</h2>
  <p class="smr-note"><b>Private by design:</b> everything you type stays in this browser. The tool asks for no names, phone numbers or email addresses, and it sends nothing to this site. On a shared school or college computer, press Clear all saved data when you finish.</p>

  <p class="smr-example-row"><button type="button" class="smr-btn" data-smr="example">Fill with a made-up example</button> <span class="smr-hint">Loads three fictional sessions and a report so you can see the format, then you clear it.</span></p>
  <p class="smr-example-flag" id="smr-example-flag" role="status" hidden></p>

  <div class="smr-tabs" role="tablist" aria-label="Choose the form or the report">
    <button type="button" role="tab" id="smr-tab-record" aria-controls="smr-panel-record" aria-selected="true" data-smr-tab="record">1. Session record</button>
    <button type="button" role="tab" id="smr-tab-report" aria-controls="smr-panel-report" aria-selected="false" data-smr-tab="report" tabindex="-1">2. Mentoring report</button>
  </div>

  <div id="smr-panel-record" role="tabpanel" aria-labelledby="smr-tab-record" class="smr-panel">
    <form class="smr-form" id="smr-form-record" novalidate onsubmit="return false">
      <div class="smr-screen">
        <fieldset class="smr-box">
          <legend>Who is filling this in</legend>
          <div class="smr-grid">
            <label>Role
              <select data-k="role">
                <option value="teacher">Teacher or school mentor</option>
                <option value="college">College mentor or faculty</option>
                <option value="senior">Senior student mentoring a junior</option>
                <option value="student">Student keeping a personal record</option>
              </select>
            </label>
            <label>Student initials (optional)
              <input type="text" data-k="initials" maxlength="6" autocomplete="off" placeholder="For example AB" />
            </label>
            <label>Class, year or course (optional)
              <input type="text" data-k="classYear" maxlength="40" autocomplete="off" placeholder="For example Class 11" />
            </label>
            <label>Session number
              <input type="number" data-k="no" min="1" max="99" inputmode="numeric" />
            </label>
            <label>Session date
              <input type="date" data-k="date" />
            </label>
            <label>How it was held
              <select data-k="mode">
                <option value="unset">Not recorded</option>
                <option value="inperson">In person</option>
                <option value="online">Online</option>
                <option value="phone">Phone call</option>
                <option value="group">Small group</option>
              </select>
            </label>
            <label>Time taken, in minutes (optional)
              <input type="text" data-k="minutes" maxlength="4" inputmode="numeric" autocomplete="off" />
            </label>
          </div>
          <p class="smr-hint">Use initials only, or leave the field empty. Do not type a full name, phone number, email address or any health or family detail.</p>
        </fieldset>

        <fieldset class="smr-box">
          <legend>What happened in the session</legend>
          <label>1. Goal of this session
            <textarea data-k="goal" rows="3" maxlength="600" placeholder="What did we want to get out of this session?"></textarea>
          </label>
          <label>2. Progress since the last session
            <textarea data-k="progress" rows="3" maxlength="600" placeholder="What changed, what was finished, what was not?"></textarea>
          </label>
          <label>3. Obstacles
            <textarea data-k="obstacles" rows="3" maxlength="600" placeholder="What is getting in the way? Time, money, marks, confidence, information, distance"></textarea>
          </label>
          <label>4. What went well and strengths seen
            <textarea data-k="strengths" rows="2" maxlength="400" placeholder="What did the student do well? Name the evidence, for example a finished task"></textarea>
          </label>
        </fieldset>

        <fieldset class="smr-box">
          <legend>5. Agreed actions with dates</legend>
          <p class="smr-hint">Write each action so that someone could tell, on the date, whether it was done. Leave unused rows empty.</p>
          {actionRows.map((i) => (
            <div class="smr-action">
              <label class="smr-action-text">Action {i + 1}
                <input type="text" data-act={i} data-f="t" maxlength="200" autocomplete="off" placeholder="For example: read the official eligibility page for one course" />
              </label>
              <label>Due date
                <input type="date" data-act={i} data-f="due" aria-label={`Action ${i + 1}, due date`} />
              </label>
              <label>Status
                <select data-act={i} data-f="status" aria-label={`Action ${i + 1}, status`}>
                  <option value="open">Open</option>
                  <option value="done">Done</option>
                  <option value="moved">Moved to a new date</option>
                  <option value="dropped">Dropped</option>
                </select>
              </label>
            </div>
          ))}
        </fieldset>

        <fieldset class="smr-box">
          <legend>6. Follow-up</legend>
          <div class="smr-grid smr-grid--2">
            <label>Next session or check date
              <input type="date" data-k="followDate" />
            </label>
            <label>How will progress be checked?
              <input type="text" data-k="followHow" maxlength="200" autocomplete="off" placeholder="For example: bring the notes and review them together" />
            </label>
          </div>
        </fieldset>

        <fieldset class="smr-box">
          <legend>7. Option or route suggested (optional)</legend>
          <p class="smr-hint">If the mentor suggested a course, route, skill or job, name it and mark it for growth. The marks are explained below the tool.</p>
          <div class="smr-grid smr-grid--2">
            <label>Option suggested
              <input type="text" data-k="option" maxlength="160" autocomplete="off" placeholder="A course, route, skill or job" />
            </label>
            <label>Growth mark
              <select data-k="mark">
                <option value="unchecked">Not yet checked</option>
                <option value="high">Scalable</option>
                <option value="mid">Scalable with a business layer</option>
                <option value="low">Not so scalable</option>
              </select>
            </label>
          </div>
          <label>Risk to remember
            <input type="text" data-k="risk" maxlength="200" autocomplete="off" placeholder="For example: very competitive, long wait before pay grows" />
          </label>
        </fieldset>

        <fieldset class="smr-box">
          <legend>8. Extra support or referral (optional)</legend>
          <label>Does the student need a counsellor, teacher, the family or another adult to know or help?
            <input type="text" data-k="support" maxlength="200" autocomplete="off" placeholder="Say who and why, without private details" />
          </label>
        </fieldset>

        <fieldset class="smr-box">
          <legend>9. Career guidance feedback form (student side, optional)</legend>
          <label>What was most useful in this session?
            <textarea data-k="useful" rows="2" maxlength="400"></textarea>
          </label>
          <label>What was unclear or did not fit?
            <textarea data-k="unclear" rows="2" maxlength="400"></textarea>
          </label>
          <label>How clear was the advice?
            <select data-k="clarity">
              <option value="unset">Not recorded</option>
              <option value="clear">Very clear</option>
              <option value="mostly">Mostly clear</option>
              <option value="unclear">Unclear</option>
            </select>
          </label>
          <div class="smr-grid smr-grid--2">
            <label>Did the student feel listened to?
              <select data-k="listened">
                <option value="unset">Not recorded</option>
                <option value="yes">Yes, I was listened to</option>
                <option value="mostly">Mostly</option>
                <option value="no">Not really</option>
              </select>
            </label>
            <label>Does the student know the next step?
              <select data-k="nextstep">
                <option value="unset">Not recorded</option>
                <option value="yes">Yes, I know my next step</option>
                <option value="some">Partly</option>
                <option value="no">Not yet</option>
              </select>
            </label>
          </div>
        </fieldset>

        <div class="smr-actions">
          <button type="button" class="smr-btn smr-btn--primary" data-smr="save" id="smr-save">Save to report log</button>
          <button type="button" class="smr-btn" data-smr="pdf-record">Download record PDF</button>
          <button type="button" class="smr-btn" data-smr="copy-record">Copy as text</button>
          <button type="button" class="smr-btn" data-smr="print-record">Print record</button>
          <button type="button" class="smr-btn" data-smr="new">Start a new record</button>
        </div>
        <p class="smr-status" id="smr-status-record" role="status" aria-live="polite"></p>
      </div>
    </form>

    <div class="smr-previewhead smr-screen">
      <h3>Preview of the record</h3>
      <p class="smr-hint">The PDF and the printout use exactly this content. Leave fields empty and the preview shows ruled lines, so you can print a blank form and write by hand.</p>
    </div>
    <article class="smr-doc" id="smr-doc-record" aria-label="Preview of the session record"></article>
  </div>

  <div id="smr-panel-report" role="tabpanel" aria-labelledby="smr-tab-report" class="smr-panel" hidden>
    <div class="smr-screen">
      <fieldset class="smr-box">
        <legend>Report details</legend>
        <label>Period covered
          <input type="text" data-r="period" maxlength="80" autocomplete="off" placeholder="For example: Term 2, or August to November" />
        </label>
        <label>Focus of the mentoring
          <textarea data-r="focus" rows="3" maxlength="600" placeholder="What was the mentoring about? For example: choosing a stream, building a project, preparing for an entrance exam"></textarea>
        </label>
        <label>Mentor observations
          <textarea data-r="observations" rows="3" maxlength="600" placeholder="What stood out across these sessions? Stay with what you saw and what was done"></textarea>
        </label>
        <label>Overall progress
          <select data-r="overall">
            <option value="unset">Not recorded</option>
            <option value="good">Good progress</option>
            <option value="some">Some progress</option>
            <option value="little">Little progress so far</option>
          </select>
        </label>
        <label>Recommended next steps
          <textarea data-r="next" rows="3" maxlength="600" placeholder="What should happen next, and who will do it?"></textarea>
        </label>
        <label>Support needed from the school, college or family
          <textarea data-r="support" rows="2" maxlength="400" placeholder="What help does the student need from adults around them?"></textarea>
        </label>
      </fieldset>

      <div class="smr-box">
        <h3 class="smr-loghead">Saved sessions</h3>
        <p class="smr-hint" id="smr-logcount"></p>
        <ol class="smr-log" id="smr-log"></ol>
      </div>

      <div class="smr-actions">
        <button type="button" class="smr-btn smr-btn--primary" data-smr="pdf-report">Download report PDF</button>
        <button type="button" class="smr-btn" data-smr="copy-report">Copy as text</button>
        <button type="button" class="smr-btn" data-smr="print-report">Print report</button>
        <button type="button" class="smr-btn smr-btn--warn" data-smr="clear-all">Clear all saved data</button>
      </div>
      <p class="smr-status" id="smr-status-report" role="status" aria-live="polite"></p>
    </div>

    <div class="smr-previewhead smr-screen">
      <h3>Preview of the report</h3>
      <p class="smr-hint">The report is built only from the sessions you saved and the text you typed above. Nothing is added or scored.</p>
    </div>
    <article class="smr-doc" id="smr-doc-report" aria-label="Preview of the mentoring report"></article>
  </div>

  <noscript><p class="smr-note">This tool needs JavaScript. You can copy the headings above onto paper and use them as a handwritten form.</p></noscript>
  <script is:inline type="application/json" id="smr-scale-data" set:html={JSON.stringify(scaleData)} />
</section>

<script>
  // @ts-nocheck
  import {
    STORAGE_KEY, MAX_SESSIONS, blankDraft, blankReport, normaliseDraft, nextSessionNo, todayISO, fmtDate,
    recordModel, reportModel, modelToHtml, modelToText, esc, buildPdf, hasUnsupportedText, prepareUnicodePdf, DEFAULT_SCALE,
    exampleState, EXAMPLE_NOTE,
  } from '../scripts/studentMentoring';

  const root = document.getElementById('student-mentoring-form');
  if (root) {
    let scale = DEFAULT_SCALE;
    try { scale = JSON.parse(document.getElementById('smr-scale-data').textContent) || DEFAULT_SCALE; } catch (e) {}

    const state = { draft: blankDraft(1), sessions: [], report: blankReport(), editingId: null, example: false };
    let storageOk = true;
    try { localStorage.setItem(STORAGE_KEY + '-probe', '1'); localStorage.removeItem(STORAGE_KEY + '-probe'); } catch (e) { storageOk = false; }
    try {
      const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (raw && typeof raw === 'object') {
        if (Array.isArray(raw.sessions)) state.sessions = raw.sessions.slice(0, MAX_SESSIONS).map((s) => Object.assign(normaliseDraft(s), { id: String(s.id || Math.random()) }));
        state.report = Object.assign(blankReport(), raw.report || {});
        state.draft = normaliseDraft(raw.draft, nextSessionNo(state.sessions));
        state.editingId = raw.editingId || null;
        state.example = raw.example === true;
        if (state.editingId && !state.sessions.some((s) => s.id === state.editingId)) state.editingId = null;
      }
    } catch (e) {}

    const $ = (sel) => root.querySelector(sel);
    const docRecord = $('#smr-doc-record');
    const docReport = $('#smr-doc-report');
    const saveBtn = $('#smr-save');
    const statusEl = { record: $('#smr-status-record'), report: $('#smr-status-report') };
    let tab = 'record';

    const persist = () => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { storageOk = false; }
    };
    const say = (which, text) => { statusEl[which].textContent = text; };

    function fillForm() {
      root.querySelectorAll('[data-k]').forEach((el) => { el.value = state.draft[el.getAttribute('data-k')] || ''; });
      root.querySelectorAll('[data-act]').forEach((el) => {
        const a = state.draft.actions[Number(el.getAttribute('data-act'))];
        el.value = a ? a[el.getAttribute('data-f')] || '' : '';
      });
      root.querySelectorAll('[data-r]').forEach((el) => { el.value = state.report[el.getAttribute('data-r')] || ''; });
      saveBtn.textContent = state.editingId ? 'Update saved session' : 'Save to report log';
      const flag = $('#smr-example-flag');
      flag.hidden = !state.example;
      flag.textContent = state.example ? EXAMPLE_NOTE : '';
    }

    function renderLog() {
      const list = $('#smr-log');
      const n = state.sessions.length;
      $('#smr-logcount').textContent = n
        ? n + (n === 1 ? ' session saved' : ' sessions saved') + ' in this browser (up to ' + MAX_SESSIONS + ').'
        : 'No sessions saved yet. Fill in the session record and press Save to report log.';
      const sorted = state.sessions.slice().sort((a, b) => String(a.date).localeCompare(String(b.date)) || (parseInt(a.no, 10) || 0) - (parseInt(b.no, 10) || 0));
      list.innerHTML = sorted.map((s) => {
        const goal = (s.goal || '').trim();
        const short = goal.length > 90 ? goal.slice(0, 87) + '...' : goal;
        return '<li><span class="smr-log-text"><b>Session ' + esc(s.no) + '</b>, ' + esc(fmtDate(s.date)) + (short ? ': ' + esc(short) : '') + '</span><span class="smr-log-btns"><button type="button" class="smr-mini" data-smr="edit" data-id="' + esc(s.id) + '" aria-label="Edit session ' + esc(s.no) + '">Edit</button><button type="button" class="smr-mini" data-smr="remove" data-id="' + esc(s.id) + '" aria-label="Remove session ' + esc(s.no) + '">Remove</button></span></li>';
      }).join('');
    }

    function renderDocs() {
      docRecord.innerHTML = modelToHtml(recordModel(state.draft));
      docReport.innerHTML = modelToHtml(reportModel(state, todayISO(), scale));
    }
    const refresh = () => { renderDocs(); renderLog(); };

    function showTab(name) {
      tab = name;
      ['record', 'report'].forEach((t) => {
        const on = t === name;
        const btn = $('#smr-tab-' + t);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
        $('#smr-panel-' + t).hidden = !on;
      });
    }
    root.querySelectorAll('[data-smr-tab]').forEach((btn) => {
      btn.addEventListener('click', () => showTab(btn.getAttribute('data-smr-tab')));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const next = tab === 'record' ? 'report' : 'record'; showTab(next); $('#smr-tab-' + next).focus(); }
      });
    });

    function onField(e) {
      const el = e.target;
      if (el.hasAttribute('data-k')) state.draft[el.getAttribute('data-k')] = el.value;
      else if (el.hasAttribute('data-act')) state.draft.actions[Number(el.getAttribute('data-act'))][el.getAttribute('data-f')] = el.value;
      else if (el.hasAttribute('data-r')) state.report[el.getAttribute('data-r')] = el.value;
      else return;
      persist();
      renderDocs();
    }
    root.addEventListener('input', onField);
    root.addEventListener('change', onField);

    function saveSession() {
      const d = state.draft;
      if (state.example) { say('record', 'A made-up example is loaded. Press Clear all saved data in the Mentoring report tab before you save real sessions.'); return; }
      if (!d.date || !d.goal.trim()) {
        say('record', 'Add the session date and the goal of the session before saving.');
        const target = !d.date ? $('[data-k="date"]') : $('[data-k="goal"]');
        if (target) target.focus();
        return;
      }
      const copy = JSON.parse(JSON.stringify(d));
      if (state.editingId) {
        const idx = state.sessions.findIndex((s) => s.id === state.editingId);
        copy.id = state.editingId;
        if (idx >= 0) state.sessions[idx] = copy; else state.sessions.push(copy);
      } else {
        if (state.sessions.length >= MAX_SESSIONS) { say('record', 'The log holds ' + MAX_SESSIONS + ' sessions. Download the report, then clear the saved data to start a new log.'); return; }
        copy.id = String(Date.now()) + String(Math.floor(Math.random() * 1000));
        state.sessions.push(copy);
      }
      const wasEditing = !!state.editingId;
      const role = d.role; const initials = d.initials;
      state.editingId = null;
      state.draft = Object.assign(blankDraft(nextSessionNo(state.sessions)), { role, initials });
      persist(); fillForm(); refresh();
      say('record', (wasEditing ? 'Session updated.' : 'Session saved to the report log.') + ' The form is ready for session ' + state.draft.no + '. Open the Mentoring report tab to see the summary.');
    }

    function newRecord() {
      if (state.draft.goal.trim() && !window.confirm('Clear the form? Sessions already saved in the log are not affected.')) return;
      const role = state.draft.role; const initials = state.draft.initials;
      state.editingId = null;
      state.draft = Object.assign(blankDraft(nextSessionNo(state.sessions)), { role, initials });
      persist(); fillForm(); refresh();
      say('record', 'The form is clear and ready for session ' + state.draft.no + '.');
    }

    function editSession(id) {
      const s = state.sessions.find((x) => x.id === id);
      if (!s) return;
      state.draft = normaliseDraft(JSON.parse(JSON.stringify(s)));
      state.editingId = id;
      persist(); fillForm(); refresh(); showTab('record');
      say('record', 'Editing session ' + s.no + '. Press Update saved session to keep your changes.');
      $('#smr-form-record').scrollIntoView({ block: 'start' });
      const goalBox = $('[data-k="goal"]');
      if (goalBox) goalBox.focus({ preventScroll: true });
    }

    function removeSession(id) {
      const s = state.sessions.find((x) => x.id === id);
      if (!s || !window.confirm('Remove session ' + s.no + ' from the log?')) return;
      state.sessions = state.sessions.filter((x) => x.id !== id);
      if (state.editingId === id) state.editingId = null;
      persist(); fillForm(); refresh();
      say('report', 'Session removed from the log.');
    }

    function loadExample() {
      const has = state.sessions.length || state.draft.goal.trim() || Object.values(state.report).some((v) => v && v !== 'unset');
      if (has && !state.example && !window.confirm('Replace what you have saved with a made-up example? Your own sessions and report text will be lost.')) return;
      const ex = exampleState();
      state.sessions = ex.sessions; state.report = ex.report; state.draft = ex.draft; state.editingId = null; state.example = true;
      persist(); fillForm(); refresh(); showTab('report');
      say('report', 'A made-up example is loaded: three sessions and a report. Press Clear all saved data when you are done.');
    }

    function clearAll() {
      if (!window.confirm('Clear the form, the saved sessions and the report text from this browser? This cannot be undone.')) return;
      state.sessions = []; state.report = blankReport(); state.editingId = null; state.draft = blankDraft(1); state.example = false;
      try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
      fillForm(); refresh();
      say('report', 'All saved data was cleared from this browser.');
      say('record', '');
    }

    let pdfBusy = false;
    async function downloadPdf(kind) {
      if (pdfBusy) return;
      pdfBusy = true;
      const model = kind === 'record' ? recordModel(state.draft) : reportModel(state, todayISO(), scale);
      const out = kind;
      try {
        const needsFont = hasUnsupportedText(model);
        let unicodeReady = false;
        if (needsFont) {
          say(out, 'Loading a font for your Telugu, Hindi or other text...');
          unicodeReady = await prepareUnicodePdf(model);
          if (!unicodeReady) {
            say(out, 'This device could not draw some of your text into the PDF. Use Print and choose Save as PDF instead, which keeps every script.');
            return;
          }
        }
        say(out, 'Preparing the PDF...');
        const mod = await import('jspdf');
        const pdf = buildPdf(mod.jsPDF, model, unicodeReady);
        pdf.save(model.fileName);
        say(out, needsFont
          ? 'PDF downloaded. Text in Telugu, Hindi or other scripts is drawn as pictures so the letters keep their shape, so that text cannot be selected or copied from the PDF. It was made in this browser and not uploaded.'
          : 'PDF downloaded. It was made in this browser and not uploaded.');
      } catch (err) {
        console.error('Unable to create the mentoring PDF:', err);
        say(out, 'The PDF could not be made. Use Print and choose Save as PDF instead.');
      } finally {
        pdfBusy = false;
      }
    }

    function printDoc(kind) {
      if (tab !== kind) showTab(kind);
      renderDocs();
      document.body.setAttribute('data-smr-print', kind);
      const done = () => { document.body.removeAttribute('data-smr-print'); window.removeEventListener('afterprint', done); };
      window.addEventListener('afterprint', done);
      window.print();
    }

    async function copyDoc(kind) {
      const model = kind === 'record' ? recordModel(state.draft) : reportModel(state, todayISO(), scale);
      const text = modelToText(model);
      let ok = false;
      try { await navigator.clipboard.writeText(text); ok = true; } catch (err) {
        try { const area = document.createElement('textarea'); area.value = text; area.style.cssText = 'position:fixed;left:-9999px'; document.body.appendChild(area); area.select(); ok = document.execCommand('copy'); area.remove(); } catch (err2) { ok = false; }
      }
      say(kind, ok ? 'Copied as text. Paste it into WhatsApp or a message. Share it only with people who should see it.' : 'Copy did not work on this device. Use Download PDF or Print instead.');
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-smr]');
      if (!btn) return;
      const action = btn.getAttribute('data-smr');
      if (action === 'save') saveSession();
      else if (action === 'new') newRecord();
      else if (action === 'copy-record') copyDoc('record');
      else if (action === 'copy-report') copyDoc('report');
      else if (action === 'pdf-record') downloadPdf('record');
      else if (action === 'pdf-report') downloadPdf('report');
      else if (action === 'print-record') printDoc('record');
      else if (action === 'print-report') printDoc('report');
      else if (action === 'edit') editSession(btn.getAttribute('data-id'));
      else if (action === 'remove') removeSession(btn.getAttribute('data-id'));
