<section class="pqc" id="portfolio-quality-checker" aria-labelledby="pqc-title">
  <p class="eyebrow">EVIDENCE CHECKER</p>
  <h2 id="pqc-title">Find the evidence your portfolio is missing</h2>
  <p>Check whether a reviewer can understand the problem, your contribution, your decisions, the result and what you learned. This is a clarity checklist—not a talent or hiring score.</p>
  <p class="pqc-note"><b>Limit:</b> the result reflects only your answers. It does not validate the work, predict selection, or replace feedback from a relevant reviewer.</p>
  <form id="pqc-form" class="pqc-form" novalidate>
    <label>Portfolio direction<input name="direction" maxlength="140" placeholder="For example, UX design, data analysis or content" required /></label>
    <label>How many finished projects can someone inspect?<select name="projects"><option value="0">None yet</option><option value="1">One</option><option value="2">Two or three</option><option value="3">Four or more</option></select></label>
    <label>Does each project explain the original problem or audience?<select name="context"><option value="0">Not yet</option><option value="1">Somewhat</option><option value="2">Clearly</option></select></label>
    <label>Can a visitor see your process and decisions?<select name="process"><option value="0">Only the final result</option><option value="1">Some notes</option><option value="2">Clear iterations and reasoning</option></select></label>
    <label>Can someone inspect the actual artifact or output?<select name="artifact"><option value="0">No or broken link</option><option value="1">Partly</option><option value="2">Yes, with a clear explanation</option></select></label>
    <label>Do you show feedback or an observable outcome?<select name="feedback"><option value="0">No</option><option value="1">Some feedback</option><option value="2">Feedback and outcome evidence</option></select></label>
    <label>Do you state limitations and what you would improve?<select name="reflection"><option value="0">No</option><option value="1">Briefly</option><option value="2">Clearly and specifically</option></select></label>
    <div class="pqc-actions"><button class="pqc-primary" type="submit">Check portfolio evidence</button><button type="button" data-pqc="clear">Clear</button></div>
    <p id="pqc-status" class="pqc-status" role="status" aria-live="polite"></p>
  </form>
  <div id="pqc-result" class="pqc-result" hidden></div>
</section>
<script>
  type PqcField = HTMLInputElement | HTMLSelectElement;
  type PqcForm = Omit<HTMLFormElement, 'querySelectorAll'> & { querySelectorAll(selectors: string): NodeListOf<PqcField> };
  const pqcForm = document.querySelector<HTMLFormElement>('#pqc-form') as PqcForm | null;
  const pqcResult = document.querySelector<HTMLDivElement>('#pqc-result');
  const pqcStatus = document.querySelector<HTMLParagraphElement>('#pqc-status');
  const pqcClear = document.querySelector<HTMLButtonElement>('[data-pqc="clear"]');
  if (!pqcForm || !pqcResult || !pqcStatus || !pqcClear) throw new Error('Portfolio quality checker markup is incomplete.');
  const pqcEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  pqcForm.addEventListener('submit', (event) => { event.preventDefault(); if (!pqcForm.checkValidity()) { pqcForm.reportValidity(); return; } const data = Object.fromEntries([...pqcForm.querySelectorAll('input,select')].map((field) => [field.name, field.value])); const items = [['finished projects', data.projects],['problem or audience',data.context],['process and decisions',data.process],['inspectable artifact',data.artifact],['feedback or outcome',data.feedback],['limitations and reflection',data.reflection]]; const score = items.reduce((sum, [,value]) => sum + Number(value || 0), 0); const gaps = items.filter(([,value]) => Number(value || 0) < 2).map(([label]) => label); const band = score >= 10 ? 'strong evidence structure' : score >= 6 ? 'partly explained evidence' : 'a portfolio that needs a clearer proof layer'; pqcResult.innerHTML = `<div class="pqc-lead"><span>${pqcEsc(data.direction)} · evidence structure</span><h3>${pqcEsc(band)} · ${score}/12</h3><p>The score checks explainability, not ability or hiring likelihood.</p></div><div class="pqc-grid"><article><b>Improve first</b><p>${gaps.length ? pqcEsc(gaps.slice(0, 3).join(', ')) : 'No major evidence gap was marked in this checklist.'}</p></article><article><b>Next 14-day output</b><p>Choose one project, write its context and decisions, publish a working artifact, ask one relevant person for feedback, and record one limitation.</p></article></div><div class="pqc-next"><h3>Keep the proof honest</h3><ul><li>State exactly what you did and what other people contributed.</li><li>Show iterations, not only a polished final screenshot.</li><li>Separate an observed outcome from an expectation or claim.</li><li>Remove private, confidential or identifying material before sharing.</li></ul></div>`; pqcResult.hidden = false; pqcStatus.textContent = 'Checklist created from your answers; nothing was sent.'; });
  pqcClear.addEventListener('click', () => { pqcForm.reset(); pqcResult.hidden = true; pqcStatus.textContent = 'Cleared.'; });
</script>
<style>
  .pqc{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.pqc h2{margin:.2rem 0 .6rem}.pqc>p{max-width:800px;line-height:1.65}.pqc-note,.pqc-status{color:rgba(255,255,255,.68);font-size:.88rem}.pqc-form{display:grid;gap:1rem;margin-top:1.4rem}.pqc-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.pqc-form input,.pqc-form select{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.pqc-actions{display:flex;gap:.6rem;flex-wrap:wrap}.pqc-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.pqc-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.pqc-result{margin-top:1.3rem}.pqc-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.pqc-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.pqc-lead h3{margin:.4rem 0;font-size:1.5rem}.pqc-lead p,.pqc-grid p,.pqc-next li{line-height:1.6;color:rgba(255,255,255,.75)}.pqc-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.pqc-grid article,.pqc-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.pqc-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.pqc-next h3{margin-top:0}@media(max-width:650px){.pqc-grid{grid-template-columns:1fr}}
</style>
