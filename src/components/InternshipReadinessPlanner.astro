<section class="irp" id="internship-readiness-planner" aria-labelledby="irp-title">
  <p class="eyebrow">PRACTICAL PREPARATION TOOL</p>
  <h2 id="irp-title">Build an internship-readiness plan</h2>
  <p>Identify the smallest evidence, communication and logistics steps that would make a credible learning application clearer.</p>
  <p class="irp-note"><b>Limit:</b> this is a preparation checklist, not a placement guarantee, employer assessment or promise that an internship is safe or paid.</p>
  <form id="irp-form" class="irp-form" novalidate>
    <label>What kind of internship are you exploring?<input name="direction" maxlength="160" placeholder="For example, marketing, data, design or laboratory work" required /></label>
    <label>What evidence can you show today?<select name="evidence"><option value="0">Nothing organised yet</option><option value="1">Coursework or practice exercises</option><option value="2">One or two projects</option><option value="3">Relevant work with feedback</option></select></label>
    <label>Can you explain your interest and what you want to learn?<select name="communication"><option value="0">Not yet</option><option value="1">A general answer</option><option value="2">A specific learning goal</option><option value="3">A concise goal backed by evidence</option></select></label>
    <label>Have you checked the opportunity and organisation?<select name="safety"><option value="0">Not yet</option><option value="1">Only the listing</option><option value="2">Identity and work details partly checked</option><option value="3">Role, supervisor, terms and safety checked</option></select></label>
    <label>What is the next preparation action?<textarea name="next" rows="3" maxlength="600" placeholder="Finish a sample, ask for feedback, tailor a message, or verify the opportunity"></textarea></label>
    <div class="irp-actions"><button class="irp-primary" type="submit">Create preparation plan</button><button type="button" data-irp="clear">Clear</button></div>
    <p id="irp-status" class="irp-status" role="status" aria-live="polite"></p>
  </form>
  <div id="irp-result" class="irp-result" hidden></div>
</section>
<script>
  type IrpField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type IrpForm = Omit<HTMLFormElement, 'querySelectorAll'> & { querySelectorAll(selectors: string): NodeListOf<IrpField> };
  const irpForm = document.querySelector<HTMLFormElement>('#irp-form') as IrpForm | null;
  const irpResult = document.querySelector<HTMLDivElement>('#irp-result');
  const irpStatus = document.querySelector<HTMLParagraphElement>('#irp-status');
  const irpClear = document.querySelector<HTMLButtonElement>('[data-irp="clear"]');
  if (!irpForm || !irpResult || !irpStatus || !irpClear) throw new Error('Internship readiness planner markup is incomplete.');
  const irpEsc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] || c));
  irpForm.addEventListener('submit', (event) => { event.preventDefault(); if (!irpForm.checkValidity()) { irpForm.reportValidity(); return; } const data = Object.fromEntries([...irpForm.querySelectorAll('input,select,textarea')].map((field) => [field.name, field.value])); const values = ['evidence','communication','safety'].map((key) => Number(data[key]) || 0); const score = values.reduce((sum, value) => sum + value, 0); const band = score >= 8 ? 'good preparation base' : score >= 5 ? 'partial preparation base' : 'early preparation stage'; const first = Number(data.evidence) < 2 ? 'Finish one small, inspectable sample related to this direction.' : Number(data.communication) < 2 ? 'Write and rehearse a specific learning goal tied to your evidence.' : 'Verify the opportunity, supervisor, terms and safety before sharing sensitive information.'; irpResult.innerHTML = `<div class="irp-lead"><span>${irpEsc(data.direction)} · preparation signal</span><h3>${irpEsc(band)} · ${score}/9</h3><p>This describes preparation evidence, not employer suitability or likely selection.</p></div><div class="irp-grid"><article><b>First action</b><p>${irpEsc(first)}</p></article><article><b>Your planned next step</b><p>${data.next ? irpEsc(data.next) : 'Add one action you can complete within seven days.'}</p></article></div><div class="irp-next"><h3>Seven-day checklist</h3><ul><li>Read the exact role, work location, supervisor and expected hours.</li><li>Prepare one truthful sample and explain what you contributed.</li><li>Ask what you will learn, who reviews the work, and whether terms are written.</li><li>Do not pay for access, share unnecessary identity or financial documents, or accept unsafe conditions.</li></ul></div>`; irpResult.hidden = false; irpStatus.textContent = 'Preparation plan created from your answers; nothing was sent.'; });
  irpClear.addEventListener('click', () => { irpForm.reset(); irpResult.hidden = true; irpStatus.textContent = 'Cleared.'; });
</script>
<style>
  .irp{margin:2rem 0;padding:1.5rem;border:1px solid rgba(18,154,141,.4);border-radius:18px;background:rgba(18,154,141,.05)}.irp h2{margin:.2rem 0 .6rem}.irp>p{max-width:800px;line-height:1.65}.irp-note,.irp-status{color:rgba(255,255,255,.68);font-size:.88rem}.irp-form{display:grid;gap:1rem;margin-top:1.4rem}.irp-form label{display:grid;gap:.4rem;font-weight:650;font-size:.9rem}.irp-form input,.irp-form select,.irp-form textarea{width:100%;padding:.65rem .75rem;border:1px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-weight:400}.irp-actions{display:flex;gap:.6rem;flex-wrap:wrap}.irp-actions button{min-height:44px;padding:.55rem .85rem;border:1px solid rgba(255,255,255,.24);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font:inherit;cursor:pointer}.irp-primary{background:#129a8d!important;border-color:#129a8d!important;font-weight:700}.irp-result{margin-top:1.3rem}.irp-lead{padding:1.1rem;border-left:3px solid #2dd4bf;background:rgba(45,212,191,.08)}.irp-lead span{color:#8de4d8;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.irp-lead h3{margin:.4rem 0;font-size:1.5rem}.irp-lead p,.irp-grid p,.irp-next li{line-height:1.6;color:rgba(255,255,255,.75)}.irp-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:.8rem}.irp-grid article,.irp-next{padding:.9rem;border:1px solid rgba(255,255,255,.15);border-radius:10px}.irp-next{margin-top:.8rem;border-color:rgba(229,184,74,.35);background:rgba(229,184,74,.06)}.irp-next h3{margin-top:0}@media(max-width:650px){.irp-grid{grid-template-columns:1fr}}
</style>
