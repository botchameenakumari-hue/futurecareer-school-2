---
import MainAssessmentPicker from './bofu/MainAssessmentPicker.astro';
import type { MainAssessmentId } from '../config/mainAssessments';

export interface Props {
  sectionClass?: string;
  category?: string;
}

// Which of the four full assessments a reader of each blog category is most
// likely to need, most relevant first.
const ASSESSMENTS_BY_CATEGORY: Record<string, MainAssessmentId[]> = {
  'stream-selection': ['class10', 'class1112'],
  parents: ['class10', 'class1112'],
  'college-degrees': ['class1112', 'graduates'],
  'medical-careers': ['class1112', 'graduates'],
  'career-options': ['class1112', 'graduates', 'professionals'],
  'career-guidance': ['class1112', 'graduates', 'professionals'],
  'study-abroad': ['graduates', 'class1112'],
  'career-change': ['professionals', 'graduates'],
  'government-jobs': ['professionals', 'graduates'],
  'ai-future': ['graduates', 'professionals'],
  'freelancing-business': ['professionals', 'graduates'],
};
const DEFAULT_ASSESSMENTS: MainAssessmentId[] = ['graduates', 'professionals', 'class1112'];

const { sectionClass = '', category: categoryProp = '' } = Astro.props;
const category = categoryProp || (Astro.url.pathname.match(/^\/blog\/([^/]+)\//)?.[1] ?? '');
const assessmentIds = ASSESSMENTS_BY_CATEGORY[category] ?? DEFAULT_ASSESSMENTS;
const assessmentsUrl = 'https://futurecareerschool.com/services/assessments/';
const guidanceUrl = 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/';
---

<MainAssessmentPicker
  sectionId="blog-assessment-picker"
  placement="blog"
  ids={assessmentIds}
  title="Not sure which way to go? Take a free career assessment"
  subtitle="Reading helps, but your own interests, strengths and situation decide what fits. Each free assessment turns them into a personal report in about 15 minutes."
/>

<section class:list={['blog-bottom-cta', sectionClass]}>
  <div class="card cta-card">
    <div class="pill cta-pill"><span class="pill-dot"></span>Next move</div>
    <h2>Do not choose your future on guesswork.</h2>
    <p class="cta-line">Find the right fit.</p>
    <p class="cta-line">Build the right skills.</p>
    <p class="cta-line">Move toward earlier financial freedom through stronger skill choices.</p>
    <div class="cta-pair">
      <a class="btn-gold pulse" href={guidanceUrl}>Get Career Guidance</a>
      <a class="btn-outline cta-assessment-lite" href={assessmentsUrl}>Free career and skill assessments</a>
    </div>
  </div>
</section>

<style>
  .blog-bottom-cta {
    padding: 62px 0 84px;
  }
  .cta-card {
    text-align: center;
    border-color: rgba(229,184,74,.18);
    background:
      radial-gradient(circle at 20% 10%, rgba(229,184,74,.08), transparent 35%),
      radial-gradient(circle at 80% 0%, rgba(45,212,191,.06), transparent 30%),
      linear-gradient(135deg, rgba(255,255,255,.035), rgba(255,255,255,.02));
    max-width: 980px;
    margin: 0 auto;
    padding: 2.4rem 1.4rem 2.3rem;
    box-shadow: 0 20px 80px rgba(0,0,0,.18);
  }
  .cta-pill {
    color: rgba(255,255,255,.6);
  }
  .cta-card h2 {
    font-size: clamp(1.6rem, 3.8vw, 2.4rem);
    line-height: 1.08;
    margin-top: .7rem;
  }
  .cta-line {
    font-size: 16px;
    line-height: 1.84;
    color: rgba(255,255,255,.64);
    margin: .16rem auto;
    max-width: 780px;
  }
  .cta-pair {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 1.55rem;
  }
  .cta-card .btn-gold {
    min-width: 300px;
    justify-content: center;
    text-align: center;
  }
  .cta-card .cta-assessment-lite {
    min-width: 0;
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 680px) {
    .blog-bottom-cta {
      padding: 46px 0 72px;
    }
    .cta-line {
      font-size: 15px;
    }
    .cta-pair {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-card .btn-gold,
    .cta-card .cta-assessment-lite {
      width: 100%;
      min-width: 0;
    }
  }
</style>
