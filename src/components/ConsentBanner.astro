<section
  class="consent-banner"
  id="analytics-consent-banner"
  role="dialog"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <div class="consent-copy">
    <h2 id="analytics-consent-title">Your privacy choices</h2>
    <p id="analytics-consent-description">
      We use optional Google Analytics to understand how the site is used. Analytics stays off
      unless you allow it. Advertising storage and ad personalisation remain off.
    </p>
  </div>
  <div class="consent-actions" aria-label="Analytics consent choices">
    <button class="consent-button consent-button--allow" type="button" data-consent-choice="granted">
      Allow analytics
    </button>
    <button class="consent-button consent-button--decline" type="button" data-consent-choice="denied">
      Decline
    </button>
  </div>
</section>

<button
  class="consent-manage"
  id="analytics-consent-manage"
  type="button"
  aria-controls="analytics-consent-banner"
  aria-expanded="false"
  hidden
>
  Privacy choices
</button>

<script is:inline>
  (() => {
    const banner = document.getElementById('analytics-consent-banner');
    const manageButton = document.getElementById('analytics-consent-manage');
    const consentApi = window.futureCareerConsent;

    if (!banner || !manageButton || !consentApi) return;

    const firstChoiceButton = banner.querySelector('[data-consent-choice="granted"]');

    const showBanner = (moveFocus = false) => {
      banner.hidden = false;
      manageButton.hidden = true;
      manageButton.setAttribute('aria-expanded', 'true');
      if (moveFocus) firstChoiceButton?.focus();
    };

    const hideBanner = () => {
      banner.hidden = true;
      manageButton.hidden = false;
      manageButton.setAttribute('aria-expanded', 'false');
    };

    banner.addEventListener('click', (event) => {
      const button = event.target.closest('[data-consent-choice]');
      if (!button) return;

      consentApi.setChoice(button.dataset.consentChoice);
      hideBanner();
      manageButton.focus();
    });

    manageButton.addEventListener('click', () => showBanner(true));

    if (consentApi.getChoice()) {
      hideBanner();
    } else {
      showBanner(false);
    }
  })();
</script>

<style>
  .consent-banner {
    position: fixed;
    z-index: 10000;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: max(1rem, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.5rem;
    width: min(760px, calc(100% - 2rem));
    margin-left: auto;
    padding: 1.1rem;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 16px;
    background: #111827;
    color: #f8fafc;
    box-shadow: 0 18px 60px rgba(0, 0, 0, .5);
    font-family: "DM Sans", "Segoe UI", sans-serif;
  }

  .consent-banner[hidden],
  .consent-manage[hidden] {
    display: none;
  }

  .consent-copy h2 {
    margin: 0 0 .35rem;
    color: #fff;
    font-family: "Sora", "Trebuchet MS", sans-serif;
    font-size: 1rem;
    line-height: 1.3;
  }

  .consent-copy p {
    max-width: 60ch;
    margin: 0;
    color: rgba(255, 255, 255, .82);
    font-size: .875rem;
    line-height: 1.55;
  }

  .consent-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .65rem;
  }

  .consent-button,
  .consent-manage {
    min-height: 44px;
    border-radius: 10px;
    font: 700 .875rem/1 "DM Sans", "Segoe UI", sans-serif;
    cursor: pointer;
  }

  .consent-button {
    padding: .75rem 1rem;
  }

  .consent-button--allow {
    border: 1px solid #f5d98c;
    background: #e5b84a;
    color: #080c18;
  }

  .consent-button--decline {
    border: 1px solid rgba(255, 255, 255, .45);
    background: transparent;
    color: #fff;
  }

  .consent-button:focus-visible,
  .consent-manage:focus-visible {
    outline: 3px solid #2dd4bf;
    outline-offset: 3px;
  }

  .consent-manage {
    position: fixed;
    z-index: 9999;
    right: max(.75rem, env(safe-area-inset-right));
    bottom: max(.75rem, env(safe-area-inset-bottom));
    padding: .7rem .9rem;
    border: 1px solid rgba(255, 255, 255, .28);
    background: #111827;
    color: #fff;
    box-shadow: 0 8px 28px rgba(0, 0, 0, .35);
  }

  @media (max-width: 640px) {
    .consent-banner {
      grid-template-columns: 1fr;
      gap: .9rem;
      width: auto;
      padding: 1rem;
      border-radius: 14px;
    }

    .consent-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-content: stretch;
    }

    .consent-button {
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .consent-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-banner,
    .consent-manage {
      scroll-behavior: auto;
    }
  }
</style>
