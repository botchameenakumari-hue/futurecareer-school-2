---
import { DEFAULT_OG_IMAGE_URL, SITE_NAME } from '../config/site';
import ConsentBanner from '../components/ConsentBanner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import BofuImage from '../components/bofu/BofuImage.astro';
import BofuContextVisual from '../components/bofu/BofuContextVisual.astro';
import BusinessPerspectiveNote from '../components/BusinessPerspectiveNote.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE_URL,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const isDashboardRoute = Astro.url.pathname === '/dashboard' || Astro.url.pathname.startsWith('/dashboard/');
const isCareerGuidanceService = Astro.url.pathname.startsWith('/services/career-counselling-and-career-guidance/');
const isAssessmentService = Astro.url.pathname.startsWith('/services/assessments/');
const assessmentPagesWithOwnMain = [
  '/big-5-personality-test-careers/',
  '/disc-personality-test-careers/',
  '/emotional-intelligence-test-careers/',
  '/entrepreneurial-aptitude-test/',
  '/enneagram-personality-test-careers/',
  '/placement-aptitude-test/',
  '/myers-briggs-career-test/',
  '/numerical-reasoning-test/',
  '/riasec-holland-code-career-test/',
  '/vark-learning-style-test/',
  '/verbal-reasoning-test/',
];
const needsContentLandmark = isCareerGuidanceService || (isAssessmentService && !assessmentPagesWithOwnMain.some((path) => Astro.url.pathname.endsWith(path)));
---

<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <GoogleAnalytics />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Future Career School" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Structured Data -->
  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': jsonLd } : jsonLd)} />
  )}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Blog`} href="/rss.xml" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Global Styles -->
  <style is:global>
    /* Design tokens for Future Career School */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; overflow-x: clip; }
    body {
      background: #080c18;
      color: rgba(255,255,255,0.85);
      font-family: "DM Sans", "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
      min-width: 320px;
      overflow-x: clip;
      max-width: 100%;
    }
    h1,h2,h3,h4 { font-family: "Sora", "Trebuchet MS", sans-serif; line-height: 1.1; }
    h1,h2,h3,h4,p,li { overflow-wrap: break-word; word-break: normal; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; display: block; }
    /* Injected editorial visuals keep their intrinsic 2:3 ratio everywhere,
       including service/resource templates that do not use BlogPostLayout. */
    .article-cover-visual img, .article-visual img, .resource-visual img {
      width: 100%;
      max-width: 760px;
      height: auto !important;
      aspect-ratio: auto !important;
      object-fit: contain;
      display: block;
      margin-inline: auto;
    }
    .article-live-visual {
      width: min(calc(100% - 48px), 960px);
      margin: 1.8rem auto 2.3rem;
    }
    .article-live-card {
      min-width: 0;
      padding: clamp(1.5rem, 3vw, 2rem);
      border: 1px solid rgba(148,163,184,.24);
      border-radius: 20px;
      background: linear-gradient(145deg, #132336, #183139);
      color: #f8fafc;
      box-shadow: 0 18px 45px rgba(0,0,0,.16);
    }
    .article-live-card--narrow { width: min(100%, 28rem); max-width: 100%; }
    .article-live-card--narrow .article-live-stats { grid-template-columns: 1fr; }
    .article-live-card__kicker {
      margin-bottom: .55rem;
      color: #f0c674;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: .08em;
      line-height: 1.35;
      text-transform: uppercase;
    }
    .article-live-card h3 {
      margin: 0 0 1.15rem;
      color: #f8fafc;
      font-size: clamp(1.15rem, 2.2vw, 1.55rem);
      line-height: 1.3;
      overflow-wrap: anywhere;
    }
    .article-live-items {
      display: grid;
      gap: .65rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .article-live-item {
      display: grid;
      grid-template-columns: minmax(8rem, .34fr) minmax(0, 1fr);
      gap: .9rem;
      padding: .85rem 0;
      border-top: 1px solid rgba(226,232,240,.14);
    }
    .article-live-item--plain { grid-template-columns: minmax(0, 1fr); }
    .article-live-item:first-child { border-top: 0; padding-top: 0; }
    .article-live-item__label {
      color: #f0c674;
      font-size: max(14px, .9rem);
      font-weight: 700;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }
    .article-live-item__text {
      color: rgba(248,250,252,.9);
      font-size: max(14px, 1rem) !important;
      line-height: 1.58;
      overflow-wrap: anywhere;
    }
    .article-live-items--chain { list-style: decimal; padding-left: 1.5rem; }
    .article-live-items--chain .article-live-item { padding-left: .3rem; }
    .article-live-items--chain .article-live-item::marker { color: #f0c674; font-weight: 700; }
    .article-live-items--checklist .article-live-item__text::before { content: '✓'; color: #2dd4bf; font-weight: 800; margin-right: .55rem; }
    .article-live-bundle { display: grid; gap: .65rem; min-width: 0; }
    /* Preserve native progressive disclosure even when descendant lists or tables have explicit display values. */
    .article-live-visual details:not([open]) > :not(summary) { display: none !important; }
    .article-live-need { min-width: 0; border-top: 1px solid rgba(226,232,240,.16); padding-top: .65rem; }
    .article-live-need > summary { color: #f0c674; cursor: pointer; font-size: max(14px, 1rem); font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
    .article-live-compact-detail { min-width: 0; }
    .article-live-compact-detail > summary { color: #79533d; cursor: pointer; font-size: max(14px, 1rem); font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
    .article-live-compact-detail > p { margin: .45rem 0 0; color: #303934; font-size: max(14px, 1rem); line-height: 1.58; overflow-wrap: anywhere; }
    .article-live-need[open] > summary { margin-bottom: .8rem; }
    .article-live-need > .article-live-items,
    .article-live-need > .article-live-table-wrap,
    .article-live-need > .article-live-stats { margin-top: .65rem; }
    .article-live-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: .8rem;
    }
    .article-live-visual .article-live-item__label,
    .article-live-visual .article-live-item__text { font-size: max(14px, 1rem) !important; }
    .article-live-stat {
      min-width: 0;
      padding: 1rem;
      border: 1px solid rgba(226,232,240,.16);
      border-radius: 14px;
      background: rgba(255,255,255,.06);
    }
    .article-live-stat strong, .article-live-stat span, .article-live-stat small { display: block; overflow-wrap: anywhere; }
    .article-live-stat strong { color: #f8fafc; font-size: clamp(1.55rem, 4vw, 2.4rem); line-height: 1.2; overflow-wrap: normal; word-break: normal; }
    .article-live-stat strong .article-live-stat__value { display: inline-block; white-space: nowrap; overflow-wrap: normal; }
    .article-live-stat__value--compact { font-size: clamp(1.05rem, 4vw, 1.35rem); }
    .article-live-stat span { margin-top: .45rem; color: #f0c674; font-size: max(14px, .95rem); font-weight: 700; line-height: 1.4; }
    .article-live-stat small { margin-top: .55rem; color: rgba(248,250,252,.76); font-size: max(14px, .88rem); line-height: 1.5; }
    .article-live-visual .article-live-stat span,
    .article-live-visual .article-live-stat small,
    .article-live-visual .article-live-sources small { font-size: max(14px, 1rem) !important; }
    .article-live-sources { display: block; margin-top: .75rem; }
    .article-live-sources:not([open]) > :not(summary) { display: none !important; }
    .article-live-sources[open] > p + p { margin-top: .4rem; }
    .article-live-sources > summary { color: #f0c674; cursor: pointer; font-size: max(14px, .9rem); font-weight: 700; line-height: 1.45; }
    .article-live-sources p { margin: 0; }
    .article-live-sources small { display: block; color: rgba(248,250,252,.76); font-size: max(14px, .88rem); line-height: 1.5; overflow-wrap: anywhere; }
    .article-live-answer { margin: 0 0 1rem; padding: 1rem 1.1rem; border-left: 4px solid #d1a84d; border-radius: 0 12px 12px 0; background: rgba(255,255,255,.07); color: #fffdf7; font-size: max(16px, 1.05rem); font-weight: 600; line-height: 1.55; overflow-wrap: anywhere; }
    .article-live-supporting { margin: .8rem 0 0; color: rgba(248,250,252,.86); font-size: max(14px, .95rem); line-height: 1.55; overflow-wrap: anywhere; }
    .article-live-table-wrap { max-width: 100%; overflow-x: auto; }
    .article-live-table-wrap table { width: 100%; min-width: 32rem; border-collapse: collapse; color: rgba(248,250,252,.92); }
    .article-live-table-wrap th, .article-live-table-wrap td {
      padding: .8rem .75rem;
      border: 1px solid rgba(226,232,240,.16);
      font-size: max(14px, .96rem);
      line-height: 1.5;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
    }
    .article-live-table-wrap th { color: #f0c674; font-weight: 700; }
    .article-live-visual figcaption { margin-top: .65rem; color: rgba(255,255,255,.68); font-size: 14px; line-height: 1.5; }
    figure.article-visual figcaption,
    figure.article-cover-visual figcaption,
    figure.compass-cover-visual figcaption { font-size: max(14px, .875rem) !important; }
    @media (max-width: 720px) {
      .article-live-item { grid-template-columns: minmax(0, 1fr); gap: .3rem; }
      .article-live-table-wrap table, .article-live-table-wrap tbody, .article-live-table-wrap tr, .article-live-table-wrap td { display: block; width: 100%; min-width: 0; }
      .article-live-table-wrap thead { display: none; }
      .article-live-table-wrap tr { margin-bottom: .75rem; overflow: hidden; border: 1px solid rgba(226,232,240,.18); border-radius: 12px; }
      .article-live-table-wrap td { display: grid; grid-template-columns: minmax(6.25rem, .42fr) minmax(0, 1fr); gap: .65rem; border: 0; border-bottom: 1px solid rgba(226,232,240,.1); }
      .article-live-table-wrap td:last-child { border-bottom: 0; }
      .article-live-table-wrap td::before { content: attr(data-label); color: #f0c674; font-weight: 700; }
    }

    :root {
      --gold: #e5b84a;
      --gold-light: #f5d98c;
      --gold-dark: #c49a2a;
      --teal: #2dd4bf;
      --navy: #080c18;
      --navy-2: #060a14;
      --card: rgba(255,255,255,.04);
      --border: rgba(255,255,255,.10);
    }

    .container { width: min(1180px, 100%); margin: 0 auto; padding: 0 1.5rem; }

    .gold-text {
      background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      padding: 6px 16px;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
      color: #080c18;
      font-family: "Sora", sans-serif;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(229,184,74,.35);
      transition: all .3s;
      border: none;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(229,184,74,.5); }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.2);
      background: rgba(255,255,255,.06);
      color: #fff;
      font-family: "Sora", sans-serif;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all .3s;
    }
    .btn-outline:hover { border-color: rgba(229,184,74,.4); transform: translateY(-2px); }
    .btn-outline.cta-assessment-lite {
      padding: 9px 15px;
      min-height: 40px;
      border-radius: 999px;
      border-color: rgba(255,255,255,.14);
      background: rgba(255,255,255,.035);
      color: rgba(255,255,255,.74);
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: none;
      animation: none;
    }
    .btn-outline.cta-assessment-lite:hover {
      color: #fff;
      border-color: rgba(45,212,191,.32);
      background: rgba(45,212,191,.06);
      transform: translateY(-1px);
    }

    @keyframes pulseGold {
      0%,100% { box-shadow: 0 4px 20px rgba(229,184,74,.35); }
      50% { box-shadow: 0 4px 20px rgba(229,184,74,.65), 0 0 0 10px rgba(229,184,74,.06); }
    }
    .pulse { animation: pulseGold 2.5s ease-in-out infinite; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-up { animation: fadeUp .6s ease forwards; }

    @media (max-width: 720px) {
      .container { padding: 0 1.1rem; }
      .btn-gold,
      .btn-outline { max-width: 100%; }
      .btn-outline.cta-assessment-lite { width: 100%; justify-content: center; }
    }

    @media (max-width: 460px) {
      .container { padding: 0 .95rem; }
    }

    @supports (content-visibility: auto) {
      main > section:not(:first-child),
      main > article,
      body > footer {
        content-visibility: auto;
        contain-intrinsic-size: auto 800px;
      }
    }

    @media (max-width: 760px) {
      .pulse,
      .animate-up {
        animation: none !important;
      }

      .animate-up {
        opacity: 1 !important;
        transform: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
      .article-live-card {
      border: 1px solid #d8cfbb;
      border-top: 4px solid #687e70;
      border-radius: 4px;
      background: #f4f0e5;
      color: #28302b;
      box-shadow: 0 8px 24px rgba(38, 31, 20, .07);
    }
    .article-live-visual[data-visual-type="matrix"] .article-live-card { border-top-color: #9a624c; }
    .article-live-visual[data-visual-type="chain"] .article-live-card { border-top-color: #537f8b; }
    .article-live-visual[data-visual-type="checklist"] .article-live-card { border-top-color: #79834d; }
    .article-live-visual[data-visual-type="proof"] .article-live-card { border-top-color: #b17b32; }
    .article-live-card h3 { color: #28302b; font-family: Georgia, 'Times New Roman', serif; font-weight: 600; letter-spacing: -.015em; }
    .article-live-item { border-color: #d9d1c1; }
    .article-live-item__label, .article-live-need > summary, .article-live-more > summary { color: #79533d; }
    .article-live-item__text { color: #303934; }
    .article-live-items--chain .article-live-item::marker { color: #537f8b; }
    .article-live-items--checklist .article-live-item__text::before { color: #58755b; }
    .article-live-need { border-color: #d9d1c1; }
    .article-live-stat { border-color: #d9d1c1; border-radius: 3px; background: #fbf8ef; }
    .article-live-stat strong { color: #28302b; }
    .article-live-stat span { color: #79533d; }
    .article-live-stat small { color: #515951; }
    .article-live-table-wrap table { color: #303934; }
    .article-live-table-wrap th, .article-live-table-wrap td { border-color: #d1c8b6; }
    .article-live-table-wrap th { background: #e9e2d2; color: #594536; }
    .article-live-table-wrap td::before { color: #79533d; }
    .article-live-visual figcaption { color: #d0d2ce; }
    .article-live-more > summary { cursor: pointer; font-size: max(14px, 1rem); font-weight: 700; line-height: 1.45; }
</style>
</head>
<body>
  {(isCareerGuidanceService || isAssessmentService) && <BusinessPerspectiveNote serviceBanner={true} />}
  {needsContentLandmark ? <main id="page-content" aria-label={title}><slot /></main> : <slot />}
  {/* The image groups below are moved into place in the finished HTML by integrations/place-page-media.mjs; there is no browser script. */}
  {Astro.url.pathname.startsWith('/services/') && <BofuImage />}
  {Astro.url.pathname.startsWith('/services/') && <BofuContextVisual />}
  {isDashboardRoute ? null : <ConsentBanner />}
</body>
</html>
