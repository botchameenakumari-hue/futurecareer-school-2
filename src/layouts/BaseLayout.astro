---
import { DEFAULT_OG_IMAGE_URL, SITE_NAME } from '../config/site';
import ConsentBanner from '../components/ConsentBanner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE_URL,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const isDashboardRoute = Astro.url.pathname === '/dashboard' || Astro.url.pathname.startsWith('/dashboard/');
---

<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <GoogleAnalytics />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Future Career School" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Structured Data -->
  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': jsonLd } : jsonLd)} />
  )}

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Blog`} href="/rss.xml" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Global Styles -->
  <style is:global>
    /* Design tokens for Future Career School */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; overflow-x: clip; }
    body {
      background: #080c18;
      color: rgba(255,255,255,0.85);
      font-family: "DM Sans", "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
      min-width: 320px;
      overflow-x: clip;
      max-width: 100%;
    }
    h1,h2,h3,h4 { font-family: "Sora", "Trebuchet MS", sans-serif; line-height: 1.1; }
    h1,h2,h3,h4,p,li { overflow-wrap: break-word; word-break: normal; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    :root {
      --gold: #e5b84a;
      --gold-light: #f5d98c;
      --gold-dark: #c49a2a;
      --teal: #2dd4bf;
      --navy: #080c18;
      --navy-2: #060a14;
      --card: rgba(255,255,255,.04);
      --border: rgba(255,255,255,.10);
    }

    .container { width: min(1180px, 100%); margin: 0 auto; padding: 0 1.5rem; }

    .gold-text {
      background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      padding: 6px 16px;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
      color: #080c18;
      font-family: "Sora", sans-serif;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(229,184,74,.35);
      transition: all .3s;
      border: none;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(229,184,74,.5); }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.2);
      background: rgba(255,255,255,.06);
      color: #fff;
      font-family: "Sora", sans-serif;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all .3s;
    }
    .btn-outline:hover { border-color: rgba(229,184,74,.4); transform: translateY(-2px); }
    .btn-outline.cta-assessment-lite {
      padding: 9px 15px;
      min-height: 40px;
      border-radius: 999px;
      border-color: rgba(255,255,255,.14);
      background: rgba(255,255,255,.035);
      color: rgba(255,255,255,.74);
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: none;
      animation: none;
    }
    .btn-outline.cta-assessment-lite:hover {
      color: #fff;
      border-color: rgba(45,212,191,.32);
      background: rgba(45,212,191,.06);
      transform: translateY(-1px);
    }

    @keyframes pulseGold {
      0%,100% { box-shadow: 0 4px 20px rgba(229,184,74,.35); }
      50% { box-shadow: 0 4px 20px rgba(229,184,74,.65), 0 0 0 10px rgba(229,184,74,.06); }
    }
    .pulse { animation: pulseGold 2.5s ease-in-out infinite; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-up { animation: fadeUp .6s ease forwards; }

    @media (max-width: 720px) {
      .container { padding: 0 1.1rem; }
      .btn-gold,
      .btn-outline { max-width: 100%; }
      .btn-outline.cta-assessment-lite { width: 100%; justify-content: center; }
    }

    @media (max-width: 460px) {
      .container { padding: 0 .95rem; }
    }

    @supports (content-visibility: auto) {
      main > section:not(:first-child),
      main > article,
      body > footer {
        content-visibility: auto;
        contain-intrinsic-size: auto 800px;
      }
    }

    @media (max-width: 760px) {
      .pulse,
      .animate-up {
        animation: none !important;
      }

      .animate-up {
        opacity: 1 !important;
        transform: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
  <slot />
  {isDashboardRoute ? null : <ConsentBanner />}
</body>
</html>
