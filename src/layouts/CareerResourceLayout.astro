---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LinkDirectorySection, { type LinkDirectoryItem } from '../components/LinkDirectorySection.astro';

type JumpLink = {
  href: string;
  label: string;
};

export interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow?: string;
  quickAnswer?: string;
  quickPoints?: string[];
  jumpLinks?: JumpLink[];
  relatedItems?: LinkDirectoryItem[];
  jsonLdExtras?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  eyebrow = 'Career Resource',
  quickAnswer,
  quickPoints = [],
  jumpLinks = [],
  relatedItems = [],
  jsonLdExtras = [],
  noindex = false,
} = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Career Resources', item: 'https://futurecareerschool.com/career-resources' },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    inLanguage: 'en-IN',
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  ...jsonLdExtras,
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
  noindex={noindex}
>
  <Nav />

  <main id="resource-article">
    <header class="resource-hero">
      <div class="container">
        <nav class="resource-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/career-resources">Career Resources</a>
          <span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">{title}</span>
        </nav>

        <div class="resource-pill pill">
          <span class="pill-dot"></span>
          {eyebrow}
        </div>

        <h1 class="resource-title">{title}</h1>
        <p class="resource-sub">{description}</p>

        {(quickAnswer || quickPoints.length > 0) && (
          <section class="resource-quick card" aria-label="Quick answer">
            <strong>Quick answer</strong>
            {quickAnswer && <p>{quickAnswer}</p>}
            {quickPoints.length > 0 && (
              <ul>
                {quickPoints.map((point) => <li>{point}</li>)}
              </ul>
            )}
          </section>
        )}

        {jumpLinks.length > 0 && (
          <nav class="resource-jump-nav card" aria-label="On this page">
            <span class="resource-jump-label">Jump to</span>
            <div class="resource-jump-links">
              {jumpLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </nav>
        )}
      </div>
    </header>

    <article class="container resource-body">
      <slot />
    </article>

    {relatedItems.length > 0 && (
      <LinkDirectorySection
        sectionId="resource-related-links"
        title="Keep Going From Here"
        subtitle="Open the next page that helps you narrow the decision instead of restarting from scratch."
        items={relatedItems}
        altBackground={true}
      />
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  #resource-article { padding-top: 72px; }

  .resource-hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 46px;
  }
  .resource-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 10%, rgba(229,184,74,.13), transparent 40%),
      radial-gradient(circle at 82% 0%, rgba(45,212,191,.08), transparent 38%);
    pointer-events: none;
  }
  .resource-hero > .container {
    position: relative;
    z-index: 1;
  }

  .resource-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: rgba(255,255,255,.44);
    font-size: 13px;
    margin-bottom: 1.15rem;
  }
  .resource-breadcrumb a {
    color: rgba(255,255,255,.58);
  }
  .resource-breadcrumb a:hover {
    color: rgba(255,255,255,.9);
  }

  .resource-pill {
    color: rgba(255,255,255,.7);
    margin-bottom: 1rem;
  }

  .resource-title {
    font-size: clamp(2.05rem, 4.4vw, 3.45rem);
    line-height: 1.04;
    letter-spacing: -.045em;
    max-width: 900px;
  }
  .resource-sub {
    color: rgba(255,255,255,.72);
    font-size: clamp(1rem, 1.45vw, 1.12rem);
    line-height: 1.85;
    max-width: 860px;
    margin-top: 1rem;
  }

  .resource-quick {
    margin-top: 1.5rem;
    max-width: 900px;
    padding: 1.2rem 1.2rem 1.15rem;
    border-color: rgba(229,184,74,.16);
    background:
      radial-gradient(circle at 100% 0%, rgba(229,184,74,.1), transparent 42%),
      linear-gradient(145deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
    box-shadow: 0 18px 44px rgba(0,0,0,.18);
  }
  .resource-quick strong {
    display: block;
    color: #fff;
    font-family: "Sora", sans-serif;
    font-size: .98rem;
    margin-bottom: .7rem;
  }
  .resource-quick p,
  .resource-quick li {
    color: rgba(255,255,255,.76);
    font-size: 15px;
    line-height: 1.75;
  }
  .resource-quick ul {
    margin-top: .7rem;
    padding-left: 1.1rem;
    display: grid;
    gap: .45rem;
  }

  .resource-body {
    width: min(860px, 100%);
    padding: 0 1.5rem 5.6rem;
  }
  .resource-jump-nav {
    margin-top: 1rem;
    max-width: 900px;
    padding: .95rem 1rem;
    border-color: rgba(255,255,255,.1);
    background:
      radial-gradient(circle at 100% 0%, rgba(45,212,191,.08), transparent 40%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.02));
  }
  .resource-jump-label {
    display: block;
    color: rgba(255,255,255,.55);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: .7rem;
  }
  .resource-jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
  }
  .resource-jump-links a {
    display: inline-flex;
    align-items: center;
    padding: .45rem .75rem;
    border-radius: 999px;
    background: rgba(255,255,255,.045);
    color: rgba(255,255,255,.82);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .resource-jump-links a:hover {
    background: rgba(229,184,74,.12);
    color: var(--gold-light);
  }
  .resource-body > :global(*) + :global(*) {
    margin-top: 1.4rem;
  }
  .resource-body :global(section) {
    margin-top: 2.4rem;
  }
  .resource-body :global(h2) {
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -.03em;
    margin-bottom: .8rem;
  }
  .resource-body :global(h3) {
    font-size: clamp(1.08rem, 2.2vw, 1.3rem);
    line-height: 1.2;
    margin-bottom: .55rem;
  }
  .resource-body :global(p),
  .resource-body :global(li) {
    color: rgba(255,255,255,.78);
    line-height: 1.84;
    font-size: 16px;
  }
  .resource-body :global(ul),
  .resource-body :global(ol) {
    padding-left: 1.15rem;
    display: grid;
    gap: .62rem;
  }
  .resource-body :global(a) {
    color: var(--gold-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .resource-body :global(.callout),
  .resource-body :global(.resource-table-wrap),
  .resource-body :global(.resource-mini-grid) > :global(article),
  .resource-body :global(.resource-step-list) > :global(li),
  .resource-body :global(.resource-link-list) > :global(li) {
    border: 1px solid rgba(255,255,255,.1);
    background:
      radial-gradient(circle at 100% 0%, rgba(229,184,74,.06), transparent 38%),
      linear-gradient(145deg, rgba(255,255,255,.04), rgba(255,255,255,.018));
    border-radius: 22px;
    box-shadow: 0 14px 32px rgba(0,0,0,.14);
  }

  .resource-body :global(.callout) {
    padding: 1.15rem 1.15rem 1.05rem;
  }
  .resource-body :global(.callout strong) {
    display: block;
    color: #fff;
    font-family: "Sora", sans-serif;
    margin-bottom: .45rem;
  }

  .resource-body :global(.resource-mini-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .resource-body :global(.resource-mini-grid) > :global(article) {
    padding: 1.05rem 1rem;
  }

  .resource-body :global(.resource-step-list),
  .resource-body :global(.resource-link-list) {
    list-style: none;
    padding-left: 0;
  }
  .resource-body :global(.resource-step-list) > :global(li),
  .resource-body :global(.resource-link-list) > :global(li) {
    padding: 1.05rem 1rem;
  }
  .resource-body :global(.resource-step-list strong),
  .resource-body :global(.resource-link-list strong) {
    color: #fff;
    font-family: "Sora", sans-serif;
  }

  .resource-body :global(.resource-table-wrap) {
    overflow-x: auto;
    padding: .35rem;
  }
  .resource-body :global(.resource-table) {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
  }
  .resource-body :global(.resource-table th),
  .resource-body :global(.resource-table td) {
    padding: .95rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .resource-body :global(.resource-table th) {
    color: #fff;
    font-family: "Sora", sans-serif;
    font-size: .9rem;
    line-height: 1.35;
  }
  .resource-body :global(.resource-table td) {
    color: rgba(255,255,255,.76);
    font-size: 15px;
    line-height: 1.72;
  }
  .resource-body :global(.resource-table tr:last-child td) {
    border-bottom: none;
  }

  .resource-body :global(.resource-source-list) {
    display: grid;
    gap: .75rem;
    margin-top: .9rem;
  }
  .resource-body :global(.resource-source-list li) {
    color: rgba(255,255,255,.76);
  }

  @media (max-width: 760px) {
    .resource-hero {
      padding: 82px 0 36px;
    }
    .resource-body {
      padding: 0 1.05rem 5rem;
    }
    .resource-body :global(.resource-mini-grid) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .resource-quick {
      padding: 1rem .95rem;
      border-radius: 18px;
    }
    .resource-jump-nav {
      padding: .9rem .9rem .95rem;
      border-radius: 18px;
    }
    .resource-jump-links {
      display: grid;
      grid-template-columns: 1fr;
      gap: .45rem;
    }
    .resource-jump-links a {
      justify-content: center;
      text-align: center;
    }
    .resource-body :global(.callout),
    .resource-body :global(.resource-mini-grid) > :global(article),
    .resource-body :global(.resource-step-list) > :global(li),
    .resource-body :global(.resource-link-list) > :global(li) {
      padding: .95rem .9rem;
      border-radius: 18px;
    }
    .resource-body :global(.resource-table-wrap) {
      padding: .15rem;
      border-radius: 18px;
    }
    .resource-body :global(.resource-table th),
    .resource-body :global(.resource-table td) {
      padding: .8rem .8rem;
    }
  }
</style>
