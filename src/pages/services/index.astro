<script>
  const serviceBrowser = document.querySelector('[data-service-browser]');

  if (serviceBrowser) {
    const controls = serviceBrowser.querySelector('#service-controls');
    const grid = serviceBrowser.querySelector('#service-results');
    const cards = Array.from(serviceBrowser.querySelectorAll('[data-service-card]'));
    const searchInput = serviceBrowser.querySelector('#service-search');
    const categorySelect = serviceBrowser.querySelector('#service-category');
    const audienceSelect = serviceBrowser.querySelector('#service-audience');
    const needSelect = serviceBrowser.querySelector('#service-need');
    const sortSelect = serviceBrowser.querySelector('#service-sort');
    const pageSizeSelect = serviceBrowser.querySelector('#service-page-size');
    const resetButton = serviceBrowser.querySelector('#service-reset');
    const quickButtons = Array.from(serviceBrowser.querySelectorAll('[data-quick-category], [data-quick-audience], [data-quick-need]'));
    const status = serviceBrowser.querySelector('#service-status');
    const statusRow = serviceBrowser.querySelector('.service-status-row');
    const emptyState = serviceBrowser.querySelector('#service-empty');
    const pagination = serviceBrowser.querySelector('#service-pagination');
    const prevButton = serviceBrowser.querySelector('#service-prev');
    const nextButton = serviceBrowser.querySelector('#service-next');
    const pageStatus = serviceBrowser.querySelector('#service-page-status');
    let currentPage = 1;

    const normalize = (value) => (value || '').toString().toLowerCase().trim();

    const getSortedMatches = () => {
      const query = normalize(searchInput.value);
      const category = categorySelect.value;
      const audience = audienceSelect.value;
      const need = needSelect.value;
      const sort = sortSelect.value;

      return cards
        .filter((card) => {
          const searchText = normalize(card.dataset.search);
          const audienceTokens = (card.dataset.audiences || '').split(' ');
          const categoryMatches = !category || card.dataset.category === category;
          const audienceMatches = !audience || audienceTokens.includes(audience);
          const needMatches = !need || card.dataset.need === need;
          const searchMatches = !query || searchText.includes(query);
          return categoryMatches && audienceMatches && needMatches && searchMatches;
        })
        .sort((a, b) => {
          if (sort === 'az') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          if (sort === 'category') {
            const categorySort = (a.dataset.category || '').localeCompare(b.dataset.category || '');
            if (categorySort !== 0) return categorySort;
          }
          return Number(a.dataset.order || 0) - Number(b.dataset.order || 0);
        });
    };

    const render = () => {
      const pageSize = Number(pageSizeSelect.value || 12);
      const matches = getSortedMatches();
      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const start = (currentPage - 1) * pageSize;
      const visibleCards = matches.slice(start, start + pageSize);

      cards.forEach((card) => {
        card.hidden = true;
        card.setAttribute('aria-hidden', 'true');
      });

      matches.forEach((card) => grid.appendChild(card));

      visibleCards.forEach((card) => {
        card.hidden = false;
        card.removeAttribute('aria-hidden');
      });

      emptyState.hidden = matches.length !== 0;
      pagination.hidden = matches.length <= pageSize;
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;
      pageStatus.textContent = `Page ${currentPage} of ${totalPages}`;

      if (matches.length === 0) {
        status.textContent = 'No service pages match the current filters.';
        return;
      }

      const end = Math.min(start + pageSize, matches.length);
      status.textContent = `Showing ${start + 1}-${end} of ${matches.length} service pages.`;
    };

    const scrollToResults = () => {
      requestAnimationFrame(() => {
        (statusRow || grid).scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    };

    const clearQuickState = () => {
      quickButtons.forEach((button) => button.classList.remove('is-active'));
    };

    const resetToFirstPage = () => {
      clearQuickState();
      currentPage = 1;
      render();
    };

    controls.addEventListener('submit', (event) => event.preventDefault());
    searchInput.addEventListener('input', resetToFirstPage);
    categorySelect.addEventListener('change', resetToFirstPage);
    audienceSelect.addEventListener('change', resetToFirstPage);
    needSelect.addEventListener('change', resetToFirstPage);
    sortSelect.addEventListener('change', resetToFirstPage);
    pageSizeSelect.addEventListener('change', resetToFirstPage);

    resetButton.addEventListener('click', () => {
      searchInput.value = '';
      categorySelect.value = '';
      audienceSelect.value = '';
      needSelect.value = '';
      sortSelect.value = 'recommended';
      pageSizeSelect.value = '12';
      clearQuickState();
      currentPage = 1;
      render();
      scrollToResults();
    });

    prevButton.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      render();
      scrollToResults();
    });

    nextButton.addEventListener('click', () => {
      currentPage += 1;
      render();
      scrollToResults();
    });

    quickButtons.forEach((button) => {
      button.addEventListener('click', () => {
        clearQuickState();
        button.classList.add('is-active');
        searchInput.value = '';
        categorySelect.value = button.dataset.quickCategory || '';
        audienceSelect.value = button.dataset.quickAudience || '';
        needSelect.value = button.dataset.quickNeed || '';
        sortSelect.value = 'recommended';
        currentPage = 1;
        render();
        scrollToResults();
      });
    });

    render();
  }
</script>
