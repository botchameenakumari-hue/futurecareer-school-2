---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LinkDirectorySection from '../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS, BOFU_PAYMENT_LINKS } from '../../config/bofu';

const guidanceDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance',
    title: 'Career Counselling and Guidance',
    description: 'Broader help with stream, course, skill, and next-step decisions when one choice affects everything else.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'Practical direction for people who need clearer next steps, stronger trade-offs, and better skill choices.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling/',
    title: 'Career Counselling',
    description: 'Clarity-first support when the decision feels personal, confusing, or emotionally heavy.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'For people who need practical online career counselling without depending on a local offline option.',
  },
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'City-intent guidance pages for people who want local search relevance without falling back into generic advice.',
  },
  {
    href: BOFU_INTERNAL_LINKS.visakhapatnamCounselling,
    title: 'Career Counselling in Visakhapatnam',
    description: 'For people in Visakhapatnam who want clearer next steps, stronger skill direction, and practical counselling support.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coach-near-me/',
    title: 'Career Coach Near Me',
    description: 'Online career coaching across India for people who want real guidance, not just local proximity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerGuidanceOnline,
    title: 'Career Guidance Online',
    description: 'For people who want practical online career guidance without waiting for a local offline option.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'For stream, course, degree, and next-step decisions after school.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12thOnline,
    title: 'Career Guidance After 12th Online',
    description: 'For students and parents who need after-12th guidance online without waiting for local options.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description: 'For pivots, salary growth, stagnation, and stronger long-term leverage.',
  },
];

const assessmentDirectoryItems = [
  {
    href: '/services/assessments',
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments across school, college, graduate, and professional stages.',
  },
  {
    href: '/services/assessments/class-10-and-below/',
    title: 'Class 10 and Below Assessment',
    description: 'Stream-fit, strength-mapping, and early direction before Class 11 choices harden.',
  },
  {
    href: '/services/assessments/class-11-to-12/',
    title: 'Class 11 to 12 Assessment',
    description: 'Course-fit, degree direction, and after-school decision support before bigger commitments.',
  },
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduates and Early Professionals Assessment',
    description: 'Free clarity on fit, skill direction, employability, and market-ready next steps.',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professionals and Career Changers Assessment',
    description: 'Free input for pivots, salary growth, role fit, and stronger leverage decisions.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-10th/',
    title: 'Career Aptitude Test After 10th',
    description: 'A focused free aptitude test for students choosing a stream after Class 10.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-10th/',
    title: 'Stream Selector Test After 10th',
    description: 'A focused free stream quiz for Science, Commerce, or Arts decisions after Class 10.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-12th/',
    title: 'Stream Selector Test After 12th',
    description: 'A focused free quiz for course and path direction after Class 12.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-12th/',
    title: 'Career Aptitude Test After 12th',
    description: 'A focused free aptitude test for students choosing a degree, course, or training path after Class 12.',
  },
];

const toolDirectoryItems = [
  {
    href: '/skill-finder',
    title: 'Skill Finder',
    description: 'A free tool for narrowing the skill paths that fit your strengths and market direction.',
  },
  {
    href: '/career-resources',
    title: 'Career Resources',
    description: 'Free guides, roadmaps, and checklists for acting on your next move.',
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://futurecareerschool.com/services" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Services | Future Career School",
    "description": "Career counselling, career guidance, assessments, and free skill resources for students, freshers, and working professionals in India. Choose the right starting point for your stage.",
    "url": "https://futurecareerschool.com/services",
    "inLanguage": "en-IN",
    "publisher": {
      "@type": "EducationalOrganization",
      "name": "Future Career School",
      "url": "https://futurecareerschool.com"
    }
  }
];
---

<BaseLayout
  title="Services | Career Guidance, Assessments, and Skill Resources | Future Career School"
  description="Explore Future Career School services for students, freshers, and working professionals in India: career counselling, career guidance, assessments, and free skill-building resources."
  canonical="https://futurecareerschool.com/services"
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Services</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling, career guidance, and assessments across India
      </div>

      <h1 class="hero-title">
        Choose the Right Service Track for
        <span class="gold-text"> Your Current Stage</span>
      </h1>
      <p class="hero-sub">
        Future Career School is built for decisions that matter: stream selection, degree direction,
        skill selection, career pivots, and achieving earlier financial freedom.
        Career counselling, career guidance, career coaching, and career strategy often point to the same practical need: better decisions and stronger skill direction.
      </p>
      <p class="hero-sub hero-sub-secondary">
        Many providers charge thousands for outdated or impractical assessments.
        Here, the career and skill assessments are fully free, updated, practical, and AI-powered.
      </p>

      <div class="hero-actions">
        <a href={BOFU_PAYMENT_LINKS.students} class="btn-gold pulse">Get Student Career Guidance</a>
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <section id="tracks">
    <div class="container">
      <h2 class="section-headline">Three Tracks, Shared Direction</h2>
      <p class="section-sub">
        Each track has a clear job. Career guidance improves decisions, assessments improve decision quality, and free resources help you keep moving between those bigger choices.
      </p>

      <div class="track-grid">
        <article class="track card">
          <div class="track-kicker">Career Guidance</div>
          <h3>Career Guidance, Counselling, and Coaching</h3>
          <p>
            People search with different labels, but the practical need is usually the same:
            a clear answer to what to do next and why.
            The stronger direction is higher-value skill building, proof of work, better income growth, and a clearer route toward achieving earlier financial freedom.
          </p>
          <ul>
            <li>Stream selection and degree direction</li>
            <li>Career change planning and risk control</li>
            <li>Skill direction based on market-fit</li>
            <li>Proof of work and income-growth direction</li>
          </ul>
          <a class="track-link" href="/services/career-counselling-and-career-guidance">Explore Career Guidance &rsaquo;</a>
        </article>

        <article class="track card track-featured">
          <div class="track-kicker">Assessments</div>
          <h3>Assessments and Career Tests</h3>
          <p>
            A structured assessment layer for psychometric tests, career aptitude tests, interest tests,
            stream selection tests, and readiness checks.
            Unlike the outdated, impractical assessments many providers charge thousands for, these assessments are free, updated, practical, and AI-powered.
          </p>
          <ul>
            <li>Psychometric career tests</li>
            <li>Career aptitude and interest tests</li>
            <li>Job readiness and skill readiness</li>
            <li>Audience-specific test mapping</li>
          </ul>
          <a class="track-link" href="/services/assessments">Explore Assessments &rsaquo;</a>
        </article>

        <article class="track card">
          <div class="track-kicker">Execution</div>
          <h3>Skill Roadmaps and Execution Resources</h3>
          <p>
            Once direction is clear, execution support focuses on consistent action: skill roadmap, proof-of-work,
            portfolio, and positioning for better roles and income.
          </p>
          <ul>
            <li>Skill roadmap selection</li>
            <li>Portfolio and proof-of-work planning</li>
            <li>Job search strategy and positioning</li>
            <li>Long-term income strategy</li>
          </ul>
          <a class="track-link" href="/career-resources?topic=skills&type=roadmap">Browse Skill Roadmaps &rsaquo;</a>
        </article>
      </div>
    </div>
  </section>

  <section id="who">
    <div class="container">
      <h2 class="section-headline">Students and Working Professionals</h2>
      <p class="section-sub">
        The right path depends on your stage, but the foundations stay the same: practical assessments, high-value skill building, market readiness, and a route toward achieving earlier financial freedom.
      </p>
      <div class="who-grid">
        <div class="who-card card">
          <div class="who-title">Students, Freshers, and Early-Career People</div>
          <p>Early direction, stream awareness, skill clarity, and stronger first-career decisions before pressure turns into expensive wrong turns.</p>
        </div>
        <div class="who-card card">
          <div class="who-title">Working Professional</div>
          <p>Stronger positioning, career pivots, and a clearer route toward achieving earlier financial freedom through better skill stacking.</p>
        </div>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="guidance-pages"
    title="Career Guidance for Different Situations"
    subtitle="Explore the guidance option that fits your current decision, stage, or pressure."
    items={guidanceDirectoryItems}
  />

  <LinkDirectorySection
    sectionId="assessment-pages"
    title="Free Career Assessments by Stage"
    subtitle="Choose the free assessment that matches your stage, whether you need stream clarity, aptitude signals, or career-direction input."
    items={assessmentDirectoryItems}
    altBackground={true}
  />

  <LinkDirectorySection
    sectionId="tools-and-resources"
    title="Free Tools and Practical Resources"
    subtitle="Free tools and resources that help you build momentum before or between bigger career decisions."
    items={toolDirectoryItems}
  />

  <section id="cta">
    <div class="container">
      <div class="cta-inner card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <div class="pill cta-pill">Next step</div>
      <h2 class="cta-title">Choose the Strongest Next Step</h2>
      <p class="cta-sub">
        Start with the free updated practical AI-powered career and skill assessments, then move to the student or working-professional guidance path that fits your stage best.
      </p>
      <div class="cta-actions">
        <a href={BOFU_PAYMENT_LINKS.students} class="btn-gold pulse">Get Student Career Guidance</a>
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #tracks, #who { padding: 6rem 0; }
  #tracks { background: rgba(255,255,255,.012); }
  .section-tag { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 1.25rem; align-items: center; gap: 6px; }
  .section-headline { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-align: center; }
  .section-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.55); max-width: 720px; margin: 0 auto 3rem; text-align: center; line-height: 1.7; }

  .track-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .track { padding: 1.9rem; display: flex; flex-direction: column; }
  .track-featured { border-color: rgba(229,184,74,.25); background: linear-gradient(135deg, rgba(229,184,74,.06), rgba(255,255,255,.02)); }
  .track-kicker { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--gold); margin-bottom: .7rem; }
  .track h3 { font-size: 1.2rem; color: #fff; margin-bottom: .75rem; }
  .track p { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.75; margin-bottom: 1rem; }
  .track ul { list-style: none; display: flex; flex-direction: column; gap: .55rem; margin-bottom: 1.25rem; }
  .track li { font-size: 13px; color: rgba(255,255,255,.65); padding-left: 1rem; position: relative; line-height: 1.55; }
  .track li::before { content: '>'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
  .track-link { margin-top: auto; font-size: 13px; font-weight: 800; color: var(--gold); }
  .who-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .who-card { padding: 1.6rem; }
  .who-title { font-family: "Sora", sans-serif; font-size: 14px; font-weight: 800; letter-spacing: -.02em; margin-bottom: .55rem; color: #fff; }
  .who-card p { font-size: 13.5px; color: rgba(255,255,255,.55); line-height: 1.7; margin-bottom: 1rem; }

  #cta { padding: 6rem 0 7rem; }
  .cta-inner { position: relative; overflow: hidden; padding: 3.25rem; text-align: center; border-color: rgba(229,184,74,.14); background: rgba(229,184,74,.02); }
  .cta-glow { position: absolute; inset: 0; background: radial-gradient(circle at 50% 0%, rgba(229,184,74,.16), transparent 60%); pointer-events: none; }
  .cta-content { position: relative; z-index: 1; }
  .cta-pill { margin: 0 auto 1.4rem; width: fit-content; color: rgba(255,255,255,.55); }
  .cta-title { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 900; letter-spacing: -.03em; color: #fff; margin-bottom: .9rem; }
  .cta-sub { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.75; max-width: 620px; margin: 0 auto 2.25rem; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 980px) {
    .track-grid { grid-template-columns: 1fr; }
    .who-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    #hero { padding: 120px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
    .cta-inner { padding: 2.25rem 1.5rem; }
    .cta-actions { flex-direction: column; align-items: stretch; }
    .cta-actions .btn-gold, .cta-actions .btn-outline { justify-content: center; }
  }
  @media (max-width: 520px) {
    #tracks, #who { padding: 4.5rem 0; }
    #cta { padding: 4.5rem 0 5.5rem; }
    .hero-sub { font-size: 14.5px; line-height: 1.72; }
    .track,
    .who-card { padding: 1.3rem 1.15rem; }
    .cta-inner { padding: 2rem 1rem; }
  }
</style>
