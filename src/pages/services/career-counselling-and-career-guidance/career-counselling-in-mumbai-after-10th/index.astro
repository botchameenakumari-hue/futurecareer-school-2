---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title =
  'Career Counselling in Mumbai After 10th | FYJC Cutoffs & Stream Choice | Future Career School';
const description =
  "Career counselling in Mumbai after 10th for students and parents deciding between 11th (Science, Commerce, Arts), an early JEE/NEET foundation-coaching commitment, or a diploma/vocational route - before Mumbai's FYJC centralized online admission and percentage-cutoff rounds make the choice for you.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-in-mumbai-after-10th/';

const class10AssessmentUrl = BOFU_ASSESSMENT_LINKS.class10AndBelow;
const streamSelectorUrl = BOFU_ASSESSMENT_LINKS.streamSelectorAfter10th;
const aptitudeAfter10thUrl = BOFU_ASSESSMENT_LINKS.careerAptitudeAfter10th;

const relatedDirectoryItems = [
  {
    href: streamSelectorUrl,
    title: 'Stream Selector Test After 10th',
    description: 'A free starting signal on Science, Commerce, or Arts fit before the FYJC preference form goes in.',
  },
  {
    href: aptitudeAfter10thUrl,
    title: 'Career Aptitude Test After 10th',
    description: 'Free aptitude signal for strengths and work style before deciding between 11th, a foundation-coaching commitment, or a diploma route.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-after-10th/',
    title: 'Career Counselling After 10th',
    description: "The national version of this decision - Science, Commerce, Arts, diploma, or ITI - if Mumbai's specific FYJC-cutoff pressure is not the main factor for you.",
  },
  {
    href: BOFU_INTERNAL_LINKS.mumbaiCounselling,
    title: 'Career Counselling in Mumbai',
    description: 'See the broader Mumbai page if the real question is a degree-stage, industry, or career-growth decision, not the stream decision right after 10th.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-class-10-students/',
    title: 'Career Counselling for Class 10 Students',
    description: 'The earlier version of this decision, for families reasoning through the Science, Commerce, or Arts stream choice before the 10th result is even out.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'For when the next decision moves from stream or diploma to a specific course, college, or entrance exam.',
  },
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'Compare other city-specific guidance pages if a different local context matters more to your decision.',
  },
];

const comparisonRows = [
  {
    left: "Filling FYJC preference forms by college reputation alone, without a real stream-fit answer first",
    right: "Testing genuine Science/PCM or PCB, Commerce, or Arts fit before the FYJC preference form locks in a round",
  },
  {
    left: 'Joining a 2-year JEE/NEET foundation-coaching batch because it runs alongside every FYJC junior college in Mumbai',
    right: 'Weighing a multi-year foundation-coaching commitment honestly against genuine interest and working style',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
];

const whatIsDecidedItems = [
  {
    title: '11th in Science, Commerce, or Arts, chosen through FYJC',
    body: "Mumbai runs its 11th-standard admissions through the FYJC (First Year Junior College) centralized online system: students submit a ranked list of junior college and stream preferences, and percentage-based cutoffs across multiple admission rounds decide the actual seat. The stream choice itself is the same Science, Commerce, or Arts decision every Indian student faces, but in Mumbai it gets filtered through this round-wise, cutoff-driven allocation process before it becomes real.",
  },
  {
    title: 'An early JEE/NEET foundation-coaching commitment',
    body: "Most FYJC junior colleges with a strong Science-stream reputation sit inside or alongside a dense foundation-coaching ecosystem, and many families sign up for a 2-year (sometimes longer) JEE or NEET coaching program at the same time as the FYJC admission itself. Signing up early can build a genuine head start for a strong-fit student, or lock a family into years of cost and pressure for a student who was never actually a fit for engineering or medicine.",
  },
  {
    title: 'A diploma, polytechnic, or vocational route',
    body: 'A diploma or ITI route after 10th remains a legitimate option in Mumbai too, though it competes for attention against a local culture that heavily assumes every capable student should chase a well-ranked FYJC Science-stream seat with coaching alongside it. That assumption is worth pressure-testing against genuine fit, not accepted as the only respectable option.',
  },
  {
    title: 'A choice made across a multi-round, cutoff-driven admission window',
    body: 'In Mumbai specifically, the FYJC process runs across several admission rounds with shifting percentage cutoffs at each college, which adds real, compressed time pressure on top of the usual 11th-admission and coaching-enrolment timeline.',
  },
];

const stageDifferenceItems = [
  {
    title: 'This is not the same conversation as the national after-10th page',
    body: "The Science-Commerce-Arts-versus-diploma question is the same everywhere in India, but Mumbai adds a specific extra layer: the FYJC centralized online admission system, with its round-wise percentage cutoffs, which changes both the timeline and the pressure around the same stream decision.",
  },
  {
    title: "It is also not the same as Mumbai's own broader counselling page",
    body: "Mumbai's main career counselling page is built around degree-stage, industry, and career-growth decisions for students and professionals already through school. This page is about the earlier fork: stream choice and an early coaching-commitment decision right after Class 10, filtered through the FYJC process.",
  },
  {
    title: "FYJC's round-wise cutoffs reach down to this decision early",
    body: "Because FYJC allocation runs across multiple rounds with percentage cutoffs that shift college by college, many families default to whichever stream and college combination clears a cutoff fastest, rather than the stream that genuinely fits the student.",
  },
  {
    title: 'Parents and students are both deciding under Mumbai-specific time pressure',
    body: 'Between board-result timelines, FYJC round deadlines, and foundation-coaching batches filling up within days, the after-10th decision in Mumbai often has to be made faster and with more competing pressure than in most other Indian cities.',
  },
];

const clarifyItems = [
  {
    title: 'Separate genuine fit from chasing whichever FYJC cutoff clears first',
    body: "A cutoff that happens to clear in an early round should not be the deciding factor on its own. Guidance should test working style, interest, and appetite for a multi-year foundation-coaching commitment specifically, not just react to which college and stream combination becomes available first.",
  },
  {
    title: 'Pressure-test the "chase the best-ranked FYJC college" instinct',
    body: "Choosing a stream purely to get into a specific well-ranked FYJC junior college is a real, common local pattern - but it is worth an honest look at whether that college's Science-and-coaching culture actually fits the student, or whether it is pulling them toward a path they were never suited for.",
  },
  {
    title: 'Give diploma and vocational routes a fair, non-default hearing',
    body: 'A diploma or ITI route is a legitimate choice for the right student, not a consolation option in a city where FYJC-plus-coaching often feels like the only respectable path. The stronger question is whether the hands-on, faster-to-skill nature of that path actually fits how this student works.',
  },
  {
    title: 'Connect whichever path is chosen to a skill-building answer',
    body: 'Stream, foundation coaching, diploma, or vocational - the stronger question on top of any of them is which high-value skills get built alongside it, because the path alone does not create earlier financial freedom; the skill direction built on top of it does.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether an early coaching commitment gets tested against fit, not just enrolled by default',
    body: "If the conversation jumps straight to “which coaching institute near this FYJC college” without genuinely testing whether Science, PCM, or PCB fits this specific student, that is following local momentum, not doing the actual diagnostic work.",
  },
  {
    title: 'Check whether the FYJC-cutoff instinct gets questioned, not just accepted',
    body: "Good guidance should be willing to say plainly when chasing the highest-ranked FYJC college a cutoff allows does not actually serve this student, rather than reinforcing the same city-wide assumption everyone else is already making.",
  },
  {
    title: 'Check whether diploma and vocational routes get discussed as real options',
    body: "If every conversation defaults straight to “FYJC Science plus coaching, obviously” without genuinely weighing a diploma or ITI route for a hands-on-inclined student, that is a narrow process, not full guidance.",
  },
  {
    title: 'Check whether the assessments behind it are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments and present them like a required first step. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments instead.',
  },
];

const faqItems = [
  {
    question: 'How is this different from the general career counselling after 10th page?',
    answer:
      "The Science-Commerce-Arts-versus-diploma question itself is the same nationally, but Mumbai adds a specific local layer: the FYJC centralized online admission system, with round-wise percentage cutoffs across junior colleges, which changes the timeline and pressure around the same stream decision.",
  },
  {
    question: 'Should my child join a 2-year JEE or NEET foundation-coaching program right after 10th because our FYJC college runs one alongside it?',
    answer:
      "That depends entirely on genuine fit and appetite for a multi-year commitment, not on how common it is for a well-ranked FYJC junior college to sit alongside a coaching ecosystem. A structured look at working style and interest is more useful than following the local default.",
  },
  {
    question: "Should we choose a stream just to clear the cutoff for a specific well-ranked FYJC college?",
    answer:
      "That is a real local instinct worth examining honestly rather than accepting automatically. Chasing a college's cutoff has a real cost if it means two years in a stream that does not fit the student, so it deserves the same fit-based reasoning as any other stream decision.",
  },
  {
    question: 'Is a diploma or vocational route still a reasonable choice in Mumbai, given how much the city focuses on FYJC and coaching?',
    answer:
      "Yes. A diploma or ITI route remains a legitimate choice for the right student, regardless of how dominant the FYJC-plus-coaching path feels locally. The right choice depends on fit, not on which path is more common in Mumbai.",
  },
  {
    question: 'Are the after-10th career and skill assessments free?',
    answer:
      'Yes. The after-10th career and skill assessments, including the stream selector, are fully free. They can be described as updated, practical, and AI-powered, and they work as a starting signal before a deeper counselling conversation on stream, coaching, or vocational fit.',
  },
  {
    question: 'Is this available online, or do we need to visit an office in Mumbai?',
    answer:
      "Guidance is delivered fully online across India, so you can start the conversation from home within the same FYJC-round and coaching-enrolment window instead of depending on a local counsellor's limited availability.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling in Mumbai After 10th', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Mumbai After 10th | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling After 10th',
    areaServed: { '@type': 'City', name: 'Mumbai' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Mumbai After 10th</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling in Mumbai after 10th: stream, FYJC cutoffs, coaching, or a vocational route
      </div>

      <h1 class="hero-title">
        Career counselling in Mumbai after 10th
        <span class="gold-text"> before the FYJC round decides for you</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career counselling in Mumbai after 10th for students and parents who now have the result in hand and have to decide fast - not only between 11th Science, Commerce, or Arts, but through Mumbai's own FYJC (First Year Junior College) centralized online admission system, where round-wise percentage cutoffs at each college often end up deciding the stream by default. Many FYJC junior colleges also run alongside a dense JEE/NEET foundation-coaching ecosystem, adding a further multi-year commitment to the same decision. The right choice, built on genuine fit instead of whichever cutoff clears first, starts a skill portfolio aimed at earlier financial freedom instead of a decision made purely on panic or a round-wise scramble.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across Mumbai and India. You can start the conversation from home, inside the same short window FYJC rounds and coaching enrolments are already open in.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">
          Get Career Counselling After 10th for Students
        </a>
      </div>
      <p class="hero-support">
        The goal is not to predict a final career three weeks after the 10th result. It is to choose the next 2-3 years - 11th, a foundation-coaching commitment, or a vocational path - for genuine fit and working style, so it builds toward a high-value skill portfolio and earlier financial freedom instead of a decision made purely on Mumbai's own FYJC-round scramble.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-is-decided"
    title="What the after-10th decision actually involves in Mumbai"
    subtitle="Once the result is out, this stops being a single stream question. In Mumbai specifically, it runs through the FYJC centralized admission system and often arrives bundled with an early coaching-commitment decision too, and the choice that builds the strongest skill portfolio is what moves you toward earlier financial freedom - not the one picked fastest inside a cutoff round."
    items={whatIsDecidedItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get clarity before the next FYJC round or a coaching batch closes"
    body="FYJC rounds and foundation-coaching batches in Mumbai often move within days. Stronger reasoning now avoids a harder, more expensive switch later."
    studentHref="#plans"
    studentLabel="Get Career Counselling After 10th for Students"
  />

  <BofuStepFlowSection
    sectionId="how-this-differs"
    title="How this differs from the national after-10th page and Mumbai's own counselling page"
    subtitle="This decision sits at the intersection of two other pages on this site, but it is not quite the same conversation as either."
    items={stageDifferenceItems}
  >
    <div class="support-links card">
      <a href="/services/career-counselling-and-career-guidance/career-counselling-after-10th/">See the national Science/Commerce/Arts/diploma decision &rsaquo;</a>
      <a href={BOFU_INTERNAL_LINKS.mumbaiCounselling}>See Mumbai's broader career counselling page &rsaquo;</a>
    </div>
  </BofuStepFlowSection>

  <ComparisonMatrix
    sectionId="different"
    title="Why this decision needs sharper reasoning than Mumbai's own default"
    subtitle="These are the contrast points that matter most once a stream choice, an early coaching commitment, and FYJC's round-wise cutoffs are all pulling on the same decision."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="what-clarify"
    title="What career counselling in Mumbai after 10th should actually clarify"
    items={clarifyItems}
    variant="decision"
  >
    <AssessmentSupportNote
      body="As a starting point, the free after-10th assessments and stream selector can surface early signals on working style and path fit before a deeper counselling conversation."
      href={class10AssessmentUrl}
      label="Free career and skill assessments"
    />
  </BofuFeatureSection>

  <BuyerChecks
    title="What to check before paying for career counselling in Mumbai after 10th"
    subtitle="The goal is a path decision the whole family can defend within the FYJC and coaching-enrolment window, not a rushed session that just repeats Mumbai's own default back to you."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Choose 11th, a coaching commitment, or a vocational route on fit, not on an FYJC round"
    body="If the result made everyone react instead of think, stronger reasoning now is cheaper than switching after a coaching batch or a term has already started."
    studentHref="#plans"
    studentLabel="Get Career Counselling After 10th for Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling After 10th"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See free path-fit assessments, the national after-10th page, Mumbai's broader counselling page, and other useful resources before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Decide 11th, coaching, or a vocational route with real reasoning before the window closes"
    subtitle="Use career counselling in Mumbai after 10th if the result is in and 11th, an early coaching commitment, and a vocational route all feel like open questions right now. The right path, chosen for fit, is what starts the skill portfolio that leads toward earlier financial freedom - instead of letting Mumbai's own FYJC-round scramble make the call."
    studentHref="#plans"
    studentLabel="Get Career Counselling After 10th for Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.75rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-clarify,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.8rem, 9.6vw, 2.5rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
