---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title = 'Career Guidance Online | Practical Direction Across India | Future Career School';
const description =
  'Career guidance online for students, freshers, and working professionals across India — clearer skill direction, stronger trade-offs, and a practical next step.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-online/';

const whenOnlineItems = [
  {
    title: 'Good local options are limited or unclear',
    body:
      'Strong guidance should not depend on what happens to exist in your city. Online access removes the search for the nearest decent option.',
  },
  {
    title: 'The decision matters now and cannot wait',
    body:
      'Admission windows, switching windows, and growth decisions do not pause for travel or scheduling around one local provider.',
  },
  {
    title: 'You want the decision quality, not the commute',
    body:
      'The real need is clearer reasoning around fit, skill direction, and risk, not proximity to an office.',
  },
  {
    title: 'You are comparing options that sit in different cities',
    body:
      'Online keeps the focus on the choice itself instead of forcing the decision around one location.',
  },
];

const decideItems = [
  {
    title: 'Path and skill direction',
    body:
      'Which path and high-value skill direction fits you best right now, based on fit, market reality, and risk.',
  },
  {
    title: 'Risk and wrong turns',
    body:
      'Which expensive wrong turns to avoid before more time, money, or effort goes into the wrong route.',
  },
  {
    title: 'Proof of work and positioning',
    body:
      'How to show skills and proof of work instead of leaning on a degree alone for credibility.',
  },
  {
    title: 'Income-growth direction',
    body:
      'A clearer route toward unlocking high income opportunities and achieving earlier financial freedom through a stronger skill portfolio, not just one skill choice.',
  },
];

const howItWorksItems = [
  {
    title: 'Share your real situation',
    body:
      'Bring your current stage, the decision under the most pressure, and the options you are genuinely weighing.',
  },
  {
    title: 'Map fit, skills, and risk together',
    body:
      'Profile, preferences, work style, market reality, and the trade-offs are looked at together instead of as separate guesses.',
  },
  {
    title: 'Leave with a practical next step',
    body:
      'You should finish with a tighter shortlist and a move you can act on, not vague advice you still need to decode later.',
  },
];

const prepItems = [
  {
    title: 'Your current stage and main decision',
    body:
      'Be clear about where you are now and the one decision that matters most so the session does not stay broad.',
  },
  {
    title: 'The options you are actually comparing',
    body:
      'Bring the 2 to 4 routes you are weighing, even if they are very different. Real trade-offs make the discussion sharper.',
  },
  {
    title: 'Where confusion or weak execution repeats',
    body:
      'Note the pattern that keeps stalling you, whether it is unclear direction, skill gaps, or starting and stopping.',
  },
  {
    title: 'Cost, city, and time limits',
    body:
      'If budget, location, or time pressure shape what is realistic, include them early so the plan still fits your reality.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Online guidance for stream, course, and early-direction choices',
    body:
      'When stream, degree, or early skill decisions feel unclear, online access means you get strong direction without first waiting to find a good local option.',
  },
  {
    label: 'Working Professionals',
    title: 'Online guidance for pivots, stagnation, and salary-ceiling pressure',
    body:
      'For switching fields, breaking a salary ceiling, handling AI-era shifts, or under-leveraged skills, the decision no longer has to depend on a commute or one nearby provider.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description:
      'Helps when several connected decisions — stream, course, skill, and next step — need to make sense together, not just one online choice.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerGuidance,
    title: 'Career Guidance',
    description:
      'Practical direction for stronger next steps, better trade-offs, and clearer skill choices.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'A clarity-led conversation focused on next-step reasoning, for when talking a decision through matters more than broad guidance language.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, salary growth, stagnation, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_INTERNAL_LINKS.assessments,
    title: 'Free Career Assessments',
    description:
      'Free, updated, practical, AI-powered assessments for strengths, preferences, work style, and direction.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coach-near-me/',
    title: 'Career Coach Near Me',
    description:
      'See the near-me version if locality or delivery format is part of your decision.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coach-online/',
    title: 'Career Coach Online',
    description:
      'See this if the direction is already set and what you need now is an ongoing plan and accountability, not another decision-support session.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance-expert-online/',
    title: 'Career Guidance Expert Online',
    description:
      'See this if what you actually want to check first is the expertise and process behind an online provider before you trust it with an important decision.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance actually narrows your confusion',
    body: 'Online should not make guidance more generic or slower. Look for a process that gathers enough context about your situation to give you clear trade-offs instead of broader advice that still leaves you guessing.',
  },
  {
    title: 'Check whether skills and path fit are both addressed clearly',
    body: 'Online guidance still needs to cover both the path choice and the skill direction connected to it. Do not settle for guidance that addresses only one or stays vague about practical skill building.',
  },
  {
    title: 'Check whether you can actually act on the reasoning without follow-up',
    body: 'The test of online guidance is whether you leave with enough clarity to move forward independently. If you need multiple follow-ups to understand the direction, the guidance was probably not complete enough.',
  },
  {
    title: 'Check whether the guidance respects that this decision matters right now',
    body: 'If the decision is urgent and you are choosing online over local, the guidance should help you move with confidence quickly, not drag the decision process further.',
  },
];

const faqItems = [
  {
    question: 'Does career guidance online actually work as well?',
    answer:
      'Yes. Online career guidance works well because the real work is clear reasoning around fit, skill direction, risk, and the next practical step rather than physical presence.',
  },
  {
    question: 'Who is online career guidance for?',
    answer:
      'It is for students, freshers, and working professionals across India who need stronger direction but do not want the decision to depend on finding a good local option first.',
  },
  {
    question: 'What should online career guidance help me decide?',
    answer:
      'It needs to help you judge path and skill direction, risk, proof of work, and income-growth direction — with trade-offs clear enough to act on before another wrong turn gets expensive.',
  },
  {
    question: 'Is online career guidance different from career counselling or career coaching?',
    answer:
      'In practice, career guidance, career counselling, career coaching, and career strategy point to the same practical service family: clearer decisions and stronger skill direction. The focus here is the broader online decision-support need. If you already have a direction and specifically need ongoing execution and accountability, the dedicated career coach online page covers that angle directly.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered. Many providers charge thousands for outdated or impractical assessments; these are a stronger free starting layer instead.',
  },
  {
    question: 'Should I use free assessments or book guidance now?',
    answer:
      'If you are still exploring and the decision is not urgent, the free assessments, resources, and Career & Skills Compass tools are a useful first layer. If the next decision already feels important, expensive, or delayed by confusion, stronger guided support helps more.',
  },
  {
    question: 'Can working professionals use online career guidance too?',
    answer:
      'Yes. Online career guidance is useful for working professionals dealing with pivots, salary-ceiling pressure, AI-era shifts, or skill under-leverage, not only for students choosing a first direction.',
  },
  {
    question: 'What should I check before paying for any online career guidance service?',
    answer:
      'Check whether the advice is generic or genuinely useful, whether it covers higher-value skill direction and proof of work, and whether it improves income-growth direction instead of pushing low-growth defaults.',
  },
  {
    question: 'Is this available online across India?',
    answer: 'Yes. Guidance is delivered online across India, so you can join from home, college, or work instead of depending on local availability.',
  },
  {
    question: 'Will online career guidance work if I live in a small town or a tier-2 or tier-3 city?',
    answer:
      'Yes. Because guidance is delivered online across India, it does not depend on whether a strong career guidance option happens to exist in your city. The value is the quality of the reasoning around fit, skill direction, and risk, not how close an office is to you.',
  },
  {
    question: 'Should I look for a career coach near me instead of choosing online?',
    answer:
      'If physical proximity genuinely matters to you, the career coach near me page covers that angle. But strong guidance depends on clear reasoning about path, skill, and risk rather than location, and online removes the dependence on whatever local option happens to be available.',
  },
  {
    question: 'Do you guarantee a job?',
    answer: 'No ethical provider can guarantee a job.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Guidance Online', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance Online | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Guidance Online',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance Online</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career guidance online for students and working professionals across India
      </div>

      <h1 class="hero-title">
        Career guidance online
        <span class="gold-text"> for clearer decisions from anywhere in India</span>
      </h1>
      <p class="hero-sub">
        Career guidance online should give you the same strong, practical direction as any good in-person session:
        a clearer route toward a high-value skill portfolio, better trade-offs, and a confident next step aimed at
        unlocking high income opportunities and earlier financial freedom — without the decision depending on what is available in your city.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. You can start from home, college, work, or wherever you already are — no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Guidance</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
      <p class="hero-support">
        The goal stays the same online: clearer reasoning around fit, skill direction, and risk before another wrong turn gets expensive.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="when-online"
    sectionClass="online-signal-band"
    variant="signal"
    title="When career guidance online is the right call"
    subtitle="Online matters most when the decision is already serious and waiting for the right local option only delays a high-value skill portfolio and the income growth it should unlock."
    items={whenOnlineItems}
  />

  <ContextualCta
    audience="mixed"
    title="If the decision already matters, do not wait for the right local option to appear"
    body="Move while the options still matter. Stronger guidance helps more when the next course, pivot, or skill decision is already carrying real cost."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <BofuFeatureSection
    sectionId="what-it-should-decide"
    sectionClass="online-decision-band"
    variant="decision"
    title="What online career guidance should actually help you decide"
    items={decideItems}
  >
      <AssessmentSupportNote
        body="If you are still early and not ready for guidance yet, the career and skill assessments can surface strengths, preferences, and work style before a bigger guidance decision."
        href={BOFU_ASSESSMENT_LINKS.hub}
      />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="how-it-works"
    sectionClass="online-flow-band"
    title="How online career guidance works across India"
    subtitle="The format is online, but the work is real decision support: fit, skills, risk, and a next step you can use."
    items={howItWorksItems}
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    sectionClass="online-prep-band"
    variant="prep"
    title="What to keep ready before an online career guidance session"
    subtitle="Online guidance works better when the real constraints, options, and confusion are visible from the start instead of surfacing too late."
    items={prepItems}
  />

  <GuidanceModelSection
    title="What the online guidance actually covers"
    subtitle="The format is online, but the work goes deeper than a quick call: profile and fit, high-leverage decisions, high-value skill direction, proof of work, and a clearer route toward stronger income growth."
  />

  <AudienceRelevance
    title="How online career guidance fits where you are right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why online career guidance still has to be sharper than generic advice"
    subtitle="The format can be online, but the decision support still needs to stay specific, practical, and strong enough for an important career choice."
    centered={true}
  />

  <BuyerChecks
    title="What to check before choosing online career guidance"
    subtitle="The goal is a stronger decision before the wrong route becomes expensive, not a call that only sounds useful for thirty minutes."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Use stronger guidance before another round of delay turns into a more expensive mistake"
    body="If you already know confusion is costing time, direction, or momentum, this is the stage to act before the wrong path hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Guidance"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See other guidance pages, audience-specific pages, and free assessments before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    subtitle="Use career guidance online when the next decision already feels important. A clearer skill portfolio and stronger positioning are what keep unlocking high income opportunities and earlier financial freedom — waiting for another round of confusion only makes the move more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <BofuFaqSection
    title="Questions people ask before choosing online career guidance"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.online-signal-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.online-decision-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.online-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.online-prep-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(45,212,191,.045), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.006));
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.84rem, 9.6vw, 2.55rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>

