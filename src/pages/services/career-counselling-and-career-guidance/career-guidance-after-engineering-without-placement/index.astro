---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_COMPARISON_LIBRARY,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title =
  'Career Guidance After Engineering Without Placement | Off-Campus Job Search Direction | Future Career School';
const description =
  'Career guidance after engineering without placement: off-campus job search strategy, closing the resume gap, and deciding between a bridge role or holding out.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-after-engineering-without-placement/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[2],
  BOFU_COMPARISON_LIBRARY[4],
];

const decisionItems = [
  {
    title: 'Off-campus job search, not another placement drive',
    body: 'Campus placements are over and the on-campus route is closed. The job search now depends on off-campus applications, referrals, and hiring pages instead of a placement cell doing the sourcing for you, and that shift needs a real strategy, not just more of the same resume sent to more portals.',
  },
  {
    title: 'Closing the resume gap without panic-applying',
    body: 'Every extra month without an offer adds a gap that recruiters will ask about. The right response is not applying to everything at once. It is deciding what to show for the time already spent and what to build in the weeks ahead so the gap has an answer, not an excuse.',
  },
  {
    title: 'Referral routes vs cold off-campus applications',
    body: 'A referral from a senior, alumnus, or LinkedIn connection can skip the resume-shortlisting stage entirely, while a cold off-campus application usually competes against thousands of others for the same role. Guidance should help you build both routes deliberately instead of relying only on the one that feels easiest.',
  },
  {
    title: 'What to upskill first when time is limited',
    body: 'Not every course or certificate closes the actual gap between your resume and the roles you are applying for. The stronger move is picking the one or two skills that make you shortlist-ready fastest, backed by a small piece of proof of work, instead of collecting certificates that do not move the needle.',
  },
  {
    title: 'Whether a non-core or service-company role is a bridge or a trap',
    body: 'A service-company or non-core offer can be a genuine bridge toward stronger roles later, or it can quietly become a five-year detour, depending on what you do with it. The decision should weigh what that specific role actually teaches you against what waiting longer costs you.',
  },
];

const fitItems = [
  {
    eyebrow: 'No offer',
    title: 'Graduation has passed and there is still no offer',
    body: 'When classmates have joining letters and you are still deciding what to apply to next, the pressure to accept anything can start overriding a clear-headed decision.',
  },
  {
    eyebrow: 'Family pressure',
    title: 'Peers have offers and the comparisons have started at home',
    body: 'When relatives, neighbours, or family WhatsApp groups keep bringing up who got placed where, and every conversation at home starts circling back to the same question.',
  },
  {
    eyebrow: 'Settle or hold out',
    title: 'An offer has come in, but it feels like settling',
    body: 'When a non-core or lower-than-expected offer is on the table and it is unclear whether accepting it locks you out of stronger options, or whether holding out is the riskier move.',
  },
  {
    eyebrow: 'Direction',
    title: 'Unsure what to actually apply for anymore',
    body: 'When months of applying to anything and everything have left the job search unfocused, and it is no longer clear what roles are actually worth the effort.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether it treats the resume gap as fixable, not shameful',
    body: 'Generic advice tends to either ignore the gap or turn it into a source of guilt. Stronger guidance should help you build a genuine answer for it: what you built, what you learned, and what you are applying toward now.',
  },
  {
    title: 'Check whether off-campus and referral strategy gets real attention',
    body: 'A campus placement cell is not coming back for this stage. Look for guidance that treats off-campus applications, referrals, and direct outreach as a real skill to build, not an afterthought.',
  },
  {
    title: 'Check whether the settle-or-hold-out decision gets a real answer',
    body: 'This is one of the most consequential calls after graduation without an offer. Stronger guidance should walk through what a specific offer actually gives you and what waiting actually costs, instead of a blanket "always accept" or "always hold out" answer.',
  },
  {
    title: 'Check whether it ends in a specific next step, not just reassurance',
    body: 'Generic encouragement to "keep applying" is not a plan. Stronger guidance should close with a specific off-campus strategy, a settle-or-hold-out answer, and an upskilling direction you can act on the same week, not just a pep talk.',
  },
];

const faqItems = [
  {
    question: 'I graduated with no placement offer. Where do I even start?',
    answer:
      'Start by separating the job search into two parallel tracks: applying and building. The applying track means off-campus applications, referrals, and direct outreach, since the campus placement process is over. The building track means closing the one or two skill gaps that are most likely blocking your shortlist rate right now. Guidance should help you set both up instead of only sending out more resumes.',
  },
  {
    question: 'Will the gap since graduation hurt my chances in interviews?',
    answer:
      'A gap is a question, not automatically a red flag. What matters is whether you have a genuine answer: a course completed, a project built, a certification finished, or a clear reason tied to the job search itself. Guidance should help you shape that answer honestly instead of leaving you to explain it on the spot.',
  },
  {
    question: 'Should I take a service-company or non-core offer while I keep looking?',
    answer:
      'It depends on what the specific role actually teaches you and what your realistic timeline for something stronger looks like, not a blanket rule either way. Some non-core or service-company roles are a real bridge if you use them deliberately to build proof of work; others quietly become years of drift. Guidance should help you weigh your specific offer against your specific situation.',
  },
  {
    question: 'How do I get referrals when I do not know anyone at the companies I want to join?',
    answer:
      'Referral networks are built, not inherited. Seniors, alumni from your college, and people in roles you want are usually reachable through LinkedIn and direct, specific outreach, not mass messages. Guidance should help you build this as a deliberate skill instead of treating it as something only well-connected people can do.',
  },
  {
    question: 'What should I actually upskill in right now with limited time?',
    answer:
      'The right skill is the one that closes the specific gap between your resume and the roles you are applying for, backed by a small piece of proof of work you can show, not the longest certificate list you can collect. A deliberate, high-value skill choice usually closes the gap faster than spreading effort across everything that sounds relevant.',
  },
  {
    question: 'How do I deal with family pressure when my friends already have offers?',
    answer:
      'This pressure is real, and pretending it does not affect your decisions rarely helps. A clearer, honest plan, even a work-in-progress one, is usually what eases family pressure faster than a rushed offer accepted only to end the conversations at home.',
  },
  {
    question: 'Are the career and skill assessments free for graduates without a placement offer?',
    answer:
      'Yes. The career and skill assessments are fully free and can be described as updated, practical, and AI-powered. Many providers charge thousands for outdated assessments; this is meant to be a stronger free starting layer before deciding what to apply for or what to upskill in next.',
  },
  {
    question: 'Is this available online, or do I need to be near a specific city?',
    answer:
      'Guidance is delivered fully online across India, so you can start from home, a hostel, or wherever you are searching from right now, without depending on a local office or a campus counsellor who is no longer available to you.',
  },
  {
    question: 'What if I already have an offer, or the job search is no longer the main pressure?',
    answer:
      'This page is built specifically for the no-offer-yet stage: off-campus strategy, the resume gap, and the settle-or-hold-out decision. Once an offer is in hand, or once the search itself is no longer the immediate issue, career counselling after engineering covers the broader direction question that comes next, such as staying in core engineering or pivoting, and higher studies versus work.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description:
      'Get broader help when several connected decisions, not just the job search itself, need to make sense together.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-engineering-students/',
    title: 'Career Counselling for Engineering Students',
    description:
      'Useful for branch regret, service-vs-product offer decisions, and higher-studies questions if those are still open alongside the placement gap.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-after-engineering/',
    title: 'Career Counselling After Engineering',
    description:
      'Useful once an offer does come in, or once the immediate job search is no longer the main pressure, and the bigger question becomes core engineering versus a pivot, or higher studies versus work.',
  },
  {
    href: '/blog/career-options/is-service-company-job-worth-it-for-freshers/',
    title: 'Is a Service Company Job Worth It for Freshers?',
    description:
      'Read this if a non-core or service-company offer is on the table and you are weighing it against waiting longer.',
  },
  {
    href: '/career-resources/resume-that-gets-shortlisted-in-india/',
    title: 'Resume That Gets Shortlisted in India',
    description:
      'A practical guide to building a resume that survives the first filter, especially with a placement gap to explain.',
  },
  {
    href: '/career-resources/creating-a-portfolio-without-work-experience/',
    title: 'Creating a Portfolio Without Work Experience',
    description:
      'Practical ways to build proof of work fast when you do not have a job history or a placement offer to point to yet.',
  },
  {
    href: '/blog/career-options/career-after-btech-other-than-software/',
    title: 'Career After B.Tech Other Than Software',
    description:
      'Explore paths beyond a coding-first role if the off-campus software job search has stalled and it is time to widen the target.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-freshers/',
    title: 'Career Counselling for Freshers',
    description:
      'Useful once an offer is in hand and the questions shift to evaluating it, choosing between companies, or planning year one.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Guidance After Engineering Without Placement',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance After Engineering Without Placement | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Guidance After Engineering Without Placement',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance After Engineering Without Placement</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        For engineering graduates with no offer after campus placements
      </div>

      <h1 class="hero-title">
        Career guidance after engineering without placement
        <span class="gold-text"> when there is still no offer in hand</span>
      </h1>
      <p class="hero-sub">
        Career guidance after engineering without placement should deal with exactly this moment: graduation is done, the campus placement window is closed, and there is still no offer.
        The next few months matter because the skill portfolio and job-search direction you build right now shape how fast you close the gap, whether you start unlocking high income opportunities instead of settling for the first offer, and how early you can reach real financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so you can start from home, without waiting for a campus counsellor or placement cell that is no longer available to you.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Guidance After Engineering Without Placement</a>
      </div>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="fit"
    title="When this becomes the decision that matters most"
    subtitle="These are the specific pressure points graduates without an offer are dealing with right now. The direction chosen here decides how soon a high-value skill portfolio starts compounding toward earlier financial freedom, instead of the gap deciding it for you."
    items={fitItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Build a real off-campus strategy before another month passes without a plan"
    body="The sooner the direction is right, the sooner a high-value, high-income skill portfolio starts unlocking high income opportunities and compounding toward earlier financial freedom, instead of the gap working against you."
    studentHref="#plans"
    studentLabel="Get Career Guidance After Engineering Without Placement for Students"
  />

  <BofuStepFlowSection
    sectionId="decisions"
    title="The decisions this should help you make right now"
    subtitle="Not generic placement advice. Direction for the exact calls graduates without an offer are actually facing."
    items={decisionItems}
  >
    <AssessmentSupportNote
      body="As a starting point, the free graduate and early-professional assessment can help you see your actual strengths and work style before deciding what to apply for, what to upskill in, or whether to accept a bridge role."
      href={BOFU_ASSESSMENT_LINKS.graduatesAndEarlyProfessionals}
    />
  </BofuStepFlowSection>

  <ComparisonMatrix
    sectionId="compare"
    title="What changes when the job search after engineering is done right"
    subtitle="This should feel different from another round of the same resume sent to another hundred portals."
    rows={comparisonRows}
  />

  <BuyerChecks
    title="What to check before paying for guidance at this stage"
    subtitle="The goal is a working off-campus strategy and a clear settle-or-hold-out answer, not generic encouragement to keep applying."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Do not let another placement season pass or family pressure decide for you"
    body="A clearer off-campus strategy and skill plan now protects the years right after graduation, when direction and skill compounding matter most."
    studentHref="#plans"
    studentLabel="Get Career Guidance After Engineering Without Placement for Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Guidance"
    title="Career Guidance After Engineering Without Placement Plans"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader guidance, engineering-specific reading, and practical next steps before you decide your next move."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection
    title="Questions graduates without a placement offer ask before choosing career guidance"
    items={faqItems}
  />

  <FinalCta
    audience="student"
    title="Take the job search seriously before the gap or a rushed offer decides your direction"
    subtitle="If graduation has passed without an offer, and the pressure of peers, family, or a settle-or-hold-out decision already feels heavy, move with a real off-campus strategy and skill plan now, toward unlocking high income opportunities and earlier financial freedom, instead of letting the gap decide for you."
    studentHref="#plans"
    studentLabel="Get Career Guidance After Engineering Without Placement for Students"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 44rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.85; max-width: 800px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.54); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #decisions,
  #related-links { background: rgba(255,255,255,.012); }

  #check-before-paying,
  #faq { background: rgba(255,255,255,.008); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.7rem, 9vw, 2.3rem);
      line-height: 1.06;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
