---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
  BOFU_COMPARISON_LIBRARY,
} from '../../../../config/bofu';

const title =
  'Career Planning Session Online | Build a Multi-Year Career Plan | Future Career School';
const description =
  'Book a career planning session online with Future Career School: a structured, multi-year plan with clear milestones and a skill portfolio built to compound, not a one-off call about a single decision.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-planning-session-online/';

const planningRows = [
  BOFU_COMPARISON_LIBRARY[1], // degree-first vs skill-first
  BOFU_COMPARISON_LIBRARY[2], // low-growth paths vs earlier financial freedom
  BOFU_COMPARISON_LIBRARY[5], // random upskilling vs clearer skill direction
  BOFU_COMPARISON_LIBRARY[0], // generic advice vs high-leverage decision support
];

const planningFormatItems = [
  {
    title: 'A plan across years, not a verdict on one decision',
    body:
      'A career planning session online is built to lay out where you want to be in three, five, or more years, then work backward into the choices, skills, and milestones that get you there. The point is a right skill portfolio that opens high income opportunities and moves you toward earlier financial freedom, not a single urgent question resolved and forgotten.',
  },
  {
    title: 'Milestones you can check yourself against',
    body:
      'The plan should give you concrete checkpoints, not just a mood of direction. You should be able to look at the plan in six months and tell whether you are on track, ahead, or need to adjust.',
  },
  {
    title: 'A plan that expects to be revisited online',
    body:
      'Markets, skills, and opportunities shift. A career plan built for the real world is meant to be opened again and adjusted as things change, not filed away after one online session.',
  },
];

const planBuildItems = [
  {
    title: 'Where you stand today, mapped honestly',
    body:
      'A useful career planning session online starts with your actual profile, work style, and constraints, not an idealised version of your situation.',
  },
  {
    title: 'A skill portfolio sequenced over time, not one skill decision',
    body:
      'Instead of picking a single skill to learn next, the plan sequences a stack of skills over the coming years aimed at unlocking high income opportunities and earlier financial freedom as each layer compounds.',
  },
  {
    title: 'Milestones tied to income and market positioning',
    body:
      'The plan should connect each stage to a concrete marker: a role, a proof-of-work milestone, or an income level, so progress is measurable rather than vague.',
  },
  {
    title: 'A built-in point to revisit and adjust the plan',
    body:
      'Because the plan spans years, it should name when and how you check back in, instead of assuming one online session covers every year ahead without a second look.',
  },
];

const planningCards = [
  {
    eyebrow: 'Plan-building',
    title: 'The first career planning session',
    body:
      'A focused one-on-one that maps your current position and builds the first version of a multi-year plan: milestones, skill sequencing, and the route toward stronger income over time.',
    listItems: [
      'Starts from your real profile, not a generic roadmap template.',
      'Produces milestones you can track, not just a direction to feel good about.',
      'Delivered fully online, so it fits around school, college, or work.',
    ],
  },
  {
    eyebrow: 'Plan check-ins',
    title: 'Ongoing plan check-ins for students',
    body:
      'After the first planning session, students can continue into small-group sessions online, usually 10 or fewer members, to revisit and adjust the plan as choices, results, and the market change.',
    listItems: [
      'Built for a plan that spans years, not a single semester.',
      'Keeps skill sequencing and milestones on track as circumstances shift.',
      'Small enough that your specific plan still gets real attention.',
    ],
  },
];

const planningFlowItems = [
  {
    title: 'Map where you are now',
    body:
      'The planning session starts with your profile, strengths, work style, and constraints, so the plan is built on your real starting point, not a generic template.',
  },
  {
    title: 'Set milestones across the years ahead',
    body:
      'From that starting point, the session lays out a multi-year route: which skills come first, which proof-of-work markers matter, and which income or role milestones show real progress.',
  },
  {
    title: 'Sequence the skill portfolio',
    body:
      'Rather than one skill decision, the plan sequences a stack of skills over time aimed at compounding your market value and opening high income opportunities as each layer is added.',
  },
  {
    title: 'Build in a way to revisit the plan online',
    body:
      'Because plans age as markets shift, the session ends with a clear way to check back in online and adjust milestones instead of treating the plan as fixed forever.',
  },
];

const prepItems = [
  {
    title: 'Your current stage and real timeline',
    body:
      'Bring where you actually are right now, whether that is choosing a stream, finishing a degree, or a few years into a role, so the plan starts from reality, not from where you wish you were.',
  },
  {
    title: 'The years you are actually planning for',
    body:
      'A useful career planning session online works better when you know roughly how far ahead you want the plan to reach, even if that horizon is rough at the start.',
  },
  {
    title: 'Skills, courses, or roles you are already weighing',
    body:
      'If you already have a shortlist of directions, skills, or roles in mind, bring them so the plan can sequence around what you are genuinely considering.',
  },
  {
    title: 'Budget, location, and family or work constraints',
    body:
      'Cost, relocation limits, and family or employer expectations shape which milestones are realistic, so raise them early instead of building a plan that ignores your real life.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'A career planning session online for the years from stream choice to first career milestones',
    body:
      'Useful for mapping stream, degree, and skill choices into one multi-year plan, so the right skill gets built before years get spent on a path that will not lead toward earlier financial freedom.',
  },
  {
    label: 'Working Professionals',
    title: 'A career planning session online for the years ahead in your career, not just the next role',
    body:
      'Useful for sequencing skill growth, pivots, and positioning across several years, so a single promotion or pivot is part of a larger plan instead of an isolated bet.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether you get an actual plan, not just an opinion',
    body:
      'A career planning session online should end with milestones and a skill sequence you can hold onto, not only an impression of what felt like good advice during the call.',
  },
  {
    title: 'Check whether the plan is built for more than one year',
    body:
      'If a plan only covers the next few months, it is closer to a single decision than a career plan. Ask how far ahead the milestones actually stretch.',
  },
  {
    title: 'Check whether there is a real way to revisit the plan',
    body:
      'Markets and skills shift, so a plan without a built-in way to check back in and adjust online tends to go stale fast. Ask what happens after the first session ends.',
  },
  {
    title: 'Check whether a multi-year plan can genuinely be built in one online session',
    body:
      'Mapping milestones across several years takes more depth than a quick call. A real career planning session online should feel structured enough to produce an actual plan, not just a summary of where you stand today.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger question is the decision itself, not the shape of a longer-term plan.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingSession,
    title: 'Career Counselling Session',
    description:
      'Choose this if you need help with one specific decision right now rather than a multi-year plan with milestones.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerGuidanceOnline,
    title: 'Career Guidance Online',
    description:
      'This is the fit if the priority is general online guidance rather than a structured, milestone-based plan.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Use free, updated, practical, AI-powered career and skill assessments as a no-cost starting point before your planning session.',
  },
];

const faqItems = [
  {
    question: 'What is a career planning session online?',
    answer:
      'It is a structured session focused on building a multi-year career plan: milestones, a skill portfolio sequenced over time, and a route toward stronger income and earlier financial freedom, delivered fully online so you can join from anywhere in India.',
  },
  {
    question: 'How is a career planning session different from a career counselling session?',
    answer:
      'A career counselling session is built around one decision under pressure right now, such as a stream, course, or pivot. A career planning session online is built around a longer horizon: mapping milestones and sequencing a skill portfolio across the years ahead, not just resolving a single choice.',
  },
  {
    question: 'Does the plan cover more than one decision, or just the next step?',
    answer:
      'The plan is meant to connect several decisions across time, such as which skills come first, which proof-of-work markers to target, and which milestones to check yourself against, rather than stopping at the next single step.',
  },
  {
    question: 'How often should I revisit the plan?',
    answer:
      'Because markets and skills shift, the plan is built to be revisited, not filed away. Students can continue into ongoing small-group sessions online to check progress and adjust milestones as things change.',
  },
  {
    question: 'Is a career planning session online available across India?',
    answer:
      'Yes. Every session is delivered fully online, so you can build and revisit your plan from home, college, or work anywhere in India without waiting for a local offline option.',
  },
  {
    question: 'What should I bring to a career planning session?',
    answer:
      'Bring your current stage and real timeline, a rough sense of how many years ahead you want to plan for, any skills or roles you are already weighing, and constraints such as budget, location, or family and work pressure.',
  },
  {
    question: 'How much does a career planning session cost?',
    answer:
      'Students can book the first planning session at a limited-time price, with an option to continue into small-group plan check-ins across the year. Working professionals can book a one-on-one planning session at the working-professional rate. Current pricing is shown in the plans section below.',
  },
  {
    question: 'Are the free career and skill assessments useful before a planning session?',
    answer:
      'They can be. If you are still early and not ready to plan multiple years out yet, the free, updated, practical, AI-powered career and skill assessments can help surface strengths and work style first.',
  },
  {
    question: 'Do you guarantee the plan will lead to a specific job or income?',
    answer:
      'No ethical provider can guarantee a job or a specific income outcome. The session builds decision support and a structured plan; the outcome still depends on your effort and real-world execution.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Planning Session Online',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Planning Session Online | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Planning Session',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Planning Session Online</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        A multi-year career plan with milestones and a compounding skill portfolio, built fully online
      </div>

      <h1 class="hero-title">
        Career planning session online
        <span class="gold-text"> built for years ahead, not one decision</span>
      </h1>
      <p class="hero-sub">
        Future Career School's career planning session online maps where you stand today into a structured, multi-year plan with real milestones. The goal is a deliberate, high-value skill portfolio that compounds over time and moves you toward earlier financial freedom, not a single verdict on one choice.
      </p>
      <p class="hero-note">
        The first session builds your plan. Students can then continue into online plan check-ins, in small groups of 10 or fewer, to keep the plan current as skills, results, and the market shift. Delivered fully online across India.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Planning Session</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Planning Session</a>
      </div>
      <p class="hero-support">
        The value is not the meeting itself. It is a plan with milestones you can check yourself against months from now, not a conversation that fades once the call ends.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="planning-format"
    sectionClass="planning-format-band"
    variant="signal"
    title="What makes a career planning session different from a single counselling call"
    subtitle="A plan spans years. A decision is one moment. The format has to match which one you actually need right now."
    items={planningFormatItems}
  />

  <ContextualCta
    audience="mixed"
    title="Start the plan before another year passes on a direction you have not actually mapped out"
    body="A career planning session online should turn a vague sense of direction into milestones and a skill sequence you can act on."
    studentHref="#plans"
    studentLabel="Get Student Career Planning Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Planning Session"
  />

  <BofuFeatureSection
    sectionId="what-the-plan-builds"
    sectionClass="planning-build-band"
    variant="decision"
    title="What a career planning session online should actually build"
    subtitle="The session is not meant to end with a single answer. It is meant to end with a plan: milestones, a skill sequence, and a route toward unlocking high income opportunities over time."
    items={planBuildItems}
  >
    <AssessmentSupportNote
      body="If you are still early and not ready to plan several years out yet, the free career and skill assessments can surface strengths and work style first."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="planning-formats"
    sectionClass="planning-formats-band"
    title="Building the plan, then keeping it current"
    subtitle="A multi-year plan is not useful if it is built once and never revisited. The first session builds it; ongoing check-ins keep it honest as things change."
    items={planningCards}
    variant="contrast"
  />

  <BofuStepFlowSection
    sectionId="how-planning-works"
    sectionClass="planning-flow-band"
    title="How the career planning session online moves from today to your milestones"
    subtitle="The session is one structured conversation, but the output should be a plan you can measure yourself against for years, not just a feeling of clarity that fades."
    items={planningFlowItems}
  />

  <BofuFeatureSection
    sectionId="what-to-prepare"
    sectionClass="planning-prep-band"
    variant="prep"
    title="What to bring to your career planning session"
    subtitle="A multi-year plan works better when your real timeline, options, and constraints are visible from the start instead of surfacing halfway through."
    items={prepItems}
  />

  <GuidanceModelSection
    title="What a stronger career planning session should actually cover"
    subtitle="The session is one conversation, but the thinking behind it should stretch across years: fit, milestones, a high-value skill portfolio, proof of work, and a clearer route toward stronger long-term income."
  />

  <AudienceRelevance
    sectionClass="planning-audience-band"
    title="How a multi-year plan fits where you are right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="planning-comparison-band"
    title="Why a career planning session has to hold up over years, not just one call"
    subtitle="A plan that only feels good for thirty minutes is not a plan. It needs to hold up as skills, roles, and the market change."
    rows={planningRows}
    centered={true}
  />

  <BuyerChecks
    sectionClass="planning-check-band"
    title="What to check before you book a career planning session"
    subtitle="The goal is not a session that sounds inspiring once. The goal is a plan structured enough to still be useful a year from now."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="If a year is already passing without a real plan, build one before another one does"
    body="A well-structured career planning session online should leave you with milestones, a skill sequence, and a way to check progress over time."
    studentHref="#plans"
    studentLabel="Get Student Career Planning Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Planning Session"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Planning Session"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See other counselling and guidance pages, plus free assessments, before you decide whether a single session or a multi-year plan fits you better."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="planning-final-band"
    subtitle="Book a career planning session online when you are ready to map more than the next decision. A stronger plan should point toward a compounding skill portfolio and a clearer route toward achieving earlier financial freedom, not just one answer for today."
    studentHref="#plans"
    studentLabel="Get Student Career Planning Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Planning Session"
  />

  <BofuFaqSection
    title="Questions people ask before booking a career planning session online"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.planning-format-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.planning-build-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.planning-formats-band) {
    background:
      radial-gradient(760px 240px at 0% 0%, rgba(229,184,74,.06), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.007));
  }
  :global(.planning-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.planning-prep-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(45,212,191,.045), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.006));
  }
  :global(.planning-audience-band .section-headline),
  :global(.planning-comparison-band .section-headline),
  :global(.planning-check-band .section-headline) {
    max-width: 20ch;
  }
  :global(.planning-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.planning-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.planning-audience-band .audience-card h3) {
    font-size: 1.08rem;
    line-height: 1.46;
  }
  :global(.planning-audience-band .audience-card p) {
    font-size: 14.2px;
    line-height: 1.82;
  }
  :global(.planning-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.planning-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.planning-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.planning-final-band .final-sub) {
    max-width: 50ch;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub {
    font-size: clamp(15px, 1.95vw, 18px);
    color: rgba(255,255,255,.72);
    line-height: 1.88;
    max-width: 820px;
    margin-bottom: 1rem;
  }
  .hero-note {
    font-size: 14px;
    color: rgba(255,255,255,.56);
    line-height: 1.8;
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-actions .btn-gold,
