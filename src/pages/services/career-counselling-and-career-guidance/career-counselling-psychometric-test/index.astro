---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title =
  'Career Counselling Psychometric Test | Free Assessments by Audience | Future Career School';
const description =
  'Career counselling psychometric test guidance for students, freshers, and working professionals - see every free psychometric-style career assessment Future Career School offers, organised by audience, with the most commonly searched formats highlighted.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-psychometric-test/';

const audienceAssessmentItems = [
  {
    href: BOFU_ASSESSMENT_LINKS.class10AndBelow,
    title: 'Free Career Assessment for Class 10 and Below',
    description:
      'A free 25-question psychometric assessment covering RIASEC career interests, multiple intelligence profile, stream recommendation, aptitude signals, and learning style. Instant results, no sign-up.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.class11To12,
    title: 'Free Career Assessment for Class 11 and 12',
    description:
      'A free 25-question psychometric assessment for all streams, covering RIASEC career interests, college-entrance strategy, multiple intelligence profile, aptitude signals, and career direction.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.graduatesAndEarlyProfessionals,
    title: 'Free Career Assessment for Graduates & Early Professionals',
    description:
      'A free 26-question psychometric assessment for graduates and professionals with 0-3 years of experience, covering career clarity, role fit, skill readiness, and employability.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.workingProfessionalsAndCareerChangers,
    title: 'Free Career Assessment for Working Professionals & Career Changers',
    description:
      'A free 32-question psychometric assessment for professionals with 5+ years of experience, covering career-pivot feasibility, income leverage, leadership potential, remote-work readiness, AI-automation risk, and entrepreneurial aptitude.',
  },
];

const highDemandAssessmentItems = [
  {
    href: '/services/assessments/psychometric-test/',
    title: 'Psychometric Test',
    description: 'The most direct match for this search - a starting point that points you to the strongest free assessment for your stage.',
  },
  {
    href: '/services/assessments/career-aptitude-test-online/',
    title: 'Career Aptitude Test Online',
    description: 'One of the most commonly searched assessment formats - a broad online aptitude check for career direction.',
  },
  {
    href: '/services/assessments/career-test-online/',
    title: 'Career Test Online',
    description: 'A broad, generically searched career-test format for people who have not yet narrowed down a specific assessment type.',
  },
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Myers-Briggs Career Test',
    description: 'A widely searched personality-type framework applied to career direction, for people specifically looking for this style of test.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'The Big Five personality-trait framework applied to career fit, for a different personality-testing angle than Myers-Briggs.',
  },
  {
    href: '/services/assessments/job-aptitude-test/',
    title: 'Job Aptitude Test',
    description: 'A job-focused aptitude format for people whose search is centred on employability rather than a broader career-direction question.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-10th/',
    title: 'Stream Selector Test After 10th',
    description: 'A focused, high-search-volume format for the specific Science, Commerce, or Arts stream decision right after Class 10.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-12th/',
    title: 'Stream Selector Test After 12th',
    description: 'The equivalent focused format for the course and college decision right after Class 12.',
  },
];

const whatItShouldClarifyItems = [
  {
    title: 'Interest and work-style alignment',
    body: 'A psychometric test should show what kind of environments, tasks, and roles feel more natural for you, not just assign you a personality label.',
  },
  {
    title: 'Where aptitude and preference support each other',
    body: 'The useful output shows when your strengths and your likely direction actually reinforce each other, and when they genuinely pull in different directions.',
  },
  {
    title: 'A specific next step, not just a description of yourself',
    body: 'The result should narrow your direction and feed into a real decision - a stream, a skill, a role, or a pivot - not leave you with a decorative report and no practical next move.',
  },
  {
    title: 'The right assessment for your actual stage',
    body: 'A Class 10 student, a graduate, and a working professional need genuinely different assessments. The stage-specific assessments above exist because a single generic test cannot serve all of them equally well.',
  },
];

const comparisonRows = [
  {
    left: 'Guessing which of many generic-sounding tests to take',
    right: 'One free assessment matched to your actual stage - student, graduate, or working professional',
  },
  {
    left: 'A personality label with no connection to a real decision',
    right: 'Interest, aptitude, and work-style signals connected to a specific next step',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'A test result with no follow-through',
    right: 'A starting signal that feeds into a deeper counselling conversation when you need one',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the test is actually free, not a "free preview" of a paid report',
    body: 'Many providers use a psychometric test as a lead-in to an expensive paid report. Future Career School can be described truthfully as offering free, updated, practical, AI-powered assessments with instant results and no sign-up.',
  },
  {
    title: 'Check whether the test matches your actual life stage',
    body: 'A school-student assessment and a working-professional assessment measure different things for good reason. Taking the wrong stage’s test produces a result that does not fit your real situation.',
  },
  {
    title: 'Check whether the result connects to a next step',
    body: 'A psychometric test is a starting signal, not the finish line. Good guidance should use the result to point toward a specific stream, skill, or counselling conversation, not stop at a personality description.',
  },
];

const faqItems = [
  {
    question: 'What is a career counselling psychometric test, exactly?',
    answer:
      'It is a structured assessment - covering interests, aptitude, personality-style signals, and work style - used as part of career counselling to give you a clearer starting signal on direction and fit, before or alongside a deeper counselling conversation.',
  },
  {
    question: 'Which psychometric test should I take first?',
    answer:
      'Start with the assessment built for your actual stage: Class 10 and below, Class 11-12, graduates and early professionals, or working professionals and career changers. Each is a full psychometric-style assessment tailored to the decisions people at that stage actually face.',
  },
  {
    question: 'Are these psychometric tests really free?',
    answer:
      'Yes. All of the stage-based assessments above are free, with instant results and no sign-up required. They can be described accurately as updated, practical, and AI-powered.',
  },
  {
    question: 'Is a Myers-Briggs or Big 5 personality test the same as these stage-based assessments?',
    answer:
      'They measure a narrower slice - personality style alone - while the stage-based assessments combine interests, aptitude, work style, and career direction together. Both are available; the stage-based assessment is usually the stronger single starting point if you have to pick one.',
  },
  {
    question: 'Does a psychometric test replace career counselling?',
    answer:
      'No. A psychometric test is a useful starting signal, but a real counselling conversation is what turns that signal into a specific, actionable plan for your situation.',
  },
  {
    question: 'Do you guarantee a specific career outcome from taking a test?',
    answer:
      'No ethical provider can guarantee a career outcome from an assessment alone. The practical value is a clearer starting signal, which a deeper counselling conversation can then build into a real plan.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling Psychometric Test', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Psychometric Test | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling Psychometric Test</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Every free psychometric-style assessment, organised by audience
      </div>

      <h1 class="hero-title">
        Career counselling psychometric test
        <span class="gold-text"> - the right free assessment for your stage</span>
      </h1>
      <p class="hero-sub">
        A psychometric test is only useful if it actually fits the decision in front of you. Future Career School offers free, updated, practical, AI-powered psychometric-style career assessments for every stage - school students, Class 11-12, graduates and early professionals, and working professionals and career changers - alongside the specific formats people commonly search for, like a Myers-Briggs or Big 5 style test. This page gathers all of them in one place so you can start with the one that actually matches your situation.
      </p>
      <p class="hero-note">
        Every assessment below is free, gives instant results, and needs no sign-up. Guidance is delivered fully online across India if you want to take the next step after your result.
      </p>
      <div class="hero-actions">
        <a href="#by-audience" class="btn-gold pulse">See Assessments by Audience</a>
        <a href="#plans" class="btn-outline">Get Career Counselling</a>
      </div>
      <p class="hero-support">
        The goal is not to collect a personality label. It is to get a clear starting signal that actually connects to your next decision - stream, skill, role, or pivot.
      </p>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="by-audience"
    title="Free psychometric-style assessments by audience"
    subtitle="Each of these is a full, multi-question psychometric assessment built for a specific stage. Start with the one that matches where you actually are, not a generic one-size-fits-all test."
    items={audienceAssessmentItems}
  />

  <ContextualCta
    audience="mixed"
    title="Not sure which stage fits you, or want to go deeper after a result?"
    body="A short counselling conversation can confirm the right assessment for your situation and turn the result into a real next step."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <LinkDirectorySection
    sectionId="high-demand-formats"
    title="Commonly searched psychometric and aptitude test formats"
    subtitle="If you were specifically looking for one of these named formats, here they are - alongside the stage-based assessments above, which usually give a more complete picture."
    items={highDemandAssessmentItems}
    altBackground={true}
  />

  <BofuFeatureSection
    sectionId="what-clarify"
    title="What a career counselling psychometric test should actually clarify"
    subtitle="A useful psychometric test does more than describe your personality - it should move a real decision forward."
    items={whatItShouldClarifyItems}
    variant="decision"
  >
    <AssessmentSupportNote
      body="Every assessment on this page is free, updated, practical, and AI-powered, with instant results and no sign-up."
      href={BOFU_ASSESSMENT_LINKS.hub}
      label="See the full assessments library"
    />
  </BofuFeatureSection>

  <ComparisonMatrix
    sectionId="comparison"
    title="Why this is more useful than picking a random psychometric test"
    subtitle="These are the contrast points that matter most once you are choosing among several assessment options."
    rows={comparisonRows}
    centered={true}
  />

  <BuyerChecks
    title="What to check before trusting any psychometric test result"
    subtitle="A test result is only as useful as what it actually measures and where it leads next."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Take the right assessment for your stage, then decide what comes next"
    body="A clear starting signal is the point - not a personality label with nowhere to go."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See the main assessments hub, broader counselling pages, and stage-specific guidance before you decide."
    items={[
      {
        href: BOFU_ASSESSMENT_LINKS.hub,
        title: 'Free Career Assessments Hub',
        description: 'Browse every assessment Future Career School offers, including narrower reasoning, placement, and topic-specific tests not listed above.',
      },
      {
        href: BOFU_INTERNAL_LINKS.careerCounselling,
        title: 'Career Counselling',
        description: 'See the main counselling page if you want to skip straight to a deeper conversation rather than starting with an assessment.',
      },
      {
        href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
        title: 'Career Counselling Online',
        description: 'Online-first guidance across India if flexible access matters most to you.',
      },
      {
        href: '/services/career-counselling-and-career-guidance/career-counselling-after-10th/',
        title: 'Career Counselling After 10th',
        description: 'For the specific 11th-stream, diploma, or vocational decision right after the Class 10 result.',
      },
      {
        href: BOFU_INTERNAL_LINKS.guidanceLocations,
        title: 'Career Guidance by Location',
        description: 'Compare city-specific guidance pages if local context matters to your decision.',
      },
    ]}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    title="Start with the right free assessment, then get a real next step"
    subtitle="Use the stage-based assessments above as your starting signal, and move into a counselling conversation when you are ready to turn the result into an actual plan."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.75rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-clarify,
  #faq { background: rgba(255,255,255,.01); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.8rem, 9.6vw, 2.5rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
