---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_COMPARISON_LIBRARY,
} from '../../../../config/bofu';

const title = 'Career Guidance Service | What’s Included and How It Works | Future Career School';
const description =
  'Comparing a career guidance service before you pay? See exactly what Future Career School’s career guidance service includes: the process, the deliverables, free assessments, and clear pricing.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-service/';

const serviceStructureItems = [
  {
    eyebrow: 'Phase 01',
    title: 'Before you pay anything',
    groups: [
      {
        title: 'What stays clear upfront',
        items: [
          'The exact 1-on-1 price for your track — student or working professional',
          'Which free assessments and resources you can use before committing to anything paid',
          'Whether you are booking a single session or stepping into continuous guidance',
        ],
      },
    ],
  },
  {
    eyebrow: 'Phase 02',
    title: 'What happens inside the 1-on-1',
    groups: [
      {
        title: 'Profile and direction',
        items: [
          'Profile, preferences, strengths, and work-style mapping',
          'High-leverage decision support around path, skill, and risk',
          'Direction toward a high-value skill portfolio built to unlock high income opportunities',
        ],
      },
    ],
  },
  {
    eyebrow: 'Phase 03',
    title: 'Where the service moves you next',
    groups: [
      {
        title: 'Growth direction',
        items: [
          'Proof of work and market-validation guidance beyond degree dependence alone',
          'Curated learning path, personal branding, and tech leverage direction',
          'Planning toward stronger income growth and a clearer route to earlier financial freedom',
        ],
      },
    ],
  },
];

const evaluationItems = [
  {
    title: 'Check whether the deliverables are named, not vague',
    body: 'A career guidance service worth paying for should tell you what actually happens in the session — profile mapping, decision support, skill direction — not just promise a good outcome.',
  },
  {
    title: 'Check whether pricing is clear before you book',
    body: 'You should see the price for your 1-on-1 and know upfront whether it stays a single session or moves into continuous guidance, not discover the structure after paying.',
  },
  {
    title: 'Check whether the free layer is genuinely free',
    body: 'Free career and skill assessments, resources, and Career & Skills Compass tools should stay free — not become a paywalled trick to pull you into a sales call.',
  },
  {
    title: 'Check whether the service leads toward skills, not only a report',
    body: 'A stronger career guidance service should end with a skill direction and a next step, not just a printed personality report you could already get elsewhere.',
  },
];

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[3],
  BOFU_COMPARISON_LIBRARY[5],
];

const objectionItems = [
  {
    title: 'I’ve paid for a service like this before and got a generic PDF',
    body: 'This service is built around a live 1-on-1, not a static report. You leave with direction, skill priorities, and a next step you can actually use — not a downloadable file that repeats what you already knew.',
  },
  {
    title: 'I only need one session, not an ongoing service',
    body: 'A single 1-on-1 works well on its own. Continuous guidance is there afterward if you want ongoing support through the year, not something you are pushed into.',
  },
  {
    title: 'I am worried this is really a sales call for a course',
    body: 'The service is built around your decision, not around selling a fixed course. No ethical provider can guarantee a job, and this service does not promise one either.',
  },
  {
    title: 'How do I know the price I see is the real price',
    body: 'The price shown for your track is the price you pay for that session. There is no separate hidden tier that appears only after you book.',
  },
];

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step career decisions beyond this service page.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'See the direct career guidance page if you want the practical-direction framing rather than the service structure.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/best-career-counselling-platform/',
    title: 'How to Evaluate a Career Counselling Platform',
    description: 'A closer look at what separates a genuinely useful provider from a templated one, if you are still comparing services.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-fees/',
    title: 'Career Counselling Fees',
    description: 'See how pricing, packages, and value usually work across the market before you commit to any service.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Assessments',
    description: 'Free, updated, practical, AI-powered career and skill assessments you can use before deciding on paid guidance.',
  },
  {
    href: '/career-skills-compass',
    title: 'Career & Skills Compass',
    description: 'Start exploring high-value skill direction before you commit to a bigger service decision.',
  },
  {
    href: '/career-resources',
    title: 'Career Resources',
    description: 'Free resources to help you keep moving between bigger career decisions.',
  },
];

const faqItems = [
  {
    question: 'What exactly is included in the career guidance service price?',
    answer:
      'The 1-on-1 includes profile, preferences, strengths, and work-style mapping; high-leverage decision support around path, skill, and risk; and direction toward a high-value skill portfolio, proof of work, and income-growth planning. Free career and skill assessments and resources are available separately at no cost.',
  },
  {
    question: 'Is this a one-time session or an ongoing service?',
    answer:
      'You can start with a single 1-on-1 session. For students, continuous career guidance is also available afterward as small-group sessions across the year, built for ongoing decision support rather than a one-off conversation.',
  },
  {
    question: 'Are the assessments included in the price or separate?',
    answer:
      'Career and skill assessments are fully free — updated, practical, and AI-powered — and are not bundled into or hidden behind the paid 1-on-1 price.',
  },
  {
    question: 'How is this different from a career guidance service that just sends a report?',
    answer:
      'This service is built around a live 1-on-1 with decision support, not a static report. The goal is a clearer skill direction and next step, not a personality label you file away.',
  },
  {
    question: 'How is this different from normal career counselling or coaching?',
    answer:
      'Career guidance, career counselling, career coaching, and career strategy are treated as one practical service family here. The useful difference is not the label — it is whether the service gives you clear deliverables, transparent pricing, and a genuine route toward higher-value skills, proof of work, and income growth.',
  },
  {
    question: 'What should I check before paying for any career guidance service?',
    answer:
      'Check whether the deliverables are named upfront, whether pricing is clear before you book, whether the free layer stays genuinely free, and whether the service leads toward skill direction rather than just a report.',
  },
  {
    question: 'Is this career guidance service available online across India?',
    answer:
      'Yes. The service is delivered fully online across India, so you can join from home, college, or work instead of depending on local availability.',
  },
  {
    question: 'Do you guarantee a job through this service?',
    answer:
      'No ethical provider can guarantee a job. The service is built for clearer decisions, stronger skill direction, and better positioning — not a placement promise.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Guidance Service',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance Service | Future Career School',
    description:
      'A structured career guidance service for students, freshers, and working professionals: profile mapping, high-leverage decision support, skill direction, proof of work, and income-growth planning, with transparent pricing and free assessments.',
    url: canonical,
    serviceType: 'Career Guidance Service',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance Service</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        A career guidance service built around clear deliverables.
      </div>

      <h1 class="hero-title">
        Career guidance service
        <span class="gold-text"> built around what you actually get</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers a career guidance service for students, freshers, and working professionals who want to see the structure, the process, and the price before they commit — not just a promise that guidance helps.
        The service is built to move you toward a stronger, high-value skill portfolio that can unlock high income opportunities and a clearer route to achieving earlier financial freedom.
      </p>
      <p class="hero-note">
        The service is delivered fully online across India. You can start from home, college, or work — no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Guidance</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
      <p class="hero-support">
        See exactly what is included, what it costs, and how the process moves — before you decide anything.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="service-structure"
    title="What this career guidance service actually includes"
    subtitle="A service worth paying for should show its structure upfront. Here is what happens before you pay, inside the 1-on-1, and where the service moves you toward next."
    items={serviceStructureItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As a starting point, free career and skill assessments can surface strengths, preferences, and work style before you commit to the paid part of the service."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BuyerChecks
    sectionId="evaluate-the-service"
    title="How to evaluate a career guidance service before you pay for it"
    subtitle="Good service structure should be easy to check before you commit — not something you discover after paying."
    items={evaluationItems}
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why this career guidance service is worth paying for"
    subtitle="Plenty of services in the market look similar on the surface. The real difference is in what the process actually delivers."
    rows={comparisonRows}
  />

  <ContextualCta
    audience="mixed"
    title="See the service structure and pricing before you decide"
    body="Compare what each track includes, then choose the option that fits your stage — student or working professional."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <GuidanceModelSection
    sectionId="how-the-service-works"
    title="How this career guidance service works, step by step"
    subtitle="Each phase of the service is meant to build on the one before it — from clarity, to direction, to a growth plan you can act on."
  />

  <AudienceRelevance
    sectionId="who-this-service-fits"
    title="Who this career guidance service is built for right now"
  />

  <BofuFeatureSection
    sectionId="objections"
    title="Common doubts before paying for a career guidance service"
    subtitle="These are the doubts worth resolving before you commit money to any guidance service, not just this one."
    items={objectionItems}
    variant="signal"
  />

  <ContextualCta
    audience="mixed"
    title="If you already know you want structured support, the plans are below"
    body="Compare the student and working-professional tracks, then choose the option that matches where you are right now."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Guidance Service"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See other guidance pages, comparison reading, assessments, and tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection title="Questions people ask before choosing a career guidance service" items={faqItems} />

  <FinalCta
    audience="mixed"
    title="Choose a career guidance service that shows its structure upfront"
    subtitle="Move forward once you know exactly what you get, what it costs, and how the process moves toward stronger skills and income growth."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  section[id] { scroll-margin-top: 108px; }
  #hero { padding: 138px 0 82px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -160px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; margin-bottom: 1.5rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.25rem, 5vw, 3.8rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.8; max-width: 780px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.75; max-width: 760px; margin-bottom: 1.8rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #service-structure,
  #different,
  #related-links { background: rgba(255,255,255,.012); }

  #evaluate-the-service,
  #objections { background: rgba(255,255,255,.008); }

  @media (max-width: 680px) {
    #hero { padding: 118px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline,
    .hero-actions .btn-soft { justify-content: center; }
  }
</style>
