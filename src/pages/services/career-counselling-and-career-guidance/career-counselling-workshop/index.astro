---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuSummaryStrip from '../../../../components/bofu/BofuSummaryStrip.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
  BOFU_COMPARISON_LIBRARY,
} from '../../../../config/bofu';

const title =
  'Career Counselling Workshop | Structured Guidance Online | Future Career School';
const description =
  'A career counselling workshop delivered as structured, guided support online across India, not a one-off talk. Get practical clarity and a clear next step.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-workshop/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[2],
  BOFU_COMPARISON_LIBRARY[5],
];

const whatWorkshopMeansItems = [
  {
    title: 'A structured process, not a one-time talk',
    body:
      'A career counselling workshop should work through your profile, pressure, and real decision in a set order, not a loose 30-minute chat that leaves the actual choice untouched.',
  },
  {
    title: 'Guided, hands-on, and specific to you',
    body:
      'The point of a workshop-style process is that you leave having actually worked through your options, not just listened to a general talk about careers.',
  },
  {
    title: 'Built to continue, not end after one session',
    body:
      'For students, the stronger path continues as structured small-group sessions across the year, so skill and path decisions stay on track instead of fading after a single conversation.',
  },
  {
    title: 'Practical output, not just discussion',
    body:
      'A workshop-style session should leave you with a sharper shortlist, a clearer high-value skill direction, and one next move that moves you toward earlier financial freedom, not just a certificate of attendance.',
  },
];

const decisionItems = [
  {
    title: 'Which path deserves serious effort right now',
    body:
      'A structured career counselling workshop should help you separate the route worth doubling down on from the ones that only look fine on paper.',
  },
  {
    title: 'Which skill direction should start early',
    body:
      'Beyond stream or role labels, the session should connect your choice to a high-value skill portfolio that compounds market value over time, not just one isolated decision.',
  },
  {
    title: 'What proof of work should come next',
    body:
      'A workshop-style process should point you toward proof of work and market signals, not leave you with a degree alone as your only credential.',
  },
  {
    title: 'How this decision affects long-term income growth',
    body:
      'The stronger question is not just what to choose today. It is how that choice moves you toward unlocking high income opportunities and earlier financial freedom.',
  },
];

const flowItems = [
  {
    title: 'Map your profile, strengths, and real pressure',
    body:
      'The process starts with your actual situation: strengths, work style, constraints, and the decision that matters most right now, not a generic questionnaire.',
  },
  {
    title: 'Work through options as a structured decision, not a chat',
    body:
      'Fit, risk, budget, family pressure, and skill direction get weighed together as one decision system, the way a working session should, not a scattered conversation.',
  },
  {
    title: 'Leave with a specific next step and a skill direction',
    body:
      'The workshop-style session should end with a narrower shortlist, a skill direction to start on, and one action you can use immediately.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Structured guidance for stream, course, degree, and skill decisions',
    body:
      'A career counselling workshop matters most for students when a stream, course, or early-skill choice already feels expensive to get wrong. After the first 1-on-1, the stronger path continues as structured small-group sessions across the year — a genuinely workshop-style, ongoing format, not a single talk.',
  },
  {
    label: 'Working Professionals',
    title: 'A focused, structured session for pivots and stagnation',
    body:
      'For professionals, the value of a structured session is working through stagnation, AI pressure, or a pivot decision in one sharp, practical sitting instead of another vague conversation that goes nowhere.',
  },
];

const objectionItems = [
  {
    title: 'Isn’t a "workshop" just a talk with slides?',
    body:
      'Not here. The process is built to be worked through, not watched. You leave with a decision that has actually moved, not just more general career information.',
    listItems: [
      'The session works through your real shortlist, not a generic list of careers.',
      'You leave with a narrower set of options and a specific next step.',
      'Skill direction and proof of work are part of the output, not an afterthought.',
      'For students, the structured format continues across the year instead of stopping after one session.',
    ],
  },
  {
    title: 'What if I already sat through a career talk or webinar and still feel unclear?',
    body:
      'That usually means the real trade-off was never worked through properly, only explained in general terms.',
    listItems: [
      'A broad talk can inform you without ever touching your specific decision.',
      'The serious option and the backup option may never have been compared honestly.',
      'Budget, family pressure, or work constraints may have been left out of the picture.',
      'You may still have no concrete next action, only more information to sit with.',
    ],
  },
];

const objectionSummaryItems = [
  {
    title: 'Worked through, not just explained',
    body: 'The goal is a decision that actually moves, not a talk you sit through.',
  },
  {
    title: 'Specific to your situation',
    body: 'Your real shortlist and constraints shape the session, not a generic slide deck.',
  },
  {
    title: 'A next step you can use',
    body: 'You should leave with something concrete to act on, not more to think about.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether it is structured or just a conversation',
    body:
      'A genuine career counselling workshop should move through your profile, options, and decision in a clear structure, not drift through an open-ended chat.',
  },
  {
    title: 'Check whether the format continues or stops after one session',
    body:
      'A single session can start the process, but real direction usually needs more than one sitting. Ask whether there is a structured way to continue, not just a one-off appointment.',
  },
  {
    title: 'Check whether skill direction and proof of work are part of it',
    body:
      'Degree-only advice rarely moves the needle. A stronger workshop-style process should connect your decision to high-value skills and proof of work, not just a role or course label.',
  },
  {
    title: 'Check whether the session actually ends with a decision',
    body:
      'A genuine workshop-style process should close with a narrowed shortlist and a stated next step, not another open-ended list of options to keep thinking about on your own.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger issue is the full decision itself, not only the workshop-style format.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description:
      'Use the main counselling page if the main question is clarity and next steps rather than a structured, session-based process.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'See the online-delivery page if the main filter for you is joining from anywhere in India without travelling.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Use free, updated, practical, AI-powered career and skill assessments as a no-cost supporting check if you are still early.',
  },
];

const faqItems = [
  {
    question: 'What actually happens in a career counselling workshop at Future Career School?',
    answer:
      'It is a structured, guided process, not a general talk. The session works through your profile, strengths, and real decision, then moves toward a narrower shortlist, a skill direction, and a specific next step you can use.',
  },
  {
    question: 'Is this a one-time session or an ongoing workshop-style program?',
    answer:
      'A first 1-on-1 session starts the process. For students, the stronger path continues afterward as structured small-group sessions across the year, so skill and path decisions stay on track instead of stopping after one meeting.',
  },
  {
    question: 'Who is a career counselling workshop useful for?',
    answer:
      'Students, freshers, and working professionals across India who want a structured, working session rather than a passive talk or a generic webinar.',
  },
  {
    question: 'Is a career development workshop online the same as this?',
    answer:
      'Yes, in practice they point to the same real need: structured, practical support delivered online instead of a one-off in-person seminar. The useful question is whether the format actually works through your decision, not the exact label used.',
  },
  {
    question: 'What is the difference between this and a regular career counselling session?',
    answer:
      'The commercial service is the same practical family of career counselling, guidance, and coaching. The workshop-style framing simply describes how the process is delivered: structured, hands-on, and built to continue rather than a single loose conversation.',
  },
  {
    question: 'Will I get a certificate or attend a scheduled group event?',
    answer:
      'No. This is not a certificate program or a fixed-date public seminar. It is structured 1-on-1 guidance for individuals, with an ongoing small-group continuation available for students who want to keep skill and path decisions on track across the year.',
  },
  {
    question: 'Can working professionals use a structured career counselling session too?',
    answer:
      'Yes. It is useful for professionals working through stagnation, AI pressure, a pivot decision, or salary-ceiling frustration in one focused, structured sitting.',
  },
  {
    question: 'What should I prepare before a structured career counselling session?',
    answer:
      'Bring your real shortlist, your actual constraints (budget, location, family or work pressure), and the one decision that feels most urgent right now. That is what makes the session feel like real work instead of a generic talk.',
  },
  {
    question: 'Are the assessments used in this process free?',
    answer:
      'Yes. Career and skill assessments are fully free, and they can be described as updated, practical, and AI-powered, unlike many providers who charge thousands for outdated or impractical versions.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so you can join the session from home, college, or work instead of depending on a local, in-person workshop.',
  },
  {
    question: 'Do you guarantee a job after the workshop?',
    answer: 'No ethical provider can guarantee a job. The goal is stronger decision-making, skill direction, and proof of work, not a placement promise.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Counselling Workshop',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Workshop | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling Workshop',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling Workshop</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Structured career counselling workshop, delivered online across India
      </div>

      <h1 class="hero-title">
        Career counselling workshop
        <span class="gold-text"> built as structured guidance, not a one-off talk</span>
      </h1>
      <p class="hero-sub">
        A career counselling workshop should leave you with more than notes from a talk. Future Career School runs it as a structured, guided process — profile, decision pressure, skill direction, and a practical next step — aimed at a high-value skill portfolio, unlocking high income opportunities, and earlier financial freedom, not just a certificate of attendance.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. You can join from home, college, or work — no travel, no waiting for a local seminar date.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        For students, the structured format continues after the first session as small-group guidance across the year, so the workshop-style support does not end after one sitting.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-workshop-means"
    sectionClass="workshop-signal-band"
    variant="signal"
    title="What a career counselling workshop should actually mean"
    subtitle="The word 'workshop' should signal a working session, not a passive talk. Here is what that looks like in practice."
    items={whatWorkshopMeansItems}
  />

  <ContextualCta
    audience="mixed"
    title="Use a structured session when a vague talk or webinar has not moved the decision"
    body="A real workshop-style process should leave you with a narrower shortlist and a skill direction, not just more general career information."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="what-it-should-resolve"
    sectionClass="workshop-decision-band"
    variant="decision"
    title="What a structured career counselling workshop should help you decide"
    subtitle="The goal is not general career information. It is a sharper decision about what deserves real effort now, what skill direction to start, and what the next move should be."
    items={decisionItems}
  />

  <BofuStepFlowSection
    sectionId="how-it-works"
    sectionClass="workshop-flow-band"
    title="How the structured session should move the decision forward"
    subtitle="This is what makes it a working session instead of a talk: real profile, real trade-offs, and a real next step."
    items={flowItems}
  />

  <AudienceRelevance
    sectionClass="workshop-audience-band"
    title="How a structured career counselling workshop fits where you are right now"
    items={audienceItems}
  />

  <BofuListCardSection
    sectionId="not-just-a-talk"
    sectionClass="workshop-clarity-band"
    title="If a career talk, webinar, or seminar already left you unclear"
    subtitle="A 'workshop' label means little if the session never actually works through your decision. Here is the difference a structured, session-based process should make."
    items={objectionItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={objectionSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <GuidanceModelSection
    title="What the structured process should actually cover"
    subtitle="Beyond the first session, the work should go further: fit, high-leverage decisions, high-value skill direction, proof of work, and a clearer route toward stronger long-term growth."
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="workshop-comparison-band"
    title="Why a career counselling workshop still has to be more useful than a general talk"
    subtitle="Calling something a workshop does not automatically make it useful. The structure still has to be specific, practical, and strong enough for a real career decision."
    rows={comparisonRows}
    centered={true}
  />

  <BuyerChecks
    sectionClass="workshop-check-band"
    title="What to check before booking a career counselling workshop"
    subtitle="The goal is not a session that feels engaging for an hour. The goal is a decision that has genuinely moved by the time it ends."
    items={buyerCheckItems}
  />

  <div class="container workshop-assessment-note">
    <AssessmentSupportNote
      body="As a starting point, free career and skill assessments can surface strengths and work style before a bigger structured session."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </div>

  <ContextualCta
    audience="mixed"
    title="If a talk or webinar already told you what you knew, book a structured session instead"
    body="A working session should narrow your options, connect the choice to skill direction, and leave you with a next move you can use immediately."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
    title="Career Counselling Workshop Plans"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See other counselling and guidance pages, plus free assessments, before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="workshop-final-band"
    subtitle="Choose a career counselling workshop that works through your real decision, not one that only talks around it — aimed at a high-value skill portfolio and earlier financial freedom. Structured guidance, delivered online across India."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFaqSection
    title="Questions people ask before booking a career counselling workshop"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.workshop-signal-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.workshop-decision-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.workshop-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.workshop-audience-band .section-headline) {
    max-width: 22ch;
  }
  :global(.workshop-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.workshop-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.workshop-audience-band .audience-card h3) {
    font-size: 1.08rem;
    line-height: 1.46;
  }
  :global(.workshop-audience-band .audience-card p) {
    font-size: 14.2px;
    line-height: 1.82;
  }
  :global(.workshop-clarity-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(229,184,74,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.007));
  }
  :global(.workshop-clarity-band .list-card-grid.is-two-col) {
    align-items: stretch;
  }
  :global(.workshop-clarity-band .bofu-summary-strip) {
    margin-top: 1.2rem;
  }
  :global(.workshop-comparison-band .section-headline),
  :global(.workshop-check-band .section-headline) {
    max-width: 20ch;
  }
  :global(.workshop-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.workshop-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.workshop-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.workshop-final-band .final-sub) {
    max-width: 52ch;
  }

  .workshop-assessment-note {
    padding: 0.5rem 0 3rem;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub {
    font-size: clamp(15px, 1.95vw, 18px);
    color: rgba(255,255,255,.72);
    line-height: 1.88;
    max-width: 820px;
    margin-bottom: 1rem;
  }
  .hero-note {
    font-size: 14px;
    color: rgba(255,255,255,.56);
    line-height: 1.8;
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-actions .btn-gold,
  .hero-actions .btn-outline {
    min-width: min(100%, 290px);
    justify-content: center;
  }
  .hero-support {
    font-size: 14px;
    color: rgba(255,255,255,.58);
    line-height: 1.8;
    max-width: 720px;
    margin-top: 1rem;
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
