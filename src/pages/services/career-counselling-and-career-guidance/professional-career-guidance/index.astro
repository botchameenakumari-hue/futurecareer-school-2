---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY } from '../../../../config/bofu';

const title =
  'Professional Career Guidance | Structured, Assessment-Backed Direction | Future Career School';
const description =
  'Professional career guidance from Future Career School: a structured, assessment-backed process for students, freshers, and working professionals who want decisions built on a real framework, not one person’s opinion.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/professional-career-guidance/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[3],
  BOFU_COMPARISON_LIBRARY[5],
];

const processQualityItems = [
  {
    eyebrow: 'Step one, every time',
    title: 'Structured profile and psychometric mapping first',
    body: 'Every serious recommendation starts with mapping strengths, preferences, and work style through a real psychometric assessment and profile mapping step, not a five-minute chat before an answer gets handed to you.',
  },
  {
    eyebrow: 'One framework, not one opinion',
    title: 'A repeatable decision framework behind every recommendation',
    body: 'Path, skill, and risk trade-offs get judged against the same high-leverage decision process each time, so the answer does not depend on which counsellor you happen to get or how convincing an idea sounds in the moment.',
  },
  {
    eyebrow: 'Skill-first, not degree-only',
    title: 'A skill-portfolio methodology, not a course label',
    body: 'A degree is treated as one input, not the whole strategy. The process is built around a deliberate high-value, high-income skill portfolio and the proof of work that makes it visible to the market — because that portfolio is what unlocks stronger income opportunities and moves you toward earlier financial freedom.',
  },
  {
    eyebrow: 'Run as a service, not a favor',
    title: 'An organized process you can hold to a standard',
    body: 'Guidance runs through Future Career School as a structured service delivered online across India, not one person operating from memory or mood, so the same process should hold up whether this is your first session or your fifth.',
  },
];

const objectionItems = [
  {
    title: '“Professional” sounds like a marketing word. What does it actually mean here?',
    body: 'It means the process, not the label: structured profile and psychometric mapping before any recommendation, a repeatable decision framework for path and skill trade-offs, and free assessments that are updated, practical, and AI-powered instead of a generic personality quiz.',
  },
  {
    title: 'How is this different from a friend’s advice, a WhatsApp group, or a random online quiz?',
    body: 'A friend’s advice or a five-minute quiz does not connect your profile, the market, and your skill direction into one decision. That connection — fit, market reality, risk, and a next step — is what the structured process is built to do.',
  },
  {
    title: 'Are the free assessments real methodology, or just a lead-generation quiz?',
    body: 'The assessments are free, updated, practical, and AI-powered, and they feed directly into the same profile-mapping step every guidance decision starts from. Many providers charge thousands for outdated, impractical assessments and still leave you with a label instead of a decision.',
  },
  {
    title: 'Will the quality stay the same every time, or does it depend on who I get?',
    body: 'The process is designed to hold up regardless of which session you are in — the same framework for mapping fit, judging trade-offs, and building skill direction applies whether it is your first conversation or a later one.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the process starts with real mapping, not a guess',
    body: 'A five-minute conversation followed by a confident answer is not a professional process. Look for structured profile, preference, and psychometric mapping before any recommendation gets made.',
  },
  {
    title: 'Check whether decisions follow a framework or a mood',
    body: 'Ask what the reasoning is built on. Guidance that can explain its own decision logic — fit, market reality, and risk — is different from guidance that just feels confident.',
  },
  {
    title: 'Check whether skill direction and proof of work are part of the process',
    body: 'Degree-only or course-label advice is not a complete strategy. Professional-grade guidance should connect your path decision to a high-value skill portfolio and proof of work the market can actually see.',
  },
  {
    title: 'Check whether the assessments back up the guidance or just decorate it',
    body: 'Paid, outdated, impractical assessments dressed up as a deal-breaker are common in this market. Free, updated, practical, AI-powered assessments that actually feed the guidance process are a stronger signal of real methodology.',
  },
];

const faqItems = [
  {
    question: 'What does "professional" mean in professional career guidance?',
    answer:
      'It describes how the guidance is built, not a marketing label: structured profile and psychometric mapping before any recommendation, a repeatable high-leverage decision framework for path, skill, and risk, a skill-first approach with proof of work rather than degree-only advice, and free, updated, practical, AI-powered assessments feeding into that same process, delivered through Future Career School as an organized service rather than one person’s opinion.',
  },
  {
    question: 'Is professional career guidance the same as career guidance for working professionals?',
    answer:
      'No. This is about the quality and structure of the guidance process itself, and it applies whether you are a student, a fresher, or already working. If you are specifically dealing with stagnation, AI pressure, or a pivot decision as an employed professional, the working professional career guidance page goes deeper into that exact situation.',
  },
  {
    question: 'How do I know this is not just generic advice presented in a nicer way?',
    answer:
      'The test is whether the process can explain its own reasoning. Structured profile mapping, a consistent decision framework for path and skill trade-offs, and skill-first direction with proof of work are what separate a professional-grade process from generic advice that still leaves you guessing.',
  },
  {
    question: 'Does a degree matter less in this process?',
    answer:
      'A degree still has a place and can support eligibility for many paths. The issue is degree-only thinking without skill-building alongside it. The process here treats a degree as one input and builds the real direction around a high-value skill portfolio and proof of work.',
  },
  {
    question: 'Are the career and skill assessments actually free?',
    answer:
      'Yes. The career and skill assessments, career and income-growth resources, and the Career & Skills Compass and course-finder tools are fully free. They are updated, practical, and AI-powered, unlike the outdated, impractical assessments many providers charge thousands for.',
  },
  {
    question: 'Is this available online across India, and do you guarantee a job?',
    answer:
      'Guidance is delivered fully online across India, so you can join from home, college, or work. No ethical provider can guarantee a job, and this is not positioned as a placement service — the goal is a stronger, professionally structured decision process.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step career decisions when several choices need to make sense together.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'Practical direction for people who need clearer next steps, stronger trade-offs, and better skill choices.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/working-professional-career-guidance/',
    title: 'Working Professional Career Guidance',
    description: 'For stagnation, AI pressure, pivots, and salary-growth decisions once you are already working.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/best-career-counsellor/',
    title: 'What Makes a Career Counsellor Worth Trusting',
    description: 'A closer look at training, breadth of experience, and honesty about limits — useful if you want to judge quality before you choose any provider.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/best-career-counselling-platform/',
    title: 'Evaluating a Career Counselling Platform',
    description: 'How to judge personalization, assessment quality, and pricing transparency across providers before you commit.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free, updated, practical, AI-powered assessments for stream decisions, aptitude signals, skill fit, and career direction.',
  },
  {
    href: '/career-skills-compass',
    title: 'Career & Skills Compass',
    description: 'Start exploring high-value skill direction before bigger commitments.',
  },
  {
    href: '/career-resources',
    title: 'Career Resources',
    description: 'Free guides, roadmaps, and checklists for acting on your next move.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Professional Career Guidance',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Professional Career Guidance | Future Career School',
    description:
      'Structured, assessment-backed career guidance for students, freshers, and working professionals who want decisions built on a repeatable framework rather than one person’s opinion.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Professional Career Guidance</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        A structured, assessment-backed process, not one person&rsquo;s opinion
      </div>

      <h1 class="hero-title">
        Professional career guidance
        <span class="gold-text"> built on a process you can actually check</span>
      </h1>
      <p class="hero-sub">
        Future Career School delivers professional career guidance for students, freshers, and working professionals who want to know the advice they act on is genuinely structured, not a friend&rsquo;s opinion, a five-minute chat, or a generic online quiz.
        That matters because the skill portfolio you choose here is what unlocks stronger income opportunities and a realistic route toward earlier financial freedom — not a decision worth leaving to guesswork.
      </p>
      <p class="hero-note">
        &ldquo;Professional&rdquo; here describes how the guidance is delivered — structured, assessment-backed, and run as an organized process — not who it is for. Whether you are a student, a fresher, or already working, the same process applies, and it runs fully online across India.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Guidance</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
      <p class="hero-support">
        You should be able to check the process, not just trust the tone. The next sections show exactly what makes this guidance professional-grade.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-makes-it-professional"
    title="What actually makes career guidance professional-grade"
    subtitle="Not a tagline. This is the process that stands behind every recommendation, from the first mapping step to the skill portfolio it points you toward."
    items={processQualityItems}
    columns={2}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As part of that structured process, the free career and skill assessments are updated, practical, and AI-powered, instead of the outdated, paid assessments many providers charge thousands for."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <ComparisonMatrix
    sectionId="different"
    title="Why the word professional should mean something here"
    subtitle="A professional-grade process should hold up to scrutiny. Here is the honest contrast between guidance that stays generic and guidance built on structure."
    rows={comparisonRows}
  />

  <BuyerChecks
    title="What to check before trusting any career guidance as genuinely professional"
    subtitle="Anyone can call their advice professional. These are the checks that actually separate a structured process from a confident opinion."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="A skill or path decision this important deserves a process, not a guess"
    body="If the guidance you are considering cannot explain its own reasoning, that is worth noticing before you commit time or money to it."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <GuidanceModelSection
    title="What a professional-grade guidance process actually includes"
    subtitle="This is the same structured process behind every serious guidance decision here — not a one-off conversation that ends when the call does."
  />

  <AudienceRelevance title="How a structured, professional-grade process fits wherever you are right now" />

  <BofuFeatureSection
    sectionId="objections"
    title="Doubts worth resolving before trusting any guidance as professional"
    subtitle="These are the questions worth asking before you decide whether guidance is genuinely structured or just confidently generic."
    items={objectionItems}
    variant="prep"
  />

  <ContextualCta
    audience="mixed"
    title="Do not let an important skill or path decision rest on an opinion instead of a process"
    body="A structured process should leave you with a clearer trade-off, a stronger skill direction, and a next step you can actually act on."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Professional Career Guidance"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See how to judge guidance quality, other guidance pages, assessments, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection title="Questions people ask before trusting professional career guidance" items={faqItems} />

  <FinalCta
    audience="mixed"
    title="Choose guidance you can actually verify as professional-grade"
    subtitle="Structured profile mapping, a repeatable decision framework, and a skill-first process with proof of work — built to move you toward stronger income opportunities and earlier financial freedom, not one person's opinion dressed up as advice."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  section[id] { scroll-margin-top: 108px; }
  #hero { padding: 138px 0 82px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -160px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.5rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.15rem, 5vw, 3.7rem); line-height: 1.06; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1rem; overflow-wrap: anywhere; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.8; max-width: 780px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.75; max-width: 760px; margin-bottom: 1.8rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-makes-it-professional,
  #different,
  #related-links { background: rgba(255,255,255,.012); }

  #objections,
  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 680px) {
    #hero { padding: 118px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline { justify-content: center; }
  }
</style>
