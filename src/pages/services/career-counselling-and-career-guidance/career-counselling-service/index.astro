---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title = 'Career Counselling Service | Clear Deliverables, Real Process | Future Career School';
const description =
  'Evaluating a career counselling service before you pay? See exactly what is included, how the process is structured from booking to outcome, what to check about any provider, and transparent pricing for students and working professionals.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-service/';

const stepFlowItems = [
  {
    title: 'Map your profile and the real decision',
    body: 'The service starts with strengths, preferences, work style, and the actual decision pressure you are under — not a generic script that ignores your stage.',
  },
  {
    title: 'Get high-leverage decision support',
    body: 'Path, skill, and risk trade-offs get put on the table clearly, so you can see what you are choosing and what you are choosing away from.',
  },
  {
    title: 'Choose high-value skill direction',
    body: 'The plan moves toward a deliberate, high-value skill portfolio matched to your profile and market reality, not one isolated skill guess.',
  },
  {
    title: 'Build proof of work and market validation',
    body: 'You leave with a practical way to show the market more than a degree alone — portfolio signals, positioning, and credibility that a resume cannot carry by itself.',
  },
  {
    title: 'Plan the growth and income route',
    body: 'The last layer connects skill choices to income growth, tech leverage, and a realistic route toward achieving earlier financial freedom.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity and mapping included in every session',
    listItems: [
      'Profile, strengths, and work-style mapping before any recommendation is made',
      'A clear decision frame instead of open-ended conversation',
      'Direction based on fit, market reality, and risk — not a generic checklist',
    ],
  },
  {
    title: 'Skill and path direction included in the plan',
    listItems: [
      'A shortlist of high-value skill directions matched to your profile',
      'Trade-offs explained so the next move is a decision, not a guess',
      'A practical next step you can act on immediately after the session',
    ],
  },
  {
    title: 'Growth support included beyond the first conversation',
    listItems: [
      'Guidance on proof of work, portfolio signals, and market positioning',
      'A route toward stronger income growth and earlier financial freedom',
      'For students, continuous guidance that keeps skill choices on track across the year through small-group sessions after the first 1-on-1',
    ],
  },
];

const providerCheckItems = [
  {
    title: 'Ask what happens after you pay',
    body: 'A credible career counselling service should tell you exactly what a session covers, what you walk away with, and whether continued support is optional or forced on you. If that answer stays vague before you pay, it usually stays vague after.',
  },
  {
    title: 'Ask whether the process is documented or improvised',
    body: 'Stronger services follow a real sequence — profile mapping, decision support, skill direction, proof of work, and growth planning — instead of reinventing the conversation every time. Ask what that sequence actually looks like for your stage.',
  },
  {
    title: 'Ask whether the assessments are current or recycled',
    body: 'Many providers charge thousands for outdated, generic personality tests and treat the report as the main product. Free, updated, practical, AI-powered career and skill assessments are a stronger starting signal than an expensive PDF.',
  },
  {
    title: 'Ask what the provider will not promise you',
    body: 'No ethical career counselling service can guarantee a job or a fixed income outcome. A provider that guarantees results outright is usually a bigger warning sign than one that stays honest about what guidance can and cannot do.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the price you see is the whole price',
    body: 'Look for a service that shows the session price and any continuation option upfront, with no separate fee layer that only appears after you have already paid.',
  },
  {
    title: 'Check what the service actually delivers, not just what it promises',
    body: 'Vague language like "we will help you figure it out" is not a deliverable. Look for specific outputs: profile clarity, skill direction, proof-of-work guidance, and a growth plan.',
  },
  {
    title: 'Check whether the process has real structure or is improvised session-to-session',
    body: 'A service built around a repeatable sequence usually gives more consistent value than one that reinvents the conversation for every client.',
  },
  {
    title: 'Check whether the assessments behind the service are current or recycled',
    body: 'Free, updated, practical, AI-powered career and skill assessments are a stronger starting layer than a paid, outdated, impractical assessment presented like a deal-breaker.',
  },
];

const audienceItems = [
  {
    label: 'Students and Early-Career',
    title: 'Deciding whether this service is worth committing to before a stream, course, or first-job decision',
    body: 'You are not only choosing a career direction — you are also choosing whether this service gives you a structured plan and proof-of-work guidance, or one more open-ended conversation before you spend more time on the wrong path.',
  },
  {
    label: 'Working Professionals',
    title: 'Evaluating whether this service can actually move a stalled career forward',
    body: 'You already know what generic advice sounds like. What matters here is whether the service gives you a real process toward stronger positioning, higher-value skills, and earlier financial freedom — not just a sympathetic conversation.',
  },
];

const faqItems = [
  {
    question: 'What exactly is included in this career counselling service?',
    answer:
      'The service starts with profile and work-style mapping, moves into high-leverage decision support around path, skill, and risk, then into high-value skill direction, proof-of-work guidance, and a growth plan aimed at stronger income and earlier financial freedom. Students who continue past the first session move into ongoing small-group career guidance so skill choices stay on track across the year.',
  },
  {
    question: 'How is the career counselling service structured from booking to outcome?',
    answer:
      'It starts with one focused 1-on-1 session built around your actual decision, not a generic script. From there, the direction depends on your stage: students can continue into small-group continuous guidance, while working professionals typically use focused 1-on-1 sessions around specific pivots, stagnation, or positioning decisions.',
  },
  {
    question: 'Who provides this career counselling service?',
    answer:
      'Future Career School runs the service for students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages, delivered fully online across India.',
  },
  {
    question: 'Is this a one-time session or ongoing support?',
    answer:
      'Both options exist. A single 1-on-1 session is available for a focused decision. For students, continuous guidance is also available after the first session — small groups, usually 10 or fewer members, running across the year — for anyone who wants skill choices supported on an ongoing basis rather than just once.',
  },
  {
    question: 'Is the pricing for this service transparent before I pay?',
    answer:
      'Yes. Current pricing for every plan is shown here before you book, including the exact session price and what a continuous-guidance path includes, with no separate hidden fee layer added after payment.',
  },
  {
    question: 'Does the service guarantee a job or income outcome?',
    answer:
      'No. No ethical career counselling service can guarantee a job or a fixed income outcome. What the service can do is give you clearer decisions, stronger skill direction, proof of work, and a more realistic route toward income growth and achieving earlier financial freedom.',
  },
  {
    question: 'Are the assessments part of the service free, or do I pay separately?',
    answer:
      'Career and skill assessments are fully free and can be described as updated, practical, and AI-powered. Many providers charge thousands for outdated or impractical assessments; here, the free assessments are meant to be a stronger starting layer before you decide on paid 1-on-1 support.',
  },
  {
    question: 'Is this career counselling service available where I live?',
    answer:
      'Yes. The service is delivered fully online across India, so you can join from home, college, or work without depending on a local office or nearby counsellor.',
  },
  {
    question: 'What should I check before choosing any career counselling service, including this one?',
    answer:
      'Check whether the pricing is transparent upfront, whether the deliverables are specific rather than vague, whether the process has real structure, and whether the assessments behind it are current rather than recycled. If a provider cannot answer those clearly, that is worth noticing before you pay.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step career decisions.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'Use this version if decision clarity is the main need and the service structure itself is not the deciding factor.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/best-career-counselling-platform',
    title: 'Best Career Counselling Platform',
    description: 'Compare how career counselling providers differ on credentialing, personalisation, assessment quality, and pricing transparency.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-fees',
    title: 'Career Counselling Fees',
    description: 'See a direct breakdown of what career counselling typically costs and what drives the price difference between providers.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-vs-career-coaching',
    title: 'Career Counselling vs Career Coaching',
    description: 'Understand the real difference between counselling and coaching before deciding which label matches what you actually need.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingSession,
    title: 'Career Counselling Session',
    description: 'See the single-session, consultation-style version if you want one focused conversation rather than an ongoing plan.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-mentoring-program',
    title: 'Career Mentoring Program',
    description: 'See the ongoing-relationship version of this same support if ideas, plans, and opportunities keep changing for you.',
  },
  {
    href: '/services/assessments',
    title: 'Free Assessments',
    description: 'All assessments, resources, Career & Skills Compass, and course-finder tools are fully free and useful before you decide on paid support.',
  },
  {
    href: '/career-resources',
    title: 'Career Resources',
    description: 'Use free resources to keep moving between bigger decisions.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Counselling Service',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Service | Future Career School',
    description:
      'A career counselling service for students, freshers, and working professionals that maps out clear deliverables, a structured process from profile mapping through skill direction and proof of work, and a transparent path toward income growth and achieving earlier financial freedom.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling Service</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        A career counselling service with clear deliverables, not just a conversation.
      </div>

      <h1 class="hero-title">
        Career counselling service
        <span class="gold-text"> built around what you get, not just who you talk to</span>
      </h1>
      <p class="hero-sub">
        Future Career School runs a career counselling service for students, freshers, and working professionals who want to know exactly what a session includes, how the process is structured, and who is actually delivering it — before committing money to stronger skill direction, proof of work, and a clearer route toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Delivered fully online across India. You can start from home, college, or work — no travel, no dependence on local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        A career counselling service should earn your trust before it earns your money: clear deliverables, a real process, and a provider that stays honest about what guidance can and cannot promise.
      </p>
    </div>
  </section>

  <BofuStepFlowSection
    sectionId="how-it-works"
    title="How the career counselling service works, start to finish"
    subtitle="Each stage builds on the last one, moving from profile clarity toward stronger skill direction, proof of work, and a realistic route toward achieving earlier financial freedom."
    items={stepFlowItems}
  />

  <BofuListCardSection
    sectionId="whats-included"
    title="What is included in the career counselling service"
    subtitle="Before you pay for any career counselling service, you should know exactly what you are getting. Here is what is included at each stage of this one."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As a starting layer, free career and skill assessments are available to surface strengths, preferences, and work style before you decide on paid 1-on-1 support."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <ComparisonMatrix
    sectionId="how-it-compares"
    title="How this career counselling service compares to generic options"
    subtitle="The difference is not the label. It is whether the service gives you higher-value skill direction, proof of work, and clearer income-growth logic instead of a nicer-sounding version of the same generic advice."
  />

  <ContextualCta
    audience="mixed"
    title="If you already know what you need clarity on, the next step is one focused session"
    body="Book the plan that matches your stage and get a session built around your actual decision, not a generic script."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="provider-credibility"
    title="What separates a credible provider from a risky one"
    subtitle="Before you pay for any career counselling service, these are the questions worth asking about the provider itself, not just the promise on the landing page."
    items={providerCheckItems}
    variant="decision"
  />

  <AudienceRelevance
    sectionId="audience-fit"
    title="How the service fits where you are right now"
    items={audienceItems}
  />

  <BuyerChecks
    sectionId="check-before-paying"
    title="What to check before paying for any career counselling service"
    subtitle="A career counselling service should be easy to evaluate before you pay for it. Use these checks on this service, or any other one you are comparing it against."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Ready to see exactly what you get for the price"
    body="Compare the student and working-professional plans below, then book the one that matches your stage."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling Service"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See how this service compares to other providers, formats, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection title="Questions people ask before booking this career counselling service" items={faqItems} />

  <FinalCta
    audience="mixed"
    eyebrow="Next step"
    title="Book a career counselling service with clear deliverables"
    subtitle="Move forward when you are ready for a structured process toward stronger skill direction, proof of work, and a realistic route toward earlier financial freedom — not another open-ended conversation."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #whats-included,
  #how-it-compares,
  #related-links { background: rgba(255,255,255,.012); }

  #how-it-works,
  #audience-fit,
  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 680px) {
    #hero { padding: 118px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline,
    .hero-actions .btn-soft { justify-content: center; }
  }
</style>
