const broaderGuidanceSummaryItems = [
  {
    title: 'One-layer confusion',
    body: 'A single decision often needs just one focused clarity layer first.',
  },
  {
    title: 'Multi-layer confusion',
    body: 'Broader guidance fits better when path, skills, and execution questions are stacked together.',
  },
  {
    title: 'Growth matters too',
    body: 'Broader direction problems usually involve skill direction, proof of work, and income growth, not only one isolated choice.',
  },
];

const objectionItems = [
  {
    title: 'I already read a lot online, so why do I still need guidance?',
    body: 'More information does not automatically create better decisions. Practical guidance matters when you still need clearer direction, clearer trade-offs, and a next step you can actually use.',
  },
