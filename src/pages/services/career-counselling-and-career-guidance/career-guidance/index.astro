const broaderGuidanceItems = [
  {
    title: 'Stream or degree confusion',
    body: 'You are trying to judge direction before a course, degree, or preparation track locks you into the wrong path. For a student, that choice is where earlier financial freedom either starts or gets delayed by years.',
  },
  {
    title: 'Skill-path confusion',
    body: 'The bigger question is not only what to study on paper. It is which high-value skill belongs in your portfolio for your next serious effort phase.',
  },
  {
    title: 'Post-graduation realignment',
    body: 'You already moved forward on paper, but fit, market reality, or growth speed still feels off and needs a clearer reset.',
  },
  {
    title: 'Pivot or salary-ceiling pressure',
    body: 'For a working professional, the path question is now about stagnation, AI pressure, or skill under-leverage — the fix is a stronger skill portfolio that unlocks high income opportunities without blowing up your stability.',
  },
