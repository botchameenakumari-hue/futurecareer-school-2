      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance | Future Career School',
    description:
      'Career guidance for students, freshers, and working professionals who want stronger skill direction, proof of work, income growth, and a clearer route toward achieving earlier financial freedom.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
