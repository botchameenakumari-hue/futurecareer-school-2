import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title = 'Career Guidance | Practical Direction and Next Steps | Future Career School';
const description =
  'Career guidance online across India — build a high-value skill portfolio, get proof of work, and move toward higher income and earlier financial freedom.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/';

const buyerCheckItems = [
  {
    title: 'Check whether the guidance actually reduces confusion',
    body: 'Too much advice stays generic and leaves you guessing. Better guidance should help you judge clearer trade-offs, rule out weak options, and see what a better next step actually means.',
  },
  {
    title: 'Check whether skills are included, not just course or job labels',
    body: 'Degree-only or job-title-only advice is rarely practical. Look for guidance that helps you understand which high-value skills matter most and how to build proof of work alongside your path choice.',
  },
  {
    title: 'Check whether the reasoning survives when pressure is on',
    body: 'The real test is whether the direction still makes sense when a parent doubts it, an option closes, or the timeline gets tighter. Good guidance should give you confidence that can survive doubt.',
  },
  {
    title: 'Check whether the process respects your real situation',
    body: 'One-size guidance often fits nobody. Stronger guidance should adapt to your stage, your options, your risk tolerance, and what a better next move actually looks like for you.',
  },
];

const faqItems = [
  {
    question: 'What does career guidance mean here?',
    answer:
      'Career guidance here means choosing with more clarity before time and money get wasted, focusing on skills that create better long-term opportunities, showing skills and proof of work, and moving with clearer income-growth logic.',
  },
  {
    question: 'Who is this career guidance for?',
    answer:
      'Future Career School serves students, freshers, and working professionals. It is useful when you need clearer direction, better skill-path decisions, or a more practical next step than generic advice.',
  },
  {
    question: 'Is career guidance different from career counselling or career coaching?',
    answer:
      'In practice, people often use career guidance, career counselling, career coaching, career strategy, and other close variants to mean the same practical thing: they want clearer decisions and stronger skill direction. The useful difference is not the label. It is whether the guidance helps you avoid low-growth decisions and move toward higher-value skills, proof of work, income growth, and achieving earlier financial freedom.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered. Many providers charge thousands for outdated or impractical assessments; these are meant to be a stronger free starting layer instead.',
  },
  {
    question: 'How do I know if I need career guidance right now?',
    answer:
      'Career guidance is most useful when the next decision feels important, expensive, hard to reverse, or already delayed by confusion.',
  },
  {
    question: 'What should good career guidance leave me with?',
    answer:
      'Good career guidance should leave you with clearer trade-offs, a stronger skill direction, a practical next step, and a better sense of what leads toward real income growth.',
  },
  {
    question: 'Should I use free assessments or book career guidance now?',
    answer:
      'If you are still exploring and the decision is not urgent yet, free assessments, resources, and Career & Skills Compass tools can be a useful first layer. If the next decision already feels important, expensive, or delayed by confusion, stronger guided support can help more.',
  },
  {
    question: 'What should I prepare before asking for career guidance?',
    answer:
      'Be clear about your current stage, the decision that matters most right now, the options you are considering, and where confusion or weak execution keeps repeating.',
  },
  {
    question: 'How is this different from normal career guidance?',
    answer:
      'A lot of career advice stays generic, degree-first, and low-growth. Many providers also charge thousands for outdated or impractical assessments. The stronger direction here is high-value skill building, proof of work, better income growth, and a clearer route toward achieving earlier financial freedom.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so you can join from home, college, or work instead of depending on local availability.',
  },
  {
    question: 'Do you guarantee a job?',
    answer:
      'No ethical provider can guarantee a job.',
  },
  {
    question: 'What should I check before choosing any career guidance service?',
    answer:
      'Check whether the advice is generic or genuinely useful, whether it helps with higher-value skill direction and proof of work, and whether it improves income-growth direction.',
  },
  {
    question: 'What if my confusion is about skills, not only degree or course choice?',
    answer:
      'That is a common reason career guidance matters. Practical guidance should not stop at course labels. It should help you judge which skill direction is worth your next serious effort phase based on fit, market reality, and risk.',
  },
  {
    question: 'What if several options all seem acceptable right now?',
    answer:
      'That is exactly where clearer decision framing helps. Good guidance should narrow broad options into a shorter shortlist of serious directions, then help you judge trade-offs before the next bigger commitment.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
