---

<BaseLayout
  title="Career Counselling, Career Guidance, and Career Coaching | Future Career School"
  description="Career counselling, career guidance, and career coaching for students, freshers, and working professionals who want practical direction and stronger skill choices."
  canonical="https://futurecareerschool.com/services/career-counselling-and-career-guidance"
  jsonLd={jsonLd}
>
  <Nav activePage="career-guidance" />

  <section id="services-hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling and Guidance</span>
      </nav>
      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling, career guidance, and career coaching for students and working professionals
      </div>
      <h1 class="hero-title">
        Career Counselling and Guidance for
        <span class="gold-text"> Students and Working Professionals</span>
      </h1>
      <p class="hero-sub">
        Whether someone searches for career counselling, career guidance, career coaching, or career strategy, the real need is usually the same:
        choosing with more clarity before time and money get wasted, focusing on skills that create better long-term opportunities,
        showing skills and proof of work, and moving toward achieving earlier financial freedom.
      </p>
      <p class="hero-sub hero-sub-secondary">
        Many providers charge thousands for outdated or impractical assessments and present them like deal-breakers.
        Here, the career and skill assessments are fully free, updated, practical, and AI-powered. Guidance is online across India, so people can start from home, college, or work instead of waiting for a local option.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Guidance</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move you forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, stronger positioning, and a clearer route toward achieving earlier financial freedom."
  />

  <BofuListCardSection
    sectionId="guidance-expectations"
    title="What Guidance Is and Isn't"
    subtitle="Good guidance should make the next decision clearer, not dress up generic advice in stronger words."
    items={expectationItems}
    variant="contrast"
  />

  <ContextualCta
    audience="mixed"
    title="Choose the audience or situation that fits you before more effort goes into the wrong next step"
    body="If the real need is already clear enough to act on, move now instead of keeping the decision in the abstract."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <BofuListCardSection
    sectionId="audiences"
    title="Career Guidance for Students and Working Professionals"
    subtitle="Different starting points still need the same foundations: clearer decisions, higher-value skill direction, proof of work, and a clearer path toward achieving earlier financial freedom. The career and skill assessments are fully free, updated, practical, and AI-powered."
    items={audienceItems}
    variant="audience"
  >
      <AssessmentSupportNote
        body="If you are still early and not ready for guidance yet, the free career and skill assessments can surface strengths, preferences, and work style before you commit to a bigger guidance decision."
      />
  </BofuListCardSection>

  <section id="guidance-start-points">
    <div class="container">
      <h2 class="section-headline">Start with the guidance situation closest to yours</h2>
      <p class="section-sub">
        If the labels feel similar, choose by your current decision first. The full guidance directory remains below for more specific pages.
      </p>
      <div class="guidance-start-grid">
        {guidanceStartCards.map((card) => (
          <article class="guidance-start-card card">
            <div class="guidance-start-label">{card.label}</div>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <a href={card.href}>Open this path &rsaquo;</a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Guidance"
    title="Clearer Career Decisions for Future Readiness and Earlier Financial Freedom"
  />

  <LinkDirectorySection
    sectionId="guidance-page-directory"
    title="Career Guidance for Different Situations"
    subtitle="Explore the guidance option that fits your current decision, stage, or pressure."
    items={completeGuidancePageDirectoryItems}
    altBackground={true}
  />

  <LinkDirectorySection
    sectionId="guidance-support-directory"
    title="Free Tools and Practical Resources"
    subtitle="Free assessments, tools, and practical reads that can help you move with more clarity."
    items={supportPageDirectoryItems}
  />

  <ComparisonMatrix
    sectionId="guidance-comparison"
    title="What actually changes when the guidance gets stronger"
    subtitle="See how clearer decisions, stronger skill direction, and more practical assessment support can change the outcome."
    centered={true}
  />

  <ContextualCta
    audience="mixed"
    title="Use guidance when the next serious career decision needs more than another round of public advice"
    body="The practical value is clearer skill direction, better trade-offs, and a stronger route forward before the wrong move becomes harder to reverse."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <section id="guidance-leverage">
    <div class="container">
      <h2 class="section-headline">
        The High-Leverage Career <span class="gold-text">Advantage</span>
      </h2>
      <p class="section-sub">
        What changes when guidance is skill-first and execution-driven.
      </p>
      <div class="leverage-grid">
        <article class="lev-item card"><h3>Income trajectory</h3><p>Linear growth vs compounding skill-based growth</p></article>
        <article class="lev-item card"><h3>Primary focus</h3><p>Degree completion vs high-value capability building</p></article>
        <article class="lev-item card"><h3>Recruiter signal</h3><p>Similar candidate vs clear differentiated value</p></article>
        <article class="lev-item card"><h3>Upskilling speed</h3><p>Random learning vs guided roadmap and course correction</p></article>
        <article class="lev-item card"><h3>Outcome</h3><p>Salary dependence only vs stronger income optionality</p></article>
      </div>
    </div>
  </section>

  <FinalCta
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <BofuFaqSection
    sectionId="guidance-faq"
    title="Common Questions Before You Start"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  .section-headline { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-wrap: balance; text-align: center; }
  .section-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.55); max-width: 760px; margin: 0 auto 3rem; text-align: center; line-height: 1.7; }

  #services-hero { padding: 140px 0 88px; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .hero-orb-1 { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .hero-orb-2 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 960px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.72); line-height: 1.9; max-width: 820px; margin-bottom: 1rem; }
