const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://futurecareerschool.com/services" },
      { "@type": "ListItem", "position": 3, "name": "Career Counselling and Career Guidance", "item": "https://futurecareerschool.com/services/career-counselling-and-career-guidance" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Career Counselling, Career Guidance, and Career Coaching | Future Career School",
    "description": "Career counselling, career guidance, and career coaching for students, freshers, and working professionals who need practical direction, high-value skill building, proof of work, and a clearer route toward achieving earlier financial freedom.",
    "url": "https://futurecareerschool.com/services/career-counselling-and-career-guidance",
    "serviceType": "Career Counselling, Career Guidance, and Career Coaching",
    "areaServed": { "@type": "Country", "name": "India" },
    "inLanguage": "en-IN",
    "provider": {
      "@type": ["Organization", "ProfessionalService"],
      "name": "Future Career School",
      "url": "https://futurecareerschool.com"
    }
  }
