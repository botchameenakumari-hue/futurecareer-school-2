    href: '/services',
    title: 'Guidance, Assessments, and Tools',
    description: 'See guidance, assessments, tools, and free resources in one place.',
  },
  {
    href: BOFU_INTERNAL_LINKS.assessments,
    title: 'Free Career Assessments',
    description: 'Free assessments for stream decisions, aptitude signals, skill fit, and career direction.',
  },
  {
    href: '/career-skills-compass',
    title: 'Career & Skills Compass',
    description: 'A free tool for narrowing the skill paths that fit your strengths and market direction.',
  },
  {
    href: '/career-resources',
    title: 'Career Resources',
    description: 'Free guides, roadmaps, and checklists for acting on your next move.',
  },
];

const expectationItems = [
  {
    title: 'What Guidance Is Not',
    listItems: [
      'A shortcut that works without effort on your part',
      'A placement service or guaranteed job outcome',
      'Generic advice you could find on public videos',
      'Degree-first pressure without skill thinking',
      'Low-growth path pushing dressed up as guidance',
      'Outdated assessments used as expensive theatre',
      'Something that replaces your own execution',
    ],
  },
  {
    title: 'What Guidance Is',
    listItems: [
      'A structured way to judge fit, market reality, and risk before bigger commitments',
      'Clarity on the exact skill and career path worth your next serious phase of effort',
      'A practical way to choose the skill path that matches your fit, market demand, and long-term upside',
      'Free updated practical AI-powered assessments before bigger commitments',
      'A stronger route toward proof of work, personal branding, and income growth',
      'Honest feedback even when it is not what you want to hear',
      'A clearer route toward achieving earlier financial freedom through stronger skill choices',
    ],
  },
];

const audienceItems = [
  {
    eyebrow: 'Student or Pre-Career',
    title: 'School, College, and Early-Career Students',
    body: 'Early direction, stream awareness, and first clarity before pressure turns into expensive wrong turns. This side also includes freshers, recent graduates, and postgraduates who still need stronger skill direction and proof-building.',
    groups: [
      {
        title: 'This is for you if',
        items: [
          "You're in school or college and don't know which path to commit to.",
          "You're a fresher or recent graduate and still do not know which skill direction is worth serious effort.",
