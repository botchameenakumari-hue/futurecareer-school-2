const completeGuidancePageDirectoryItems = completeGuidanceDirectoryItems(guidancePageDirectoryItems);

const guidanceStartCards = [
  {
    label: 'Students',
    title: 'School, college, or early-career direction',
    description: 'Use this path for stream decisions, after-12th choices, degree confusion, fresher direction, or first serious skill choices.',
    href: BOFU_INTERNAL_LINKS.students,
  },
  {
    label: 'After 12th',
    title: 'Course, degree, and next-step decisions',
    description: 'Start here when the immediate question is what to do after school and how to avoid a costly wrong direction.',
    href: BOFU_INTERNAL_LINKS.after12th,
  },
  {
    label: 'Working professionals',
    title: 'Career growth, pivot, or income leverage',
    description: 'Use this if the problem is stagnation, career switching, AI pressure, better positioning, or stronger long-term leverage.',
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
  },
  {
    label: 'Online guidance',
    title: 'Start from anywhere in India',
    description: 'Best when local availability is less important than structured guidance, practical assessment support, and clearer next steps.',
    href: BOFU_INTERNAL_LINKS.careerGuidanceOnline,
  },
  {
    label: 'First session',
    title: 'One focused consultation before committing',
    description: 'Use this when you want a low-commitment first conversation before deciding whether a longer guidance path makes sense.',
