---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_COMPARISON_LIBRARY,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title = 'Student Career Guidance | Stream, Course & Skill Direction | Future Career School';
const description =
  'Student career guidance for school, college, and postgraduate stages, with clearer stream, course, and skill direction before a wrong turn gets expensive.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/student-career-guidance/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[2],
  BOFU_COMPARISON_LIBRARY[5],
];

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step decisions when several connected choices need to make sense together.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingForStudents,
    title: 'Career Counselling for Students',
    description: 'Better fit when the need is one specific decision already narrowed to two options, not broader ongoing direction across school-to-postgraduate stages.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for stream decisions, aptitude signals, skill fit, and career direction.',
  },
  {
    href: '/services/assessments/class-10-and-below/',
    title: 'Class 10 and Below Assessment',
    description: 'Stream-fit, strength-mapping, and early direction before Class 11 choices harden.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12thOnline,
    title: 'Career Guidance After 12th Online',
    description: 'More focused help for the specific after-12th course or college decision, still delivered online from anywhere in India.',
  },
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduates and Early Professionals Assessment',
    description: 'Free clarity on fit, skill direction, employability, and stronger next steps for freshers and recent graduates.',
  },
  {
    href: '/blog/stream-selection/career-options-after-10th/',
    title: 'Career Options After 10th',
    description: 'Read the practical after-10th guide if the bigger issue is stream pressure before the next school decision.',
  },
];

const fitItems = [
  {
    title: 'School students',
    body: 'Stream decisions, early direction, and parent pressure often land at the same time — this is built for that stretch.',
  },
  {
    title: 'College students',
    body: 'The degree is already in motion, but the real skill direction still feels unclear.',
  },
  {
    title: 'Freshers, recent graduates, and postgraduates',
    body: 'The degree exists on paper. What is missing is the next skill move, proof of work, or a clear route into stronger income opportunities.',
  },
  {
    title: 'Parents who want clearer decisions',
    body: 'Not just a safe-sounding option — a path with better fit, lower regret, and stronger long-term upside.',
  },
];

const improvementItems = [
  {
    title: 'Stream and course clarity',
    body: 'Choose the next serious direction on real trade-offs, not marks, noise, or pressure alone.',
  },
  {
    title: 'Skill direction early',
    body: 'Start building higher-value skills now instead of waiting until the degree is almost over.',
  },
  {
    title: 'Proof before heavy commitment',
    body: 'Small practical signals, projects, and exposure test a direction before bigger money or time goes into it.',
  },
  {
    title: 'Parent decision confidence',
    body: 'Trade arguments driven by confusion for reasoning built on fit, market reality, and upside.',
  },
];

const faqItems = [
  {
    question: 'What should I do if my stream choice feels uncertain before 11th?',
    answer:
      'Stream choice is one of the most consequential decisions in school. Guidance matters most when marks, pressure, or parental expectations are pushing toward a direction that does not feel right. Getting clarity early keeps regret down and options open.',
  },
  {
    question: 'My parents want me to take science, but I am not sure. Can guidance help with that?',
    answer:
      'This is one of the most common pressures students face. A good session works through what you actually enjoy, which skills you want to build, and which paths genuinely interest you — not just what sounds impressive or safe to say at a family dinner.',
  },
  {
    question: 'Is this career guidance or career counselling for students?',
    answer:
      'Both terms get searched for the same underlying need, and this page covers it: broad, ongoing career guidance and counselling for students across school, college, and early-career stages. If the need is narrower — one specific stream, subject, or course decision already down to two options — career counselling for students is the better fit for that exact moment.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes, fully free — updated, practical, and AI-powered. Many providers charge thousands for outdated assessments; these are built to be a stronger free starting layer instead.',
  },
  {
    question: 'How is this different from what my school counselor would say?',
    answer:
      'School counselors matter, but their time and coverage are stretched across an entire batch. Focused guidance goes deeper into specific path options, skill directions, and trade-offs that match your fit and long-term goals, not just broad course categories.',
  },
  {
    question: 'What if I am confused about which course to choose in college?',
    answer:
      'That confusion is exactly what this addresses. Two similar-sounding courses can look identical on paper while opening very different skill and career doors. Guidance surfaces that difference before fees lock the decision in.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Guidance runs fully online across India, so students and families start from home, college, or wherever they already are, instead of depending on a local counsellor being available nearby.',
  },
  {
    question: 'Can this help if I already feel lost after choosing the wrong stream?',
    answer:
      'Yes. Being in a stream that does not fit is not a dead end — the session maps out the real options from here, whether that is skill-building to pivot, a different degree path, or making the strongest use of the direction already in motion.',
  },
  {
    question: 'What if my family expects me to follow a certain path?',
    answer:
      'Family expectations usually come from care, not just control. Guidance builds a clearer case for the conversation with your family — grounded in your strengths, interests, and market reality, not just whichever option sounds safer or more impressive.',
  },
  {
    question: 'How do I know this is the best career counselling for students?',
    answer:
      "Don't take 'best' on trust — judge it against a few concrete things. Does it get specific about your stream, stage, and situation instead of repeating the same advice to everyone? Does it lay out honest trade-offs instead of pushing one predetermined path? Does it connect the decision to real skill-building and proof of work, not just a stream or course label? And can you actually defend the reasoning to your parents afterward? Guidance that holds up on those points is a fair working definition of the best fit for a student.",
  },
];

const stageItems = [
  {
    title: 'School',
    body: 'Stream and subject decisions, usually with parent pressure at its peak. Guidance works through fit, strengths, and realistic trade-offs before Class 11 locks a direction in.',
  },
  {
    title: 'College',
    body: 'The degree is already chosen. Focus shifts to skill direction and early proof of work, closing the gap between a course label and what the market actually pays for.',
  },
  {
    title: 'Fresher or recent graduate',
    body: 'The degree exists on paper. The real work now is a deliberate skill portfolio and positioning — the part a degree alone was never going to create.',
  },
  {
    title: 'Postgraduate and beyond',
    body: 'Stronger careers rarely come from one decision. Skill choices keep getting checked against market shifts so direction compounds instead of going stale.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether it addresses stream pressure specifically',
    body: 'Generic career advice does not resolve marks pressure, parent expectations, or confusion between similar-sounding streams. Look for guidance that engages the actual stage-specific decision in front of you.',
  },
  {
    title: 'Check whether the process builds your own thinking',
    body: 'The stronger version of this builds your understanding of your own fit, preferences, and trade-offs — it does not just push you into a predetermined or safe-sounding path.',
  },
  {
    title: 'Check whether proof of work and skills are part of the path',
    body: 'Stream and course are only the opening move. Look for guidance that also covers building the right skills and getting early proof of work, not just picking a degree.',
  },
  {
    title: 'Check whether you can actually trust the clarity',
    body: 'Stream choices have real consequences. The reasoning behind the recommendation needs to hold up in a conversation with your parents, not just feel reassuring in the moment.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Student Career Guidance', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Student Career Guidance | Future Career School',
    description,
    url: canonical,
    serviceType: 'Student Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Student Career Guidance</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Student career guidance for school and college decisions
      </div>

      <h1 class="hero-title">
        Student career guidance
        <span class="gold-text"> before the wrong turn gets expensive</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers student career guidance for school students, college students, freshers, recent graduates, and postgraduates who need clearer stream, course, degree, and skill decisions before confusion turns into a wasted year.
        The goal is a stronger stream or course choice paired with the start of <strong>a high-value skill portfolio</strong>, not just a safer-sounding label.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so you can start from home, college, or wherever you already are without waiting for local availability or travel time.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Guidance</a>
      </div>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="fit"
    title="When student career guidance becomes useful"
    subtitle="This becomes useful when the next decision feels important, expensive, hard to reverse, or already delayed by confusion."
    items={fitItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Make the student decision clearer before the next stream, course, or degree step gets harder to reverse"
    body="Waiting rarely resolves stream or course confusion on its own. Move while the decision can still shape a stronger skill portfolio — unlocking high income opportunities later instead of a choice you end up relitigating in two years."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
  />

  <BofuStepFlowSection
    sectionId="stages"
    title="How student career guidance changes across each stage"
    subtitle="This is built for ongoing direction, not one isolated conversation — the focus shifts as the stage and the decision in front of you shift."
    items={stageItems}
  />

  <BofuFeatureSection
    sectionId="what-changes"
    title="What strong student career guidance actually improves"
    items={improvementItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="If you want a free assessment option before student career guidance, the stage-specific career and skill assessments can help you narrow strengths, preferences, and work style before a bigger student decision."
        href={BOFU_ASSESSMENT_LINKS.hub}
      />
  </BofuFeatureSection>

  <ComparisonMatrix
    title="Generic career advice versus guidance built around skill direction"
    subtitle="The difference shows up over years, not one conversation — in whether the path keeps building toward stronger income opportunities or just delays the same confusion."
    rows={comparisonRows}
  />

  <BuyerChecks
    title="What to check before paying for student career guidance"
    subtitle="The goal is clearer decisions and stronger direction, not generic advice or expensive theatre."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Use student guidance when the next move already feels important enough to stop guessing"
    body="When the real problem is direction rather than effort, resolving it now protects time, money, and the skill portfolio that ends up shaping income for years afterward."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Guidance"
    title="Student Career Guidance Plans"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See other guidance pages, assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Take the student decision seriously before it becomes expensive"
    subtitle="If the next stream, course, degree, or skill decision already feels important, move now with a plan tied to real skill direction and earlier financial freedom — instead of letting confusion keep compounding."
    studentHref="#plans"
    studentLabel="Get Student Career Guidance"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 44rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.85; max-width: 790px; margin-bottom: 1rem; }
  .hero-sub strong { color: rgba(255,255,255,.92); }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.54); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #what-changes,
  #related-links { background: rgba(255,255,255,.012); }

  #check-before-paying,
  #faq { background: rgba(255,255,255,.008); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.82rem, 9.6vw, 2.45rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
