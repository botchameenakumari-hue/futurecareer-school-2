---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
  BOFU_PAYMENT_LINKS,
} from '../../../../config/bofu';

const title = 'Working Professional Career Guidance | Future Career School';
const description =
  'Working professional career guidance for people dealing with stagnation, AI pressure, pivots, and the need for stronger skill direction, positioning, and income growth.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/working-professional-career-guidance';

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step decisions when several connected choices need to make sense together.',
    note: 'Parent page',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'Practical direction for people who need clearer next steps, stronger trade-offs, and better skill choices.',
    note: 'Related page',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professionals and Career Changers Assessment',
    description: 'Free input for pivots, salary growth, role fit, and stronger leverage decisions.',
    note: 'Stage page',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for stream decisions, aptitude signals, skill fit, and career direction.',
    note: 'Support page',
  },
  {
    href: '/skill-finder/',
    title: 'Skill Finder',
    description: 'A free tool for narrowing the skill paths that fit your strengths and market direction.',
    note: 'Support page',
  },
  {
    href: '/career-resources/',
    title: 'Career Resources',
    description: 'Free guides, roadmaps, and checklists for acting on your next move.',
    note: 'Support page',
  },
];

const fitItems = [
  {
    title: 'Stagnation or ceiling pressure',
    body: 'When the role continues, but the upside does not feel strong enough to keep compounding in the same direction.',
  },
  {
    title: 'AI pressure or skill under-leverage',
    body: 'When you can feel the market shifting, but your current skill stack is not translating into stronger leverage yet.',
  },
  {
    title: 'Career pivots or income-growth decisions',
    body: 'When the next move affects compensation, independence, and long-term optionality more than it first appears.',
  },
];

const improvementItems = [
  {
    title: 'Higher-value skill direction',
    body: 'Stop random upskilling and move toward a sharper skill stack with stronger market value and better long-term upside.',
  },
  {
    title: 'Personal branding and positioning',
    body: 'Make your value easier to understand so better opportunities, better compensation, and stronger trust become more realistic.',
  },
  {
    title: 'Career pivot logic',
    body: 'Judge risk, fit, and upside more clearly before switching roles, domains, or work models in a reactive way.',
  },
  {
    title: 'Income-growth direction',
    body: 'Connect skill choices to stronger compensation, optional income streams, and a clearer route toward achieving earlier financial freedom.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance',
      },
      { '@type': 'ListItem', position: 4, name: 'Working Professional Career Guidance', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Working Professional Career Guidance | Future Career School',
    description,
    url: canonical,
    serviceType: 'Working Professional Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': 'EducationalOrganization',
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Working Professional Career Guidance</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Working professional career guidance for growth, pivots, and stronger leverage
      </div>

      <h1 class="hero-title">
        Working professional career guidance
        <span class="gold-text"> when staying where you are no longer feels smart</span>
      </h1>
      <p class="hero-sub">
        Working professional career guidance should help when the current role, skill stack, or growth path feels under-leveraged.
        The point is stronger positioning, better skill direction, clearer income-growth logic, and a more realistic route toward achieving earlier financial freedom.
      </p>
      <p class="hero-note">
        Free updated practical AI-powered career and skill assessments are available when they genuinely help.
        Guidance is delivered online across India.
      </p>
      <div class="hero-actions">
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-gold pulse">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="fit"
    title="When working professional career guidance becomes useful"
    items={fitItems}
    variant="signal"
    columns={3}
  />

  <BofuFeatureSection
    sectionId="what-changes"
    title="What strong working professional guidance should improve"
    items={improvementItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="The free career and skill assessments can surface strengths, preferences, and work style before you commit to a bigger professional growth decision."
        href={BOFU_ASSESSMENT_LINKS.workingProfessionalsAndCareerChangers}
      />
  </BofuFeatureSection>

  <BuyerChecks
    title="What to check before paying for working professional career guidance"
    subtitle="The goal is stronger leverage, better growth logic, and more intelligent career moves, not low-growth drift in nicer words."
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader guidance, professional-stage assessments, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="professional"
    title="Do not let the next few years compound in the wrong direction"
    subtitle="If the current role, skill stack, or growth logic feels weak, it is better to fix the direction deliberately now than to stay busy inside a path that is under-leveraging you."
    professionalLabel="Get Working Professional Career Guidance"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px); background-size: 80px 80px; mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%); opacity: .16; }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 44rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.85; max-width: 790px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.54); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #what-changes,
  #related-links { background: rgba(255,255,255,.012); }

  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.76rem, 9.3vw, 2.35rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
