---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS } from '../../../../config/bofu';

const title = 'Working Professional Career Guidance | Skill Direction & Income Growth | Future Career School';
const description =
  'Working professional career guidance for stagnation, AI pressure, and pivots — stronger skill direction, positioning, and a clearer route to income growth.';

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Random upskilling that compounds slowly',
    right: 'Clearer skill direction tied to growth and income upside',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
];
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/working-professional-career-guidance/';

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step decisions when several connected choices need to make sense together.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'Practical direction for people who need clearer next steps, stronger trade-offs, and better skill choices.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coaching-for-mid-career-professionals/',
    title: 'Career Coaching for Mid-Career Professionals',
    description: 'For the specific plateau after eight to fifteen years: slowed promotions, an aging skill stack, and the specialize-or-pivot decision.',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professionals and Career Changers Assessment',
    description: 'Free input for pivots, salary growth, role fit, and stronger leverage decisions.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for stream decisions, aptitude signals, skill fit, and career direction.',
  },
  {
    href: '/career-skills-compass/',
    title: 'Career & Skills Compass',
    description: 'A free tool for narrowing the skill paths that fit your strengths and market direction.',
  },
  {
    href: '/career-resources/',
    title: 'Career Resources',
    description: 'Free guides, roadmaps, and checklists for acting on your next move.',
  },
  {
    href: '/blog/career-growth/how-to-transition-to-a-new-career-role-at-work/',
    title: 'Career Transitions for Working Professionals',
    description: 'Strategic approach to pivoting roles, domains, or companies while managing income and risk realistically.',
  },
];

const fitItems = [
  {
    title: 'Stagnation or ceiling pressure',
    body: 'When the role continues, but the upside does not feel strong enough to keep compounding in the same direction.',
  },
  {
    title: 'AI pressure or skill under-leverage',
    body: 'When you can feel the market shifting, but your current skill stack is not translating into stronger leverage yet.',
  },
  {
    title: 'Career pivots or income-growth decisions',
    body: 'When the next move affects compensation, independence, and long-term optionality more than it first appears.',
  },
];

const improvementItems = [
  {
    title: 'A genuine high-value skill portfolio',
    body: 'Stop random upskilling and build a deliberate high-value, high-income skill portfolio that compounds — the kind that keeps unlocking high income opportunities instead of one isolated skill bet.',
  },
  {
    title: 'Personal branding and positioning',
    body: 'Make your value easier to understand so better opportunities, better compensation, and stronger trust become more realistic.',
  },
  {
    title: 'Career pivot logic',
    body: 'Judge risk, fit, and upside more clearly before switching roles, domains, or work models in a reactive way.',
  },
  {
    title: 'Income-growth direction',
    body: 'Connect skill choices to stronger compensation, optional income streams, and a clearer route toward achieving earlier financial freedom.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance addresses stagnation or skill under-leverage',
    body: 'Generic career advice does not help when the real problem is that you are not leveraging your strengths well enough, the market is shifting, or the role is no longer worth your time. Look for guidance that connects skill, positioning, and real income-growth logic.',
  },
  {
    title: 'Check whether pivots are judged by math, not by emotion or FOMO',
    body: 'Career pivots are expensive. Better guidance should help you compare income trajectories, risk, skill gaps, and runway realistically — not just follow what other people are doing.',
  },
  {
    title: 'Check whether the guidance separates skill from positioning',
    body: 'High-value skills alone are not enough. Look for guidance that also helps you build positioning and personal branding so your skills translate into actual opportunities and better compensation.',
  },
  {
    title: 'Check whether the process respects your income and time reality',
    body: 'As a working professional, your opportunity cost is real. The guidance should save you time and prevent expensive mistakes, not just give you generic frameworks you could figure out on your own.',
  },
];

const faqItems = [
  {
    question: 'How do I know if I am in a stagnant role or if I should give it more time?',
    answer:
      'Stagnation is usually not about boredom alone. It is when the role, skill growth, and income trajectory all feel flat after giving it serious effort. The useful question to answer is whether the stagnation is fixable — new skills, a new team — or structural, where the ceiling is simply too low for your market value.',
  },
  {
    question: 'I feel pressure to upskill, but I do not know which skills matter. How do I choose?',
    answer:
      'Random upskilling wastes time and money without moving your income or optionality. Pick skill choices that connect to your market, your strengths, and where you actually want your income to go — not whatever course everyone else is talking about this quarter.',
  },
  {
    question: 'I am worried about AI and automation affecting my role. What should I do?',
    answer:
      'AI pressure is real, but the response matters. The stronger move is not to panic-upskill. It is to understand which skills in your field are AI-resistant or AI-enhanced, and to build proof of work and positioning that makes you valuable beyond the skill alone.',
  },
  {
    question: 'Should I quit my job to pursue something else, or can I transition while employed?',
    answer:
      'This is one of the biggest career decisions you will make, and the honest answer depends on your current income, your runway, the skill gap you still need to close, and your real risk tolerance — not on a deadline you set out of panic or FOMO.',
  },
  {
    question: 'My degree is a credential, but it is not leading to good opportunities. What now?',
    answer:
      'A degree alone is rarely enough for high income outcomes. The next layer is skills, proof of work, positioning, and the ability to communicate value beyond the degree — that stack is what guidance should help you build.',
  },
  {
    question: 'Can I build a real income future in my current field, or should I pivot?',
    answer:
      'It depends on your market, your skill level, your current income ceiling, and what a pivot would actually require. Do the math instead of guessing: compare the realistic income trajectory in your field against a new one, and weigh that against the true cost of pivoting.',
  },
  {
    question: 'How do I know if a career coach is actually worth the money vs just thinking it through myself?',
    answer:
      'A career coach should improve decision quality enough to save you time, prevent expensive wrong moves, or accelerate income growth by more than the investment itself. If the guidance does not create that clarity or confidence, it is not worth it.',
  },
  {
    question: 'Is this the same as career coaching for professionals or career counselling for adults online?',
    answer:
      'Career counselling for working professionals, career coaching for professionals, and career counselling for adults online all describe the same kind of structured support covered here — stronger skill direction, positioning, and income-growth logic for people already in the workforce, delivered fully online. If you are specifically eight to fifteen years in and stuck at a plateau where promotions have slowed, the dedicated career coaching for mid-career professionals page goes deeper into that exact specialize-or-pivot decision.',
  },
  {
    question: 'Is this available online, or do I need to meet in person?',
    answer:
      'Guidance is delivered fully online across India. You can work with a coach from home, your office, or wherever you are — no commute, no scheduling around office hours.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Working Professional Career Guidance', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Working Professional Career Guidance | Future Career School',
    description,
    url: canonical,
    serviceType: 'Working Professional Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Working Professional Career Guidance</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Working professional career guidance for growth, pivots, and stronger leverage
      </div>

      <h1 class="hero-title">
        Working professional career guidance
        <span class="gold-text"> when staying where you are no longer feels smart</span>
      </h1>
      <p class="hero-sub">
        Working professional career guidance should help when the current role, skill stack, or growth path feels under-leveraged.
        The point is a genuine high-value skill portfolio, stronger positioning, and a realistic route toward earlier financial freedom —
        not another skill added without a plan for unlocking high income opportunities.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. You can start from home or work — no commute, no scheduled office visits, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-changes"
    title="What strong working professional guidance should improve"
    items={improvementItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="The free career and skill assessments can surface strengths, preferences, and work style before you commit to a bigger professional growth decision."
        href={BOFU_ASSESSMENT_LINKS.workingProfessionalsAndCareerChangers}
      />
  </BofuFeatureSection>

  <BuyerChecks
    title="What to check before paying for working professional career guidance"
    subtitle="The goal is stronger leverage, better growth logic, and more intelligent career moves, not low-growth drift in nicer words."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="professional"
    title="Do not wait for the market to force the move if the growth logic already looks weak"
    body="A sharper decision now can change your next skill investment, compensation path, and longer-term positioning before drift compounds further."
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <BofuFeatureSection
    sectionId="fit"
    title="When working professional career guidance becomes useful"
    items={fitItems}
    variant="signal"
    columns={3}
  />

  <ContextualCta
    audience="professional"
    title="Use professional guidance before another year compounds inside a low-leverage direction"
    body="It helps most when stagnation, AI pressure, or a pivot question already affects compensation, leverage, or long-term optionality."
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why generic career advice does not fix stagnation"
    subtitle="A working professional does not need more motivation. The gap is usually decision quality, skill direction, and income logic."
    rows={comparisonRows}
    centered={true}
  />

  <GuidancePlansSection
    audience="professional"
    serviceLabel="Career Guidance"
    title="Working Professional Career Guidance Plans"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See other guidance pages, professional-stage assessments, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection
    title="Questions working professionals ask before choosing career guidance"
    items={faqItems}
  />

  <FinalCta
    audience="professional"
    title="Do not let the next few years compound in the wrong direction"
    subtitle="If the current role, skill stack, or growth logic feels weak, fix the direction deliberately now — a stronger skill portfolio and clearer positioning are what keep unlocking high income opportunities and earlier financial freedom, not another year of staying busy in an under-leveraged path."
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Guidance"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px); background-size: 80px 80px; mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%); opacity: .16; }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 44rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.85; max-width: 790px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.54); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #what-changes,
  #related-links { background: rgba(255,255,255,.012); }

  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.76rem, 9.3vw, 2.35rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>

