---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Guidance for Low Board Scores | Future Career School';
const description =
  'Career guidance for students who scored low in boards - a clear next-step plan covering compartment exams, open schooling, and skill-first routes, without guesswork or shame.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-for-low-board-scores/';
const class1112AssessmentUrl = '/services/assessments/class-11-to-12/';
const class10AssessmentUrl = '/services/assessments/class-10-and-below/';
const averageStudentsGuideUrl = '/blog/career-options/career-options-for-average-students-india/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for school, college, and early skill-direction decisions beyond this one result.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'Use this when the bigger course, degree, and skill decision after 12th needs its own dedicated plan.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help when several connected decisions - stream, course, skill, and income direction - need to make sense together.',
  },
  {
    href: class1112AssessmentUrl,
    title: 'Class 11 to 12 Assessment',
    description: 'Free course-fit and direction signal if the result affects an 11th or 12th-stage decision.',
  },
  {
    href: class10AssessmentUrl,
    title: 'Class 10 and Below Assessment',
    description: 'Free strength and stream-fit signal if the low score was in class 10 rather than 12th.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for stream, aptitude, and skill-fit signals before a bigger decision.',
  },
  {
    href: averageStudentsGuideUrl,
    title: 'Career Options for Average Students in India',
    description: 'A practical read if your result sits in the average range rather than a failing or barely-passing one.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
];

const whatBlocksItems = [
  {
    title: 'A specific college cutoff or scholarship floor',
    body: 'This is the real, narrow effect - certain named colleges and some scholarships with a fixed percentage. Worth checking exactly, not assuming.',
  },
  {
    title: 'It does not block further study',
    body: 'Open universities, private-candidate re-attempts, and flexible-admission colleges exist specifically for a result like this one.',
  },
  {
    title: 'It does not block a stable government role',
    body: 'Several government exams set little or no percentage floor and treat exam day as a fresh start, separate from your board score.',
  },
  {
    title: 'It does not block building real income',
    body: 'Skilled trades, digital work, and freelance income all depend far more on demonstrated skill than on one exam season - the same skill portfolio that opens high income opportunities for any student, regardless of this result.',
  },
];

const routeOptionItems = [
  {
    title: 'Fix the result directly',
    body: 'A compartment exam clears one or two failed subjects in the same academic year for most boards. Three or more failed subjects usually means an essential repeat year - a common, well-worn path, not a rare emergency measure.',
  },
  {
    title: 'Reroute forward without a redo',
    body: 'NIOS lets you complete class 10 or 12 on a flexible timeline. Open universities such as IGNOU admit with just a 10+2 pass and no strict percentage cutoff for most programmes.',
  },
  {
    title: 'Build a skill lane in parallel',
    body: 'Government exams like SSC CGL, NSDC-certified skill courses, ITI and polytechnic trades, and freelance or business paths do not gate entry on your board percentage the way a top degree college does.',
  },
];

const familyPointItems = [
  {
    title: 'Bring the result and a plan into the same conversation',
    body: 'A flat "I did badly" lands as a dead end. "I did badly, and here is what I want to do about it" gives the same news a direction.',
  },
  {
    title: 'Name exactly what changes, not everything',
    body: 'Be specific about the one or two doors this result actually closes instead of letting the fear generalise into "everything is ruined."',
  },
  {
    title: 'Ask for time before a decision gets locked in',
    body: 'Panic-driven decisions made in the first week - an expensive private seat, ruling out a whole field - are usually worse than decisions made after a short, honest look at real options.',
  },
];

const mistakeItems = [
  {
    title: 'Treating a compartment or repeat year as a wasted year',
    body: 'A compartment exam clears in the same academic year for most students. Even a repeat year is an ordinary path taken by a large number of students every year.',
  },
  {
    title: 'Ruling out a path without checking the real eligibility line',
    body: 'SSC CGL needs a plain pass. IGNOU needs a 10+2 pass with no fixed percentage on most programmes. Checking the actual number often removes a wrongly assumed wall.',
  },
  {
    title: 'Locking into an expensive decision out of panic',
    body: 'A costly private college seat or a random long-shot exam chosen in the first panicked week is one of the more expensive mistakes families make right after a low result.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance separates fact from fear',
    body: 'After a low score, most of the fear is broader than the real effect. Useful guidance should tell you exactly which doors closed and which stayed open, not just offer comfort.',
  },
  {
    title: 'Check whether skill direction is part of the plan',
    body: 'Fixing or rerouting the result is only half the plan. Stronger guidance should also help you start building a high-value skill portfolio - one that does not depend on this marksheet and compounds toward stronger income over the years ahead.',
  },
  {
    title: 'Check whether the reasoning holds up in the family conversation',
    body: 'If the plan cannot be explained calmly to a parent or guardian, it probably is not specific enough yet about what changed and what your actual next step is.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments.',
  },
];

const faqItems = [
  {
    question: 'What should career guidance for a low board score actually help with?',
    answer:
      'It should help you separate the specific, narrow effect of the result from the broader fear around it, then map the real next-step options - fixing the result, rerouting forward, or building a skill lane - against your actual situation and constraints.',
  },
  {
    question: 'Does a low board score close off strong career options?',
    answer:
      'No, not in the way it feels in the first few days. A low score genuinely closes some specific doors - certain high-cutoff colleges and some scholarships with a fixed percentage floor. It does not close the door to further study, a government role, a skilled trade, or building real income.',
  },
  {
    question: 'Is this a service that fixes my marks or guarantees a job?',
    answer:
      'No. This is not a marks-fixing service and not a job-guarantee or placement service. It is decision support - helping you see the real options for your specific result and build a clearer, skill-first plan from here.',
  },
  {
    question: 'Should I use free assessments or get guidance now?',
    answer:
      'Use the free stage-specific assessment as a quick signal only if you are still early. Move to guidance when the decision already feels urgent - a compartment exam date, an admission deadline, or a family conversation that keeps stalling.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help with the conversation at home, not just the academic options?',
    answer:
      'Yes. Part of building a real next-step plan is being able to explain it clearly and calmly to parents or guardians, so the guidance should also help you frame the conversation, not just the options.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so students and families can join from home or wherever they already are instead of depending on local availability.',
  },
  {
    question: 'What if the pressure feels bigger than the result itself?',
    answer:
      'That matters more than any career decision. If shame, fear, or hopelessness around this result is affecting your sleep, appetite, or sense of hope, talk to a trusted adult, teacher, or counsellor first - a plan for next steps can wait a few days.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Guidance for Low Board Scores', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance for Low Board Scores | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Guidance for Low Board Scores',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance for Low Board Scores</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career guidance for students who scored low in boards
      </div>

      <h1 class="hero-title">
        Career guidance for a low board score
        <span class="gold-text"> and a clearer route to earlier financial freedom</span>
      </h1>
      <p class="hero-sub">
        A low board score closes a few specific doors - it does not close the door to further study, a stable role, or <strong>achieving earlier financial freedom through the right skill choices from here</strong>. Career guidance for a low board score should replace the panic with a clear, skill-first next step built around your actual result, not a longer list of things to worry about.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. Students and families can start from home, without waiting on a local option or travelling anywhere.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Guidance for Students</a>
      </div>
      <p class="hero-support">
        This is not a marks-fixing service and not a job guarantee. It is decision support that turns one difficult result into one real next step toward a stronger skill portfolio.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-blocks"
    title="What a low board score actually blocks - and what it does not"
    subtitle="Most of the fear after a low result is bigger than the real effect. These are the specific claims worth checking honestly before any big decision gets made."
    items={whatBlocksItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get a plan built around your exact result before a panic decision gets expensive"
    body="The first week after a low result is when families most often lock into a costly, wrong-fit decision. A clearer plan now avoids that."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students"
  />

  <BofuStepFlowSection
    sectionId="route-options"
    title="Three real routes, depending on your exact result"
    subtitle="Whether you failed one subject, several, or passed with a percentage that feels too low - a specific route exists. Guidance helps you pick the one that fits your situation instead of guessing."
    items={routeOptionItems}
  >
    <AssessmentSupportNote
      body="As a starting signal, the free stage-specific assessments - for class 10 and below or class 11 to 12 - can help map strengths and direction before you commit to fixing, rerouting, or building a skill lane."
      href="/services/assessments/"
      label="Free career and skill assessments"
    />
  </BofuStepFlowSection>

  <ComparisonMatrix
    sectionId="different"
    title="Why this needs sharper guidance than a general pep talk"
    subtitle="A low score deserves a real plan, not just reassurance. These are the contrast points that matter once a specific next step needs to be chosen."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="family-conversation"
    title="Having the family conversation without it turning into a bigger fight"
    subtitle="For a lot of students, the result itself is only half the stress - the conversation waiting at home is the other half. A little structure helps on both sides of the table."
    items={familyPointItems}
    variant="decision"
  />

  <ContextualCta
    audience="student"
    title="Walk into the family conversation with a plan, not just the number"
    body="A result plus a real next step lands very differently than the result alone. Guidance helps you build that plan before the conversation happens, not after it goes badly."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students"
  />

  <BofuFeatureSection
    sectionId="mistakes"
    title="Mistakes that make a low score cost more than it should"
    subtitle="Most of the real damage after a low result does not come from the marks themselves - it comes from decisions made in the days right after, usually under panic or pressure."
    items={mistakeItems}
    variant="prep"
  />

  <BuyerChecks
    title="What to check before paying for guidance after a low board score"
    subtitle="The point is a specific, honest plan for your exact result - not generic reassurance or a longer list of options."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Move on one real next step instead of staying stuck in the fear"
    body="If the bigger problem right now is not effort but not knowing what actually changed, stronger guidance helps before more weeks pass in uncertainty."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Guidance for Low Board Scores"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader student guidance, stage-specific assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Turn this result into one clear next step instead of a stalled few months"
    subtitle="A low board score is a narrow setback, not a verdict on your worth or your future income. Build the plan now instead of letting the uncertainty stretch on."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.2rem, 4.7vw, 3.85rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #family-conversation,
  #mistakes,
  #faq { background: rgba(255,255,255,.01); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.78rem, 9.4vw, 2.45rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
