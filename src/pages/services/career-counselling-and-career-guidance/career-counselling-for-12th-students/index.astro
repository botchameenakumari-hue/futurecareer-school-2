---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title = 'Career Counselling for 12th Students | Future Career School';
const description =
  'Career counselling for 12th students right after results — resolve the real marks, admission clock, and stream or course conflict with your parents before the decision gets rushed.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-12th-students/';
const class1112AssessmentUrl = BOFU_ASSESSMENT_LINKS.class11To12;
const after12thGuideUrl = '/blog/career-guidance/how-to-choose-a-career-after-12th/';
const confusedAfter12thUrl = '/blog/career-guidance/what-to-do-after-12th-confused/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description:
      'Use the broader after-12th page for a full course, degree, and skill decision when you are still exploring options generally.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12thOnline,
    title: 'Career Guidance After 12th Online',
    description:
      'Use the online-first page if location and travel are the bigger blocker, not the results-day conflict itself.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for school, college, and early skill-direction decisions.',
  },
  {
    href: class1112AssessmentUrl,
    title: 'Class 11 to 12 Assessment',
    description: 'Free strengths, preference, and work-style signal before a bigger stream or course decision.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.streamSelectorAfter12th,
    title: 'Career Test After 12th',
    description: 'Use the free quiz to narrow route families quickly if the shortlist itself still feels too wide.',
  },
  {
    href: confusedAfter12thUrl,
    title: 'What to Do After 12th When You Feel Confused',
    description: 'A practical read for the exact moment when the result is out and nothing feels obvious yet.',
  },
];

const resultsDayItems = [
  {
    title: 'The number is real now, not hypothetical',
    body: 'Before results, planning is theoretical. The moment marks or rank are out, every option has to be re-checked against a real number, and some doors close within days.',
  },
  {
    title: 'The admission clock is already running',
    body: 'Counselling forms, cutoff rounds, and application windows do not wait for the family to feel calm about the decision.',
  },
  {
    title: 'Parents and student are reacting, not deciding',
    body: 'Disappointment, relief, or shock after a result can drive a rushed choice before anyone has actually compared the real options.',
  },
  {
    title: 'One conversation now beats a rushed one next week',
    body: 'A short, focused counselling conversation right after the result can prevent a bigger regret later — this is decision support, not motivation. The choice made this week should still point toward stronger skills and earlier financial freedom, not just the fastest available seat.',
  },
];

const resultsDaySolveItems = [
  {
    title: 'Reset the panic around the actual number',
    body: 'A counsellor works from your real marks or rank, not a hoped-for score, so the shortlist that comes out of the conversation is one you can actually act on this week.',
  },
  {
    title: 'Separate what is truly closed from what still has time',
    body: 'Some routes are gone for this year. Others still have a real window. Counselling should tell you which is which before you waste a day chasing a closed door.',
  },
  {
    title: 'Give the family one shared decision frame',
    body: 'When marks disappoint expectations, parents and the student often want different things fast. A neutral counsellor can turn that disagreement into one shared, workable plan.',
  },
  {
    title: 'Connect the choice to skill direction, not just a seat',
    body: 'Chasing any available seat is not the goal. The right next step should also open a stronger long-term skill and income direction, not just fill a gap.',
  },
];

const decisionFilterItems = [
  {
    title: 'My marks came in lower than expected',
    body: 'That does not mean the plan has to become whatever is left over. It means the shortlist needs to be rebuilt fast, around routes that still fit and still support long-term growth.',
  },
  {
    title: 'My rank missed my target course or college by a small margin',
    body: 'A close miss deserves a real comparison of alternatives, not a default drop-year decision made out of frustration in the first 48 hours.',
  },
  {
    title: 'My parents want one option and I want another',
    body: 'Counselling right after results should surface both sides clearly and find the option that survives scrutiny from both, not just outlast the argument.',
  },
  {
    title: 'I do well but I still do not know which specific course to lock in',
    body: 'A good result does not remove the decision. It usually widens it, and a wider set of good options still needs a clear way to choose between them.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Random upskilling that compounds slowly',
    right: 'Clearer skill direction tied to growth and income upside',
  },
];

const readyChecklistItems = [
  {
    title: 'Your actual marks, rank, or percentile',
    body: 'Bring the real number, not the number you were hoping for. The whole point is planning from reality, not from the original target.',
  },
  {
    title: 'The 2 to 4 routes still realistically open',
    body: 'List what is genuinely still on the table this week, including anything you had ruled out too fast under pressure.',
  },
  {
    title: 'What each parent actually wants and why',
    body: 'Naming the real concern behind a parent preference — cost, safety, prestige, family precedent — makes the conversation faster than arguing around it.',
  },
  {
    title: 'Any hard deadline you already know about',
    body: 'Counselling forms, application windows, or fee-payment dates change how much time is actually left to decide well.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the counsellor works from your real marks, not a hypothetical range',
    body: 'Results-day counselling only works if it starts from your actual number. If the conversation stays generic and abstract, it will not hold up against a real deadline.',
  },
  {
    title: 'Check whether disagreement gets resolved or just delayed',
    body: 'A useful session should leave the family with one shared next step, not a longer list of open questions to argue about later.',
  },
  {
    title: 'Check whether skill direction is part of the decision, not an afterthought',
    body: 'Filling a seat and building a stronger long-term direction are not the same goal. Ask whether the guidance connects the choice to skill and income logic, not just admission logic.',
  },
  {
    title: 'Check whether the assessments behind the process are free and current',
    body: 'Many providers charge thousands for outdated or impractical assessments right when families are most anxious. Future Career School offers free, updated, practical, AI-powered career and skill assessments instead.',
  },
];

const faqItems = [
  {
    question: 'What does career counselling for 12th students actually help with right after results?',
    answer:
      'It helps you turn your real marks, rank, or percentile into a workable shortlist fast, resolve disagreement between student and parent, and choose a route that still supports stronger long-term skill and income direction instead of just filling an available seat.',
  },
  {
    question: 'Is this different from career guidance after 12th?',
    answer:
      'Career guidance after 12th supports the broader course, degree, and skill decision whenever it comes up. This is built for the specific results-day pressure: the real number is now known, admission windows are already open, and the decision needs to move fast without becoming rushed.',
  },
  {
    question: 'My marks or rank are lower than I expected. What now?',
    answer:
      'A lower-than-expected result does not mean the plan has to become whatever is left over. The next step is rebuilding the shortlist from the real number, comparing what still fits on skill direction and long-term growth, not settling for the first available option.',
  },
  {
    question: 'Should I take a drop year if my rank missed my target by a small margin?',
    answer:
      'That decision deserves a real comparison, not a reaction made in the first two days after results. Career counselling for 12th students can help you weigh a repeat attempt against a strong alternative route on its own merits.',
  },
  {
    question: 'How is career coaching for students after 12th useful if my parents and I want different things?',
    answer:
      'A neutral counsellor can separate the concern behind each position — cost, safety, prestige, family precedent — from the argument itself, and help the family land on one option that survives scrutiny from both sides.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered.',
  },
  {
    question: 'How fast can I actually get counselling after results are out?',
    answer:
      'Guidance is delivered online across India, so a session can be booked and joined from home, a relative’s house, or wherever the family already is right after results, without waiting on a local counsellor’s availability.',
  },
  {
    question: 'Is this only useful when the result is disappointing?',
    answer:
      'No. A good result usually widens the number of realistic options rather than narrowing them, and a wider set of good options still needs a clear way to choose between them under the same admission timeline.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for 12th Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for 12th Students | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for 12th Students',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for 12th Students</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling for 12th students right after results
      </div>

      <h1 class="hero-title">
        Career counselling for 12th students
        <span class="gold-text"> once your real marks are in and the clock is already running</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career counselling for 12th students for the exact moment after results — when the number in front of you is real, admission forms are already open, and the family needs one workable decision fast instead of another week of back and forth. The goal is a route toward <strong>achieving earlier financial freedom through the right skill choice</strong>, not just filling the nearest available seat.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so a session can be booked the same day results come out — no travel, no waiting on a local counsellor's slot. It also works as career coaching for students after 12th who want the same fast, marks-based clarity, wherever they live.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">
          Get Career Counselling for 12th Students
        </a>
      </div>
      <p class="hero-support">
        A focused counselling conversation right after results should leave you with a shortlist you can act on this week, not another list of things to think about later.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="results-day"
    title="Why the moment right after results is different from general after-12th planning"
    subtitle="Before results, every option is still theoretical. The day marks or rank come out, the same decision suddenly has a real number, a real deadline, and real family pressure attached to it."
    items={resultsDayItems}
    variant="signal"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why results-day counselling has to be sharper than general advice"
    subtitle="These are the contrast points that matter most once your actual marks are in and the admission clock has already started."
    rows={comparisonRows}
    centered={true}
  />

  <ContextualCta
    audience="student"
    title="Use counselling before a rushed reaction becomes the actual decision"
    body="The first 2 to 3 days after results carry the most pressure to decide fast. A short counselling conversation can replace that pressure with a real plan."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 12th Students"
  />

  <BofuFeatureSection
    sectionId="what-counselling-solves"
    title="What career counselling for 12th students should solve right after results"
    items={resultsDaySolveItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="If results have not come out yet and you are still preparing, the class 11 to 12 assessments can help map strengths, preferences, and work style ahead of the bigger post-result decision."
        href={class1112AssessmentUrl}
        label="Free career and skill assessments"
      />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="decision-filters"
    title="Four real situations this counselling is built for"
    subtitle="These are the exact conversations that come up in the days right after 12th results, not general course-planning questions."
    items={decisionFilterItems}
  >
      <div class="support-links card">
        <a href={confusedAfter12thUrl}>Read what to do after 12th when nothing feels obvious &rsaquo;</a>
        <a href={after12thGuideUrl}>Read the detailed after-12th decision guide &rsaquo;</a>
      </div>
  </BofuStepFlowSection>

  <BofuFeatureSection
    sectionId="ready-checklist"
    title="What to have ready before a results-day counselling session"
    subtitle="A results-day session works best when the real numbers and real constraints are already on the table instead of being discovered mid-conversation."
    items={readyChecklistItems}
    variant="prep"
  />

  <BuyerChecks
    title="What to check before paying for career counselling for 12th students"
    subtitle="The point is a workable decision within the real admission window, not a comforting conversation that still leaves the shortlist unresolved."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Turn today's result into a decision you can act on this week"
    body="Whether the marks came in above, at, or below target, the next move still deserves a real comparison instead of whatever feels available right now."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 12th Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling for 12th Students"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader after-12th guidance, free assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Do not let admission-week pressure make the decision for you"
    subtitle="Use results-day counselling while the real options are still open, so the choice you make this week still points toward stronger skills and earlier financial freedom, instead of letting the fastest available seat become the plan by default."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 12th Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-counselling-solves,
  #decision-filters,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.84rem, 9.6vw, 2.55rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
