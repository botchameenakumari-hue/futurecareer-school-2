---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS, BOFU_ASSESSMENT_LINKS } from '../../../../config/bofu';

const title = 'Career Counselling for PCB Students | Future Career School';
const description =
  'Career counselling for PCB students who are unsure about NEET, medical seats, or what comes after Biology if medicine does not work out — clearer direction before the wrong turn gets expensive.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-pcb-students/';
const class1112AssessmentUrl = BOFU_ASSESSMENT_LINKS.class11To12;
const pcbCareerOptionsUrl = '/blog/career-options/career-options-after-12th-pcb/';
const pcbWithoutNeetUrl = '/blog/career-options/pcb-career-options-without-neet/';

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
];

const pressurePointItems = [
  {
    title: 'NEET is the only plan, and it feels fragile',
    body: 'Medical seats are limited and competition is intense. When the entire PCB decision rests on one exam result, every month of uncertainty gets heavier.',
  },
  {
    title: 'No real Plan B has been thought through',
    body: 'Biology, Chemistry, and Physics open more than MBBS or BDS, but most PCB students only ever hear about the medical route, so a backup feels like giving up rather than a real option.',
  },
  {
    title: 'A repeat attempt is on the table',
    body: 'Deciding whether to try NEET again, switch direction now, or keep both options alive at once is a genuinely hard call without a clear way to weigh it.',
  },
  {
    title: 'Family expectations are built around "doctor" specifically',
    body: 'When the family narrative has been medicine for years, even a strong non-medical path can feel like it needs defending instead of choosing on its own merit.',
  },
];

const nonMedicalDirectionItems = [
  {
    title: 'Biotechnology and life-sciences research',
    body: 'For PCB students who like the science itself more than the clinical side, research and biotech-linked degrees build on the same subject strength without needing NEET.',
  },
  {
    title: 'Pharmacy and allied health',
    body: 'B.Pharm, nursing, physiotherapy, and other allied-health routes use the same biology foundation and lead to real healthcare careers outside the MBBS bottleneck.',
  },
  {
    title: 'Applied and interdisciplinary science paths',
    body: 'Food technology, biomedical engineering, genetics, and forensic science are realistic PCB-linked routes that rarely get mentioned inside NEET-focused coaching.',
  },
  {
    title: 'A genuine pivot away from pure biology',
    body: 'Some PCB students discover their real strength is elsewhere — data, design, business, communication. Skill-first guidance treats that as a legitimate direction, not a failure to become a doctor.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether NEET pressure gets addressed honestly, not dismissed',
    body: 'The anxiety around a single high-stakes exam is real. Useful guidance should help you plan around that pressure instead of pretending it does not exist or telling you to "just relax".',
  },
  {
    title: 'Check whether non-medical PCB paths get real depth, not a token mention',
    body: 'Biotech, pharmacy, allied health, and research routes deserve the same seriousness as MBBS planning — not a one-line "or you could also do biotech" afterthought.',
  },
  {
    title: 'Check whether skill-building starts now, not after a NEET result',
    body: 'Waiting for one exam result before thinking about skills wastes months either way. Stronger guidance builds proof of work and direction in parallel with the exam attempt.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments.',
  },
];

const decisionFlowItems = [
  {
    title: 'If NEET is still the plan',
    body: 'Guidance should help you judge attempt strategy, backup timing, and how to keep a real non-medical option alive at the same time instead of betting everything on one result.',
  },
  {
    title: 'If NEET did not go the way you needed',
    body: 'A missed or weak NEET result does not erase a PCB background. It changes the route, not the value of years spent building science strength — the next decision still deserves real reasoning.',
  },
  {
    title: 'If medicine was never really your choice',
    body: 'Some PCB students realise partway through 12th that they were following family or peer pressure into NEET. That realisation deserves a serious, judgment-free path forward, not guilt.',
  },
];

const faqItems = [
  {
    question: 'What should career counselling for PCB students actually help with?',
    answer:
      'It should help you plan around NEET pressure honestly, understand real non-medical paths a PCB background supports, and decide on a backup or pivot with clear reasoning instead of panic.',
  },
  {
    question: 'I am scared I will not clear NEET. What are my real options?',
    answer:
      'A Biology, Chemistry, and Physics background supports more than MBBS — biotechnology, pharmacy, nursing, allied health, food technology, and research-linked degrees are all realistic routes. Guidance should help you compare these honestly instead of treating them as a fallback.',
  },
  {
    question: 'Should I attempt NEET again or pivot now?',
    answer:
      'That decision depends on your actual score trend, financial and time cost of another attempt, and whether a strong non-medical path already fits you better. Guidance should help you weigh those factors instead of deciding on pressure or guilt alone.',
  },
  {
    question: 'My parents only want medicine. How do I handle that conversation?',
    answer:
      'Family expectations around medicine are common and usually come from care, not just pressure. A clearer conversation should be based on real options, real trade-offs, and honest reasoning about fit — not just pushing back or giving in.',
  },
  {
    question: 'I do not want to be a doctor at all. Is that a valid decision after choosing PCB?',
    answer:
      'Yes. Choosing PCB does not lock you into medicine. If your real strengths point toward research, allied health, data, design, or something outside biology entirely, that is a legitimate direction — the goal is a decision that fits you, not one that only satisfies the original stream choice.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered — useful for narrowing direction while NEET results or attempt decisions are still pending.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so PCB students and parents can join from home, coaching city, or wherever they already are instead of depending on local availability.',
  },
  {
    question: 'What if I am still waiting on a NEET result and do not know which decision to prepare for?',
    answer:
      'It helps to think through both branches in advance — what you would do with a strong result and what you would do without one — instead of freezing until the result arrives. Guidance can help build both branches so neither outcome catches you unprepared.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for PCB Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for PCB Students | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for PCB Students',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'Broader after-12th guidance once the NEET or non-medical decision needs to connect to course, degree, and skill direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Wider student guidance for school, college, and early skill-direction decisions beyond the PCB-specific pressure points.',
  },
  {
    href: class1112AssessmentUrl,
    title: 'Class 11 to 12 Assessment',
    description: 'Free strength and work-style signal while a NEET result or attempt decision is still pending.',
  },
  {
    href: pcbWithoutNeetUrl,
    title: 'PCB Career Options Without NEET',
    description: 'A practical read on real non-medical routes when NEET is not the plan you want to bet everything on.',
  },
  {
    href: pcbCareerOptionsUrl,
    title: 'Career Options After 12th PCB',
    description: 'A broader look at what a Biology, Chemistry, and Physics background actually supports beyond MBBS.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help when stream, course, and skill decisions need to connect into one coherent plan.',
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for PCB Students</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        For PCB students weighing NEET, a repeat attempt, or a non-medical path
      </div>

      <h1 class="hero-title">
        Career counselling for PCB students
        <span class="gold-text"> when the whole plan rests on one exam</span>
      </h1>
      <p class="hero-sub">
        Career counselling for PCB students should do more than repeat "aim for NEET." It should help you plan around the pressure honestly, protect a real non-medical route if the result does not go your way, and choose the high-value skill path that gets you to earlier financial freedom either way — not just the one exam outcome.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so you can start from home, coaching city, or wherever you already are without waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Counselling for PCB Students</a>
      </div>
      <p class="hero-support">
        Whether NEET goes well, needs a repeat attempt, or was never the right fit, PCB still opens more directions than most students are shown — the goal is a plan that works either way.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="pressure-points"
    title="The specific pressure PCB students carry that other students do not"
    subtitle="Choosing Physics, Chemistry, and Biology usually means one exam gets treated as the entire plan. That pressure deserves a real strategy, not just reassurance."
    items={pressurePointItems}
    variant="signal"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why PCB decisions need sharper support than generic exam advice"
    subtitle="Once NEET, a repeat attempt, or a non-medical pivot is genuinely on the table, the contrast points below start to matter."
    rows={comparisonRows}
    centered={true}
  />

  <ContextualCta
    audience="student"
    title="Build a plan that works whether NEET goes well or not"
    body="The strongest position is not betting everything on one result — it is having a real direction ready either way."
    studentHref="#plans"
    studentLabel="Get Career Counselling for PCB Students"
  />

  <BofuFeatureSection
    sectionId="non-medical-directions"
    title="What a PCB background actually supports beyond MBBS"
    subtitle="Biology, Chemistry, and Physics build real, marketable strength — medicine is one route through that strength, not the only one."
    items={nonMedicalDirectionItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="If a NEET result or attempt decision is still pending, the class 11 to 12 assessments can help you narrow strengths, preferences, and work style before you commit to the next direction."
        href={class1112AssessmentUrl}
        label="Free career and skill assessments"
      />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="decision-branches"
    title="Whichever branch you are in, the decision still deserves real reasoning"
    subtitle="Most PCB guidance only prepares for one outcome. A stronger plan works through all three."
    items={decisionFlowItems}
  >
      <div class="support-links card">
        <a href={pcbWithoutNeetUrl}>Read PCB career options without NEET &rsaquo;</a>
        <a href={pcbCareerOptionsUrl}>Read career options after 12th PCB &rsaquo;</a>
      </div>
  </BofuStepFlowSection>

  <BuyerChecks
    title="What to check before paying for PCB career counselling"
    subtitle="The point is a plan that survives a NEET result either way, not generic exam-season reassurance."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Do not wait for one result to decide the whole direction"
    body="Whether the plan is NEET, a repeat attempt, or a non-medical route, skill-first direction should start now instead of after the result arrives."
    studentHref="#plans"
    studentLabel="Get Career Counselling for PCB Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling for PCB Students"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader guidance, assessments, and PCB-specific reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Get a PCB plan that does not depend on a single result"
    subtitle="If NEET pressure, a repeat-attempt decision, or a non-medical pivot already feels heavy, move with a clearer plan now — one built around the skill choices that lead toward earlier financial freedom, not just one exam outcome."
    studentHref="#plans"
    studentLabel="Get Career Counselling for PCB Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.75rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #non-medical-directions,
  #decision-branches,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.82rem, 9.6vw, 2.5rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
