---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS, BOFU_ASSESSMENT_LINKS, BOFU_PLAN_LINKS } from '../../../../config/bofu';
import { GUIDANCE_PLAN_PRICE_COPY } from '../../../../config/guidancePlans';

const title = 'Affordable Career Counselling | Is It Actually Worth the Price? | Future Career School';
const description =
  "Affordable career counselling only means something compared to private coaches, doing nothing, or the free layer — here's the honest value-for-money answer.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/affordable-career-counselling/';

const {
  studentSessionPrice,
  professionalSessionPrice,
  studentSessionPriceText,
  professionalSessionPriceText,
  studentContinuousPriceText,
  studentContinuousIncludesText,
  freeLayerText,
} = GUIDANCE_PLAN_PRICE_COPY;

const alternativeCards = [
  {
    label: 'A private coach or consultant',
    body: `Many independent career coaches and consultants charge a large one-time fee, often in the thousands, for a diagnostic session or an assessment before any real guidance even starts. That upfront cost is separate from whatever the actual coaching or counselling costs afterward, so the real total is usually higher than it first looks.`,
    verdict: `Here, the career and skill assessments are free on their own, so there is no separate fee just to find out whether paying for a session is worth it. A first 1-on-1 session runs ${studentSessionPriceText} for students and ${professionalSessionPriceText} for working professionals, with nothing added on top.`,
  },
  {
    label: 'Doing nothing and figuring it out alone',
    body: `Skipping paid support entirely has a real cost too, it just does not show up on a receipt. A wrong-fit degree, a loan-funded course with a weak return, or a stalled career pivot can cost far more in wasted years and money than a single counselling session ever would.`,
    verdict: `Weighed against that kind of outcome, a ${studentSessionPrice} or ${professionalSessionPrice} session is a small outlay for a decision that is expensive, time-pressured, or hard to reverse. It is still a real cost, and it is not always the right call, which is the next comparison.`,
  },
  {
    label: 'The free layer on its own',
    body: freeLayerText,
    verdict: `If your decision is still early, low-stakes, or easily reversible, the free assessments and resources are often genuinely enough for now. Affordable does not have to mean "pay something" — sometimes it means not paying yet.`,
  },
];

const decisionFilters = {
  worthIt: [
    'A wrong choice here (degree, course, pivot) would cost far more than the session itself.',
    'You have already tried the free assessments and resources and are still stuck.',
    'The decision is time-pressured or hard to reverse once made.',
  ],
  waitFirst: [
    'You have not tried the free career and skill assessments yet.',
    'The decision is small, early, or easily reversible.',
    'You are comparing options in the abstract rather than facing an actual choice right now.',
  ],
};

const faq = [
  {
    q: 'Is affordable career counselling actually good, or is a low price a red flag?',
    a: `Price and quality are not the same axis here. The reason a first session is priced at ${studentSessionPriceText} for students and ${professionalSessionPriceText} for working professionals is a limited-time price, not a signal of thinner support. The career and skill assessments that many providers charge thousands for, and that often turn out outdated or impractical, are free here and described as updated, practical, and AI-powered.`,
  },
  {
    q: 'How does this compare to what a private career coach charges?',
    a: 'Many independent coaches and consultants charge a separate, often large, one-time fee for an assessment or diagnostic before any real coaching begins. Here, the assessment layer is free on its own, and the paid session price is fixed and visible upfront, so you are not paying twice before getting a real answer.',
  },
  {
    q: 'What if I genuinely cannot pay anything right now?',
    a: 'The career and skill assessments, career and income-growth resources, and finder tools are free with no paid tier attached. If a decision is still early or reversible, that free layer is often enough on its own for now.',
  },
  {
    q: 'Does a lower price mean less support after I pay?',
    a: `No. The fee covers a real 1-on-1 session focused on your specific situation. For people who want ongoing support across a year rather than a single session, the continuous-guidance package (${studentContinuousPriceText}, ${studentContinuousIncludesText}) exists as a separate, clearly priced option, not an upsell hidden behind the first session.`,
  },
  {
    q: 'Is career counselling worth it for me specifically right now?',
    a: 'That depends on what a wrong decision would cost you. If the choice in front of you is expensive, time-pressured, or hard to reverse, a paid session tends to add more value than its price. If you are still early and just narrowing a long list, the free layer is a reasonable place to start instead.',
  },
  {
    q: 'Do you guarantee results for the price you pay?',
    a: 'No ethical provider can guarantee a job or a specific income outcome, and this fee is not sold that way. What it buys is structured decision support around path, skill, and risk. The outcome still depends on the direction you choose and the effort you put in afterward.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Career Counselling and Career Guidance',
    description: 'The full service overview: audiences, plans, and what practical guidance covers.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-fees/',
    title: 'Career Counselling Fees',
    description: 'The exact prices, what counts as a package, and whether it is billed as a subscription.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-benefits/',
    title: 'Career Counselling Benefits',
    description: 'The evidence on what counselling actually improves, and when it may not be worth paying for yet.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Start here for free if your decision is still early, small, or easily reversible.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Affordable Career Counselling', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Affordable Career Counselling: What "Affordable" Should Actually Mean',
    description,
    datePublished: '2026-07-13',
    dateModified: '2026-08-28',
    mainEntityOfPage: canonical,
    inLanguage: 'en-IN',
    author: {
      '@type': 'Person',
      name: 'Shivanshi Sehgal',
      url: 'https://futurecareerschool.com/about/shivanshi-sehgal/',
      jobTitle: 'Career researcher and writer',
    },
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://futurecareerschool.com/favicon.svg',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <article id="affordable-article">
    <header class="hero">
      <div class="hero-bg">
        <div class="orb orb-gold"></div>
        <div class="orb orb-teal"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
          <span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Affordable Career Counselling</span>
        </nav>

        <div class="hero-meta">
          <span class="pill hero-pill"><span class="pill-dot"></span>A value comparison, not a price list</span>
        </div>

        <div class="hero-grid-main">
          <div class="hero-copy">
            <h1>Affordable career counselling: what "affordable" should actually buy you</h1>
            <p class="line strong">
              Affordable career counselling is real here, but the word only means something next to a comparison. Weighed against a private coach's separate assessment fee, the cost of a wrong-fit degree or stalled pivot, or simply doing nothing, a {studentSessionPrice} student session or a {professionalSessionPrice} working-professional session is a small, visible outlay, not a vague "contact us" quote.
            </p>
            <p class="line">
              It is still a real cost, and cheap does not automatically mean worth it. The honest answer depends on what a wrong decision would cost you, and whether the free layer has already stopped being enough for your specific situation.
            </p>
            <p class="line">The real measure of "affordable" is not the number itself but what it moves you toward: a high-value skill portfolio and unlocking high income opportunities, not just a cheaper receipt.</p>
            <p class="line">Here's how that cost actually compares to the real alternatives, not just to itself.</p>

            <div class="cta-pair">
              <a class="btn-gold pulse" href={BOFU_PLAN_LINKS.parentGuidance}>See guidance plans and pricing</a>
              <a class="btn-outline" href={BOFU_ASSESSMENT_LINKS.hub}>Free career and skill assessments</a>
            </div>
          </div>

          <aside class="hero-board card">
            <div class="board-kicker">Affordable compared to what</div>
            <div class="board-row">
              <span>1</span>
              <p>A private coach's separate assessment fee, often thousands before real guidance starts.</p>
            </div>
            <div class="board-row">
              <span>2</span>
              <p>The cost of a wrong-fit degree, weak-return course, or stalled pivot.</p>
            </div>
            <div class="board-row">
              <span>3</span>
              <p>Doing nothing, which has a real cost even without a receipt.</p>
            </div>
            <div class="board-row">
              <span>4</span>
              <p>The free layer alone, which is sometimes genuinely enough.</p>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <section class="container section">
      <div class="key-takeaways">
        <p class="key-takeaways__label">The honest short version</p>
        <ul>
          <li>"Affordable" is meaningless on its own. It only means something when weighed against a private coach's fees, the cost of a wrong decision, or doing nothing at all.</li>
          <li>A first 1-on-1 session is {studentSessionPriceText} for students and {professionalSessionPriceText} for working professionals, with no separate assessment fee added on top.</li>
          <li>Many private coaches and consultants charge a large fee just for a diagnostic assessment before any real guidance begins. Here, the career and skill assessments are free on their own.</li>
          <li>A low price is not the same as thin support. The price is a limited-time offer, not a signal about the quality of the session or the assessments behind it.</li>
          <li>Affordable does not always mean "pay now." If your decision is still early or reversible, the free layer is often enough on its own.</li>
        </ul>
      </div>

      <nav class="jump-nav" aria-label="Jump to section">
        <span class="jump-nav__label">Jump to section</span>
        <div class="jump-nav__grid">
          <a href="#compare">Affordable compared to what</a>
          <a href="#cheap-quality">Is cheap the same as low quality</a>
          <a href="#worth-it">When it is worth paying</a>
          <a href="#choosing">How to decide</a>
          <a href="#faqs">FAQs</a>
        </div>
      </nav>
    </section>

    <section id="compare" class="container section">
      <h2>Affordable career counselling, compared to the real alternatives</h2>
      <p class="line">
        A price only tells you something once you know what it is being measured against. Here are the three things people are usually actually comparing career counselling fees to, and how the comparison plays out honestly.
      </p>

      <div class="afford-grid">
        {alternativeCards.map((card) => (
          <article class="afford-card card">
            <div class="afford-card-label">{card.label}</div>
            <p class="afford-card-body">{card.body}</p>
            <p class="afford-card-verdict">{card.verdict}</p>
          </article>
        ))}
      </div>
    </section>

    <ComparisonMatrix
      sectionId="what-changes"
      title="What the price is actually buying, compared to the alternative"
      subtitle="Not every provider adds the same thing behind a similar-looking price. This is the difference that matters when you are judging whether a session is worth it."
      rows={[
        { left: 'Paid outdated impractical assessments with weak practical value', right: 'Free updated practical AI-powered career and skill assessments' },
        { left: 'Generic advice that still leaves you unclear', right: 'High-leverage decision support around path, skill, and risk' },
        { left: 'Low-growth paths that delay real earning progress', right: 'Stronger skill choices aimed at achieving earlier financial freedom' },
        { left: 'Random upskilling that compounds slowly', right: 'Clearer skill direction tied to growth and income upside' },
      ]}
    />

    <section id="cheap-quality" class="container section">
      <h2>Is a low price the same as low quality</h2>
      <p class="line">
        A fair question when a number looks small: is the price low because the support is thin, or is it low because of how the offer is structured right now? Here, the {studentSessionPrice} and {professionalSessionPrice} session prices are limited-time prices, not a signal about the depth of the session or the assessments behind it.
      </p>
      <p class="line">
        The clearer signal is what is included at that price. Many providers in the market charge thousands just for an assessment before counselling even starts, and those assessments are often outdated or impractical. Here, the career and skill assessments are free on their own, described as updated, practical, and AI-powered, and are not part of any paid tier at all. A cheap-looking fee that still comes with a genuinely current assessment layer is a different thing from a cheap fee that skips the assessment step entirely.
      </p>

      <div class="cta-pair">
        <a class="btn-outline" href={BOFU_ASSESSMENT_LINKS.hub}>See the free assessments</a>
        <a class="btn-gold" href="/services/career-counselling-and-career-guidance/career-counselling-fees/">See the exact fees and packages</a>
      </div>
    </section>

    <section id="worth-it" class="container section">
      <h2>When paying is actually worth it, and when it is not yet</h2>
      <div class="grid-two">
        <div class="card win-card">
          <h3>A paid session is worth it now if</h3>
          <ul>
            {decisionFilters.worthIt.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="card warn-card">
          <h3>It is worth waiting on if</h3>
          <ul>
            {decisionFilters.waitFirst.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="line">
        Affordability is really a comparison between the price of the session and the cost of getting the decision wrong. When that gap is large, the fee is easy to justify. When the decision is still small or early, spending nothing yet is the more honest answer.
      </p>
    </section>

    <section id="choosing" class="container section">
      <AssessmentSupportNote
        title="Not ready to pay yet"
        body="If you are still early and unsure whether a paid session is even needed, the free career and skill assessments can narrow a long list into a shorter, comparable one at no cost before you decide."
      />
    </section>

    <section id="faqs" class="container section faq-block">
      <h2>FAQs on affordable career counselling</h2>
      <div class="faq-accordion">
        {faq.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{item.q}</summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container section closing-cta">
      <h2>Once you know which side of that comparison you are on</h2>
      <p class="line">
        If a wrong decision would cost you more than the session, the guidance plans are the next step. If you are still narrowing things down, start with the free assessments instead. Either way, affordable only earns the word if it moves you toward earlier financial freedom, not just a smaller invoice.
      </p>
      <div class="cta-pair">
        <a class="btn-gold pulse" href={BOFU_PLAN_LINKS.parentGuidance}>See guidance plans and pricing</a>
        <a class="btn-outline" href={BOFU_ASSESSMENT_LINKS.hub}>Free career and skill assessments</a>
      </div>
    </section>

    <GuidancePlansSection
      sectionId="plans"
      audience="mixed"
      serviceLabel="Career Guidance"
      title="Career Guidance Plans"
    />

    <LinkDirectorySection
      sectionId="related-pages"
      title="Related pages"
      subtitle="See the exact fees, the evidence on benefits, or the free first step."
      items={relatedDirectoryItems}
      altBackground={true}
    />
  </article>

  <Footer />
</BaseLayout>

<style>
  #affordable-article {
    padding-top: 72px;
    background:
      radial-gradient(circle at 10% 0%, rgba(229,184,74,.08), transparent 38%),
      radial-gradient(circle at 90% 2%, rgba(45,212,191,.09), transparent 32%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,0));
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 70px;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 540px; height: 540px; left: -140px; top: -200px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 450px; height: 450px; right: -120px; top: -80px; background: radial-gradient(circle, rgba(45,212,191,.14), transparent 70%); }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: radial-gradient(circle at 46% 20%, rgba(0,0,0,.95), transparent 70%);
    opacity: .15;
  }
  .hero-inner { position: relative; z-index: 1; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 1.6rem;
  }
  .breadcrumb a { color: rgba(255,255,255,.56); }
  .breadcrumb a:hover { color: rgba(255,255,255,.9); }

  .hero-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .hero-pill { font-size: 12px; color: rgba(255,255,255,.62); }
  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    display: inline-block;
  }

  .hero-grid-main {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, .8fr);
    gap: 1.25rem;
    align-items: start;
  }
  .hero-copy h1 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    margin-bottom: 1rem;
    max-width: 920px;
  }
  .line {
    font-size: 16px;
    line-height: 1.84;
    color: rgba(255,255,255,.64);
    margin: .22rem 0;
    max-width: 980px;
  }
  .line.strong,
  .strong { color: rgba(255,255,255,.87); font-weight: 620; }
  .cta-pair {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }

  .hero-board {
    padding: 1.2rem;
    background:
      linear-gradient(135deg, rgba(229,184,74,.07), rgba(45,212,191,.05), rgba(255,255,255,.03));
    border-color: rgba(255,255,255,.12);
  }
  .board-kicker {
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(45,212,191,.95);
    margin-bottom: .75rem;
    font-weight: 700;
  }
  .board-row {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: .8rem;
    align-items: start;
    padding: .75rem 0;
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .board-row:first-of-type { border-top: none; padding-top: .2rem; }
  .board-row span {
    width: 34px;
    height: 34px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    color: var(--gold);
    font-family: "Sora", sans-serif;
    font-weight: 800;
  }
  .board-row p {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,.7);
  }

  .section { padding: 62px 0 8px; }
  .section h2 {
    font-size: clamp(1.7rem, 3.8vw, 2.45rem);
    line-height: 1.12;
    letter-spacing: -.03em;
    margin-bottom: .85rem;
    scroll-margin-top: 92px;
  }
  .section h3 { font-size: 1.12rem; margin-bottom: .55rem; }

  .key-takeaways {
    margin: 0 0 1.6rem;
    padding: 1.2rem 1.35rem 1.25rem;
    border-radius: 16px;
    border: 1px solid rgba(45,212,191,.22);
    background:
      radial-gradient(circle at 0% 0%, rgba(45,212,191,.1), transparent 60%),
      rgba(255,255,255,.03);
  }
  .key-takeaways__label {
    margin: 0 0 0.7rem;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(45,212,191,.95);
  }
  .key-takeaways ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.5rem;
  }
  .key-takeaways li {
    color: rgba(255,255,255,.82);
    line-height: 1.7;
    font-size: 15.5px;
  }

  .jump-nav {
    padding: 1.1rem 1.3rem;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.025);
  }
  .jump-nav__label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(229,184,74,.9);
    margin-bottom: .7rem;
  }
  .jump-nav__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: .5rem .9rem;
  }
  .jump-nav__grid a {
    font-size: 14px;
    color: rgba(255,255,255,.72);
    text-decoration: none;
    border-bottom: 1px dashed rgba(255,255,255,.16);
    padding-bottom: 2px;
    line-height: 1.6;
  }
  .jump-nav__grid a:hover { color: #fff; border-color: rgba(229,184,74,.5); }

  .card {
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 18px;
    padding: 1.3rem;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0,0,0,.22);
  }
  .grid-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .afford-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .9rem;
    margin-top: 1.2rem;
  }
  .afford-card { display: grid; gap: .6rem; align-content: start; }
  .afford-card-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #f6db95;
  }
  .afford-card-body {
    font-size: 14px;
    line-height: 1.72;
    color: rgba(255,255,255,.68);
    margin: 0;
  }
  .afford-card-verdict {
    font-size: 13.5px;
    line-height: 1.68;
