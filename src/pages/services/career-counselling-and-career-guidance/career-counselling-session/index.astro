---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuSummaryStrip from '../../../../components/bofu/BofuSummaryStrip.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const title =
  'Career Counselling Session | One-on-One Consultation | Future Career School';
const description =
  'Book a career counselling session with Future Career School: a structured one-on-one consultation for students and working professionals across India, plus ongoing small-group sessions for continuous support.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-session/';

const sessionFormatItems = [
  {
    title: 'A one-on-one career counselling session, not a group webinar',
    body:
      'The first session is a focused one-on-one consultation built around your situation, not a generic talk delivered to a crowd. Some people search for the same thing as a 1-on-1 career coaching session, but the idea is identical: one conversation built entirely around you. That format is what makes the conversation useful for a decision this personal.',
  },
  {
    title: 'A structured consultation, not a loose chat',
    body:
      'A career counselling session should still feel like a real conversation, but the structure behind it should move you toward higher-value skill direction and a clearer route toward achieving earlier financial freedom, not just a pleasant hour.',
  },
  {
    title: 'A session you can prepare for and act on',
    body:
      'Because it is one focused conversation instead of a scattered series of calls, you can walk in with your real shortlist and walk out with a next move you can actually use.',
  },
];

const resolveItems = [
  {
    title: 'Which path deserves your next serious phase of effort',
    body:
      'A good career counselling session should help you judge which course, role, pivot, or skill direction is genuinely worth doubling down on right now.',
  },
  {
    title: 'What should stay backup and what should be dropped',
    body:
      'The session should make the serious option and the backup option explicit instead of leaving every route sounding equally fine.',
  },
  {
    title: 'Which skill direction should start now, not later',
    body:
      'A stronger consultation connects the choice in front of you to a high-value skill portfolio: the right skill mix, proof of work, and stronger market positioning, not just one isolated decision.',
  },
  {
    title: 'What the very next step should be after the call ends',
    body:
      'The session should end with one practical next action, not another broad idea to keep thinking about.',
  },
];

const flowItems = [
  {
    title: 'Bring the real decision under pressure',
    body:
      'The one-on-one starts with the actual choice that matters now, whether that is a stream, a course, a pivot, or a stagnating role, not only the broad label you searched for.',
  },
  {
    title: 'Work through fit, trade-offs, and constraints together',
    body:
      'A structured consultation looks at fit, market reality, budget, family pressure, and skill direction as one connected decision instead of separate questions.',
  },
  {
    title: 'Leave with a sharper next move',
    body:
      'The outcome of the session should be a narrower shortlist and a specific next step you can act on immediately, not more information to sit with.',
  },
];

const sessionCards = [
  {
    eyebrow: 'One-on-one',
    title: 'One-on-one career counselling session',
    body:
      'A focused, personal consultation for a single decision under pressure: stream, course, role, pivot, or salary-growth direction.',
    listItems: [
      'Built entirely around your real situation, not a shared script.',
      'Useful for a first serious decision or a single urgent question.',
      'Ends with a specific next step, not general encouragement.',
    ],
  },
  {
    eyebrow: 'Continuous support',
    title: 'Group career counselling sessions',
    body:
      'After the first one-on-one, students can continue into ongoing career guidance in small groups, usually 10 or fewer members.',
    listItems: [
      'Built for students who need more than one high-leverage decision across the year.',
      'Keeps skill choices, proof of work, and financial-freedom planning on track over time.',
      'Stays small enough that the discussion still feels specific, not like a lecture.',
    ],
  },
];

const prepItems = [
  {
    title: 'Your real shortlist and backup route',
    body:
      'Bring the 2 to 4 options you are genuinely comparing. The one-on-one gets sharper when the real trade-offs are already visible.',
  },
  {
    title: 'Marks, degree, role, or current-stage reality',
    body:
      'Use your actual situation, not the ideal one. A useful career counselling session works with what is genuinely available to you now.',
  },
  {
    title: 'Budget, location, and time constraints',
    body:
      'If cost, city, relocation, or time pressure shape the decision, raise them early so the plan still fits your real life.',
  },
  {
    title: 'Family or work pressure connected to the decision',
    body:
      'When parents, a partner, or your employer are part of the decision, surface those concerns from the start instead of letting them derail the plan later.',
  },
];

const outcomeItems = [
  {
    title: 'Which route deserves your next serious phase of effort',
    body:
      'A strong career counselling session should leave one route feeling more justified than the others, not every option sounding equally acceptable.',
  },
  {
    title: 'What stays backup and what should stop taking your energy',
    body:
      'You should know which option remains a genuine backup and which one only survives because no one has ruled it out yet.',
  },
  {
    title: 'Which skill direction should start now',
    body:
      'The next move should connect to a practical, high-value skill direction early instead of waiting years before market value enters the decision.',
  },
  {
    title: 'What your first move after the session should be',
    body:
      'A good consultation leaves you with one useful action specific enough to use right away, not another broad idea to sit on.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the session is genuinely one-on-one',
    body:
      'A career counselling session should be built around your specific situation. If the format feels like a shared script delivered to many people at once, it is not serving the decision in front of you.',
  },
  {
    title: 'Check whether a group session actually stays small',
    body:
      'If continuous or group career counselling sessions are on offer, check that the group genuinely stays small, usually 10 or fewer members, so the discussion still feels specific rather than like a lecture.',
  },
  {
    title: 'Check whether online delivery still fits your real day',
    body:
      'A career planning session online should work from home, college, or work without losing depth. It should not feel like a rushed call squeezed between other things.',
  },
  {
    title: 'Check whether you leave with a next step you can actually use',
    body:
      'The real test of any career counselling consultation is whether you finish with a narrower shortlist and a specific next move, not just a session that felt thoughtful in the moment.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'A career counselling session for stream, course, degree, and early-skill decisions',
    body:
      'Useful for a first serious school, college, or early-career decision, then for staying on track through continuous small-group sessions across the year.',
  },
  {
    label: 'Working Professionals',
    title: 'A career counselling session for pivots, stagnation, and salary-ceiling decisions',
    body:
      'Useful for one focused consultation on switching, growing, or repositioning without wasting more time on low-leverage options.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger issue is the full decision itself, not only the session format.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description:
      'Use the main counselling page if the main question is clarity and next steps rather than how the session itself is structured.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'This is the fit if your main question is about online delivery rather than the one-on-one or group session format.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Use free, updated, practical, AI-powered career and skill assessments as a no-cost supporting check before you book a session.',
  },
];

const faqItems = [
  {
    question: 'What actually happens in a career counselling session?',
    answer:
      'The first session is a focused one-on-one consultation built around your real decision: your profile, constraints, and the choice under pressure right now. It should end with a narrower shortlist and a specific next step, not a general conversation.',
  },
  {
    question: 'Is a career counselling session one-on-one or a group call?',
    answer:
      'The first session is one-on-one. After that, students can continue into ongoing career guidance in small groups, usually 10 or fewer members, for continued support across the year.',
  },
  {
    question: 'What is the difference between a one-on-one session and a group career counselling session?',
    answer:
      'A one-on-one session is built entirely around your specific situation and is useful for a single high-pressure decision. Group career counselling sessions are for students who want continuous support on skill choices and career planning across the year, kept small enough to still feel personal.',
  },
  {
    question: 'How much does a career counselling session cost?',
    answer:
      'Students can book the first one-on-one session for a limited-time price, with an option to continue into small-group career guidance sessions across the year. Working professionals can book a one-on-one session at the working-professional rate. Current pricing is shown in the plans section below.',
  },
  {
    question: 'Is a career counselling consultation different from a career counselling session?',
    answer:
      'They use the same underlying one-on-one conversation. A career counselling consultation is how you book that first conversation as a single, low-commitment step with no requirement to continue afterward. If you already know you want the fuller structured format described here, or the small-group follow-on, that is covered here in more depth.',
  },
  {
    question: 'Is a career planning session online available across India?',
    answer:
      'Yes. Every session, one-on-one or group, is delivered fully online, so you can join from home, college, or work anywhere in India without waiting for a local offline option.',
  },
  {
    question: 'What should I prepare before a career counselling session?',
    answer:
      'Bring your real shortlist, your actual constraints such as marks, budget, or work situation, and the one decision under the most pressure right now. That turns a general conversation into a specific, usable one.',
  },
  {
    question: 'Can working professionals book a one-on-one career counselling session too?',
    answer:
      'Yes. Working professionals can book a one-on-one session focused on pivots, stagnation, salary-ceiling pressure, or stronger positioning without needing a group format.',
  },
  {
    question: 'Is there a career mentoring program online for ongoing support, not just a single session?',
    answer:
      'Yes. After the first one-on-one, the small-group sessions work as a career mentoring program online: continued, structured support on skill choices and career planning across the year, delivered fully online, rather than a one-time call.',
  },
  {
    question: 'Are the free career and skill assessments part of the session?',
    answer:
      'No, the assessments are a separate free step. If you are still early and not ready to book a session, the free, updated, practical, AI-powered career and skill assessments can help surface strengths and work style first.',
  },
  {
    question: 'Do you guarantee a job after a career counselling session?',
    answer: 'No ethical provider can guarantee a job. The session is decision support, not a placement service.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Counselling Session',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Session | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling Session',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling Session</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        One-on-one career counselling session for students and working professionals across India
      </div>

      <h1 class="hero-title">
        Career counselling session
        <span class="gold-text"> built around one decision, not a generic conversation</span>
      </h1>
      <p class="hero-sub">
        A career counselling session with Future Career School starts as a structured one-on-one consultation, not a shared script or a group webinar.
        The goal is a higher-value skill direction and a clearer route toward achieving earlier financial freedom, not just an hour that felt thoughtful.
      </p>
      <p class="hero-note">
        The first session is one-on-one. Students can then continue into small-group career counselling sessions, usually 10 or fewer members, for ongoing support across the year. Every session is delivered fully online across India.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling Session</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling Session</a>
      </div>
      <p class="hero-support">
        The value is not the meeting itself. It is a focused consultation that narrows your real options and leaves you with a next step you can use.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="session-format"
    sectionClass="session-format-band"
    variant="signal"
    title="What makes a career counselling session different from a generic call"
    subtitle="The format matters because a personal decision needs a personal conversation, not a group script or a repeated pitch."
    items={sessionFormatItems}
  />

  <ContextualCta
    audience="mixed"
    title="Book the one-on-one when the decision in front of you already feels expensive to get wrong"
    body="A structured career counselling session should sharpen fit, skill direction, and the next move quickly enough to matter now."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling Session"
  />

  <BofuFeatureSection
    sectionId="what-it-resolves"
    sectionClass="session-decision-band"
    variant="decision"
    title="What a career counselling session should actually help you resolve"
    subtitle="A one-on-one consultation is not meant to be a pleasant chat. It should sharpen a real decision about what deserves effort now and what should be dropped."
    items={resolveItems}
  >
    <AssessmentSupportNote
      body="If you are still early and not ready to book a session yet, the free career and skill assessments can surface strengths and work style first."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="session-formats"
    sectionClass="session-formats-band"
    title="One-on-one or group: which career counselling session fits your stage"
    subtitle="Both formats exist for a reason. The one-on-one is for a single high-pressure decision. The small-group sessions are for staying on track across a longer stretch of choices."
    items={sessionCards}
    variant="contrast"
  />

  <BofuStepFlowSection
    sectionId="how-the-session-works"
    sectionClass="session-flow-band"
    title="How the one-on-one career counselling session moves the decision forward"
    subtitle="The format is one focused conversation, but the work should still feel practical and specific enough to change the quality of your next move."
    items={flowItems}
  />

  <BofuFeatureSection
    sectionId="what-to-prepare"
    sectionClass="session-prep-band"
    variant="prep"
    title="What to keep ready before your career counselling consultation"
    subtitle="A one-on-one session works better when your real options, real limits, and real pressure are visible from the start instead of surfacing halfway through."
    items={prepItems}
  />

  <BofuFeatureSection
    sectionId="what-should-feel-clearer"
    sectionClass="session-outcome-band"
    variant="signal"
    title="What should feel clearer by the end of a good career counselling session"
    subtitle="The real test is not whether the conversation felt thoughtful. It is whether your next move becomes smaller, sharper, and easier to act on."
    items={outcomeItems}
  />

  <GuidanceModelSection
    title="What a stronger career counselling session should actually cover"
    subtitle="The session is one focused conversation, but the thinking behind it should go beyond a quick chat: fit, high-leverage decisions, high-value skill direction, proof of work, and a clearer route toward stronger long-term growth."
  />

  <AudienceRelevance
    sectionClass="session-audience-band"
    title="How the right session format fits where you are right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="session-comparison-band"
    title="Why a career counselling session has to be more useful than a generic call"
    subtitle="The format can be one-on-one or a small group, but the session still needs to stay specific, practical, and strong enough for a serious career decision."
    centered={true}
  />

  <BuyerChecks
    sectionClass="session-check-band"
    title="What to check before you book a career counselling session"
    subtitle="The goal is not a call that sounds good for thirty minutes. The goal is a session structured enough to change the quality of your next move."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="If the decision is already getting expensive, book the one-on-one before it hardens further"
    body="A well-structured career counselling session should narrow your options and leave you with a smaller, more usable next move."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling Session"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling Session"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See other counselling and guidance pages, plus free assessments, before you decide which session format fits you."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="session-final-band"
    subtitle="Book a career counselling session when the next decision already feels important. A stronger one-on-one should point you toward higher-value skills and a clearer route toward achieving earlier financial freedom, not just another round of vague advice."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling Session"
  />

  <BofuFaqSection
    title="Questions people ask before booking a career counselling session"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.session-format-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.session-decision-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.session-formats-band) {
    background:
      radial-gradient(760px 240px at 0% 0%, rgba(229,184,74,.06), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.007));
  }
  :global(.session-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.session-prep-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(45,212,191,.045), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.006));
  }
  :global(.session-outcome-band) {
    background:
      radial-gradient(760px 240px at 0% 0%, rgba(229,184,74,.05), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.01), rgba(255,255,255,.006));
  }
  :global(.session-outcome-band .feature-grid.is-two-col) {
    align-items: stretch;
  }
  :global(.session-outcome-band .feature-card) {
    background:
      radial-gradient(360px 160px at 100% 0%, rgba(229,184,74,.08), transparent 74%),
      linear-gradient(150deg, rgba(255,255,255,.045), rgba(255,255,255,.016));
  }
  :global(.session-audience-band .section-headline),
  :global(.session-comparison-band .section-headline),
  :global(.session-check-band .section-headline) {
    max-width: 20ch;
  }
  :global(.session-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.session-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.session-audience-band .audience-card h3) {
    font-size: 1.08rem;
    line-height: 1.46;
  }
  :global(.session-audience-band .audience-card p) {
    font-size: 14.2px;
    line-height: 1.82;
  }
  :global(.session-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.session-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.session-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.session-final-band .final-sub) {
    max-width: 50ch;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
