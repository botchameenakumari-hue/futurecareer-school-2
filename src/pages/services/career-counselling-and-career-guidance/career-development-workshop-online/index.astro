---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuSummaryStrip from '../../../../components/bofu/BofuSummaryStrip.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
  BOFU_COMPARISON_LIBRARY,
} from '../../../../config/bofu';

const title =
  'Career Development Workshop Online | Build a High-Value Skill Direction | Future Career School';
const description =
  'A career development workshop online focused on what you actually build: a high-value skill direction, proof of work, and a growth path toward earlier financial freedom — delivered online across India.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-development-workshop-online/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[3],
  BOFU_COMPARISON_LIBRARY[4],
  BOFU_COMPARISON_LIBRARY[5],
];

const whatDevelopmentMeansItems = [
  {
    title: 'Growth you build, not a talk you attend',
    body:
      'A career development workshop online should leave you with something you can point to: a sharper skill direction and a first piece of proof of work, not just notes from a session.',
  },
  {
    title: 'A skill portfolio, not one skill decision',
    body:
      'Development means building a deliberate stack of skills over time — the right mix, proof of work, communication, and market positioning — instead of one isolated choice made once and left alone.',
  },
  {
    title: 'Practice that continues, not a single sitting',
    body:
      'For students, the stronger path continues after the first session as ongoing small-group sessions across the year, so the skill-building keeps compounding instead of stopping.',
  },
  {
    title: 'Aimed at income growth, not just information',
    body:
      'The point of development is a stronger, higher-value skill portfolio that opens income opportunities over time, not another list of career options to think about later.',
  },
];

const buildItems = [
  {
    title: 'A high-value skill direction, not just a role label',
    body:
      'The workshop should connect your profile and market fit to a specific skill direction worth building, not just a job title to chase.',
  },
  {
    title: 'A first piece of proof of work',
    body:
      'Development is not complete with a decision alone. The session should point you toward the first concrete proof of work that makes your skill direction visible to the market.',
  },
  {
    title: 'A growth path, not a one-time answer',
    body:
      'The stronger outcome is a sense of what to build next — this month, this year — not a single answer that goes stale the moment the market shifts.',
  },
  {
    title: 'A route toward earlier financial freedom',
    body:
      'The real question is not just which skill to learn next. It is how that skill stacks with the others to move you toward higher income opportunities and earlier financial freedom.',
  },
];

const flowItems = [
  {
    title: 'Map your current skills, strengths, and gaps',
    body:
      'The process starts with an honest picture of what you already have and what is missing for the direction you want, not a generic questionnaire.',
  },
  {
    title: 'Build a skill direction worth developing',
    body:
      'Fit, market demand, and income upside get weighed together to shape a skill direction that is actually worth the time you put into it.',
  },
  {
    title: 'Turn direction into a first piece of proof of work',
    body:
      'The session should end with something practical to build or start, not just a decision written down and left untouched.',
  },
  {
    title: 'Keep developing through continuous guidance',
    body:
      'For students, ongoing small-group sessions across the year keep the skill portfolio growing instead of the direction fading after one workshop.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Build the skill portfolio before a stream or degree choice locks you in',
    body:
      'A career development workshop online matters most for students when the real risk is not just picking the wrong stream or course, but building the wrong skills around it. After the first 1-on-1, ongoing small-group sessions across the year keep skill and path development on track instead of ending after a single workshop.',
  },
  {
    label: 'Working Professionals',
    title: 'Add high-value skills before stagnation or AI pressure sets the ceiling',
    body:
      'For professionals, development means identifying the next high-value skill to build — the one that raises market value and reopens income growth — instead of random upskilling that never compounds.',
  },
];

const objectionItems = [
  {
    title: 'Isn’t "career development" just another word for career advice?',
    body:
      'Not the way it is run here. The focus is on what you build and practice — a skill direction and proof of work — not just information to think about later.',
    listItems: [
      'The session connects your profile to a specific, high-value skill direction.',
      'You leave with a first concrete piece of proof of work to build on.',
      'Skill choices are treated as a portfolio that compounds, not one isolated decision.',
      'For students, development continues through the year instead of stopping after one session.',
    ],
  },
  {
    title: 'I have already picked a skill to learn. Why would I need this?',
    body:
      'A single skill decision made in isolation often misses fit, market timing, and how it stacks with everything else you already have.',
    listItems: [
      'One skill without proof of work rarely moves market value on its own.',
      'Skills chosen without checking demand can compound slowly or not at all.',
      'A holistic view — skill mix, proof of work, communication, positioning — usually beats a single narrow pick.',
      'The session checks whether your current direction still holds up, or needs a course correction.',
    ],
  },
];

const objectionSummaryItems = [
  {
    title: 'Built, not just discussed',
    body: 'The goal is a skill direction and proof of work you can act on, not more general advice.',
  },
  {
    title: 'Portfolio thinking, not one decision',
    body: 'Skills are weighed as a compounding stack, not a single isolated choice.',
  },
  {
    title: 'Growth that continues',
    body: 'For students, development keeps going through the year instead of stopping after one session.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether you leave with something built, not just discussed',
    body:
      'A genuine career development workshop should end with a skill direction and a first piece of proof of work, not just a list of options to think about.',
  },
  {
    title: 'Check whether skill choices are treated as a portfolio',
    body:
      'One isolated skill rarely moves the needle. Ask whether the process connects your skill choice to the fuller mix — proof of work, communication, and market positioning.',
  },
  {
    title: 'Check whether development continues or stops after one session',
    body:
      'Real skill-building compounds over time. Ask whether there is a structured way to keep developing, not just a single appointment.',
  },
  {
    title: 'Check whether the assessments behind it are free or a paid add-on',
    body:
      'Many providers charge thousands for outdated or impractical assessments and present them as a required first step. Future Career School offers free, updated, practical, AI-powered career and skill assessments instead.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger question is the whole career decision, not only the skill-building side of it.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-workshop/',
    title: 'Career Counselling Workshop',
    description:
      'See the structured, decision-focused workshop if the main need is working through a specific choice in one guided session, not building a skill portfolio over time.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Use free, updated, practical, AI-powered career and skill assessments as a no-cost starting check before a bigger development session.',
  },
];

const faqItems = [
  {
    question: 'What does a career development workshop online actually help me build?',
    answer:
      'It helps you build a high-value skill direction and a first piece of proof of work, based on your strengths, work style, and market fit — not just a list of career options to think about later.',
  },
  {
    question: 'How is this different from a career counselling workshop?',
    answer:
      'Career counselling, guidance, coaching, and development are the same practical service family. The focus here is the skill-building and growth side of that work — what you build and practice — while the career counselling workshop page focuses on the structured decision session itself. Either route leads to the same guidance.',
  },
  {
    question: 'Does the development stop after one workshop, or does it continue?',
    answer:
      'A first 1-on-1 session starts the process. For students, it continues afterward as small-group sessions across the year, so the skill portfolio keeps growing instead of stopping after one workshop.',
  },
  {
    question: 'What kind of skills does the workshop help me work on?',
    answer:
      'The direction is chosen for your specific profile and market fit — it can include a high-value technical or hard skill, proof-of-work building, communication, or positioning, depending on what will move your growth the most.',
  },
  {
    question: 'Is this for students, working professionals, or both?',
    answer:
      'Both. Students use it to build the right skill direction early, before a stream, course, or degree choice locks in a weak skill path. Working professionals use it to add a high-value skill before stagnation or AI pressure sets a ceiling on growth.',
  },
  {
    question: 'Are the assessments used in this process free?',
    answer:
      'Yes. Career and skill assessments are fully free, and they can be described as updated, practical, and AI-powered, unlike many providers who charge thousands for outdated or impractical versions.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so you can join from home, college, or work instead of depending on a local, in-person workshop.',
  },
  {
    question: 'What should I prepare before the session?',
    answer:
      'Bring a sense of your current skills, what you already know is missing, and the direction you are considering. That is what turns the session into real skill-building work instead of a general talk.',
  },
  {
    question: 'Do you guarantee a job or income outcome from the workshop?',
    answer:
      'No ethical provider can guarantee a job or income outcome. The goal is a stronger skill direction, proof of work, and a clearer route toward growth, not a placement promise.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Development Workshop Online',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Development Workshop Online | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Development Workshop',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Development Workshop Online</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career development workshop online, built around the skills you build and practice
      </div>

      <h1 class="hero-title">
        Career development workshop online
        <span class="gold-text"> for building a high-value skill direction, not just talking about one</span>
      </h1>
      <p class="hero-sub">
        Future Career School runs a career development workshop online around what you actually build: a high-value skill direction, a first piece of proof of work, and a growth path toward higher income opportunities and earlier financial freedom — not a passive talk about careers in general.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. Join from home, college, or work — no travel, no waiting for a local seminar date.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Development</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Development</a>
      </div>
      <p class="hero-support">
        For students, the skill-building continues after the first session as small-group guidance across the year, so development does not stop after one workshop.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-development-means"
    sectionClass="devworkshop-signal-band"
    variant="signal"
    title="What a career development workshop online should actually mean"
    subtitle="'Development' should signal building and practicing, not sitting through a talk. Here is what that looks like in a session built for growth."
    items={whatDevelopmentMeansItems}
  />

  <ContextualCta
    audience="mixed"
    title="Use a development-focused session when advice alone has not built anything yet"
    body="A real career development workshop should leave you with a skill direction and a first piece of proof of work, not just more information to sit with."
    studentHref="#plans"
    studentLabel="Get Student Career Development"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Development"
  />

  <BofuFeatureSection
    sectionId="what-you-build"
    sectionClass="devworkshop-build-band"
    variant="decision"
    title="What a career development workshop online should help you build"
    subtitle="The goal is not another list of career options. It is a specific skill direction, a first piece of proof of work, and a growth path that compounds toward stronger income opportunities."
    items={buildItems}
  >
    <AssessmentSupportNote
      body="As a starting point, free career and skill assessments can surface strengths and skill gaps before a bigger development session."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="how-it-works"
    sectionClass="devworkshop-flow-band"
    title="How the session moves you from skill gap to skill direction"
    subtitle="This is what makes it development instead of a talk: a real picture of your skills, a direction worth building, and a way to keep growing after the session ends."
    items={flowItems}
  />

  <AudienceRelevance
    sectionClass="devworkshop-audience-band"
    title="How career development fits where you are building from right now"
    items={audienceItems}
  />

  <BofuListCardSection
    sectionId="not-just-advice"
    sectionClass="devworkshop-clarity-band"
    title="If career advice alone has not turned into an actual skill yet"
    subtitle="Advice without a build plan rarely changes your market value. Here is the difference a development-focused session should make."
    items={objectionItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={objectionSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <GuidanceModelSection
    title="What the development process should actually cover"
    subtitle="Beyond the first session, the work should go further: fit, high-value skill direction, proof of work, personal branding, tech leverage, and a clearer route toward stronger long-term growth."
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="devworkshop-comparison-band"
    title="Why a career development workshop still has to leave you with something built"
    subtitle="Calling something 'development' does not automatically make it useful. It still has to connect to a real skill direction and proof of work."
    rows={comparisonRows}
    centered={true}
  />

  <BuyerChecks
    sectionClass="devworkshop-check-band"
    title="What to check before booking a career development workshop online"
    subtitle="The goal is not a session that feels informative for an hour. The goal is a skill direction and a first build you can act on immediately."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="If you already know the theory, build the skill direction instead"
    body="A development-focused session should turn what you already know into a specific skill direction and a first piece of proof of work."
    studentHref="#plans"
    studentLabel="Get Student Career Development"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Development"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Development"
    title="Career Development Workshop Plans"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See the structured counselling workshop, guidance pages, and free assessments before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="devworkshop-final-band"
    subtitle="Choose a career development workshop online that leaves you with a skill direction and proof of work aimed at earlier financial freedom, not just notes from a talk. Delivered online across India."
    studentHref="#plans"
    studentLabel="Get Student Career Development"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Development"
  />

  <BofuFaqSection
    title="Questions people ask before booking a career development workshop online"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.devworkshop-signal-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.devworkshop-build-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.devworkshop-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.devworkshop-audience-band .section-headline) {
    max-width: 22ch;
  }
  :global(.devworkshop-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.devworkshop-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.devworkshop-audience-band .audience-card h3) {
    font-size: 1.08rem;
    line-height: 1.46;
  }
  :global(.devworkshop-audience-band .audience-card p) {
    font-size: 14.2px;
    line-height: 1.82;
  }
  :global(.devworkshop-clarity-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(229,184,74,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.007));
  }
  :global(.devworkshop-clarity-band .list-card-grid.is-two-col) {
    align-items: stretch;
  }
  :global(.devworkshop-clarity-band .bofu-summary-strip) {
    margin-top: 1.2rem;
  }
  :global(.devworkshop-comparison-band .section-headline),
  :global(.devworkshop-check-band .section-headline) {
    max-width: 20ch;
  }
  :global(.devworkshop-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.devworkshop-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.devworkshop-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.devworkshop-final-band .final-sub) {
    max-width: 52ch;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub {
    font-size: clamp(15px, 1.95vw, 18px);
    color: rgba(255,255,255,.72);
    line-height: 1.88;
    max-width: 820px;
    margin-bottom: 1rem;
  }
  .hero-note {
    font-size: 14px;
    color: rgba(255,255,255,.56);
    line-height: 1.8;
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-actions .btn-gold,
  .hero-actions .btn-outline {
    min-width: min(100%, 290px);
    justify-content: center;
  }
  .hero-support {
    font-size: 14px;
    color: rgba(255,255,255,.58);
    line-height: 1.8;
    max-width: 720px;
    margin-top: 1rem;
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.84rem, 9.6vw, 2.55rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (max-width: 430px) {
    .breadcrumb {
      gap: 6px;
      font-size: 12px;
      margin-bottom: 1.5rem;
    }
    .hero-sub,
    .hero-note,
    .hero-support {
      line-height: 1.76;
    }
