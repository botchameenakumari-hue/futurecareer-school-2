---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS, BOFU_COMPARISON_LIBRARY } from '../../../../config/bofu';

const title = 'Career Counselling for Dropouts | A Real Next Step, Not Judgment | Future Career School';
const description =
  'Career counselling for dropouts who left school, college, or a course without a plan - real routes to restart, reroute, or build a skill-first path forward.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-dropouts/';
const degreeArticleUrl = '/blog/college-degrees/career-without-degree-after-12th-india/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader guidance for school, college, and early skill-direction decisions if you are still actively enrolled somewhere.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance-for-confused-students',
    title: 'Career Guidance for Confused Students',
    description: 'Useful if the bigger struggle right now is option overload or conflicting advice rather than having already left a course.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-low-cgpa-students',
    title: 'Career Counselling for Low CGPA Students',
    description: 'Useful if you are still enrolled but your college performance, not a dropout situation, is the main worry.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help when several connected decisions - what to restart, what to skip, and how to explain the gap - need to make sense together.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free strength and direction signals before deciding whether to return, reroute, or build a skill lane first.',
  },
  {
    href: degreeArticleUrl,
    title: 'Career Without a Degree After 12th',
    description: 'A practical read on building income and direction without depending on finishing a formal degree first.',
  },
];

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[2],
  BOFU_COMPARISON_LIBRARY[3],
];

const whyItHappensItems = [
  {
    title: 'Money ran out before the course did',
    body: 'Fees, hostel costs, or a sudden drop in family income are among the most common real reasons a course gets left unfinished - not a lack of ability or effort.',
  },
  {
    title: 'A crisis at home pulled attention away',
    body: 'Illness, a family business needing help, a parent losing work, or a personal health issue can make continuing impossible for a stretch, even when the intent to finish was real.',
  },
  {
    title: 'The course or stream stopped making sense',
    body: 'Sometimes the subject, the workload, or the mismatch between the course and your actual strengths becomes clear only after starting - and continuing anyway would have wasted more time.',
  },
  {
    title: 'Repeated failure wore down the will to continue',
    body: 'Backlogs, a failed year, or falling behind classmates can make walking away feel like the only option, even when a narrower fix might have existed.',
  },
];

const routeOptionItems = [
  {
    title: 'Go back and complete the same path',
    body: 'Re-enrolment, a private-candidate re-attempt, or completing pending backlogs is often possible longer than it feels right after leaving. Checking the actual re-entry window and rules is worth doing before ruling this out.',
  },
  {
    title: 'Finish it through a flexible route instead',
    body: 'NIOS lets you complete class 10 or 12 on your own timeline. Open universities such as IGNOU admit graduates and diploma seekers with flexible eligibility and no fixed re-attempt window, so the qualification itself is not permanently out of reach.',
  },
  {
    title: 'Build a skill-first path without going back at all',
    body: 'Certifications, government skill-development programmes, ITI and polytechnic trades, and demonstrated project or freelance work can open real income and roles without requiring the original course to be finished first.',
  },
];

const stigmaItems = [
  {
    title: 'The story is not "I failed" - it is "here is what happened, and here is what I am doing about it"',
    body: 'Employers and interviewers respond to a clear, honest account of a real setback followed by action far better than to silence or a vague answer about the gap.',
  },
  {
    title: 'Skills and proof of work speak louder than an unfinished transcript',
    body: 'A portfolio, a certification, a completed project, or demonstrated on-the-job ability answers "can you do the work" more directly than a degree does - and it is something you can start building immediately.',
  },
  {
    title: 'One incomplete course is not the same as being unemployable',
    body: 'Plenty of people who left a course mid-way have gone on to build stable income through trades, certifications, government roles with flexible eligibility, or skill-based work - the setback is real, but it is not the final chapter.',
  },
];

const familyPointItems = [
  {
    title: 'Separate the shame from the actual next step',
    body: 'A lot of the pressure at home is about how the situation looks, not just what happens next. Naming a real plan - even a small one - usually changes the tone of the conversation faster than more explaining.',
  },
  {
    title: 'Talk about money honestly if that was part of the reason',
    body: 'If fees or family income were behind the decision, saying that plainly is usually more productive than letting the conversation stay stuck on blame or disappointment.',
  },
  {
    title: 'Bring one concrete option, not a vague promise to "figure it out"',
    body: 'A specific route - re-enrolling, an open-schooling completion, or a named skill path - gives a worried parent or guardian something real to respond to instead of more uncertainty.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance treats the dropout as a fact, not a character flaw',
    body: 'Useful guidance should focus on your actual next options, not make you explain or justify why you left before it will help you plan forward.',
  },
  {
    title: 'Check whether returning, rerouting, and skill-first paths are all genuinely considered',
    body: 'A narrow plan that only pushes you back into the exact same course, or only pushes you away from it, is not real decision support. All three routes deserve an honest look against your situation.',
  },
  {
    title: 'Check whether skill direction is part of the plan, not just the paperwork',
    body: 'Completing or replacing the qualification is only half the picture. Stronger guidance should also help you start building a high-value skill portfolio aimed at unlocking high income opportunities, not one that depends entirely on that one credential.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments.',
  },
];

const faqItems = [
  {
    question: 'What should career counselling for dropouts actually help with?',
    answer:
      'It should help you look honestly at three real routes - going back to complete the same path, rerouting through a flexible completion option like open schooling or an open university, or building a skill-first direction without going back at all - and match the right one to your actual situation, not push one option by default.',
  },
  {
    question: 'Does leaving a course partway close off strong career options permanently?',
    answer:
      'No. It genuinely closes some doors for a period - certain campus placements or programmes with a fixed eligibility window - but it does not close the door to further study, a skilled trade, government roles with flexible eligibility, or building real income through demonstrated skill and proof of work.',
  },
  {
    question: 'Is this a service that gets my degree back or guarantees a job?',
    answer:
      'No. This is not a re-enrolment processing service and not a job-guarantee or placement service. It is decision support - helping you see your real options and build a clearer, skill-first plan from wherever you left off.',
  },
  {
    question: 'How do I explain a dropout to a future employer without it working against me?',
    answer:
      'Keep it short, honest, and forward-facing: what happened, and what you have done since. A brief, clear account paired with real skills or proof of work usually lands better than trying to hide or over-explain the gap.',
  },
  {
    question: 'Should I use free assessments or get counselling now?',
    answer:
      'Use a free assessment as a quick signal if you are still weighing which direction feels right. Move to counselling once the decision already feels urgent - a re-enrolment deadline, family pressure that needs a real answer, or a skill path you are ready to commit to.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help with the pressure at home, not just the academic or career options?',
    answer:
      'Yes. Part of building a real plan is being able to explain it calmly to parents or guardians, so the guidance should also help you frame that conversation, not just list the options.',
  },
  {
    question: 'Is this different from career guidance for someone taking a planned gap year?',
    answer:
      'Yes. A gap year is a planned pause with an intended return date. Dropping out usually means the original path stopped without a plan to go back, often because of money, a personal or family crisis, or repeated setbacks. The real next step is different - this is built around restarting, rerouting, or building a new skill-first direction, not resuming a break that was already scheduled to end.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so you can join from home or wherever you already are instead of depending on local availability.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for Dropouts', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for Dropouts | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for Dropouts',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for Dropouts</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling for dropouts
      </div>

      <h1 class="hero-title">
        Career counselling for dropouts
        <span class="gold-text"> - a real next step, not a verdict on your future</span>
      </h1>
      <p class="hero-sub">
        Leaving a school, college, or course partway usually happens for real reasons - money running out, a family crisis, or a path that stopped making sense - not because of ability or effort. Career counselling for dropouts should turn that setback into one honest, skill-first next step: going back, rerouting through a flexible option, or <strong>building a high-value skill portfolio that opens income opportunities without waiting on one finished credential</strong>.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. You can start from home, without waiting on a local option or explaining yourself to anyone in person.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Counselling for Dropouts</a>
      </div>
      <p class="hero-support">
        This is not a re-enrolment processing service and not a job guarantee. It is decision support that treats your situation with respect and helps you choose a real next step from here.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="why-it-happens"
    title="Why courses get left unfinished - and why that is not the whole story"
    subtitle="Most dropouts happen for specific, understandable reasons. Naming the real one matters, because it usually points straight at the strongest next step toward building a high-value skill portfolio and achieving earlier financial freedom, whether or not the original course gets finished."
    items={whyItHappensItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get a plan built around your exact situation before more months pass in uncertainty"
    body="The longer a dropout goes unaddressed, the more the uncertainty itself - not the original setback - becomes the real cost."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Dropouts"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why this needs sharper guidance than a general pep talk"
    subtitle="A dropout deserves a real, specific plan - not just reassurance that things will work out. These are the contrast points that matter once a next step needs to be chosen."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="stigma-and-employers"
    title="Reframing the story for employers, without pretending it did not happen"
    subtitle="Dropping out still carries real stigma in India, especially in interviews and family circles. The honest version of the story, backed by skills and proof of work, is usually the stronger version."
    items={stigmaItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="family-conversation"
    title="Having the conversation at home without it turning into a bigger fight"
    subtitle="For most dropouts, the situation itself is only half the pressure - the conversation waiting at home, often shaped by shame or financial worry, is the other half."
    items={familyPointItems}
    variant="prep"
  />

  <ContextualCta
    audience="student"
    title="Walk into the conversation at home with a plan, not just the news"
    body="A dropout plus a real next step lands very differently than the dropout alone. Counselling helps you build that plan before the conversation happens, not after it goes badly."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Dropouts"
  />

  <BuyerChecks
    title="What to check before paying for counselling after dropping out"
    subtitle="The point is a specific, honest plan for your exact situation - not generic reassurance or a list of options with no real answer for you."
    items={buyerCheckItems}
  />

  <BofuStepFlowSection
    sectionId="route-options"
    title="Three real routes forward, depending on your situation"
    subtitle="Whether the course can still be completed, needs a flexible reroute, or is better left behind for a skill-first path - a specific route exists. Counselling helps you pick the one that fits, instead of defaulting to the first option you hear."
    items={routeOptionItems}
  >
    <AssessmentSupportNote
      body="As a starting signal, the free career and skill assessments can help map your strengths and direction before you commit to returning, rerouting, or building a new skill lane."
      href="/services/assessments/"
      label="Free career and skill assessments"
    />
  </BofuStepFlowSection>

  <ContextualCta
    audience="student"
    title="Move on one real next step instead of staying stuck in the uncertainty"
    body="If the bigger problem right now is not ability but not knowing what actually changed or what comes next, stronger counselling helps before more weeks pass without a plan."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Dropouts"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling for Dropouts"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader student guidance, related decision-support pages, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Turn this setback into one clear next step instead of a stalled few months"
    subtitle="Leaving a course unfinished is a setback, not a verdict on your worth or your future. Build the plan now - one that puts you back on a route toward stronger skills, real income growth, and earlier financial freedom - instead of letting the uncertainty stretch on."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Dropouts"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.2rem, 4.7vw, 3.85rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #stigma-and-employers,
  #family-conversation,
  #faq { background: rgba(255,255,255,.01); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.78rem, 9.4vw, 2.45rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
