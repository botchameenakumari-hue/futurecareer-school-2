---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Counselling for 11th Class Students | Fix the Elective and Stream-Fit Decision | Future Career School';
const description =
  'Career counselling for 11th class students in Science, Commerce, or Arts — the elective mix, stream-fit doubts, and exam-track planning before the year locks in.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-11th-class-students/';

const class1112AssessmentUrl = BOFU_ASSESSMENT_LINKS.class11To12;
const streamGuideUrl = '/blog/stream-selection/which-stream-to-choose-in-11th/';
const cuetVsJeeUrl = '/blog/stream-selection/cuet-vs-jee-which-is-better-for-career/';
const parentGuideUrl = '/blog/parents/how-to-guide-child-in-career-selection-india/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.counsellingFor12thStudents,
    title: 'Career Counselling for 12th Students',
    description: 'Help for the moment boards and entrance results are out, once the decision moves from subjects to a specific course and college.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-class-10-students/',
    title: 'Career Counselling for Class 10 Students',
    description: 'For the earlier decision of picking Science, Commerce, or Arts in the first place, before 11th admission.',
  },
  {
    href: class1112AssessmentUrl,
    title: 'Class 11 to 12 Assessment',
    description: 'A free signal on strengths, working style, and subject fit before a deeper elective or stream conversation.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for school, college, and early skill-direction decisions beyond the current elective choice.',
  },
  {
    href: cuetVsJeeUrl,
    title: 'CUET vs JEE: Which Is Better for Your Career',
    description: 'A practical comparison for students in Science who are still deciding which entrance track to commit real 11th-class time to.',
  },
  {
    href: parentGuideUrl,
    title: 'How to Guide Your Child in Career Selection',
    description: 'Practical support for parents navigating elective pressure and stream-switch conversations without turning them into a fight.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Random upskilling that compounds slowly',
    right: 'Clearer skill direction tied to growth and income upside',
  },
];

const whatIsDecidedItems = [
  {
    title: 'The elective or subject combination inside the stream',
    body: 'Science students weigh Computer Science against Biology, or a second Maths-heavy elective against a lighter one. Commerce students weigh Maths against no-Maths, and Economics against an applied business elective. Arts students weigh Psychology, Political Science, Sociology, and Fine Arts combinations. This choice quietly shapes which entrance exams and degree options stay open two years from now.',
  },
  {
    title: 'Whether the stream picked at Class 10 still actually fits',
    body: 'A few months into 11th, some students realize the workload, the teaching, or the subject itself feels wrong in a way that theory never showed. That is a real signal, not weakness — the question is whether it is strong enough and early enough to justify a stream switch.',
  },
  {
    title: 'How much of the year goes to boards, entrance prep, and one backup skill',
    body: 'JEE, NEET, CLAT, CA Foundation, or CUET preparation now competes for the same hours as school itself. Students who put every hour into one exam track with no parallel skill are taking on more risk than they usually realize.',
  },
  {
    title: 'How to hold the parent and school conversation without losing the year to it',
    body: 'Schools often steer students toward "safer" elective combinations for their own average scores. Parents often push a prestige elective or a specific entrance exam based on what worked for a relative. Both pressures are real, and a student caught between them can lose months just deciding who to listen to. Every one of these choices feeds the same longer game: building a high-value skill portfolio that keeps unlocking high income opportunities and moves toward earlier financial freedom, not just clearing this term.',
  },
];

const stageDifferenceItems = [
  {
    title: 'Before 11th, the question was which stream to enter',
    body: 'Career counselling for Class 10 students works from theory: comparing Science, Commerce, and Arts before anyone has actually sat through a single class in any of them. It is a forecast, made on marks, interest, and family input.',
  },
  {
    title: 'Inside 11th, the question is what to do with the stream already entered',
    body: 'By this point the forecast has met reality. The student has felt the actual workload, the actual teachers, and the actual subject matter. The decision now is about electives, exam-track hours, and whether the original stream call still holds — not about picking a stream from a blank slate.',
  },
  {
    title: 'After 12th, the question moves to a specific course and college',
    body: 'Once boards and entrance results are out, the stream and elective choices are locked in and the decision becomes which degree and institution to commit to. That is a different, later conversation than the one an 11th-class student is having right now.',
  },
  {
    title: 'A stream switch is still possible here, but the window is closing',
    body: 'Many schools allow a stream or elective change within the first few months of 11th, sometimes with a catch-up condition. Waiting until deep into the second half of the year usually means either forcing through a poor fit or accepting a full repeat year.',
  },
];

const clarifyItems = [
  {
    title: 'Separate genuine subject discomfort from a hard-teacher or hard-topic phase',
    body: 'A rough unit, a strict teacher, or a bad test result can feel like proof the whole stream was a mistake. Good counselling checks whether the discomfort is about the subject itself or about one fixable patch of it before treating it as a stream-fit problem.',
  },
  {
    title: 'Test the elective decision against where it actually leads, not against which sounds safer',
    body: 'Dropping Computer Science because it "sounds harder," or adding Maths in Commerce only because a friend did, are decisions made on comfort instead of consequence. The elective choice should be checked against the entrance exams and degree routes it keeps open or closes.',
  },
  {
    title: 'Give the exam-track decision an honest backup answer',
    body: 'Committing every hour to one entrance exam with no fallback skill is a real risk when the result is still two years away. A parallel skill built alongside boards protects the year even if the exam result does not go as planned.',
  },
  {
    title: 'Turn the stream-switch question into a real cost comparison, not a panic decision',
    body: 'A switch made in the first weeks of 11th on genuine fit reasoning is very different from a switch made in a moment of frustration in the tenth month. The decision should weigh what is actually lost against what is fixed, not just react to how the week has felt.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether it actually engages with your specific elective or subject combination',
    body: 'If the conversation stays at the level of "Science, Commerce, or Arts" without touching your specific elective mix, it has not moved past the Class 10 conversation you already had.',
  },
  {
    title: 'Check whether a stream-switch conversation looks at real cost, not just comfort',
    body: 'A serious process should weigh lost time, catch-up load, and entrance-exam eligibility against the discomfort driving the switch request — not just validate whichever way you are leaning that week.',
  },
  {
    title: 'Check whether the exam-track plan includes a backup skill, not just a study schedule',
    body: 'A plan that only tells you how to study harder for JEE, NEET, CLAT, or CA Foundation misses the actual risk: two years of hours going into one outcome with nothing built alongside it.',
  },
  {
    title: 'Check whether the plan gives you a real backup, not just moral support',
    body: 'A conversation that only reassures you without naming a concrete parallel skill or a clear stream-switch criterion has not actually reduced your risk — it has just made the current term feel more comfortable.',
  },
];

const faqItems = [
  {
    question: 'I chose Science (or Commerce, or Arts) at Class 10 and now I am not sure it fits. What should I actually check?',
    answer:
      'First separate whether the discomfort is with one hard subject, teacher, or test result, or with the actual daily work of the stream itself. Genuine stream-fit doubt after a real stretch inside the stream deserves a serious look; a rough patch usually does not need a switch.',
  },
  {
    question: 'Is it too late to change streams once I have started 11th?',
    answer:
      'It depends on the school and how far into the year you are. Many schools allow a change within the first few months, sometimes with a catch-up condition on missed topics. The later into the year it gets, the more a switch usually means either forcing through the current stream or accepting a repeat year.',
  },
  {
    question: 'How do I choose between electives like Computer Science and Biology, or Maths and no-Maths in Commerce?',
    answer:
      'Check the choice against the entrance exams and degree routes it opens or closes, not just which one sounds easier this term. A subject combination decided on comfort now can quietly remove options two years from now that are hard to add back.',
  },
  {
    question: 'Should I put all my time into one entrance exam like JEE, NEET, CLAT, or CA Foundation?',
    answer:
      'Committing every hour to a single exam track with no parallel skill is a real risk over a two-year runway. Building one backup skill alongside boards and exam prep protects the year even if that specific exam result does not go the way you hoped.',
  },
  {
    question: 'My parents and my school want different things for my elective or exam choice. How do I handle that?',
    answer:
      'Schools sometimes steer students toward combinations that protect the school’s average scores, and parents sometimes push a choice based on a relative’s experience or local prestige. A neutral counselling conversation can separate the real concern behind each position from the pressure itself, so the final call is actually yours to defend.',
  },
  {
    question: 'How is this different from career counselling for Class 10 students?',
    answer:
      'Class 10 counselling helps decide which stream to enter in the first place, before a student has experienced any of it. This is for the decision after that: the actual elective mix, whether the chosen stream still fits after real exposure, and how to plan exam-track hours now that boards and entrances are visible on the calendar.',
  },
  {
    question: 'Are the career and skill assessments for this stage free?',
    answer:
      'Yes. The Class 11 to 12 career and skill assessments are fully free, and they can be described as updated, practical, and AI-powered — useful as an early signal before a deeper elective or stream conversation.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so students and parents can join from home or school hours without depending on a local counsellor’s limited availability.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for 11th Class Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for 11th Class Students | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for 11th Class Students',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for 11th Class Students</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling for 11th class students already inside a stream
      </div>

      <h1 class="hero-title">
        Career counselling for 11th class students
        <span class="gold-text"> sorting out electives, stream-fit, and exam-track hours</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career counselling for 11th class students who have already entered Science, Commerce, or Arts and now have to get the elective mix, the exam-track plan, and the stream-fit question right — before more of the year goes into the wrong bet. The goal is a decision that protects the high-value skill portfolio building toward earlier financial freedom, not just one that gets the current term over with.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. Students and parents can join around school and coaching hours instead of waiting on a local counsellor's limited slots.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">
          Get Career Counselling for 11th Class Students
        </a>
      </div>
      <p class="hero-support">
        This is not the pre-stream conversation from Class 10. It is for the decisions that only show up once a student is actually sitting inside Science, Commerce, or Arts: which elective combination, whether the stream still fits, and how to plan exam-track hours without gambling the whole year on one outcome.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-is-decided"
    title="What the 11th class decision actually involves once you are already in a stream"
    subtitle="Choosing Science, Commerce, or Arts was the first decision. The decisions that come after entering the stream are just as consequential and get far less attention."
    items={whatIsDecidedItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get clarity on the elective and exam-track decision before more of the term is locked in"
    body="Elective combinations and exam-track hours get harder to unwind the deeper into 11th you go. Sorting this out now is cheaper than fixing it in 12th."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 11th Class Students"
  />

  <BofuStepFlowSection
    sectionId="how-this-differs"
    title="How this is different from Class 10 and from after-12th counselling"
    subtitle="Class 10, Class 11, and after 12th can look like one long stretch of the same decision from the outside. Each one is actually asking a different question."
    items={stageDifferenceItems}
  >
    <div class="support-links card">
      <a href={streamGuideUrl}>Read the pre-11th stream-selection framework &rsaquo;</a>
      <a href={BOFU_INTERNAL_LINKS.counsellingFor12thStudents}>See what changes once boards and entrance results are out &rsaquo;</a>
    </div>
  </BofuStepFlowSection>

  <ComparisonMatrix
    sectionId="different"
    title="Why the 11th-class elective and stream-fit decision needs sharper reasoning than a guess"
    subtitle="These are the contrast points that matter most once real subject exposure, exam-track pressure, and elective trade-offs are already in play."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="what-clarify"
    title="What career counselling for 11th class students should actually clarify"
    items={clarifyItems}
    variant="decision"
  >
    <AssessmentSupportNote
      body="As a starting point, the free Class 11 to 12 assessments can surface early signals on working style and subject fit before a deeper elective or stream-switch conversation."
      href={class1112AssessmentUrl}
      label="Free career and skill assessments"
    />
  </BofuFeatureSection>

  <BuyerChecks
    title="What to check before paying for 11th-class career counselling"
    subtitle="The goal is a decision on your actual elective mix and exam-track plan, not a repeat of the stream conversation you already had at Class 10."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Fix the elective, stream-fit, or exam-track decision while the window is still open"
    body="If a subject combination, a stream-fit doubt, or an exam-track plan still feels unsettled, stronger reasoning now costs far less than a rushed correction in 12th."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 11th Class Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling"
    title="Career Counselling Plans for 11th Class Students"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See the earlier stream-selection stage, the later after-12th stage, free assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Do not let this year pass on an elective or exam-track guess"
    subtitle="Use 11th-class career counselling to settle the elective mix, the stream-fit question, and the exam-track plan with real reasoning, so the choice still builds toward a stronger skill portfolio and earlier financial freedom instead of drifting on comfort or pressure."
    studentHref="#plans"
    studentLabel="Get Career Counselling for 11th Class Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.75rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-clarify,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.8rem, 9.6vw, 2.5rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
