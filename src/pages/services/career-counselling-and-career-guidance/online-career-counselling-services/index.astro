---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_COMPARISON_LIBRARY,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';

const onlineComparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[3],
  BOFU_COMPARISON_LIBRARY[5],
];

const title =
  'Online Career Counseling Services | What You Get Before You Pay | Future Career School';
const description =
  'Comparing online career counseling services before you book? See exactly what is included in an online session, how the process runs end to end over video, and what to check about a provider before paying for remote guidance.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/online-career-counselling-services/';

const deliverableItems = [
  {
    title: 'What a session actually includes online',
    listItems: [
      'Profile, strengths, and work-style mapping done over video, not a static form you fill and forget',
      'A live conversation about your real decision, not a pre-recorded module or generic slide deck',
      'A clear next step you leave with, sent to you in writing after the call so it does not get lost',
    ],
  },
  {
    title: 'What gets shared with you digitally',
    listItems: [
      'Assessment results and any notes are shared through a link or document, not left inside someone else’s paper file',
      'A recap of the decision, trade-offs, and shortlist you can refer back to whenever you need it',
      'A clear channel to ask a follow-up question if something is still unclear after the session',
    ],
  },
  {
    title: 'What continues after the first online session',
    listItems: [
      'For students, continuous guidance in small online groups after the first 1-on-1 keeps skill choices on track across the year, aimed at the skill portfolio that opens stronger income opportunities early',
      'For working professionals, follow-up 1-on-1 sessions can be booked around a specific pivot or positioning decision that moves you closer to earlier financial freedom',
      'Nothing about the online format should make follow-up harder than an in-person visit would',
    ],
  },
];

const stepFlowItems = [
  {
    title: 'Book the session and share the real situation upfront',
    body:
      'Booking happens online, and a short intake gives the counselor your actual stage and pressure before the call starts, so the first few minutes are not wasted on context you already typed out.',
  },
  {
    title: 'Join the video session from wherever you already are',
    body:
      'The session itself runs over video. Screen-sharing is used to walk through assessment results and options together in real time, the same way a good in-person session would use a whiteboard.',
  },
  {
    title: 'Leave with a written recap, not just a memory of the call',
    body:
      'A useful online process ends with something you can reopen later: the shortlist, the trade-offs, and the one next step, sent to you rather than left to memory once the call ends.',
  },
  {
    title: 'Continue online if the decision needs more than one session',
    body:
      'If the situation needs a second conversation, continuation should stay online and pick up from where the last session left off, not restart the whole context from zero.',
  },
];

const onlineCheckItems = [
  {
    title: 'Check how the session is actually delivered before you pay',
    body:
      'Ask whether the session is a live video call with a real counselor or a recorded module dressed up as guidance. A credible online career counseling service should tell you this clearly before you book, not after.',
  },
  {
    title: 'Check what happens to your assessment data and notes',
    body:
      'When guidance moves online, your profile, results, and notes exist as digital files somewhere. Ask where they go, who can see them, and whether you get a copy — not just what the session covers.',
  },
  {
    title: 'Check whether pricing and continuation terms are visible before booking',
    body:
      'An online purchase should not hide the real cost behind a "book a call to discuss pricing" step. Look for the session price and any continuation option shown clearly on the page itself.',
  },
  {
    title: 'Check whether you can still reach the same counselor for a follow-up',
    body:
      'Online delivery should make follow-up easier, not harder. If a second session means explaining your whole situation again to someone new, the "service" part of the service is weaker than it looks.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check that the session price is the whole price',
    body:
      'Look for a service that shows the online session price and any continuation option upfront, with no separate fee layer that appears only after you have booked and joined the call.',
  },
  {
    title: 'Check whether rescheduling or a poor connection is handled fairly',
    body:
      'Online sessions run on video, and calls occasionally drop or need rescheduling. A credible service should have a clear, fair policy for this instead of leaving you to lose the session entirely.',
  },
  {
    title: 'Check whether the deliverable is specific, not just "we will help you figure it out"',
    body:
      'A real online career counseling service should promise specific outputs: profile clarity, a shortlist, skill direction, and a written next step — not a vague description of a friendly conversation.',
  },
  {
    title: 'Check whether the assessments behind the online session are current or recycled',
    body:
      'Free, updated, practical, AI-powered career and skill assessments are a stronger starting layer than a paid, outdated assessment presented like a mandatory first step before the real session.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Comparing online career counseling services before a stream, course, or first-job decision',
    body:
      'You are not only picking a direction — you are deciding whether an online service actually delivers a structured session and a usable next step, or just a pleasant video call that ends without one.',
  },
  {
    label: 'Working Professionals',
    title: 'Evaluating whether an online counseling service can move a stalled career forward',
    body:
      'The video-call format only matters if the process behind it produces sharper positioning, a real skill direction, and a next step you can act on the same week — not a sympathetic conversation with no follow-through.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger issue is the full career decision itself, not only how the online service is delivered or structured.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'See this version if your main question is simply whether counselling works over video and across India, rather than what a paid online service includes before you book.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-service',
    title: 'Career Counselling Service',
    description:
      'Compare the general service-evaluation view — deliverables, process, and provider credibility — without the online-delivery specific checks covered on this page.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/best-career-counselling-platform',
    title: 'Best Career Counselling Platform',
    description:
      'Compare how different online providers differ on credentialing, personalisation, assessment quality, and pricing transparency.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, and postgraduates who need stronger direction delivered online.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, and stronger long-term leverage, delivered through online sessions.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Use free, updated, practical, AI-powered career and skill assessments as a no-cost way to see the online delivery quality before paying for a full session.',
  },
];

const faqItems = [
  {
    question: 'What exactly do online career counseling services include?',
    answer:
      'A session should include profile and work-style mapping, a live video conversation about your actual decision, and a written recap of the shortlist and next step sent to you afterward. Students who continue past the first session can move into ongoing small-group online guidance to keep skill choices on track across the year.',
  },
  {
    question: 'How is the online process structured from booking to the actual session?',
    answer:
      'Booking happens online, a short intake captures your real situation before the call, the session itself runs over video with screen-sharing for assessment results, and it should end with a written recap rather than only a verbal summary you have to remember.',
  },
  {
    question: 'How do I check if an online career counseling service is credible before paying?',
    answer:
      'Ask how the session is delivered (live video versus a recorded module), what happens to your assessment data, whether pricing is visible before you book, and whether you can reach the same counselor again for a follow-up. Vague answers to any of these are worth noticing before you pay.',
  },
  {
    question: 'Is online career counseling as effective as meeting someone in person?',
    answer:
      'The format is not what makes a session useful. A structured process, a real counselor, and a next step you can act on matter more than whether the meeting happens over video or across a table.',
  },
  {
    question: 'Are the career and skill assessments used in the online session free?',
    answer:
      'Yes. Career and skill assessments are fully free and can be described as updated, practical, and AI-powered. Many providers charge for outdated assessments and treat the report itself as the product; here the free assessments are a starting layer before paid 1-on-1 support.',
  },
  {
    question: 'What happens to my session notes and assessment results after an online session?',
    answer:
      'You should be able to keep a copy of your results and the session recap rather than have them exist only inside someone else’s internal system. Ask any provider, including this one, how that is handled before you book.',
  },
  {
    question: 'Can I get a follow-up session with the same counselor online?',
    answer:
      'Yes. Working professionals can book focused 1-on-1 follow-up sessions around a specific pivot or positioning decision, and students can continue into small-group continuous guidance after the first 1-on-1, all delivered online.',
  },
  {
    question: 'Is pricing for online career counseling services transparent before I book?',
    answer:
      'Yes. Current pricing for every plan is shown here before you book, including the session price and what a continuous-guidance path includes, with no separate fee layer added after payment.',
  },
  {
    question: 'Do online career counseling services guarantee a job or income outcome?',
    answer:
      'No. No ethical provider can guarantee a job or a fixed income outcome, whether the session happens online or in person. What a good online service can do is give you clearer decisions, stronger skill direction, and a realistic route toward income growth.',
  },
  {
    question: 'Is this available wherever I am in India?',
    answer:
      'Yes. The service is delivered fully online across India, so you can join from home, college, or work without depending on a local office or a nearby counsellor.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Online Career Counseling Services',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Online Career Counseling Services | Future Career School',
    description,
    url: canonical,
    serviceType: 'Online Career Counselling and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Online Career Counseling Services</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        See what you get before you book online career counseling services
      </div>

      <h1 class="hero-title">
        Online career counseling services
        <span class="gold-text"> built around what you actually get, delivered over video</span>
      </h1>
      <p class="hero-sub">
        Future Career School runs online career counseling services for students, freshers, and working professionals who want to know exactly what a video session includes, how the online process runs from booking to follow-up, and what happens to their assessment results — before committing money to stronger skill direction and a clearer route toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Delivered fully online across India through live video sessions. No office to visit, no travel — but the same expectation of a real deliverable, not just a pleasant call.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        Choosing an online service should not mean lowering your standard for what a session delivers: a real counselor, a structured process, and a next step you can act on unlocks the same high-value skill direction and income growth as an in-person session would.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="whats-included"
    title="What is included when you book online career counseling services"
    subtitle="An online session is still a paid service. Here is exactly what should be included at each stage, delivered entirely through video and digital documents."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As a starting layer, free career and skill assessments are available online to surface strengths, preferences, and work style before you decide on paid 1-on-1 support."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If you already know a video session is the right format, book the plan that matches your stage"
    body="The next step is one focused online session built around your actual decision, not a generic script read out over a call."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuStepFlowSection
    sectionId="how-it-works"
    title="How online career counseling services run, start to finish"
    subtitle="The value of a video-based process is not the video itself. It is whether each stage moves your decision forward and leaves a record you can actually use afterward."
    items={stepFlowItems}
  />

  <BofuFeatureSection
    sectionId="online-credibility"
    title="What separates a real online counselor from a video call with no real process"
    subtitle="You cannot walk into an office to judge a provider before an online booking. These are the checks that matter instead, specific to how remote career counseling is actually delivered."
    items={onlineCheckItems}
    variant="decision"
  />

  <AudienceRelevance
    sectionId="audience-fit"
    title="How online career counseling services fit where you are right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="how-it-compares"
    title="How this compares to a generic video call dressed up as counseling"
    subtitle="Plenty of services can put a counselor on a video call. The difference is whether the process behind that call gives you higher-value skill direction and a next step you can use, or just a comfortable conversation."
    rows={onlineComparisonRows}
  />

  <BuyerChecks
    sectionId="check-before-paying"
    title="What to check before paying for any online career counseling service"
    subtitle="Use these checks on this service, or on any other online provider you are comparing it against, before you book a session."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Ready to see exactly what an online session gets you"
    body="Compare the student and working-professional plans below, then book the one that matches your stage."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Online Career Counseling"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See how this compares to other online-delivery pages, general service-evaluation pages, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection title="Questions people ask before booking online career counseling services" items={faqItems} />

  <FinalCta
    audience="mixed"
    eyebrow="Next step"
    title="Book online career counseling services with a clear deliverable"
    subtitle="Move forward when you are ready for a structured online process toward stronger skill direction and a realistic route toward earlier financial freedom — not another pleasant call that ends without a next step."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 46rem); margin-bottom: 1.6rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-actions .btn-gold,
  .hero-actions .btn-outline { min-width: min(100%, 290px); justify-content: center; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #whats-included,
  #how-it-compares,
  #related-links { background: rgba(255,255,255,.012); }

  #how-it-works,
  #audience-fit,
  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 680px) {
    #hero { padding: 118px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline { justify-content: center; }
  }

  @media (max-width: 560px) {
    .hero-pill { width: 100%; padding-inline: 1rem; font-size: 12px; line-height: 1.5; }
    .hero-title { font-size: clamp(1.78rem, 9.6vw, 2.5rem); line-height: 1.05; }
  }
</style>
