---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_COMPARISON_LIBRARY } from '../../../../config/bofu';

const title = 'Career Counselling for Adults Online | Future Career School';
const description =
  'Career counselling for adults online, for anyone past school or college age: employed, between roles, restarting, or self-employed. Fully online, across India.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-adults-online/';

const fitItems = [
  {
    title: 'Between roles or job-searching',
    body: 'When there is no current job title to lean on, and the real pressure is choosing a direction quickly without another false start.',
  },
  {
    title: 'Restarting after a career break',
    body: 'When time away from paid work — caregiving, health, relocation, or any other pause — makes an old resume feel disconnected from where the market is now.',
  },
  {
    title: 'Self-employed or freelance and unsure of the next move',
    body: 'When you already run your own work but still want an outside, structured read on whether to keep building solo, formalise it, or shift direction.',
  },
  {
    title: 'Employed, but choosing counselling on your own terms',
    body: 'When you already have a job but want independent, structured support without depending on an employer programme or a local office visit.',
  },
];

const improvementItems = [
  {
    title: 'Direction that does not assume a fixed job title',
    body: 'Clarity built from your strengths, work style, and market fit, whatever your current employment status happens to be right now.',
  },
  {
    title: 'Skill-first positioning, not a return to square one',
    body: 'A path built on high-value skills and proof of work, instead of defaulting back to another degree or a from-scratch resume just because of a break or transition.',
  },
  {
    title: 'Income-growth logic, not just reactivation',
    body: 'The goal is not only getting back to paid work. It is a stronger route toward higher-value opportunities and, over time, achieving earlier financial freedom.',
  },
  {
    title: 'A process actually designed to run online',
    body: 'Guidance built to work fully online across India from the start, not a scaled-down version of an in-person process.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the process assumes you already have a job',
    body: 'Many counselling services build everything around a current employer and an active resume. If you are between roles or returning after a break, guidance built only for employed people will not fit. Ask whether it can start from your actual situation.',
  },
  {
    title: 'Check whether a career break gets treated as a gap to explain or a stage to plan from',
    body: 'Stronger guidance treats time away from paid work as a real starting point for updated skills and proof of work, not a resume problem to patch over.',
  },
  {
    title: 'Check whether self-employment is treated as a real career, not an in-between status',
    body: 'If you freelance or run your own work, look for guidance that takes that seriously as its own path, with its own skill, positioning, and income decisions.',
  },
  {
    title: 'Check whether online actually means online',
    body: 'Some services describe themselves as online but still expect an in-person visit at some stage. Confirm every part of the process — including the counselling session itself — runs online before you commit.',
  },
];

const faqItems = [
  {
    question: 'Is career counselling for adults different if I am not currently employed?',
    answer:
      'The underlying support is the same — strengths, work style, market fit, skill direction, and income-growth logic. What changes is the starting point: the guidance should not assume a current job title or employer. It should work whether you are employed, between roles, or restarting.',
  },
  {
    question: 'Can this help someone returning to work after a career break?',
    answer:
      'Yes. A degree or an old resume alone is rarely enough to explain your current value after time away. The more useful approach is translating the break into a clear, updated position built on your real strengths, market-relevant skills, and proof of work — not a gap that needs excusing.',
  },
  {
    question: 'I am self-employed. Is career counselling still relevant for me?',
    answer:
      'Yes. Self-employed and freelance adults face the same core questions as anyone else: which skills are worth building next, how to position that work, and how to grow income from it. Guidance can still help even when there is no employer or traditional resume involved.',
  },
  {
    question: 'Is this actually available fully online, or do I need to visit an office eventually?',
    answer:
      'Guidance is delivered fully online across India for the entire process, including the counselling session itself. There is no office visit or in-person requirement at any stage.',
  },
  {
    question: 'Is this the same as career counselling for working professionals?',
    answer:
      'No. Career counselling for working professionals is built around someone who already has a current job title and an in-role question to resolve. This is built for a wider group — including people with no current job title at all, such as someone between roles or restarting after a break — with every part of the process, including the session itself, confirmed to run fully online rather than assuming an in-person option exists somewhere along the way.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free, updated, practical, and AI-powered, and can be used as a starting signal before a paid counselling session.',
  },
];

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with path, skill, and next-step decisions when several connected choices need to make sense together.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-online/',
    title: 'Career Counselling Online',
    description: 'Direct online counselling support for anyone who wants a structured session without visiting an office.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-adults/',
    title: 'Career Counselling for Adults',
    description: 'The same adult audience without the online-delivery emphasis — built instead around real time constraints, higher stakes, and the existing skill base an adult already has.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/working-professional-career-guidance/',
    title: 'Working Professional Career Guidance',
    description: 'For people already in a role and dealing with stagnation, AI pressure, pivots, or positioning while employed.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coaching-for-career-change/',
    title: 'Career Coaching for Career Change',
    description: 'For a deliberate industry or function switch that needs a full plan, not just a single session.',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professionals and Career Changers Assessment',
    description: 'Free input for pivots, role fit, and stronger leverage decisions, useful whatever your current employment status.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for skill fit, direction, and stronger next-step decisions.',
  },
  {
    href: '/career-skills-compass/',
    title: 'Career & Skills Compass',
    description: 'A free tool for narrowing the skill paths that fit your strengths and market direction.',
  },
  {
    href: '/career-resources/from-employee-to-freelancer-the-real-roadmap/',
    title: 'From Employee to Freelancer: The Real Roadmap',
    description: 'A practical look at moving between employment and self-employment without guessing at the risks.',
  },
];

// Pulled live from BOFU_COMPARISON_LIBRARY (src/config/bofu.ts) rather than a page-local copy,
// and deliberately not the same subset as the career-counselling-for-adults sibling page
// (which uses indices 0, 5, 2) to avoid a near-duplicate comparison block.
const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[4],
  BOFU_COMPARISON_LIBRARY[3],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for Adults Online', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for Adults Online | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for Adults Online',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for Adults Online</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        No fixed job title required — built for any adult, fully online
      </div>

      <h1 class="hero-title">
        Career counselling for adults online
        <span class="gold-text"> whatever your current employment status is</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career counselling for adults online for anyone past school or college age
        who needs a clearer next step — employed, between roles, restarting after a career break, or self-employed.
        The direction is the same for everyone: a high-value skill portfolio, stronger positioning, and a realistic
        route toward unlocking high income opportunities and achieving earlier financial freedom.
      </p>
      <p class="hero-note">
        Sessions run fully online across India, so you can join from home, a co-working space, or wherever your day
        already happens — no office visit, no local branch dependency, no waiting for an in-person slot.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Counselling for Adults</a>
      </div>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="fit"
    title="Who career counselling for adults online is built for"
    subtitle="This is not online career guidance for adults scoped to one employment status. It is built for the wider group of adults making a real career or skill decision right now, aimed at a high-value skill portfolio and earlier financial freedom rather than just a job title."
    items={fitItems}
    variant="signal"
    columns={2}
  />

  <ComparisonMatrix
    title="What changes when counselling is not built only for the currently employed"
    subtitle="Most career counselling online quietly assumes a resume, an employer, and a job title. This is where that assumption should stop being the default."
    rows={comparisonRows}
  />

  <ContextualCta
    audience="professional"
    title="A clearer next step matters whether you are employed, between roles, or restarting"
    body="The longer a direction stays unclear, the more it costs in time, confidence, and missed income — regardless of your current employment status."
    professionalHref="#plans"
    professionalLabel="Get Career Counselling for Adults"
  />

  <BuyerChecks
    title="What to check before paying for career counselling as an adult"
    subtitle="The goal is a process that starts from your real situation, not one built only for people who already have a job to describe."
    items={buyerCheckItems}
  />

  <BofuFeatureSection
    sectionId="what-changes"
    title="What strong career counselling for adults should improve"
    items={improvementItems}
    variant="decision"
    columns={2}
  />

  <ContextualCta
    audience="professional"
    title="Do not let an unclear employment status keep the bigger decision on hold"
    body="A structured session can create movement whether the real question is finding the next role, re-entering after a break, or choosing where self-employment goes next."
    professionalHref="#plans"
    professionalLabel="Get Career Counselling for Adults"
  />

  <GuidancePlansSection
    audience="professional"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See other counselling and guidance pages, career-changer assessments, and free tools before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection
    title="Questions adults ask before choosing online career counselling"
    items={faqItems}
  />

  <FinalCta
    audience="professional"
    title="Your current employment status should not be what decides whether you get clarity"
    subtitle="Whether you are employed, between roles, restarting after a break, or self-employed, a structured, fully online session can move you toward stronger skill direction and a realistic route to achieving earlier financial freedom."
    professionalHref="#plans"
    professionalLabel="Get Career Counselling for Adults"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px); background-size: 80px 80px; mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%); opacity: .16; }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 44rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.68); line-height: 1.85; max-width: 790px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.54); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #fit,
  #related-links { background: rgba(255,255,255,.012); }

  #check-before-paying { background: rgba(255,255,255,.008); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.76rem, 9.3vw, 2.35rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
