---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuSummaryStrip from '../../../../components/bofu/BofuSummaryStrip.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
  BOFU_PAYMENT_LINKS,
} from '../../../../config/bofu';

const title =
  'Career Counselling Online | Practical Clarity Across India | Future Career School';
const description =
  'Career counselling online for students, freshers, and working professionals across India. Get clearer decisions, stronger skill direction, and a practical next step without depending on local options.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-online';

const whenOnlineItems = [
  {
    title: 'You need clarity without waiting for a local option',
    body:
      'Online career counselling matters when the decision already feels serious and waiting for the right nearby option only adds more delay.',
  },
  {
    title: 'The next move feels personal, expensive, or hard to reverse',
    body:
      'Course choices, pivot choices, skill choices, and salary-growth choices do not become safer just because you keep thinking about them longer.',
  },
  {
    title: 'More opinions are not creating more clarity',
    body:
      'When family, friends, colleagues, or the internet keep adding noise, stronger counselling should help narrow the problem instead of expanding it.',
  },
  {
    title: 'You want better reasoning, not city dependence',
    body:
      'The value is clearer thinking around fit, risk, skill direction, and the next practical move, not proximity to an office.',
  },
];

const resolveItems = [
  {
    title: 'Which route deserves serious effort now',
    body:
      'Online career counselling should help you judge which course, degree, role, pivot, or skill path is genuinely worth doubling down on.',
  },
  {
    title: 'What should stay as backup and what should be dropped',
    body:
      'A stronger counselling process helps you compare the serious option, the acceptable backup, and the route that only looks fine on the surface.',
  },
  {
    title: 'Which skill direction should start early',
    body:
      'The better choice is not only about labels. It is also about which skill direction improves market value earlier instead of being delayed for years.',
  },
  {
    title: 'How proof of work and income growth fit the choice',
    body:
      'Better counselling should connect the next decision to proof of work, stronger positioning, and a clearer route toward better long-term income growth.',
  },
];

const flowItems = [
  {
    title: 'Bring the real question under pressure',
    body:
      'The session should start with the actual decision that matters now, not only the broad label you searched for.',
  },
  {
    title: 'Compare fit, trade-offs, and constraints together',
    body:
      'Good online counselling should judge fit, risk, market reality, budget, family pressure, and skill direction as one decision system.',
  },
  {
    title: 'Leave with a tighter next move',
    body:
      'The outcome should be a sharper shortlist and a practical next step you can use after the session instead of more vague thinking.',
  },
];

const prepItems = [
  {
    title: 'Your real shortlist and backup route',
    body:
      'Bring the 2 to 4 routes you are actually comparing. The discussion gets stronger when the real trade-offs are already visible.',
  },
  {
    title: 'Marks, degree, exam, role, or current-stage reality',
    body:
      'Use the real situation, not the ideal one. Better counselling depends on what is actually available to you now.',
  },
  {
    title: 'Budget, city, relocation, and time limits',
    body:
      'If cost, city, relocation, commute, or time pressure shape the decision, surface them early so the plan still fits your reality.',
  },
  {
    title: 'Parent questions, family pressure, or work constraints',
    body:
      'When other people are part of the decision, make those concerns visible from the beginning so the reasoning does not drift later.',
  },
];

const outcomeItems = [
  {
    title: 'Which route deserves your next serious phase of effort',
    body:
      'A better session should make one route feel more justified than the others instead of leaving every option sounding equally acceptable.',
  },
  {
    title: 'What stays backup and what should stop taking your energy',
    body:
      'You should know which option remains practical backup, and which route only keeps surviving because no one has ruled it out clearly yet.',
  },
  {
    title: 'Which skill direction should start now',
    body:
      'The next move should connect to a practical skill direction early instead of waiting years before market value becomes part of the decision.',
  },
  {
    title: 'What the first move after the session should be',
    body:
      'A stronger counselling session should leave you with one useful next action that is specific enough to use immediately, not another broad idea to think about later.',
  },
];

const priorAdviceItems = [
  {
    title: 'If you already took advice, tests, or free help and still feel unclear',
    body:
      'That usually means the real trade-off is still unresolved, not that you need endless extra opinions.',
    listItems: [
      'The broad answer may still be too broad for the actual decision under pressure.',
      'The serious option and the acceptable backup may never have been compared honestly.',
      'The advice may have ignored budget, family, work, or location constraints that change the choice.',
      'You may still have no useful next action, only more information to think about.',
    ],
  },
  {
    title: 'What stronger online career counselling should do differently',
    body:
      'A better session should narrow the problem fast enough that the next move starts feeling more usable, not more crowded.',
    listItems: [
      'Reduce the options to the few routes that actually deserve serious effort now.',
      'Make the backup route explicit instead of leaving it vague in the background.',
      'Connect the choice to skill direction, proof of work, and long-term growth early.',
      'Leave you with one practical next step specific enough to act on after the session.',
    ],
  },
];

const priorAdviceSummaryItems = [
  {
    title: 'Less recycled advice',
    body: 'The goal is to stop collecting more opinions that do not improve the decision itself.',
  },
  {
    title: 'Clearer trade-offs',
    body: 'The useful question is why one route makes more sense now and what loses priority.',
  },
  {
    title: 'A smaller next move',
    body: 'Good counselling should leave you with a next action that is easier to use, not harder to decode.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the counselling still gets specific online',
    body:
      'Online should not mean generic. Stronger career counselling should still compare fit, path, skill direction, risk, and growth trade-offs clearly.',
  },
  {
    title: 'Check whether the reasoning works for everyone involved',
    body:
      'A better process should help the student and parent, or the professional and family, understand the same trade-offs instead of leaving the decision as an opinion fight.',
  },
  {
    title: 'Check whether skills and proof of work are part of the direction',
    body:
      'Good counselling should not stop at labels. It should show which skill direction and proof of work matter for the path you choose next.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body:
      'Many providers charge thousands for outdated or impractical assessments. Future Career School offers free, updated, practical, AI-powered career and skill assessments instead.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Online career counselling for stream, course, degree, and early-skill choices',
    body:
      'Useful when a school, college, or early-career decision already feels important and the next move should not depend on finding a strong local option first.',
  },
  {
    label: 'Working Professionals',
    title: 'Online career counselling for pivots, stagnation, salary ceilings, and skill under-leverage',
    body:
      'Useful when you need clearer direction around switching, growing, or repositioning without wasting more time on low-leverage options.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Counselling and Guidance',
    description:
      'Use the main service page when the bigger issue is the full decision itself, not only the online format.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description:
      'Use the broader counselling page if the main question is clarity and next steps, not only online delivery.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerGuidanceOnline,
    title: 'Career Guidance Online',
    description:
      'See the guidance-online page if the search intent is broader practical direction rather than counselling-led clarity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCoachNearMe,
    title: 'Career Coach Near Me',
    description:
      'Compare the near-me angle if you are still deciding whether locality matters more to you than stronger online decision support.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, AI pressure, and stronger long-term leverage.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Start with free, updated, practical, AI-powered career and skill assessments if you want a no-cost first layer.',
  },
];

const faqItems = [
  {
    question: 'Does career counselling online actually work?',
    answer:
      'Yes. Career counselling online works when the real value is clear reasoning around fit, path, skill direction, risk, and the next practical move rather than physical presence in one location.',
  },
  {
    question: 'Who is online career counselling for?',
    answer:
      'It is useful for students, freshers, and working professionals across India who need stronger clarity but do not want the quality of support to depend on local availability.',
  },
  {
    question: 'What should online career counselling help me decide?',
    answer:
      'It should help you judge which path deserves serious effort now, what should stay backup, which skill direction should start early, and how the next move affects long-term growth.',
  },
  {
    question: 'Is career counselling online different from career guidance online?',
    answer:
      'In practice, both point to the same real need: clearer decisions and stronger skill direction. The useful difference is not the label. It is whether the support improves the quality of the next move.',
  },
  {
    question: 'Can students and freshers use online career counselling?',
    answer:
      'Yes. It is useful when stream, course, degree, or early-skill decisions already feel important and the next move should not depend on finding a local offline option first.',
  },
  {
    question: 'Can working professionals use online career counselling too?',
    answer:
      'Yes. Online career counselling is useful for professionals dealing with pivots, salary-ceiling pressure, stagnation, AI-era shifts, or skill under-leverage.',
  },
  {
    question: 'Should I start with free assessments first or book counselling now?',
    answer:
      'If you are still exploring and the decision is not urgent yet, the free assessments, resources, and skill-finder tools are a useful first layer. If the next decision already feels important, expensive, or delayed by confusion, stronger counselling support helps more.',
  },
  {
    question: 'What should I prepare before a first online career counselling session?',
    answer:
      'Bring the real shortlist, the real constraints, and the one decision under the most pressure right now. That makes it easier to move from broad advice to a practical next step.',
  },
  {
    question: 'Can online career counselling still help if I already took tests or advice and still feel unclear?',
    answer:
      'Yes. That often means the real trade-off was never resolved clearly enough. Better online career counselling should narrow the options, make the backup route explicit, and leave you with a next move you can actually use.',
  },
  {
    question: 'Will online career counselling still work if a student and parent both need to be part of the decision?',
    answer:
      'Yes. Online career counselling is often easier when the student and parent both need to hear the same trade-offs clearly instead of repeating the conversation in separate confusing rounds.',
  },
  {
    question: 'Should I choose career counselling online or a career coach near me?',
    answer:
      'Choose based on decision quality, not only distance. If you care mainly about clearer reasoning around fit, risk, skill direction, and the next move, online counselling can work well across India. If locality is still an important filter for you, compare it with the career coach near me page too.',
  },
  {
    question: 'Is this available online across India?',
    answer: 'Yes. Guidance is delivered online across India.',
  },
  {
    question: 'Do you guarantee a job?',
    answer: 'No ethical provider can guarantee a job.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Career Counselling Online',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Online | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling Online',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': 'EducationalOrganization',
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling Online</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling online for students and working professionals across India
      </div>

      <h1 class="hero-title">
        Career counselling online
        <span class="gold-text"> for clearer next steps from anywhere in India</span>
      </h1>
      <p class="hero-sub">
        Career counselling online should help you get clear before a bigger wrong turn gets more expensive.
        The value is not the format alone.
        It is stronger reasoning around fit, skill direction, risk, and the next move that actually deserves serious effort.
      </p>
      <p class="hero-note">
        Many providers charge thousands for outdated or impractical assessments.
        Here, the career and skill assessments are fully free, updated, practical, and AI-powered.
        Guidance is delivered online across India.
      </p>
      <div class="hero-actions">
        <a href={BOFU_PAYMENT_LINKS.students} class="btn-gold pulse">Get Student Career Counselling</a>
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The real value is clearer reasoning around fit, path, skill direction, and what should happen next, not dependence on one nearby office.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="when-online"
    sectionClass="online-signal-band"
    variant="signal"
    title="When career counselling online becomes the smarter option"
    subtitle="Online matters most when the decision already feels serious and waiting for the right local option only adds more delay, pressure, or confusion."
    items={whenOnlineItems}
  />

  <BofuFeatureSection
    sectionId="what-it-should-resolve"
    sectionClass="online-decision-band"
    variant="decision"
    title="What online career counselling should actually help you resolve"
    subtitle="The goal is not a generic conversation. It is a sharper decision about what deserves real effort, what should stay backup, and what should be dropped."
    items={resolveItems}
  >
    <AssessmentSupportNote
      body="If you want a free first step before going deeper, the career and skill assessments can surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="how-it-works"
    sectionClass="online-flow-band"
    title="How online career counselling should move the decision forward"
    subtitle="The format is online, but the work should still feel practical, specific, and useful enough to change the quality of the next move."
    items={flowItems}
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    sectionClass="online-prep-band"
    variant="prep"
    title="What to keep ready before online career counselling"
    subtitle="Online counselling works better when the real options, the real limits, and the real pressure are visible from the start instead of surfacing too late."
    items={prepItems}
  />

  <BofuListCardSection
    sectionId="still-unclear-after-advice"
    sectionClass="online-clarity-band"
    title="If you already took advice or tests and still feel unclear"
    subtitle="That usually means the decision still has not been narrowed enough. Better counselling should reduce the problem, not expand the amount of information around it."
    items={priorAdviceItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={priorAdviceSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="what-should-feel-clearer"
    sectionClass="online-outcome-band"
    variant="signal"
    title="What should feel clearer by the end of a good online career counselling session"
    subtitle="The useful test is not whether the conversation felt thoughtful. The useful test is whether the next move becomes smaller, sharper, and easier to act on."
    items={outcomeItems}
  />

  <GuidanceModelSection
    title="What stronger online career counselling should actually cover"
    subtitle="The format is online, but the work should still go beyond a short conversation: fit, high-leverage decisions, high-value skill direction, proof of work, and a clearer route toward stronger long-term growth."
  />

  <AudienceRelevance
    sectionClass="online-audience-band"
    title="How the right support can fit where you are right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="online-comparison-band"
    title="Why online career counselling still has to be more useful than generic advice"
    subtitle="The format can be online, but the counselling still needs to stay specific, practical, and strong enough for a serious career decision."
    centered={true}
  />

  <BuyerChecks
    sectionClass="online-check-band"
    title="What to check before choosing online career counselling"
    subtitle="The goal is not a call that sounds useful for half an hour. The goal is clearer reasoning before the wrong route becomes more expensive."
    items={buyerCheckItems}
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See broader counselling, guidance, and free assessments before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="online-final-band"
    subtitle="Use career counselling online when the next decision already feels important and another round of delay, confusion, or low-quality advice is only making the move harder."
    studentLabel="Get Student Career Counselling"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFaqSection
    title="Questions people ask before choosing online career counselling"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.online-signal-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.online-decision-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.online-flow-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.online-prep-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(45,212,191,.045), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.006));
  }
  :global(.online-clarity-band) {
    background:
      radial-gradient(760px 240px at 100% 0%, rgba(229,184,74,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.007));
  }
  :global(.online-clarity-band .list-card-grid.is-two-col) {
    align-items: stretch;
  }
  :global(.online-clarity-band .bofu-summary-strip) {
    margin-top: 1.2rem;
  }
  :global(.online-outcome-band) {
    background:
      radial-gradient(760px 240px at 0% 0%, rgba(229,184,74,.05), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.01), rgba(255,255,255,.006));
  }
  :global(.online-outcome-band .feature-grid.is-two-col) {
    align-items: stretch;
  }
  :global(.online-outcome-band .feature-card) {
    background:
      radial-gradient(360px 160px at 100% 0%, rgba(229,184,74,.08), transparent 74%),
      linear-gradient(150deg, rgba(255,255,255,.045), rgba(255,255,255,.016));
  }
  :global(.online-audience-band .section-headline),
  :global(.online-comparison-band .section-headline),
  :global(.online-check-band .section-headline) {
    max-width: 18ch;
  }
  :global(.online-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.online-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.online-audience-band .audience-card h3) {
    font-size: 1.08rem;
    line-height: 1.46;
  }
  :global(.online-audience-band .audience-card p) {
    font-size: 14.2px;
    line-height: 1.82;
  }
  :global(.online-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.online-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.online-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.online-final-band .final-sub) {
    max-width: 50ch;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
