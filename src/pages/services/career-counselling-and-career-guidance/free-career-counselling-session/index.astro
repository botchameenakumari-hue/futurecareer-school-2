---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../components/bofu/BofuSummaryStrip.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_INTERNAL_LINKS,
} from '../../../../config/bofu';
import { GUIDANCE_PLAN_PRICE_COPY } from '../../../../config/guidancePlans';

const title =
  'Free Career Counselling Session: What’s Actually Free | Future Career School';
const description =
  'Searching for a free career counselling session or a trial career counselling session? See exactly what is genuinely free at Future Career School and what a real 1-on-1 session costs, so you can decide with full clarity.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/free-career-counselling-session/';

const {
  studentSessionPrice,
  studentSessionComparePrice,
  professionalSessionPrice,
  professionalSessionComparePrice,
  studentSessionPriceText,
  professionalSessionPriceText,
  freeLayerText,
} = GUIDANCE_PLAN_PRICE_COPY;
const mixedSessionPriceLine = `${studentSessionPrice} for students and ${professionalSessionPrice} for working professionals`;
const mixedSessionPriceBody = `${studentSessionPrice} for students, ${professionalSessionPrice} for working professionals, for one real 1-on-1 session.`;

const freeVsPaidItems = [
  {
    eyebrow: 'Genuinely free',
    title: 'Career and skill assessments, resources, and finder tools',
    body:
      'The career and skill assessments are fully free, and can be described as updated, practical, and AI-powered. Career and income-growth resources, plus the Career & Skills Compass and course-finder tools, are also free. You do not pay anything to use these, and you do not need to book a session first.',
  },
  {
    eyebrow: 'A real, paid session',
    title: 'The 1-on-1 career counselling session itself',
    body:
      `A 1-on-1 session is a counsellor's working time spent on your specific situation - not a script. It is currently priced at ${studentSessionPriceText} for students and ${professionalSessionPriceText} for working professionals. There is no version of the counselling session itself that is free, and no separate "trial" product with different terms.`,
  },
];

const freeVsPaidSummary = [
  {
    title: 'No hidden cost on the free layer',
    body: 'Assessments, resources, and finder tools stay free whether or not you ever book a session.',
  },
  {
    title: 'No hidden fee inside a "free" call',
    body: 'The price of the 1-on-1 is shown upfront — not revealed only after a sales pitch.',
  },
  {
    title: 'One honest starting price',
    body: `${mixedSessionPriceLine}, for a real session with a real counsellor.`,
  },
];

const whyNoFreeSessionItems = [
  {
    title: 'A lot of "free career counselling session" offers online are sales calls',
    body:
      'Many services advertise a free call, then spend most of it building pressure to sell an expensive package before you get any real direction. That is not counselling — it is a funnel. Future Career School keeps the two separate: the free layer (assessments and resources) is genuinely free, and the paid session is priced honestly from the start.',
  },
  {
    title: 'A real session needs a counsellor’s real time',
    body:
      'Building a high-value, high-income skill portfolio — the right skill mix, proof of work, market positioning, and a route toward earlier financial freedom — takes a counsellor actually working through your situation, not a templated 15-minute call.',
  },
  {
    title: 'The price is kept low on purpose, not padded and then "discounted"',
    body:
      `${studentSessionPrice} for a student first session and ${professionalSessionPrice} for a working professional session are the current limited-time prices - low enough to be a genuinely low-risk way to test the guidance before deciding whether to go further.`,
  },
];

const resolveItems = [
  {
    title: 'Whether your current path is actually worth the years you are giving it',
    body:
      'Assessments can point you toward strengths and work style. A real session goes further — helping you judge whether your stream, degree, or role is genuinely building toward stronger income, or just eating time.',
  },
  {
    title: 'Which skill direction is worth building toward first',
    body:
      'The goal is not one isolated skill decision. It is unlocking high income opportunities through a deliberate high-value, high-income skill portfolio that compounds over time — the right skill mix, proof of work, and market positioning together.',
  },
  {
    title: 'What is actually holding your decision back',
    body:
      'Family pressure, budget, board or exam scores, a stagnant role, or AI-era uncertainty all change what "the right move" looks like. A session should work through your real constraints, not generic advice.',
  },
  {
    title: 'What the very next step should be',
    body:
      'You should leave with one practical next action — a route to focus on, a skill to start, or a decision to drop — not more open-ended thinking.',
  },
];

const audienceItems = [
  {
    label: 'Students & Freshers',
    title: 'Testing the guidance before committing to more',
    body:
      `A ${studentSessionPrice} first session is a low-risk way to see whether the direction actually helps before choosing between one session and continuous guidance for the year - useful when a stream, course, or early-skill decision could waste years and money if it is wrong.`,
  },
  {
    label: 'Working Professionals',
    title: 'A low-cost way to check a pivot before you act on it',
    body:
      `At ${professionalSessionPrice}, one session is a small cost against the risk of a bad pivot, a stalled negotiation, or another year in a low-ceiling role ? useful when stagnation, AI pressure, or a career change already feels urgent.`,
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether "free" applies to something you actually keep',
    body: 'A genuinely free layer should give you something useful on its own — like an assessment result — not just a foot in the door for a sales call.',
  },
  {
    title: 'Check whether the real price is shown before you book',
    body: 'If a provider will not state the price of an actual counselling session until you are already on a call, treat that as a warning sign, not a courtesy.',
  },
  {
    title: 'Check whether the session addresses skill direction and income growth, not just a script',
    body: 'A useful session should connect your situation to a high-value skill direction and a realistic route toward stronger income — not repeat the same advice regardless of who is asking.',
  },
  {
    title: 'Check what happens after the first session',
    body: 'Know upfront whether you are being pushed into a big package immediately, or whether continuing is a genuine choice you make after the first session is actually useful to you.',
  },
];

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Career Counselling and Career Guidance',
    description:
      'Use the main service page if the bigger question is the full counselling and guidance decision, not only the free-versus-paid breakdown.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description:
      'See the main counselling page if you already know you want a session and want the full picture of what it covers.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'For clarity on how the online delivery works from anywhere in India before you book.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description:
      'For school students, college students, freshers, recent graduates, and postgraduates who want the student path in more depth.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description:
      'For pivots, stagnation, salary growth, and stronger long-term positioning as a working professional.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description:
      'Start with the genuinely free, updated, practical, AI-powered assessments if you are not ready to book a session yet.',
  },
];

const faqItems = [
  {
    question: 'Is there a genuinely free career counselling session?',
    answer:
      `${freeLayerText} The 1-on-1 counselling session is currently ${mixedSessionPriceLine} for a limited time.`,
  },
  {
    question: 'Is there a trial career counselling session?',
    answer:
      `There is no separate free trial product. The closest equivalent is the first 1-on-1 session itself, priced low on purpose - ${mixedSessionPriceLine} - so you can test the guidance at low cost before deciding whether to continue.`,
  },
  {
    question: 'Why isn’t the counselling session free if the assessments are?',
    answer:
      'Assessments are automated and can be offered at no cost. A counselling session is a counsellor’s working time spent on your specific path, skill direction, and constraints — which is why it is priced, but kept deliberately low during the current limited-time offer.',
  },
  {
    question: `What do I get for ${studentSessionPrice} as a student?`,
    answer:
      'One 1-on-1 session focused on your stream, course, degree, or early-skill decision. After the first session, students can move into continuous career guidance — small-group sessions across the year — to keep skill choices and income-growth direction on track, though that is a separate choice you make afterward.',
  },
  {
    question: `What do I get for ${professionalSessionPrice} as a working professional?`,
    answer:
      'One 1-on-1 session focused on stagnation, AI pressure, a pivot, or a salary-growth decision — aimed at higher-value skills, sharper positioning, and a clearer route toward earlier financial freedom.',
  },
  {
    question: 'Should I start with the free assessments or book the paid session directly?',
    answer:
      'If you are still exploring strengths and preferences and the decision is not urgent, start with the free assessments. If a decision already feels serious, expensive, or delayed by confusion, book the session directly — the assessments are a supporting layer, not a required first step.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so you can join a session from home, college, or work instead of depending on local availability.',
  },
  {
    question: 'Do you guarantee a job after the session?',
    answer: 'No ethical provider can guarantee a job. The session is decision support, not a placement service.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Free Career Counselling Session',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling Session | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.parentGuidance}>Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Free Career Counselling Session</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Free assessments, plus a real 1-on-1 session from {studentSessionPrice}
      </div>

      <h1 class="hero-title">
        Free career counselling session
        <span class="gold-text"> &mdash; here&rsquo;s exactly what&rsquo;s free, and what isn&rsquo;t</span>
      </h1>
      <p class="hero-sub">
        If you searched for a free career counselling session or a trial career counselling session, here is the honest answer: the career and skill assessments at Future Career School are genuinely free. The 1-on-1 counselling session itself is real, paid work with a counsellor &mdash; currently {mixedSessionPriceLine} for a limited time &mdash; because it takes real time to help you build a high-value, high-income skill portfolio and move toward earlier financial freedom, not a scripted call.
      </p>
      <p class="hero-note">
        No hidden pricing, no bait-and-switch "free call." You see the free layer and the real session price here before you book anything.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Book a Student Career Counselling Session</a>
        <a href="#plans" class="btn-outline">Book a Working Professional Session</a>
      </div>
      <p class="hero-support">
        Guidance is delivered fully online across India &mdash; join from home, college, or work.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="free-vs-paid"
    sectionClass="freesession-breakdown-band"
    title="What's actually free, and what's a real paid session"
    subtitle="Both matter. The free layer is genuinely useful on its own. The paid session is where a counsellor works through your specific path, skill direction, and constraints."
    items={freeVsPaidItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={freeVsPaidSummary} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the free layer already gave you enough signal, the low-cost session is the next real step"
    body="The first 1-on-1 is priced to be a low-risk way to test the guidance, not a big commitment."
    studentHref="#plans"
    studentLabel="Book a Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Book a Working Professional Session"
  />

  <BofuFeatureSection
    sectionId="why-not-free"
    sectionClass="freesession-honesty-band"
    variant="decision"
    title="Why there's no free 1-on-1 session, and why that's actually better for you"
    subtitle="A lot of what gets advertised online as a free career counselling session is a short sales call. Here is why Future Career School keeps the free layer and the paid session separate and priced honestly."
    items={whyNoFreeSessionItems}
  >
    <AssessmentSupportNote
      body="The career and skill assessments stay free either way, and can be described as updated, practical, and AI-powered &mdash; unlike many providers who charge thousands for outdated, impractical assessments."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuFeatureSection>

  <BofuFeatureSection
    sectionId="what-a-session-resolves"
    sectionClass="freesession-resolve-band"
    variant="signal"
    title="What a real career counselling session should help you resolve"
    subtitle="Once you move past the free layer, the paid session should do real work &mdash; not repeat what an assessment already told you."
    items={resolveItems}
  />

  <GuidanceModelSection
    title="What the paid 1-on-1 session actually covers"
    subtitle="From strengths and work style to a clearer route toward a high-value skill direction, proof of work, and stronger long-term income growth."
  />

  <AudienceRelevance
    sectionClass="freesession-audience-band"
    title="Why the low-cost first session makes sense for you right now"
    items={audienceItems}
  />

  <ComparisonMatrix
    sectionId="different"
    sectionClass="freesession-comparison-band"
    title="Why the paid session is worth more than a free generic call"
    subtitle="A free call that stays generic will not move your decision forward. A low-cost real session should."
    centered={true}
  />

  <BuyerChecks
    sectionClass="freesession-check-band"
    title="What to check before trusting any 'free career counselling session' offer"
    subtitle="Use these checks on any provider, including this one, before you book."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="See the exact price before you book &mdash; no hidden step, no surprise pitch"
    body={mixedSessionPriceBody}
    studentHref="#plans"
    studentLabel="Book a Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Book a Working Professional Session"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling Session"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See the broader counselling and guidance pages, plus the free assessments, before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="mixed"
    sectionClass="freesession-final-band"
    title="Start with what's free, or go straight to the real session"
    subtitle="Use the free assessments if you are still exploring. Book the low-cost 1-on-1 if the decision already feels serious enough to act on now."
    studentHref="#plans"
    studentLabel="Book a Student Career Counselling Session"
    professionalHref="#plans"
    professionalLabel="Book a Working Professional Session"
  />

  <BofuFaqSection
    title="Questions people ask about free and trial career counselling sessions"
    items={faqItems}
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 88px; }

  :global(.freesession-breakdown-band) {
    background:
      radial-gradient(720px 240px at 10% 0%, rgba(45,212,191,.055), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.008), transparent 50%);
  }
  :global(.freesession-honesty-band) {
    background:
      radial-gradient(720px 260px at 100% 0%, rgba(229,184,74,.065), transparent 72%),
      linear-gradient(180deg, rgba(255,255,255,.012), rgba(255,255,255,.008));
  }
  :global(.freesession-resolve-band) {
    background:
      radial-gradient(620px 220px at 18% 100%, rgba(45,212,191,.05), transparent 72%),
      radial-gradient(560px 220px at 88% 0%, rgba(229,184,74,.05), transparent 72%);
  }
  :global(.freesession-audience-band .section-headline),
  :global(.freesession-comparison-band .section-headline),
  :global(.freesession-check-band .section-headline) {
    max-width: 20ch;
  }
  :global(.freesession-audience-band .audience-grid) {
    max-width: 1080px;
    margin: 0 auto;
    gap: 1.15rem;
  }
  :global(.freesession-audience-band .audience-card) {
    padding: 1.35rem 1.25rem 1.2rem;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.11);
    background:
      radial-gradient(360px 150px at 100% 0%, rgba(45,212,191,.08), transparent 74%),
      linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.014));
    box-shadow: 0 18px 38px rgba(0,0,0,.2);
  }
  :global(.freesession-comparison-band .compare-shell) {
    box-shadow: 0 28px 60px rgba(0,0,0,.3);
  }
  :global(.freesession-check-band .buyer-check-grid) {
    gap: 1.1rem;
  }
  :global(.freesession-check-band .buyer-check-card) {
    min-height: 100%;
  }
  :global(.freesession-final-band .final-sub) {
    max-width: 52ch;
  }

  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold {
    width: 520px;
    height: 520px;
    top: -170px;
    left: -110px;
    background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%);
  }
  .orb-teal {
    width: 420px;
    height: 420px;
    top: -40px;
    right: -120px;
    background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,.38);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill {
    width: fit-content;
    max-width: min(100%, 46rem);
    margin-bottom: 1.6rem;
    white-space: normal;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.15rem, 4.7vw, 3.7rem);
    line-height: 1.08;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub {
    font-size: clamp(15px, 1.95vw, 18px);
    color: rgba(255,255,255,.72);
    line-height: 1.88;
    max-width: 820px;
    margin-bottom: 1rem;
  }
  .hero-note {
    font-size: 14px;
    color: rgba(255,255,255,.56);
    line-height: 1.8;
    max-width: 780px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-actions .btn-gold,
  .hero-actions .btn-outline {
    min-width: min(100%, 300px);
    justify-content: center;
  }
  .hero-support {
    font-size: 14px;
    color: rgba(255,255,255,.58);
    line-height: 1.8;
    max-width: 720px;
    margin-top: 1rem;
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.74rem, 9.2vw, 2.4rem);
      line-height: 1.08;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (max-width: 430px) {
    .breadcrumb {
      gap: 6px;
      font-size: 12px;
      margin-bottom: 1.5rem;
    }
    .hero-sub,
    .hero-note,
    .hero-support {
      line-height: 1.76;
    }
    :global(.freesession-audience-band .audience-card) {
      padding: 1.08rem 1rem .98rem;
      border-radius: 20px;
    }
  }
</style>
