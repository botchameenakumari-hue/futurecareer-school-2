---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import {
  BOFU_ASSESSMENT_LINKS,
  BOFU_COMPARISON_LIBRARY,
} from '../../../../config/bofu';

const title = 'Hire a Career Coach | Credentials, Process, and What You Get | Future Career School';
const description =
  'Hire a career coach the way you would evaluate any real hire: check credentials, understand the process, then commit. Online across India, with a clear path toward stronger skill direction and earlier financial freedom.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/hire-a-career-coach/';

const comparisonRows = [
  BOFU_COMPARISON_LIBRARY[0],
  BOFU_COMPARISON_LIBRARY[1],
  BOFU_COMPARISON_LIBRARY[2],
  BOFU_COMPARISON_LIBRARY[3],
];

const hiringCheckItems = [
  {
    title: 'Check credentials, not just confidence',
    body: 'Ask what the coach actually assesses before recommending anything — strengths, work style, and market fit — instead of relying on a persuasive sales call alone.',
  },
  {
    title: 'Check whether the first session builds a real profile of you',
    body: 'A coach worth hiring should map your specific stage, pressure, and constraints first. If the advice sounds identical to what a friend already told you, the process skipped a step.',
  },
  {
    title: 'Check what you actually walk away with',
    body: 'After you hire someone, you should have clearer skill direction and a next move you can act on, not just an hour of conversation and general encouragement.',
  },
  {
    title: 'Check the real price and what continues afterward',
    body: 'Confirm the exact session price and what happens after the first session before you commit, so there is no unclear billing or pressure into a bigger package later.',
  },
];

const hiringProcessItems = [
  {
    title: 'Tell us your stage and the decision that is stuck',
    body: 'School, college, fresher, or working professional — hiring starts with your real situation, not a generic intake form.',
  },
  {
    title: 'Get matched to the right guidance path',
    body: 'Student or working-professional track, chosen based on your goals and profile instead of a one-size script used for everyone.',
  },
  {
    title: 'First 1-on-1 session: profile, strengths, and market-fit mapping',
    body: 'This is where the actual evaluation happens — psychometric input, work-style mapping, and honest feedback before any bigger commitment.',
  },
  {
    title: 'Leave with a specific next step',
    body: 'Clearer skill direction, a proof-of-work plan, and next actions you can use immediately, instead of vague motivation.',
  },
  {
    title: 'Continue only if it is genuinely useful',
    body: 'Students can move into ongoing small-group guidance; working professionals can book further sessions when the next decision comes up. Nothing is forced.',
  },
];

const objectionItems = [
  {
    title: 'How do I know this coach is actually qualified?',
    body: 'The first session includes a structured psychometric assessment and profile mapping, not just an opinion. That is the evaluation layer most freelance coaches skip.',
  },
  {
    title: 'What if I hire someone and it turns out to be generic advice?',
    body: 'That risk is exactly why the process starts with your specific stage and pressure. Guidance should push toward higher-value skill direction and proof of work, not repeat public advice in nicer language.',
  },
  {
    title: 'Do I have to commit to a big package before I know if it works?',
    body: 'No. You can hire for a single 1-on-1 session first. Students can move into ongoing group guidance afterward if it is genuinely useful; professionals can book further sessions only when the next decision comes up.',
  },
  {
    title: 'How is this different from hiring a random freelance coach off a marketplace?',
    body: 'The process is structured: a real assessment layer, profile mapping, a defined next step, and free, updated, practical, AI-powered career and skill assessments instead of a one-off paid conversation.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity from session one',
    listItems: [
      'Initial psychometric assessment and career counselling',
      'Profile and stage mapping before any recommendation',
      'Direction based on fit, market reality, and risk',
      'A practical next step instead of a generic pep talk',
    ],
  },
  {
    title: 'A specific plan, not a generic script',
    listItems: [
      'Personalised long-term career plan',
      'High-value skill selection and decision leverage',
      'Skill-path shortlisting before expensive commitments',
      'A guidance path chosen for your goals and profile',
    ],
  },
  {
    title: 'Leverage that continues after the first session',
    listItems: [
      'Portfolio proof, personal branding, and tech leverage guidance',
      'Proof of work that improves market credibility',
      'Clearer positioning beyond degree dependence alone',
      'Earlier financial freedom planning through stronger skill choices',
    ],
  },
];

const faqItems = [
  {
    question: 'What should I check before I hire a career coach?',
    answer:
      'Check credentials over confidence, whether the first session actually maps your profile instead of giving generic talk, what you walk away with, and the real price of what continues afterward. Compare those before comparing anything else.',
  },
  {
    question: 'What happens in the first session after I hire a coach here?',
    answer:
      'The first session includes psychometric assessment and career counselling, profile and stage mapping, and direction based on fit, market reality, and risk — followed by a practical next step instead of generic advice.',
  },
  {
    question: 'Do I have to sign up for a long-term package to hire a coach?',
    answer:
      'No. You can hire for a single 1-on-1 session first. Students can move into ongoing small-group guidance afterward if it is genuinely useful; working professionals can book further sessions only when a new decision comes up.',
  },
  {
    question: 'Is hiring a career coach different from career counselling or career guidance?',
    answer:
      'In practice, career coaching, career counselling, career guidance, and career strategy are used to mean the same practical thing: clearer decisions and stronger skill direction. The label matters less than whether the process improves your decisions and moves you toward higher-value skills and income growth.',
  },
  {
    question: 'Are the free assessments part of what I get when I hire a coach?',
    answer:
      'Yes, as a starting layer. Career and skill assessments are fully free, updated, practical, and AI-powered. Many providers charge thousands for outdated or impractical assessments; a paid 1-on-1 session is separate counsellor time spent on your specific situation.',
  },
  {
    question: 'Do you guarantee outcomes when I hire a coach?',
    answer:
      'No ethical provider can guarantee a job or a specific income outcome. What you can expect is a structured process, honest feedback, and a clearer route toward achieving earlier financial freedom through stronger skill choices.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const relatedDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step career decisions beyond a single hiring decision.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coach-near-me',
    title: 'Career Coach Near Me',
    description: 'If proximity is also part of your search, see how online delivery across India compares to a nearby-only option.',
  },
  {
    href: '/services/assessments',
    title: 'Free Assessments',
    description: 'Try the free, updated, practical, AI-powered assessments before you commit to hiring a coach.',
  },
  {
    href: '/career-skills-compass',
    title: 'Career & Skills Compass',
    description: 'Explore high-value skill direction on your own before a bigger hiring decision.',
  },
  {
    href: '/career-resources/high-income-skills-for-the-next-decade',
    title: 'High-Income Skills Guide',
    description: 'See which skills are worth building before you hire a coach to help you choose a direction.',
  },
  {
    href: '/blog/career-guidance/how-to-find-the-right-career-for-me-india',
    title: 'How to Find the Right Career',
    description: 'A practical framework for the same decision a coach would help you work through.',
  },
  {
    href: '/locations',
    title: 'Locations',
    description: 'See the online-first, city-aware service footprint across India.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Hire a Career Coach',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Hire a Career Coach | Future Career School',
    description:
      'Hire a career coach for students, freshers, and working professionals through a structured process: credentials, profile mapping, a clear next step, and a route toward stronger skill direction and earlier financial freedom.',
    url: canonical,
    serviceType: 'Career Coaching and Career Guidance',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Hire a Career Coach</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Evaluated like a real hiring decision, not an impulse booking.
      </div>

      <h1 class="hero-title">
        Hire a career coach
        <span class="gold-text"> the way you would evaluate any real hire</span>
      </h1>
      <p class="hero-sub">
        When you decide to hire a career coach, you are not just booking a chat. You are making a hiring
        decision that deserves the same scrutiny as any other: credentials, process, and what you actually
        walk away with. Future Career School is built to be judged on exactly those terms, with sessions
        delivered fully online across India.
      </p>
      <p class="hero-note">
        The right hire should move you toward a high-value skill portfolio and a clearer route to earlier
        financial freedom, not just a pleasant conversation that ends without a next step.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Hire Your Student Career Coach</a>
        <a href="#plans" class="btn-outline">Hire Your Working Professional Career Coach</a>
      </div>
      <p class="hero-support">
        Check credentials and process below, then hire with a clear picture of what happens next.
      </p>
    </div>
  </section>

  <BuyerChecks
    sectionId="hiring-checks"
    title="What to look for before you hire a career coach"
    subtitle="Do not compare coaches on price or personality alone. The stronger comparison is whether the process is structured enough to actually improve your decisions."
    items={hiringCheckItems}
  />

  <BofuStepFlowSection
    sectionId="hiring-process"
    title="What actually happens once you hire"
    subtitle="Hiring a career coach here follows a defined process, not a single open-ended call."
    items={hiringProcessItems}
  />

  <ComparisonMatrix
    sectionId="different"
    title="What you are really hiring: generic advice or structured decision support"
    subtitle="This is the honest comparison to make before you hire anyone, here or elsewhere."
    rows={comparisonRows}
  />

  <BofuListCardSection
    sectionId="what-you-get"
    title="What you get once you hire a career coach here"
    subtitle="The value of hiring the right coach is not the hour itself. It is better path decisions, higher-value skill direction, proof of work, and clearer income-growth direction afterward."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="Before you hire, the free career and skill assessments can surface your strengths and work style at no cost — a useful first signal before a paid session."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <GuidanceModelSection />

  <BofuFeatureSection
    sectionId="objections"
    title="Objections people have before they hire"
    items={objectionItems}
    variant="signal"
  />

  <AudienceRelevance title="Who should actually hire a career coach right now" />

  <ContextualCta
    audience="mixed"
    title="If the decision already feels serious enough to hire help, hire on the right criteria"
    body="Credentials, process, and a clear next step matter more than convenience or a persuasive pitch."
    studentHref="#plans"
    studentLabel="Hire Your Student Career Coach"
    professionalHref="#plans"
    professionalLabel="Hire Your Working Professional Career Coach"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Coaching"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore related help"
    subtitle="See other guidance pages, assessments, tools, and useful reading before you hire."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <BofuFaqSection title="Questions people ask before they hire a career coach" items={faqItems} />

  <FinalCta
    audience="mixed"
    title="Hire with a clear picture of what happens next"
    subtitle="Move forward once credentials and process check out — that is a stronger route toward earlier financial freedom than another open-ended conversation."
    studentHref="#plans"
    studentLabel="Hire Your Student Career Coach"
    professionalHref="#plans"
    professionalLabel="Hire Your Working Professional Career Coach"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-you-get,
  #different,
  #related-links { background: rgba(255,255,255,.012); }

  #hiring-process,
  #hiring-checks { background: rgba(255,255,255,.008); }

  @media (max-width: 680px) {
    #hero { padding: 118px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline,
    .hero-actions .btn-soft { justify-content: center; }
  }
</style>
