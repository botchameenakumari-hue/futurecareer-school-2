---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../components/bofu/BofuListCardSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Guidance After 10th | Choose the Direction, Not Just the Stream | Future Career School';
const description =
  'Career guidance after 10th for students and parents: compare Science, Commerce, Arts, diploma and ITI by the work they lead to, and start building skills that open better income options.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-after-10th/';

const streamSelectorUrl = BOFU_ASSESSMENT_LINKS.streamSelectorAfter10th;
const afterTenthCounsellingUrl =
  '/services/career-counselling-and-career-guidance/career-counselling-after-10th/';

const questionItems = [
  {
    eyebrow: 'Most searched',
    title: '"Which stream pays fastest?"',
    body: 'Pay follows the skill you build and the proof you can show far more than the stream label. A student who picks the "highest-paying" stream without fit usually spends two years disengaged and starts building real skill late, which is the expensive part.',
    listItems: ['Better question: which work can I do for years without dreading it?'],
  },
  {
    eyebrow: 'Family advice',
    title: '"Take Science now, change later if you want."',
    body: 'Science does keep engineering and medical routes open, and changing later is possible. The cost is two years of subjects the student may not enjoy, plus fresh choices after 12th. Whether that trade is worth it depends on honest interest in Maths or Biology.',
    listItems: ['Better question: would this student still show up for these subjects on a bad week?'],
  },
  {
    eyebrow: 'Logistics fog',
    title: '"Which school, which forms, which exams?"',
    body: 'State boards, CBSE, NIOS, junior colleges, polytechnic entrance and ITI admissions all run on different calendars. Fix the direction first, then fill the right forms and check exact dates on the board or state portal.',
    listItems: ['Better question: what do I want this route to lead to by 12th?'],
  },
  {
    eyebrow: 'Beyond the big three',
    title: '"Is there anything apart from Science, Commerce and Arts?"',
    body: 'Yes. Diploma (polytechnic), ITI, NIOS and vocational routes are real options with their own seats and next steps. A diploma can even lead to second-year B.E./B.Tech entry. Fit decides, not prestige.',
    listItems: ['Better question: which route builds a skill I can show by 17?'],
  },
  {
    eyebrow: 'Language worry',
    title: 'A bright student, nervous about English',
    body: 'Regional-medium students often assume the stream or the career is out of reach. Language discomfort is not low ability. Understand the work, do the work, explain it, then improve the English around it. Bilingual progress counts.',
  },
  {
    eyebrow: 'Thin runway',
    title: 'A family with one earning member',
    body: 'Prestige is expensive when the family cannot afford a second try. Hostel, coaching, relocation, repeat attempts and time to first income all belong in the comparison, not only the school fee.',
  },
];

const beliefRows = [
  {
    belief: 'Science keeps every door open',
    holds: 'It keeps engineering (PCM) and medical (PCB) routes open, along with many degree options. It does not help a student who stops engaging with the subjects. Two disengaged years close doors too.',
    check: 'Test honest interest in Maths or Biology and study stamina before admission, not after.',
  },
  {
    belief: 'Basic Maths in Class 10 means no Maths in 11th',
    holds: 'CBSE has relaxed this rule again and again. In recent sessions, Basic Maths students could opt for Mathematics in Class 11 if the school is satisfied about aptitude. The relaxation has been temporary and re-issued session by session.',
    check: 'Ask the school for the rule that applies to your session, in writing.',
  },
  {
    belief: 'Foundation coaching from now is the safe choice',
    holds: 'The Ministry of Education\'s 2024 coaching guidelines say centres should not enrol students under 16 or before secondary school exams are done. CBSE has also warned that "dummy school" enrolment without attending can cost students their Class 12 board eligibility, with 75% attendance as the norm.',
    check: 'Check the school attendance rule and the real cost of the coaching plan in time, fees and energy.',
  },
  {
    belief: 'Diploma and ITI are for students who missed Science',
    holds: 'They are structured routes with their own seat pools. For 2026, Andhra Pradesh alone lists about 82,870 polytechnic seats across 267 institutions, and the Directorate General of Training lists over 13,000 ITIs. AICTE norms allow diploma holders with the required marks to join second-year B.E./B.Tech.',
    check: 'Compare the branch or trade by the work, the next step (job, apprenticeship or degree) and the cut-offs for your state.',
  },
  {
    belief: 'The stream decides your income',
    holds: 'Skills move faster than streams. The World Economic Forum expects about 39% of workers\' core skills to change or go out of date between 2025 and 2030, with analytical thinking, technology literacy and resilience among the most sought-after.',
    check: 'Ask which skills you will stack on top of any stream, and what proof you could show by 12th.',
  },
  {
    belief: 'A low result closes the options',
    holds: 'CBSE Class 10 now has an optional second board exam (held 15 to 21 May in 2026) in up to three subjects, with the better score per subject counted. State boards run their own supplementary or improvement systems.',
    check: 'Learn your board\'s improvement rules before a panic choice is made.',
  },
];

const processItems = [
  {
    title: 'Strengths and working style first, marks second',
    body: 'Marks say how a student did in one exam pattern. Guidance looks at what the student is good at, how they like to work, and what they keep coming back to when nobody is grading.',
  },
  {
    title: 'See the work, including the boring 80%',
    body: 'A title like "engineer" or "CA" hides what a Tuesday looks like. Students compare paths by the daily tasks, the stamina needed and the proof each path demands, not by how impressive the word sounds at a family function.',
  },
  {
    title: 'Market fit and skill direction',
    body: 'Next comes what the market pays for and which high-value skills sit on top of the chosen route. The aim is a deliberate skill portfolio, not one lucky pick.',
  },
  {
    title: 'A route, a backup and a family conversation',
    body: 'The output is a route the student and parents can both defend, with a backup if the first choice stumbles, and the words to explain it at home.',
  },
];

const skillItems = [
  {
    eyebrow: 'Digital floor',
    title: 'Typing, documents, slides, spreadsheets, safe AI use',
    body: 'Every stream now needs this floor. AI helps only if the student can still explain what was built and check the output.',
    listItems: ['Proof: one spreadsheet chart on a topic they care about, with two lines on what it shows'],
  },
  {
    eyebrow: 'English as multiplier',
    title: 'Short, regular practice beats occasional long bursts',
    body: 'English widens internships, networks and later leadership options. It is a trainable access skill, not an intelligence test.',
    listItems: ['Proof: a one-minute voice note explaining a school project simply'],
  },
  {
    eyebrow: 'One finished thing',
    title: 'A small project, completed and shown',
    body: 'A simple webpage, a mini Python script, a school event run well, a short explainer video. One finished piece beats five started ones.',
    listItems: ['Proof: something another person can open, read or watch'],
  },
  {
    eyebrow: 'Real-work exposure',
    title: 'One conversation with someone who does the work',
    body: 'A single call with a practitioner beats twenty opinions from relatives who have never done the job. Many students have seen only four careers before they choose.',
    listItems: ['Proof: five lines of notes on what surprised them'],
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Random upskilling that compounds slowly',
    right: 'Clearer skill direction tied to growth and income upside',
  },
];

const parentItems = [
  {
    title: 'Improve the decision, do not replace it',
    body: 'The parent\'s job is to raise the quality of the choice, not to make it. A student who is talked into a stream rarely defends it in month six.',
  },
  {
    title: 'Judge the cost beyond the fee',
    body: 'Add hostel, coaching, relocation, repeat attempts and the years before a first income. A path that looks prestigious can be the riskiest one for a thin family runway.',
  },
  {
    title: 'Ask what can be finished, not only what sounds safe',
    body: '"What can you finish this month?" and "What makes this path safer?" get further than "Which college name will we tell relatives?"',
  },
  {
    title: 'Mind the group-chat effect',
    body: 'Parent groups can multiply fear faster than they improve judgement. Someone else\'s child in a heavy coaching schedule is not evidence for yours.',
  },
];

const buyerCheckItems = [
  {
    title: 'Ask where an outcome percentage comes from',
    body: 'Claims like "most students follow the path we recommend" mean little without a method behind them. Ethical providers do not guarantee admissions, jobs or income.',
  },
  {
    title: 'Check that one test is not treated as the verdict',
    body: 'A report is a signal, not a sentence. Good guidance uses assessment results alongside conversation, marks, interests and family reality.',
  },
  {
    title: 'Check that the plan reaches past the stream',
    body: 'If the output is only "take Commerce", something is missing: skills to build, proof to show by 12th, and a backup if the first route stumbles.',
  },
  {
    title: 'Check whether the fee buys direction or only a report',
    body: 'Many providers charge thousands for a stream report and stop there. Ask what happens after the report: who explains it, who helps with skills and proof of work, and what the family walks away with.',
  },
];

const relatedDirectoryItems = [
  {
    href: afterTenthCounsellingUrl,
    title: 'Career Counselling After 10th',
    description:
      'For the result-week choice between 11th, a diploma or an ITI, when the admission window is already open and the decision has to be made in days.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling-for-class-10-students/',
    title: 'Career Counselling for Class 10 Students',
    description: 'For families who want to work through the stream question before the board result arrives.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'For when the question moves from stream to course, college and entrance exam.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader guidance for school, college and first skill-direction decisions.',
  },
  {
    href: '/blog/stream-selection/career-options-after-10th/',
    title: 'Career Options After 10th',
    description: 'A practical read on what Science, Commerce, Arts, diploma and ITI routes lead to.',
  },
  {
    href: '/blog/stream-selection/which-stream-to-choose-in-11th/',
    title: 'Which Stream to Choose in 11th',
    description: 'A fuller stream-selection framework if 11th is the direction you are leaning toward.',
  },
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'Looking for support in your own city? Find your city among the location pages.',
  },
];

const faqItems = [
  {
    question: 'What does career guidance after 10th cover that a stream test does not?',
    answer:
      'A stream test gives one signal. Guidance turns that signal into a direction: which work fits, which skills to stack on top of the route, what proof to build by 12th, and how to explain the choice at home. It also covers routes a simple Science-Commerce-Arts test can miss, such as diploma, ITI and NIOS.',
  },
  {
    question: 'Is it too early to start before the 10th result?',
    answer:
      'No. The direction question does not depend on the result. Starting early leaves room to explore the work, try a small project and talk to someone in the field, so the form-filling week is not the first time anyone thinks about it.',
  },
  {
    question: 'My child scored lower than expected. Are the options gone?',
    answer:
      'No. CBSE now offers an optional second board exam in up to three subjects, with the better score counted, and state boards have their own improvement or supplementary rules. Diploma, ITI and NIOS routes also stay open. One result is a data point, not a verdict.',
  },
  {
    question: 'My child took Basic Maths. Can they still take Maths in 11th?',
    answer:
      'CBSE has allowed this in recent sessions through a relaxation, provided the school is satisfied about aptitude. The relaxation has been renewed session by session, so ask the school for the rule that applies to your year before you plan around it.',
  },
  {
    question: 'Do we need foundation coaching for JEE or NEET from now?',
    answer:
      'Not automatically. Ministry of Education guidelines say coaching centres should not enrol students under 16 or before they finish secondary exams, and skipping regular school attendance can put board eligibility at risk. Decide whether the exam route genuinely fits the student first, then choose the coaching and school combination.',
  },
  {
    question: 'Can we change stream after starting 11th?',
    answer:
      'Some schools allow a subject or stream change only in the first weeks or months of the session, and rules differ by board and school. Ask the school for its last date in writing before admission, and treat a change as a backup, not a plan.',
  },
  {
    question: 'How is career guidance after 10th different from career counselling after 10th?',
    answer:
      'The support is the same practical service. What differs is the decision in front of you. Guidance after 10th deals with the wider direction question that stays open for years: work, skills and proof alongside the stream. Career counselling after 10th is built around the result-week admission choice between 11th, diploma and ITI.',
  },
  {
    question: 'Are the after-10th assessments free, and is this available online across India?',
    answer:
      'Yes to both. The career and skill assessments, including the stream selector, are fully free and can be described as updated, practical and AI-powered. Guidance is delivered online across India, so students and parents can join from home.',
  },
  {
    question: 'Can you guarantee a seat, a job or a high income?',
    answer:
      'No, and be careful with anyone who does. Guidance improves the quality of the decision and points the student toward a high-value skill portfolio. Effort, proof of work and the market do the rest.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Guidance After 10th', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance After 10th | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Guidance After 10th',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance After 10th</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career guidance after 10th: direction first, stream second
      </div>

      <h1 class="hero-title">
        Career guidance after 10th
        <span class="gold-text"> that starts from the work you want, not the stream form</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career guidance after 10th for students and parents who want a direction they can defend, not just a Science, Commerce or Arts tick-box. We help you compare paths by the work they lead to, then choose the skills to build alongside them. The goal is a high-value skill portfolio that opens high income opportunities and moves you toward earlier financial freedom, instead of two years lost on the wrong stream.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so students and parents can join from home, before or after the result.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Guidance After 10th for Students</a>
      </div>
      <p class="hero-support">
        You do not need to pick a lifelong career at 15. You do need to stop drifting, and to know which skills the next two years will build.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="questions-families-ask"
    title="The questions Class 10 households actually ask"
    subtitle="Most of them sound like stream questions. Underneath, they are about high income opportunities, effort and risk, and the answer changes once you ask the better version."
    items={questionItems}
    columns={3}
    variant="audience"
  />

  <section id="belief-check" class="belief-check">
    <div class="container">
      <h2 class="section-headline">Six beliefs to check before any form is filled</h2>
      <p class="section-sub">
        Each of these is repeated in family chats and coaching pitches. Some hold, some only partly, and some have changed recently.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>What you hear</th>
              <th>What holds up</th>
              <th>Check this first</th>
            </tr>
          </thead>
          <tbody>
            {beliefRows.map((row) => (
              <tr>
                <td data-label="What you hear">{row.belief}</td>
                <td data-label="What holds up">{row.holds}</td>
                <td data-label="Check this first">{row.check}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Boards, seat counts and relaxations change from year to year. Confirm the current rule with your school, board or state portal before you decide.
      </p>
    </div>
  </section>

  <ContextualCta
    audience="student"
    title="Get a direction you can defend before the forms go in"
    body="A wrong stream costs more than fees. It costs two years of skill-building that could have started on day one."
    studentHref="#plans"
    studentLabel="Get Career Guidance After 10th for Students"
  />

  <BofuStepFlowSection
    sectionId="how-guidance-works"
    title="How career guidance after 10th moves from confusion to a route"
    subtitle="It starts with clarity on strengths, work style and market fit, then moves to skill direction, proof of work and a plan the family can back."
    items={processItems}
  >
    <AssessmentSupportNote
      body="As a starting point, the free after-10th stream selector can surface early signals on working style and path fit before the guidance conversation."
      href={streamSelectorUrl}
      label="Free career and skill assessments"
    />
  </BofuStepFlowSection>

  <BofuListCardSection
    sectionId="build-alongside"
    title="What a Class 10 student can build alongside any stream"
    subtitle="Skills change faster than streams. The World Economic Forum's 2025 jobs report expects about 39% of core skills to change by 2030. A small, visible skill base started now is what compounds."
    items={skillItems}
    columns={2}
    variant="contrast"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why direction beats a stream label"
    subtitle="Degrees and streams have a place. Choosing one without building skills alongside it is the problem."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="for-parents"
    title="For parents: how to help without taking over"
    items={parentItems}
    variant="decision"
    columns={2}
  />

  <BuyerChecks
    title="What to check before paying for career guidance after 10th"
    subtitle="Guidance for a 15-year-old should leave the whole family clearer, not just hand over a report."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Choose the route on fit and skill, not on group-chat pressure"
    body="Start with a conversation about the student's strengths, the work they may enjoy and the skills worth building next."
    studentHref="#plans"
    studentLabel="Get Career Guidance After 10th for Students"
  />

  <GuidancePlansSection audience="student" serviceLabel="Career Guidance After 10th" />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See the result-week admission decision, the earlier stream conversation, broader student guidance and practical reading."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Give the next two years a direction"
    subtitle="Career guidance after 10th helps you pick a route for fit, then build the skill portfolio that opens high income opportunities and moves toward earlier financial freedom, instead of finding out in 12th that the stream was a guess."
    studentHref="#plans"
    studentLabel="Get Career Guidance After 10th for Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.75rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  .belief-check { padding: 5rem 0; background: rgba(255,255,255,.012); }
  .table-wrap {
    margin: 1.2rem 0 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.09);
  }
  table { width: 100%; border-collapse: collapse; min-width: 640px; }
  th, td {
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,.08);
    padding: 14px 14px;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255,255,255,.74);
    vertical-align: top;
  }
  th { font-family: "Sora", sans-serif; color: #fff; font-weight: 700; }
  td:first-child { color: #fff; font-weight: 700; width: 22%; }
  tbody tr:nth-child(4n+1) td:first-child { border-left: 3px solid rgba(45,212,191,.7); }
  tbody tr:nth-child(4n+2) td:first-child { border-left: 3px solid rgba(229,184,74,.8); }
