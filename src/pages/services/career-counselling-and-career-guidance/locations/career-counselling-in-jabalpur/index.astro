---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: all 15 two-row drops are already claimed by existing
// siblings (see the tracking note in career-counselling-in-agra/index.astro).
// This page uses the unused three-row drop (2, 3, 4), keeping rows 0, 1, and
// 5 - the rows most relevant to the ordnance-manufacturing-vs-judiciary
// fork below. Verified against every sibling file before publishing.
const jabalpurComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 2 && index !== 3 && index !== 4,
);

const title =
  'Career Counselling in Jabalpur | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Jabalpur for students, freshers, and working professionals weighing the ordnance-factory defence-manufacturing economy against the Madhya Pradesh High Court's law and judiciary path, or the Bhedaghat marble-rocks tourism economy.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-jabalpur/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before committing to an ordnance-factory trade or engineering role, a law and judiciary path, or a Bhedaghat tourism-linked business.',
      "You want something more practical than a relative's opinion or a coaching-centre pitch about which exam to attempt.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const ordnanceEconomyItems = [
  {
    title: "Jabalpur runs a genuinely unique economy: one of India's largest defence-ordnance manufacturing clusters",
    body: "Jabalpur hosts several major ordnance and defence-production units, including gun-carriage, vehicle-factory, and foundry operations, making it one of the country's most concentrated defence-manufacturing hubs in a single city. That creates a specific career fork a generic guidance page never addresses: whether to pursue formal ITI, diploma, or engineering routes into apprenticeship, technical, or supervisory roles across this defence-manufacturing base, or build a different skill path while family or local ties to the ordnance economy stay in the background.",
  },
  {
    title: 'Formal trade and engineering certification beats informal exposure alone',
    body: "A career built around Jabalpur's ordnance-manufacturing economy still benefits from real ITI, diploma, or engineering qualification - not just growing up near the factories. Building a genuine skill and certification layer, rather than assuming local familiarity is enough on its own, is what actually moves someone toward a stronger role and earlier financial freedom from here.",
  },
];

const ordnanceEconomySummaryItems = [
  {
    title: 'This concentration is specific to Jabalpur',
    body: 'Very few Indian cities carry this density of ordnance and defence-production units in one place - it deserves a direct, specific answer, not a generic manufacturing mention.',
  },
];

const judiciaryEconomyItems = [
  {
    title: 'A second, genuinely distinct economy: the Madhya Pradesh High Court and the legal profession',
    listItems: [
      'The Madhya Pradesh High Court is seated in Jabalpur rather than the state capital, Bhopal, which has built a real, sizeable legal profession and law-student ecosystem around the city',
      'Many local families weigh an LLB and litigation path, a judicial-services exam attempt, or corporate and government legal roles as serious, credible options',
      'Judicial-services preparation is a genuine multi-year commitment that deserves the same structured planning as any competitive exam path',
      'A legal career in Jabalpur can mean litigation, judicial services, or roles supporting the High Court and its associated institutions, each with different preparation needs',
    ],
  },
  {
    title: 'What deliberate planning can add to a legal-career decision',
    listItems: [
      'Clarity on litigation versus judicial-services versus corporate-legal paths early prevents years of unfocused preparation',
      'An honest look at exam competition levels and realistic timelines protects against over-committing to one attempt cycle',
      'Legal-research, drafting, and digital-practice-management skills increasingly matter even inside traditional litigation practice',
      'For those choosing the ordnance-manufacturing track instead, the same high-value skill portfolio logic applies: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const judiciaryEconomySummaryItems = [
  {
    title: 'Two real, unrelated local economies, one decision',
    body: "The ordnance-manufacturing economy and the High Court's legal-profession economy coexist in Jabalpur without overlapping - the useful question is which one, if either, actually fits your situation.",
  },
];

const areaItems = [
  {
    title: 'The cantonment and factory belt carries the defence-manufacturing economy',
    body: 'The areas around the ordnance and vehicle-factory units, including the cantonment zones, carry the ITI, technical, and supervisory-role economy described above.',
  },
  {
    title: 'The High Court and civil-lines area carries the legal-profession economy',
    body: 'The neighbourhoods around the Madhya Pradesh High Court and the district courts carry the litigation, judicial-services, and legal-support economy.',
  },
  {
    title: 'Bhedaghat and the Narmada belt carry a real marble-rocks tourism economy',
    body: 'The Bhedaghat marble-rocks gorge and the Dhuandhar Falls area on the Narmada river support a genuine, if smaller, tourism, boating, and hospitality economy worth weighing for families connected to it.',
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh a defence-manufacturing trade role, a legal-profession path, or a tourism-linked business before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the city search to reduce hesitation, not because the city itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'A judicial-services preparation timeline or a family trade tie matters more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the city label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether an ITI, diploma, or engineering path into the ordnance-manufacturing economy fits your actual strengths',
      'Whether a law and judiciary path, given the High Court seat, is genuinely the stronger route for your situation',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Jabalpur's actual economy",
    listItems: [
      'ITI, diploma, or engineering-trade skills if the defence-manufacturing economy fits your situation',
      'A structured litigation, judicial-services, or corporate-legal preparation plan if the legal profession fits your situation better',
      'Hospitality or small-business skills if a Bhedaghat tourism-linked opportunity is part of the picture',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, hostel, workshop, or law-college library',
    body: 'Career counselling is available online in Jabalpur and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family and mentor conversations, not compete with them',
    body: 'When a defence-manufacturing family tie or a judicial-services preparation timeline is part of the picture, the harder conversations often need to include family or mentors. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: "A nearby or well-known option can still leave you with generic advice that ignores Jabalpur's specific ordnance-manufacturing or High Court context. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.",
  },
];

const objectionItems = [
  {
    title: 'Should I pursue an ITI or engineering trade toward the ordnance factories, or aim for a different technical career?',
    body: "That depends on the specific role and skill behind it - a formal ITI, diploma, or engineering qualification built with the ordnance-manufacturing base in mind can be a genuinely strong path. Relying on informal local familiarity, without a certification plan, is a weaker bet than it looks.",
  },
  {
    title: 'I am preparing for law or judicial services because Jabalpur has the High Court - is that still a good reason to choose this path?',
    body: 'The High Court being local can be a genuine advantage for exposure and opportunity, but the career choice itself should still rest on your own aptitude and honest exam-competition timelines, not on proximity alone.',
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In a city where a defence-manufacturing trade and a legal-profession path can each look equally serious, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is a trade-certification decision, a judicial-services preparation plan, a tourism-linked opportunity, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: a wrong stream, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, family expectations, exam-attempt limits, and location ties early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Jabalpur's dual defence-and-judiciary economy",
    body: 'Ordnance-factory trades and the High Court legal profession are two real, distinct local paths with their own preparation needs. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a judicial-services attempt gets an honest, structured answer',
    body: 'Good guidance should help you plan a judicial-services or litigation path with realistic timelines and a backup plan, not treat it as a guaranteed outcome simply because the High Court is local.',
  },
  {
    title: 'Check whether the next move fits your Jabalpur reality realistically',
    body: 'Good guidance for Jabalpur should be realistic about trade-certification timelines, exam competition, and family expectations, and what skill-building genuinely works given your specific situation.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.kanpurCounselling,
    title: 'Career Counselling in Kanpur',
    description: "See Kanpur's page if an Ordnance Factory or defence-PSU career elsewhere is closer to your situation than Jabalpur's specific ordnance-and-judiciary fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Jabalpur instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from home, hostel, or workshop without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'Can career counselling help me plan a trade or engineering path into the ordnance factories?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - which ITI, diploma, or engineering route actually fits the roles available, what the realistic growth path looks like, and whether it fits your strengths.",
  },
  {
    question: 'I am preparing for judicial services or law because the High Court is in Jabalpur. Should counselling assume that is the right path?',
    answer:
      "No. Good counselling should treat a law or judicial-services path as a real, serious option worth structured planning, including honest timelines and a backup plan, rather than assuming it is right simply because the High Court is local.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Jabalpur?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Jabalpur users.',
  },
  {
    question: 'Do you guarantee a government job, an ordnance-factory posting, or a judicial-services result?',
    answer:
      'No ethical provider can guarantee any of these outcomes. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Jabalpur',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Jabalpur | Future Career School',
    description:
      'Career counselling in Jabalpur for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: 'Jabalpur' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Jabalpur</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Jabalpur
      </div>

      <h1 class="hero-title">
        Career counselling in Jabalpur
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Jabalpur hands many people a genuinely different fork than most Indian cities: one of the country's largest concentrations of ordnance and defence-manufacturing units, running alongside a real legal-profession economy built around the Madhya Pradesh High Court's seat here rather than in the state capital. Most career advice available online is written for a single generic city and misses both, along with the smaller Bhedaghat marble-rocks tourism economy on the Narmada. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Jabalpur and across India. You can start from home, hostel, workshop, or law-college library - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Jabalpur. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Jabalpur search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="ordnance-economy"
    title="The ordnance-manufacturing economy is Jabalpur's first real fork"
    subtitle="No other Indian city sibling carries this density of defence-production units - it deserves a specific answer, not a generic manufacturing mention."
    items={ordnanceEconomyItems}
    variant="decision"
  >
    <BofuSummaryStrip items={ordnanceEconomySummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="judiciary-economy"
    title="The High Court and the legal profession: a second, genuinely different economy"
    subtitle="A real professional economy under its own pressures, and a genuine choice between it and the ordnance-manufacturing base."
    items={judiciaryEconomyItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={judiciaryEconomySummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="jabalpur-areas"
    title="Jabalpur's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Jabalpur, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Jabalpur-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a city where a defence-manufacturing trade and a legal-profession path can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={jabalpurComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Jabalpur"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Jabalpur"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through defence manufacturing, law and judiciary, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
