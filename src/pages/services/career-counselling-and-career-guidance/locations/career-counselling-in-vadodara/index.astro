    name: 'Career Counselling in Vadodara | Future Career School',
    description:
      "Career counselling in Vadodara for students, freshers, and working professionals weighing a PSU or heavy-engineering-and-chemicals track against a genuine MSU fine-arts or humanities calling, or PSU job security against private-sector growth.",
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: [
      { '@type': 'City', name: 'Vadodara' },
      { '@type': 'Country', name: 'India' },
    ],
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
