import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Vadodara page drops two rows: index 1 (degree-first-vs-skill-first) and
// index 3 (paid-outdated-vs-free-updated-assessments). Vadodara's defining
// fork is not a degree-vs-no-degree question the way Surat's or Ludhiana's is -
// both sides of the PSU-vs-fine-arts decision already require a formal,
// credentialed degree (an engineering degree for the PSU track, an MSU Faculty
// of Fine Arts degree for the arts track), so a degree-first-vs-skill-first
// framing would misrepresent the actual choice. The assessment-comparison row
// is dropped here to keep the page's one permitted assessment mention (in
// AssessmentSupportNote, lower on the page) as the only assessment reference
// rather than doubling it inside the comparison matrix too. This drops a
// distinct pair of indices, keeping rows 0, 2, 4, 5 - a combination not used
// by any sibling: Rajkot (rows 0-4), Vizag (rows 1-5), Bangalore (full
// library), Pune (drops 3), Kolkata (drops 1), Chennai (drops 5), Hyderabad
// (drops 2), Mumbai/Chandigarh/Gurgaon/Nagpur (each drop 4), Delhi (drops 0
// and 5), Ahmedabad (drops 3 and 5), Surat (drops 0 and 3), Ludhiana (drops 1
// and 4), and Guwahati (drops 2 and 4).
// AUDIT CORRECTION: the uniqueness claim above was previously wrong - a
// sitewide audit found Thane also dropped exactly indices 1 and 3, an
// undetected duplicate the comment above never checked for (Thane wasn't
// even mentioned in the sibling list). Vadodara is kept as-is here as the
// first-built page of the two; Thane has been moved to a distinct
// triple-index drop (indices 0, 2, and 3) so no other page shares this
// selection anymore.
const vadodaraComparisonRows = BOFU_COMPARISON_LIBRARY.filter((_, index) => index !== 1 && index !== 3);

const title =
  'Career Counselling in Vadodara | PSU, Chemicals, and Fine Arts Paths | Future Career School';
const description =
  "Career counselling in Vadodara for students, freshers, and working professionals weighing a PSU or heavy-engineering-and-chemicals track against a genuine MSU fine-arts or humanities calling, or PSU job security against private-sector growth.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-vadodara/';

const psuVsArtsItems = [
  {
    title: 'The default in Vadodara runs through a PSU or a heavy-engineering-and-chemicals job, and it rarely gets questioned',
    listItems: [
      "Vadodara (Baroda) grew up around some of Gujarat's largest public-sector and heavy-industrial employers - Gujarat Refinery (IOCL) at Koyali, Gujarat State Fertilizers & Chemicals (GSFC), Gujarat Alkalies and Chemicals (GACL) - and a generation of households built their sense of a stable, respectable career around a chemical-engineering or mechanical-engineering degree leading into one of them",
      "That expectation is not unreasonable - these are real, large, long-running employers - but it can crowd out an honest look at whether that specific track fits the person, or whether it is simply the path nobody in the family ever had reason to question",
      "The Maharaja Sayajirao University of Baroda's Faculty of Technology and Engineering feeds directly into this pipeline, so a technical student here can go from classroom to PSU-track expectation without ever formally weighing the alternative",
    ],
  },
  {
    title: "MSU's Faculty of Fine Arts is a genuinely rare, respected calling that most Indian cities simply cannot offer",
    listItems: [
      "The Maharaja Sayajirao University of Baroda is one of India's oldest and most academically broad universities, and its Faculty of Fine Arts is widely regarded as one of the country's most serious institutions for painting, sculpture, applied art, and art history - a genuine, credentialed path into a creative practice, not an informal or unstructured one",
      "This is a real structural difference from most of the other cities where Future Career School works: a student with a genuine pull toward art, design, or a humanities discipline in Vadodara has an actual respected local institution to study at, not just a distant, unproven ambition",
      "That changes the shape of the decision - it is not \"give up a stable career for an uncertain passion,\" it is \"choose between two credentialed, genuinely viable paths that pull in very different directions\"",
    ],
  },
  {
    title: 'Naming this fork honestly is the point - neither side should win by default',
    listItems: [
      "The honest starting point is treating both routes as real: a PSU or heavy-engineering-and-chemicals career offers a well-understood, structured route toward earlier financial freedom for someone whose strengths and interest genuinely fit it, while a fine-arts or humanities path through MSU can be built into a genuine high-value skill portfolio - through practice, portfolio-building, teaching, design work, or applied creative fields - for someone whose actual aptitude sits there instead",
      "What should not happen is either side getting chosen purely because it was the assumed family script, or dismissed purely because it feels less conventional - both outcomes waste years before the real trade-offs get compared honestly",
    ],
  },
];

const contextItems = [
  {
    title: "Vadodara's public-sector and heavy-chemicals identity is genuinely different from Gujarat's other business cities",
    body: "Unlike Ahmedabad's trading-and-finance economy or Surat's diamond-and-textile trade, Vadodara's defining industrial identity runs through large public-sector and heavy-chemical-engineering employers. Gujarat Refinery, operated by Indian Oil Corporation at Koyali on the city's edge, is one of India's oldest and largest oil refineries and has anchored a genuine petrochemical and heavy-engineering ecosystem around it for decades. Gujarat State Fertilizers & Chemicals (GSFC) is headquartered in Vadodara and remains one of the state's largest chemical and fertilizer manufacturers, alongside Gujarat Alkalies and Chemicals (GACL). This creates a PSU-and-heavy-industry employment culture that is structurally distinct from a private-trade or family-business economy - stable, well-defined career ladders, but also a genuinely different risk-and-growth profile from a private-sector role.",
  },
  {
    title: 'Alembic Pharmaceuticals adds a real, homegrown private-sector counterpoint to the PSU default',
    body: "Alembic Pharmaceuticals, one of India's oldest pharmaceutical companies, is headquartered in Vadodara and has built a genuine private-sector pharma and life-sciences employment base in the city, alongside a wider cluster of smaller pharma, chemical, and engineering firms in the Gorwa, Makarpura, and Nandesari GIDC estates. For someone weighing PSU-track stability against private-sector growth, Alembic and the surrounding pharma-and-chemicals private sector are a real, local, non-hypothetical alternative - not a reason to assume a move to Ahmedabad or a metro is the only way to build a private-sector career.",
  },
  {
    title: "MSU is unusually broad for an Indian university, and that shapes the city's whole academic identity",
    body: "The Maharaja Sayajirao University of Baroda, established under the patronage of the Gaekwad royal family, is one of India's oldest and most academically diverse universities, running genuine faculties across arts, fine arts, technology and engineering, medicine, science, commerce, and social work rather than functioning as a narrow engineering-or-business institution. That breadth is itself a defining local fact: Vadodara is one of the few Indian cities in this set where a serious, credentialed path exists for a humanities or fine-arts calling alongside the engineering-and-PSU default, rather than treating either as the obvious answer for every student.",
  },
  {
    title: "The Gaekwad royal legacy still shapes Vadodara's identity as Gujarat's cultural and educational capital",
    body: "Vadodara carries a genuine cultural identity distinct from Gujarat's business cities, rooted in the Gaekwad dynasty's patronage of education, art, and public institutions - visible today in Laxmi Vilas Palace, the Baroda Museum and Picture Gallery, and Sayaji Baug, and carried forward institutionally through MSU itself. This is part of why the fine-arts and humanities path in Vadodara feels genuinely local and legitimate rather than imported, and why the city is often described as Gujarat's cultural and educational capital rather than only its industrial one.",
  },
];

const psuVsPrivateItems = [
  {
    title: 'A second, quieter fork sits underneath the first one: PSU job security versus private-sector growth',
    body: "Even among students and professionals who are clearly headed toward engineering, chemistry, or a technical track rather than fine arts, Vadodara raises a distinct decision that many other cities do not force as directly: whether to pursue the well-defined, secure ladder of a PSU role - at Gujarat Refinery, GSFC, GACL, or a related public-sector employer - or to build toward faster growth and higher variable upside in the private sector, whether at Alembic, a private chemical or engineering firm in the Gorwa-Makarpura-Nandesari belt, or a role built outside Vadodara entirely.",
  },
  {
    title: 'PSU security is real, but it is not automatically the higher-value choice for every person',
    body: "A PSU role at a large employer like Gujarat Refinery or GSFC offers genuine, well-documented job security, structured progression, and a stable income floor - and for many families in Vadodara, that security is treated as the obviously correct answer without much further comparison. What often goes unexamined is the actual income ceiling and growth pace of that ladder compared with a private-sector or entrepreneurial path built on a genuinely useful, high-value skill portfolio, which can move someone toward earlier financial freedom faster, at the cost of a different risk profile.",
  },
  {
    title: 'The honest approach compares both paths on your actual situation, not on family habit',
    body: "Neither PSU security nor private-sector growth is the universally right answer. The useful comparison looks at your actual risk appetite, financial runway, family context, and the specific skills you would need to build for each route - not which one has always been assumed to be safer in your household.",
  },
];

const areaItems = [
  {
    title: 'Alkapuri, Fatehgunj, and Sayajigunj: the academic, commercial, and cultural core',
    body: "Alkapuri is Vadodara's established commercial and residential heart, while Fatehgunj and Sayajigunj sit close to MSU's main campus, drawing much of the city's student population and the coaching and college ecosystem built around it. Many first career and stream decisions in Vadodara take shape in conversations that start in this part of the city.",
  },
  {
    title: 'Gorwa, Makarpura, and Nandesari: the industrial and GIDC belt',
    body: "These Gujarat Industrial Development Corporation estates host a dense cluster of chemical, pharmaceutical, and engineering manufacturing units, including firms connected to Alembic's wider ecosystem, and anchor a real share of Vadodara's private-sector industrial employment alongside the PSU giants on the city's edge.",
  },
  {
    title: 'Koyali and the refinery belt: where the PSU-and-petrochemical identity runs deepest',
    body: "The Gujarat Refinery at Koyali and the surrounding petrochemical complex anchor Vadodara's heaviest industrial employment and its strongest PSU-track pull, drawing engineering graduates from across the region into a well-defined, secure career ladder.",
  },
  {
    title: 'Manjalpur, Waghodia Road, and Karelibaug: the growing residential and professional belt',
    body: "These fast-growing residential areas host a large share of Vadodara's students and young professionals commuting toward MSU, the GIDC estates, or the corporate and pharma offices scattered across the city, often weighing the PSU-versus-private and engineering-versus-arts questions from the same household.",
  },
  {
    title: "Sayaji Baug and the palace precincts: the city's cultural identity made visible",
    body: "Sayaji Baug, Laxmi Vilas Palace, and the Baroda Museum keep Vadodara's Gaekwad-era cultural and educational legacy visibly present in daily life, reinforcing why a fine-arts or humanities path feels like a genuinely local option here rather than an imported ambition.",
  },
];

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want the PSU-and-chemicals-versus-fine-arts fork treated as a real decision, not settled by whichever direction your family already expects.',
      'You want an honest comparison between PSU job security and private-sector growth, based on your actual risk appetite, not habit.',
      'You want to know whether MSU\'s Faculty of Fine Arts, its engineering and technology track, or a private pharma or chemicals path genuinely suits your strengths.',
      'You want a practical next step, not another round of vague reassurance.',
    ],
  },
  {
    title: 'What should matter more than the city label alone',
    listItems: [
      "Whether the guidance actually understands Vadodara's PSU-and-heavy-industry culture and its genuine fine-arts pull",
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process strengthens skill direction and proof of work rather than just describing your options',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the decision actually creating pressure right now',
    listItems: [
      'Whether a PSU or heavy-engineering-and-chemicals track, or an MSU fine-arts or humanities path, genuinely fits your strengths and interest',
      'Whether PSU job security or private-sector growth serves your actual situation better, rather than defaulting to whichever your family has always assumed',
      'What the honest income and growth ceiling looks like for the specific ladder you are currently on',
      'Whether a private pharma, chemicals, or engineering role in Vadodara itself, or a move elsewhere, is worth building toward',
    ],
  },
  {
    title: "Skill direction that fits Vadodara's real economy",
    listItems: [
      'Proof-of-work thinking over degree-first or PSU-admission-first positioning alone',
      'A genuine plan for turning a fine-arts or humanities calling into a high-value skill portfolio - through practice, portfolio-building, teaching, design, or applied creative work',
      'Technical and engineering skills relevant to Vadodara\'s PSU, petrochemical, and private-pharma economy',
      'A realistic route toward earlier financial freedom that accounts for your specific risk appetite and family context',
    ],
  },
  {
    title: 'A practical next step you can act on',
    listItems: [
      'Online guidance delivered across India with no dependence on local offline availability',
      'A clear, honest comparison of your two or three real options instead of an assumed default',
      'A concrete skill and income direction, not just a label for what you already suspected',
      'One decision to move on now instead of more time spent circling the same unexamined choice',
    ],
  },
];

const objectionItems = [
  {
    title: "My family expects me to aim for a PSU job at the refinery or GSFC - is it even reasonable to consider something else?",
