  },
  {
    title: 'Should I prepare for defence services just because the Cantonment is nearby?',
    body: "Proximity is not a reason on its own. A defence-services path deserves the same honest look at fit, readiness, and timelines as any other serious career decision, not an automatic assumption because it is a familiar option locally.",
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In an area where a family trade and a defence-services aspiration can both look equally reasonable, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is a family trade decision, a defence-services preparation plan, stream confusion, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
