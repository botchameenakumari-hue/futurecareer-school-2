];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.delhiCounselling,
    title: 'Career Counselling in Delhi',
    description: "See Delhi's page if the UPSC-attempt cycle, a Delhi University decision, or a government-versus-private question is closer to your situation than Paschim Vihar's specific trade-and-defence fork.",
