---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Note: every BOFU_COMPARISON_LIBRARY filter combination is exhausted
// across siblings (see career-counselling-in-agra/index.astro and
// career-counselling-in-pitampura/index.astro). This page uses its own
// page-specific comparison rows, tailored to the trading-family-business-
// vs-defence-services fork below, matching the pattern first used in
// career-counselling-in-kandivali/index.astro.
const paschimViharComparisonRows = [
  {
    left: 'Assuming a family trading business is a fallback, not a real career',
    right: 'Building formal retail, design, or e-commerce skill on top of a genuine family trade asset',
  },
  {
    left: 'Defaulting toward defence-services preparation purely because the Cantonment is nearby',
    right: 'Testing genuine fit and readiness before committing years to a defence-services attempt',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
];

const title =
  'Career Counselling in Paschim Vihar | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Paschim Vihar: a family retail business near Rajouri Garden versus defence-services preparation near Delhi Cantonment. Online.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-paschim-vihar/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      "You want to see how a family retail business and defence-services preparation really compare",
      "You want clarity before another year of preparation or a shop role",
      "You want advice that does not assume leaving Delhi",
      "You want a specific skill step, not generic motivation",
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      "Whether a family retail or trading business is weighed against a salaried skill path",
      "Whether defence-services preparation is judged on realistic odds and a backup",
      "Whether the plan fits a household that runs on business income",
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: "Paschim Vihar families often run shops near Rajouri Garden; advice should treat that as an asset to build on.",
  },
  {
    title: 'Quality before convenience',
    body: "Retail, defence and salaried careers need different skills, so compare them on paper.",
  },
  {
    title: 'Act before the wrong turn compounds',
    body: "Another year of preparation without a fallback skill is the cost of waiting.",
  },
];

const tradingFamilyItems = [
  {
    title: 'Paschim Vihar carries a genuinely distinct economy: a trading-family business culture',
    body: "Paschim Vihar sits close to Rajouri Garden's well-known furniture and fashion wholesale-and-retail market, and the area itself carries a strong small-business and trading-family culture, common among many West Delhi neighbourhoods with a similar community background. Peeragarhi's smaller-scale manufacturing and trading units add a further layer to this base. That creates a specific career fork a generic Delhi guidance page never addresses: whether to build formally toward retail-management, design, or e-commerce skill on top of a family trading business, or move toward a different skill path while the business continues in the background.",
  },
  {
    title: 'Formal retail and e-commerce skill beats informal trade experience alone',
    body: "A career built around a Paschim Vihar family trading business still benefits from real retail-management, merchandising, or e-commerce skill - not just years of informal exposure. Building a genuine skill and certification layer on top of family trade knowledge, rather than assuming familiarity is enough on its own, is what actually moves someone toward earlier financial freedom from here.",
  },
];

const tradingFamilySummaryItems = [
  {
    title: 'This trading-family culture is a real, specific local factor',
    body: 'Not every Delhi neighbourhood carries this strength of small-business and trading-family identity - it deserves a direct answer, not a generic mention of "family business" in passing.',
  },
];

const defenceServicesItems = [
  {
    title: 'A second, genuinely distinct pattern: defence-services aspiration near the Cantonment',
    listItems: [
      "Paschim Vihar's proximity to the Delhi Cantonment area has built a real local pattern of families considering defence-services careers, whether through the armed forces or paramilitary routes",
      'Preparing seriously for a defence-services entry is a genuine multi-year commitment involving physical, written, and interview-stage preparation',
      'Some families weigh a defence-services attempt against continuing or formalising a family trading business, sometimes without comparing the two honestly',
      'A defence-services path is a real, respected option, but it deserves the same fit-based reasoning as any other career fork, not an automatic assumption because the Cantonment is close by',
    ],
  },
  {
    title: 'What deliberate planning can add to either path',
    listItems: [
      'A structured defence-services preparation plan benefits from an honest look at physical readiness, exam competition, and a backup plan while attempts are ongoing',
      'Retail-management, design, or e-commerce skills can meaningfully strengthen a family trading business rather than treating it as a fallback',
      'Digital marketing skills matter for a trading-family business just as much as in any other trade-based local economy',
      'For those choosing an unrelated path, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const defenceServicesSummaryItems = [
  {
    title: 'Two real, different local patterns, one decision',
    body: 'A trading-family business culture and a defence-services aspiration coexist in Paschim Vihar without overlapping much - the useful question is which one, if either, actually fits your situation.',
  },
];

const areaItems = [
  {
    title: 'The market-adjacent pockets carry the trading-family business economy',
    body: 'Areas closer to Rajouri Garden and Peeragarhi carry the retail, wholesale, and small-manufacturing trade economy described above.',
  },
  {
    title: 'The Cantonment-adjacent belt carries the defence-services aspiration',
    body: 'Proximity to the Delhi Cantonment has built a real local pattern of families considering defence-services careers as a serious option.',
  },
  {
    title: 'The residential core carries a wider middle-class services economy',
    body: "Paschim Vihar's residential sectors support a broad retail, education, and services economy alongside the two more specific local threads above.",
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      "A Paschim Vihar-based option feels easier to trust and you need that to begin",
      "You want the family-business-versus-defence question explained for you",
      "You need one practical step before another cycle",
      "You are using the city search to reduce hesitation, not to decide",
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      "You are expected to join the family shop but want options",
      "You are preparing for the defence services and need a backup plan",
      "You can meet online without leaving the neighbourhood",
      "You need risk and income compared before deciding",
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the area label as a trust shortcut',
    body: "A Paschim Vihar search can build trust at the start, not decide for you.",
  },
  {
    title: 'Let decision quality decide the next step',
    body: "Choose the route that connects family business, defence prep or a skill career to a clear step.",
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether a retail-management, design, or e-commerce path fits your actual strengths',
      'Whether a defence-services preparation path is genuinely viable given your readiness and timeline',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Paschim Vihar's actual economy",
    listItems: [
      'Retail-management, design, or e-commerce skills if a family trading business fits your situation',
      'A structured, honest defence-services preparation plan if that path fits your situation better',
      'A different high-value skill path if neither local pattern fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      "A comparison of the family shop, defence preparation and a skill career",
      "A target with realistic odds and a backup",
      "One next step that suits your household's income pattern",
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, the family shop, or between training sessions',
    body: "You can join from home without travelling across Delhi",
  },
  {
    title: 'Online guidance can sit alongside family conversations about trade or defence-services plans, not compete with them',
    body: "Parents can join the same call about defence or business plans",
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: "Outside advice can speak plainly about selection odds",
  },
];

const objectionItems = [
  {
    title: 'My family runs a retail or trading business near Rajouri Garden - should I continue it, formalise it, or leave it for something else?',
    body: 'This is rarely all-or-nothing. Many trading families are better served by adding retail-management, design, or e-commerce skill on top of the existing business than by abandoning it outright, and for some a separate skill path is genuinely the stronger route.',
  },
  {
    title: 'Should I prepare for defence services just because the Cantonment is nearby?',
    body: "Proximity is not a reason on its own. A defence-services path deserves the same honest look at fit, readiness, and timelines as any other serious career decision, not an automatic assumption because it is a familiar option locally.",
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In an area where a family trade and a defence-services aspiration can both look equally reasonable, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: "The decision at hand: the family business, defence preparation or a skill-first career",
  },
  {
    title: 'The serious options you are already considering',
    body: "The routes you are comparing, with realistic odds and income for each",
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: "What worries you: an unsuccessful cycle, a late start or no backup",
  },
  {
    title: 'The constraints that cannot be ignored',
    body: "Family expectations and money limits, stated early",
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Paschim Vihar's dual local pattern",
    body: 'A trading-family business culture and a defence-services aspiration are two real, distinct local paths with their own planning needs. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a family trading business is treated as an asset, not dismissed',
    body: 'A family retail or trading business is a real starting asset, not a problem to escape by default. Better guidance should show what formalising it with retail-management or e-commerce skill can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether a defence-services attempt gets an honest, structured answer',
    body: 'Good guidance should help you plan a defence-services attempt with realistic readiness checks and a backup plan, not treat it as a default simply because the Cantonment is nearby.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.delhiCounselling,
    title: 'Career Counselling in Delhi',
    description: "See Delhi's page if the UPSC-attempt cycle, a Delhi University decision, or a government-versus-private question is closer to your situation than Paschim Vihar's specific trade-and-defence fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.pitampuraCounselling,
    title: 'Career Counselling in Pitampura',
    description: "See Pitampura's page if an electronics-and-retail-trade-versus-office-career decision is closer to your situation.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than area-based search wording.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Paschim Vihar instead of only looking for a nearby offline office?',
    answer:
      "Because the decision depends on your odds and options, not on proximity. Online fits around preparation or shop hours.",
  },
  {
    question: 'My family runs a retail or trading business near Rajouri Garden. Should counselling assume I have to leave it?',
    answer:
      "No. Good counselling should treat an existing family trading business as a real asset and explore formalising it with retail-management, design, or e-commerce skills, alongside the honest option of building a separate skill path if that genuinely fits better.",
  },
  {
    question: 'Should I prepare for defence services because the Cantonment is close by?',
    answer:
      "Proximity alone is not a strong enough reason. A defence-services path deserves an honest look at fit, readiness, and timelines, just like any other serious career decision - not an automatic assumption because it feels like a familiar local option.",
  },
  {
    question: 'Can this help students, freshers, and working professionals in Paschim Vihar?',
    answer:
      "Yes. Students, defence aspirants, young traders and professionals in west Delhi can use it. Sessions run online across India.",
  },
  {
    question: 'Do you guarantee a job or a defence-services placement?',
    answer:
      'No ethical provider can guarantee a job or a defence-services placement. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Paschim Vihar',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Paschim Vihar | Future Career School',
    description:
      'Career counselling in Paschim Vihar for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Place', name: 'Paschim Vihar, Delhi' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance/">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Paschim Vihar</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Paschim Vihar
      </div>

      <h1 class="hero-title">
        Career counselling in Paschim Vihar
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Paschim Vihar hands many people a genuinely different fork than most Delhi neighbourhoods: a strong trading-family business culture linked to the nearby Rajouri Garden market, running alongside a real defence-services aspiration built up around the neighbouring Delhi Cantonment. Most career advice available online treats it as one generic West Delhi address and misses both. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Paschim Vihar and across India. You can start from home or the family shop - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Paschim Vihar. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Paschim Vihar search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="trading-family"
    title="The trading-family business culture is Paschim Vihar's first real fork"
    subtitle="No other Delhi neighbourhood sibling carries this exact combination of trading-family identity and market proximity - it deserves a specific answer, not a generic mention."
    items={tradingFamilyItems}
    variant="decision"
  >
    <BofuSummaryStrip items={tradingFamilySummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="defence-services"
    title="Defence-services aspiration near the Cantonment: a second, genuinely different pattern"
    subtitle="A real, respected local pattern, and a genuine choice between it and a trading-family business path."
    items={defenceServicesItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={defenceServicesSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="paschim-vihar-areas"
    title="Paschim Vihar's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Paschim Vihar, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Paschim Vihar-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In an area where a trading-family business and a defence-services aspiration can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={paschimViharComparisonRows}
    centered={true}
    extraRows={[
      { left: "Choosing a counsellor only because their office is in Paschim Vihar", right: "Live online sessions from Paschim Vihar, with the same process wherever you are" },
      { left: "Following what most people in Paschim Vihar do by default", right: "A direction chosen from your fit, skills, and market demand" },
    ]}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Paschim Vihar"
    subtitle="If the area search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the area label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Paschim Vihar"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio backed by the decisions that unlock high income opportunities whether your path runs through family trade, defence services, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
