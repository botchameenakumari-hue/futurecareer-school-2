---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Siliguri page drops "Generic advice that still leaves you unclear" (index 0) and
// "Degree-first direction with weak skill edge" (index 1). Index 0 is dropped because the
// page's own hero and positioning prose already carry the generic-advice-vs-high-leverage
// contrast directly through the border-trade-chokepoint and hill-tourism-gateway forks named
// below. Index 1 is dropped because a meaningful share of Siliguri's real local paths - customs
// and freight-forwarding documentation, tour-operator and trekking-guide licensing, and the tea
// auction and export trade - run on certifications and licenses as much as on a formal degree,
// making the degree-first-vs-skill-first framing a weaker fit than it is for a purely
// campus-placement economy. This (0, 1) combination has not been used by any sibling: Rajkot
// (rows 0-4), Vizag (rows 1-5), Bangalore (full library), Pune (drops 3), Kolkata (drops 1),
// Chennai (drops 5), Hyderabad (drops 2), Mumbai/Chandigarh/Gurgaon/Nagpur (each drop 4), Delhi
// (drops 0 and 5), Ahmedabad (drops 3 and 5), Surat (drops 0 and 3), Thane/Vadodara (drop 1 and
// 3), Ludhiana (drops 1 and 4), Guwahati (drops 2 and 4), Jalandhar (drops 2 and 5), Raipur
// (drops 2 and 3), Nashik (drops 1 and 2), Aurangabad (drops 0 and 4), Coimbatore/Noida (each
// drop 3 and 4), Ranchi (drops 1 and 5), Kolhapur/Bhubaneswar (each drop 0 and 2), and Navi
// Mumbai (drops 4 and 5).
const siliguriComparisonRows = BOFU_COMPARISON_LIBRARY.filter((_, index) => index !== 0 && index !== 1);

const title = 'Career Counselling in Siliguri | Border-Trade and Hill-Gateway Careers | Future Career School';
const description =
  "Career counselling in Siliguri for students, freshers, and working professionals weighing the city's own multi-nation border-trade and logistics chokepoint economy, its hill-tourism-gateway role toward Darjeeling, Kalimpong, and Sikkim, and the real stay-in-Siliguri-or-move-to-Kolkata decision.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-siliguri/';

const corridorItems = [
  {
    title: "Siliguri sits inside the \"Chicken's Neck\" - a genuine multi-nation chokepoint, not just another gateway city",
    listItems: [
      "The Siliguri Corridor is the narrow strip of Indian territory that connects the entire Northeast region to the rest of mainland India, hemmed in by Nepal to the west, Bhutan to the north-east, and Bangladesh to the south, with Sikkim sitting just to the north",
      "Almost every truck, train, and passenger route linking the Northeast to the rest of the country physically funnels through this stretch of land, which is a genuinely different economic role from a city that merely sits close to a border",
      "That geography builds a real, ongoing customs, freight-forwarding, warehousing, and cross-border trade-documentation economy in Siliguri that has nothing to do with tourism or tea, and that most people outside the region never connect to a career decision at all",
    ],
  },
  {
    title: "This is a border-trade and logistics career economy, not a stopover city for people leaving the Northeast",
    listItems: [
      "Unlike a city that functions as the Northeast's own internal first-stop for people moving in from surrounding states, Siliguri's defining role is a through-corridor for goods and people moving between Nepal, Bhutan, Bangladesh, Sikkim, and the rest of India",
      "NH27 and the region's road-freight network, the North East Frontier Railway's New Jalpaiguri (NJP) junction, and Bagdogra Airport all converge here, creating genuine roles in freight and cargo operations, customs-house-agent work, warehousing and cold-chain logistics, and export-import documentation",
      "A skill direction built around this corridor economy is a real, distinct path in its own right, not a fallback for someone who could not make a bigger metro work",
    ],
  },
  {
    title: "Getting this fork right matters because Siliguri's real choice is local-corridor-and-hills versus a move to Kolkata, not an ethnic-migration story",
    listItems: [
      "Siliguri is a West Bengal city, and its honest tension is the same one many mid-sized West Bengal towns face - build a strong path inside the local economy, or move to Kolkata for a metro's greater density of employers and mentors",
      "The stronger move is naming, specifically, whether a skill direction already fits what Siliguri's own economy is hiring for - the border-trade and logistics corridor, the hill-tourism-gateway trade, or the tea-auction and export economy - rather than assuming Kolkata is automatically the better answer",
      "Naming that fork clearly is what actually moves someone toward a high-value skill portfolio, unlocking high income opportunities, and earlier financial freedom, whether that plays out from Siliguri or after a move to Kolkata",
    ],
  },
];

const hillGatewayItems = [
  {
    title: "Siliguri is the road, rail, and air gateway to Darjeeling, Kalimpong, Gangtok, and the Dooars",
    body: "Bagdogra Airport and the NJP rail junction are the effective entry point for almost anyone travelling to Darjeeling's tea-and-heritage hill stations, Kalimpong, Sikkim's capital Gangtok, and the Dooars forest-and-wildlife belt. That funnel creates a genuine, sustained hill-tourism-gateway economy inside Siliguri itself - tour operation and travel-agency work, trekking and adventure-tourism guiding, hospitality and hotel management, and transport and logistics coordination for the hill circuit - distinct from tourism happening in the hill towns themselves.",
  },
  {
    title: "The Siliguri Tea Auction Committee runs the physical trading side of the tea economy, not corporate trading offices",
    body: "Siliguri hosts the Siliguri Tea Auction Committee, one of the country's significant tea auction centres, where tea from the Darjeeling, Terai, and Dooars gardens is physically brought to market and sold through the auction process itself - a genuinely different part of the tea-industry value chain from corporate tea-trading head offices found elsewhere. Add in Siliguri's proximity to the Darjeeling tea-garden belt, and the city supports real auction-house, tea-tasting and grading, export-documentation, and garden-management-adjacent career paths.",
  },
  {
    title: "Neither the hill-tourism economy nor the tea-auction trade gets a fair hearing against \"just move to Kolkata for IT or a corporate job\"",
    body: "Because tour operations, trekking guiding, hospitality, and tea-auction work do not carry the same visibility as a Kolkata corporate offer, a genuinely strong local opening in either economy is often dismissed before it is even evaluated. The honest counselling question is not whether hill tourism or the tea trade sounds glamorous - it is whether it is a real, skill-building, income-building path for a specific person, judged on its own terms rather than assumed inferior to a Kolkata move by default.",
  },
];

const areaItems = [
  {
    title: "Sevoke Road and Hill Cart Road carry Siliguri's commercial spine toward the hills",
    body: "Sevoke Road and Hill Cart Road (NH10) form the commercial and transport spine linking Siliguri to Sevoke, the Coronation Bridge over the Teesta, and the road route up toward Kalimpong and Sikkim. Much of the city's travel-agency, transport-operator, and hospitality-booking economy for the hill circuit is concentrated along this stretch.",
  },
  {
    title: "New Jalpaiguri (NJP) and Bagdogra anchor Siliguri's role as a transport and logistics junction",
    body: "NJP railway station is one of the Northeast's most important rail junctions, and Bagdogra Airport handles a large share of passenger and cargo traffic bound for North Bengal, Sikkim, and the wider Northeast. The freight yards, warehousing clusters, and transport-operator offices around both hubs are where much of the corridor's genuine logistics and customs-documentation work actually happens.",
  },
  {
    title: "The Siliguri Tea Auction Centre and the Matigara-Champasari belt carry the tea and trading economy",
    body: "The Siliguri Tea Auction Committee's auction house, along with tea-broking firms and warehousing for gardens across Darjeeling, the Terai, and the Dooars, sits within the city's commercial core, while the Matigara and Champasari stretch along NH27 hosts a growing mix of warehousing, cold storage, and light industry supporting both the tea trade and the wider border-trade corridor.",
  },
  {
    title: "Sevoke More, Hakim Para, and the Bidhannagar-Champasari residential belt carry Siliguri's student and professional population",
    body: "Bidhannagar, College Para, and the areas around North Bengal University hold much of the city's student population, while Hakim Para and the older Sevoke More commercial pockets reflect Siliguri's dense wholesale-trading character. The mix shapes whether a household's default expectation leans toward the local corridor-and-hills economy or is already open to sending a son or daughter to Kolkata.",
  },
];

const objectionItems = [
  {
    title: "Everyone around me says the real opportunity is in Kolkata - is that actually true for someone from Siliguri?",
    body: "It depends heavily on the specific skill direction. Siliguri's own economy - the border-trade and logistics corridor running through NJP, Bagdogra, and NH27, the hill-tourism-gateway trade toward Darjeeling, Kalimpong, and Sikkim, and the Siliguri Tea Auction Committee's trading economy - genuinely supports a range of skilled, well-paying careers that a Kolkata-only view misses entirely. For some skill directions, Kolkata is still the stronger move. The honest answer is specific to your direction, not a blanket yes or no.",
  },
  {
    title: "Should I build a career in Siliguri itself, or treat it as a step before moving to Kolkata?",
    body: "That is exactly the fork this page is built around, and there is no single right answer for every person. If your skill direction already has a genuine opening inside Siliguri's border-trade, logistics, hill-tourism, or tea-auction economy, building here can be the stronger, lower-cost, closer-to-family choice. If it needs a metro's greater density of employers and peer competition to grow, treating a Kolkata move as a deliberate next stage - not a default assumption - is the more honest plan.",
  },
  {
    title: "Is a career in logistics, customs work, or tourism actually a realistic, well-paying path from Siliguri, or is it a fallback?",
    body: "It is genuinely realistic when it is matched to the right skill set. The border-trade corridor running through NJP, Bagdogra, and NH27 supports real freight, customs-documentation, and warehousing careers, and the hill-tourism-gateway trade toward Darjeeling, Kalimpong, and Sikkim supports real tour-operation, guiding, and hospitality careers. Both are underestimated mainly because they are less visible than a Kolkata corporate offer, not because they pay less or offer less growth for the right person.",
  },
  {
    title: "My family wants me to stay close to Siliguri and North Bengal - does that limit my real options?",
    body: "Not automatically. Siliguri's own economy is genuinely broader than most people realise from outside the region - a multi-nation border-trade and logistics corridor, a hill-tourism-gateway trade toward three separate hill destinations, and the tea-auction and export economy. The more useful question is whether your specific skill direction is strong enough to build from Siliguri itself, independent of the stay-or-move-to-Kolkata debate.",
  },
  {
    title: "Does this page also apply if my real pull is toward Darjeeling, Kalimpong, or Sikkim rather than Siliguri city itself?",
    body: "Yes. Siliguri is the practical gateway for all three - most travel, transport, and supply lines into Darjeeling, Kalimpong, and Sikkim run through Siliguri's own road, rail, and air links. If your interest is in a hill-tourism, hospitality, or trekking-guide career built around any of those destinations, the honest starting point for career decisions is usually Siliguri's own gateway economy, not the hill town alone.",
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the specific fork pressing you right now',
    listItems: [
      "Whether your skill direction already has a real opening inside Siliguri's border-trade and logistics corridor, its hill-tourism-gateway economy, or the tea-auction and export trade",
      'Whether building in Siliguri itself, or moving to Kolkata for a wider metro market, is the stronger next step for your specific direction',
      'Whether staying close to family and North Bengal, or moving for a metro\'s density of employers, fits your actual situation better',
      "What a realistic income trajectory looks like on your current path, given how Siliguri's corridor-and-gateway economy actually works compared with a single-metro market",
    ],
  },
  {
    title: "Skill direction built for what Siliguri's actual economy is hiring for",
    listItems: [
      'A high-value skill portfolio aimed at freight, logistics, and customs-documentation roles, hill-tourism and hospitality work, or tea-auction and export trade, if that is genuinely your fit',
      'Proof-of-work positioning strong enough to compete for a Kolkata-based role, if the honest read is that a metro move fits your specific direction better',
      'Honest fit-checking between a corridor-and-hills local path and a Kolkata move, instead of defaulting to whichever option feels more familiar',
      "A clearer route toward earlier financial freedom that treats Siliguri's real border-trade-and-hill-gateway economy as the honest starting point, not an afterthought to a Kolkata-only lens",
    ],
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Siliguri's actual economy, not a generic small-town assumption",
    body: "Good guidance for Siliguri should speak specifically to the border-trade and logistics corridor running through NJP, Bagdogra, and NH27, the hill-tourism-gateway trade toward Darjeeling, Kalimpong, and Sikkim, and the Siliguri Tea Auction Committee's trading economy - not treat Siliguri as an undifferentiated small city with no real economic identity of its own.",
  },
  {
    title: "Check whether the advice is honest about Siliguri's role as a corridor city, not just optimistic about it",
    body: "Siliguri genuinely anchors a multi-nation trade route and a three-way hill-tourism gateway, but it remains a smaller, more specialised market than Kolkata for many skill directions. Guidance worth paying for should say plainly when a Kolkata move genuinely serves your specific direction better, instead of overselling Siliguri as a full substitute for a metro's scale in every field.",
  },
  {
    title: "Check whether staying close to family and North Bengal is treated as a real constraint to plan around",
    body: "For many people from Siliguri and the surrounding Terai and Dooars region, staying within reach of home is a genuine priority, not a lack of ambition. Guidance should help build the strongest possible path from Siliguri when that is the goal, rather than treating a move to Kolkata as the only serious outcome.",
  },
  {
    title: "Check whether the guidance treats logistics, tourism, and tea-auction work as legitimate paths, not a fallback",
    body: "A counsellor who only measures success by a Kolkata corporate or IT offer will miss a real share of Siliguri's genuinely well-paying, skill-building work in freight and logistics, hill tourism, and the tea trade. The guidance should evaluate a path on its own merits for you, not its resemblance to a metro corporate career.",
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'Explore other city-specific guidance pages if you want to compare before committing.',
  },
  {
    href: BOFU_INTERNAL_LINKS.kolkataCounselling,
    title: 'Career Counselling in Kolkata',
    description: 'Useful if Kolkata is the nearer metro you are weighing as the next step beyond Siliguri.',
  },
  {
    href: BOFU_INTERNAL_LINKS.guwahatiCounselling,
    title: 'Career Counselling in Guwahati',
    description: "Useful if your comparison point is the Northeast's own internal gateway city rather than Siliguri's border-corridor and hill-tourism economy.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'Use the main counselling page if the city matters less than the overall need for clarity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'Use the main guidance page when the core issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Siliguri instead of only looking for a nearby offline option?',
    answer:
      "Because proximity alone does not resolve Siliguri's real fork - whether to build a career inside the city's own border-trade, logistics, hill-tourism-gateway, and tea-auction economy, or move to Kolkata for a wider metro market. Online guidance lets you start from home, from North Bengal University, or from work near Sevoke Road or NJP, without waiting on local availability, and it should still be judged on whether it gives you a clear, specific answer for your situation.",
  },
  {
    question: "What makes Siliguri's economy different from other gateway cities like Guwahati?",
    answer:
      "Siliguri's defining identity is the Siliguri Corridor, or \"Chicken's Neck\" - the narrow strip of Indian territory bordered by Nepal, Bhutan, and Bangladesh, with Sikkim just to the north, that the entire Northeast's road and rail links to the rest of India physically pass through. That makes Siliguri a multi-nation border-trade and logistics chokepoint, alongside a genuine hill-tourism-gateway role toward Darjeeling, Kalimpong, and Sikkim. That is a structurally different role from a city that functions as the Northeast's own internal first-stop for people arriving from the surrounding states - the two economies and the two decisions are genuinely distinct.",
  },
  {
    question: 'Is a career in logistics, customs work, or tourism actually realistic from Siliguri?',
    answer:
      "Yes, genuinely. Siliguri's position on the border-trade corridor - anchored by NH27, NJP railway junction, and Bagdogra Airport - supports real freight, customs-documentation, and warehousing careers, and its role as the road, rail, and air gateway to Darjeeling, Kalimpong, and Sikkim supports real tour-operation, trekking-guide, and hospitality careers. Both are underestimated mainly because they are less visible than a Kolkata corporate offer, not because they lack real, skill-building growth for the right person.",
  },
  {
    question: 'Is the Siliguri tea trade the same kind of career path as tea-industry work elsewhere?',
    answer:
      "Not exactly. Siliguri's tea-industry role runs through the Siliguri Tea Auction Committee, where tea from the Darjeeling, Terai, and Dooars gardens is physically brought to market and sold through the auction process itself, alongside genuine proximity to the Darjeeling tea-garden belt. That is a distinct part of the tea-industry value chain from corporate tea-trading offices, and it supports its own set of auction-house, tea-tasting and grading, and export-documentation career paths.",
  },
  {
    question: 'Should I settle in Siliguri permanently, or treat it as a stepping stone before moving to Kolkata?',
    answer:
      "There is no single right answer for every person. If your skill direction already has a genuine opening inside Siliguri's border-trade, logistics, hill-tourism, or tea-auction economy, building here can be the stronger, lower-cost, closer-to-family choice. If it needs Kolkata's greater density of employers and peer competition to grow, treating a Kolkata move as a deliberate next stage - not a default assumption - is the more honest plan.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free, updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Siliguri?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so it works whether you are building from Siliguri or weighing a move to Kolkata.',
  },
  {
    question: 'What if I searched for Siliguri but the bigger issue is not the city at all?',
    answer:
      "That is common. The city search is often a trust shortcut. If the real pressure is stream selection, degree choice, skill direction, or a career change rather than location, the main counselling and guidance pages are the stronger next filter. This page is most useful when local context - Siliguri's border-trade corridor, its hill-tourism-gateway role, the tea-auction economy, or the stay-or-move-to-Kolkata decision - is genuinely part of your situation.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      { '@type': 'ListItem', position: 5, name: 'Career Counselling in Siliguri', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Siliguri | Future Career School',
    description:
      "Career counselling in Siliguri for students, freshers, and working professionals. Online guidance for the stay-and-build-in-Siliguri-or-move-to-Kolkata decision, built around the city's role as a multi-nation border-trade corridor and hill-tourism gateway.",
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: [
      { '@type': 'City', name: 'Siliguri' },
      { '@type': 'Country', name: 'India' },
    ],
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Siliguri</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Siliguri and North Bengal
      </div>

      <h1 class="hero-title">
        Career counselling in Siliguri
        <span class="gold-text"> for a border-trade and hill-gateway city</span>
      </h1>
      <p class="hero-sub">
        Siliguri sits inside the "Chicken's Neck" - the narrow corridor of Indian territory bordered by Nepal, Bhutan,
        and Bangladesh, with Sikkim just to the north, that the entire Northeast's road and rail links to the rest of
        the country pass through. That makes Siliguri a genuine multi-nation border-trade and logistics chokepoint,
        and its role as the road, rail, and air gateway to Darjeeling, Kalimpong, Gangtok, and the Dooars builds a real
        hill-tourism economy on top of it. Good counselling here is not about assuming Kolkata is automatically the
        stronger move. It is building the kind of high-value skill portfolio that unlocks high income opportunities
        and moves you toward earlier financial freedom - whether that plays out from Siliguri or after a move to
        Kolkata.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Siliguri and across India. You can start from home, from North Bengal
        University or any other campus, or from work near Sevoke Road or NJP - no travel required before the
        underlying skill direction is even clear.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not whether Siliguri's role as a gateway city sounds promising in general. It is
        whether your specific skill direction already has a real opening here, or genuinely needs a move to Kolkata
        first.
      </p>
    </div>
  </section>

  <AudienceRelevance title="How the right support can fit where you are right now" />

  <BofuListCardSection
    sectionId="corridor-fork"
    title="The decision most people searching from Siliguri are actually facing"
    subtitle="This border-trade-corridor-and-hill-gateway framing has no equivalent on any other city page this site covers, because no other city sits inside a genuine multi-nation trade chokepoint the way Siliguri does."
    items={corridorItems}
    variant="contrast"
  />

  <ContextualCta
    audience="mixed"
    title="If the Siliguri stay-or-move-to-Kolkata question already feels urgent, resolve it before more time goes into the wrong bet"
    body="Use this when you want a decision that moves you toward earlier financial freedom, not another year of assuming Kolkata is automatically the answer."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="How this approach differs from typical career counselling"
    subtitle="In a city where the pull toward Kolkata is constant, the risk is generic advice that assumes a metro is always the answer without checking your specific skill fit. The comparison below shows what separates high-leverage guidance from that."
    rows={siliguriComparisonRows}
  />

  <BofuFeatureSection
    sectionId="hill-tea-economy"
    title="Siliguri's hill-tourism-gateway and tea-auction economy - a real fork most outside advice never mentions"
    subtitle="Neither economy shows up in a generic 'just move to Kolkata' script, but both run genuine, skill-building careers out of Siliguri every day."
    items={hillGatewayItems}
    variant="signal"
  />

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical career counselling should move you forward"
    subtitle="The point is not another opinion about whether Siliguri has 'enough opportunity'. The point is a clearer decision, stronger skill direction, proof of work, and a real route toward earlier financial freedom, whether that plays out from Siliguri or from Kolkata after it."
  />

  <BofuFeatureSection
