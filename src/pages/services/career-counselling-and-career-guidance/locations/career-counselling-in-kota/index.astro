---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: all 15 two-row drops are already claimed by existing
// siblings (see the tracking note in career-counselling-in-agra/index.astro).
// This page uses the unused three-row drop (1, 2, 4), keeping rows 0, 3, and
// 5 - the rows most relevant to the coaching-pipeline-vs-local-trade fork
// below. Verified against every sibling file before publishing.
const kotaComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 1 && index !== 2 && index !== 4,
);

const title =
  'Career Counselling in Kota | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Kota for students, freshers, and working professionals weighing the JEE/NEET coaching pipeline against the Kota Stone mining-and-export trade, the Kota Doria handloom craft, or a different skill path.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-kota/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      "You want clarity before committing more years to the JEE/NEET coaching pipeline, a family Kota Stone or Kota Doria trade, or a formal degree path.",
      "You want something more practical than a coaching-centre pitch or a relative's opinion about which exam to keep attempting.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const coachingPipelineItems = [
  {
    title: "Kota runs on a genuinely unique economy: India's largest JEE and NEET coaching industry",
    body: "Kota hosts the country's largest concentration of engineering and medical entrance-exam coaching institutes, drawing students from across India into a dense hostel-and-coaching ecosystem built entirely around one or two exam attempts. That creates a specific pressure a generic guidance page never addresses: whether to keep pushing on the same coaching track after a difficult attempt, switch to a different stream or exam entirely, or step back and reassess fit before another year of preparation and cost goes into the same route.",
  },
  {
    title: 'A real decision, not a motivational one',
    body: "Because the coaching pipeline is so visible and so heavily marketed in Kota, the honest question - whether this specific path still fits your strengths, results, and appetite for another attempt - can get lost. Clear-eyed counselling looks at your actual results and options rather than repeating the same coaching-centre pitch.",
  },
];

const coachingPipelineSummaryItems = [
  {
    title: 'This pressure is specific to Kota',
    body: 'Very few Indian cities carry an entire local economy built around one exam-preparation pipeline the way Kota does - it deserves a direct, honest answer, not a generic study-tips page.',
  },
];

const localTradeItems = [
  {
    title: 'A second, genuinely distinct economy: Kota Stone and Kota Doria',
    listItems: [
      'Kota district is a major national source of Kota Stone, a limestone widely used in construction and flooring, with a real mining, cutting, polishing, and export trade centred around Ramganj Mandi and nearby areas',
      'Kota Doria (Kota Sari) is a GI-tagged handloom textile craft with a genuine weaving and trading economy of its own, distinct from the exam-coaching identity most people associate with the city',
      'Families connected to either trade often pass skill down informally, through apprenticeship rather than formal training',
      'Formal skill in mining-equipment operation, export-quality control, textile design, or e-commerce for handloom products increasingly separates a growing business from a stagnant one',
    ],
  },
  {
    title: 'What a skill-first path can add to either trade',
    listItems: [
      'Mining-operations, quality-control, or export-compliance skill can move a stone business from local supply toward higher-margin export work',
      'Textile design, natural-dye, and e-commerce skills can move a Kota Doria business from wholesale trading toward branded, higher-margin retail',
      'Digital marketing skills matter here as much as in any other trade-based local economy',
      'For those choosing an unrelated path, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const localTradeSummaryItems = [
  {
    title: 'Kota is not only a coaching city',
    body: 'The Kota Stone and Kota Doria trades run alongside the coaching-industry identity without overlapping it - a useful local page should treat both as real, not flatten the city into one export-marketing story.',
  },
];

const areaItems = [
  {
    title: 'The coaching hubs carry the exam-preparation and hostel economy',
    body: 'The areas around the major coaching institutes and their hostel clusters carry the exam-preparation economy described above, along with the pressure and cost that come with it.',
  },
  {
    title: 'Ramganj Mandi and nearby belts carry the Kota Stone mining and export trade',
    body: 'The stone-mining, cutting, and polishing units, along with the export trade built around them, are concentrated in and around Ramganj Mandi.',
  },
  {
    title: 'Older weaving neighbourhoods carry the Kota Doria handloom craft',
    body: "Kota Doria weaving remains a real, if smaller, craft economy centred in specific neighbourhoods with a long handloom tradition.",
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh continuing coaching, a family stone or textile trade, or a formal-skill path before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the city search to reduce hesitation, not because the city itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'A coaching-attempt decision or family trade ties matter more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the city label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether continuing the current coaching attempt genuinely fits your results and goals',
      'Whether a family stone-trade or Kota Doria business, formalised with real skill, is a stronger option than it looks',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Kota's actual economy",
    listItems: [
      'A revised exam or stream strategy if the coaching path is still the right one, made with clear eyes rather than sunk-cost thinking',
      'Mining, export, or textile-design skills if a family trade fits your situation',
      'A different high-value skill path if neither local economy fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from your hostel, home, workshop, or family shop',
    body: 'Career counselling is available online in Kota and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family and coaching-centre conversations, not compete with them',
    body: 'When a coaching decision or a family trade business is part of the picture, the harder conversations often need to include family. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: 'A nearby or well-marketed option can still leave you with generic advice that ignores the coaching-pressure or trade context you are actually weighing. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.',
  },
];

const objectionItems = [
  {
    title: "I've had a difficult attempt at JEE or NEET - should I try again or change direction?",
    body: 'That depends on your actual results, the specific gap causing the difficulty, and honest appetite for another attempt - not on how normal repeating an attempt looks in Kota. A structured look at the real numbers is more useful than another motivational push.',
  },
  {
    title: 'My family runs a Kota Stone or Kota Doria business - should I continue it, formalise it, or leave it for something else?',
    body: 'This is rarely all-or-nothing. Many trade families are better served by adding export-compliance, design, or digital-marketing skill on top of the existing business than by abandoning it outright, and for some a separate skill path is genuinely the stronger route.',
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In a city where one coaching pipeline can look like the only serious option, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is a coaching-attempt decision, a family trade path, stream confusion, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: another difficult attempt, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, family expectations, trade ties, and exam-attempt limits early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Kota's coaching-pressure reality",
    body: 'Good guidance should engage honestly with the specific pressure of the coaching pipeline, including when stepping back or changing direction is the stronger move, not just cheerlead another attempt.',
  },
  {
    title: 'Check whether a family stone or textile trade is treated as an asset, not dismissed',
    body: 'A family Kota Stone or Kota Doria business is a real starting asset, not a problem to escape by default. Better guidance should show what formalising or building on it can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether the next move fits your Kota reality realistically',
    body: 'Good guidance for Kota should be realistic about exam-attempt costs, family and trade ties, and what skill-building genuinely works whether you continue the coaching path or build something different.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.suratCounselling,
    title: 'Career Counselling in Surat',
    description: "See Surat's page if a family trade-business decision is closer to your situation than Kota's coaching-pipeline fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Kota instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from your hostel, home, or family shop without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'I am currently preparing for JEE or NEET in Kota. Will counselling tell me to quit?',
    answer:
      "No. Good counselling looks at your actual results, timeline, and goals and helps you decide honestly whether to continue, adjust strategy, or change direction - it does not start from an assumption in either direction.",
  },
  {
    question: 'My family has a Kota Stone or Kota Doria business. Should counselling assume I have to leave it?',
    answer:
      "No. Good counselling should treat an existing family trade business as a real asset and explore formalising it with export, design, or digital-marketing skills, alongside the honest option of building a separate skill path if that genuinely fits better.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Kota?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Kota users.',
  },
  {
    question: 'Do you guarantee a job or an exam result?',
    answer:
      'No ethical provider can guarantee an exam result or a job. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Kota',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Kota | Future Career School',
    description:
      'Career counselling in Kota for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: 'Kota' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Kota</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Kota
      </div>

      <h1 class="hero-title">
        Career counselling in Kota
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Kota hands many people a genuinely different fork than most Indian cities: the country's largest JEE and NEET coaching-industry economy, running alongside a real Kota Stone mining-and-export trade and the GI-tagged Kota Doria handloom craft. Most career advice available online is written for a single generic city and misses all three. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Kota and across India. You can start from your hostel, home, workshop, or family shop - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Kota. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Kota search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="coaching-pipeline"
    title="The JEE/NEET coaching pipeline is Kota's first real fork"
    subtitle="No other Indian city sibling runs on this exact coaching-industry base - it deserves a specific, honest answer, not a generic study-tips page."
    items={coachingPipelineItems}
    variant="decision"
  >
    <BofuSummaryStrip items={coachingPipelineSummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="local-trade"
    title="Kota Stone and Kota Doria: a second, genuinely different economy"
    subtitle="Real trade and craft economies under their own pressures, and a genuine choice between formalising them and building a different skill path."
    items={localTradeItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={localTradeSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="kota-areas"
    title="Kota's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Kota, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Kota-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a city where one coaching pipeline can look like the only serious option, the risk is advice that ignores where you actually are and what your results actually show. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={kotaComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Kota"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Kota"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through a coaching pipeline, a local trade, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
