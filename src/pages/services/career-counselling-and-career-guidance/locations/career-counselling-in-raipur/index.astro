---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Raipur drops the "stronger skill choices aimed at achieving earlier
// financial freedom" row (index 2) and the "free updated practical
// AI-powered assessments" row (index 3) - both ideas are already carried
// directly in this page's own prose (the positioning chain in the hero and
// early sections, and the single contextual AssessmentSupportNote lower on
// the page), so repeating them inside the matrix adds the least here. This
// combination (drops 2 and 3) is not used by any sibling: Rajkot (rows 0-4),
// Vizag (rows 1-5), Bangalore (full library), Pune (drops 3), Kolkata (drops
// 1), Chennai (drops 5), Hyderabad (drops 2), Mumbai (drops 4), Chandigarh
// (drops 4), Gurgaon (drops 4), Nagpur (drops 4), Delhi (drops 0 and 5),
// Ahmedabad (drops 3 and 5), Surat (drops 0 and 3), Thane (drops 1 and 3),
// and Ludhiana (drops 1 and 4).
const raipurComparisonRows = BOFU_COMPARISON_LIBRARY.filter((_, index) => index !== 2 && index !== 3);

const title = 'Career Counselling in Raipur | Chhattisgarh Career Guidance | Future Career School';
const description =
  'Career counselling in Raipur for students, freshers, and working professionals weighing steel, power, and mining careers, AIIMS-driven medical paths, and Naya Raipur\'s newer IT-SEZ opportunities in a state still building its own professional identity.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-raipur/';

const raipurContextItems = [
  {
    title: 'Chhattisgarh is barely 25 years old as a state - and Raipur is still writing what a serious career here actually looks like',
    body: "Chhattisgarh was carved out of Madhya Pradesh on 1 November 2000, making it one of India's youngest major states. That is not a trivia point - it means Raipur's government departments, professional networks, and 'this is how a career here is supposed to go' assumptions are still being formed in real time, not inherited across generations the way they are in a state capital with a century or more of settled administrative culture behind it. For someone deciding what to build from Raipur, that cuts both ways: there is less rigid precedent forcing you into one script, but there is also less established mentorship density and fewer well-worn alumni networks to lean on by default. Good career counselling here should treat that honestly instead of quietly borrowing advice built for an older, already-settled capital.",
  },
  {
    title: "Steel, power, and mining are not backstory here - they are Raipur's present-tense economic engine",
    body: "The Bhilai Steel Plant, one of India's largest integrated steel plants under SAIL, sits barely 30 kilometres from Raipur in neighbouring Durg, and its presence shapes engineering, metallurgy, plant-operations, and heavy-industry supply-chain careers across the whole Raipur-Durg-Bhilai belt. Chhattisgarh also carries some of India's richest coal and iron-ore reserves, feeding a dense corridor of NTPC and state-run thermal power plants across the state and a genuine mining, mineral-processing, and power-engineering economy around Raipur that outside observers tend to flatten into a vague 'mineral-rich state' label without naming the actual technical and managerial roles it produces.",
  },
  {
    title: 'AIIMS Raipur has given the city a real medical-education anchor most tier-2 state capitals do not have',
    body: "AIIMS Raipur, opened in 2012 as one of the first new All India Institute of Medical Sciences campuses outside Delhi, sits alongside Pandit Ravishankar Shukla University and Chhattisgarh's other medical colleges to give Raipur a genuinely credible medical-education and hospital-career pathway. For anyone weighing medicine, nursing, allied health, paramedical work, or health administration, that changes the calculation - a serious pathway now exists from Raipur itself, not only after leaving for a metro.",
  },
  {
    title: 'Naya Raipur (Atal Nagar) is Chhattisgarh building its own modern capital from an open map, including an IIM campus',
    body: "South of the old city, Naya Raipur - officially renamed Atal Nagar - was purpose-built as Chhattisgarh's new capital extension, planned from scratch to host the state secretariat, the high court, and an IT-SEZ block meant to pull in technology and services employment. It is also home to IIM Raipur's campus, giving the state a genuine management-education anchor to sit alongside AIIMS Raipur's medical one. Like most young, still-filling SEZs, the honest read is whether a specific skill direction already has a real opening inside Atal Nagar today, not whether the master plan sounds impressive.",
  },
];

const youngStateItems = [
  {
    title: "Chhattisgarh's own government, PSU, and professional culture is still forming - and that changes how a career decision should be made here",
    listItems: [
      "A state capital with a century of settled administrative history hands you a well-worn script; Raipur, barely a generation into statehood, has fewer of those inherited assumptions about what a 'good career' has to look like",
      "That means more genuine room to choose a nonstandard path without fighting decades of precedent, but also thinner mentorship density and fewer established alumni networks than an older capital - a real trade-off worth naming rather than glossing over",
      "The honest starting point is treating Raipur as its own case, not assuming it will behave like Delhi's centuries-old bureaucracy or Chandigarh's 1950s planned-capital identity just because it is also a state capital",
    ],
  },
  {
    title: "The steel-power-mining backbone offers real stability, but it rewards a specific technical and operational fit, not general ambition",
    listItems: [
      "Bhilai Steel Plant, the NTPC and state thermal-power corridor, and Chhattisgarh's coal and iron-ore mining economy are genuine, large, stable employers - not a fading industrial story",
      "But they hire hardest for metallurgy, plant-operations, power engineering, mining and mineral-processing, and heavy-industry supply-chain roles specifically, not for every generalist skill direction someone might bring",
      "Building the kind of high-value skill portfolio this economy actually rewards matters more than assuming 'steel and power are big here' automatically means an opening exists for you",
    ],
  },
  {
    title: 'AIIMS Raipur, IIM Raipur\'s Atal Nagar campus, and the industrial belt are genuinely different bets, and guessing blind wastes real time',
    listItems: [
      "A medical or allied-health path through AIIMS Raipur, a management or IT-SEZ path through Naya Raipur, and an engineering or operations path through the steel-power-mining belt call for almost entirely different preparation, timelines, and skill-building",
      "Picking between them on family expectation or city reputation alone, instead of on your own aptitude and interests, is exactly the kind of decision that quietly delays unlocking high income opportunities",
      "Getting this specific fork right - rather than defaulting to whichever option is most talked about locally - is what actually moves someone toward earlier financial freedom, whether that path runs through Raipur, Naya Raipur, or Durg-Bhilai",
    ],
  },
];

const raipurAreaItems = [
  {
    title: 'Naya Raipur (Atal Nagar) carries the state\'s newest administrative, management, and IT ambitions',
    body: "Atal Nagar's planned sectors host the state secretariat (Mantralaya), the Chhattisgarh High Court, IIM Raipur's campus, and an IT-SEZ block still filling in around them. Someone based here, or commuting in from old Raipur, is usually weighing a government or public-administration track, a management-education route through IIM Raipur, or an early bet on the IT-SEZ's still-developing private-sector roles.",
  },
  {
    title: 'Civil Lines, Shankar Nagar, and Telibandha carry old Raipur\'s established professional and residential core',
    body: "Civil Lines holds much of the city's older government-office and bungalow-era administrative presence, while Shankar Nagar and Telibandha are dense with professional families, coaching institutes, and a settled, more traditional service-sector identity. Someone from this side of the city is often weighing a stable government-exam or administrative-services path against the newer options opening up in Naya Raipur or the industrial belt.",
  },
  {
    title: 'Pandri and the railway-and-trade corridor anchor Raipur\'s mandi, logistics, and commercial economy',
    body: "Pandri's wholesale grain and produce market, together with Raipur Junction's position as a major stop on the Mumbai-Howrah and Delhi-Chennai rail lines, keeps a genuine trade, mandi, and logistics economy running through the city, feeding supply-chain, warehousing, and commercial roles well beyond what the steel-power-mining story alone suggests.",
  },
  {
    title: 'Durg-Bhilai next door turns many Raipur careers into a genuine two-city calculation',
    body: "Durg-Bhilai, the twin-city belt roughly 30 kilometres from Raipur and home to the Bhilai Steel Plant itself, means a real share of Raipur-area career decisions are not really about Raipur alone - they are about whether to build toward a steel-plant or heavy-industry role centred on Bhilai, or an administrative, medical, management, or IT-SEZ path centred on Raipur and Naya Raipur, and how the commute or a possible relocation between the two factors in.",
  },
];

const objectionItems = [
  {
    title: 'Everyone tells me Raipur is just a mining and government-job town - is that still the whole picture?',
    body: "It captures a real share of the economy but not all of it. Government and public-sector work, plus the coal, iron-ore, and mineral economy, genuinely anchor a large slice of Raipur's stable income. But AIIMS Raipur's medical pathway, IIM Raipur's management pathway inside Naya Raipur, and the wider steel-and-power engineering economy around Bhilai add real, distinct layers most outside summaries skip. The honest answer depends on which specific direction fits you, not a blanket yes or no about the whole city.",
  },
  {
    title: "Should I aim for AIIMS or a medical path, Naya Raipur's IT-SEZ and management route, or the steel-and-power engineering belt around Bhilai?",
    body: "These are genuinely different bets with different preparation timelines, entrance routes, and skill-building needs. There is no single right answer independent of your own aptitude, interests, and family situation - the useful next step is mapping your actual fit against each of these three real Raipur-area paths, rather than defaulting to whichever one is loudest in local conversation.",
  },
  {
    title: "Is a degree or professional qualification from a young state like Chhattisgarh taken less seriously than one from an older state?",
    body: "A degree's value comes from the institution and the work you build on top of it, not from how long the state issuing it has existed. NIT Raipur, Pandit Ravishankar Shukla University, AIIMS Raipur, and IIM Raipur's Atal Nagar campus are recognised on their own institutional standing. What matters more in a market still forming its own professional density is having visible proof of work alongside the degree, since Raipur's hiring networks are thinner than an older metro's.",
  },
  {
    title: "My family wants me in a government job because Chhattisgarh is a new state that is still hiring into its own administration - is that the safer bet?",
    body: "Government and public-sector hiring genuinely is a stronger local option in a young state still building out its own administrative machinery, so that instinct is not baseless. But 'safer in general' still depends on whether exam-based, service-oriented work actually fits you, versus the medical, management, or industrial-engineering paths Raipur now also genuinely supports - not an automatic default because the state is new.",
  },
  {
    title: "Does living closer to Durg-Bhilai instead of Raipur city change what options make sense for me?",
    body: "Yes, meaningfully. Someone rooted near Bhilai is usually closer to steel-plant, metallurgy, and heavy-industry operations roles day to day, while someone based in Raipur or Naya Raipur sits closer to the administrative, medical, management, and IT-SEZ economy. Neither location closes off the other path entirely, but the realistic commute and networking pattern differs enough that it is worth naming directly instead of treating Raipur-Durg-Bhilai as one undifferentiated area.",
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the specific fork pressing you right now',
    listItems: [
      'Whether a medical or allied-health path through AIIMS Raipur, a management or IT-SEZ path through Naya Raipur, or an engineering and operations path through the steel-power-mining belt genuinely fits your aptitude and interests',
      "Whether a government or administrative path fits you specifically, given Chhattisgarh's own still-forming public-sector economy, or is only a default expectation worth questioning",
      "Whether staying close to the Raipur-Durg-Bhilai belt, or building the skills for a bigger metro's density first, is the stronger move for your particular direction",
      "What a realistic trajectory looks like on your current path given how thin or thick Raipur's market actually is for that specific skill, not for the region in general",
    ],
  },
  {
    title: "Skill direction built for what Raipur's actual economy is hiring for",
    listItems: [
      'A high-value skill portfolio aimed at metallurgy, power engineering, mining and mineral-processing, or industrial supply-chain roles, if that is genuinely your fit',
      'Honest fit-checking between a medical or allied-health route through AIIMS Raipur and a management or IT-SEZ route through Naya Raipur, instead of guessing based on which sounds more prestigious',
      'Proof-of-work positioning strong enough to stand out in a market with thinner professional networks than an older, more established capital',
      'A clearer route toward unlocking high income opportunities and earlier financial freedom that treats Raipur\'s real, present-day economy as the starting point, not an assumed or outdated one',
    ],
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Raipur's actual mix, not a generic state-capital script",
    body: "Useful guidance for Raipur should speak specifically to the Bhilai Steel Plant and the wider metallurgy and power-engineering economy, AIIMS Raipur's medical pathway, IIM Raipur's management route inside Naya Raipur, and the state's own still-forming administrative and PSU hiring - not treat Raipur as an interchangeable tier-2 capital.",
  },
  {
    title: "Check whether the advice is honest about scale, not just enthusiastic about Naya Raipur",
    body: "Naya Raipur's IT-SEZ and Atal Nagar's institutions are real, but still earlier-stage than an established corridor with decades of density behind it. Guidance worth paying for should say plainly when a specific skill direction is not yet well served locally, instead of overselling the growth story to keep the conversation optimistic.",
  },
  {
    title: "Check whether staying near family in Raipur or Durg-Bhilai is treated as a real constraint to plan around, not argued out of",
    body: "Wanting to stay close to family in a young state still building its own institutions is a genuine, common factor for Raipur students and professionals. Guidance should help build the strongest realistic path from where you are, not push relocation as the only serious option.",
  },
  {
    title: "Check whether the guidance treats the steel-power-mining economy and government-sector paths as legitimate directions, not fallbacks",
    body: "A counsellor who only measures success by a metro-style tech or corporate offer is missing a real share of Raipur's genuinely stable, well-paying work in steel, power, mining, and public administration. The guidance should evaluate a path on its actual merits for you, not its resemblance to a metro-city career.",
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'Explore other city-specific guidance pages if you want to compare before committing.',
  },
  {
    href: BOFU_INTERNAL_LINKS.nagpurCounselling,
    title: 'Career Counselling in Nagpur',
    description: 'Useful if you are also weighing Nagpur\'s MIHAN logistics-and-aerospace growth alongside a Raipur-area decision.',
  },
  {
    href: BOFU_INTERNAL_LINKS.chandigarhCounselling,
    title: 'Career Counselling in Chandigarh',
    description: 'Useful for comparing an older, already-settled planned-capital identity against Raipur and Naya Raipur\'s still-forming one.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'Use the main counselling page if the city matters less than the overall need for clarity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'Use the main guidance page when the core issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Raipur instead of only looking for a nearby offline option?',
    answer:
      "Because proximity alone does not resolve Raipur's real fork - a medical or allied-health path through AIIMS Raipur, a management or IT-SEZ path through Naya Raipur, an engineering or operations path through the Bhilai steel-and-power belt, or a government-administration route in a state still building out its own institutions. Online guidance lets you start from home, from NIT Raipur or Pandit Ravishankar Shukla University, or from work near Naya Raipur or Durg-Bhilai, and it should still be judged on whether it gives you a clear, specific answer for your situation.",
  },
  {
    question: 'Should I aim for AIIMS Raipur, Naya Raipur\'s IT-SEZ and IIM Raipur route, or the steel-and-power belt around Bhilai?',
    answer:
      "That depends on your own aptitude, interests, and family situation, not on which option sounds most impressive locally. These are three genuinely different preparation paths with different timelines. Good counselling should map your actual fit against Raipur's real, current mix rather than pushing you toward whichever direction is loudest in conversation right now.",
  },
  {
    question: 'Is a degree from a young state like Chhattisgarh, or from a Raipur college, taken less seriously elsewhere?',
    answer:
      'Not inherently - institutions like NIT Raipur, AIIMS Raipur, and IIM Raipur\'s Atal Nagar campus stand on their own merit. What matters more in a market with a thinner, still-forming professional network is pairing the degree with visible proof of work, since that carries more weight where alumni density and informal referral networks are still building up.',
  },
  {
    question: 'Does staying close to family in Raipur or Durg-Bhilai limit my career options?',
    answer:
      "Not automatically. Raipur and its surrounding belt carry genuine depth across steel and power engineering, mining and mineral-processing, AIIMS Raipur's medical pathway, IIM Raipur's management route, and a still-growing state administration. The more useful question is whether your current skill direction is strong enough to grow from where you are, independent of the stay-or-move decision in the abstract.",
  },
  {
    question: 'Is the steel, power, and mining economy around Raipur and Bhilai still a real career path, or mostly manual industrial work?',
    answer:
      "It is a genuine, large employer of engineers, plant-operations staff, metallurgists, power engineers, and supply-chain and quality professionals, not only manual or entry-level roles. Whether it fits you depends on your specific interests and technical aptitude, which is exactly what counselling should help clarify before you commit years to preparing for it.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free, updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Raipur?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so it works whether you are based in Raipur, Naya Raipur, or the Durg-Bhilai belt, or weighing a move elsewhere.',
  },
  {
    question: 'What if I searched for Raipur but the bigger issue is not the city at all?',
    answer:
      "That is common - a city search is often a trust shortcut. If the real pressure is stream selection, degree choice, skill direction, or a career change rather than location, the main counselling and guidance pages are the stronger next filter. This page is most useful when local context - AIIMS Raipur, Naya Raipur, the steel-power-mining belt, or Chhattisgarh's still-forming professional identity - is genuinely part of your decision.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      { '@type': 'ListItem', position: 5, name: 'Career Counselling in Raipur', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Raipur | Future Career School',
    description:
      "Career counselling in Raipur for students, freshers, and working professionals. Online guidance for the medical, management, and industrial-engineering forks shaping careers in Chhattisgarh's young state capital.",
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: [
      { '@type': 'City', name: 'Raipur' },
      { '@type': 'Country', name: 'India' },
    ],
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Raipur</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Raipur
      </div>

      <h1 class="hero-title">
        Career counselling in Raipur
        <span class="gold-text"> for a state still building its own identity</span>
      </h1>
      <p class="hero-sub">
        Chhattisgarh became one of India's newest major states only in November 2000, and Raipur is still writing what a serious career here
        actually looks like rather than simply inheriting a script decades old. The city's real economy runs on steel, power, and mining - the
        Bhilai Steel Plant just outside the city in Durg, a dense NTPC and coal-fired thermal-power corridor, and one of India's richest iron-ore
        and mineral belts - alongside a genuinely new medical anchor in AIIMS Raipur and a management-and-administrative anchor in IIM Raipur and
        the state secretariat inside Naya Raipur (Atal Nagar). Good career counselling here should help you build the kind of high-value skill
        portfolio that keeps unlocking high income opportunities in that specific mix, not recite advice written for a metro with decades of
        settled professional culture already behind it.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Raipur and across India. You can start from home, from NIT Raipur or Pandit Ravishankar Shukla
        University, or from work near Naya Raipur or the Durg-Bhilai belt - no travel required before the underlying skill direction is even clear.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not whether Chhattisgarh's growth story sounds promising in general. It is whether your specific skill direction
        already has a real opening in Raipur's steel-power-mining economy, its newer medical and management layer, or needs a bigger metro's
        density first, and moving you toward earlier financial freedom from wherever that answer actually points.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="raipur-career-landscape"
    title="The Raipur career reality generic state-capital advice misses"
    subtitle="Raipur is a genuine state capital, but a young one - and its economy is more layered than a 'mining state, government jobs' shorthand suggests. Good career counselling should help you build the high-value skill portfolio that unlocks high income opportunities from whichever of these real paths actually fits you."
    items={raipurContextItems}
    variant="signal"
  />

  <BofuListCardSection
    sectionId="young-state-identity"
    title="Building a career in a state that is still building itself - the fork most Raipur searches are really about"
    subtitle="This is the real question behind most Raipur searches, and it has no equivalent framing anywhere else on this site: whether to build toward the steel-power-mining economy, the newer AIIMS-and-IIM-anchored medical and management layer, or a government-administration path in a state that has only existed for about 25 years."
    items={youngStateItems}
    variant="contrast"
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="How this approach differs from typical career counselling"
    subtitle="In a state capital where the mining-and-government reputation and the newer AIIMS-and-Naya-Raipur growth story both hold some truth, the risk is generic advice that only knows one script. The comparison below shows what separates high-leverage guidance from that."
    rows={raipurComparisonRows}
  />

  <ContextualCta
    audience="mixed"
    title="If the AIIMS-vs-Naya-Raipur-vs-industrial-belt question already feels urgent, resolve it before more time goes into the wrong bet"
    body="Use this when you want a decision that moves you toward earlier financial freedom, not another year of guessing which of Raipur's three real paths actually fits you."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="raipur-areas"
    title="Raipur's geography shapes the decision, not just the commute"
    subtitle="A useful local page should feel grounded in how people actually live, study, and work across Raipur and its surrounding belt, not treat every search as coming from the same part of the city."
    items={raipurAreaItems}
    variant="decision"
  />

