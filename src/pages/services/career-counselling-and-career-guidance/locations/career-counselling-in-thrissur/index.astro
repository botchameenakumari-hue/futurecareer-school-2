---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: every drop combination is claimed by a sibling, so this page keeps all six library rows and relies on page-specific extra rows tied to the gold, finance and Koratty questions below.
const comparisonRows = BOFU_COMPARISON_LIBRARY;

const title = "Career Counselling in Thrissur | Practical Online Guidance | Future Career School";
const description = "Career counselling in Thrissur: gold and jewellery trade, banking and finance, Koratty industry and Infopark, or Gulf work. Online across India.";
const canonical = "https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-thrissur/";

const fitItems = [
  {
    "title": "What you actually need right now",
    "listItems": [
      "You want support that feels easier to trust and easier to start.",
      "You want clarity before choosing between a family trade, banking or finance work, an industrial job or a move to a bigger city.",
      "You want something more practical than a relative advising by habit or a coaching-centre pitch.",
      "You want a real next step toward a high-value skill portfolio, not only motivational talk."
    ]
  },
  {
    "title": "What should matter more than city alone",
    "listItems": [
      "Whether gold, lending and trade routes are compared honestly with technology routes",
      "Whether the Koratty industrial and Infopark option gets a fair look",
      "Whether the plan still works if you move to Kochi, Bengaluru or abroad"
    ]
  }
];
const fitSummaryItems = [
  {
    "title": "Closer should still mean clearer",
    "body": "Thrissur has trade, finance, industry and culture-linked routes; nearness does not choose between them."
  },
  {
    "title": "Quality before convenience",
    "body": "Each route asks for different skills and different capital, so compare them first."
  },
  {
    "title": "Act before the wrong turn compounds",
    "body": "Taking the family-default path without testing it is the cost of waiting."
  }
];
const localItems = [
  {
    "title": "Gold, jewellery and retail: the district is a national name in the trade",
    "body": "Thrissur is widely described as a centre of Kerala's gold business. Jewellery groups such as Kalyan Jewellers, Joyalukkas, Josco and Chemmanur have roots here, and gold and diamond manufacturing units cluster in places such as Kapiparambu, Tholur, Adat and Choondal. The work is not only retail floors: it includes design, hallmarking and quality control, accounts, supply chain, inventory, marketing and increasingly digital sales. A family trade is a real route, and a stronger one when the next generation adds data, finance or e-commerce skills."
  },
  {
    "title": "Banks, NBFCs and kuri companies: a finance economy",
    "body": "Several banks trace their headquarters to Thrissur, including South Indian Bank, Dhanlaxmi Bank, CSB Bank and ESAF Small Finance Bank, along with Manappuram Finance and the Kerala State Financial Enterprise (KSFE), which runs chit schemes. This makes banking, credit, collections, compliance and fintech operations visible local careers. Recruitment is usually through formal notices and exams, so check each employer's current rules, and build a backup skill while attempts are ongoing."
  },
  {
    "title": "Koratty, Infopark Thrissur and the institutes",
    "body": "The Koratty belt hosts a KINFRA industrial park and Infopark Thrissur, and the district includes plants such as Carborundum Universal at Koratty and Apollo Tyres at Perambra, the Oushadhi ayurvedic manufacturer at Kuttanellur, and tile-making clusters around Ollur, Puthukkad and Amballur. The Kerala Agricultural University and Kerala Kalamandalam add agricultural science and performing-arts routes. Infopark Thrissur is smaller than Kochi's, so many IT-minded graduates compare a local role with Kochi or remote options."
  },
  {
    "title": "Pay, cost and competition: what to plan for",
    "body": "A family trade can give early responsibility and a stable base, but personal income depends heavily on the business cycle and on the gold price. Bank and NBFC recruitment is competitive and exam-driven, and entry pay in local service roles is often modest until skills compound. Treat any figure you hear as unverified until it appears in an offer letter or on an employer's own careers page, and keep a skill running that earns if one attempt or one season goes badly."
  }
];
const localSummaryItems = [
  {
    "title": "Trade and finance first, technology on top",
    "body": "Gold, lending and trade give many families a base; the useful question is what skill added to that base raises income fastest."
  }
];
const forkItems = [
  {
    "title": "The decisions worth separating",
    "listItems": [
      "Joining or modernising a family gold, textile or trade business versus outside employment",
      "A banking or NBFC career versus a technology route",
      "A Koratty industrial or Infopark role versus moving to Kochi or Bengaluru",
      "Agriculture, ayurveda or arts-linked study versus a mainstream professional course"
    ]
  },
  {
    "title": "What deliberate planning adds",
    "listItems": [
      "A skill choice matched to what local firms and banks really hire for",
      "A fair view of capital, risk and control in a family business",
      "A backup plan if a bank exam or entrance test does not clear",
      "Proof of work that employers outside Kerala can verify"
    ]
  }
];
const forkSummaryItems = [
  {
    "title": "Four routes, one decision",
    "body": "The useful question is which combination fits your strengths and your family situation, not which route is most familiar."
  }
];
const areaItems = [
  {
    "title": "Swaraj Round, Poothole and Round South",
    "body": "The city core, with jewellery showrooms, banks, textile shops and the Thrissur Pooram ground nearby."
  },
  {
    "title": "Punkunnam, Ayyanthole and Kuriachira",
    "body": "Residential and commercial belts with textile, coaching and service businesses."
  },
  {
    "title": "Ollur, Mannuthy and Vellanikkara",
    "body": "Tile clusters, the agricultural-university area and a large student population."
  },
  {
    "title": "Kapiparambu, Tholur, Adat and Choondal",
    "body": "Gold and diamond manufacturing areas, where jewellery production and design are concentrated."
  },
  {
    "title": "Koratty and Perambra",
    "body": "The industrial and IT side: the KINFRA park, Infopark Thrissur and plants such as Carborundum Universal and Apollo Tyres."
  },
  {
    "title": "Irinjalakuda, Chalakudy and Guruvayur",
    "body": "Neighbouring towns with their own trade, temple-economy and small-industry opportunities, many within daily travel of the city."
  }
];
const cityDecisionItems = [
  {
    "title": "Choose local-first support when trust is the real blocker",
    "listItems": [
      "You are more likely to act if the search feels closer and easier to trust",
      "You want to weigh a family trade, banking, industry and a move out before deciding",
      "You need one practical next step, not a long career-theory discussion first",
      "You are using the city search to reduce hesitation, not because Thrissur itself resolves the decision"
    ]
  },
  {
    "title": "Choose broader guidance when the decision itself is the bigger problem",
    "listItems": [
      "You are choosing between a family trade and an outside career",
      "You are considering Kochi, Bengaluru or the Gulf and want to compare it with staying",
      "You can meet online from anywhere in Kerala",
      "You need risk, timelines and income compared"
    ]
  }
];
const cityDecisionSummaryItems = [
  {
    "title": "Use the city label as a trust shortcut",
    "body": "A Thrissur search can start the conversation, not end it."
  },
  {
    "title": "Let decision quality decide the next step",
    "body": "Pick the route that makes trade, finance, industry or migration a clear decision."
  }
];
const deliverableItems = [
  {
    "title": "Clarity on the real decision creating pressure right now",
    "listItems": [
      "Whether to join, modernise or step away from a family trade",
      "Whether a banking attempt or a technology route is stronger for you",
      "What your income trajectory looks like on the current path",
      "Which expensive wrong turn is most urgent to stop repeating"
    ]
  },
  {
    "title": "Skill direction tied to Thrissur's actual economy",
    "listItems": [
      "Accounts, finance and analytics skills if banking or lending fits",
      "Digital sales, design or e-commerce skills if a jewellery or retail route fits",
      "Software, data or automation skills if an IT route fits",
      "A clearer route toward earlier financial freedom from your starting point"
    ]
  },
  {
    "title": "A lower-friction way to start moving",
    "listItems": [
      "A comparison of the routes you are already considering",
      "A target and the qualification each one needs",
      "One next step, with a backup in place"
    ]
  }
];
const onlineAdvantageItems = [
  {
    "title": "You can start from home, hostel, shop or workplace",
    "body": "Sessions run online, so a busy showroom or a college timetable never decides whether you can attend."
  },
  {
    "title": "Online guidance can include the whole family",
    "body": "Parents who run the business, and relatives abroad, can join the same call and hear the same comparison."
  },
  {
    "title": "The stronger comparison is generic versus genuinely useful",
    "body": "Outside advice can compare Thrissur with Kochi, Bengaluru and overseas options without a local bias."
  }
];
const objectionItems = [
  {
    "title": "Our family trade is steady. Why add a skill or look elsewhere?",
    "body": "A good plan can still join the trade. The question is which added skill (finance, data, digital sales) raises its income or gives you a stronger fallback."
  },
  {
    "title": "Bank and NBFC jobs look secure here. Is a technology route worth the risk?",
    "body": "Both are legitimate. Banking has formal recruitment and competition; technology rewards proof of work. A plan can run a bank attempt with a technology backup instead of choosing blindly."
  },
  {
    "title": "Infopark Thrissur is small. Should I move to Kochi or Bengaluru for IT?",
    "body": "That depends on cost, family needs and remote-work options. The plan should compare a local role, a Kochi role and a remote role with real costs."
  }
];
const prepItems = [
  {
    "title": "The real decision you need to solve first",
    "body": "Bring the question creating pressure right now, whether that is the family trade, a bank exam, an IT move or a Gulf plan."
  },
  {
    "title": "The serious options you are already considering",
    "body": "Write down the two to four routes you are comparing so the trade-offs are visible from the start."
  },
  {
    "title": "What feels risky, delayed or expensive",
    "body": "Be clear about what you do not want to repeat: a wrong course, a family-pressure default or more time lost in confusion."
  },
  {
    "title": "The constraints that cannot be ignored",
    "body": "Include budget, family expectations, business obligations, exam-attempt limits and any migration timeline early."
  }
];
const buyerCheckItems = [
  {
    "title": "Check whether the counsellor understands Thrissur's trade and finance economy",
    "body": "Gold, lending and family enterprise are real local routes. Good guidance should weigh them seriously, not treat everyone as a future IT employee."
  },
  {
    "title": "Check whether a bank-exam attempt gets an honest backup plan",
    "body": "Good guidance should be clear about competition and build a backup skill while attempts are ongoing."
  },
  {
    "title": "Check whether the next move is realistic",
    "body": "Good guidance names entry rules, competition and what skill-building works from your actual starting point."
  }
];
const extraRows = [
  {
    "left": "Treating gold, lending and trade families as if they had no career options to compare",
    "right": "A fair comparison of the family trade, finance work and technology routes"
  },
  {
    "left": "A bank-exam plan with no backup skill while attempts continue",
    "right": "A plan that runs the attempt alongside a skill that earns if it does not clear"
  }
];

const relatedItems = [
  { href: BOFU_INTERNAL_LINKS.guidanceLocations, title: "Career Guidance by Location", description: "See other city guidance options if you want to compare before deciding further." },
  { href: BOFU_INTERNAL_LINKS.kochiCounselling, title: "Career Counselling in Kochi", description: "See Kochi's page if a larger IT, port and industrial market is closer to your plan." },
  { href: BOFU_INTERNAL_LINKS.kozhikodeCounselling, title: "Career Counselling in Kozhikode", description: "See Kozhikode's page if a trade-and-institute city in North Kerala fits your situation." },
  { href: BOFU_INTERNAL_LINKS.careerCounselling, title: "Career Counselling", description: "See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone." },
  { href: BOFU_INTERNAL_LINKS.careerCounsellingOnline, title: "Career Counselling Online", description: "See the online page if easier access across India matters more than city-based search wording." },
  { href: BOFU_INTERNAL_LINKS.parentGuidance, title: "Broader Career Guidance", description: "See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search." },
];

const faqItems = [
  {
    "question": "Why choose online career counselling in Thrissur instead of only looking for a nearby office?",
    "answer": "Because the decision depends on your path and odds, not on an office near Swaraj Round. Online sessions fit around classes, the shop or a job and are available in Thrissur and across India."
  },
  {
    "question": "Can counselling help me decide between the family jewellery or trade business and an outside career?",
    "answer": "Yes. The comparison looks at capital, risk, control, learning and which added skill makes either route stronger, rather than assuming one answer."
  },
  {
    "question": "Is a banking or NBFC career a realistic target from Thrissur?",
    "answer": "It is a real route because several banks and lenders are headquartered in the district, but recruitment is competitive and formal. A plan should include a backup skill."
  },
  {
    "question": "Can this help students, freshers and working professionals in Thrissur?",
    "answer": "Yes. Students, freshers, business families and professionals in Thrissur and nearby towns can use it. Sessions run online across India."
  },
  {
    "question": "Do you guarantee a job, a bank placement or a Gulf offer?",
    "answer": "No ethical provider can guarantee any of these outcomes. The practical goal is better decision quality, stronger skill direction and a clearer path forward."
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      { '@type': 'ListItem', position: 3, name: 'Career Counselling and Career Guidance', item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/' },
      { '@type': 'ListItem', position: 4, name: 'Locations', item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/' },
      { '@type': 'ListItem', position: 5, name: "Career Counselling in Thrissur", item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: "Career Counselling in Thrissur | Future Career School",
    description: "Career counselling in Thrissur for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.",
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: "Thrissur" },
    inLanguage: 'en-IN',
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance/">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Thrissur</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Thrissur
      </div>

      <h1 class="hero-title">
        Career counselling in Thrissur
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Thrissur is known as Kerala's cultural capital and as its gold and finance centre. Jewellery groups, several banks and non-banking lenders, kuri (chit) companies, tile and textile units, the Koratty industrial area with Infopark Thrissur, and the Kerala Agricultural University all sit in one district. Generic advice online misses how many families here run on gold, lending or trade. If you are at a real decision point, the goal is to get clear before more time goes the wrong way, and to build the high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Thrissur and across India. You can start from home near Swaraj Round, a hostel in Mannuthy, a flat in Ollur or your workplace, with no travel and no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Thrissur. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Thrissur search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="local-economy"
    title="What the Thrissur job market is actually built on"
    subtitle="A useful local page starts from the employers and trades that really exist in the district, and from what each one asks of a new entrant."
    items={localItems}
    variant="decision"
  >
    <BofuSummaryStrip items={localSummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="local-routes"
    title="Thrissur puts four serious routes in front of one student"
    subtitle="These are the real choices people in the district discuss, and each deserves a straight comparison."
    items={forkItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={forkSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="thrissur-areas"
    title="Thrissur's areas point to different real decisions"
    subtitle="Where you live and study often decides which opportunities feel reachable. The areas below are the ones students and professionals here usually mention."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Thrissur-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a city with this many credible-looking paths, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={comparisonRows}
    extraRows={[
      ...extraRows,
      { left: "Choosing a counsellor only because their office is in Thrissur", right: "Live online sessions from Thrissur, with the same process wherever you are" },
    ]}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Thrissur"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Thrissur"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio backed by the decisions that unlock high income opportunities whether your path runs through trade, finance, industry, technology, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
