---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS, BOFU_PAYMENT_LINKS } from '../../../../config/bofu';

const locationItems = [
  {
    href: BOFU_INTERNAL_LINKS.visakhapatnamCounselling,
    title: 'Career Counselling in Visakhapatnam',
    description:
      'For students, freshers, and working professionals in Visakhapatnam who want clearer direction without wasting more time on generic advice.',
  },
  {
    href: BOFU_INTERNAL_LINKS.rajkotCounselling,
    title: 'Career Counselling in Rajkot',
    description:
      'For students, freshers, and working professionals in Rajkot who want practical guidance before making expensive decisions.',
  },
];

const supportItems = [
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Career Counselling and Guidance',
    description:
      'Use the broader guidance page if the city is less important than the overall career decision itself.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description:
      'See the broader counselling page when you want clarity-first support beyond the city-specific search.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description:
      'Use the online-intent page if your main concern is flexible access across India rather than city intent.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Career Counselling and Guidance by Location | Future Career School',
    description:
      'City-intent career counselling and guidance pages for people who want location-aware support without losing the online-first, India-wide guidance model.',
    url: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations',
    inLanguage: 'en-IN',
    publisher: {
      '@type': 'EducationalOrganization',
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
];
---

<BaseLayout
  title="Career Counselling and Guidance by Location | Future Career School"
  description="Explore city-intent career counselling and guidance pages for students, freshers, and working professionals who want location-aware clarity without depending on generic local advice."
  canonical="https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations"
  jsonLd={jsonLd}
>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Locations</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Location-intent guidance within the main career support branch
      </div>

      <h1 class="hero-title">
        Career Counselling and Guidance
        <span class="gold-text"> by Location</span>
      </h1>
      <p class="hero-sub">
        Some people search by city because they want support that feels closer, more reachable, and easier to trust.
        The better filter is not only locality. It is whether the guidance improves decision quality, skill direction, proof of work, and long-term growth.
      </p>
      <p class="hero-sub hero-sub-secondary">
        Guidance is delivered online across India, so location pages should help people compare fit and context without trapping them inside weak local-only assumptions.
      </p>
      <div class="hero-actions">
        <a href={BOFU_PAYMENT_LINKS.students} class="btn-gold pulse">Get Student Career Guidance</a>
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="city-pages"
    title="City-Specific Career Guidance Pages"
    subtitle="Open the city page that matches your search intent, then compare the next step based on clarity, practical value, and decision quality."
    items={locationItems}
  />

  <LinkDirectorySection
    sectionId="city-support-pages"
    title="Broader Guidance Pages"
    subtitle="If the city matters less than the decision itself, these broader guidance pages are the stronger next filter."
    items={supportItems}
    altBackground={true}
  />

  <section id="cta">
    <div class="container">
      <div class="cta-inner card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <div class="pill cta-pill">Next step</div>
          <h2 class="cta-title">Choose the stronger next move</h2>
          <p class="cta-sub">
            Start with the city page if local search intent matters. If the bigger issue is the career decision itself, move straight into the broader guidance path.
          </p>
          <div class="cta-actions">
            <a href={BOFU_INTERNAL_LINKS.visakhapatnamCounselling} class="btn-gold pulse">Explore Visakhapatnam Guidance</a>
            <a href={BOFU_INTERNAL_LINKS.parentGuidance} class="btn-outline">Explore Broader Career Guidance</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 1rem; }
  .hero-sub-secondary { color: rgba(255,255,255,.64); margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  #cta { padding: 6rem 0 7rem; }
  .cta-inner { position: relative; overflow: hidden; padding: 3.25rem; text-align: center; border-color: rgba(229,184,74,.14); background: rgba(229,184,74,.02); }
  .cta-glow { position: absolute; inset: 0; background: radial-gradient(circle at 50% 0%, rgba(229,184,74,.16), transparent 60%); pointer-events: none; }
  .cta-content { position: relative; z-index: 1; }
  .cta-pill { margin: 0 auto 1.4rem; width: fit-content; color: rgba(255,255,255,.55); }
  .cta-title { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 900; letter-spacing: -.03em; color: #fff; margin-bottom: .9rem; }
  .cta-sub { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.75; max-width: 620px; margin: 0 auto 2.25rem; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 680px) {
    #hero { padding: 120px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
    .cta-inner { padding: 2.25rem 1.5rem; }
    .cta-actions { flex-direction: column; align-items: stretch; }
    .cta-actions .btn-gold, .cta-actions .btn-outline { justify-content: center; }
  }
</style>
