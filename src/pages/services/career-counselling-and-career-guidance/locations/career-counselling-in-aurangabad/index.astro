import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from "../../../../../config/bofu";

// Aurangabad (Chhatrapati Sambhajinagar) drops the "generic advice vs
// high-leverage decision support" row (index 0) and the "generic low-paying
// path advice vs higher-value skill direction" row (index 4) - both framings
// are too generic against this page's own named, specific forks (Marathwada
// farm-income volatility, the Waluj/Chikalthana auto-ancillary and pharma
// cluster, and the Ajanta-Ellora heritage-tourism economy), so the page's own
// sections already carry that ground more precisely than either row would.
// This combination (drops 0 and 4) is not used by any sibling: Rajkot (rows
// 0-4), Vizag (rows 1-5), Bangalore (full library), Pune (drops 3), Kolkata
// (drops 1), Chennai (drops 5), Hyderabad (drops 2), Mumbai/Chandigarh/
// Gurgaon/Nagpur (each drop 4), Delhi (drops 0 and 5), Ahmedabad (drops 3 and
// 5), Surat (drops 0 and 3), Thane/Vadodara (drop 1 and 3), Ludhiana (drops 1
// and 4), Guwahati (drops 2 and 4), Jalandhar (drops 2 and 5), and Raipur
// (drops 2 and 3).
const aurangabadComparisonRows = BOFU_COMPARISON_LIBRARY.filter((_, index) => index !== 0 && index !== 4);

const title = "Career Counselling in Aurangabad (Chhatrapati Sambhajinagar) | Future Career School";
