const faqItems = [
  {
    question: "Why choose online career counselling in Aurangabad instead of only looking for a nearby offline option?",
    answer:
      "Because proximity alone does not resolve Aurangabad's real fork - a stable professional path versus continued dependence on volatile farm income, a role inside the Waluj-Chikalthana auto-ancillary and pharma cluster, or a genuine heritage-tourism direction around Ajanta and Ellora. Online guidance lets you start from home, from Dr. Babasaheb Ambedkar Marathwada University or another campus, or from work near Waluj or Chikalthana, and it should still be judged on whether it gives you a clear, specific answer for your situation.",
  },
