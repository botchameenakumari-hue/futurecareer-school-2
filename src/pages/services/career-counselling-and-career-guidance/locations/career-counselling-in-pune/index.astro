const localIntentItems = [
  {
    title: 'Pune pulls in students from across India - and then hands them a real decision',
    body: 'Pune has one of India\'s largest student populations, drawn by institutions like COEP Technological University, Fergusson College, Symbiosis, MIT-WPU, Pune Institute of Computer Technology, Bharati Vidyapeeth, Sinhgad, and Savitribai Phule Pune University. Thousands arrive every year from Maharashtra, other states, and abroad for engineering, commerce, and MBA programmes. What rarely gets addressed is the decision that follows graduation: stay in Pune and build a career here, return to a home city, or move on to Bangalore, Mumbai, or Hyderabad. That decision deserves an actual answer, not a default.',
  },
  {
    title: 'The automotive-vs-IT fork is a genuinely Pune-specific decision',
    body: 'Pune runs on two very different engines at once. The Pimpri-Chinchwad and Chakan belt carries the automotive and manufacturing base - Tata Motors, Bajaj Auto, Mahindra & Mahindra, Force Motors, and hundreds of ancillary and component suppliers, alongside the Automotive Research Association of India (ARAI). The Hinjewadi, Magarpatta, Kharadi, and Viman Nagar belt carries the IT and services base - Infosys, TCS, Wipro, Cognizant, and Pune-headquartered Persistent Systems, among others. A mechanical or production engineering graduate genuinely has to choose between staying on the core automotive/manufacturing track or pivoting into software, data, or IT-enabled roles - and that choice changes the skills, the location, and the income curve for the next several years. Entry-level roles across both tracks typically start in a similar range locally; the gap opens later, based on which skill direction is built with intent.',
  },
  {
    title: 'The Bangalore and Mumbai pull is real - but it is not the only path from Pune',
    body: 'Many Pune-based professionals feel pressure to move to Bangalore for "real" tech roles, or to Mumbai for finance and media. That can be the right call for some paths. But Pune\'s own IT corridor, its manufacturing R&D base, and strong remote-first digital skills mean the stay-vs-move decision deserves actual analysis - not an assumption that the bigger city is automatically better.',
  },
  {
    title: 'The outcome should be a sharper next move tied to your actual situation',
    body: 'Good counselling should leave you with a smaller, more serious shortlist and one practical next step you can actually use - one that accounts for Pune\'s real job market and its two-track economy, not a generic template written for a single-industry city.',
  },
];

const autoVsItItems = [
  {
    title: 'The automotive and manufacturing track',
    listItems: [
      'Rooted in the Pimpri-Chinchwad and Chakan belt, close to Tata Motors, Bajaj Auto, Mahindra & Mahindra, Force Motors, and a dense component and ancillary supplier base',
