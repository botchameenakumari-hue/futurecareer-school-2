const puneAreaItems = [
  {
    title: 'Pune decisions often come from very different parts of the city',
    body: 'Someone based around Hinjewadi, Baner, Aundh, or Wakad is usually inside the IT-corridor bubble - long commutes, high rent, and a career track built around software and services employers. Someone based around Pimpri, Chinchwad, Chakan, or Bhosari is closer to the automotive and manufacturing belt - a different pace, different employer base, and a different skill ladder. Someone around Kothrud, Deccan Gymkhana, Shivajinagar, FC Road, or Camp is closer to the older education and coaching-institute core of the city. Someone around Kharadi, Magarpatta, Viman Nagar, or Wagholi is often balancing a mixed IT-and-corporate landscape with a longer commute from student housing. Good counselling should feel grounded in that spread instead of treating Pune like one flat generic location.',
  },
  {
    title: 'Different areas often point to different opportunity clusters and pressures',
    body: 'The IT corridor pulls toward software, product, and analytics roles with metro-level pay ceilings but metro-level living costs. The Pimpri-Chinchwad and Chakan belt pulls toward core engineering, production, quality, and supply-chain roles with a lower cost of living but a different income curve. The older central areas stay closer to competitive-exam coaching, government-job preparation, and general commerce and arts routes. That is why local clarity matters: the stronger next move should reflect where you are actually starting from and which of Pune\'s tracks is realistically within reach.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question that is creating pressure right now, whether that is course choice, stream confusion, the automotive-vs-IT fork, a relocation call, career change, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
