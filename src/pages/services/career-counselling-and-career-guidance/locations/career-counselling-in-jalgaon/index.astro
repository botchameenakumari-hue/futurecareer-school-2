---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: all 15 two-row drop combinations from this 6-row
// library are already claimed by existing siblings (see the tracking note
// in career-counselling-in-agra/index.astro), so this page uses the unused
// three-row drop (0, 4, 5), keeping rows 1, 2, and 3 - the ones most
// relevant to the banana-and-bullion-trade-vs-formal-skill fork below.
const jalgaonComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 0 && index !== 4 && index !== 5,
);

const title =
  'Career Counselling in Jalgaon | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Jalgaon for students, freshers, and working professionals weighing the banana-trade agribusiness economy, the gold and bullion trading base, or a formal skill-first career.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-jalgaon/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before committing to a family agribusiness or bullion-trade role, or a formal degree path.',
      "You want something more practical than a relative's opinion or a WhatsApp forward about which government exam to attempt.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const bananaTradeItems = [
  {
    title: "Jalgaon runs a genuinely unique agribusiness economy: India's largest banana-growing belt",
    body: "Jalgaon district, especially the Raver-Yawal-Muktainagar belt along the Tapi river, is widely recognised as India's largest banana-cultivation and trading region, with a real ripening, cold-storage, and export-logistics chain built around it. That creates a specific career fork a generic guidance page never addresses: whether to build formally toward agribusiness management, food-processing technology, cold-chain logistics, or agri-export operations on top of this local base, or to build a different skill path while family land or trade continues in the background.",
  },
  {
    title: 'Formal agribusiness and food-technology skill beats informal trade knowledge alone',
    body: "A career built on Jalgaon's banana economy still benefits from real agribusiness, food-processing, cold-chain, or agri-export skill - not just growing up around the trade. Building a genuine skill and certification layer on top of local knowledge, rather than assuming familiarity with the crop cycle is enough on its own, is what actually moves someone toward earlier financial freedom from here.",
  },
];

const bananaTradeSummaryItems = [
  {
    title: 'This is not the same fork as Kolhapur or Nashik',
    body: "Kolhapur's cooperative sugar-and-jaggery economy and Nashik's grape-and-wine or aerospace tracks do not touch Jalgaon's banana-agribusiness base at all - it is a distinct crop economy with its own real career questions.",
  },
];

const bullionTradeItems = [
  {
    title: 'A second, genuinely distinct economy: gold and bullion trading',
    listItems: [
      "Jalgaon is widely known in the trade press as one of India's significant gold and bullion trading hubs, with a dense concentration of jewellery and bullion businesses relative to the city's size",
      'Family-run jewellery and bullion businesses often pass skill down informally, through apprenticeship rather than formal training',
      'Formal gemology, jewellery design, and bullion-trade compliance qualifications are increasingly what separates a growing business from a stagnant one',
      'Many young people from trade families are weighing whether to continue in the family business, formalise it with design or compliance skill, or build an unrelated skill path entirely',
    ],
  },
  {
    title: 'What a skill-first path can add to the same trade',
    listItems: [
      'Gemology, jewellery design, and CAD-based design skills can move a family business from pure trading toward higher-margin branded or design-led work',
      'Bullion-market compliance, hallmarking knowledge, and financial-market literacy open opportunities a purely trade-floor role does not',
      'Digital marketing and e-commerce skills matter here as much as in any family-trade economy',
      'For those leaving the trade, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const bullionTradeSummaryItems = [
  {
    title: 'Two real, unrelated local economies, one decision',
    body: 'The banana-agribusiness economy and the gold-and-bullion trade coexist in Jalgaon without overlapping - the useful question is which one, if either, actually fits your situation, not which is more visible.',
  },
];

const areaItems = [
  {
    title: 'The Tapi-belt talukas carry the banana and agribusiness economy',
    body: 'Raver, Yawal, Muktainagar, and the surrounding Tapi-river belt carry the banana-cultivation, ripening, and export-logistics economy described above.',
  },
  {
    title: "Jalgaon city's markets carry the bullion and jewellery trade",
    body: "The commercial core of Jalgaon city hosts the dense jewellery and bullion trading cluster, alongside general retail and services employment.",
  },
  {
    title: 'The wider district carries cotton and general agriculture alongside these two specialised economies',
    body: 'Beyond bananas and bullion, cotton cultivation and general agriculture remain a real, if less distinctive, part of the district economy for many families.',
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh a family agribusiness, bullion-trade, or formal-skill option before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the city search to reduce hesitation, not because the city itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'Family land, trade ties, or business succession matter more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the city label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether an agribusiness, food-processing, or cold-chain path fits your actual strengths',
      'Whether continuing or formalising a family bullion or jewellery business beats a formal salaried path',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Jalgaon's actual economy",
    listItems: [
      'Agribusiness, food-technology, or export-logistics skills if the banana economy fits your situation',
      'Gemology, design, or compliance skills if a family jewellery or bullion business is part of the picture',
      'A different high-value skill path if neither local economy fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, farm, shop, or workplace',
    body: 'Career counselling is available online in Jalgaon and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family and trade conversations, not compete with them',
    body: 'When family land or a jewellery-trade business is part of the picture, the harder conversations often need to include family. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: 'A nearby or local-sounding option can still leave you with generic advice that ignores the agribusiness or bullion-trade context you are actually weighing. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.',
  },
];

const objectionItems = [
  {
    title: 'Should I build my career around the family banana farm, or is agribusiness too unpredictable?',
    body: "That depends on the specific role and skill behind it - formal agribusiness management, food-processing, or export-logistics skill built on top of the family farming base can be a genuinely strong path. Continuing purely on informal trade knowledge, without a skill plan, is a weaker bet than it looks.",
  },
  {
    title: 'My family runs a jewellery or bullion business - should I continue it, formalise it, or leave it for a salaried job?',
    body: "This is rarely all-or-nothing. Many trade families are better served by adding design, gemology, or compliance skill on top of the existing business than by abandoning it outright, and for some a separate salaried skill path is genuinely the stronger route.",
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In a city where a family farm, a jewellery business, and a conventional skill path can all look equally "safe" from the outside, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is an agribusiness path, a family trade decision, stream confusion, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: a wrong stream, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, family expectations, land or business ties, and location limits early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Jalgaon's dual trade economy",
    body: 'Banana agribusiness and gold-and-bullion trading are two real, distinct local employers with their own skill requirements. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a family farm or trade is treated as an asset, not dismissed',
    body: 'A family banana farm or a jewellery business is a real starting asset, not a problem to escape by default. Better guidance should show what formalising or building on it can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether the next move fits your Jalgaon reality realistically',
    body: 'Good guidance for Jalgaon should be realistic about family and land or trade ties, and what skill-building genuinely works whether you stay close to the family base or build something new.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.kolhapurCounselling,
    title: 'Career Counselling in Kolhapur',
    description: "See Kolhapur's page if a cooperative-agribusiness fork is closer to your actual situation than Jalgaon's banana-and-bullion economy.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Jalgaon instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from home, farm, or shop without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'Can career counselling actually help with a decision about the family banana farm or agribusiness?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - what skills the specific role actually needs, what the real growth path looks like, and whether it fits your strengths, not only whether the family already farms bananas.",
  },
  {
    question: 'My family has a jewellery or bullion trading business. Should counselling assume I have to leave it?',
    answer:
      "No. Good counselling should treat an existing family trade business as a real asset and explore formalising it with gemology, design, or compliance skills, alongside the honest option of building a separate skill path if that genuinely fits better.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Jalgaon?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Jalgaon users.',
  },
  {
    question: 'Do you guarantee a job?',
    answer:
      'No ethical provider can guarantee a job. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Jalgaon',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Jalgaon | Future Career School',
    description:
      'Career counselling in Jalgaon for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: 'Jalgaon' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Jalgaon</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Jalgaon
      </div>

      <h1 class="hero-title">
        Career counselling in Jalgaon
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Jalgaon hands many people a genuinely different fork than most Indian cities: India's largest banana-growing and trading belt along the Tapi river, running alongside a dense, well-known gold and bullion trading economy in the city itself. Most career advice available online is written for a single generic city and misses both. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Jalgaon and across India. You can start from home, farm, shop, or work - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Jalgaon. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Jalgaon search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="banana-economy"
    title="The banana-trade agribusiness economy is Jalgaon's first real fork"
    subtitle="No other Indian city sibling runs on this crop economy - it deserves a specific answer, not a generic agriculture mention."
    items={bananaTradeItems}
    variant="decision"
  >
    <BofuSummaryStrip items={bananaTradeSummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="bullion-trade"
    title="The gold and bullion trade: a second, genuinely different economy"
    subtitle="A real family-trade economy under its own pressures, and a genuine choice between formalising the trade and building a different skill path."
    items={bullionTradeItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={bullionTradeSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="jalgaon-areas"
    title="Jalgaon's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Jalgaon district, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Jalgaon-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a city where a family farm, a jewellery business, and a conventional skill path can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={jalgaonComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Jalgaon"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Jalgaon"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through agribusiness, the bullion trade, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
