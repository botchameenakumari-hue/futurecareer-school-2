---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: all 15 two-row drops are already claimed by existing
// siblings (see the tracking note in career-counselling-in-agra/index.astro).
// This page uses the unused three-row drop (1, 4, 5), keeping rows 0, 2, and
// 3 - the rows most relevant to the Technopark-ISRO-vs-Gulf-migration fork
// below. Verified against every sibling file before publishing.
const trivandrumComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 1 && index !== 4 && index !== 5,
);

const title =
  'Career Counselling in Trivandrum | Practical Online Guidance | Future Career School';
const description =
  'Career counselling in Trivandrum for students, freshers, and working professionals weighing the Technopark IT economy, the ISRO/VSSC space-research and aerospace track, the Kerala PSC government-job path, or Gulf migration.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-trivandrum/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before committing to an IT career, a space-research or aerospace-engineering path, a Kerala PSC attempt, or a Gulf-migration plan.',
      "You want something more practical than a relative's opinion or a coaching-centre pitch about which government exam to attempt.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const highTechItems = [
  {
    title: 'Trivandrum runs a genuinely rare double economy: Technopark and ISRO, in one city',
    body: "Trivandrum hosts Technopark, one of India's earliest and largest IT parks, alongside the Vikram Sarabhai Space Centre and the Liquid Propulsion Systems Centre, both central to India's space programme. Very few Indian cities carry both a major private-sector IT hub and a major government space-research campus at this scale. That creates a specific career fork a generic guidance page never addresses: whether to build toward a Technopark-style IT and software career, a public-sector space-research or aerospace-engineering path through ISRO-linked institutes, or a different route entirely.",
  },
  {
    title: 'Formal, specific skill beats a vague "IT or engineering" plan',
    body: 'A Technopark-facing IT career and an ISRO-facing aerospace or space-research career need genuinely different preparation - one built around software, product, or IT-services skill, the other around specific engineering disciplines, research aptitude, and often a longer, exam-driven entry path. Getting clear on which track actually fits your strengths early saves years of unfocused preparation.',
  },
];

const highTechSummaryItems = [
  {
    title: 'This double base is specific to Trivandrum',
    body: 'Most Indian cities have either a strong IT-park economy or a major public-sector research campus, rarely both at this scale in the same city - it deserves a direct answer, not a generic "IT city" mention.',
  },
];

const gulfPscItems = [
  {
    title: 'A second, genuinely distinct pattern: Gulf migration and the Kerala PSC path',
    listItems: [
      "Gulf migration for work is a long-standing, well-established pattern across Kerala, and many Trivandrum families have direct experience with it, whether through a parent's, sibling's, or relative's income",
      'The Kerala Public Service Commission recruitment process is a widely pursued route into stable government employment, and preparing for it seriously is a real, multi-year commitment',
      "The Kerala Secretariat's presence in Trivandrum, as the state capital, adds a further local pull toward state-government administrative careers specifically",
      'Many young people in Trivandrum are weighing a Technopark or ISRO-linked technical career against a Gulf-migration plan or a Kerala PSC attempt, sometimes as parallel options rather than a single choice',
    ],
  },
  {
    title: 'What deliberate planning can add to either path',
    listItems: [
      'A Gulf-migration decision benefits from clarity on the specific trade or profession, realistic income expectations, and a return-and-reinvest plan, not just following family precedent',
      'A Kerala PSC attempt benefits from an honest look at preparation time, exam competition levels, and a backup plan while attempts are ongoing',
      'Digital and IT-adjacent skills increasingly matter even inside traditionally non-technical government or Gulf-linked roles',
      'For those choosing the Technopark or ISRO-linked track instead, the same high-value skill portfolio logic applies: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const gulfPscSummaryItems = [
  {
    title: 'Four real threads, one decision',
    body: 'IT-park careers, space-research and aerospace paths, Kerala PSC preparation, and Gulf migration all coexist as real options in Trivandrum - the useful question is which combination, if any, actually fits your situation.',
  },
];

const areaItems = [
  {
    title: 'Technopark and its surrounding sectors carry the IT and software economy',
    body: 'The Technopark campus and the IT-services companies around it carry the software, product, and IT-services job market described above.',
  },
  {
    title: 'The Thumba and VSSC-linked areas carry the space-research and aerospace economy',
    body: 'The Vikram Sarabhai Space Centre, the Liquid Propulsion Systems Centre, and the research institutes linked to them carry the space-research and aerospace-engineering economy.',
  },
  {
    title: 'The Secretariat and older city areas carry the state-administrative and PSC-preparation economy',
    body: "The Kerala Secretariat and the administrative offices around it, along with the coaching ecosystem that has grown around Kerala PSC preparation, carry the government-job economy many local families rely on.",
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh a Technopark career, an ISRO-linked path, a PSC attempt, or Gulf migration before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the city search to reduce hesitation, not because the city itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'A Gulf-migration decision or a multi-year PSC preparation plan matters more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the city label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether a Technopark-style IT career or an ISRO-linked space-research or aerospace path fits your actual strengths',
      'Whether a Kerala PSC attempt or a Gulf-migration plan is genuinely the stronger route for your situation',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Trivandrum's actual economy",
    listItems: [
      'Software, product, or IT-services skills if the Technopark economy fits your situation',
      'Specific engineering, research, or aptitude preparation if a space-research or aerospace path fits your situation',
      'A realistic PSC preparation plan or a well-researched Gulf-migration plan if either fits your situation better',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, hostel, workplace, or before a Gulf departure',
    body: 'Career counselling is available online in Trivandrum and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family conversations about Gulf migration or PSC attempts, not compete with them',
    body: 'When a Gulf-migration decision or a long PSC preparation timeline is part of the picture, the harder conversations often need to include family. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: "A nearby or well-known option can still leave you with generic advice that ignores Trivandrum's specific Technopark, ISRO, PSC, or Gulf-migration context. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.",
  },
];

const objectionItems = [
  {
    title: 'Should I aim for Technopark-style IT work or try for an ISRO-linked space-research career?',
    body: 'That depends on your actual strengths, interests, and appetite for a longer, research-and-exam-driven entry path versus a faster-moving IT-industry route - both are genuinely strong options in Trivandrum, and the honest answer depends on you, not on which sounds more prestigious.',
  },
  {
    title: 'My family wants me to try for Gulf migration like a relative did - is that still a good plan?',
    body: 'It can be, but it deserves the same structured thinking as any other career decision - which specific trade or profession, realistic income and cost comparisons, and a plan for what happens on return, rather than simply following family precedent.',
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In a city with this many credible-looking paths, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is an IT-versus-research decision, a PSC preparation plan, a Gulf-migration decision, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: a wrong stream, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, family expectations, exam-attempt limits, and migration timelines early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Trivandrum's dual high-tech base",
    body: 'Technopark and ISRO are two real, distinct local paths with very different preparation needs. Good guidance should engage with whichever applies to you seriously, not offer a generic "IT city" mention.',
  },
  {
    title: 'Check whether a Gulf-migration plan or PSC attempt gets a real, honest answer',
    body: 'Good guidance should help you plan a Gulf-migration decision or a Kerala PSC attempt with realistic numbers and timelines, not dismiss either option or assume it as an automatic default.',
  },
  {
    title: 'Check whether the next move fits your Trivandrum reality realistically',
    body: 'Good guidance for Trivandrum should be realistic about exam competition, migration costs and timelines, and family expectations, and what skill-building genuinely works given your specific situation.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.bangaloreCounselling,
    title: 'Career Counselling in Bangalore',
    description: "See Bangalore's page if a broader IT-industry career, rather than Trivandrum's specific Technopark-ISRO fork, is closer to your situation.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Trivandrum instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from home, hostel, or workplace without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'Can career counselling help me choose between a Technopark IT career and an ISRO-linked research career?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - your actual strengths, interests, and appetite for a research-and-exam-driven path versus a faster-moving IT-industry route, not just which option sounds more prestigious.",
  },
  {
    question: 'My family expects me to consider Gulf migration. Should counselling assume that is the wrong choice?',
    answer:
      "No. Good counselling should treat Gulf migration as a real, legitimate option worth planning properly - specific trade, realistic income comparison, and a return plan - alongside the honest option of a different path if that genuinely fits better.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Trivandrum?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Trivandrum users.',
  },
  {
    question: 'Do you guarantee a job, an ISRO seat, a PSC result, or a Gulf placement?',
    answer:
      'No ethical provider can guarantee any of these outcomes. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Trivandrum',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Trivandrum | Future Career School',
    description:
      'Career counselling in Trivandrum for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: 'Thiruvananthapuram' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Trivandrum</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Trivandrum
      </div>

      <h1 class="hero-title">
        Career counselling in Trivandrum
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Trivandrum hands many people a genuinely rare fork: Technopark, one of India's earliest and largest IT parks, sitting alongside the Vikram Sarabhai Space Centre and India's space-research programme, plus a long-standing Gulf-migration pattern and a widely pursued Kerala PSC government-job path. Most career advice available online is written for a single generic city and misses all four. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Trivandrum and across India. You can start from home, hostel, or workplace - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Trivandrum. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Trivandrum search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="high-tech-fork"
    title="Technopark and ISRO together are Trivandrum's first real fork"
    subtitle="No other Indian city sibling carries this exact combination - it deserves a specific answer, not a generic 'IT city' mention."
    items={highTechItems}
    variant="decision"
  >
    <BofuSummaryStrip items={highTechSummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="gulf-psc"
    title="Gulf migration and Kerala PSC: two more genuinely real paths"
    subtitle="Long-standing, well-worn local patterns that deserve honest planning, not automatic acceptance or dismissal."
    items={gulfPscItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={gulfPscSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="trivandrum-areas"
    title="Trivandrum's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Trivandrum, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Trivandrum-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a city with this many credible-looking paths, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={trivandrumComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Trivandrum"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Trivandrum"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through IT, space research, government service, Gulf migration, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
