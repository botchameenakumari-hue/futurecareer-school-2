  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const examEconomyItems = [
  {
    title: "Lucknow runs one of India's largest UP-specific state-government-exam coaching economies",
    body: "As the capital of Uttar Pradesh, Lucknow has built a genuinely large coaching industry around UPPSC, UP Police, UP judicial services, and teaching-eligibility exams like UPTET, with entire neighbourhoods built around this coaching cycle. That creates a specific fork a generic guidance page never addresses: whether to commit multiple attempt-years to a state-exam pipeline, aim at a different competitive-exam track, or build a different skill path while family expectations around a 'sarkari naukri' stay in the background.",
  },
  {
    title: 'A realistic attempt-and-backup plan beats an open-ended coaching cycle',
    body: "A state-exam attempt built around Lucknow's coaching economy still needs an honest, structured timeline - how many attempts, by when, and what happens if the exam does not work out. Treating the coaching cycle as the only plan, without a genuine backup direction, is a weaker bet than it looks and is exactly where structured guidance adds the most value.",
  },
];

const examEconomySummaryItems = [
  {
    title: 'This scale is specific to a state capital',
    body: "Very few cities carry Lucknow's density of UP-specific state-exam coaching institutes in one place - it deserves a direct, specific answer, not a generic exam-prep mention.",
  },
];

