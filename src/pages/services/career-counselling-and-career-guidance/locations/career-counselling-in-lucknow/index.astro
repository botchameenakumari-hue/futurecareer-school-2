];

const title =
  'Career Counselling in Lucknow | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Lucknow for students, freshers, and working professionals weighing Lucknow's large UPPSC and state-government-exam coaching pipeline against the city's genuine Chikankari embroidery and handicraft-export economy, or a state-secretariat administrative career.";
