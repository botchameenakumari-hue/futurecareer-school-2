    title: "Check whether the counsellor understands Lucknow's dual exam-and-craft economy",
    body: 'The UP state-exam coaching pipeline and the Chikankari handicraft-export economy are two real, distinct local paths with their own preparation needs. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a multi-attempt exam plan gets an honest, structured answer',
    body: 'Good guidance should help you plan a state-exam attempt with realistic timelines and a genuine backup plan, not treat repeated attempts as a guaranteed outcome.',
  },
  {
    title: 'Check whether the next move fits your Lucknow reality realistically',
    body: 'Good guidance for Lucknow should be realistic about exam-attempt timelines, handicraft-business growth ceilings, and family expectations, and what skill-building genuinely works given your specific situation.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.kanpurCounselling,
    title: 'Career Counselling in Kanpur',
    description: "See Kanpur's page if a different Uttar Pradesh manufacturing or trade economy is closer to your situation than Lucknow's exam-and-craft fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'See the main guidance page if the bigger issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
