const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before committing years to a UPPSC or state-exam coaching cycle, a Chikankari or handicraft-export path, or a state-secretariat administrative role.',
