];

const areaItems = [
  {
    title: 'Coaching-institute clusters carry the state-exam-preparation economy',
    body: 'Neighbourhoods with dense coaching-institute clusters carry the UPPSC, UP Police, judicial-services, and teaching-exam preparation economy described above.',
