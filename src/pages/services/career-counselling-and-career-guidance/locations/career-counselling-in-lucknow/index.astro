import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// The shared BOFU_COMPARISON_LIBRARY is fully exhausted across siblings (see
// the tracking note left on career-counselling-in-pitampura/index.astro), so
// this page uses its own page-specific comparisonRows array instead, matching
// the pattern set by career-counselling-in-kandivali and
// career-counselling-in-paschim-vihar.
const lucknowComparisonRows = [
  {
    left: 'Assuming a UPPSC or state-government-exam coaching batch guarantees a government job',
    right: 'Building an honest, realistic exam-attempt timeline with a genuine backup plan',
  },
  {
    left: "Treating a family Chikankari or handicraft-export business as a fallback rather than a real career choice",
    right: 'Weighing the handicraft-export economy honestly against your actual skills, interest, and growth ceiling',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
