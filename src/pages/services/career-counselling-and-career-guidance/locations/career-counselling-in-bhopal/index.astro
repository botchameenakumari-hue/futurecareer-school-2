  },
  {
    title: 'Check whether an MPPSC attempt gets an honest, structured answer',
    body: 'Good guidance should help you plan an MPPSC or state-exam path with realistic timelines and a backup plan, not treat it as a guaranteed outcome simply because Bhopal is the state capital.',
  },
  {
    title: 'Check whether the next move fits your Bhopal reality realistically',
    body: 'Good guidance for Bhopal should be realistic about trade-certification timelines, exam competition, and family expectations, and what skill-building genuinely works given your specific situation.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.jabalpurCounselling,
    title: 'Career Counselling in Jabalpur',
    description: "See Jabalpur's page if a defence-manufacturing-and-judiciary fork elsewhere in Madhya Pradesh is closer to your situation than Bhopal's engineering-and-administration fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
