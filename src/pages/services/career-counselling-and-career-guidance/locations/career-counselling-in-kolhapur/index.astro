];

const cooperativeEconomyItems = [
  {
    title: "Kolhapur's economy runs through cooperatives, not only companies",
    body: "Few Indian cities have a career-relevant institution quite like the Kolhapur belt's cooperative movement. Cooperative sugar factories across Kagal, Hatkanangale, Shirol, and the surrounding sugar-belt talukas, alongside cooperative credit societies and cooperative banks, function as some of the largest local employers outside government service. That creates a genuine, specific career fork that a generic guidance page never addresses: a cooperative-sector management, agribusiness, or sugar-technology role built on this local institutional base, versus a conventional private-sector or government job built somewhere else entirely.",
  },
  {
    title: 'The jaggery ("gul") trade adds a second, parallel agribusiness track',
    body: "Kolhapur's jaggery, traded widely as Kolhapur gul, has its own APMC market and supply chain running alongside the sugar-factory economy. For families connected to cane farming or the gul trade, the real decision is often not stream or subject at all - it is whether to build a formal career in agribusiness, supply-chain, or cooperative finance on top of that base, sell the trade knowledge into a salaried food-processing or FMCG role, or move away from the family trade into an unrelated skill entirely. That decision deserves a specific answer, not a one-line mention buried inside a generic 'agriculture careers' section.",
  },
  {
    title: 'Formal roles inside this system need real skills, not just family access',
    body: "A career built inside Kolhapur's cooperative and agribusiness economy still needs sugar-technology or chemical-engineering fundamentals, cooperative-society and financial-management skills, supply-chain and quality-control competence, or genuine agribusiness commercial skill - not just a family name or a share in a cooperative society. Building a high-value skill portfolio on top of this local base, rather than assuming access alone is enough, is what actually moves someone toward earlier financial freedom from here.",
  },
];

const cooperativeSummaryItems = [
  {
    title: 'This is not the same fork as any other Maharashtra city',
    body: "Pune's automotive-vs-IT fork, Nagpur's MIHAN logistics question, and Nashik's wine and aerospace tracks do not touch Kolhapur's cooperative sugar-and-gul economy at all - it is a distinct institutional structure with its own real career questions.",
  },
];

