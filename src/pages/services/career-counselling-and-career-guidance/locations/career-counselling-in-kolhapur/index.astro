const wrestlingHeritageItems = [
  {
    title: "Kushti and the akhada tradition create a genuine sports-career question",
    body: "Kolhapur is one of India's most recognised wrestling cities, with a long akhada (talim) tradition historically patronised by the Chhatrapati rulers of the Kolhapur princely state. Families connected to an akhada face a real fork that has nothing to do with Pune's auto-vs-IT question or Nagpur's stay-or-move dilemma: whether to keep pushing toward competitive kushti and state or national wrestling, pivot into modern sports science, physiotherapy, or coaching, or step back from wrestling into a mainstream academic or professional path once the physical prime years pass. This is a distinct sports-pathway pressure from the cricket- or hockey-linked questions some other cities face, because kushti's competitive window, injury profile, and post-competition career options are genuinely different.",
  },
  {
    title: "The Chhatrapati princely heritage still shapes the city's civic identity",
    body: "The New Palace (now a museum) and Shalini Palace anchor a visible Chhatrapati princely-state heritage identity across the city, alongside nearby Panhala Fort. This supports a real, if smaller, heritage-tourism, hospitality, and museum/conservation-adjacent employment layer, and it is part of why Kolhapur's civic self-image runs through royal patronage of wrestling, craft, and cooperative institutions rather than a purely industrial or IT-corridor identity.",
  },
];

const areaItems = [
  {
    title: "The sugar-belt talukas carry the cooperative and agribusiness economy",
    body: "Kagal, Hatkanangale, Shirol, Ichalkaranji, and the surrounding taluka belt carry the cooperative sugar-factory and jaggery-trade economy described above, alongside Ichalkaranji's own textile and power-loom cluster. Career decisions here are often shaped by family land, cooperative-society membership, or an existing textile-trade connection.",
