const onlineAdvantageItems = [
  {
    title: 'You can start from home, college, workshop, or workplace',
    body: 'Career counselling is available online in Kolhapur and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
