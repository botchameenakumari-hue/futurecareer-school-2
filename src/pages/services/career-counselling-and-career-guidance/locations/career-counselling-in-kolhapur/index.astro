// Kolhapur page drops index 0 (generic-advice-vs-high-leverage, already the
// throughline of the "why this decision matters" and buyer-checks sections
// rather than a point that needs its own row) and index 2 (low-growth-paths-
// vs-earlier-financial-freedom, already carried directly in the page's own
// hero and positioning prose - the same reasoning Nashik and Raipur used for
// dropping a row already stated in prose). This combination is not used by
// any sibling: Rajkot (rows 0-4), Vizag (rows 1-5), Bangalore (full library),
// Pune (drops 3), Kolkata (drops 1), Chennai (drops 5), Hyderabad (drops 2),
// Mumbai/Chandigarh/Gurgaon/Nagpur (each drop 4), Delhi (drops 0 and 5),
// Ahmedabad (drops 3 and 5), Surat (drops 0 and 3), Thane/Vadodara (drop 1
// and 3), Ludhiana (drops 1 and 4), Guwahati (drops 2 and 4), Jalandhar
// (drops 2 and 5), Raipur (drops 2 and 3), Nashik (drops 1 and 2), Aurangabad
// (drops 0 and 4), and Noida (drops 3 and 4).
const kolhapurComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 0 && index !== 2,
);

const title =
  'Career Counselling in Kolhapur | Practical Online Guidance | Future Career School';
