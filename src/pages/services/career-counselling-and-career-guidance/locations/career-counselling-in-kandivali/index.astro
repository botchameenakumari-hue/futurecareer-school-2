---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Note: every single-row, two-row, and three-row filter combination from
// the shared BOFU_COMPARISON_LIBRARY is now exhausted across siblings (see
// the tracking note in career-counselling-in-agra/index.astro and the
// exhaustion note in career-counselling-in-pitampura/index.astro). This
// page uses its own page-specific comparison rows instead, tailored to the
// Charkop-industrial-estate-vs-Western-Express-Highway-office fork below.
const kandivaliComparisonRows = [
  {
    left: 'Assuming shop-floor exposure at Charkop is the same as a real trade qualification',
    right: 'Building a genuine ITI, diploma, or engineering skill layer on top of that exposure',
  },
  {
    left: 'Defaulting to a Western Express Highway office job because it sounds more modern',
    right: 'Comparing an SME-manufacturing path and a corporate-office path honestly, on fit and growth',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
];

const title =
  'Career Counselling in Kandivali | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Kandivali: Charkop industrial-estate manufacturing versus a Western Express Highway corporate career. Online across India.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-kandivali/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      "You want to see how Charkop industrial work and Western Express Highway offices really compare",
      "You want clarity before choosing a factory job or a corporate move",
      "You want advice that counts commute time and rent",
      "You want one skill to build, not a list of options",
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      "Whether Charkop industrial-estate work is compared with a Western Express Highway office career",
      "Whether commute and rent are counted in the plan",
      "Whether you leave with one skill to build, not a list",
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: "Kandivali has both factory and office jobs; being nearby does not tell you which suits you.",
  },
  {
    title: 'Quality before convenience',
    body: "Manufacturing and corporate careers need different skills, so compare on pay and growth.",
  },
  {
    title: 'Act before the wrong turn compounds',
    body: "Another year in the first role that came along is the cost of waiting.",
  },
];

const charkopEconomyItems = [
  {
    title: 'Kandivali runs a genuinely distinct economy: the Charkop industrial estate',
    body: "Charkop, in Kandivali West, hosts a real cluster of small and medium manufacturing units - engineering, plastics, printing, and packaging businesses among them - built up over decades. Many local families have technical or trading ties to this estate. That creates a specific career fork a generic Mumbai suburb page never addresses: whether to build formally toward ITI, diploma, or engineering-trade skill on top of this manufacturing base, or move toward a different skill path while the estate's older identity stays in the background.",
  },
  {
    title: 'Formal trade certification beats informal shop-floor exposure alone',
    body: "A career built around Charkop's SME-manufacturing economy still benefits from real ITI, diploma, or engineering qualification - not just years of exposure to the estate. Building a genuine skill and certification layer, rather than assuming familiarity is enough on its own, is what actually moves someone toward a stronger role and earlier financial freedom from here.",
  },
];

const charkopEconomySummaryItems = [
  {
    title: 'This industrial-estate identity is specific to Kandivali',
    body: 'Most Mumbai western-suburb neighbourhoods do not carry a dedicated SME-manufacturing estate like Charkop in one place - it deserves a direct answer, not a generic suburb mention.',
  },
];

const officeCorridorItems = [
  {
    title: 'A second, genuinely distinct shift: the Western Express Highway office corridor',
    listItems: [
      'The stretch of the Western Express Highway running through Kandivali, Malad, and Goregaon has grown a real cluster of corporate offices, IT-services companies, and business parks',
      "Kandivali's proximity to the Aarey Colony and Goregaon Film City area also brings some media and production-support work into the mix",
      'Many younger residents now weigh a stable corporate-office or IT-services career along this corridor against continuing family ties to the Charkop manufacturing estate',
      'This is a genuinely different local decision than either a pure-manufacturing town or a pure-corporate suburb would offer',
    ],
  },
  {
    title: 'What a skill-first path can add to either direction',
    listItems: [
      'ITI, diploma, or engineering-trade skills can move a Charkop-linked career from shop-floor labour toward supervisory or quality-control roles',
      'IT, services, or corporate-skill certifications matter for a Western Express Highway office career as much as anywhere else in Mumbai',
      'Media or production-support skills can turn a Film-City-adjacent interest into real income for those pursuing that specific direction',
      'For those choosing an unrelated path, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const officeCorridorSummaryItems = [
  {
    title: 'Two real, different local economies, one decision',
    body: "The Charkop manufacturing-estate economy and the Western Express Highway office corridor coexist in Kandivali without overlapping much - the useful question is which one, if either, actually fits your situation.",
  },
];

const areaItems = [
  {
    title: 'Charkop carries the SME-manufacturing economy',
    body: 'The industrial estate at Charkop carries the ITI, diploma, and engineering-trade economy described above.',
  },
  {
    title: 'The Western Express Highway belt carries the corporate-office economy',
    body: 'The office parks and IT-services companies along the highway corridor carry the corporate and services job market many younger residents now rely on.',
  },
  {
    title: 'The Aarey-Film-City-adjacent pockets carry a smaller media and production-support economy',
    body: "Kandivali's proximity to Goregaon Film City and Aarey Colony brings some media, production-support, and event-linked work into the local mix as well.",
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      "A Kandivali-based option feels easier to trust and you need that to begin",
      "You want the industrial-versus-corporate question explained for you",
      "You need one practical step before more time passes",
      "You are using the city search to reduce hesitation, not to decide",
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      "You are choosing between an industrial job and a corporate one",
      "You want a skill upgrade without leaving your current job",
      "You can meet online around shifts",
      "You need risk and growth laid out before switching",
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the area label as a trust shortcut',
    body: "The Kandivali label helps you start, not choose.",
  },
  {
    title: 'Let decision quality decide the next step',
    body: "Take the route that gives you a clear skill step and a realistic income comparison.",
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether an ITI, diploma, or engineering-trade path into the Charkop manufacturing economy fits your actual strengths',
      'Whether a corporate-office or IT-services career along the Western Express Highway is genuinely the stronger route for your situation',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Kandivali's actual economy",
    listItems: [
      'ITI, diploma, or engineering-trade skills if the Charkop manufacturing economy fits your situation',
      'IT, services, or corporate-skill certifications if the office-corridor economy fits your situation better',
      'A different high-value skill path if neither local economy fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      "A comparison of industrial-estate and corporate careers on pay, growth and commute",
      "A target role and the steps to reach it without moving house",
      "One next step you can take within the week",
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, the shop floor, or before the highway commute',
    body: "You can join between shifts or on a commute-free evening",
  },
  {
    title: 'Online guidance can sit alongside family conversations about a trade tie, not compete with them',
    body: "Rent and travel time can be discussed openly in the plan",
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: "A counsellor outside your workplace can compare employers more candidly",
  },
];

const objectionItems = [
  {
    title: 'Should I pursue an ITI or engineering trade toward the Charkop manufacturing units, or aim for an office job instead?',
    body: "That depends on the specific role and skill behind it - a formal ITI, diploma, or engineering qualification built with the Charkop base in mind can be a genuinely strong path. Relying on informal shop-floor familiarity, without a certification plan, is a weaker bet than it looks.",
  },
  {
    title: 'Is a Western Express Highway office job automatically a better bet than a manufacturing-trade career?',
    body: 'Not automatically. Both paths can be genuinely strong depending on the specific role and the skill built around it - the honest answer depends on your own strengths and goals, not on which sounds more modern.',
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In an area where a manufacturing trade and an office-corridor career can both look equally reasonable, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: "The decision at hand: a manufacturing role, a corporate role or a skill upgrade",
  },
  {
    title: 'The serious options you are already considering',
    body: "The routes you are comparing, with pay, hours and commute for each",
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: "What worries you: stagnation, a long commute or a poor switch",
  },
  {
    title: 'The constraints that cannot be ignored',
    body: "Budget, family needs and shift timings, stated early",
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Kandivali's dual economy",
    body: 'The Charkop manufacturing-estate economy and the Western Express Highway office corridor are two real, distinct local paths with their own skill requirements. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a family Charkop-linked trade tie is treated as an asset, not dismissed',
    body: 'A family connection to the Charkop estate is a real starting asset, not a problem to escape by default. Better guidance should show what formalising it with trade certification can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether the office-career question gets a real, honest answer',
    body: 'Good guidance for Kandivali should treat a Western Express Highway office career as a genuine option worth real skill-building, not an automatic win simply because the offices are nearby.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.mumbaiCounselling,
    title: 'Career Counselling in Mumbai',
    description: "See Mumbai's page if a citywide BFSI-versus-media or cost-of-living decision is closer to your situation than Kandivali's specific Charkop-and-highway fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.dadarCounselling,
    title: 'Career Counselling in Dadar',
    description: "See Dadar's page if a wholesale-trade-versus-sports-pathway decision is closer to your situation.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than area-based search wording.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Kandivali instead of only looking for a nearby offline office?',
    answer:
      "Because a Kandivali office adds travel without improving the advice. Online fits around shifts and keeps the session on your decision.",
  },
  {
    question: 'Can career counselling help me plan a trade or engineering path into the Charkop manufacturing units?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - which ITI, diploma, or engineering route actually fits the roles available, what the realistic growth path looks like, and whether it fits your strengths.",
  },
  {
    question: 'Is a corporate-office job along the Western Express Highway a safer bet than a manufacturing-trade career?',
    answer:
      "Not automatically. Both paths can be genuinely strong depending on the specific role and skill built around it. Good counselling should compare them honestly rather than assuming an office job is automatically the safer choice.",
  },
  {
    question: 'Can this help students, freshers, and working professionals in Kandivali?',
    answer:
      "Yes. Students, freshers and working professionals around Kandivali can use it, whether they are choosing a first role or a switch. Sessions run online across India.",
  },
  {
    question: 'Do you guarantee a job?',
    answer:
      'No ethical provider can guarantee a job. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Kandivali',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Kandivali | Future Career School',
    description:
      'Career counselling in Kandivali for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Place', name: 'Kandivali, Mumbai' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance/">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Kandivali</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Kandivali
      </div>

      <h1 class="hero-title">
        Career counselling in Kandivali
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Kandivali hands many people a genuinely different fork than most Mumbai suburbs: the Charkop industrial estate's small-and-medium manufacturing economy, running alongside a growing Western Express Highway corporate-office corridor. Most career advice available online treats it as one generic Mumbai suburb and misses both. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Kandivali and across India. You can start from home or the shop floor - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Kandivali. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Kandivali search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="charkop-economy"
    title="The Charkop manufacturing-estate economy is Kandivali's first real fork"
    subtitle="No other Mumbai suburb sibling carries this exact SME-manufacturing-estate base - it deserves a specific answer, not a generic suburb mention."
    items={charkopEconomyItems}
    variant="decision"
  >
    <BofuSummaryStrip items={charkopEconomySummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="office-corridor"
    title="The Western Express Highway office corridor: a second, genuinely different shift"
    subtitle="A real, growing local economy, and a genuine choice between the manufacturing base and a corporate-office career."
    items={officeCorridorItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={officeCorridorSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="kandivali-areas"
    title="Kandivali's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Kandivali, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Kandivali-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In an area where a manufacturing trade and an office-corridor career can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={kandivaliComparisonRows}
    centered={true}
    extraRows={[
      { left: "Choosing a counsellor only because their office is in Kandivali", right: "Live online sessions from Kandivali, with the same process wherever you are" },
      { left: "Following what most people in Kandivali do by default", right: "A direction chosen from your fit, skills, and market demand" },
    ]}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Kandivali"
    subtitle="If the area search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the area label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Kandivali"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio backed by the decisions that unlock high income opportunities whether your path runs through manufacturing trade, a corporate-office career, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
