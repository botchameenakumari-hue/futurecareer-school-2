---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: all 15 two-row drops are already claimed by existing
// siblings (see the tracking note in career-counselling-in-agra/index.astro).
// This page uses the unused three-row drop (1, 2, 3), keeping rows 0, 4, and
// 5 - the rows most relevant to the warehousing-logistics-vs-chemical-belt
// fork below. Verified against every sibling file before publishing.
const kalyanComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 1 && index !== 2 && index !== 3,
);

const title =
  'Career Counselling in Kalyan | Practical Online Guidance | Future Career School';
const description =
  'Career counselling in Kalyan for students, freshers, and working professionals weighing the railway-junction trade and warehousing economy, the Dombivli chemical manufacturing belt, or a long Mumbai commute.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-kalyan/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before locking into a family trading or warehousing business, a Dombivli manufacturing-belt job, or a long daily commute to Mumbai.',
      "You want something more practical than a relative's opinion or a coaching-centre pitch about which stream or exam to chase.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const junctionEconomyItems = [
  {
    title: 'Kalyan runs on a genuine railway-junction trade and warehousing economy',
    body: "Kalyan Junction is one of the busiest and oldest junctions on the Central Railway, the gateway point where lines split toward the Konkan coast, Pune, and the rest of Maharashtra. That junction status built a real wholesale-trade and godown economy around Kalyan over generations - grain, timber, hardware, and general wholesale markets that still run on relationships and volume rather than formal branding. That creates a specific career fork a generic guidance page never addresses: whether to build formally toward logistics, supply-chain, and warehouse-management skill on top of this trading base, or move toward a different skill path while family trade continues in the background.",
  },
  {
    title: 'Formal logistics and supply-chain skill beats informal trading knowledge alone',
    body: "A career built on Kalyan's warehousing and wholesale-trade economy still benefits from real logistics, supply-chain, and inventory-management skill - not just growing up around the godowns. Building a genuine skill and certification layer on top of local trade knowledge, rather than assuming years of exposure is enough on its own, is what actually moves someone toward earlier financial freedom from here.",
  },
];

const junctionEconomySummaryItems = [
  {
    title: 'This is not the same fork as Thane',
    body: "Thane's page covers the Wagle Estate IT-and-manufacturing corridor and a Mumbai-commute decision built around office jobs. Kalyan's junction-trade and warehousing economy is a different local base entirely, even though both sit in the same district.",
  },
];

const dombivliBeltItems = [
  {
    title: 'A second, genuinely distinct economy: the Dombivli chemical and manufacturing belt',
    listItems: [
      'Dombivli MIDC is one of the older industrial estates in the Mumbai Metropolitan Region, built around dye, chemical, and pharmaceutical-intermediate manufacturing',
      'Many local families have decades of informal shop-floor or supervisory exposure to chemical-plant work without formal process, safety, or quality-control certification',
      'Formal diploma or ITI-level qualifications in chemical technology, industrial safety, or instrumentation increasingly separate a supervisory role from a stagnant shop-floor one',
      'Environmental-compliance and safety-audit skill is a growing, genuinely in-demand niche around this specific industrial belt',
    ],
  },
  {
    title: 'What a skill-first path can add on top of the same belt',
    listItems: [
      'Chemical-process, instrumentation, or industrial-safety diplomas can move a career from shop-floor labour toward supervisory or quality-control roles',
      'Environmental-compliance and safety-audit certifications open opportunities a purely production-line role does not',
      'For those leaving the belt entirely, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
      'A long Mumbai commute is a genuine third option worth weighing honestly against staying local, not dismissing either way',
    ],
  },
];

const dombivliBeltSummaryItems = [
  {
    title: 'Two real, unrelated local economies, one decision',
    body: 'The railway-junction trade economy and the Dombivli manufacturing belt coexist in Kalyan-Dombivli without overlapping much - the useful question is which one, if either, actually fits your situation, not which is more visible.',
  },
];

const areaItems = [
  {
    title: 'Kalyan station and the old town carry the wholesale-trade and warehousing economy',
    body: 'The areas around Kalyan Junction and the older market lanes carry the grain, timber, hardware, and general wholesale trade described above, alongside the godown and logistics work that supports it.',
  },
  {
    title: 'Dombivli carries the chemical and pharmaceutical manufacturing base',
    body: 'Dombivli MIDC and the surrounding industrial pockets host the dye, chemical, and pharmaceutical-intermediate manufacturing cluster, alongside the supervisory and technical roles it needs.',
  },
  {
    title: 'The newer residential belt carries the long-distance Mumbai-commute economy',
    body: 'Large parts of Kalyan-Dombivli have grown as a more affordable residential base for people commuting daily to Mumbai by Central Railway local trains, which is its own real decision about time, cost, and career fit.',
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh a family trading or warehousing business, a Dombivli manufacturing-belt role, or a Mumbai commute before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the city search to reduce hesitation, not because the city itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'Family trade ties or a long commute decision matter more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the city label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether a logistics, supply-chain, or warehouse-management path fits your actual strengths',
      'Whether a Dombivli manufacturing-belt role, upgraded with formal skill, beats an unrelated path',
      'Whether the daily cost of a long Mumbai commute is actually worth it for your specific goals',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Kalyan-Dombivli's actual economy",
    listItems: [
      'Logistics, supply-chain, or warehouse-management skills if the junction-trade economy fits your situation',
      'Chemical-process, instrumentation, or safety-compliance skills if the Dombivli manufacturing belt is part of the picture',
      'A different high-value skill path if neither local economy fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, shop, plant floor, or train commute',
    body: 'Career counselling is available online in Kalyan and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family trade conversations, not compete with them',
    body: 'When a family wholesale business or a Dombivli-belt job is part of the picture, the harder conversations often need to include family. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: 'A nearby or local-sounding option can still leave you with generic advice that ignores the trade or manufacturing-belt context you are actually weighing. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.',
  },
];

const objectionItems = [
  {
    title: 'Should I join the family trading or warehousing business, or build a formal logistics career instead?',
    body: 'That depends on the specific role and skill behind it - a formal logistics, supply-chain, or warehouse-management qualification built on top of the family trade base can be a genuinely strong path. Continuing purely on informal trade knowledge, without a skill plan, is a weaker bet than it looks.',
  },
  {
    title: 'I work or could work in the Dombivli manufacturing belt - is it worth formalising that with a diploma?',
    body: 'Often, yes. A chemical-process, instrumentation, or industrial-safety diploma is usually what separates a supervisory or quality-control role from a stagnant shop-floor one, and it travels with you even if you eventually move on from this specific belt.',
  },
  {
    title: 'Is a daily Mumbai commute from Kalyan actually worth it for my career?',
    body: "That depends entirely on the role, the pay difference, and your own tolerance for travel time. It deserves an honest comparison against a strong local option, not an automatic assumption in either direction.",
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is a family trade decision, a manufacturing-belt job, a commute trade-off, or stream and income-growth confusion.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: a wrong stream, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, family expectations, trade ties, and commute limits early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Kalyan-Dombivli's dual economy",
    body: 'Junction-trade warehousing and the Dombivli manufacturing belt are two real, distinct local bases with their own skill requirements. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a family trading business is treated as an asset, not dismissed',
    body: 'A family wholesale or warehousing business is a real starting asset, not a problem to escape by default. Better guidance should show what formalising it with logistics or supply-chain skill can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether the commute question gets a real, honest answer',
    body: 'Good guidance for Kalyan should treat a long Mumbai commute as a genuine trade-off worth weighing on evidence, not settle it with a generic assumption either way.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.thaneCounselling,
    title: 'Career Counselling in Thane',
    description: "See Thane's page if the Wagle Estate IT-and-manufacturing corridor and Mumbai-commute decision is closer to your situation than Kalyan's trade-and-warehousing economy.",
  },
  {
    href: BOFU_INTERNAL_LINKS.mumbaiCounselling,
    title: 'Career Counselling in Mumbai',
    description: "See Mumbai's page if the bigger question is a direct Mumbai-based career rather than a commute from Kalyan.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than city-based search wording.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Kalyan instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from home, shop, or plant floor without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'Can career counselling actually help with a decision about a family trading or warehousing business?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - what skills the specific role actually needs, what the real growth path looks like, and whether it fits your strengths, not only whether the family already runs a trading business.",
  },
  {
    question: 'I work in the Dombivli chemical or manufacturing belt. Should counselling assume I have to leave it?',
    answer:
      "No. Good counselling should treat existing manufacturing-belt experience as a real asset and explore formalising it with a chemical-process, instrumentation, or safety-compliance diploma, alongside the honest option of building a separate skill path if that genuinely fits better.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Kalyan?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Kalyan users.',
  },
  {
    question: 'Do you guarantee a job?',
    answer:
      'No ethical provider can guarantee a job. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Kalyan',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Kalyan | Future Career School',
    description:
      'Career counselling in Kalyan for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'City', name: 'Kalyan' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Kalyan</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Kalyan
      </div>

      <h1 class="hero-title">
        Career counselling in Kalyan
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Kalyan-Dombivli hands many people a genuinely different fork than most Indian cities: a historic railway-junction trade and warehousing economy running alongside the Dombivli chemical and pharmaceutical manufacturing belt, plus a long-commute decision most Mumbai Metropolitan Region towns share. Most career advice available online is written for a single generic city and misses all three. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Kalyan and across India. You can start from home, shop, plant floor, or train commute - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Kalyan. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Kalyan search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="junction-economy"
    title="The railway-junction trade and warehousing economy is Kalyan's first real fork"
    subtitle="No other Indian city sibling runs on this exact junction-trade base - it deserves a specific answer, not a generic logistics mention."
    items={junctionEconomyItems}
    variant="decision"
  >
    <BofuSummaryStrip items={junctionEconomySummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="dombivli-belt"
    title="The Dombivli manufacturing belt: a second, genuinely different economy"
    subtitle="A real industrial economy under its own pressures, and a genuine choice between formalising shop-floor exposure and building a different skill path."
    items={dombivliBeltItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={dombivliBeltSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="kalyan-areas"
    title="Kalyan-Dombivli's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Kalyan-Dombivli, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Kalyan-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In a town where a family trading business, a manufacturing-belt job, and a long Mumbai commute can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={kalyanComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Kalyan"
    subtitle="If the city search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the city label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Kalyan"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through trade and logistics, the Dombivli manufacturing belt, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

