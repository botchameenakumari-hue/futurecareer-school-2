---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import AudienceRelevance from '../../../../../components/bofu/AudienceRelevance.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Surat page drops two rows: index 0 (generic-advice-vs-high-leverage) and
// index 3 (paid-outdated-vs-free-updated-assessments). Surat's diamond and
// textile trade families already run working businesses without needing
// "generic advice" framed as the primary risk, and the assessment-vs-paid-
// assessment row is deliberately dropped here to keep the page's one
// permitted assessment mention (in AssessmentSupportNote, lower on the page)
// as the only assessment reference rather than doubling it inside the
// comparison matrix too. This selection (rows 1, 2, 4, 5) has not been used
// by any other city sibling: Rajkot (rows 0-4), Vizag (rows 1-5), Bangalore
// (full library), Pune (drops index 3), Kolkata (drops index 1), Chennai
// (drops index 5), Hyderabad (drops index 2), Mumbai (drops index 4),
// Chandigarh (drops index 4), Gurgaon (drops index 4), Delhi (drops indices
// 0 and 5), and Nagpur (drops index 4).
const suratComparisonRows = BOFU_COMPARISON_LIBRARY.filter((_, index) => index !== 0 && index !== 3);

const title = 'Career Counselling in Surat | Beyond the Family Trade | Future Career School';
const description =
  'Career counselling in Surat for students, freshers, and working professionals weighing a diamond or textile trade-family future against a formal, skill-first career path.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-surat/';

const suratContextItems = [
  {
    title: 'Surat cuts and polishes the overwhelming majority of the world\'s diamonds - and that shapes career expectations from a young age',
    body: "Well over 90% of the world's diamonds are cut and polished in Surat, mostly through small and mid-size units concentrated in Varachha, Katargam, and Mahidharpura, and now increasingly inside the Surat Diamond Bourse - the world's largest office building by floor area, built specifically to consolidate the city's diamond trade under one roof. This is not a side industry; it is the reason Surat exists in the global economy the way it does. For a large share of Surat's youth, especially from Saurashtrian trading families originally from Kathiawad, a diamond-unit job or a trade apprenticeship has historically been an available, income-generating path that does not require a college degree at all - which quietly changes how seriously formal education and career planning get treated at home.",
  },
  {
    title: 'A massive man-made-fibre and textile manufacturing base runs in parallel to diamonds, not behind it',
    body: "Surat is India's largest hub for man-made and synthetic textiles - polyester, embroidery, and sari and dress-material manufacturing - concentrated through Ring Road, Sachin GIDC, Pandesara, and Katargam's power-loom clusters. Thousands of small manufacturing and trading units run on family ownership and a floor-level apprenticeship model rather than formal HR structures or campus hiring. Combined with diamonds, this creates one of India's most concentrated trade-and-manufacturing economies, employing a genuinely enormous share of the city - most of it built on practical trade skill and family or community networks rather than degrees.",
  },
  {
    title: 'A very large migrant workforce built Surat\'s trade economy, and that shapes the aspirations of Surat\'s own youth differently',
    body: "Surat's diamond and textile units draw an unusually large migrant labour workforce from Odisha, Uttar Pradesh, Bihar, and Saurashtra itself, many of whom came specifically for trade-floor work in cutting, polishing, weaving, or embroidery. That scale of a blue-collar, trade-labour economy sitting right alongside genuinely large trade wealth creates a specific pressure for Surat's own next generation - especially first-generation-in-their-family aspirants: a pull toward white-collar and professional tracks that the trade floor itself does not lead to, without always having a clear map for what that transition actually looks like or requires.",
  },
  {
    title: 'SVNIT and Veer Narmad South Gujarat University sit inside this trade-heavy economy, not outside it',
    body: "Sardar Vallabhbhai National Institute of Technology (SVNIT) is one of India's respected NITs, and Veer Narmad South Gujarat University anchors a wide base of arts, commerce, and science colleges across the city. Graduates from both routinely come from diamond- or textile-trading families where the family business is already a live, working income source - which raises a real question few other engineering or commerce cohorts elsewhere in India have to answer as directly: is a formal, skill-first career actually worth building when a functioning family trade is already available without one?",
  },
];

const tradeVsCareerItems = [
  {
    title: 'The family diamond or textile trade rarely requires a degree - and that changes the whole decision',
    listItems: [
      "Unlike a family business that expects an MBA, a CA, or a professional qualification before handing over responsibility, Surat's diamond and textile trades have historically absorbed sons and daughters straight from school or college, sometimes without finishing either, because the trade itself is what teaches the skill",
      "That makes the question genuinely different from a typical family-business-succession decision elsewhere in India: it is not 'should I get the right degree to run this business,' it is 'why build a formal career path at all when the trade already pays and does not ask for one'",
      "Neither answer is automatically right - the honest starting point is naming which of the two actually fits the person's own interest, aptitude, and risk appetite, not defaulting to whichever one the family already expects",
    ],
  },
  {
    title: 'Diamond and textile trade income can be real and substantial, but it carries its own risk that a formal career path does not',
    listItems: [
      "Surat's diamond trade in particular is tied closely to global rough-diamond demand, US and Chinese consumer spending, and periodic industry slowdowns that have visibly affected polishing-unit employment in past cycles - a volatility that a stable, skill-first professional career path is less exposed to",
      "Textile manufacturing carries its own margin pressure from competition, raw-material cost swings, and shifting fashion cycles",
      "A genuinely useful career conversation in Surat should put both paths' real income ceiling and real risk on the table honestly, rather than assuming the trade is either a guaranteed safety net or an outdated fallback",
    ],
  },
  {
    title: 'For those without a family trade to fall back on, the same city creates a different kind of pressure',
    listItems: [
      "For first-generation-white-collar aspirants, and for the very large migrant-worker community whose own children are growing up in Surat, the visible trade wealth around them can create real aspiration without a clear route into it, since white-collar professional roles in Surat itself are comparatively thinner than in Ahmedabad or a metro tech hub",
      "That gap between visible local wealth and available white-collar opportunity is Surat's own version of a career-clarity problem, distinct from the trade-succession question facing trade-family youth",
      "Both groups are better served by the same thing: an honest, skill-first plan built for their actual starting point, not a generic script written for a metro IT graduate",
    ],
  },
];

const suratAreaItems = [
  {
    title: 'Varachha, Katargam, and Mahidharpura carry the daily texture of the diamond and textile trade',
    body: "Varachha Road and Katargam are dense with diamond-cutting and polishing units and the Saurashtrian trading families who run many of them, while Mahidharpura anchors the older diamond-trading market alongside the newer Surat Diamond Bourse at Khajod. Someone from this side of the city is often weighing a live, working family trade against a formal career path in a way few other Indian cities force this directly.",
  },
  {
    title: 'Ring Road, Sachin GIDC, and Pandesara run the textile and industrial economy',
    body: "The Ring Road textile market, Sachin GIDC's industrial estate, and the Pandesara power-loom and processing belt form Surat's manufacturing backbone, alongside Udhna's industrial zone. Families rooted here are often weighing the same trade-vs-formal-career question from the textile side rather than the diamond side.",
  },
  {
    title: "Adajan, Vesu, City Light, and Piplod reflect Surat's newer professional and student population",
    body: "Adajan, Vesu, City Light, and Piplod host much of Surat's newer residential growth, professional families, and student life around Veer Narmad South Gujarat University and the private colleges nearby, while Athwalines and Ghod Dod Road carry an older, established-business identity. SVNIT sits toward Ichchhanath, drawing students from across Gujarat and beyond into a city whose dominant local economy still runs on trade rather than campus-to-corporate hiring.",
  },
];

const objectionItems = [
  {
    title: 'My family runs a diamond or textile business - why do I need career counselling at all?',
    body: "That is one of the most specific and least-discussed pressures in Surat. A working family trade is a real asset, but 'the trade already pays' is not the same as 'the trade is the right fit for you.' Good counselling helps you weigh joining, modernising, or building a separate formal path honestly, based on your own interest and aptitude rather than on what already exists.",
  },
  {
    title: 'Everyone around me went straight into the family business without a degree - am I wasting time studying?',
    body: "Not necessarily, and not automatically. A degree without a skill-first plan behind it can be weak positioning either way. But dismissing formal education because the trade does not require one skips a real question: does the trade path suit your specific strengths and risk appetite as well as a skill-first professional path would? That comparison, not a blanket answer, is what actually helps.",
  },
  {
    title: 'I am not from a trade family - does that put me at a disadvantage in Surat?',
    body: "It changes the starting point, not the ceiling. Surat's white-collar professional opportunities are thinner than Ahmedabad's or a metro tech hub's, so the honest plan is often a deliberate, remote-capable, high-value skill portfolio rather than assuming Surat's own job market alone will absorb every skill direction equally.",
  },
  {
    title: 'The diamond industry has slowdowns - should I still consider it as a career path?',
    body: "Diamond-trade income is real but tied to global demand cycles that have visibly affected the industry before. That is not a reason to rule it out, but it is a reason to weigh it honestly against a formal path's different risk profile, and to think about what skills travel well if the trade cycle turns down.",
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the specific fork pressing you right now',
    listItems: [
      'Whether joining, modernising, or building alongside your family\'s diamond or textile trade is genuinely the stronger fit for you, or whether a formal skill-first path serves you better',
      'What a realistic income and risk comparison actually looks like between staying in the trade and building a professional career, instead of assuming one is automatically safer',
      'Whether a degree already in progress, or already completed, needs a skill-first plan behind it to actually convert into stronger opportunities',
      'What a first-generation-white-collar path can realistically look like if there is no family trade to fall back on',
    ],
  },
  {
    title: 'Skill direction built for Surat\'s actual trade-and-manufacturing economy',
    listItems: [
      'A high-value skill portfolio that works whether the near-term plan is inside the family trade, alongside it, or entirely apart from it',
      'Proof-of-work positioning strong enough to compete for opportunities beyond Surat\'s comparatively thin local white-collar market',
      'Honest fit-checking between trade-succession, a hybrid modernised-trade path, and a fully independent skill-first career',
      'A clearer route toward unlocking high income opportunities and earlier financial freedom, grounded in Surat\'s real trade economy rather than a generic metro script',
    ],
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Surat's trade-family dynamic - not just generic family-business succession",
    body: "Surat's diamond and textile trade rarely demands a formal degree before handing over responsibility, which makes the decision genuinely different from a typical family-business-succession conversation. Guidance worth paying for should recognise that difference specifically, not treat every family-business question the same way.",
  },
  {
    title: "Check whether the trade's income and risk are treated honestly, not oversold or dismissed",
    body: "Diamond and textile trade income can be substantial, but both industries carry real cyclical risk. Good guidance should put that risk on the table plainly, rather than assuming the family trade is either a guaranteed safety net or an outdated path to escape from.",
  },
  {
    title: "Check whether the advice fits someone with no family trade to fall back on just as seriously",
    body: "A large share of Surat's population, including many migrant families who built the city's trade economy, has no diamond or textile business to inherit. Guidance should build a genuine first-generation-white-collar plan for that starting point, not treat it as an afterthought to the trade-family conversation.",
  },
  {
    title: 'Check whether relocation is not assumed as the only route to a stronger career',
    body: "Surat's own white-collar market is real but thinner than Ahmedabad's or a metro's. Good guidance should be honest about when a remote-capable skill path can be built from Surat itself, and when a move genuinely serves the plan better - not default to either answer automatically.",
  },
  {
    title: 'Check the actual session format before assuming it fits your situation',
    body: "A one-off group talk or a single generic call is a different product from a genuinely one-on-one session built around your specific trade-vs-career question. Ask directly what the session covers and how personalised it actually is before deciding it is the right fit for someone weighing a live family trade against a formal path.",
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'Explore other city-specific guidance pages if you want to compare before committing.',
  },
  {
    href: BOFU_INTERNAL_LINKS.rajkotCounselling,
    title: 'Career Counselling in Rajkot',
    description: 'Useful if the manufacturing-and-SME family-business question you are weighing is closer to Rajkot\'s industrial framing than Surat\'s diamond-and-textile-trade framing.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'Use the main counselling page if the city matters less than the overall need for clarity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.parentGuidance,
    title: 'Broader Career Guidance',
    description: 'Use the main guidance page when the core issue is stream, course, skill, or career direction beyond the city search.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Surat instead of only looking for a nearby offline option?',
    answer:
      "Because proximity alone does not resolve Surat's real fork - whether to build on a family diamond or textile trade, or move toward a formal skill-first career path. Online guidance lets you start from home, an SVNIT or VNSGU-affiliated campus, or a diamond or textile unit near Varachha, Katargam, or Sachin GIDC without waiting on local availability, and it should still be judged on whether it gives you a clear, specific answer for your situation.",
  },
  {
    question: 'My family runs a diamond or textile trade business - is career counselling still relevant for me?',
    answer:
      "Yes, often more relevant than for a typical family-business situation, because Surat's trade rarely requires a degree or professional qualification before absorbing the next generation. That makes it easy to skip a real comparison between staying in the trade, modernising it, or building a separate skill-first path. Counselling can help you make that comparison honestly instead of defaulting to whichever option is already available.",
  },
  {
    question: 'I am not from a diamond or textile trading family - does Surat still offer real career opportunities?',
    answer:
      "It changes your starting point rather than your ceiling. Surat's own white-collar professional market is thinner than Ahmedabad's or a metro tech hub's, so a deliberate, often remote-capable skill portfolio tends to matter more here for a first-generation-white-collar path. Good counselling should build that plan specifically for your situation.",
  },
  {
    question: 'Is the diamond and textile trade a stable career option, or should I move toward a formal path?',
    answer:
      "Both paths carry real trade-offs. Diamond-trade income is tied to global rough-diamond demand and has visible slowdown cycles; textile manufacturing carries its own margin and demand pressure. A formal, skill-first professional path carries a different risk profile. The honest approach compares both against your own interest, aptitude, and risk appetite rather than assuming either is automatically the safer choice.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free, updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Surat?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so it works whether your decision involves a family trade, a first job, or a career pivot.',
  },
  {
    question: 'What actually makes a career counselling service the best fit in Surat, not just the most convenient one?',
    answer:
      "Fit here has less to do with location and more to do with whether the process is genuinely one-on-one, whether it treats the diamond and textile trade honestly instead of glossing over its real cyclical risk, and whether it takes a first-generation-white-collar plan just as seriously as a trade-succession one. A service that skips the free assessments and pushes straight to a paid pitch without those checks in place is not automatically the best fit just because it is based in Surat.",
  },
  {
    question: 'What if I searched for Surat but the bigger issue is not the city or the family trade at all?',
    answer:
      "That is common. The city search is often a trust shortcut. If the real pressure is stream selection, degree choice, skill direction, or a career change rather than the trade-vs-formal-career decision, the main counselling and guidance pages are the stronger next filter. This page is most useful when Surat's own trade-family context is genuinely part of your decision.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      { '@type': 'ListItem', position: 5, name: 'Career Counselling in Surat', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Surat | Future Career School',
    description:
      "Career counselling in Surat for students, freshers, and working professionals. Online guidance for the diamond-and-textile-trade-vs-formal-career decision, built around Surat's real trade economy.",
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: [
      { '@type': 'City', name: 'Surat' },
      { '@type': 'Country', name: 'India' },
    ],
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Surat</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Surat
      </div>

      <h1 class="hero-title">
        Career counselling in Surat
        <span class="gold-text"> beyond the family trade</span>
      </h1>
      <p class="hero-sub">
        Surat cuts and polishes the overwhelming majority of the world's diamonds and runs one of India's largest textile manufacturing
        economies - and both trades have historically absorbed the next generation straight from school or college, without a degree ever
        being required. That creates a genuinely different decision from most Indian cities: not just whether to join the family trade, but
        whether to build one at all when it already pays without one. Good career counselling in Surat should help you choose with more
        clarity before time and money get wasted on the wrong side of that decision - building toward achieving earlier financial freedom
        through the high-value skill portfolio that actually fits you, whether that path runs through the trade, alongside it, or apart
        from it entirely.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Surat and across India. You can start from home, from SVNIT or a Veer Narmad South Gujarat
        University-affiliated campus, or from a diamond or textile unit near Varachha, Katargam, or Sachin GIDC - no travel required before
        the underlying decision is even clear.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not whether the family trade already pays. It is whether it is actually the right fit for you, and whether
        unlocking high income opportunities elsewhere is worth building toward instead.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="surat-career-landscape"
    title="The Surat career reality that generic advice misses"
    subtitle="Surat's economy is built around trade and manufacturing at a scale most Indian cities do not match. Good career counselling should help you build the high-value skill portfolio that unlocks high income opportunities from your actual starting point, not the situation of a metro IT graduate."
    items={suratContextItems}
    variant="signal"
  />

  <BofuListCardSection
    sectionId="trade-vs-career"
    title="Family trade or formal career path - the decision most Surat students actually face"
    subtitle="This is the real fork behind most Surat searches, and it has no equivalent framing anywhere else on this site: whether a working diamond or textile trade family business is reason enough to skip a formal, skill-first career path, or whether it deserves the same honest comparison as any other career option."
    items={tradeVsCareerItems}
    variant="contrast"
  />

  <ContextualCta
    audience="mixed"
    title="If the trade-vs-career question already feels urgent, resolve it before more time goes into the wrong bet"
    body="Use this when you want a decision that moves you toward earlier financial freedom, not another year of drifting between the trade and a career you have not actually evaluated."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <AudienceRelevance title="How the right support can fit where you are right now" />

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical career counselling should move you forward"
    subtitle="The point is not a verdict on whether the family trade is 'still worth it'. The point is a clearer decision, stronger skill direction, proof of work, and a real route toward earlier financial freedom, whether that plays out inside the trade, alongside it, or apart from it."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="How this approach differs from typical career counselling"
    subtitle="In a city where a working family trade and a formal career path both carry genuine weight, the real risk is advice that only knows one script. The comparison below shows what separates high-leverage guidance from that."
    rows={suratComparisonRows}
  />

  <BofuFeatureSection
    sectionId="surat-areas"
    title="Surat's geography shapes the decision, not just the commute"
    subtitle="A useful local page should feel grounded in how people actually live, study, and work across Surat, not treat every search as coming from the same part of the city."
    items={suratAreaItems}
    variant="decision"
  />

  <BuyerChecks
    title="What to check before paying for career counselling in Surat"
    subtitle="Do not compare only convenience or the city label. Compare whether the process understands Surat's actual trade-and-manufacturing economy, and whether it is honest about the trade-vs-formal-career trade-off."
    items={buyerCheckItems}
  />

  <section id="deliverables" class="section-block">
    <div class="container">
      <h2>What should feel clearer after career counselling</h2>
      <p>
        Good career counselling should leave you with one clear decision, a smaller shortlist of options, and one practical next step
        you can actually use. Here is what that looks like for Surat's trade-vs-career fork.
      </p>
      <BofuListCardSection items={deliverableItems} variant="signal" />
      <AssessmentSupportNote
        body="If you are still early and not ready for guidance yet, the free career and skill assessments can surface strengths, preferences, and work style before you commit to a bigger counselling decision."
        href={BOFU_ASSESSMENT_LINKS.hub}
      />
    </div>
  </section>

  <section id="objections" class="section-block">
    <div class="container">
      <h2>Honest answers to what people wonder</h2>
      <p>Before committing to career counselling, you probably have some doubts or questions. Here are the ones we hear most often from Surat.</p>
      <BofuListCardSection items={objectionItems} variant="signal" />
    </div>
  </section>

  <ContextualCta
    audience="mixed"
    title="Use the Surat page when locality matters, but decide based on genuine fit, not which option already exists"
    body="The practical value is an honest read on the trade-vs-career decision, stronger skill positioning either way, and a concrete next step before the wrong bet gets more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-pages"
    title="Other guidance options to consider"
    subtitle="If the city search matters less than the actual need, explore these related pages."
    items={relatedItems}
  />

  <BofuFaqSection sectionId="faq" title="Questions about career counselling in Surat" items={faqItems} />

  <FinalCta
    sectionId="final-cta"
    title="Ready to get clarity on your next move"
    subtitle="Career counselling matters most when a real fork - the family diamond or textile trade, or a formal skill-first career path - is genuinely in front of you, and the goal is a high-value skill portfolio that keeps unlocking high income opportunities on the way to earlier financial freedom."
