---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Nav from '../../../../../components/Nav.astro';
import Footer from '../../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFaqSection from '../../../../../components/bofu/BofuFaqSection.astro';
import BofuFeatureSection from '../../../../../components/bofu/BofuFeatureSection.astro';
import BofuListCardSection from '../../../../../components/bofu/BofuListCardSection.astro';
import BofuSummaryStrip from '../../../../../components/bofu/BofuSummaryStrip.astro';
import ComparisonMatrix from '../../../../../components/bofu/ComparisonMatrix.astro';
import GuidanceModelSection from '../../../../../components/bofu/GuidanceModelSection.astro';
import BuyerChecks from '../../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_COMPARISON_LIBRARY, BOFU_INTERNAL_LINKS } from '../../../../../config/bofu';

// Follow-up-checked: this page uses the second of the three remaining
// unused three-row drops from the shared 6-row library - (2, 4, 5), keeping
// rows 0, 1, and 3 - the rows most relevant to the wholesale-trade-vs-
// sports-coaching fork below. See the tracking note in
// career-counselling-in-agra/index.astro for the full uniqueness history.
const dadarComparisonRows = BOFU_COMPARISON_LIBRARY.filter(
  (_, index) => index !== 2 && index !== 4 && index !== 5,
);

const title =
  'Career Counselling in Dadar | Practical Online Guidance | Future Career School';
const description =
  "Career counselling in Dadar for students, freshers, and working professionals weighing the wholesale flower-and-textile trade economy against a Shivaji Park sports-coaching pathway, or a different skill-first career.";
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/career-counselling-in-dadar/';

const fitItems = [
  {
    title: 'What you actually need right now',
    listItems: [
      'You want support that feels easier to trust and easier to start.',
      'You want clarity before committing to a family wholesale-trade business, a sports-coaching pathway through Shivaji Park, or a formal degree path.',
      "You want something more practical than a relative's opinion or a generic Mumbai career article that ignores Dadar's own base.",
      'You want a real next step toward a high-value skill portfolio, not only motivational talk.',
    ],
  },
  {
    title: 'What should matter more than city alone',
    listItems: [
      'Whether the guidance improves decision quality',
      'Whether the next step becomes clearer and easier to act on',
      'Whether the process helps you move toward earlier financial freedom instead of a default path',
      'Whether the advice is genuinely useful instead of generic counselling language',
    ],
  },
];

const fitSummaryItems = [
  {
    title: 'Closer should still mean clearer',
    body: 'Searching locally is useful only if it leads to better decision support, not just physical proximity.',
  },
  {
    title: 'Quality before convenience',
    body: 'The better filter is whether the guidance improves your next move, not whether an office happens to be nearby.',
  },
  {
    title: 'Act before the wrong turn compounds',
    body: 'The practical goal is to get clear before more time and effort go into the wrong path, and to start building the high-value skill portfolio that keeps unlocking high income opportunities and moves you toward earlier financial freedom.',
  },
];

const wholesaleTradeItems = [
  {
    title: 'Dadar runs a genuinely unique economy: two of Mumbai’s oldest wholesale trading markets',
    body: "Dadar hosts one of Mumbai's best-known wholesale flower markets and a long-standing wholesale garment and textile trading cluster around Kabutar Khana. Generations of local families have built businesses on this wholesale-trade base. That creates a specific career fork a generic Mumbai guidance page never addresses: whether to build formally toward supply-chain, retail-buying, or e-commerce skill on top of this trading base, or move toward a different skill path while family trade continues in the background.",
  },
  {
    title: 'Formal trade and e-commerce skill beats informal wholesale experience alone',
    body: "A career built on Dadar's wholesale-market economy still benefits from real supply-chain, retail-buying, or digital-commerce skill - not just years of exposure to the market floor. Building a genuine skill and certification layer on top of local trade knowledge, rather than assuming familiarity is enough on its own, is what actually moves someone toward earlier financial freedom from here.",
  },
];

const wholesaleTradeSummaryItems = [
  {
    title: 'This wholesale-market concentration is specific to Dadar',
    body: 'Very few Mumbai neighbourhoods carry this exact combination of a major flower market and a major textile-trading cluster in one place - it deserves a direct answer, not a generic market mention.',
  },
];

const sportsCoachingItems = [
  {
    title: 'A second, genuinely distinct economy: the Shivaji Park sports-coaching pathway',
    listItems: [
      'Shivaji Park is one of Mumbai’s most storied sporting grounds, with a long history of producing serious cricketers through its cricket academies and coaching nurseries',
      'Many families in and around Dadar weigh a genuine sports-career pathway through this infrastructure against a more conventional academic or trade route',
      'A sports pathway through Shivaji Park deserves the same honest planning as any other career fork - competitive level, age windows, and a parallel backup plan',
      'Dadar’s dense Maharashtrian cultural identity also supports real opportunities in Marathi theatre, media, and performing arts alongside the sporting pathway',
    ],
  },
  {
    title: 'What deliberate planning can add to a sports or arts pathway',
    listItems: [
      'Sports-science, coaching, or sports-management qualifications can extend a genuine sporting interest into a stable career even without reaching elite competitive level',
      'Media, performing-arts, or event-management skills can turn a cultural-scene connection into real income rather than a purely hobbyist pursuit',
      'Supply-chain or e-commerce skills matter for the wholesale-trade side just as much as for any other family-trade economy',
      'For those choosing an unrelated path, the same high-value skill portfolio logic applies as anywhere else: proof of work, market positioning, and a deliberate skill choice rather than a default',
    ],
  },
];

const sportsCoachingSummaryItems = [
  {
    title: 'Two real, unrelated local economies, one decision',
    body: "The wholesale flower-and-textile trade and the Shivaji Park sports-and-arts pathway coexist in Dadar without overlapping - the useful question is which one, if either, actually fits your situation.",
  },
];

const areaItems = [
  {
    title: 'Dadar East and the market lanes carry the wholesale-trade economy',
    body: 'The flower market and the textile-trading cluster around Kabutar Khana carry the wholesale-trade economy described above.',
  },
  {
    title: 'Shivaji Park and its surrounding lanes carry the sports and cultural economy',
    body: 'The Shivaji Park maidan and the neighbourhoods around it carry the cricket-coaching, sports-nursery, and Marathi cultural and performing-arts economy.',
  },
  {
    title: 'Dadar’s rail-junction core carries a wider commuter and services economy',
    body: 'As a major interchange between the Western and Central railway lines, central Dadar also supports a broad retail and services economy built around commuter footfall.',
  },
];

const cityDecisionItems = [
  {
    title: 'Choose local-first support when trust is the real blocker',
    listItems: [
      'You are more likely to act if the search feels closer and easier to trust',
      'You want to weigh a family wholesale-trade business, a sports-coaching pathway, or a formal-skill path before deciding',
      'You need one practical next step, not a full career-theory discussion first',
      'You are using the area search to reduce hesitation, not because the area itself resolves the decision',
    ],
  },
  {
    title: 'Choose broader guidance when the decision itself is the bigger problem',
    listItems: [
      'You are stuck between multiple paths or skill directions',
      'A sports-career timeline or family trade ties matter more than local wording',
      'You already know the help can happen online and want the strongest decision support',
      'You need deeper clarity on risk, growth, proof of work, and long-term direction',
    ],
  },
];

const cityDecisionSummaryItems = [
  {
    title: 'Use the area label as a trust shortcut',
    body: 'That search can be useful if it helps you start. It is not the final filter.',
  },
  {
    title: 'Let decision quality decide the next step',
    body: 'The stronger route is the one that makes the next move clearer, smaller, and easier to act on.',
  },
];

const deliverableItems = [
  {
    title: 'Clarity on the real decision creating pressure right now',
    listItems: [
      'Whether a supply-chain, retail-buying, or e-commerce path fits your actual strengths',
      'Whether a sports-career pathway through Shivaji Park is genuinely viable at your current level and age window',
      'What your income trajectory looks like on the current path over the next few years',
      'Which expensive wrong turn is most urgent to stop repeating right now',
    ],
  },
  {
    title: "Skill direction tied to Dadar's actual economy",
    listItems: [
      'Supply-chain, retail-buying, or e-commerce skills if the wholesale-trade economy fits your situation',
      'Sports-science, coaching, or performing-arts skills if a Shivaji Park-linked pathway fits your situation better',
      'A different high-value skill path if neither local economy fits your strengths',
      'A clearer route toward earlier financial freedom from your actual starting point',
    ],
  },
  {
    title: 'A lower-friction way to start moving',
    listItems: [
      'Online guidance accessible across India with no local-access dependence',
      'A realistic career target and the clearest path to reach it from where you are now',
      'One concrete next step instead of a theory discussion you still have to decode yourself',
    ],
  },
];

const onlineAdvantageItems = [
  {
    title: 'You can start from home, the market floor, or after practice at Shivaji Park',
    body: 'Career counselling is available online in Dadar and across India. That means the decision does not have to wait for a nearby office or one local slot opening up. The useful filter is whether the guidance improves the next move enough to matter.',
  },
  {
    title: 'Online guidance can sit alongside family and coaching conversations, not compete with them',
    body: 'When a family trading business or a sports-training schedule is part of the picture, the harder conversations often need to include family or coaches. Online sessions make it easier to include that context and join from wherever you already are.',
  },
  {
    title: 'The stronger comparison is not nearby versus far away - it is generic versus genuinely useful',
    body: "A nearby or well-known option can still leave you with generic advice that ignores Dadar's specific wholesale-trade or sports-pathway context. The better filter is whether the guidance gives you stronger skill direction, proof-of-work thinking, and a more practical next step.",
  },
];

const objectionItems = [
  {
    title: 'Should I join the family wholesale business, or build a formal supply-chain career instead?',
    body: 'That depends on the specific role and skill behind it - a formal supply-chain, retail-buying, or e-commerce qualification built on top of the family trade base can be a genuinely strong path. Continuing purely on informal trade knowledge, without a skill plan, is a weaker bet than it looks.',
  },
  {
    title: 'I train seriously at Shivaji Park - should I go all-in on a sports career or keep a backup plan?',
    body: 'A genuine sports pathway deserves serious commitment, but an honest look at competitive level and timelines alongside a parallel academic or skill plan protects you either way - it does not need to be all-or-nothing.',
  },
  {
    title: 'I am worried about wasting more time before choosing a direction',
    body: 'That is usually the best reason to act now. In an area where a family trade and a sporting pathway can both look equally reasonable, getting clear before another year passes is exactly when counselling has the highest return.',
  },
];

const prepItems = [
  {
    title: 'The real decision you need to solve first',
    body: 'Bring the actual question creating pressure right now, whether that is a family trade decision, a sports-career timeline, stream confusion, or income growth.',
  },
  {
    title: 'The serious options you are already considering',
    body: 'Write down the two to four routes you are actually comparing. Stronger counselling happens when the real trade-offs are visible from the start.',
  },
  {
    title: 'What feels risky, delayed, or expensive',
    body: 'Be clear about what you do not want to repeat: an over-committed sporting bet with no backup, a family-pressure default, or more time wasted in confusion.',
  },
  {
    title: 'The constraints that cannot be ignored',
    body: 'Include budget, training schedules, family expectations, and trade ties early so the guidance stays practical instead of idealised.',
  },
];

const buyerCheckItems = [
  {
    title: "Check whether the counsellor understands Dadar's dual economy",
    body: 'The wholesale flower-and-textile trade and the Shivaji Park sports-and-arts pathway are two real, distinct local paths with their own skill requirements. Good guidance should engage with whichever applies to you seriously, not offer a generic mention.',
  },
  {
    title: 'Check whether a family wholesale-trade business is treated as an asset, not dismissed',
    body: 'A family flower or textile-trading business is a real starting asset, not a problem to escape by default. Better guidance should show what formalising it with supply-chain or e-commerce skill can look like, alongside the option to build a different skill path.',
  },
  {
    title: 'Check whether a sports-career decision gets a real, honest timeline',
    body: 'Good guidance for Dadar should engage seriously with a genuine Shivaji Park sports-training pathway, including honest timelines and backup planning, not offer a generic extracurricular mention.',
  },
];

const relatedItems = [
  {
    href: BOFU_INTERNAL_LINKS.guidanceLocations,
    title: 'Career Guidance by Location',
    description: 'See other city guidance options if you want to compare before deciding further.',
  },
  {
    href: BOFU_INTERNAL_LINKS.mumbaiCounselling,
    title: 'Career Counselling in Mumbai',
    description: "See Mumbai's page if a citywide BFSI-versus-media or cost-of-living decision is closer to your situation than Dadar's specific wholesale-trade-and-sports fork.",
  },
  {
    href: BOFU_INTERNAL_LINKS.chemburCounselling,
    title: 'Career Counselling in Chembur',
    description: "See Chembur's page if a refinery-trade-versus-BKC-commute decision is closer to your situation.",
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounselling,
    title: 'Career Counselling',
    description: 'See the main counselling page if your bigger need is clarity and stronger next steps rather than location alone.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'See the online page if easier access across India matters more than area-based search wording.',
  },
  {
    href: BOFU_ASSESSMENT_LINKS.hub,
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments can be a lower-pressure check if you are not ready for stronger guidance yet.',
  },
];

const faqItems = [
  {
    question: 'Why choose online career counselling in Dadar instead of only looking for a nearby offline office?',
    answer:
      "Because proximity alone does not improve the decision. Online guidance lets you start from home or the market floor without waiting for local availability, and the stronger comparison is whether the support gives you clearer trade-offs, stronger skill direction, and a more practical next step.",
  },
  {
    question: 'Can career counselling actually help with a decision about a family flower or textile-trading business?',
    answer:
      "Yes. That decision benefits from the same structured thinking as any other career fork - what skills the specific role actually needs, what the real growth path looks like, and whether it fits your strengths, not only whether the family already runs a wholesale business.",
  },
  {
    question: 'I train at Shivaji Park. Can counselling help me plan a genuine sports career around it?',
    answer:
      "Yes. Good counselling should treat serious sports training as a real career pathway worth planning around, including an honest look at competitive level and a parallel academic or skill plan, rather than either ignoring it or assuming it is the only option.",
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. As context, Future Career School also offers free, updated, practical, AI-powered career and skill assessments if you want a lower-pressure starting signal before a bigger counselling decision.',
  },
  {
    question: 'Can this help students, freshers, and working professionals in Dadar?',
    answer:
      'Yes. Future Career School serves students, freshers, and working professionals across school, college, recent-graduate, postgraduate, and career-growth stages. The guidance is online across India, so there are no local-access limits for Dadar users.',
  },
  {
    question: 'Do you guarantee a job or a sports career?',
    answer:
      'No ethical provider can guarantee a job or a sporting career. The practical goal is better decision quality, stronger skill direction, and a clearer path forward.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Locations',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/locations/',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Career Counselling in Dadar',
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling in Dadar | Future Career School',
    description:
      'Career counselling in Dadar for students, freshers, and working professionals who want clearer decisions, stronger skill direction, proof of work, and better income-growth direction.',
    url: canonical,
    serviceType: 'Career Counselling and Career Guidance',
    areaServed: { '@type': 'Place', name: 'Dadar, Mumbai' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href={BOFU_INTERNAL_LINKS.guidanceLocations}>Locations</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling in Dadar</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Practical support for students, freshers, and working professionals in Dadar
      </div>

      <h1 class="hero-title">
        Career counselling in Dadar
        <span class="gold-text"> for practical clarity and stronger next steps</span>
      </h1>
      <p class="hero-sub">
        Dadar hands many people a genuinely different fork than most Mumbai neighbourhoods: one of the city's oldest wholesale flower-and-textile trading economies, running alongside a real sports-and-cultural pathway built around the legendary Shivaji Park. Most career advice available online treats it as one generic Mumbai address and misses both. If you are at a real decision point, the goal is getting clear before more time goes the wrong way, and building the kind of high-value skill portfolio that unlocks high income opportunities and moves you toward earlier financial freedom.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online in Dadar and across India. You can start from home, the market floor, or after practice at Shivaji Park - no travel, no waiting for local availability.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Student Career Counselling</a>
        <a href="#plans" class="btn-outline">Get Working Professional Career Counselling</a>
      </div>
      <p class="hero-support">
        The stronger filter is not only whether the search started with Dadar. It is whether the guidance improves the next move enough to matter.
      </p>
    </div>
  </section>

  <BofuListCardSection
    sectionId="local-intent-fit"
    title="Why this decision already feels important"
    subtitle="You want support that feels easier to trust, easier to start, and more useful than generic advice - not another vague conversation."
    items={fitItems}
    variant="contrast"
  >
    <BofuSummaryStrip items={fitSummaryItems} variant="contrast" />
  </BofuListCardSection>

  <ContextualCta
    audience="mixed"
    title="If the Dadar search already reflects a serious decision, move before more time goes into the wrong direction"
    body="Use this when you want stronger guidance now, not another round of delay while the decision keeps getting more expensive."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <BofuFeatureSection
    sectionId="wholesale-trade"
    title="The wholesale flower-and-textile trade economy is Dadar's first real fork"
    subtitle="No other Mumbai neighbourhood sibling runs on this exact wholesale-market base - it deserves a specific answer, not a generic market mention."
    items={wholesaleTradeItems}
    variant="decision"
  >
    <BofuSummaryStrip items={wholesaleTradeSummaryItems} variant="neutral" />
  </BofuFeatureSection>

  <BofuListCardSection
    sectionId="sports-coaching"
    title="Shivaji Park's sports-and-cultural pathway: a second, genuinely different economy"
    subtitle="A real sporting and cultural economy under its own pressures, and a genuine choice between it and the wholesale-trade base."
    items={sportsCoachingItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={sportsCoachingSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="dadar-areas"
    title="Dadar's areas point to different real decisions"
    subtitle="A useful local page should feel grounded in how people actually live and work across Dadar, not treat it as one flat generic location."
    items={areaItems}
    variant="decision"
  />

  <BofuListCardSection
    sectionId="city-page-vs-broader-guidance"
    title="Choose the stronger starting point for your situation"
    subtitle="For some people, local, Dadar-specific support is the easiest way to start. For others, broader guidance across paths and skills is the better fit because the decision itself is already the bigger issue."
    items={cityDecisionItems}
    columns={2}
    variant="contrast"
  >
    <BofuSummaryStrip items={cityDecisionSummaryItems} variant="neutral" />
  </BofuListCardSection>

  <GuidanceModelSection
    sectionId="guidance-process"
    title="How practical guidance should move the decision forward"
    subtitle="The point is not a vague conversation. The point is better decisions, higher-value skill direction, proof of work, and a clearer path toward income growth."
  />

  <ComparisonMatrix
    sectionId="comparison"
    title="What makes this more useful than generic counselling"
    subtitle="In an area where a family trade and a sporting pathway can each look like the obvious default, the risk is advice that ignores where you actually are. The comparison below shows what separates high-leverage guidance from generic career counselling."
    rows={dadarComparisonRows}
  />

  <BofuListCardSection
    sectionId="what-good-support-should-give"
    title="What stronger career counselling should give you"
    subtitle="Good counselling should improve the next decision, not just describe your situation more politely."
    items={deliverableItems}
    columns={3}
    variant="signal"
  >
    <AssessmentSupportNote
      body="As context, if you are still early and not ready for guidance yet, the free assessments can help surface strengths, preferences, and work style before a bigger counselling decision."
      href={BOFU_ASSESSMENT_LINKS.hub}
    />
  </BofuListCardSection>

  <BofuFeatureSection
    sectionId="why-online-still-works"
    title="Why online career counselling can still be the stronger route from Dadar"
    subtitle="If the area search began as a trust shortcut, the next question is whether online guidance gives you a clearer, more practical next move than defaulting to whoever simply happens to be nearby."
    items={onlineAdvantageItems}
    variant="decision"
  />

  <BofuFeatureSection
    sectionId="common-doubts"
    title="Common doubts before starting"
    subtitle="These are the doubts worth resolving before you pay for any counselling support."
    items={objectionItems}
    variant="signal"
  />

  <BofuFeatureSection
    sectionId="what-to-keep-ready"
    title="What to keep ready before you pay for any career counselling"
    subtitle="A stronger conversation starts faster when the real pressure, the real options, and the real constraints are already visible."
    items={prepItems}
    variant="signal"
  />

  <BuyerChecks
    title="What to check before paying any career counselling service"
    subtitle="Do not compare only convenience or the area label. Compare whether the process improves decision quality, skill direction, and the practical next step."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="mixed"
    title="Locality can matter, but decision quality should still be what settles it"
    body="The practical value is clearer fit, trade-offs, and next steps before a wrong route hardens further."
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <GuidancePlansSection
    audience="mixed"
    serviceLabel="Career Counselling"
  />

  <LinkDirectorySection
    sectionId="related-help"
    title="Explore related help"
    subtitle="See the main guidance pages, free assessments, and other useful resources before you decide."
    items={relatedItems}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Questions people ask before choosing career counselling in Dadar"
    items={faqItems}
  />

  <FinalCta
    title="Move toward earlier financial freedom with a clearer next step"
    subtitle="Career counselling here is not about one isolated decision. It is about building a high-value skill portfolio that keeps unlocking high income opportunities whether your path runs through wholesale trade, sport, the performing arts, or somewhere else entirely."
    audience="mixed"
    studentHref="#plans"
    studentLabel="Get Student Career Counselling"
    professionalHref="#plans"
    professionalLabel="Get Working Professional Career Counselling"
  />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
