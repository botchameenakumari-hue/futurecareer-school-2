---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Guidance After 12th | Future Career School';
const description =
  'Career guidance after 12th for students and parents who need clearer course, degree, skill, and next-step direction before an expensive wrong turn.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-after-12th/';
const class1112AssessmentUrl = '/services/assessments/class-11-to-12/';
const after12thGuideUrl = '/blog/career-guidance/how-to-choose-a-career-after-12th/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for school, college, and early skill-direction decisions.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12thOnline,
    title: 'Career Guidance After 12th Online',
    description: 'Use the online version when the decision is urgent and you do not want to wait for local guidance options.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Broader Career Guidance',
    description: 'Get broader help with stream, course, skill, and next-step decisions when several connected choices need to make sense together.',
  },
  {
    href: class1112AssessmentUrl,
    title: 'Class 11 to 12 Assessment',
    description: 'Course-fit, degree direction, and after-school decision support before bigger commitments.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for stream decisions, aptitude signals, skill fit, and career direction.',
  },
  {
    href: after12thGuideUrl,
    title: 'How to Choose a Career After 12th',
    description: 'Read the fuller decision-framework article if the bigger issue is still how to judge the trade-offs.',
  },
  {
    href: '/blog/career-options/career-options-after-12th-science/',
    title: 'Career Options After 12th Science',
    description: 'A practical science-path guide when the next question is what those routes really lead to.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
];

const whenHelpItems = [
  {
    title: 'Too many acceptable options',
    body: 'Several routes look possible, but you still do not know which trade-offs make the most sense for you.',
  },
  {
    title: 'Parent and student keep repeating the same confusion',
    body: 'The conversation is active, but the decision frame is still weak and nobody feels confident enough to commit.',
  },
  {
    title: 'The commitment is getting expensive',
    body: 'Fees, years, coaching pressure, or the fear of choosing the wrong course are already part of the decision.',
  },
  {
    title: 'You want stronger growth logic, not just a safe-sounding option',
    body: 'The real goal is better fit, stronger skill upside, and a clearer route toward achieving earlier financial freedom.',
  },
];

const guidanceSolveItems = [
  {
    title: 'Course and degree shortlist',
    body: 'Narrow broad options into a smaller, more serious shortlist instead of getting lost in endless possibilities.',
  },
  {
    title: 'Entrance route versus backup route',
    body: 'Judge what is worth pushing harder, what should stay as backup, and where the risk is too high for blind commitment.',
  },
  {
    title: 'Skill direction from year one',
    body: 'Do not wait years to think about practical skill building. Better guidance should connect the next course choice to stronger skill direction early.',
  },
  {
    title: 'Parent decision confidence',
    body: 'Replace vague arguments with clearer reasoning around fit, market reality, cost, and long-term upside.',
  },
];

const shiftedPlanItems = [
  {
    title: 'Do not choose only by what is left over',
    body: 'Availability alone is a weak reason for a multi-year commitment. The route still needs fit, growth logic, and practical skill direction.',
  },
  {
    title: 'Separate disappointment from the next decision',
    body: 'One plan not working out can distort the next choice. The next route should be judged on its own trade-offs, not only on emotional carryover.',
  },
  {
    title: 'Keep the next route connected to stronger skill building',
    body: 'A backup plan is still better when it helps you build higher-value skills early instead of locking you into low-thought drift.',
  },
];

const parentCompareItems = [
  {
    title: 'Fit before prestige pressure',
    body: 'If the route looks impressive but the fit is weak, regret can arrive faster than expected.',
  },
  {
    title: 'Cost against real growth logic',
    body: 'High cost alone does not prove stronger value. The route should still support better skill building and better long-term earning logic.',
  },
  {
    title: 'Skill direction from year one',
    body: 'The route gets stronger when the student can begin practical proof-building early instead of waiting until the degree is almost over.',
  },
  {
    title: 'Backup strength if the first plan slows down',
    body: 'Even the backup should still leave space for stronger positioning, better skills, and course correction later.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance compares real trade-offs',
    body:
      'After 12th, several options can sound acceptable. Better guidance should help you judge fit, cost, risk, and upside, not just repeat course names.',
  },
  {
    title: 'Check whether skill direction is part of the decision',
    body:
      'Degree choice alone is rarely enough. Stronger guidance should also help you think about the higher-value skills that need to start early.',
  },
  {
    title: 'Check whether the reasoning survives a parent-student discussion',
    body:
      'If the direction cannot be explained clearly to both student and parent, the decision frame is probably not strong enough yet.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body:
      'Many providers charge thousands for outdated or impractical assessments. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments.',
  },
];

const faqItems = [
  {
    question: 'What should career guidance after 12th actually help with?',
    answer:
      'It should help you judge course, degree, skill, and backup-route decisions with clearer trade-offs instead of choosing under pressure alone.',
  },
  {
    question: 'Is this different from career counselling after 12th or career coaching after 12th?',
    answer:
      'In practice, people often use career guidance, career counselling, and career coaching for students after 12th to mean the same thing here: they want a stronger decision before making an expensive wrong turn after 12th.',
  },
  {
    question: 'Should I use free assessments or get guidance now?',
    answer:
      'Free career and skill assessments can stay as a light check if you are still looking broadly and the decision is not urgent yet. Move to guidance when admissions, fees, repeated confusion, or parent-student disagreement are already making the decision feel expensive.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer:
      'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered.',
  },
  {
    question: 'Can this help if parents and student are stuck on different options?',
    answer:
      'Yes. A useful decision process should replace repeating confusion with clearer reasoning around fit, risk, cost, and long-term growth.',
  },
  {
    question: 'Is this only for students who have no idea what to do?',
    answer:
      'No. It is also useful when several options look acceptable and you need a sharper way to choose between them.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so students and families can join from home, college, or wherever they already are instead of depending on local availability.',
  },
  {
    question: 'What if marks, rank, or admission results changed my original plan after 12th?',
    answer:
      'That does not make the next decision small. The backup route should still be judged seriously for fit, skill direction, cost, and long-term growth instead of being chosen only because it is available now.',
  },
  {
    question: 'How should parents compare two acceptable options after 12th?',
    answer:
      'Compare them on fit, cost, risk, skill direction, and whether the route still supports stronger growth if the first plan slows down. Brand name alone is usually not enough for the decision.',
  },
  {
    question: 'Should a backup route after 12th be treated like a serious decision too?',
    answer:
      'Yes. A backup route should still support better skill direction and long-term growth rather than becoming a low-thought default that creates regret later.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Guidance After 12th', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Guidance After 12th | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Guidance After 12th',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Guidance After 12th</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career guidance after 12th for course, degree, skill, and next-step decisions
      </div>

      <h1 class="hero-title">
        Career guidance after 12th
        <span class="gold-text"> before the wrong turn gets expensive</span>
      </h1>
      <p class="hero-sub">
        After 12th, a list of options is not enough. Whether you are looking for career guidance, career counselling for 12th students, or straightforward next-step planning, the real job is judging course, degree, skill, and backup-route trade-offs before pressure turns into an expensive commitment.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. Students and families can start from home, college, or wherever they already are — no travel, no waiting for a local option.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">
          Get Career Guidance for Students After 12th
        </a>
      </div>
      <p class="hero-support">
        Stronger guidance after 12th should leave you with clearer trade-offs, better reasoning, and a safer next move before the costs get heavier.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="when-help"
    title="When career guidance after 12th becomes worth it"
    subtitle="This usually matters when the next course, degree, or skill decision is starting to carry real cost and generic advice is no longer enough."
    items={whenHelpItems}
    variant="signal"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why after-12th guidance has to be sharper than generic advice"
    subtitle="These are the contrast points that matter most once the after-12th decision starts carrying real cost."
    rows={comparisonRows}
    centered={true}
  />

  <ContextualCta
    audience="student"
    title="Use after-12th guidance before course pressure turns into a longer and costlier wrong turn"
    body="This stage matters most when the next college or skill decision already feels serious enough that guessing is no longer safe."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students After 12th"
  />

  <BofuFeatureSection
    sectionId="what-guidance-should-solve"
    title="What stronger career guidance after 12th should actually improve"
    items={guidanceSolveItems}
    variant="decision"
  >
      <AssessmentSupportNote
        body="If you are still early and not ready for guidance yet, the class 11 to 12 assessments can help you narrow strengths, preferences, and work style before a bigger after-12th decision."
        href={class1112AssessmentUrl}
        label="Free career and skill assessments"
      />
  </BofuFeatureSection>

  <BofuStepFlowSection
    sectionId="if-plan-shifted"
    title="If marks, rank, or admission reality changed the original plan"
    subtitle="A lot of after-12th decisions are made while recovering from one route not going the way you expected. That is exactly when the next choice still needs strong reasoning."
    items={shiftedPlanItems}
  >
      <div class="support-links card">
        <a href={after12thGuideUrl}>Read the detailed after-12th decision guide &rsaquo;</a>
      </div>
  </BofuStepFlowSection>

  <BofuFeatureSection
    sectionId="parents-compare"
    title="What parents should compare before paying major fees after 12th"
    subtitle="The strongest decision is usually not the loudest option. It is the one that still makes sense on fit, cost, skill direction, and long-term growth."
    items={parentCompareItems}
    variant="prep"
  />

  <BuyerChecks
    title="What to check before paying for career guidance after 12th"
    subtitle="The point is clearer course, degree, and skill decisions before expensive drift sets in."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Move before the wrong after-12th commitment gets more expensive to undo"
    body="If the bigger problem is not effort but unclear fit, course logic, or long-term upside, stronger guidance helps before commitment hardens."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students After 12th"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Guidance After 12th"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader student guidance, assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Take the after-12th decision seriously before it becomes a long detour"
    subtitle="Use the after-12th guidance path if the decision already feels heavy instead of letting confusion, pressure, or a weak backup route stretch into a longer detour."
    studentHref="#plans"
    studentLabel="Get Career Guidance for Students After 12th"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.35rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-guidance-should-solve,
  #if-plan-shifted,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.84rem, 9.6vw, 2.55rem);
      line-height: 1.04;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
