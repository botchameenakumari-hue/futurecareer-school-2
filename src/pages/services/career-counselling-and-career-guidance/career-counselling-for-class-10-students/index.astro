---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_ASSESSMENT_LINKS, BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Counselling for Class 10 Students | Choose the Right Stream Before 11th | Future Career School';
const description =
  'Career counselling for Class 10 students facing the Science, Commerce, or Arts decision before 11th. Clearer stream-fit reasoning before marks or pressure decide it.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-class-10-students/';

const class10AssessmentUrl = BOFU_ASSESSMENT_LINKS.class10AndBelow;
const streamSelectorUrl = BOFU_ASSESSMENT_LINKS.streamSelectorAfter10th;
const aptitudeAfter10thUrl = BOFU_ASSESSMENT_LINKS.careerAptitudeAfter10th;

const relatedDirectoryItems = [
  {
    href: streamSelectorUrl,
    title: 'Stream Selector Test After 10th',
    description: 'A free starting signal on Science, Commerce, or Arts fit before you commit to a stream conversation.',
  },
  {
    href: aptitudeAfter10thUrl,
    title: 'Career Aptitude Test After 10th',
    description: 'Free aptitude signal for strengths and work style before the stream decision hardens.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for school, college, and early skill-direction decisions beyond just the stream choice.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'For when the next decision moves from stream to course, degree, and college — the stage after this one.',
  },
  {
    href: '/blog/stream-selection/career-options-after-10th/',
    title: 'Career Options After 10th',
    description: 'A practical breakdown of what Science, Commerce, and Arts actually lead to before you decide.',
  },
  {
    href: '/blog/stream-selection/which-stream-to-choose-in-11th/',
    title: 'Which Stream to Choose in 11th',
    description: 'Read the fuller decision framework if marks, pressure, and family opinions are all pulling in different directions.',
  },
  {
    href: '/blog/parents/how-to-guide-child-in-career-selection-india/',
    title: 'How to Guide Your Child in Career Selection',
    description: 'Practical support for parents trying to help without turning the stream decision into a tug-of-war.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
  {
    left: 'Generic low-paying path advice that limits growth',
    right: 'Higher-value skill direction with clearer income-growth logic',
  },
];

const whatIsDecidedItems = [
  {
    title: 'Science (PCM), Science (PCB), or both',
    body: 'Physics-Chemistry-Maths keeps engineering and many tech and finance-adjacent routes open. Physics-Chemistry-Biology keeps medical and life-science routes open. Very few schools let a student keep every option without an early lean one way.',
  },
  {
    title: 'Commerce, with or without Maths',
    body: 'Commerce without Maths narrows out a few analytical and finance-heavy routes later. Commerce with Maths keeps more of those doors open while still fitting students who do not want pure Science.',
  },
  {
    title: 'Arts or Humanities, not as a fallback',
    body: 'Design, law, media, psychology, civil services, writing, and several fast-growing digital-skill paths sit here. Treating Arts as the leftover option for weaker students is one of the most common ways families box in a strong fit.',
  },
  {
    title: 'A choice that feels irreversible even though it is not final',
    body: 'Switching streams after starting 11th is possible but harder, and it usually costs a repeat year. That pressure is real — the goal is a decision strong enough that a switch is rarely needed, aimed at earlier financial freedom instead of a rushed guess now.',
  },
];

const stageDifferenceItems = [
  {
    title: 'After 12th, the decision is a course or college',
    body: 'By then a student already has two years inside a stream, a clearer sense of which subjects they can sustain, and board or entrance scores narrowing the list. The decision is about which specific degree and institution to commit to.',
  },
  {
    title: 'At Class 10, the decision is a subject direction, not a career',
    body: 'A 15-year-old rarely has enough exposure to know if they want to be an architect or a chartered accountant. What they can judge, with the right questions, is whether they think and work better with numbers, systems, language, people, or hands-on problems — and that is what should drive the stream, not marks alone.',
  },
  {
    title: 'Class 10 board marks are a weak proxy for stream fit',
    body: 'Scoring well in Class 10 Maths or Science says a student can perform under a fixed syllabus and exam pressure. It does not say they will enjoy three more years of it, or that Science is where their strongest long-term skill portfolio actually sits.',
  },
  {
    title: 'Parents carry more of the decision weight at this stage',
    body: 'After 12th, most students push back or take more ownership. At Class 10, parents are usually the ones filling forms, talking to relatives, and absorbing school pressure — so guidance here has to work for both the student and the parent in the same conversation.',
  },
];

const clarifyItems = [
  {
    title: 'Separate genuine strength from exam performance',
    body: 'A student can score well in a subject and still be a weak long-term fit for the stream built around it. Guidance should test for actual working style and interest, not just the last report card.',
  },
  {
    title: 'Pressure-test the "Science keeps all doors open" argument',
    body: 'Science does keep more formal doors open on paper. It does not automatically build a stronger skill portfolio if the student is disengaged for three years and enters college burnt out instead of ahead.',
  },
  {
    title: 'Give the stream decision a skill-building answer, not just a subject answer',
    body: 'Whichever stream is chosen, the stronger question is which high-value skills the student starts building alongside it — because stream choice alone does not create earlier financial freedom; the skill direction built on top of it does.',
  },
  {
    title: 'Make the reasoning something both student and parent can defend',
    body: 'A good decision here should survive a conversation with relatives and school teachers without collapsing into "everyone else is taking Science" or "Arts has no future."',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether it separates marks-based logic from fit-based logic',
    body: 'If the guidance mostly restates the report card back to you, it has not actually diagnosed stream fit. It should be testing working style, interest, and tolerance for the subjects each stream demands for the next two years.',
  },
  {
    title: 'Check whether Arts and Commerce get treated seriously',
    body: 'If every conversation quietly steers toward Science regardless of fit, that is prestige bias, not guidance. A serious process treats all three streams as real options with real outcomes.',
  },
  {
    title: 'Check whether it addresses the parent conversation, not just the student',
    body: 'At this age, the parent is usually the one under pressure from relatives and school deadlines too. Guidance that only speaks to the student and ignores the family conversation usually does not survive contact with home.',
  },
  {
    title: 'Check whether the assessments behind it are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments and present them like a required first step. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments instead.',
  },
];

const faqItems = [
  {
    question: 'Should stream choice be based on Class 10 board marks alone?',
    answer:
      'No. Marks show how a student performs under a fixed syllabus, not whether they will enjoy or sustain that subject direction for two more years. Stream-fit reasoning should also cover working style, genuine interest, and long-term skill direction, not marks in isolation.',
  },
  {
    question: 'What is the real difference between PCM and PCB?',
    answer:
      'PCM (Physics, Chemistry, Maths) keeps engineering, architecture, and several analytical and tech-adjacent paths open. PCB (Physics, Chemistry, Biology) keeps medical and life-science paths open. Some schools allow both, but most require an early lean toward one.',
  },
  {
    question: 'Can a student change streams after starting 11th?',
    answer:
      'It is possible in many schools but usually harder, and it often means repeating a year or catching up quickly on missed foundational topics. That is exactly why the Class 10 decision deserves real reasoning instead of a guess based on marks or pressure.',
  },
  {
    question: 'Is Arts or Humanities a weaker choice than Science or Commerce?',
    answer:
      'No. Arts and Humanities lead to design, law, media, psychology, civil services, and several growing digital-skill careers. Treating it as the fallback for students who "could not get" Science is a common bias, not a fact about outcomes.',
  },
  {
    question: 'How much should parents decide versus the child at this age?',
    answer:
      'At Class 10, parents usually carry more of the practical decision load than they will after 12th. The stronger approach is a shared decision built on the student’s actual working style and interest, with parents involved in the reasoning instead of only the outcome.',
  },
  {
    question: 'Should we wait for the Class 10 board result before finalizing the stream?',
    answer:
      'The result matters for eligibility in some schools, but the deeper stream-fit questions — working style, subject interest, and skill direction — can be worked through before results arrive so the decision is not made in a rush once marks are out.',
  },
  {
    question: 'Is career counselling for Class 10 students too early, or is this the right time?',
    answer:
      'This is usually the right time. The stream decision made now shapes subject options, entrance-exam eligibility, and skill-building runway for the next several years, so getting clearer reasoning before 11th starts is more useful than waiting until the pressure peaks.',
  },
  {
    question: 'Are the Class 10 career and skill assessments free?',
    answer:
      'Yes. The Class 10 career and skill assessments are fully free. They can be described as updated, practical, and AI-powered, and they work as a light starting signal before a deeper stream conversation.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so students and parents can join from home or wherever they already are instead of depending on local availability.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for Class 10 Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for Class 10 Students | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for Class 10 Students',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for Class 10 Students</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling for Class 10 students choosing Science, Commerce, or Arts
      </div>

      <h1 class="hero-title">
        Career counselling for Class 10 students
        <span class="gold-text"> before a rushed stream choice costs you years</span>
      </h1>
      <p class="hero-sub">
        Future Career School offers career counselling for Class 10 students who are choosing between Science, Commerce, and Arts before 11th. The right stream, chosen for genuine fit instead of marks or pressure, is what protects two years of subject direction and starts the high-value skill portfolio that unlocks high income opportunities and earlier financial freedom instead of a guessed one.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India. Students and parents can start from home without waiting for a local option or a school counsellor's limited time slot.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">
          Get Career Counselling for Class 10 Students
        </a>
      </div>
      <p class="hero-support">
        The goal is not to predict a final career at 15. It is to choose the stream that fits genuine strength and working style, so the next two years build toward a high-value skill portfolio and earlier financial freedom instead of a guess based on marks alone.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-is-decided"
    title="What the Class 10 stream decision actually involves"
    subtitle="Choosing a stream is not one question. It is several overlapping decisions that most families rush through in a few weeks after results."
    items={whatIsDecidedItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get clarity on the stream decision before school deadlines force a guess"
    body="Most schools ask for a stream choice within weeks of the Class 10 result. Stronger reasoning now avoids a harder switch later."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Class 10 Students"
  />

  <BofuStepFlowSection
    sectionId="how-this-differs"
    title="How this is different from career guidance after 12th"
    subtitle="Class 10 and Class 12 look like similar decision points from the outside. The actual reasoning needed at each stage is not the same."
    items={stageDifferenceItems}
  >
    <div class="support-links card">
      <a href="/blog/stream-selection/which-stream-to-choose-in-11th/">Read the full stream-selection framework &rsaquo;</a>
      <a href={BOFU_INTERNAL_LINKS.after12th}>See what changes once the decision becomes course and college &rsaquo;</a>
    </div>
  </BofuStepFlowSection>

  <ComparisonMatrix
    sectionId="different"
    title="Why the stream decision needs sharper reasoning than a marks-based guess"
    subtitle="These are the contrast points that matter most once a stream choice starts shaping the next two years and the skill direction built on top of it."
    rows={comparisonRows}
    centered={true}
  />

  <BofuFeatureSection
    sectionId="what-clarify"
    title="What career counselling for Class 10 students should actually clarify"
    items={clarifyItems}
    variant="decision"
  >
    <AssessmentSupportNote
      body="As a starting point, the free Class 10 assessments and stream selector can surface early signals on working style and subject fit before a deeper counselling conversation."
      href={class10AssessmentUrl}
      label="Free career and skill assessments"
    />
  </BofuFeatureSection>

  <BuyerChecks
    title="What to check before paying for Class 10 career counselling"
    subtitle="The goal is a stream decision the whole family can defend, not a session that just repeats the report card back to you."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Choose the stream on fit and skill direction, not on marks or relatives' opinions"
    body="If Science, Commerce, and Arts all sound acceptable but nobody is confident, stronger reasoning now is cheaper than a stream switch later."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Class 10 Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling"
    title="Career Counselling Plans for Class 10 Students"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See free stream-fit assessments, broader student guidance, and practical reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Decide the stream with real reasoning before the school deadline decides it for you"
    subtitle="Use Class 10 career counselling if Science, Commerce, and Arts all feel like guesses right now. The right stream, chosen for fit, is what starts the skill portfolio that leads toward earlier financial freedom — instead of letting marks, pressure, or prestige bias make the call."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Class 10 Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; max-width: min(100%, 44rem); margin-bottom: 1.75rem; white-space: normal; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #what-clarify,
  #faq { background: rgba(255,255,255,.01); }

  .support-links {
    padding: 1rem 1.05rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .9rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  }
  .support-links a {
    display: block;
    padding: .95rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.8);
    font-weight: 700;
    line-height: 1.65;
  }
  .support-links a:hover {
    color: #fff;
    border-color: rgba(229,184,74,.24);
  }

  @media (max-width: 980px) {
    .support-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.8rem, 9.6vw, 2.5rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
