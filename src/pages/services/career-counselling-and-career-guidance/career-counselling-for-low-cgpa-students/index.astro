---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentSupportNote from '../../../../components/bofu/AssessmentSupportNote.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import BofuStepFlowSection from '../../../../components/bofu/BofuStepFlowSection.astro';
import ComparisonMatrix from '../../../../components/bofu/ComparisonMatrix.astro';
import BuyerChecks from '../../../../components/bofu/BuyerChecks.astro';
import ContextualCta from '../../../../components/bofu/ContextualCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import FinalCta from '../../../../components/bofu/FinalCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { BOFU_INTERNAL_LINKS } from '../../../../config/bofu';

const title = 'Career Counselling for Low CGPA Students | Future Career School';
const description =
  'Career counselling for low CGPA students - a practical plan for placement eligibility, MBA or MS applications, and building proof of skill when your CGPA is not the number you wanted.';
const canonical =
  'https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-low-cgpa-students/';

const graduatesAssessmentUrl = '/services/assessments/graduates-and-early-professionals/';
const portfolioGuideUrl = '/career-resources/creating-a-portfolio-without-work-experience/';
const placementReportGuideUrl = '/blog/college-degrees/how-to-read-college-placement-report-india/';

const relatedDirectoryItems = [
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'Broader student guidance for stream, course, and skill-direction decisions beyond one CGPA-driven decision.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingSession,
    title: 'One-on-One Career Counselling Session',
    description: 'A focused session format when the placement or higher-studies decision needs undivided attention now.',
  },
  {
    href: graduatesAssessmentUrl,
    title: 'Graduates and Early Professionals Assessment',
    description: 'A free signal on skill fit and employability if you are already close to graduating or just finished.',
  },
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free assessments for skill fit, direction, and employability signals before a bigger decision.',
  },
  {
    href: portfolioGuideUrl,
    title: 'Creating a Portfolio Without Work Experience',
    description: 'A practical read on building proof of skill when your marksheet is not doing the talking for you.',
  },
  {
    href: placementReportGuideUrl,
    title: 'How to Read a College Placement Report',
    description: 'Understand what placement numbers actually mean before assuming a low CGPA rules a company out.',
  },
];

const comparisonRows = [
  {
    left: 'Generic advice that still leaves you unclear',
    right: 'High-leverage decision support around path, skill, and risk',
  },
  {
    left: 'Degree-first direction with weak skill edge',
    right: 'Skill-first direction with proof of work and stronger market value',
  },
  {
    left: 'Low-growth paths that delay real earning progress',
    right: 'Stronger skill choices aimed at achieving earlier financial freedom',
  },
  {
    left: 'Paid outdated impractical assessments with weak practical value',
    right: 'Free updated practical AI-powered career and skill assessments',
  },
];

const whatBlocksItems = [
  {
    title: 'On-campus shortlisting at some recruiters',
    body: 'A number of on-campus recruiters set a minimum CGPA before they will even shortlist a resume for that drive. This is real, but it is a shortlisting filter for specific companies on specific days - not a verdict on your employability.',
  },
  {
    title: 'It does not block the off-campus and referral route',
    body: 'Off-campus applications, hiring events, and referrals are usually judged far more on your resume, projects, and interview performance than on the exact CGPA line used for one campus drive.',
  },
  {
    title: 'It does not automatically block an MBA or MS application',
    body: 'Most postgraduate programs list a minimum aggregate as an eligibility line to apply, not a ranking factor once you clear it. Entrance scores, work experience, projects, and your application story carry real weight from there.',
  },
  {
    title: 'It does not block building a strong skill portfolio',
    body: 'Projects, certifications, internships, and demonstrated work are proof a transcript cannot replace - and building that high-value skill portfolio is what unlocks high income opportunities over your first few working years, regardless of one number on a marksheet.',
  },
];

const routeOptionItems = [
  {
    title: 'Final year, placements approaching',
    body: 'The CGPA on your transcript is close to fixed now. The real decision is where to put remaining effort - one or two strong projects, targeted certifications, and a resume built around what you can prove, not what you wish your marksheet said.',
  },
  {
    title: 'Mid-college, still time on the clock',
    body: 'If you still have a few semesters left, there is real room to both work on the number and build parallel proof of skill, so neither placements nor higher-studies eligibility depend on the CGPA alone.',
  },
  {
    title: 'Already graduated, CGPA already on the resume',
    body: 'The number will not change, so the plan shifts to positioning: leading with projects and outcomes, choosing employers who weight skill signal more heavily, and deciding whether an MBA, MS, or certification path is worth it for your goals.',
  },
];

const recruiterRealityItems = [
  {
    title: 'IT services and campus-heavy recruiters',
    body: 'Many large campus recruiters use CGPA as an early, mechanical filter simply because they are screening thousands of applications at once. It is a volume filter, not always a considered judgment of your ability.',
  },
  {
    title: 'Product companies and skill-first hiring',
    body: 'Product companies, startups, and skill-first employers more often screen on projects, problem-solving rounds, and portfolio work. Several drop or de-emphasize CGPA screens entirely once you are past the resume stage.',
  },
  {
    title: 'What actually carries weight once you are in the room',
    body: 'In interviews, CGPA rarely comes up again once you have cleared the shortlist. What gets asked about is what you built, what you understood, and how you think through a problem - which is exactly what proof of work is for.',
  },
];

const mistakeItems = [
  {
    title: 'Waiting for placement season to start building proof',
    body: 'Projects, certifications, and a usable portfolio take time to build credibly. Starting the semester placements begin is usually too late to have anything strong enough to show.',
  },
  {
    title: 'Assuming every recruiter uses the same CGPA cutoff',
    body: 'Cutoffs vary company to company and often change year to year. Ruling out an entire sector because one recruiter had a high bar closes doors that were never actually shut.',
  },
  {
    title: 'Applying to MBA or MS programs without checking the real eligibility line',
    body: 'Every program sets its own minimum aggregate and its own weighting of test scores, work experience, and essays. Assuming rejection without checking the actual numbers wastes application cycles.',
  },
  {
    title: 'Treating the CGPA as the whole story in interviews',
    body: 'Leading with an apology about your CGPA in an interview draws more attention to it than the interviewer was giving it. A stronger move is leading with what you built and learned.',
  },
];

const buyerCheckItems = [
  {
    title: 'Check whether the guidance separates real cutoffs from assumed ones',
    body: 'Useful counselling should help you check which specific recruiters or programs actually filter on CGPA, instead of letting you rule out entire paths based on rumour or one bad experience.',
  },
  {
    title: 'Check whether proof-of-skill building is part of the plan',
    body: 'A plan that only talks about the number is incomplete. Stronger guidance should also help you start building the high-value skill portfolio that carries weight in interviews and off-campus applications regardless of your transcript.',
  },
  {
    title: 'Check whether it covers both placements and higher studies',
    body: 'CGPA pressure usually touches two different decisions at once - campus eligibility now and MBA or MS eligibility later. Guidance should help you plan for both instead of only the more urgent one.',
  },
  {
    title: 'Check whether the assessments are practical or just expensive theatre',
    body: 'Many providers charge thousands for outdated or impractical assessments. Future Career School can be described truthfully as offering free, updated, practical, AI-powered career and skill assessments.',
  },
];

const faqItems = [
  {
    question: 'Does a low CGPA disqualify me from campus placements?',
    answer:
      'It can affect eligibility for specific on-campus drives that set a minimum CGPA for shortlisting. It does not disqualify you from placements overall - off-campus applications, referrals, and hiring events generally weigh your resume, projects, and interview performance more heavily than that one cutoff.',
  },
  {
    question: 'Can I still apply for an MBA or MS with a low CGPA?',
    answer:
      'Usually yes. Most postgraduate programs set a minimum aggregate purely as an eligibility line to apply. Once you clear that line, entrance scores, work experience, projects, and your application story typically carry more weight than the exact CGPA number.',
  },
  {
    question: 'Do product-based tech companies check CGPA the same way service companies do?',
    answer:
      'Not usually to the same degree. Many product companies, startups, and skill-first employers weight projects, problem-solving rounds, and portfolio work more heavily than large campus recruiters who use CGPA mainly as an early volume filter.',
  },
  {
    question: 'Is a low CGPA different from having backlogs?',
    answer:
      'Yes. A low CGPA usually reflects passed subjects with lower scores, while backlogs mean subjects still need to be cleared. Backlogs can affect eligibility more strictly at some recruiters and programs, so the two situations need slightly different plans.',
  },
  {
    question: 'What can I actually do about my CGPA in final year, when it is too late to raise the number much?',
    answer:
      'At that stage, the more useful move is usually not chasing a small CGPA improvement but building one or two strong, demonstrable projects or certifications and preparing a resume and interview story that leads with what you can prove instead of the number.',
  },
  {
    question: 'Are the career and skill assessments free?',
    answer: 'Yes. The career and skill assessments are fully free. They can be described as updated, practical, and AI-powered.',
  },
  {
    question: 'Is this a service that fixes my CGPA or guarantees a job?',
    answer:
      'No. This is not a marks-fixing service and not a job-guarantee or placement service. It is decision support - helping you separate real eligibility limits from assumed ones and build a clearer, skill-first plan around your actual result.',
  },
  {
    question: 'Is this available online across India?',
    answer:
      'Yes. Guidance is delivered online across India, so college students can join from their hostel, home, or campus without depending on local availability.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Career Counselling and Career Guidance',
        item: 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/',
      },
      { '@type': 'ListItem', position: 4, name: 'Career Counselling for Low CGPA Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Career Counselling for Low CGPA Students | Future Career School',
    description,
    url: canonical,
    serviceType: 'Career Counselling for Low CGPA Students',
    areaServed: { '@type': 'Country', name: 'India' },
    inLanguage: 'en-IN',
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  faqJsonLd,
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav activePage="career-guidance" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/career-counselling-and-career-guidance">Career Counselling and Guidance</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Counselling for Low CGPA Students</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Career counselling for college students with a low CGPA
      </div>

      <h1 class="hero-title">
        Career counselling for low CGPA students
        <span class="gold-text"> who still want a strong placement and a real shot at earlier financial freedom</span>
      </h1>
      <p class="hero-sub">
        A low CGPA can shut a few specific doors - certain on-campus cutoffs, a handful of scholarships - but it does not decide your placement outcome, your MBA or MS eligibility, or your income potential on its own. Career counselling for low CGPA students should replace the guesswork with a plan built around your exact transcript, the recruiters or programs that matter to you, and <strong>the high-value skill portfolio that carries real weight once the shortlist is behind you</strong>.
      </p>
      <p class="hero-note">
        Guidance is delivered fully online across India, so you can start from your hostel room, home, or campus without waiting on a local option.
      </p>
      <div class="hero-actions">
        <a href="#plans" class="btn-gold pulse">Get Career Counselling for Students</a>
      </div>
      <p class="hero-support">
        This is not a marks-fixing service and not a job guarantee. It is decision support that turns CGPA anxiety into one clear next step toward stronger skills and stronger positioning.
      </p>
    </div>
  </section>

  <BofuFeatureSection
    sectionId="what-blocks"
    title="What a low CGPA actually blocks - and what it does not"
    subtitle="Most of the fear around a low CGPA is bigger than its real effect. These are the specific claims worth checking before you rule anything out."
    items={whatBlocksItems}
    variant="signal"
  />

  <ContextualCta
    audience="student"
    title="Get a plan built around your actual CGPA before placement season makes the decision for you"
    body="The semester before placements is when a proof-of-skill gap becomes hardest to close. A clearer plan now leaves more runway."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Students"
  />

  <BofuStepFlowSection
    sectionId="route-options"
    title="Three different situations, three different plans"
    subtitle="Whether you are heading into placements this year, still mid-degree, or already graduated with the number fixed on your resume, the right next step is not the same."
    items={routeOptionItems}
  >
    <AssessmentSupportNote
      body="As a starting signal, the free graduates and early-professionals assessment can help map strengths and skill direction before you decide where to focus limited final-year time."
      href="/services/assessments/graduates-and-early-professionals/"
      label="Free career and skill assessments"
    />
  </BofuStepFlowSection>

  <BofuFeatureSection
    sectionId="recruiter-reality"
    title="How recruiters and admissions committees actually weigh CGPA"
    subtitle="Not every employer or program treats CGPA the same way. Knowing where the number matters most - and where it barely comes up - changes where you should spend your effort."
    items={recruiterRealityItems}
    variant="decision"
  />

  <ComparisonMatrix
    sectionId="different"
    title="Why this needs sharper guidance than generic placement advice"
    subtitle="A CGPA number deserves a specific plan, not just reassurance that it will be fine. These are the contrast points that matter once you need a real next step."
    rows={comparisonRows}
    centered={true}
  />

  <ContextualCta
    audience="student"
    title="Build the skill portfolio that outweighs one number on a transcript"
    body="Interviews rarely revisit CGPA once you clear the shortlist - what gets asked about is what you built. Start on that proof now instead of after the drive is announced."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Students"
  />

  <BofuFeatureSection
    sectionId="mistakes"
    title="Mistakes that make a low CGPA cost more than it should"
    subtitle="Most of the real damage from a low CGPA does not come from the number itself - it comes from decisions made about it, usually under pressure."
    items={mistakeItems}
    variant="prep"
  />

  <BuyerChecks
    title="What to check before paying for career counselling on a low CGPA"
    subtitle="The point is a specific plan for your exact transcript and goals - not generic reassurance or a longer list of worries."
    items={buyerCheckItems}
  />

  <ContextualCta
    audience="student"
    title="Move on one clear plan instead of staying stuck on the number"
    body="If the real problem is not effort but not knowing which doors are actually closed, stronger counselling helps before another application cycle or placement season passes."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Students"
  />

  <GuidancePlansSection
    audience="student"
    serviceLabel="Career Counselling for Low CGPA Students"
  />

  <LinkDirectorySection
    sectionId="related-links"
    title="Explore Related Help"
    subtitle="See broader student guidance, stage-specific assessments, and useful reading before you decide."
    items={relatedDirectoryItems}
    altBackground={true}
  />

  <FinalCta
    audience="student"
    title="Turn your CGPA into one clear plan instead of an open worry"
    subtitle="A low CGPA is a narrow limitation on a few specific doors, not a verdict on your placement chances, your higher-studies options, or your route to earlier financial freedom. Build the plan now instead of carrying the uncertainty into placement season."
    studentHref="#plans"
    studentLabel="Get Career Counselling for Students"
  />

  <BofuFaqSection items={faqItems} />

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); top: -140px; left: -80px; }
  .orb-teal { width: 420px; height: 420px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); top: 0; right: 0; }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(circle at center, rgba(0,0,0,.86), transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.8); }
  .hero-pill { width: fit-content; margin-bottom: 1.75rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title {
    font-size: clamp(2.2rem, 4.7vw, 3.85rem);
    line-height: 1.06;
    letter-spacing: -.04em;
    color: #fff;
    max-width: min(980px, 100%);
    margin-bottom: 1.25rem;
    overflow-wrap: anywhere;
  }
  .hero-sub { font-size: clamp(15px, 1.95vw, 18px); color: rgba(255,255,255,.72); line-height: 1.88; max-width: 820px; margin-bottom: 1rem; }
  .hero-note { font-size: 14px; color: rgba(255,255,255,.56); line-height: 1.8; max-width: 780px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-support { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.8; max-width: 720px; margin-top: 1rem; }

  #recruiter-reality,
  #mistakes,
  #faq { background: rgba(255,255,255,.01); }

  @media (max-width: 560px) {
    #hero { padding: 126px 0 72px; }
    .hero-pill {
      width: 100%;
      padding-inline: 1rem;
      font-size: 12px;
      line-height: 1.5;
    }
    .hero-title {
      font-size: clamp(1.78rem, 9.4vw, 2.45rem);
      line-height: 1.05;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn-gold,
    .hero-actions .btn-soft {
      justify-content: center;
    }
  }
</style>
