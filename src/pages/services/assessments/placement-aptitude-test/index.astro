---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/placement-aptitude-test/';
const plansConfig = getAssessmentPlansConfig('graduate');
const relatedTestNames = [
  'placement aptitude test',
  'aptitude test for jobs',
  'job aptitude test',
  'job career aptitude test',
  'free job career test',
];

const relatedLinks = [
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduate and Early Professional Assessment',
    description:
      'Use the broader assessment when you also need role-fit, employability, career direction, and skill-building clarity.',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professional Assessment',
    description:
      'Use the professional assessment when the bigger question is a career switch, stronger positioning, or higher-value skill leverage.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description:
      'Compare every free assessment for students, graduates, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does this placement aptitude test measure?',
    a: 'It checks five areas: numerical reasoning, logical reasoning, verbal ability, data interpretation, and workplace judgement. Your result shows an overall score and a separate score for every area.',
  },
  {
    q: 'Is this aptitude test for jobs free?',
    a: 'Yes. The full 20-question assessment, instant result, answer review, and practice priorities are free. No login or payment is required.',
  },
  {
    q: 'Can this test guarantee placement or selection?',
    a: 'No. It is a preparation and diagnostic tool, not a placement guarantee. Employer tests also vary by company, role, difficulty, and time limit.',
  },
  {
    q: 'Who should take this assessment?',
    a: 'It is designed for college students, graduates, freshers, job seekers, and early professionals preparing for placement aptitude rounds or general job screening tests.',
  },
  {
    q: 'How should I use the result?',
    a: 'Start with the two lowest-scoring areas, practise under time limits, and retake the test after focused preparation. Use career guidance when you also need help with role direction, stronger skills, positioning, and the larger career plan.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Placement Aptitude Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Placement Aptitude Test',
    description:
      'A free 20-question aptitude test for jobs and placement preparation with numerical, logical, verbal, data interpretation, and workplace judgement scores.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Placement Aptitude Test | Free Aptitude Test for Jobs | Future Career School"
  description="Take a free 20-question placement aptitude test and aptitude test for jobs. Get instant numerical, logical, verbal, data, and workplace judgement scores."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <main>
    <section id="hero" class="placement-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--teal" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a>
          <span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Placement Aptitude Test</span>
        </nav>

        <div class="eyebrow"><span></span> Free placement readiness check</div>
        <h1>Placement Aptitude Test <span>for Job Readiness</span></h1>
        <p class="hero-sub">
          Take this free aptitude test for jobs to check the five skills that commonly matter in placement and screening rounds. Get an instant score, see your weakest areas, and know what to practise next.
        </p>

        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>20</strong><span>questions</span></div>
          <div><strong>5</strong><span>aptitude areas</span></div>
          <div><strong>Free</strong><span>instant result</span></div>
        </div>

        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Free Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>

        <div class="related-name-row" aria-label="Related test names">
          {relatedTestNames.map((name) => <span>{name}</span>)}
        </div>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section id="test-coverage" class="coverage-section">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">Five-part readiness picture</span>
          <h2>Know exactly where your placement preparation stands</h2>
          <p>One overall mark can hide the real problem. This assessment separates your score into five practical areas.</p>
        </div>
        <div class="coverage-grid">
          <article><span>01</span><h3>Numerical reasoning</h3><p>Percentages, ratios, averages, and everyday quantitative decisions.</p></article>
          <article><span>02</span><h3>Logical reasoning</h3><p>Patterns, sequences, deductions, and structured problem solving.</p></article>
          <article><span>03</span><h3>Verbal ability</h3><p>Vocabulary, grammar, comprehension, and word relationships.</p></article>
          <article><span>04</span><h3>Data interpretation</h3><p>Reading tables, comparing values, and drawing accurate conclusions.</p></article>
          <article><span>05</span><h3>Workplace judgement</h3><p>Priorities, ownership, communication, and practical professional choices.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">Free aptitude test for jobs</span>
          <h2>Answer all 20 questions</h2>
          <p>Choose the strongest answer. There is no negative marking, and you can review every incorrect answer at the end.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell">
          <div class="quiz-topline">
            <div>
              <span id="domain-label" class="domain-label">Numerical reasoning</span>
              <span id="question-counter" class="question-counter">Question 1 of 20</span>
            </div>
            <span id="progress-label" class="progress-label">5% complete</span>
          </div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="5" aria-valuetext="Question 1 of 20"><span id="progress-fill"></span></div>

          <div id="question-panel" class="question-panel">
            <p id="question-text" class="question-text" tabindex="-1">Loading question...</p>
            <div id="option-list" class="option-list" role="group" aria-label="Answer choices"></div>
          </div>

          <div class="quiz-nav">
            <button id="back-button" class="quiz-button quiz-button--secondary" type="button" disabled>Back</button>
            <button id="next-button" class="quiz-button quiz-button--primary" type="button" disabled>Next</button>
          </div>
        </div>

        <div
          id="result-shell"
          class="result-shell"
          data-guidance-href={plansConfig.jumpHref}
          data-guidance-label={plansConfig.jumpLabel}
          hidden
          aria-live="polite"
          tabindex="-1"
          role="region"
          aria-label="Placement aptitude results"
        ></div>

        <p class="assessment-note">
          This diagnostic is not an employer-specific exam and cannot guarantee selection. Company tests vary by role, format, difficulty, and time limit.
        </p>
      </div>
    </section>
    </div>

    <section class="practice-section">
      <div class="container practice-layout">
        <div>
          <span class="section-kicker">Use the score properly</span>
          <h2>A better score comes from focused practice, not random repetition</h2>
        </div>
        <div class="practice-steps">
          <article><strong>1</strong><div><h3>Start with the lowest two areas</h3><p>Put most of your preparation time where the score shows the largest gap.</p></div></article>
          <article><strong>2</strong><div><h3>Add a time limit</h3><p>Accuracy comes first. Once it improves, practise similar questions under realistic time pressure.</p></div></article>
          <article><strong>3</strong><div><h3>Review the reason, not only the answer</h3><p>Use each explanation to understand the method so the next variation becomes easier.</p></div></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you start practising</h2></div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <LinkDirectorySection
      sectionId="related-assessments"
      title="Related Free Assessments"
      subtitle="Use a broader assessment when your question goes beyond aptitude practice into role fit, career direction, or a professional transition."
      items={relatedLinks}
      altBackground={true}
    />

    <AssessmentGuidanceCta mode="graduate" sectionId="guidance-bridge" />

    <GuidancePlansSection
      sectionId="plans"
      audience={plansConfig.audience}
      serviceLabel={plansConfig.serviceLabel}
      title={plansConfig.sectionTitle}
    />
  </main>

  <AssessmentReportTools
    title="Placement Aptitude Report"
    fileName="future-career-school-placement-aptitude-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="PLACEMENT READINESS DIAGNOSTIC"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .placement-hero { position: relative; overflow: hidden; padding: 132px 0 78px; }
  .hero-grid { position: absolute; inset: 0; opacity: .12; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(to bottom, #000, transparent 90%); }
  .hero-glow { position: absolute; width: 430px; height: 430px; border-radius: 50%; filter: blur(110px); opacity: .17; pointer-events: none; }
  .hero-glow--gold { top: 18px; left: -180px; background: #e5b84a; }
  .hero-glow--teal { right: -190px; bottom: -80px; background: #2dd4bf; }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-bottom: 1.6rem; font-size: 13px; color: rgba(255,255,255,.46); }
  .breadcrumb a:hover { color: var(--gold); }
  .eyebrow, .section-kicker { color: var(--teal); font-size: 12px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .eyebrow { display: inline-flex; align-items: center; gap: .55rem; padding: .5rem .85rem; border: 1px solid rgba(45,212,191,.24); border-radius: 999px; background: rgba(45,212,191,.07); }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 5px rgba(45,212,191,.1); }
  .placement-hero h1 { max-width: 840px; margin: 1.2rem 0 .9rem; color: #fff; font-size: clamp(2.35rem, 6.1vw, 4.8rem); line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .placement-hero h1 span { display: block; color: var(--gold); }
  .hero-sub { max-width: 720px; margin: 0; color: rgba(255,255,255,.68); font-size: clamp(15px, 1.8vw, 18px); line-height: 1.72; text-wrap: pretty; }
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(120px, 1fr)); width: min(600px, 100%); margin: 2rem 0; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(255,255,255,.035); backdrop-filter: blur(10px); overflow: hidden; }
  .hero-stats div { display: grid; gap: .15rem; padding: 1rem; }
  .hero-stats div + div { border-left: 1px solid rgba(255,255,255,.09); }
  .hero-stats strong { color: #fff; font-size: 1.2rem; }
  .hero-stats span { color: rgba(255,255,255,.48); font-size: 12px; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .related-name-row { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-top: 1.5rem; }
  .related-name-row span { padding: .35rem .65rem; border-radius: 999px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.42); font-size: 11px; }

  .coverage-section, .assessment-section, .practice-section, .faq-section { padding: 5.5rem 0; }
  .coverage-section, .practice-section { background: rgba(255,255,255,.012); }
  .section-heading { max-width: 760px; margin: 0 auto 2.4rem; text-align: center; }
  .section-heading h2, .practice-layout h2 { margin: .65rem 0 .75rem; color: #fff; font-size: clamp(1.85rem, 4vw, 3rem); line-height: 1.08; letter-spacing: -.04em; text-wrap: balance; }
  .assessment-section { overflow-anchor: none; }
  .section-heading p { margin: 0 auto; color: rgba(255,255,255,.58); line-height: 1.7; }
  .coverage-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .85rem; }
  .coverage-grid article { min-height: 210px; padding: 1.25rem; border: 1px solid rgba(255,255,255,.09); border-radius: 22px; background: linear-gradient(155deg, rgba(255,255,255,.05), rgba(255,255,255,.018)); }
  .coverage-grid article > span { color: var(--gold); font-size: 11px; font-weight: 800; letter-spacing: .1em; }
  .coverage-grid h3 { margin: 2.2rem 0 .55rem; color: #fff; font-size: 16px; line-height: 1.25; }
  .coverage-grid p { margin: 0; color: rgba(255,255,255,.56); font-size: 13px; line-height: 1.6; }

  .quiz-shell, .result-shell { width: min(820px, 100%); margin: 0 auto; padding: clamp(1.2rem, 3vw, 2.2rem); border: 1px solid rgba(255,255,255,.11); border-radius: 28px; background: radial-gradient(500px 220px at 100% 0, rgba(45,212,191,.08), transparent 70%), rgba(255,255,255,.03); box-shadow: 0 34px 90px -60px rgba(0,0,0,.95); scroll-margin-top: 92px; }
  .quiz-topline { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .quiz-topline > div { display: grid; gap: .25rem; }
  .domain-label { color: var(--gold); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .question-counter, .progress-label { color: rgba(255,255,255,.48); font-size: 12px; }
  .progress-track { height: 7px; margin: .8rem 0 2rem; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.08); }
  .progress-track span { display: block; width: 5%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--teal), var(--gold)); transition: width .25s ease; }
  .question-text { min-height: 3.1em; margin: 0 0 1.35rem; color: #fff; font-size: clamp(1.15rem, 2.6vw, 1.55rem); font-weight: 750; line-height: 1.48; white-space: pre-line; }
  .option-list { display: grid; gap: .7rem; }
  .answer-option { display: grid; grid-template-columns: 32px 1fr; align-items: start; gap: .8rem; width: 100%; padding: .9rem 1rem; border: 1px solid rgba(255,255,255,.085); border-radius: 15px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.82); font: inherit; text-align: left; cursor: pointer; transition: border-color .16s ease, background .16s ease, box-shadow .16s ease; }
  .answer-option:hover { border-color: rgba(229,184,74,.34); background: rgba(255,255,255,.06); box-shadow: 0 12px 24px rgba(229,184,74,.12); }
  .answer-option.is-selected { border-color: rgba(229,184,74,.62); background: linear-gradient(135deg, rgba(229,184,74,.14), rgba(229,184,74,.04)); color: #fff; }
  .answer-letter { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,.08); color: rgba(255,255,255,.62); font-size: 12px; font-weight: 800; }
  .answer-option.is-selected .answer-letter { background: var(--gold); color: #0a0f1e; }
  .answer-copy { padding-top: .3rem; line-height: 1.5; }
  .quiz-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.08); }
  .quiz-button { min-width: 110px; min-height: 46px; padding: .7rem 1.2rem; border-radius: 12px; font: inherit; font-size: 14px; font-weight: 800; cursor: pointer; }
  .quiz-button:disabled { opacity: .35; cursor: not-allowed; }
  .quiz-button--secondary { border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.72); }
  .quiz-button--primary { border: 0; background: linear-gradient(135deg, #e5b84a, #f5d98c); color: #0a0f1e; }
  .assessment-note { max-width: 760px; margin: 1rem auto 0; color: rgba(255,255,255,.4); font-size: 12px; line-height: 1.6; text-align: center; }

  .result-shell[hidden] { display: none; }
  .result-head { display: grid; grid-template-columns: 140px 1fr; align-items: center; gap: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.09); }
  .score-ring { display: grid; place-items: center; width: 140px; height: 140px; border-radius: 50%; background: conic-gradient(var(--gold) var(--score), rgba(255,255,255,.08) 0); position: relative; }
  .score-ring::after { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: #0c111d; }
  .score-ring strong, .score-ring span { position: relative; z-index: 1; }
  .score-ring strong { color: #fff; font-size: 2rem; line-height: 1; }
  .score-ring span { color: rgba(255,255,255,.48); font-size: 11px; }
  .result-kicker { color: var(--teal); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .result-head h3 { margin: .45rem 0 .5rem; color: #fff; font-size: clamp(1.55rem, 3vw, 2.2rem); }
  .result-head p { margin: 0; color: rgba(255,255,255,.64); line-height: 1.65; }
  .domain-results { display: grid; gap: .85rem; margin: 1.5rem 0; }
  .domain-row { display: grid; grid-template-columns: 165px 1fr 42px; align-items: center; gap: .8rem; }
  .domain-row span { color: rgba(255,255,255,.72); font-size: 13px; }
  .domain-bar { height: 9px; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.08); }
  .domain-bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--teal), var(--gold)); }
  .domain-score { text-align: right; font-weight: 800; color: #fff !important; }
  .result-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .7rem; margin: 1.35rem 0; }
  .result-metric { padding: .9rem; border: 1px solid rgba(255,255,255,.08); border-radius: 15px; background: rgba(255,255,255,.03); }
  .result-metric strong { display: block; color: #fff; font-size: 1.15rem; }
  .result-metric span { display: block; margin-top: .25rem; color: rgba(255,255,255,.48); font-size: 11px; line-height: 1.45; }
  .focus-card { padding: 1.15rem; border: 1px solid rgba(229,184,74,.24); border-radius: 18px; background: rgba(229,184,74,.07); }
  .focus-card + .focus-card { margin-top: .85rem; }
  .focus-card h4, .review-section h4, .plan-section h4, .insight-section h4 { margin: 0 0 .55rem; color: var(--gold); }
  .focus-card p { margin: 0; color: rgba(255,255,255,.7); line-height: 1.65; }
  .practice-allocation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-top: .85rem; }
  .allocation-item { display: flex; align-items: center; justify-content: space-between; gap: .8rem; padding: .75rem .85rem; border-radius: 13px; background: rgba(0,0,0,.18); color: rgba(255,255,255,.7); font-size: 13px; }
  .allocation-item strong { color: var(--teal); white-space: nowrap; }
  .insight-section, .plan-section { margin-top: 1.1rem; padding: 1.15rem; border: 1px solid rgba(255,255,255,.08); border-radius: 18px; background: rgba(255,255,255,.025); }
  .insight-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .insight-grid article { padding: .85rem; border-radius: 14px; background: rgba(255,255,255,.035); }
  .insight-grid h5 { margin: 0 0 .35rem; color: #fff; font-size: 13px; }
  .insight-grid p, .plan-grid p { margin: 0; color: rgba(255,255,255,.58); font-size: 12.5px; line-height: 1.6; }
  .plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; }
  .plan-grid article { padding: .85rem; border: 1px solid rgba(45,212,191,.12); border-radius: 14px; background: rgba(45,212,191,.04); }
  .plan-grid strong { display: block; margin-bottom: .35rem; color: var(--teal); font-size: 12px; }
  .review-section { margin-top: 1.2rem; }
  .review-section details { margin-top: .7rem; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.025); overflow: hidden; }
  .review-section summary { padding: .9rem 1rem; color: #fff; font-size: 13px; font-weight: 750; cursor: pointer; }
  .review-section details > div { padding: 0 1rem 1rem; }
  .review-item { margin-top: .7rem; padding: 1rem; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: rgba(255,255,255,.025); }
  .review-item.is-correct { border-color: rgba(45,212,191,.18); }
  .review-item.is-incorrect { border-color: rgba(229,184,74,.2); }
  .review-item strong { display: block; color: #fff; line-height: 1.45; }
  .review-item p { margin: .45rem 0 0; color: rgba(255,255,255,.6); font-size: 13px; line-height: 1.6; }
  .review-correct { color: var(--teal) !important; }
  .result-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.5rem; }
  .download-button { border-color: rgba(45,212,191,.35); color: var(--teal); background: rgba(45,212,191,.08); }
  .answer-option:focus-visible, .quiz-button:focus-visible, .result-actions a:focus-visible, .review-section summary:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }

  .practice-layout { display: grid; grid-template-columns: .85fr 1.15fr; align-items: start; gap: clamp(2rem, 6vw, 5rem); }
  .practice-steps { display: grid; gap: .85rem; }
  .practice-steps article { display: grid; grid-template-columns: 42px 1fr; gap: .9rem; padding: 1rem; border: 1px solid rgba(255,255,255,.08); border-radius: 18px; background: rgba(255,255,255,.03); }
  .practice-steps strong { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; background: rgba(45,212,191,.1); color: var(--teal); }
  .practice-steps h3 { margin: 0 0 .3rem; color: #fff; font-size: 15px; }
  .practice-steps p { margin: 0; color: rgba(255,255,255,.56); font-size: 13px; line-height: 1.6; }
  .faq-list { display: grid; gap: .7rem; width: min(800px, 100%); margin: 0 auto; }
  .faq-list details { padding: 1rem 1.15rem; border: 1px solid rgba(255,255,255,.09); border-radius: 15px; background: rgba(255,255,255,.03); }
  .faq-list summary { color: #fff; font-weight: 750; cursor: pointer; }
  .faq-list p { margin: .75rem 0 0; color: rgba(255,255,255,.62); font-size: 14px; line-height: 1.7; }

  @media (max-width: 960px) {
    .coverage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .coverage-grid article:last-child { grid-column: 1 / -1; min-height: auto; }
  }
  @media (max-width: 720px) {
    .placement-hero { padding: 112px 0 62px; }
    .placement-hero h1 span { display: inline; }
    .hero-stats { grid-template-columns: 1fr; }
    .hero-stats div + div { border-left: 0; border-top: 1px solid rgba(255,255,255,.09); }
    .coverage-section, .assessment-section, .practice-section, .faq-section { padding: 4.2rem 0; }
    .coverage-grid, .practice-layout { grid-template-columns: 1fr; }
    .coverage-grid article:last-child { grid-column: auto; }
    .coverage-grid article { min-height: auto; }
    .coverage-grid h3 { margin-top: 1.2rem; }
    .quiz-topline { align-items: start; }
    .result-head { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .result-metrics, .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .insight-grid, .practice-allocation { grid-template-columns: 1fr; }
    .domain-row { grid-template-columns: 118px 1fr 36px; gap: .55rem; }
  }
  @media (max-width: 420px) {
    .hero-actions > * { width: 100%; justify-content: center; }
    .quiz-shell, .result-shell { border-radius: 20px; }
    .question-text { min-height: 0; }
    .answer-option { grid-template-columns: 28px 1fr; padding: .8rem; }
    .answer-letter { width: 28px; height: 28px; }
    .domain-row { grid-template-columns: 1fr 36px; }
    .domain-row > span:first-child { grid-column: 1 / -1; }
    .result-metrics, .plan-grid { grid-template-columns: 1fr; }
    .result-actions > * { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .answer-option, .progress-track span { transition: none; }
  }
</style>

<script>
  // @ts-nocheck
  import { jsPDF } from 'jspdf';

  var DOMAIN_NAMES = {
    numerical: 'Numerical reasoning',
    logical: 'Logical reasoning',
    verbal: 'Verbal ability',
    data: 'Data interpretation',
    judgement: 'Workplace judgement'
  };

  var DOMAIN_TIPS = {
    numerical: 'Practise percentages, ratios, averages, profit and loss, and estimation. Write the method before trying to improve speed.',
    logical: 'Practise number patterns, ordering, syllogisms, and classification. Explain why each rejected option is wrong.',
    verbal: 'Build vocabulary in context, revise subject-verb agreement, and practise short reading passages and analogies.',
    data: 'Practise tables, percentage change, conversion rates, and averages. Check units before calculating.',
    judgement: 'Use a simple rule: clarify priorities, communicate early, protect quality, and take ownership without hiding problems.'
  };

  var QUESTIONS = [
    { domain: 'numerical', q: 'What is 15% of 240?', options: ['24', '30', '36', '40'], answer: 2, explanation: 'Calculation: 240 x 15 / 100 = 36. Quick method: 10% is 24 and 5% is 12, so 15% is 24 + 12 = 36.' },
    { domain: 'numerical', q: 'A team has men and women in the ratio 3:5. If the team has 64 people, how many are men?', options: ['18', '24', '32', '40'], answer: 1, explanation: 'Calculation: total ratio parts = 3 + 5 = 8. One part = 64 / 8 = 8. Men = 3 x 8 = 24.' },
    { domain: 'numerical', q: 'What is the average of 18, 22, 26, and 34?', options: ['24', '25', '26', '27'], answer: 1, explanation: 'Calculation: 18 + 22 + 26 + 34 = 100. Average = total / number of values = 100 / 4 = 25.' },
    { domain: 'numerical', q: 'A course priced at Rs 1,500 has a 20% discount. What is the final price?', options: ['Rs 1,100', 'Rs 1,200', 'Rs 1,250', 'Rs 1,300'], answer: 1, explanation: 'Calculation: discount = 1,500 x 20 / 100 = Rs 300. Final price = 1,500 - 300 = Rs 1,200.' },

    { domain: 'logical', q: 'Find the next number: 3, 7, 15, 31, ?', options: ['47', '55', '62', '63'], answer: 3, explanation: 'Pattern: multiply by 2, then add 1. 3 x 2 + 1 = 7; 7 x 2 + 1 = 15; 15 x 2 + 1 = 31; 31 x 2 + 1 = 63.' },
    { domain: 'logical', q: 'All analysts are curious. Some curious people are writers. Which conclusion must be true?', options: ['All writers are analysts', 'Some analysts are writers', 'All analysts are curious', 'No writer is an analyst'], answer: 2, explanation: 'Method: separate what is guaranteed from what is merely possible. All analysts being curious is stated directly. Nothing proves whether analysts and writers overlap.' },
    { domain: 'logical', q: 'D comes before A. A comes before B. C comes after B. Which order is correct?', options: ['A, D, B, C', 'D, A, B, C', 'D, B, A, C', 'C, B, A, D'], answer: 1, explanation: 'Build one chain from the rules: D before A, A before B, and B before C. The complete order is D, A, B, C.' },
    { domain: 'logical', q: 'Which item is different from the others?', options: ['Triangle', 'Square', 'Circle', 'Cube'], answer: 3, explanation: 'Classify by dimension: triangle, square, and circle are two-dimensional. A cube is the only three-dimensional object.' },

    { domain: 'verbal', q: 'Choose the word closest in meaning to "concise".', options: ['Brief', 'Confusing', 'Detailed', 'Polite'], answer: 0, explanation: 'Concise means clear and short without unnecessary words. Brief is the closest meaning; detailed is nearly the opposite.' },
    { domain: 'verbal', q: 'Choose the grammatically correct sentence.', options: ['Each of the candidates have submitted the form.', 'Each of the candidates has submitted the form.', 'Each of the candidate have submitted the form.', 'Each candidates has submitted the form.'], answer: 1, explanation: 'Grammar rule: the subject "each" is singular, even when followed by a plural noun. A singular subject takes "has".' },
    { domain: 'verbal', q: 'Blueprint is to building as recipe is to:', options: ['Kitchen', 'Meal', 'Chef', 'Ingredient'], answer: 1, explanation: 'Relationship: a blueprint is a plan used to create a building. A recipe is a plan used to create a meal.' },
    { domain: 'verbal', q: 'A company introduced flexible hours. Productivity stayed stable, while late arrivals fell. Which conclusion is best supported?', options: ['Flexible hours always increase productivity.', 'Employees worked fewer hours.', 'Flexible hours reduced late arrivals without lowering productivity.', 'Every employee preferred flexible hours.'], answer: 2, explanation: 'Use only the evidence given: late arrivals fell and productivity stayed stable. The passage does not prove fewer hours, universal preference, or an increase in productivity.' },

    { domain: 'data', q: 'A company received 120 applications and shortlisted 30. What percentage was shortlisted?', options: ['20%', '25%', '30%', '40%'], answer: 1, explanation: 'Calculation: shortlisted / applications x 100 = 30 / 120 x 100 = 25%.' },
    { domain: 'data', q: 'Quarterly sales rose from 80 units to 100 units. What was the percentage increase?', options: ['20%', '25%', '30%', '40%'], answer: 1, explanation: 'Calculation: increase = 100 - 80 = 20. Percentage increase = 20 / original value 80 x 100 = 25%.' },
    { domain: 'data', q: 'Campaign A: 50 leads, 10 sales. Campaign B: 80 leads, 20 sales. Campaign C: 40 leads, 12 sales. Which had the highest conversion rate?', options: ['Campaign A', 'Campaign B', 'Campaign C', 'A and B were equal'], answer: 2, explanation: 'Calculate each rate: A = 10/50 = 20%; B = 20/80 = 25%; C = 12/40 = 30%. Campaign C has the highest conversion rate.' },
    { domain: 'data', q: 'A trainee completed 40 tasks in April, 50 in May, and 70 in June. What was the average per month?', options: ['50', '53.3', '55', '60'], answer: 1, explanation: 'Calculation: total tasks = 40 + 50 + 70 = 160. Average = 160 / 3 = 53.33, which rounds to 53.3.' },

    { domain: 'judgement', q: 'Your manager gives you two urgent tasks with the same deadline. What is the best first response?', options: ['Guess which one matters more.', 'Work silently and submit whichever gets finished.', 'Clarify priority, explain the conflict, and propose a realistic plan.', 'Ask a teammate to do one without informing the manager.'], answer: 2, explanation: 'Strong judgement makes the trade-off visible early. Clarify the business priority, state the capacity conflict, and offer a realistic completion plan.' },
    { domain: 'judgement', q: 'You notice a calculation error in a report just before submission. What should you do?', options: ['Submit it and fix it only if someone notices.', 'Flag the issue, correct it, and communicate any short delay.', 'Delete the calculation from the report.', 'Blame the person who shared the data.'], answer: 1, explanation: 'Accuracy and ownership matter more than hiding a delay. Flag the issue, correct it, and communicate the impact before submission.' },
    { domain: 'judgement', q: 'A task requires a tool you have never used. What is the strongest approach?', options: ['Avoid the task.', 'Pretend you know the tool.', 'Learn the essential steps, try a small example, and ask targeted questions if blocked.', 'Wait until someone teaches the whole tool.'], answer: 2, explanation: 'The strongest response combines initiative and risk control: learn the minimum needed, test on a small example, then ask a precise question if blocked.' },
    { domain: 'judgement', q: 'A teammate has missed an important handoff. What should you do first?', options: ['Complain about them in the group chat.', 'Ignore it and finish only your part.', 'Check the blocker, agree on a recovery plan, and escalate early if the deadline is at risk.', 'Take over every task without speaking to them.'], answer: 2, explanation: 'Start with direct problem solving: identify the blocker and agree on recovery. Escalate early only when the shared deadline remains at risk.' }
  ];

  var currentQuestion = 0;
  var answers = new Array(QUESTIONS.length).fill(null);
  var firstAnswers = new Array(QUESTIONS.length).fill(null);
  var answerChanges = new Array(QUESTIONS.length).fill(0);
  var questionTimes = new Array(QUESTIONS.length).fill(0);
  var questionEnteredAt = 0;
  var startedAt = 0;
  var latestReport = null;
  var quizShell = document.getElementById('quiz-shell');
  var resultShell = document.getElementById('result-shell');
  var guidanceHref = resultShell.dataset.guidanceHref || '#plans';
  var guidanceLabel = resultShell.dataset.guidanceLabel || 'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor = 'none';
  var questionText = document.getElementById('question-text');
  var optionList = document.getElementById('option-list');
  var domainLabel = document.getElementById('domain-label');
  var questionCounter = document.getElementById('question-counter');
  var progressLabel = document.getElementById('progress-label');
  var progressFill = document.getElementById('progress-fill');
  var progressTrack = progressFill.parentElement;
  var backButton = document.getElementById('back-button');
  var nextButton = document.getElementById('next-button');

  function escapeHtml(value) {
    return String(value).replace(/[&<>'"]/g, function (character) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character];
    });
  }

  function revealPanel(panel, focusTarget) {
    function positionPanel() {
      var top = panel.getBoundingClientRect().top + window.scrollY - 84;
      window.scrollTo({ top: Math.max(0, top), behavior: 'instant' });
    }
    (focusTarget || panel).focus({ preventScroll: true });
    positionPanel();
    requestAnimationFrame(function () { requestAnimationFrame(positionPanel); });
    window.setTimeout(positionPanel, 80);
    window.setTimeout(positionPanel, 320);
  }

  function renderQuestion() {
    var question = QUESTIONS[currentQuestion];
    var progress = Math.round(((currentQuestion + 1) / QUESTIONS.length) * 100);
    domainLabel.textContent = DOMAIN_NAMES[question.domain];
    questionCounter.textContent = 'Question ' + (currentQuestion + 1) + ' of ' + QUESTIONS.length;
    progressLabel.textContent = progress + '% complete';
    progressFill.style.width = progress + '%';
    progressTrack.setAttribute('aria-valuenow', String(progress));
    progressTrack.setAttribute('aria-valuetext', 'Question ' + (currentQuestion + 1) + ' of ' + QUESTIONS.length);
    questionText.textContent = question.q;
    optionList.innerHTML = '';

    question.options.forEach(function (option, index) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'answer-option' + (answers[currentQuestion] === index ? ' is-selected' : '');
      button.setAttribute('aria-pressed', answers[currentQuestion] === index ? 'true' : 'false');
      button.innerHTML = '<span class="answer-letter">' + String.fromCharCode(65 + index) + '</span><span class="answer-copy">' + escapeHtml(option) + '</span>';
      button.addEventListener('click', function () {
        if (!startedAt) startedAt = Date.now();
        if (!questionEnteredAt) questionEnteredAt = startedAt;
        if (firstAnswers[currentQuestion] === null) firstAnswers[currentQuestion] = index;
        if (answers[currentQuestion] !== null && answers[currentQuestion] !== index) answerChanges[currentQuestion] += 1;
        answers[currentQuestion] = index;
        renderQuestion();
        optionList.children[index].focus();
      });
      optionList.appendChild(button);
    });

    backButton.disabled = currentQuestion === 0;
    nextButton.disabled = answers[currentQuestion] === null;
    nextButton.textContent = currentQuestion === QUESTIONS.length - 1 ? 'See My Result' : 'Next';
  }

  function getBand(percentage) {
    if (percentage >= 85) return { title: 'Strong placement aptitude foundation', body: 'Your accuracy is strong across this short diagnostic. Keep practising under time pressure and focus on the few questions you missed.' };
    if (percentage >= 70) return { title: 'Competitive, with targeted gaps', body: 'You have a useful base. Improving the lowest one or two domains can make your performance more consistent in screening rounds.' };
    if (percentage >= 50) return { title: 'Developing placement readiness', body: 'You have workable strengths, but a few skill gaps can still reduce your score. Focused practice should come before harder mock tests.' };
    return { title: 'Build the foundation before speed', body: 'Your result shows that core methods need attention. Improve accuracy in the lowest domains first, then add timed practice.' };
  }

  function getDomainBand(score) {
    if (score === 4) return 'Strong';
    if (score === 3) return 'Working strength';
    if (score === 2) return 'Developing';
    return 'Priority gap';
  }

  function formatDuration(totalSeconds) {
    var minutes = Math.floor(totalSeconds / 60);
    var seconds = totalSeconds % 60;
    return minutes + 'm ' + String(seconds).padStart(2, '0') + 's';
  }

  function median(values) {
    var sorted = values.slice().sort(function (a, b) { return a - b; });
    var middle = Math.floor(sorted.length / 2);
    return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
  }

  function recordQuestionTime() {
    if (!questionEnteredAt) return;
    questionTimes[currentQuestion] += Math.max(.2, (Date.now() - questionEnteredAt) / 1000);
    questionEnteredAt = Date.now();
  }

  function buildPracticeAllocation(domainScores, domainTimes) {
    var domains = Object.keys(domainScores);
    var personalMedian = median(questionTimes);
    var weights = domains.map(function (domain) {
      var accuracyGap = Math.max(1, 5 - domainScores[domain]);
      var pacePenalty = domainTimes[domain] / 4 > personalMedian * 1.2 ? .75 : 0;
      return accuracyGap + pacePenalty;
    });
    var totalWeight = weights.reduce(function (sum, value) { return sum + value; }, 0);
    var halfHours = weights.map(function (weight) { return Math.max(1, Math.floor((weight / totalWeight) * 20)); });
    var used = halfHours.reduce(function (sum, value) { return sum + value; }, 0);
    var fractions = weights.map(function (weight, index) {
      return { index: index, fraction: ((weight / totalWeight) * 20) - halfHours[index] };
    }).sort(function (a, b) { return b.fraction - a.fraction; });
    var fractionCursor = 0;

    while (used < 20) {
      halfHours[fractions[fractionCursor % fractions.length].index] += 1;
      fractionCursor += 1;
      used += 1;
    }
    while (used > 20) {
      var removable = halfHours.map(function (value, index) { return { index: index, value: value }; })
        .filter(function (item) { return item.value > 1; })
        .sort(function (a, b) { return b.value - a.value; })[0];
      if (!removable) break;
      halfHours[removable.index] -= 1;
      used -= 1;
    }

    return domains.map(function (domain, index) {
      return { domain: domain, hours: halfHours[index] / 2 };
    });
  }

  function buildReport() {
    var domainScores = { numerical: 0, logical: 0, verbal: 0, data: 0, judgement: 0 };
    var domainTimes = { numerical: 0, logical: 0, verbal: 0, data: 0, judgement: 0 };
    var total = 0;

    QUESTIONS.forEach(function (question, index) {
      domainTimes[question.domain] += questionTimes[index];
      if (answers[index] === question.answer) {
        total += 1;
        domainScores[question.domain] += 1;
      }
    });

    var percentage = Math.round((total / QUESTIONS.length) * 100);
    var elapsedSeconds = Math.max(1, Math.round(questionTimes.reduce(function (sum, value) { return sum + value; }, 0)));
    var averageSeconds = Math.max(1, Math.round(elapsedSeconds / QUESTIONS.length));
    var personalMedian = Math.max(1, Math.round(median(questionTimes)));
    var rankedLow = Object.keys(domainScores).sort(function (a, b) {
      return domainScores[a] - domainScores[b] || domainTimes[b] - domainTimes[a];
    });
    var rankedHigh = [...rankedLow].reverse();
    var minimum = domainScores[rankedLow[0]];
    var maximum = domainScores[rankedHigh[0]];
    var strongestDomains = rankedHigh.filter(function (domain) { return domainScores[domain] === maximum; });
    var focusDomains = rankedLow.filter(function (domain) { return domainScores[domain] === minimum; }).slice(0, 2);

    if (focusDomains.length < 2) {
      focusDomains = rankedLow.slice(0, 2);
    }

    var practiceAllocation = buildPracticeAllocation(domainScores, domainTimes);
    var firstHalfScore = QUESTIONS.slice(0, 10).reduce(function (score, question, index) {
      return score + (answers[index] === question.answer ? 1 : 0);
    }, 0);
    var secondHalfScore = QUESTIONS.slice(10).reduce(function (score, question, index) {
      return score + (answers[index + 10] === question.answer ? 1 : 0);
    }, 0);
    var changedQuestions = answerChanges.filter(function (value) { return value > 0; }).length;
    var beneficialChanges = 0;
    var harmfulChanges = 0;
    var rushedMisses = 0;
    var slowMisses = 0;
    var slowCorrect = 0;

    QUESTIONS.forEach(function (question, index) {
      if (answerChanges[index] > 0 && firstAnswers[index] !== question.answer && answers[index] === question.answer) beneficialChanges += 1;
      if (answerChanges[index] > 0 && firstAnswers[index] === question.answer && answers[index] !== question.answer) harmfulChanges += 1;
      if (answers[index] !== question.answer && questionTimes[index] < personalMedian * .65) rushedMisses += 1;
      if (answers[index] !== question.answer && questionTimes[index] > personalMedian * 1.5) slowMisses += 1;
      if (answers[index] === question.answer && questionTimes[index] > personalMedian * 1.5) slowCorrect += 1;
    });

    var domainDiagnostics = Object.keys(domainScores).map(function (domain) {
      return {
        domain: domain,
        score: domainScores[domain],
        accuracy: domainScores[domain] * 25,
        averageTime: Math.max(1, Math.round(domainTimes[domain] / 4)),
      };
    });

    return {
      total: total,
      percentage: percentage,
      band: getBand(percentage),
      elapsedSeconds: elapsedSeconds,
      averageSeconds: averageSeconds,
      medianSeconds: personalMedian,
      domainScores: domainScores,
      domainDiagnostics: domainDiagnostics,
      strongestDomains: strongestDomains,
      focusDomains: focusDomains,
      practiceAllocation: practiceAllocation,
      firstHalfScore: firstHalfScore,
      secondHalfScore: secondHalfScore,
      changedQuestions: changedQuestions,
      beneficialChanges: beneficialChanges,
      harmfulChanges: harmfulChanges,
      rushedMisses: rushedMisses,
      slowMisses: slowMisses,
      slowCorrect: slowCorrect,
      compositeScores: {
        quantitativeCore: Math.round(((domainScores.numerical + domainScores.data) / 8) * 100),
        problemSolving: Math.round((domainScores.logical / 4) * 100),
        communication: Math.round((domainScores.verbal / 4) * 100),
        workplaceExecution: Math.round((domainScores.judgement / 4) * 100),
        consistency: Math.max(0, 100 - ((maximum - minimum) * 25)),
      },
      answers: QUESTIONS.map(function (question, index) {
        return {
          number: index + 1,
          question: question,
          selected: answers[index],
          isCorrect: answers[index] === question.answer,
          firstSelected: firstAnswers[index],
          changes: answerChanges[index],
          time: Math.max(1, Math.round(questionTimes[index])),
        };
      }),
    };
  }

  function getCompositeInsight(label, score) {
    if (score >= 75) return label + ' is currently a useful strength. Maintain it with mixed timed sets.';
    if (score >= 50) return label + ' is developing. Use short focused drills before full mock tests.';
    return label + ' needs foundation work. Slow down, learn the method, and rebuild accuracy first.';
  }

  function showResults() {
    latestReport = buildReport();
    var report = latestReport;
    var rows = Object.keys(report.domainScores).map(function (domain) {
      var score = report.domainScores[domain];
      return '<div class="domain-row"><span>' + DOMAIN_NAMES[domain] + ' - ' + getDomainBand(score) + '</span><div class="domain-bar"><i style="width:' + (score / 4 * 100) + '%"></i></div><span class="domain-score">' + score + '/4</span></div>';
    }).join('');

    var focusCopy = report.focusDomains.map(function (domain) {
      return '<strong>' + DOMAIN_NAMES[domain] + ':</strong> ' + DOMAIN_TIPS[domain];
    }).join('<br><br>');

    var allocationHtml = report.practiceAllocation
      .sort(function (a, b) { return b.hours - a.hours; })
      .map(function (item) {
        return '<div class="allocation-item"><span>' + DOMAIN_NAMES[item.domain] + '</span><strong>' + item.hours + ' hours</strong></div>';
      }).join('');

    var composite = report.compositeScores;
    var insightHtml = [
      ['Quantitative core', composite.quantitativeCore],
      ['Problem solving', composite.problemSolving],
      ['Communication accuracy', composite.communication],
      ['Workplace execution', composite.workplaceExecution],
    ].map(function (item) {
      return '<article><h5>' + item[0] + ': ' + item[1] + '%</h5><p>' + getCompositeInsight(item[0], item[1]) + '</p></article>';
    }).join('');

    var paceHtml = report.domainDiagnostics.map(function (item) {
      var paceMessage = item.averageTime > report.medianSeconds * 1.3
        ? 'Slower than your usual pace. Check whether the method needs simplifying.'
        : item.averageTime < report.medianSeconds * .7
          ? 'Faster than your usual pace. Protect accuracy from avoidable rushing.'
          : 'Close to your usual pace. Improve the method before forcing more speed.';
      return '<article><h5>' + DOMAIN_NAMES[item.domain] + ': ' + item.accuracy + '%</h5><p>' + item.averageTime + ' sec/question. ' + paceMessage + '</p></article>';
    }).join('');

    var revisionMessage = report.changedQuestions === 0
      ? 'You kept every first answer. On the next attempt, change an answer only when you can name the specific evidence or calculation that justifies it.'
      : report.beneficialChanges > report.harmfulChanges
        ? 'Your revisions improved more answers than they harmed. Keep requiring a clear reason before changing a response.'
        : report.harmfulChanges > report.beneficialChanges
          ? 'Some revisions moved away from correct first answers. Avoid changing a response because of vague doubt alone.'
          : 'Your revisions were neutral overall. Use a written check or calculation before replacing a first answer.';

    var reviewHtml = report.answers.map(function (item) {
      var question = item.question;
      var selectedText = question.options[item.selected];
      return '<div class="review-item ' + (item.isCorrect ? 'is-correct' : 'is-incorrect') + '">' +
        '<strong>' + item.number + '. ' + escapeHtml(question.q) + '</strong>' +
        '<p>Your answer: ' + escapeHtml(selectedText) + ' - ' + (item.isCorrect ? 'Correct' : 'Needs review') + '</p>' +
        '<p class="review-correct">Correct answer: ' + escapeHtml(question.options[question.answer]) + '</p>' +
        '<p>' + escapeHtml(question.explanation) + '</p>' +
        '<p>Time: ' + item.time + ' seconds' + (item.changes ? ' | Answer changed ' + item.changes + ' time' + (item.changes === 1 ? '' : 's') : '') + '</p></div>';
    }).join('');

    var focusOne = DOMAIN_NAMES[report.focusDomains[0]];
    var focusTwo = DOMAIN_NAMES[report.focusDomains[1]];
    var strongest = report.strongestDomains.length > 2
      ? report.strongestDomains.length + ' tied strengths'
      : report.strongestDomains.map(function (domain) { return DOMAIN_NAMES[domain]; }).join(' and ');

    resultShell.innerHTML =
      '<div class="result-head">' +
        '<div class="score-ring" style="--score:' + report.percentage + '%"><strong>' + report.percentage + '%</strong><span>' + report.total + ' of ' + QUESTIONS.length + '</span></div>' +
        '<div><span class="result-kicker">Your placement aptitude result</span><h3>' + report.band.title + '</h3><p>' + report.band.body + '</p></div>' +
      '</div>' +
      '<div class="result-metrics">' +
        '<div class="result-metric"><strong>' + strongest + '</strong><span>Strongest current area</span></div>' +
        '<div class="result-metric"><strong>' + focusOne + '</strong><span>First practice priority</span></div>' +
        '<div class="result-metric"><strong>' + formatDuration(report.elapsedSeconds) + '</strong><span>Completion time</span></div>' +
        '<div class="result-metric"><strong>' + report.averageSeconds + ' sec</strong><span>Average per question</span></div>' +
      '</div>' +
      '<div class="domain-results">' + rows + '</div>' +
      '<div class="insight-section"><h4>Accuracy and pacing by domain</h4><div class="insight-grid">' + paceHtml + '</div></div>' +
      '<div class="insight-section"><h4>How you handled the assessment</h4><div class="insight-grid">' +
        '<article><h5>First half: ' + report.firstHalfScore + '/10</h5><p>Second half: ' + report.secondHalfScore + '/10. ' + (report.secondHalfScore < report.firstHalfScore - 2 ? 'Accuracy fell later in the test. Practise longer mixed sets and use a deliberate reset between sections.' : report.secondHalfScore > report.firstHalfScore + 2 ? 'Accuracy improved after the opening questions. Use a short warm-up before a real screening round.' : 'Accuracy stayed reasonably stable across both halves.') + '</p></article>' +
        '<article><h5>Answer revision quality</h5><p>' + revisionMessage + ' Improved: ' + report.beneficialChanges + '; harmed: ' + report.harmfulChanges + '.</p></article>' +
        '<article><h5>Fast incorrect answers: ' + report.rushedMisses + '</h5><p>' + (report.rushedMisses ? 'Some misses were much faster than your normal pace. Re-read units, qualifiers, and the actual question before calculating.' : 'No missed answer was unusually fast relative to your own pace.') + '</p></article>' +
        '<article><h5>Slow incorrect answers: ' + report.slowMisses + '</h5><p>' + (report.slowMisses ? 'Extra time did not solve some questions. Learn a clearer method or use an exit rule rather than staying stuck.' : 'No missed answer took unusually long relative to your own pace.') + '</p></article>' +
      '</div></div>' +
      '<div class="focus-card"><h4>Your first practice priorities</h4><p>' + focusCopy + '</p></div>' +
      '<div class="focus-card"><h4>Suggested 10-hour practice split</h4><p>Spend more time where your current accuracy gap is larger. Recalculate the split after your next attempt.</p><div class="practice-allocation">' + allocationHtml + '</div></div>' +
      '<div class="insight-section"><h4>What your pattern means for placement preparation</h4><div class="insight-grid">' + insightHtml +
        '<article><h5>Consistency: ' + composite.consistency + '%</h5><p>' + (composite.consistency >= 75 ? 'Your domain scores are reasonably balanced. Continue mixed practice.' : 'Your performance is uneven. Improve the weakest domain before relying on the overall score.') + '</p></article>' +
        '<article><h5>How to use your pace</h5><p>' + (report.percentage >= 70 ? 'Accuracy is strong enough to begin timed sets. Reduce time gradually without sacrificing correctness.' : 'Do not chase speed yet. Rebuild the method and accuracy first, then introduce time limits.') + '</p></article>' +
      '</div></div>' +
      '<div class="plan-section"><h4>Your personalized 14-day improvement plan</h4><div class="plan-grid">' +
        '<article><strong>Days 1-4</strong><p>Learn and drill ' + focusOne + '. Review every error and repeat the method without timing.</p></article>' +
        '<article><strong>Days 5-8</strong><p>Focus on ' + focusTwo + '. Move from worked examples to short independent sets.</p></article>' +
        '<article><strong>Days 9-11</strong><p>Mix both priority areas with your strongest domain so switching between question types becomes easier.</p></article>' +
        '<article><strong>Days 12-14</strong><p>Take timed mixed sets, review avoidable errors, and retake this assessment on Day 14.</p></article>' +
      '</div></div>' +
      '<div class="insight-section"><h4>Practical interpretation</h4><div class="insight-grid">' +
        '<article><h5>What the score can tell you</h5><p>It identifies current accuracy patterns and practice priorities across five common aptitude areas.</p></article>' +
        '<article><h5>What it cannot tell you</h5><p>It cannot predict selection, replace employer-specific preparation, or decide which job and career direction fits you fully.</p></article>' +
        '<article><h5>Before an employer test</h5><p>Check the company format, time limit, negative marking, permitted tools, and role-specific sections separately.</p></article>' +
        '<article><h5>For fuller career clarity</h5><p>Use updated career guidance for role direction, skill priorities, positioning, and a stronger long-term career plan.</p></article>' +
      '</div></div>' +
      '<div class="review-section"><h4>Complete answer review and calculations</h4><details><summary>Open all 20 solutions</summary><div>' + reviewHtml + '</div></details></div>' +
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button download-button">Download Detailed PDF</button><a href="' + guidanceHref + '" class="btn-gold">' + guidanceLabel + '</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';

    quizShell.hidden = true;
    resultShell.hidden = false;
    revealPanel(resultShell);
    document.getElementById('retake-button').addEventListener('click', retakeTest);
    document.getElementById('download-button').addEventListener('click', downloadVisualReport);
  }

  function downloadVisualReport() {
    if (!window.downloadAssessmentReportPdf) return;
    window.downloadAssessmentReportPdf({
      container: resultShell,
      title: 'Placement Aptitude Report',
      fileName: 'future-career-school-placement-aptitude-report.pdf'
    });
  }

  function downloadReportPdf() {
    if (!latestReport) return;

    var report = latestReport;
    var doc = new jsPDF({ unit: 'mm', format: 'a4', compress: true });
    var pageWidth = doc.internal.pageSize.getWidth();
    var pageHeight = doc.internal.pageSize.getHeight();
    var margin = 16;
    var contentWidth = pageWidth - (margin * 2);
    var y = 20;

    function addPage() {
      doc.addPage();
      y = 20;
    }

    function ensureSpace(height) {
      if (y + height > pageHeight - 18) addPage();
    }

    function safeText(value) {
      return String(value)
        .replace(/[\u2013\u2014]/g, '-')
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201c\u201d]/g, '"')
        .replace(/₹/g, 'Rs ');
    }

    function measureText(text, size, spacing) {
      doc.setFontSize(size || 10);
      var lines = doc.splitTextToSize(safeText(text), contentWidth);
      return (lines.length * ((size || 10) * .42)) + (spacing || 3);
    }

    function addText(text, size, color, style, spacing) {
      doc.setFont('helvetica', style || 'normal');
      doc.setFontSize(size || 10);
      doc.setTextColor.apply(doc, color || [45, 52, 64]);
      var lines = doc.splitTextToSize(safeText(text), contentWidth);
      var lineHeight = (size || 10) * .42;
      ensureSpace((lines.length * lineHeight) + (spacing || 3));
      doc.text(lines, margin, y);
      y += (lines.length * lineHeight) + (spacing || 3);
    }

    function addSectionTitle(title) {
      ensureSpace(14);
      y += 2;
      doc.setFillColor(235, 245, 243);
      doc.roundedRect(margin, y - 5, contentWidth, 10, 2, 2, 'F');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(12);
      doc.setTextColor(12, 94, 83);
      doc.text(title, margin + 4, y + 1.5);
      y += 10;
    }

    doc.setFillColor(9, 15, 27);
    doc.rect(0, 0, pageWidth, 55, 'F');
    doc.setTextColor(229, 184, 74);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('FUTURE CAREER SCHOOL', margin, 15);
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(24);
    doc.text('Placement Aptitude Report', margin, 29);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.setTextColor(196, 204, 216);
    doc.text('Personalized diagnostic, practice priorities, and complete solutions', margin, 38);
    doc.text(new Date().toLocaleDateString('en-IN'), margin, 46);
    y = 68;

    addText(report.percentage + '% overall accuracy - ' + report.band.title, 18, [16, 24, 40], 'bold', 4);
    addText(report.band.body, 10, [70, 78, 90], 'normal', 5);
    addText('Correct answers: ' + report.total + '/20 | Completion time: ' + formatDuration(report.elapsedSeconds) + ' | Average pace: ' + report.averageSeconds + ' seconds per question', 10, [40, 110, 100], 'bold', 5);

    addSectionTitle('Domain scores');
    Object.keys(report.domainScores).forEach(function (domain) {
      var score = report.domainScores[domain];
      addText(DOMAIN_NAMES[domain] + ': ' + score + '/4 (' + (score * 25) + '%) - ' + getDomainBand(score), 10, [38, 45, 58], 'bold', 2.5);
    });

    addSectionTitle('Accuracy and pacing by domain');
    report.domainDiagnostics.forEach(function (item) {
      addText(DOMAIN_NAMES[item.domain] + ': ' + item.accuracy + '% accuracy | ' + item.averageTime + ' seconds per question', 10, [48, 55, 67], 'normal', 2.5);
    });

    addSectionTitle('How the assessment was handled');
    addText('First half: ' + report.firstHalfScore + '/10 | Second half: ' + report.secondHalfScore + '/10 | Personal median pace: ' + report.medianSeconds + ' seconds', 10, [48, 55, 67], 'bold', 3);
    addText('Answer changes: ' + report.changedQuestions + ' questions | Helpful revisions: ' + report.beneficialChanges + ' | Harmful revisions: ' + report.harmfulChanges, 10, [55, 62, 74], 'normal', 3);
    addText('Fast incorrect answers: ' + report.rushedMisses + ' | Slow incorrect answers: ' + report.slowMisses + ' | Slow correct answers: ' + report.slowCorrect, 10, [55, 62, 74], 'normal', 4);

    addSectionTitle('Calculated readiness indicators');
    addText('Quantitative core: ' + report.compositeScores.quantitativeCore + '% - combined numerical reasoning and data interpretation accuracy.', 10, [55, 62, 74], 'normal', 2.5);
    addText('Problem solving: ' + report.compositeScores.problemSolving + '% - logical pattern and deduction accuracy.', 10, [55, 62, 74], 'normal', 2.5);
    addText('Communication accuracy: ' + report.compositeScores.communication + '% - verbal comprehension, vocabulary, and grammar accuracy.', 10, [55, 62, 74], 'normal', 2.5);
    addText('Workplace execution: ' + report.compositeScores.workplaceExecution + '% - practical judgement around ownership, priorities, and communication.', 10, [55, 62, 74], 'normal', 2.5);
    addText('Score consistency: ' + report.compositeScores.consistency + '% - higher means your performance is more balanced across the five domains.', 10, [55, 62, 74], 'normal', 4);

    addSectionTitle('Personalized priorities');
    report.focusDomains.forEach(function (domain, index) {
      addText((index + 1) + '. ' + DOMAIN_NAMES[domain] + ': ' + DOMAIN_TIPS[domain], 10, [48, 55, 67], index === 0 ? 'bold' : 'normal', 4);
    });

    addSectionTitle('Suggested 10-hour practice allocation');
    report.practiceAllocation.sort(function (a, b) { return b.hours - a.hours; }).forEach(function (item) {
      addText(DOMAIN_NAMES[item.domain] + ': ' + item.hours + ' hours', 10, [48, 55, 67], 'normal', 2.5);
    });

    addSectionTitle('14-day improvement plan');
    addText('Days 1-4: Learn and drill ' + DOMAIN_NAMES[report.focusDomains[0]] + '. Work without time pressure and write the method for every error.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 5-8: Focus on ' + DOMAIN_NAMES[report.focusDomains[1]] + '. Move from worked examples to short independent sets.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 9-11: Mix both priority areas with your strongest domain. Practise switching between different question types.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 12-14: Take timed mixed sets, review avoidable mistakes, and retake the placement aptitude assessment on Day 14.', 10, [48, 55, 67], 'normal', 4);

    addSectionTitle('Practical interpretation');
    addText('Use this report to identify current accuracy patterns and practice priorities. It is not a placement guarantee or a substitute for an employer-specific mock test.', 10, [55, 62, 74], 'normal', 3);
    addText('Before a real screening round, confirm the company format, time limit, negative marking, permitted tools, and role-specific sections.', 10, [55, 62, 74], 'normal', 3);
    addText('For fuller role direction, skill priorities, positioning, and a long-term career plan, use updated career guidance rather than relying on an aptitude score alone.', 10, [55, 62, 74], 'normal', 4);

    addSectionTitle('Complete answer review and calculations');
    report.answers.forEach(function (item) {
      var question = item.question;
      var selectedText = question.options[item.selected];
      var timingText = 'Time: ' + item.time + ' seconds' + (item.changes ? ' | Answer changes: ' + item.changes : '');
      var blockHeight = measureText(item.number + '. ' + question.q, 10, 2.5) +
        measureText('Your answer: ' + selectedText + ' - ' + (item.isCorrect ? 'Correct' : 'Needs review'), 9, 2) +
        measureText('Correct answer: ' + question.options[question.answer], 9, 2) +
        measureText(timingText, 9, 2) +
        measureText(question.explanation, 9, 5);
      ensureSpace(blockHeight);
      addText(item.number + '. ' + question.q, 10, [20, 27, 40], 'bold', 2.5);
      addText('Your answer: ' + selectedText + ' - ' + (item.isCorrect ? 'Correct' : 'Needs review'), 9, item.isCorrect ? [12, 118, 98] : [166, 94, 28], 'bold', 2);
      addText('Correct answer: ' + question.options[question.answer], 9, [12, 118, 98], 'normal', 2);
      addText(timingText, 9, [45, 100, 110], 'normal', 2);
      addText(question.explanation, 9, [65, 72, 84], 'normal', 5);
    });

    var pageCount = doc.getNumberOfPages();
    for (var pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
      doc.setPage(pageNumber);
      doc.setDrawColor(220, 224, 230);
      doc.line(margin, pageHeight - 12, pageWidth - margin, pageHeight - 12);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(8);
      doc.setTextColor(120, 126, 136);
      doc.text('futurecareerschool.com | Page ' + pageNumber + ' of ' + pageCount, margin, pageHeight - 7);
    }

    doc.save('future-career-school-placement-aptitude-report.pdf');
  }

  function retakeTest() {
    currentQuestion = 0;
    answers = new Array(QUESTIONS.length).fill(null);
    firstAnswers = new Array(QUESTIONS.length).fill(null);
    answerChanges = new Array(QUESTIONS.length).fill(0);
    questionTimes = new Array(QUESTIONS.length).fill(0);
    startedAt = Date.now();
    questionEnteredAt = startedAt;
    latestReport = null;
    resultShell.hidden = true;
    quizShell.hidden = false;
    renderQuestion();
    revealPanel(quizShell, questionText);
  }

  backButton.addEventListener('click', function () {
    if (currentQuestion > 0) {
      recordQuestionTime();
      currentQuestion -= 1;
      questionEnteredAt = Date.now();
      renderQuestion();
      questionText.focus({ preventScroll: true });
    }
  });

  nextButton.addEventListener('click', function () {
    if (answers[currentQuestion] === null) return;
    recordQuestionTime();
    if (currentQuestion < QUESTIONS.length - 1) {
      currentQuestion += 1;
      questionEnteredAt = Date.now();
      renderQuestion();
      questionText.focus({ preventScroll: true });
    } else {
      showResults();
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      recordQuestionTime();
      questionEnteredAt = 0;
    } else if (!quizShell.hidden && resultShell.hidden && startedAt) {
      questionEnteredAt = Date.now();
    }
  });

  if ('IntersectionObserver' in window) {
    var timerObserver = new IntersectionObserver(function (entries) {
      if (entries.some(function (entry) { return entry.isIntersecting; }) && !startedAt) {
        startedAt = Date.now();
        questionEnteredAt = startedAt;
        timerObserver.disconnect();
      }
    }, { threshold: .35 });
    timerObserver.observe(quizShell);
  }

  renderQuestion();
</script>
