      ['Translation and setup errors', report.errorFamilies.translation, 'The words, data, or relationship were not converted into the right calculation.'],
      ['Execution and checking errors', report.errorFamilies.execution, 'Arithmetic or reasonableness checks need a more reliable final pass.']
    ].map(function (item) {
      return '<article><h5>' + item[0] + ': ' + item[1] + '</h5><p>' + item[2] + '</p></article>';
