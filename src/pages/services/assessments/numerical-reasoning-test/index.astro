      return '<div class="allocation-item"><span>' + DOMAIN_NAMES[item.domain] + '</span><strong>' + item.hours + ' hours</strong></div>';
    }).join('');
    var reviewHtml = report.answers.map(function (item) {
      var question = item.question;
      return '<div class="review-item ' + (item.correct ? 'is-correct' : 'is-incorrect') + '"><strong>' + item.number + '. ' + escapeHtml(question.q) + '</strong><p>Your answer: ' + escapeHtml(question.options[item.selected]) + ' - ' + (item.correct ? 'Correct' : 'Needs review') + '</p><p class="review-correct">Correct answer: ' + escapeHtml(question.options[question.answer]) + '</p><p>' + escapeHtml(question.explanation) + '</p><p>Time on question: ' + item.time + ' seconds' + (item.changed ? ' | Answer changed ' + item.changed + ' time' + (item.changed === 1 ? '' : 's') : '') + '</p></div>';
    }).join('');

    resultShell.innerHTML =
      '<div class="result-head"><div class="score-ring" style="--score:' + report.percentage + '%"><strong>' + report.percentage + '%</strong><span>' + report.total + ' of 24</span></div><div><span class="result-kicker">' + report.audience.label + ' result</span><h3>' + report.band.title + '</h3><p>' + report.band.body + '</p></div></div>' +
      '<div class="result-metrics"><div class="result-metric"><strong>' + strongest + '</strong><span>Strongest current area</span></div><div class="result-metric"><strong>' + DOMAIN_NAMES[report.focus[0]] + '</strong><span>First practice priority</span></div><div class="result-metric"><strong>' + formatDuration(report.elapsed) + '</strong><span>Active completion time</span></div><div class="result-metric"><strong>' + report.average + ' sec</strong><span>Average per question</span></div></div>' +
      '<div class="domain-results">' + domainRows + '</div>' +
      '<div class="result-section"><h4>Your three broader quantitative indicators</h4><p>These combine related domains from the same 24 answers. They are diagnostic summaries, not standardized percentiles.</p><div class="diagnostic-grid">' + compositeHtml + '</div></div>' +
      '<div class="result-section"><h4>Difficulty transfer and consistency</h4><div class="insight-grid"><article><h5>Foundation: ' + difficultyPct(report.difficulty.foundation) + '%</h5><p>Core percentages, ratios, rates, patterns, totals, and estimation.</p></article><article><h5>Applied: ' + difficultyPct(report.difficulty.applied) + '%</h5><p>Multi-step work, averages, profit, sharing, time, and practical setup.</p></article><article><h5>Advanced: ' + difficultyPct(report.difficulty.advanced) + '%</h5><p>Reverse percentages, mixtures, equal-distance speed, data logic, and expected value.</p></article><article><h5>Domain consistency: ' + report.consistency + '%</h5><p>' + (report.consistency >= 75 ? 'Your six scores are reasonably balanced.' : 'Your overall mark hides an uneven profile, so the weakest domains deserve priority.') + '</p></article></div><p>' + report.transferMessage + '</p></div>' +
      '<div class="result-section"><h4>Domain-by-domain action matrix</h4><div class="diagnostic-grid">' + domainActionHtml + '</div></div>' +
      '<div class="result-section"><h4>Pacing and answer behaviour</h4><p>Timing is compared with your own median of ' + report.medianTime + ' seconds per question. It is not compared with other test takers.</p><div class="pace-table">' + paceHtml + '</div><div class="insight-grid"><article><h5>Fast incorrect answers: ' + report.rushedMisses + '</h5><p>' + (report.rushedMisses ? 'These were much faster than your own usual pace. Add a setup and reasonableness check.' : 'No missed answer was unusually fast relative to your own pace.') + '</p></article><article><h5>Slow incorrect answers: ' + report.slowMisses + '</h5><p>' + (report.slowMisses ? 'Extra time did not solve these items, which points toward a method or concept gap.' : 'No missed answer took unusually long relative to your own pace.') + '</p></article><article><h5>Slow correct answers: ' + report.slowCorrect + '</h5><p>' + (report.slowCorrect ? 'The method worked, but fluency can improve through short focused sets.' : 'Correct answers were not unusually slow relative to your own pace.') + '</p></article><article><h5>Answers reconsidered: ' + report.changedQuestions + '</h5><p>' + report.beneficialChanges + ' changes improved an answer and ' + report.harmfulChanges + ' changed a correct first answer to an incorrect final answer.</p></article></div></div>' +
      '<div class="result-section"><h4>Your error diagnosis</h4><div class="insight-grid">' + errorsHtml + '</div><div class="insight-grid">' + errorFamilyHtml + '</div><p><strong>' + report.verificationSensitiveMisses + ' verification-sensitive miss' + (report.verificationSensitiveMisses === 1 ? '' : 'es') + ':</strong> if arithmetic, data-reading, and estimation checks had corrected all of them, the mathematical review ceiling would be ' + report.reviewCeiling + '%. This is a review opportunity, not a predicted future score.</p></div>' +
      '<div class="result-section"><h4>' + report.audience.title + '</h4><p>' + report.audience.body + '</p><div class="insight-grid"><article><h5>Where to use the skill now</h5>' + listHtml(report.audience.useNow) + '</article><article><h5>What to build next</h5>' + listHtml(report.audience.buildNext) + '</article><article><h5>Important caution</h5><p>' + report.audience.caution + '</p></article><article><h5>Best immediate actions</h5>' + listHtml(report.firstActions) + '</article></div></div>' +
      '<div class="result-section"><h4>Suggested 12-hour practice allocation</h4><p>The split uses accuracy gaps, repeated misses, and relative slowness. Recalculate after your next attempt.</p><div class="practice-allocation">' + allocationHtml + '</div></div>' +
      '<div class="result-section"><h4>Your 14-day improvement plan</h4><div class="plan-grid"><article><strong>Days 1 to 4</strong><p>Learn and drill ' + DOMAIN_NAMES[report.focus[0]] + '. Write every setup and calculation without a timer.</p></article><article><strong>Days 5 to 8</strong><p>Focus on ' + DOMAIN_NAMES[report.focus[1]] + '. Correct the repeated error patterns shown above.</p></article><article><strong>Days 9 to 11</strong><p>Mix both priorities with ' + DOMAIN_NAMES[report.strongest[0]] + ' so switching between methods becomes easier.</p></article><article><strong>Days 12 to 14</strong><p>Use short timed sets, review avoidable mistakes, and retake under similar conditions.</p></article></div></div>' +
      '<div class="result-section"><h4>How to retake without fooling yourself</h4><div class="insight-grid"><article><h5>Wait 10 to 14 days</h5><p>Practise methods between attempts. An immediate retake mainly measures memory of these questions.</p></article><article><h5>Keep conditions similar</h5><p>Use the same calculator rule, similar environment, and comparable time pressure.</p></article><article><h5>Track more than the total</h5><p>Compare domain scores, advanced accuracy, error families, and verification-sensitive misses.</p></article><article><h5>Look for transfer</h5><p>Confirm improvement on unfamiliar questions elsewhere before treating the gain as durable.</p></article></div></div>' +
      '<div class="result-section"><h4>What the score can and cannot tell you</h4><div class="insight-grid"><article><h5>Useful for</h5><p>Current accuracy, domain gaps, difficulty transfer, pacing patterns, error causes, and practice order.</p></article><article><h5>Not a percentile</h5><p>No national norm, IQ score, or employer benchmark is claimed.</p></article><article><h5>Not complete career clarity</h5><p>Numerical skill is one signal. Direction also needs interests, values, wider skills, opportunity, and practical planning.</p></article><article><h5>For fuller decisions</h5><p>Updated career guidance can connect skill evidence with stronger direction, high-value skill building, future readiness, and earlier financial freedom planning.</p></article></div></div>' +
      '<div class="result-section review-section"><h4>Complete worked answer review</h4><details><summary>Open all 24 calculations, timings, and explanations</summary><div>' + reviewHtml + '</div></details></div>' +
