    report.firstActions.forEach(function (item, index) { addText((index + 1) + '. ' + item, 10, [48, 55, 67], index === 0 ? 'bold' : 'normal', 3); });

    addSectionTitle('Suggested 12-hour practice allocation');
    report.allocation.forEach(function (item) { addText(DOMAIN_NAMES[item.domain] + ': ' + item.hours + ' hours', 10, [48, 55, 67], 'normal', 2.5); });

    addSectionTitle('14-day improvement plan');
    addText('Days 1 to 4: Learn and drill ' + DOMAIN_NAMES[report.focus[0]] + '. Work without a timer and write every method.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 5 to 8: Focus on ' + DOMAIN_NAMES[report.focus[1]] + ' and correct the repeated error patterns.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 9 to 11: Mix both priorities with ' + DOMAIN_NAMES[report.strongest[0]] + '.', 10, [48, 55, 67], 'normal', 3);
    addText('Days 12 to 14: Use timed mixed sets, review avoidable mistakes, and retake under similar conditions.', 10, [48, 55, 67], 'normal', 4);

    addSectionTitle('Retake protocol and diagnostic limits');
    addText('Wait 10 to 14 days, keep conditions similar, and compare domain scores, advanced accuracy, error families, and verification-sensitive misses. Confirm gains on unfamiliar questions because an immediate retake can mainly measure memory.', 10, [55, 62, 74], 'normal', 3);
    addText('This report is not a standardized percentile, employer cut-off, IQ score, selection guarantee, or complete career-fit assessment.', 10, [55, 62, 74], 'normal', 3);
    addText('For fuller direction, connect skill evidence with interests, values, wider strengths, market reality, high-value skill building, and practical career planning.', 10, [55, 62, 74], 'normal', 4);

    addSectionTitle('Complete worked solutions');
    report.answers.forEach(function (item) {
      var question = item.question;
      ensureSpace(38);
      addText(item.number + '. ' + question.q, 10, [20, 27, 40], 'bold', 2.5);
      addText('Your answer: ' + question.options[item.selected] + ' - ' + (item.correct ? 'Correct' : 'Needs review'), 9, item.correct ? [12, 118, 98] : [166, 94, 28], 'bold', 2);
      addText('Correct answer: ' + question.options[question.answer], 9, [12, 118, 98], 'normal', 2);
      addText('Time: ' + item.time + ' seconds' + (item.changed ? ' | Answer changes: ' + item.changed : ''), 9, [85, 92, 104], 'normal', 2);
      addText(question.explanation, 9, [65, 72, 84], 'normal', 5);
    });

    var pageCount = doc.getNumberOfPages();
    for (var pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
      doc.setPage(pageNumber);
      doc.setDrawColor(220, 224, 230);
      doc.line(margin, pageHeight - 12, pageWidth - margin, pageHeight - 12);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(8);
      doc.setTextColor(120, 126, 136);
      doc.text('futurecareerschool.com | Page ' + pageNumber + ' of ' + pageCount, margin, pageHeight - 7);
    }
    doc.save('future-career-school-numerical-reasoning-report.pdf');
  }
</script>
