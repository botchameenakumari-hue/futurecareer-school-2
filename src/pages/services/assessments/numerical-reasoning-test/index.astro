    var paceHtml = report.domainDiagnostics.map(function (item) {
      return '<div class="pace-row"><strong>' + DOMAIN_NAMES[item.domain] + '</strong><span>' + item.accuracy + '% accuracy</span><span>' + item.averageTime + ' sec/question</span></div>';
