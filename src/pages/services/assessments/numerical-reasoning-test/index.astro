  var QUESTIONS = [
    { domain:'percent', difficulty:'foundation', q:'A course fee of ₹2,400 is discounted by 15%. What is the sale price?', options:['₹2,040','₹2,160','₹2,250','₹2,360'], answer:0, errors:['','base','arithmetic','base'], explanation:'15% of 2,400 = 2,400 x 15/100 = 360. Sale price = 2,400 - 360 = ₹2,040.' },
    { domain:'ratio', difficulty:'foundation', q:'The ratio of red to blue files is 3:5. If there are 40 files in total, how many are red?', options:['12','15','18','24'], answer:1, errors:['setup','','arithmetic','setup'], explanation:'Total parts = 3 + 5 = 8. Each part = 40/8 = 5. Red files = 3 x 5 = 15.' },
    { domain:'rate', difficulty:'foundation', q:'A vehicle travels 150 km in 3 hours at a constant speed. What is its speed?', options:['45 km/h','50 km/h','55 km/h','60 km/h'], answer:1, errors:['arithmetic','','arithmetic','unit'], explanation:'Speed = distance/time = 150/3 = 50 km/h.' },
    { domain:'number', difficulty:'foundation', q:'What is the next number in the sequence 4, 7, 10, 13, ...?', options:['15','16','17','18'], answer:1, errors:['pattern','','pattern','pattern'], explanation:'The sequence increases by 3 each time. 13 + 3 = 16.' },
    { domain:'data', difficulty:'foundation', q:'A store sold 120 units on Monday and 150 on Tuesday. How many units were sold across both days?', options:['250','260','270','280'], answer:2, errors:['arithmetic','dataread','','arithmetic'], explanation:'Total sold = 120 + 150 = 270 units.' },
    { domain:'estimate', difficulty:'foundation', q:'Which is the best estimate of 49 x 21?', options:['500','750','1,000','1,500'], answer:2, errors:['estimate','estimate','','estimate'], explanation:'Round 49 to 50 and 21 to 20. Then 50 x 20 = 1,000. The exact value is 1,029.' },
    { domain:'percent', difficulty:'foundation', q:'A score rises from 60 to 72. What is the percentage increase?', options:['12%','16%','20%','24%'], answer:2, errors:['base','base','','arithmetic'], explanation:'Increase = 72 - 60 = 12. Percentage increase = 12/60 x 100 = 20%. The original value, 60, is the base.' },
    { domain:'ratio', difficulty:'foundation', q:'A recipe uses flour and sugar in the ratio 4:1. How much sugar is needed for 600 g of flour?', options:['100 g','120 g','150 g','240 g'], answer:2, errors:['setup','arithmetic','','setup'], explanation:'Flour is 4 parts and equals 600 g, so one part = 600/4 = 150 g. Sugar is one part, or 150 g.' },
    { domain:'rate', difficulty:'applied', q:'Five people complete a task in 12 days at the same rate. How many days would 10 people need?', options:['4','6','10','24'], answer:1, errors:['setup','','setup','setup'], explanation:'Total work = 5 x 12 = 60 person-days. With 10 people, time = 60/10 = 6 days.' },
    { domain:'number', difficulty:'applied', q:'If 3x + 7 = 28, what is x?', options:['5','7','9','11'], answer:1, errors:['arithmetic','','setup','setup'], explanation:'3x = 28 - 7 = 21. Therefore x = 21/3 = 7.' },
    { domain:'data', difficulty:'applied', q:'A team completed 18, 24, 21, and 27 tasks over four weeks. What was the weekly average?', options:['21','22','22.5','23'], answer:2, errors:['arithmetic','arithmetic','','setup'], explanation:'Total = 18 + 24 + 21 + 27 = 90. Average = 90/4 = 22.5 tasks.' },
    { domain:'estimate', difficulty:'applied', q:'A budget is ₹79,600 and expected spending is ₹19,850 per quarter. About how many quarters can the budget cover?', options:['2','3','4','5'], answer:2, errors:['estimate','estimate','','estimate'], explanation:'79,600 is about 80,000 and 19,850 is about 20,000. 80,000/20,000 = 4 quarters. Exact division also equals about 4.01.' },
    { domain:'percent', difficulty:'applied', q:'An item costs ₹800 and is sold for ₹920. What is the profit percentage on cost?', options:['12%','15%','18%','20%'], answer:1, errors:['base','','arithmetic','base'], explanation:'Profit = 920 - 800 = 120. Profit percentage on cost = 120/800 x 100 = 15%.' },
    { domain:'ratio', difficulty:'applied', q:'₹7,200 is divided among A, B, and C in the ratio 2:3:4. How much does B receive?', options:['₹1,600','₹2,000','₹2,400','₹3,200'], answer:2, errors:['setup','arithmetic','','setup'], explanation:'Total parts = 2 + 3 + 4 = 9. One part = 7,200/9 = 800. B receives 3 x 800 = ₹2,400.' },
    { domain:'rate', difficulty:'applied', q:'A tap fills 1/4 of a tank in 30 minutes. At the same rate, how long will it take to fill the whole tank?', options:['60 minutes','90 minutes','120 minutes','150 minutes'], answer:2, errors:['setup','setup','','unit'], explanation:'If one quarter takes 30 minutes, four quarters take 4 x 30 = 120 minutes.' },
    { domain:'number', difficulty:'applied', q:'What is the smallest positive number divisible by 6, 8, and 12?', options:['12','24','36','48'], answer:1, errors:['pattern','','pattern','arithmetic'], explanation:'Prime factors: 6 = 2 x 3, 8 = 2³, 12 = 2² x 3. LCM = 2³ x 3 = 24.' },
    { domain:'data', difficulty:'advanced', q:'Revenue rose from ₹4.8 lakh to ₹6 lakh while costs rose from ₹3 lakh to ₹4.2 lakh. What happened to profit?', options:['It fell by ₹0.6 lakh','It stayed at ₹1.8 lakh','It rose by ₹0.6 lakh','It doubled'], answer:1, errors:['dataread','','arithmetic','dataread'], explanation:'Old profit = 4.8 - 3 = ₹1.8 lakh. New profit = 6 - 4.2 = ₹1.8 lakh. Revenue rose, but profit stayed unchanged.' },
    { domain:'estimate', difficulty:'advanced', q:'A report claims that 18% of 2,980 people is 894. What is the best conclusion?', options:['The claim is reasonable','The claim is too low','The claim is too high','There is not enough information'], answer:2, errors:['estimate','estimate','','estimate'], explanation:'18% of about 3,000 is about 540. Exact value is 536.4, so 894 is far too high.' },
    { domain:'percent', difficulty:'advanced', q:'After a 20% price increase, a service costs ₹3,600. What was the original price?', options:['₹2,880','₹3,000','₹3,200','₹3,400'], answer:1, errors:['base','','base','arithmetic'], explanation:'The new price is 120% of the original. Original = 3,600/1.2 = ₹3,000.' },
    { domain:'ratio', difficulty:'advanced', q:'A 30-litre mixture has milk and water in the ratio 4:1. How much water must be added to make the ratio 3:1?', options:['1 litre','2 litres','3 litres','4 litres'], answer:1, errors:['setup','','arithmetic','setup'], explanation:'Milk = 24 L and water = 6 L. For a 3:1 ratio with 24 L milk, water must be 8 L. Add 8 - 6 = 2 L.' },
    { domain:'rate', difficulty:'advanced', q:'A person travels equal distances at 40 km/h and 60 km/h. What is the average speed for the whole trip?', options:['45 km/h','48 km/h','50 km/h','52 km/h'], answer:1, errors:['setup','','setup','arithmetic'], explanation:'For equal distances, average speed is the harmonic mean: 2ab/(a+b) = 2 x 40 x 60/100 = 48 km/h.' },
    { domain:'number', difficulty:'advanced', q:'A number leaves remainder 2 when divided by 5 and remainder 1 when divided by 3. Which option fits?', options:['7','11','17','22'], answer:0, errors:['','pattern','pattern','pattern'], explanation:'Check both conditions. 7 ÷ 5 leaves remainder 2, and 7 ÷ 3 leaves remainder 1. Therefore 7 fits both constraints.' },
    { domain:'data', difficulty:'advanced', q:'A product has 2,000 visitors, a 6% purchase rate, and an average order value of ₹1,250. What revenue does that imply?', options:['₹15,000','₹75,000','₹1,50,000','₹2,50,000'], answer:2, errors:['dataread','setup','','arithmetic'], explanation:'Purchases = 2,000 x 6% = 120. Revenue = 120 x ₹1,250 = ₹1,50,000.' },
    { domain:'estimate', difficulty:'advanced', q:'Project A has a 70% chance of earning ₹1 lakh. Project B has a 40% chance of earning ₹2 lakh. Ignoring all other factors, which has the higher expected value?', options:['Project A','Project B','They are equal','It cannot be compared'], answer:1, errors:['setup','','arithmetic','estimate'], explanation:'Expected value A = 0.70 x ₹1,00,000 = ₹70,000. Expected value B = 0.40 x ₹2,00,000 = ₹80,000. Project B is higher by ₹10,000.' }
  ];
  var startShell = document.getElementById('start-shell');
  var quizShell = document.getElementById('quiz-shell');
  var resultShell = document.getElementById('result-shell');
  var startButton = document.getElementById('start-button');
  var questionText = document.getElementById('question-text');
  var optionList = document.getElementById('option-list');
  var domainLabel = document.getElementById('domain-label');
  var questionCounter = document.getElementById('question-counter');
  var progressLabel = document.getElementById('progress-label');
  var progressFill = document.getElementById('progress-fill');
  var progressTrack = progressFill.parentElement;
  var difficultyLabel = document.getElementById('difficulty-label');
  var backButton = document.getElementById('back-button');
  var nextButton = document.getElementById('next-button');
  var audience = null;
  var currentQuestion = 0;
  var answers = new Array(QUESTIONS.length).fill(null);
  var firstAnswers = new Array(QUESTIONS.length).fill(null);
  var answerChanges = new Array(QUESTIONS.length).fill(0);
  var questionTimes = new Array(QUESTIONS.length).fill(0);
  var questionEnteredAt = 0;
  var startedAt = 0;
  var latestReport = null;
  var guidanceHref = resultShell.dataset.guidanceHref || '#plans';
  var guidanceLabel = resultShell.dataset.guidanceLabel || 'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor = 'none';

  function escapeHtml(value) {
    return String(value).replace(/[&<>'"]/g, function (character) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character];
    });
  }

  function revealPanel(panel, focusTarget) {
    function positionPanel() {
      var top = panel.getBoundingClientRect().top + window.scrollY - 84;
      window.scrollTo({ top: Math.max(0, top), behavior: 'instant' });
    }
    (focusTarget || panel).focus({ preventScroll: true });
    positionPanel();
    requestAnimationFrame(function () { requestAnimationFrame(positionPanel); });
    window.setTimeout(positionPanel, 80);
    window.setTimeout(positionPanel, 320);
  }

  function formatDuration(seconds) {
    return Math.floor(seconds / 60) + 'm ' + String(seconds % 60).padStart(2, '0') + 's';
  }

  function roundedPercentage(score, total) {
    return total ? Math.round((score / total) * 100) : 0;
  }

  function median(values) {
    var sorted = values.slice().sort(function (left, right) { return left - right; });
    var middle = Math.floor(sorted.length / 2);
    return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
  }

  function band(score) {
    if (score >= 85) return { title: 'Strong numerical reasoning foundation', body: 'Your accuracy is strong across the six areas. Use timed mixed sets and harder data problems to make the skill more reliable under pressure.' };
    if (score >= 70) return { title: 'Useful strength with targeted gaps', body: 'You have a solid working base. One or two weaker methods are probably reducing consistency more than the overall score suggests.' };
    if (score >= 50) return { title: 'Developing quantitative readiness', body: 'Several methods are working, but avoidable setup and concept gaps still need focused practice before speed becomes the priority.' };
    return { title: 'Rebuild the method before chasing speed', body: 'Start with foundations and worked examples. Accuracy, units, and correct setup matter more than finishing quickly right now.' };
  }

  function domainBand(score) {
    if (score === 4) return 'Strong';
    if (score === 3) return 'Working strength';
    if (score === 2) return 'Developing';
    return 'Priority gap';
  }

  function recordQuestionTime() {
    if (!questionEnteredAt) return;
    questionTimes[currentQuestion] += Math.max(0.2, (Date.now() - questionEnteredAt) / 1000);
    questionEnteredAt = Date.now();
  }

  function renderQuestion() {
    var question = QUESTIONS[currentQuestion];
    var percentage = Math.round(((currentQuestion + 1) / QUESTIONS.length) * 100);
    domainLabel.textContent = DOMAIN_NAMES[question.domain];
    questionCounter.textContent = 'Question ' + (currentQuestion + 1) + ' of ' + QUESTIONS.length;
    progressLabel.textContent = percentage + '% complete';
    progressFill.style.width = percentage + '%';
    progressTrack.setAttribute('aria-valuenow', String(percentage));
    progressTrack.setAttribute('aria-valuetext', 'Question ' + (currentQuestion + 1) + ' of ' + QUESTIONS.length);
    difficultyLabel.textContent = question.difficulty;
    questionText.textContent = question.q;
    optionList.innerHTML = '';

    question.options.forEach(function (option, index) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'answer-option' + (answers[currentQuestion] === index ? ' is-selected' : '');
      button.setAttribute('aria-pressed', answers[currentQuestion] === index ? 'true' : 'false');
      button.innerHTML = '<span class="answer-letter">' + String.fromCharCode(65 + index) + '</span><span class="answer-copy">' + escapeHtml(option) + '</span>';
      button.addEventListener('click', function () {
        if (firstAnswers[currentQuestion] === null) firstAnswers[currentQuestion] = index;
        if (answers[currentQuestion] !== null && answers[currentQuestion] !== index) answerChanges[currentQuestion] += 1;
        answers[currentQuestion] = index;
        renderQuestion();
        optionList.children[index].focus();
      });
      optionList.appendChild(button);
    });

    backButton.disabled = currentQuestion === 0;
    nextButton.disabled = answers[currentQuestion] === null;
    nextButton.textContent = currentQuestion === QUESTIONS.length - 1 ? 'See My Detailed Result' : 'Next';
  }

  document.querySelectorAll('.audience-option').forEach(function (button) {
    button.addEventListener('click', function () {
      audience = button.dataset.audience;
      document.querySelectorAll('.audience-option').forEach(function (item) {
        var selected = item === button;
        item.classList.toggle('is-selected', selected);
        item.setAttribute('aria-checked', selected ? 'true' : 'false');
      });
      startButton.disabled = false;
      startButton.textContent = 'Start as ' + AUDIENCE[audience].label;
    });
  });

  startButton.addEventListener('click', function () {
    if (!audience) return;
    startedAt = Date.now();
    questionEnteredAt = startedAt;
    startShell.hidden = true;
    quizShell.hidden = false;
    renderQuestion();
    revealPanel(quizShell, questionText);
  });

  backButton.addEventListener('click', function () {
    if (currentQuestion === 0) return;
    recordQuestionTime();
    currentQuestion -= 1;
    questionEnteredAt = Date.now();
    renderQuestion();
    questionText.focus({ preventScroll: true });
  });

  nextButton.addEventListener('click', function () {
    if (answers[currentQuestion] === null) return;
    recordQuestionTime();
    if (currentQuestion < QUESTIONS.length - 1) {
      currentQuestion += 1;
      questionEnteredAt = Date.now();
      renderQuestion();
      questionText.focus({ preventScroll: true });
    } else {
      showResults();
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      recordQuestionTime();
      questionEnteredAt = 0;
    } else if (!quizShell.hidden && resultShell.hidden) {
      questionEnteredAt = Date.now();
    }
  });

  function getDomainAction(domain, score, averageTime, personalMedian) {
    var accuracy = score * 25;
    if (accuracy >= 75 && averageTime <= personalMedian * 1.2) return 'Maintain with mixed practice. Accuracy and relative fluency are both useful here.';
    if (accuracy >= 75) return 'The method is accurate but deliberate. Build fluency with short sets before adding strict time pressure.';
    if (averageTime <= personalMedian * 0.85) return 'You moved relatively quickly but lost accuracy. Slow the setup down and add a final verification step.';
    return DOMAIN_TIPS[domain];
  }

  function buildReport() {
    var domains = { percent: 0, ratio: 0, rate: 0, number: 0, data: 0, estimate: 0 };
    var domainTime = { percent: 0, ratio: 0, rate: 0, number: 0, data: 0, estimate: 0 };
    var difficulty = {
      foundation: { score: 0, total: 0, time: 0 },
      applied: { score: 0, total: 0, time: 0 },
      advanced: { score: 0, total: 0, time: 0 }
    };
    var errors = {};
    var domainWrong = { percent: 0, ratio: 0, rate: 0, number: 0, data: 0, estimate: 0 };
    var total = 0;
    var safeTimes = questionTimes.map(function (time) { return Math.max(0.2, time); });
    var personalMedian = median(safeTimes);
    var fastThreshold = personalMedian * 0.65;
    var slowThreshold = personalMedian * 1.5;
    var rushedMisses = 0;
    var slowMisses = 0;
    var slowCorrect = 0;

    QUESTIONS.forEach(function (question, index) {
      var time = safeTimes[index];
      var isCorrect = answers[index] === question.answer;
      difficulty[question.difficulty].total += 1;
      difficulty[question.difficulty].time += time;
      domainTime[question.domain] += time;

      if (isCorrect) {
        total += 1;
        domains[question.domain] += 1;
        difficulty[question.difficulty].score += 1;
        if (time > slowThreshold) slowCorrect += 1;
      } else {
        domainWrong[question.domain] += 1;
        var tag = question.errors[answers[index]] || 'arithmetic';
        errors[tag] = (errors[tag] || 0) + 1;
        if (time < fastThreshold) rushedMisses += 1;
        if (time > slowThreshold) slowMisses += 1;
      }
    });

    var percentage = roundedPercentage(total, QUESTIONS.length);
    var elapsed = Math.max(1, Math.round(safeTimes.reduce(function (sum, time) { return sum + time; }, 0)));
    var average = Math.round(elapsed / QUESTIONS.length);
    var ranked = Object.keys(domains).sort(function (left, right) { return domains[left] - domains[right]; });
    var low = domains[ranked[0]];
    var high = domains[ranked[ranked.length - 1]];
    var focus = ranked.filter(function (domain) { return domains[domain] === low; }).slice(0, 2);
    if (focus.length < 2) focus = ranked.slice(0, 2);
    var strongest = ranked.filter(function (domain) { return domains[domain] === high; }).reverse();
    var topErrors = Object.keys(errors).sort(function (left, right) { return errors[right] - errors[left]; }).slice(0, 3);
    var errorFamilies = {
      concept: (errors.base || 0) + (errors.pattern || 0) + (errors.unit || 0),
      translation: (errors.setup || 0) + (errors.dataread || 0),
      execution: (errors.arithmetic || 0) + (errors.estimate || 0)
    };
    var verificationSensitiveMisses = (errors.arithmetic || 0) + (errors.dataread || 0) + (errors.estimate || 0);
    var changedQuestions = answerChanges.filter(function (count) { return count > 0; }).length;
    var beneficialChanges = 0;
    var harmfulChanges = 0;
    QUESTIONS.forEach(function (question, index) {
      if (!answerChanges[index]) return;
      if (firstAnswers[index] !== question.answer && answers[index] === question.answer) beneficialChanges += 1;
      if (firstAnswers[index] === question.answer && answers[index] !== question.answer) harmfulChanges += 1;
    });

    var composites = [
      {
        key: 'commercial',
        title: 'Commercial numeracy',
        score: roundedPercentage(domains.percent + domains.ratio, 8),
        body: 'Percentages and ratios used in pricing, discounts, budgets, margins, sharing, scaling, and financial literacy.'
      },
      {
        key: 'applied',
        title: 'Applied quantitative problem solving',
        score: roundedPercentage(domains.rate + domains.data, 8),
        body: 'Rates and data used in reports, productivity, averages, comparisons, operations, and practical decisions.'
      },
      {
        key: 'analytical',
        title: 'Analytical number judgement',
        score: roundedPercentage(domains.number + domains.estimate, 8),
        body: 'Number relationships and estimation used to test constraints, detect implausible claims, and reason before calculating.'
      }
    ].sort(function (left, right) { return right.score - left.score; });

    var domainDiagnostics = Object.keys(domains).map(function (domain) {
      var averageDomainTime = Math.round(domainTime[domain] / 4);
      return {
        domain: domain,
        score: domains[domain],
        accuracy: domains[domain] * 25,
        averageTime: averageDomainTime,
        action: getDomainAction(domain, domains[domain], averageDomainTime, personalMedian)
      };
    });

    var weights = Object.keys(domains).map(function (domain) {
      var relativeSlowness = domainTime[domain] / 4 > personalMedian * 1.5 && domains[domain] < 3 ? 0.5 : 0;
      return { domain: domain, weight: Math.max(0.5, 4 - domains[domain]) + domainWrong[domain] * 0.25 + relativeSlowness };
    });
    var weightTotal = weights.reduce(function (sum, item) { return sum + item.weight; }, 0);
    var allocation = weights.map(function (item) {
      return { domain: item.domain, hours: Math.round((item.weight / weightTotal) * 24) / 2 };
    });
    var allocatedHours = allocation.reduce(function (sum, item) { return sum + item.hours; }, 0);
    allocation.sort(function (left, right) { return right.hours - left.hours; });
    allocation[0].hours = Math.max(0.5, allocation[0].hours + (12 - allocatedHours));

    var foundationScore = roundedPercentage(difficulty.foundation.score, difficulty.foundation.total);
    var appliedScore = roundedPercentage(difficulty.applied.score, difficulty.applied.total);
    var advancedScore = roundedPercentage(difficulty.advanced.score, difficulty.advanced.total);
    var transferGap = foundationScore - advancedScore;
    var transferMessage = transferGap >= 30
      ? 'Your foundation score drops sharply on advanced questions. The next priority is transferring known methods into multi-step and less familiar situations.'
      : transferGap >= 15
        ? 'Your methods are more reliable on straightforward questions than on advanced applications. Add mixed, multi-step practice.'
        : 'Your accuracy holds relatively steadily as difficulty rises. Keep strengthening the weakest domain rather than only repeating easy questions.';

    var firstActions = [
      'Rebuild ' + DOMAIN_NAMES[focus[0]] + ' first: ' + DOMAIN_TIPS[focus[0]],
      topErrors.length ? 'Prevent ' + ERROR_NAMES[topErrors[0]].toLowerCase() + ' by writing one explicit check beside every worked answer.' : 'Maintain accuracy with mixed questions and explain the method before checking the options.',
      rushedMisses ? 'Use a two-pass rule: solve, then verify the unit, base, denominator, and approximate answer before moving on.' : slowMisses ? 'Work through solved examples until the setup becomes easier, then add short time limits.' : 'Move to short timed sets only after preserving the same accuracy.'
    ];

    return {
      total: total,
      percentage: percentage,
      band: band(percentage),
      elapsed: elapsed,
      average: average,
      medianTime: Math.round(personalMedian),
      domains: domains,
      domainDiagnostics: domainDiagnostics,
      difficulty: difficulty,
      focus: focus,
      strongest: strongest,
      allocation: allocation,
      errors: errors,
      topErrors: topErrors,
      errorFamilies: errorFamilies,
      verificationSensitiveMisses: verificationSensitiveMisses,
      reviewCeiling: Math.min(100, roundedPercentage(total + verificationSensitiveMisses, QUESTIONS.length)),
      composites: composites,
      consistency: Math.max(0, 100 - (high - low) * 25),
      transferGap: transferGap,
      transferMessage: transferMessage,
      rushedMisses: rushedMisses,
      slowMisses: slowMisses,
      slowCorrect: slowCorrect,
      changedQuestions: changedQuestions,
      beneficialChanges: beneficialChanges,
      harmfulChanges: harmfulChanges,
      firstActions: firstActions,
      audience: AUDIENCE[audience],
      answers: QUESTIONS.map(function (question, index) {
        return {
          number: index + 1,
          question: question,
          selected: answers[index],
          correct: answers[index] === question.answer,
          time: Math.max(1, Math.round(safeTimes[index])),
          changed: answerChanges[index]
        };
      })
    };
  }

  function difficultyPct(item) {
    return roundedPercentage(item.score, item.total);
  }

  function listHtml(items) {
    return '<ul class="signal-list">' + items.map(function (item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('') + '</ul>';
  }

