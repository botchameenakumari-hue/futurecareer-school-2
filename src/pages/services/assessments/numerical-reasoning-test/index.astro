---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/numerical-reasoning-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/placement-aptitude-test/',
    title: 'Placement Aptitude Test',
    description: 'Use the wider placement test when you also want logical, verbal, data, and workplace-judgement scores.',
  },
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduate and Early Professional Assessment',
    description: 'Use the broader assessment when role fit, employability, skill direction, and career clarity matter alongside aptitude.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'Who can take this numerical reasoning test?',
    a: 'School students, college students, graduates, job seekers, and working professionals can use it. Choose your current stage before starting so the result interpretation and action plan fit your context.',
  },
  {
    q: 'What does the test measure?',
    a: 'It measures six practical areas: percentages and commercial arithmetic, ratios and proportions, rates and applied maths, number logic, data interpretation, and estimation with quantitative decision-making.',
  },
  {
    q: 'Is the result a percentile or employer score?',
    a: 'No. It is a free diagnostic based only on your answers in this test. It does not claim a national percentile, psychometric norm, or employer-specific cut-off.',
  },
  {
    q: 'Can I download the full result?',
    a: 'Yes. The downloadable PDF is generated as a properly paginated report with your scores, error patterns, practice allocation, action plan, and complete worked solutions.',
  },
  {
    q: 'Will a high score tell me which career to choose?',
    a: 'No. Numerical reasoning is one useful skill signal, not complete career clarity. Career direction also needs interests, values, wider skills, market reality, and a practical future-readiness plan.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Numerical Reasoning Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Numerical Reasoning Test',
    description: 'A free 24-question numerical reasoning test with six domain scores, audience-specific interpretation, error-pattern analysis, worked solutions, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Numerical Reasoning Test | Free Test with Detailed Results"
  description="Take a free 24-question numerical reasoning test for students, job seekers, and professionals. Get six skill scores, worked calculations, error analysis, and a PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <main>
    <section id="hero" class="reasoning-hero">
      <div class="number-field" aria-hidden="true">7 24 % 3:5 1.25 48 360 x 12</div>
      <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--teal" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Numerical Reasoning Test</span>
        </nav>
        <div class="eyebrow"><span></span> Free quantitative diagnostic</div>
        <h1>Numerical Reasoning Test <span>with Worked Results</span></h1>
        <p class="hero-sub">
          Measure how accurately you handle numbers, ratios, rates, data, estimation, and practical quantitative decisions. Your result adapts to your current stage and shows exactly what to improve next.
        </p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>24</strong><span>questions</span></div>
          <div><strong>6</strong><span>reasoning areas</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <div class="related-name-row" aria-label="Related test names">
          <span>numerical reasoning test</span><span>numerical aptitude test</span><span>quantitative reasoning test</span><span>free numerical test</span>
        </div>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="coverage-section">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">A six-part quantitative picture</span>
          <h2>See more than one overall score</h2>
          <p>The test separates foundational calculation from applied reasoning, data accuracy, number logic, and estimation.</p>
        </div>
        <div class="coverage-grid">
          <article><b>01</b><h3>Percentages</h3><p>Discounts, changes, profit, interest, and percentage bases.</p></article>
          <article><b>02</b><h3>Ratios</h3><p>Proportion, sharing, scaling, mixtures, and comparisons.</p></article>
          <article><b>03</b><h3>Rates</h3><p>Speed, work, unit rates, averages, and practical arithmetic.</p></article>
          <article><b>04</b><h3>Number logic</h3><p>Sequences, algebraic relationships, factors, and constraints.</p></article>
          <article><b>05</b><h3>Data</h3><p>Tables, totals, percentage change, and accurate conclusions.</p></article>
          <article><b>06</b><h3>Estimation</h3><p>Approximation, reasonableness checks, and decision trade-offs.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">Choose your context first</span>
          <h2>Get a result that speaks to your stage</h2>
          <p>Everyone answers the same fair reasoning core. Your interpretation and action plan change based on where you need to use the skill.</p>
        </div>

        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Build foundations for subjects, streams, and future readiness.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Check applied quantitative readiness before internships and placements.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Diagnose numerical gaps before aptitude and screening rounds.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Check data confidence and quantitative decisions used at work.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>Calculator-free practice is recommended. There is no negative marking.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline">
            <div><span id="domain-label" class="domain-label">Percentages</span><span id="question-counter" class="question-counter">Question 1 of 24</span></div>
            <span id="progress-label" class="progress-label">4% complete</span>
          </div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Question 1 of 24"><span id="progress-fill"></span></div>
          <div class="difficulty-line"><span id="difficulty-label">Foundation</span><span id="pace-label">Take the time needed for accuracy</span></div>
          <div class="question-panel">
            <p id="question-text" class="question-text" tabindex="-1">Loading question...</p>
            <div id="option-list" class="option-list" role="group" aria-label="Answer choices"></div>
          </div>
          <div class="quiz-nav">
            <button id="back-button" class="quiz-button quiz-button--secondary" type="button" disabled>Back</button>
            <button id="next-button" class="quiz-button quiz-button--primary" type="button" disabled>Next</button>
          </div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Numerical reasoning results"></div>
        <p class="assessment-note">This is a practice diagnostic, not a standardized percentile, employer cut-off, selection guarantee, or complete measure of intelligence or career fit.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Turn mistakes into a method</span><h2>The report diagnoses how the error happened</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Concept gaps</h3><p>See whether percentages, ratios, rates, or number relationships need rebuilding.</p></article>
          <article><strong>2</strong><h3>Setup errors</h3><p>Spot cases where the right numbers were present but the relationship was set up incorrectly.</p></article>
          <article><strong>3</strong><h3>Data-reading errors</h3><p>Separate calculation mistakes from choosing the wrong row, unit, total, or comparison.</p></article>
          <article><strong>4</strong><h3>Reasonableness checks</h3><p>Use estimation to reject impossible answers before spending time on exact arithmetic.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use the score</h2></div>
        <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when the question includes placement readiness, career direction, role fit, or professional growth beyond numerical reasoning." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Numerical Reasoning Report"
    fileName="future-career-school-numerical-reasoning-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="NUMERICAL REASONING EVIDENCE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .reasoning-hero { position: relative; overflow: hidden; padding: 132px 0 78px; }
  .number-field { position: absolute; inset: 80px -5% auto; color: rgba(255,255,255,.025); font: 800 clamp(4rem, 12vw, 10rem)/.8 monospace; letter-spacing: .08em; white-space: nowrap; transform: rotate(-5deg); user-select: none; }
  .hero-glow { position: absolute; width: 430px; height: 430px; border-radius: 50%; filter: blur(110px); opacity: .17; pointer-events: none; }
  .hero-glow--gold { top: 18px; left: -180px; background: #e5b84a; }
  .hero-glow--teal { right: -190px; bottom: -80px; background: #2dd4bf; }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-bottom: 1.6rem; font-size: 13px; color: rgba(255,255,255,.46); }
  .eyebrow, .section-kicker { color: var(--teal); font-size: 12px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .eyebrow { display: inline-flex; align-items: center; gap: .55rem; padding: .5rem .85rem; border: 1px solid rgba(45,212,191,.24); border-radius: 999px; background: rgba(45,212,191,.07); }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 5px rgba(45,212,191,.1); }
  .reasoning-hero h1 { max-width: 940px; margin: 1.2rem 0 .9rem; color: #fff; font-size: clamp(2.35rem, 6vw, 4.75rem); line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .reasoning-hero h1 span { display: block; color: var(--gold); }
  .hero-sub { max-width: 760px; margin: 0; color: rgba(255,255,255,.68); font-size: clamp(15px, 1.8vw, 18px); line-height: 1.72; }
  .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); width: min(600px, 100%); margin: 2rem 0; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(255,255,255,.035); overflow: hidden; }
  .hero-stats div { display: grid; gap: .15rem; padding: 1rem; }
  .hero-stats div + div { border-left: 1px solid rgba(255,255,255,.09); }
  .hero-stats strong { color: #fff; font-size: 1.2rem; }
  .hero-stats span { color: rgba(255,255,255,.48); font-size: 12px; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .related-name-row { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-top: 1.5rem; }
  .related-name-row span { padding: .35rem .65rem; border-radius: 999px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.42); font-size: 11px; }
  .coverage-section, .assessment-section, .method-section, .faq-section { padding: 5.5rem 0; }
  .coverage-section, .method-section { background: rgba(255,255,255,.012); }
  .section-heading { max-width: 760px; margin: 0 auto 2.4rem; text-align: center; }
  .section-heading h2, .method-layout h2 { margin: .65rem 0 .75rem; color: #fff; font-size: clamp(1.85rem, 4vw, 3rem); line-height: 1.08; letter-spacing: -.04em; text-wrap: balance; }
  .section-heading p { margin: 0 auto; color: rgba(255,255,255,.58); line-height: 1.7; }
  .coverage-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .coverage-grid article { min-height: 170px; padding: 1.25rem; border: 1px solid rgba(255,255,255,.09); border-radius: 22px; background: linear-gradient(155deg, rgba(255,255,255,.05), rgba(255,255,255,.018)); }
  .coverage-grid b { color: var(--gold); font-size: 11px; letter-spacing: .1em; }
  .coverage-grid h3 { margin: 1.6rem 0 .5rem; color: #fff; font-size: 17px; }
  .coverage-grid p { margin: 0; color: rgba(255,255,255,.56); font-size: 13px; line-height: 1.6; }
  .start-shell, .quiz-shell, .result-shell { width: min(880px, 100%); margin: 0 auto; padding: clamp(1.2rem, 3vw, 2.2rem); border: 1px solid rgba(255,255,255,.11); border-radius: 28px; background: radial-gradient(520px 220px at 100% 0, rgba(45,212,191,.08), transparent 70%), rgba(255,255,255,.03); box-shadow: 0 34px 90px -60px rgba(0,0,0,.95); }
  .start-shell { text-align: center; }
  .audience-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; margin-bottom: 1.2rem; }
  .audience-option { display: grid; gap: .4rem; padding: 1rem; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: rgba(255,255,255,.03); color: #fff; font: inherit; text-align: left; cursor: pointer; }
  .audience-option span { color: rgba(255,255,255,.55); font-size: 13px; line-height: 1.55; }
  .audience-option:hover, .audience-option.is-selected { border-color: rgba(229,184,74,.6); background: linear-gradient(135deg, rgba(229,184,74,.13), rgba(45,212,191,.05)); }
  .start-shell > p { margin: .9rem 0 0; color: rgba(255,255,255,.42); font-size: 12px; }
  .quiz-shell[hidden], .result-shell[hidden], .start-shell[hidden] { display: none; }
  .quiz-topline { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .quiz-topline > div { display: grid; gap: .25rem; }
  .domain-label { color: var(--gold); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .question-counter, .progress-label { color: rgba(255,255,255,.48); font-size: 12px; }
  .progress-track { height: 7px; margin: .8rem 0 .7rem; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.08); }
  .progress-track span { display: block; width: 4%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--teal), var(--gold)); transition: width .25s ease; }
  .difficulty-line { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1.7rem; color: rgba(255,255,255,.4); font-size: 11px; }
  #difficulty-label { color: rgba(45,212,191,.9); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .question-text { min-height: 3.1em; margin: 0 0 1.35rem; color: #fff; font-size: clamp(1.15rem, 2.6vw, 1.55rem); font-weight: 750; line-height: 1.48; white-space: pre-line; }
  .option-list { display: grid; gap: .7rem; }
  .answer-option { display: grid; grid-template-columns: 32px 1fr; align-items: start; gap: .8rem; width: 100%; padding: .9rem 1rem; border: 1px solid rgba(255,255,255,.085); border-radius: 15px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.82); font: inherit; text-align: left; cursor: pointer; }
  .answer-option:hover { border-color: rgba(229,184,74,.34); background: rgba(255,255,255,.06); }
  .answer-option.is-selected { border-color: rgba(229,184,74,.62); background: linear-gradient(135deg, rgba(229,184,74,.14), rgba(229,184,74,.04)); color: #fff; }
  .answer-letter { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,.08); color: rgba(255,255,255,.62); font-size: 12px; font-weight: 800; }
  .answer-option.is-selected .answer-letter { background: var(--gold); color: #0a0f1e; }
  .answer-copy { padding-top: .3rem; line-height: 1.5; }
  .quiz-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.08); }
  .quiz-button { min-width: 120px; min-height: 46px; padding: .7rem 1.2rem; border-radius: 12px; font: inherit; font-size: 14px; font-weight: 800; cursor: pointer; }
  .quiz-button:disabled { opacity: .35; cursor: not-allowed; }
  .quiz-button--secondary { border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.72); }
  .quiz-button--primary { border: 0; background: linear-gradient(135deg, #e5b84a, #f5d98c); color: #0a0f1e; }
  .assessment-note { max-width: 760px; margin: 1rem auto 0; color: rgba(255,255,255,.4); font-size: 12px; line-height: 1.6; text-align: center; }
  .result-head { display: grid; grid-template-columns: 140px 1fr; align-items: center; gap: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.09); }
  .score-ring { display: grid; place-items: center; width: 140px; height: 140px; border-radius: 50%; background: conic-gradient(var(--gold) var(--score), rgba(255,255,255,.08) 0); position: relative; }
  .score-ring::after { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: #0c111d; }
  .score-ring strong, .score-ring span { position: relative; z-index: 1; }
  .score-ring strong { color: #fff; font-size: 2rem; line-height: 1; }
  .score-ring span { color: rgba(255,255,255,.48); font-size: 11px; }
  .result-kicker { color: var(--teal); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .result-head h3 { margin: .45rem 0 .5rem; color: #fff; font-size: clamp(1.55rem, 3vw, 2.2rem); }
  .result-head p { margin: 0; color: rgba(255,255,255,.58); line-height: 1.65; }
  .result-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; margin: 1rem 0; }
  .result-metric, .insight-grid article, .plan-grid article, .error-card, .diagnostic-card { padding: .95rem; border: 1px solid rgba(255,255,255,.08); border-radius: 16px; background: rgba(255,255,255,.025); }
  .result-metric { display: grid; gap: .3rem; }
  .result-metric strong { color: #fff; font-size: 14px; }
  .result-metric span { color: rgba(255,255,255,.43); font-size: 11px; line-height: 1.4; }
  .domain-results { display: grid; gap: .7rem; margin: 1.2rem 0; }
  .domain-row { display: grid; grid-template-columns: 170px 1fr 42px; align-items: center; gap: .75rem; color: rgba(255,255,255,.72); font-size: 12px; }
  .domain-bar { height: 8px; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.08); }
  .domain-bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--teal), var(--gold)); }
  .domain-score { color: var(--gold); font-weight: 800; text-align: right; }
  .result-section { margin-top: 1.3rem; padding-top: 1.2rem; border-top: 1px solid rgba(255,255,255,.08); }
  .result-section h4 { margin: 0 0 .8rem; color: #fff; font-size: 1.15rem; }
  .result-section > p { color: rgba(255,255,255,.58); line-height: 1.65; }
  .insight-grid, .plan-grid, .practice-allocation, .diagnostic-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; }
  .insight-grid h5, .plan-grid strong, .error-card strong, .diagnostic-card h5 { margin: 0 0 .35rem; color: #fff; font-size: 13px; }
  .insight-grid p, .plan-grid p, .error-card p, .diagnostic-card p { margin: 0; color: rgba(255,255,255,.52); font-size: 12px; line-height: 1.58; }
  .diagnostic-card--priority { border-color: rgba(229,184,74,.3); background: linear-gradient(145deg, rgba(229,184,74,.09), rgba(255,255,255,.02)); }
  .diagnostic-score { display: block; margin-bottom: .45rem; color: var(--gold); font-size: 1.5rem; font-weight: 850; line-height: 1; }
  .signal-list { display: grid; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .signal-list li { position: relative; padding-left: 1rem; color: rgba(255,255,255,.6); font-size: 12px; line-height: 1.62; }
  .signal-list li::before { content: ''; position: absolute; top: .62em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--teal); }
  .pace-table { display: grid; gap: .55rem; }
