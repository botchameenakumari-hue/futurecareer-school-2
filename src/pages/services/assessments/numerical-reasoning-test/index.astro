  function retake() {
    currentQuestion = 0;
    answers = new Array(QUESTIONS.length).fill(null);
    firstAnswers = new Array(QUESTIONS.length).fill(null);
    answerChanges = new Array(QUESTIONS.length).fill(0);
    questionTimes = new Array(QUESTIONS.length).fill(0);
    latestReport = null;
    startedAt = Date.now();
    questionEnteredAt = startedAt;
    resultShell.hidden = true;
    quizShell.hidden = false;
    renderQuestion();
    revealPanel(quizShell, questionText);
  }

  function downloadVisualReport() {
    if (!window.downloadAssessmentReportPdf) return;
    window.downloadAssessmentReportPdf({
      container: resultShell,
      title: 'Numerical Reasoning Report',
      fileName: 'future-career-school-numerical-reasoning-report.pdf'
    });
  }

  function downloadPdf() {
    if (!latestReport) return;
    var report = latestReport;
    var doc = new jsPDF({ unit: 'mm', format: 'a4', compress: true });
    var pageWidth = doc.internal.pageSize.getWidth();
    var pageHeight = doc.internal.pageSize.getHeight();
    var margin = 16;
    var contentWidth = pageWidth - margin * 2;
    var y = 20;

    function addPage() { doc.addPage(); y = 20; }
    function ensureSpace(height) { if (y + height > pageHeight - 18) addPage(); }
    function addText(value, size, color, style, spacing) {
      doc.setFont('helvetica', style || 'normal');
      doc.setFontSize(size || 10);
      doc.setTextColor.apply(doc, color || [45, 52, 64]);
      var pdfSafeValue = String(value)
        .replace(/₹/g, 'Rs ')
        .replace(/÷/g, '/')
        .replace(/²/g, '^2')
        .replace(/³/g, '^3')
        .replace(/[–—]/g, '-')
        .replace(/’/g, "'");
      var lines = doc.splitTextToSize(pdfSafeValue, contentWidth);
      var lineHeight = (size || 10) * 0.42;
      ensureSpace(lines.length * lineHeight + (spacing || 3));
      doc.text(lines, margin, y);
      y += lines.length * lineHeight + (spacing || 3);
    }
    function addSectionTitle(value) {
      ensureSpace(14);
      y += 2;
      doc.setFillColor(235, 245, 243);
      doc.roundedRect(margin, y - 5, contentWidth, 10, 2, 2, 'F');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(12);
      doc.setTextColor(12, 94, 83);
      doc.text(value, margin + 4, y + 1.5);
      y += 10;
    }

    doc.setFillColor(9, 15, 27);
    doc.rect(0, 0, pageWidth, 55, 'F');
    doc.setTextColor(229, 184, 74);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('FUTURE CAREER SCHOOL', margin, 15);
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(23);
    doc.text('Numerical Reasoning Report', margin, 29);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.setTextColor(196, 204, 216);
    doc.text(report.audience.label + ' diagnostic with worked solutions', margin, 38);
    doc.text(new Date().toLocaleDateString('en-IN'), margin, 46);
    y = 68;

    addText(report.percentage + '% overall accuracy - ' + report.band.title, 18, [16, 24, 40], 'bold', 4);
    addText(report.band.body, 10, [70, 78, 90], 'normal', 4);
    addText('Correct: ' + report.total + '/24 | Active time: ' + formatDuration(report.elapsed) + ' | Average pace: ' + report.average + ' seconds | Personal median: ' + report.medianTime + ' seconds', 10, [40, 110, 100], 'bold', 5);

    addSectionTitle('Six domain scores and pace');
    report.domainDiagnostics.forEach(function (item) {
      addText(DOMAIN_NAMES[item.domain] + ': ' + item.score + '/4 (' + item.accuracy + '%) | ' + item.averageTime + ' sec/question | ' + domainBand(item.score), 10, [38, 45, 58], 'bold', 2.5);
      addText(item.action, 9, [65, 72, 84], 'normal', 3);
    });

    addSectionTitle('Three broader quantitative indicators');
    report.composites.forEach(function (item) {
      addText(item.title + ': ' + item.score + '%', 10, [38, 45, 58], 'bold', 2);
      addText(item.body, 9, [65, 72, 84], 'normal', 3);
    });

    addSectionTitle('Difficulty transfer and consistency');
    ['foundation', 'applied', 'advanced'].forEach(function (level) {
      addText(level.charAt(0).toUpperCase() + level.slice(1) + ': ' + difficultyPct(report.difficulty[level]) + '% (' + report.difficulty[level].score + '/' + report.difficulty[level].total + ')', 10, [48, 55, 67], 'normal', 2.5);
    });
    addText('Domain consistency: ' + report.consistency + '%', 10, [48, 55, 67], 'normal', 2.5);
    addText(report.transferMessage, 10, [48, 55, 67], 'normal', 4);

    addSectionTitle('Pacing and answer behaviour');
    addText('Fast incorrect answers: ' + report.rushedMisses + ' | Slow incorrect answers: ' + report.slowMisses + ' | Slow correct answers: ' + report.slowCorrect, 10, [48, 55, 67], 'normal', 3);
    addText('Answers reconsidered: ' + report.changedQuestions + ' | Helpful changes: ' + report.beneficialChanges + ' | Harmful changes: ' + report.harmfulChanges, 10, [48, 55, 67], 'normal', 4);

    addSectionTitle('Error diagnosis and checking opportunity');
    if (report.topErrors.length) {
      report.topErrors.forEach(function (tag) { addText(ERROR_NAMES[tag] + ': ' + report.errors[tag] + ' occurrence' + (report.errors[tag] === 1 ? '' : 's'), 10, [48, 55, 67], 'normal', 2.5); });
    } else {
      addText('No repeated error pattern was detected.', 10, [48, 55, 67], 'normal', 3);
    }
    addText('Concept and rule errors: ' + report.errorFamilies.concept + ' | Translation and setup errors: ' + report.errorFamilies.translation + ' | Execution and checking errors: ' + report.errorFamilies.execution, 10, [48, 55, 67], 'normal', 3);
    addText('Verification-sensitive misses: ' + report.verificationSensitiveMisses + '. If all were corrected, the mathematical review ceiling would be ' + report.reviewCeiling + '%. This is not a predicted score.', 10, [55, 62, 74], 'normal', 4);

    addSectionTitle('Interpretation for ' + report.audience.label);
    addText(report.audience.title, 11, [20, 27, 40], 'bold', 3);
    addText(report.audience.body, 10, [55, 62, 74], 'normal', 4);
    addText('Where to use the skill now:', 10, [20, 27, 40], 'bold', 2);
    report.audience.useNow.forEach(function (item, index) { addText((index + 1) + '. ' + item, 9, [55, 62, 74], 'normal', 2); });
    addText('What to build next:', 10, [20, 27, 40], 'bold', 2);
    report.audience.buildNext.forEach(function (item, index) { addText((index + 1) + '. ' + item, 9, [55, 62, 74], 'normal', 2); });
