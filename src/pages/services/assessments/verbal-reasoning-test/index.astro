  function buildEnhancedReport(){
    var report=buildReport();
    var domainScores={};
    report.domainDiagnostics.forEach(function(item){domainScores[item.domain]=item.accuracy;});
    var languageScore=report.composites[0].score;
    var evidenceScore=report.composites[1].score;
    var communicationScore=report.composites[2].score;
    var profileScores=[
      {key:'language',title:'Precision-first communicator',score:languageScore,body:'You currently handle wording and sentence construction more reliably than the other broad areas. The next gain comes from applying that precision to evidence and real decisions.'},
      {key:'evidence',title:'Evidence-led reader',score:evidenceScore,body:'Your strongest broad signal is understanding passages and judging what the evidence supports. Protect that strength when information becomes longer, faster, or more persuasive.'},
      {key:'communication',title:'Practical message shaper',score:communicationScore,body:'Your strongest broad signal is recognising relationships and choosing communication that helps a reader act. Keep strengthening the evidence underneath the message.'}
    ].sort(function(a,b){return b.score-a.score;});
