      doc.setTextColor.apply(doc,color||[45,52,64]);
      var lines=doc.splitTextToSize(safeText(value),contentWidth);
      var lineHeight=(size||10)*.42;
      ensureSpace(lines.length*lineHeight+(spacing||3));
      doc.text(lines,margin,y);
      y+=lines.length*lineHeight+(spacing||3);
    }
    function section(value){
      ensureSpace(14);
      y+=2;
      doc.setFillColor(236,244,248);
      doc.roundedRect(margin,y-5,contentWidth,10,2,2,'F');
      doc.setFont('helvetica','bold');
      doc.setFontSize(12);
      doc.setTextColor(38,103,130);
      doc.text(safeText(value),margin+4,y+1.5);
      y+=10;
