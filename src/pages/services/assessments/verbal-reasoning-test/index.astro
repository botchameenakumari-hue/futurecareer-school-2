    }else if(interpretiveScore>=literalScore+15){
      readingBalance={title:'Interpretation is ahead of detail control',body:'You reason well from ideas, but exact wording and stated details may be leaking marks. Anchor every conclusion to the sentence, qualifier, or relationship that makes it valid.'};
    }else{
