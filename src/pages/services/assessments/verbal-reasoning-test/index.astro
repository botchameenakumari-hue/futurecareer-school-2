---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/verbal-reasoning-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/placement-aptitude-test/',
    title: 'Placement Aptitude Test',
    description: 'Use the wider placement test when you also want numerical, logical, data, and workplace-judgement scores.',
  },
  {
    href: '/services/assessments/numerical-reasoning-test/',
    title: 'Numerical Reasoning Test',
    description: 'Use the numerical test for a separate diagnostic of quantitative reasoning, data interpretation, and estimation.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'Who can take this verbal reasoning test?',
    a: 'School students, college students, graduates, job seekers, and working professionals can use it. Choose your current stage first so the result interpretation fits where you need to apply the skill.',
  },
  {
    q: 'What does the test measure?',
    a: 'It measures vocabulary in context, grammar and sentence precision, reading comprehension, evidence-based inference, verbal relationships, and communication judgement.',
  },
  {
    q: 'Is verbal reasoning the same as spoken English?',
    a: 'No. This test focuses on understanding written information and reasoning with language. It does not measure accent, pronunciation, conversation fluency, or overall intelligence.',
  },
  {
    q: 'Is the score an employer percentile?',
    a: 'No. It is a diagnostic based only on these 24 questions. It does not claim a national percentile, psychometric norm, or employer-specific cut-off.',
  },
  {
    q: 'Can I download the complete result?',
    a: 'Yes. The PDF includes your six domain scores, broader indicators, error patterns, practice allocation, audience-specific guidance, and explanations for all 24 questions.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Verbal Reasoning Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Verbal Reasoning Test',
    description: 'A free 24-question verbal reasoning test with six domain scores, audience-specific interpretation, error analysis, explanations, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Verbal Reasoning Test | Free Test with Detailed Results"
  description="Take a free 24-question verbal reasoning test for students, job seekers, and professionals. Get six skill scores, error analysis, explanations, and a PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="verbal-hero">
      <div class="word-field" aria-hidden="true">READ / INFER / QUESTION / CLARIFY / DECIDE</div>
      <div class="ink-glow ink-glow--gold" aria-hidden="true"></div>
      <div class="ink-glow ink-glow--blue" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Verbal Reasoning Test</span>
        </nav>
        <div class="eyebrow"><span></span> Free language and evidence diagnostic</div>
        <h1>Verbal Reasoning Test <span>with Practical Results</span></h1>
        <p class="hero-sub">Measure how accurately you understand written information, interpret evidence, recognise relationships, and communicate a clear decision. Your report adapts to the setting where you need the skill.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>24</strong><span>questions</span></div>
          <div><strong>6</strong><span>reasoning areas</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <div class="related-name-row" aria-label="Related test names">
          <span>verbal reasoning test</span><span>verbal aptitude test</span><span>verbal ability test</span><span>free verbal test</span>
        </div>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="coverage-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Six distinct reasoning signals</span><h2>See where understanding breaks down</h2><p>An overall score can hide whether the real issue is language precision, passage comprehension, inference, or communicating a conclusion.</p></div>
        <div class="coverage-grid">
          <article><b>01</b><h3>Context</h3><p>Understand words from the sentence around them, not from memorised definitions alone.</p></article>
          <article><b>02</b><h3>Precision</h3><p>Recognise grammar, parallel structure, clarity, and unambiguous expression.</p></article>
          <article><b>03</b><h3>Comprehension</h3><p>Identify the main point, relevant detail, comparison, and limitation in a passage.</p></article>
          <article><b>04</b><h3>Inference</h3><p>Separate what evidence supports from what merely sounds possible.</p></article>
          <article><b>05</b><h3>Relationships</h3><p>Recognise functional, causal, part-whole, and category relationships between ideas.</p></article>
          <article><b>06</b><h3>Communication</h3><p>Choose clear, relevant, appropriately toned messages for practical situations.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Choose your context first</span><h2>Get interpretation built for your stage</h2><p>Everyone answers the same reasoning core. The practical uses, cautions, and improvement priorities change with your current situation.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Build comprehension and precise expression across subjects.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Strengthen reports, research reading, presentations, and placement readiness.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Diagnose verbal gaps before aptitude rounds, interviews, and written tasks.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Improve briefs, stakeholder communication, and evidence-based decisions.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>Read for accuracy rather than speed. There is no negative marking.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><div><span id="domain-label" class="domain-label">Vocabulary in context</span><span id="question-counter" class="question-counter">Question 1 of 24</span></div><span id="progress-label" class="progress-label">4% complete</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Question 1 of 24"><span id="progress-fill"></span></div>
          <div class="difficulty-line"><span id="difficulty-label">Foundation</span><span>Choose only what the wording supports</span></div>
          <div class="question-panel"><p id="question-text" class="question-text" tabindex="-1">Loading question...</p><div id="option-list" class="option-list" role="group" aria-label="Answer choices"></div></div>
          <div class="quiz-nav"><button id="back-button" class="quiz-button quiz-button--secondary" type="button" disabled>Back</button><button id="next-button" class="quiz-button quiz-button--primary" type="button" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Verbal reasoning results"></div>
        <p class="assessment-note">This is a practice diagnostic, not a standardized percentile, language-proficiency certificate, employer cut-off, IQ test, or complete measure of career fit.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">A better way to improve</span><h2>Diagnose the reasoning error, not only the wrong answer</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Language precision</h3><p>Check whether context, grammar, sentence structure, or ambiguity caused the miss.</p></article>
          <article><strong>2</strong><h3>Evidence discipline</h3><p>Spot ignored details, weakened qualifiers, unsupported assumptions, and overreach.</p></article>
          <article><strong>3</strong><h3>Relationship logic</h3><p>Identify whether two ideas have the same functional relationship before choosing an analogy.</p></article>
          <article><strong>4</strong><h3>Communication judgement</h3><p>Balance clarity, relevance, tone, and the action the reader actually needs.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use the score</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when the decision includes placement readiness, quantitative aptitude, career direction, or professional growth beyond verbal reasoning." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Verbal Reasoning Report"
    fileName="future-career-school-verbal-reasoning-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="VERBAL REASONING EVIDENCE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .verbal-hero { position: relative; overflow: hidden; padding: 132px 0 78px; }
  .word-field { position: absolute; top: 115px; left: -4%; color: rgba(255,255,255,.025); font: 900 clamp(3rem,9vw,8rem)/.9 Georgia,serif; letter-spacing: -.04em; white-space: nowrap; transform: rotate(-4deg); }
  .ink-glow { position: absolute; width: 440px; height: 440px; border-radius: 50%; filter: blur(120px); opacity: .16; pointer-events: none; }
  .ink-glow--gold { top: -50px; left: -180px; background: #e5b84a; }
  .ink-glow--blue { right: -180px; bottom: -80px; background: #4ca6d8; }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-bottom: 1.6rem; color: rgba(255,255,255,.46); font-size: 13px; }
  .eyebrow,.section-kicker { color: #69c8e8; font-size: 12px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .eyebrow { display: inline-flex; align-items: center; gap: .55rem; padding: .5rem .85rem; border: 1px solid rgba(105,200,232,.25); border-radius: 999px; background: rgba(105,200,232,.07); }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #69c8e8; box-shadow: 0 0 0 5px rgba(105,200,232,.1); }
  .verbal-hero h1 { max-width: 940px; margin: 1.2rem 0 .9rem; color: #fff; font-size: clamp(2.35rem,6vw,4.75rem); line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .verbal-hero h1 span { display: block; color: var(--gold); }
  .hero-sub { max-width: 770px; margin: 0; color: rgba(255,255,255,.68); font-size: clamp(15px,1.8vw,18px); line-height: 1.72; }
  .hero-stats { display: grid; grid-template-columns: repeat(3,1fr); width: min(600px,100%); margin: 2rem 0; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(255,255,255,.035); overflow: hidden; }
  .hero-stats div { display: grid; gap: .15rem; padding: 1rem; }
  .hero-stats div+div { border-left: 1px solid rgba(255,255,255,.09); }
  .hero-stats strong { color: #fff; font-size: 1.2rem; }
  .hero-stats span { color: rgba(255,255,255,.48); font-size: 12px; }
  .hero-actions,.related-name-row,.result-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .related-name-row { margin-top: 1.5rem; gap: .45rem; }
  .related-name-row span { padding: .35rem .65rem; border-radius: 999px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.42); font-size: 11px; }
  .coverage-section,.assessment-section,.faq-section { padding: 82px 0; }
  .coverage-section,.faq-section { background: #f5f2e9; color: #17202c; }
  .section-heading { max-width: 760px; margin: 0 auto 2.2rem; text-align: center; }
  .section-heading h2,.method-layout h2 { margin: .55rem 0 .7rem; color: inherit; font-size: clamp(2rem,4vw,3.15rem); line-height: 1.05; letter-spacing: -.04em; text-wrap: balance; }
  .section-heading p { color: #68717d; line-height: 1.7; }
  .coverage-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .coverage-grid article { min-height: 190px; padding: 1.5rem; border: 1px solid #d9d5cb; border-radius: 18px; background: rgba(255,255,255,.7); box-shadow: 0 12px 30px rgba(23,32,44,.05); }
  .coverage-grid b { color: #b18425; font-size: 12px; letter-spacing: .12em; }
  .coverage-grid h3 { margin: 1.5rem 0 .5rem; color: #17202c; }
  .coverage-grid p,.method-grid p { margin: 0; color: #68717d; line-height: 1.6; }
  .assessment-section { background: #0b1320; }
  .assessment-section .section-heading { color: #fff; }
  .assessment-section .section-heading p { color: rgba(255,255,255,.58); }
  .start-shell,.quiz-shell,.result-shell { max-width: 1040px; margin: 0 auto; padding: clamp(1.15rem,3vw,2rem); border: 1px solid rgba(255,255,255,.1); border-radius: 28px; background: linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025)); box-shadow: 0 28px 70px rgba(0,0,0,.25); }
  .audience-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: .8rem; margin-bottom: 1rem; }
  .audience-option,.answer-option { width: 100%; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.035); color: #fff; text-align: left; cursor: pointer; transition: border-color .18s, background .18s, box-shadow .18s; }
  .audience-option { display: grid; gap: .35rem; padding: 1rem; border-radius: 16px; }
  .audience-option span { color: rgba(255,255,255,.55); font-size: 13px; line-height: 1.45; }
  .audience-option:hover,.answer-option:hover,.audience-option.is-selected,.answer-option.is-selected { border-color: rgba(229,184,74,.7); background: rgba(229,184,74,.1); box-shadow: 0 12px 26px rgba(229,184,74,.14); }
  .start-shell>p,.assessment-note { margin: .8rem 0 0; color: rgba(255,255,255,.43); text-align: center; font-size: 12px; }
  .quiz-button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: .75rem 1.15rem; border: 1px solid transparent; border-radius: 12px; font-weight: 800; cursor: pointer; }
  .quiz-button--primary { background: var(--gold); color: #111827; }
  .quiz-button--secondary { border-color: rgba(255,255,255,.15); background: transparent; color: #fff; }
  .quiz-button:disabled { cursor: not-allowed; opacity: .38; }
  #start-button { width: 100%; }
  .quiz-topline,.difficulty-line,.quiz-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .quiz-topline>div { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; }
  .domain-label { color: #69c8e8; font-size: 13px; font-weight: 800; }
  .question-counter,.progress-label,.difficulty-line { color: rgba(255,255,255,.48); font-size: 12px; }
  .progress-track { height: 5px; margin: .8rem 0; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
  .progress-track span { display: block; width: 4%; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#69c8e8,var(--gold)); transition: width .25s; }
  .difficulty-line span:first-child { color: var(--gold); font-weight: 800; text-transform: capitalize; }
  .question-panel { min-height: 390px; padding: clamp(1rem,3vw,2rem) 0 1rem; }
  .question-text { max-width: 900px; margin: 0 0 1.4rem; color: #fff; font-size: clamp(1.15rem,2.5vw,1.65rem); font-weight: 750; line-height: 1.5; white-space: pre-line; }
  .option-list { display: grid; grid-template-columns: repeat(2,1fr); gap: .75rem; }
  .answer-option { display: grid; grid-template-columns: 34px 1fr; align-items: center; gap: .7rem; min-height: 68px; padding: .8rem; border-radius: 14px; }
  .answer-letter { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 9px; background: rgba(255,255,255,.08); color: var(--gold); font-weight: 850; }
  .answer-copy { line-height: 1.45; }
  .quiz-nav { padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.08); }
  .result-shell { color: rgba(255,255,255,.7); }
  .result-head { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 1.5rem; }
  .score-ring { display: grid; width: 140px; height: 140px; place-content: center; border-radius: 50%; background: radial-gradient(circle at center,#101a29 62%,transparent 63%),conic-gradient(var(--gold) var(--score),rgba(255,255,255,.08) 0); text-align: center; }
  .score-ring strong { color: #fff; font-size: 2rem; }
  .score-ring span,.result-kicker { color: #69c8e8; font-size: 12px; }
  .result-head h3 { margin: .35rem 0; color: #fff; font-size: clamp(1.7rem,4vw,2.7rem); line-height: 1.08; }
  .result-head p,.result-section p { line-height: 1.65; }
  .result-metrics,.diagnostic-grid,.insight-grid,.plan-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: .75rem; }
  .result-metrics { grid-template-columns: repeat(4,1fr); margin: 1.5rem 0; }
  .result-metric,.diagnostic-card,.insight-grid article,.plan-grid article,.error-card { padding: 1rem; border: 1px solid rgba(255,255,255,.09); border-radius: 14px; background: rgba(255,255,255,.035); }
  .result-metric { display: grid; gap: .35rem; }
  .result-metric strong,.diagnostic-score { color: #fff; }
  .result-metric span { color: rgba(255,255,255,.43); font-size: 11px; }
  .domain-results { display: grid; gap: .65rem; }
  .domain-row { display: grid; grid-template-columns: minmax(190px,1fr) minmax(130px,2fr) 40px; align-items: center; gap: .8rem; font-size: 13px; }
  .domain-bar { height: 7px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
  .domain-bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#69c8e8,var(--gold)); }
  .domain-score { color: #fff; font-weight: 800; }
  .result-section { margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,.09); }
  .result-section h4 { margin: 0 0 .55rem; color: #fff; font-size: 1.25rem; }
  .result-section h5 { margin: 0 0 .45rem; color: #fff; }
  .diagnostic-grid,.insight-grid,.plan-grid { margin-top: .9rem; }
  .diagnostic-score { display: inline-block; margin-bottom: .7rem; color: var(--gold); font-size: 1.4rem; font-weight: 850; }
  .pace-table,.practice-allocation { display: grid; gap: .55rem; margin-top: .8rem; }
  .pace-row,.allocation-item { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: .8rem; padding: .75rem; border-radius: 10px; background: rgba(255,255,255,.035); font-size: 13px; }
  .allocation-item { grid-template-columns: 1fr auto; }
  .signal-list { margin: .6rem 0 0; padding-left: 1.1rem; }
  .signal-list li+li { margin-top: .45rem; }
  .review-section details { margin-top: .8rem; }
  .review-section summary { color: var(--gold); cursor: pointer; font-weight: 800; }
  .review-item { margin-top: .75rem; padding: 1rem; border-left: 3px solid #dc7b64; border-radius: 10px; background: rgba(255,255,255,.035); }
  .review-item.is-correct { border-left-color: #45c5a8; }
  .review-item p { margin: .35rem 0 0; }
  .review-correct { color: #75dbc4; }
  .result-actions { margin-top: 1.4rem; }
  .method-section { padding: 82px 0; background: #fff; color: #17202c; }
  .method-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 2rem; align-items: start; }
  .method-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: .8rem; }
  .method-grid article { padding: 1.2rem; border: 1px solid #e2ded4; border-radius: 16px; background: #faf8f3; }
  .method-grid strong { color: #b18425; font-size: 12px; }
  .method-grid h3 { margin: .8rem 0 .45rem; }
  .faq-list { max-width: 900px; margin: 0 auto; }
  .faq-list details { border-bottom: 1px solid #d9d5cb; }
  .faq-list summary { padding: 1rem 0; color: #17202c; font-weight: 800; cursor: pointer; }
  .faq-list p { margin: 0 0 1rem; color: #68717d; line-height: 1.7; }
  [hidden] { display: none !important; }
  @media (max-width: 820px) { .coverage-grid { grid-template-columns: repeat(2,1fr); } .method-layout { grid-template-columns: 1fr; } .result-metrics { grid-template-columns: repeat(2,1fr); } }
