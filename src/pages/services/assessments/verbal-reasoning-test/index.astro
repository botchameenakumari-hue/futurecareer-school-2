    var y=20;
    function addPage(){doc.addPage();y=20;}
    function ensureSpace(height){if(y+height>pageHeight-18)addPage();}
    function safeText(value){return String(value).replace(/[\u2013\u2014]/g,'-').replace(/[\u2018\u2019]/g,"'").replace(/[\u201c\u201d]/g,'"');}
    function addText(value,size,color,style,spacing){
      doc.setFont('helvetica',style||'normal');
