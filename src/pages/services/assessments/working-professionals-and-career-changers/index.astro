      impact: 'You want to build something big AND earn highly, but lack leadership drive to manage people or scale a team.',
      solution: 'Partner with a strong COO/Operations person. Or position yourself as a technical founder/CTO with a business co-founder.',
      skills_to_build: ['Delegation', 'Team Dynamics', 'Fundraising', 'Executive Communication']
    });
  }

  if (scores.leadership >= 45 && scores.startup >= 45 && scores.remote >= 45) {
    conflicts.push({
      conflict: 'Too Many Directions',
      impact: 'You want to lead teams, build ventures, AND maintain flexibility. These pull in different directions simultaneously.',
      solution: 'You need to rank: what\'s the primary goal for the next 2–3 years? (Lead in company, build startup, or maintain flexibility). Then commit.',
