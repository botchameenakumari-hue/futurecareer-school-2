function generateRadarChartSVG(percentiles) {
  var width = 320;
  var height = 320;
  var center = width / 2;
  var maxRadius = 120;
  var dimensions = ['pivot', 'income', 'leadership', 'remote', 'ai', 'startup'];
  var labels = ['Pivot', 'Income', 'Leadership', 'Remote', 'AI', 'Startup'];
  var colors = ['#14b8a6', '#f59e0b', '#8b5cf6', '#14b8a6', '#6366f1', '#ef4444'];

  var svg = '<svg width="' + width + '" height="' + height + '" viewBox="0 0 ' + width + ' ' + height + '" style="margin: 0 auto">';

  // Draw grid circles
  for (var i = 1; i <= 5; i++) {
    var radius = (maxRadius / 5) * i;
    svg += '<circle cx="' + center + '" cy="' + center + '" r="' + radius + '" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="1"/>';
  }

  // Draw axes and labels
  var angleSlice = (Math.PI * 2) / dimensions.length;
  for (var i = 0; i < dimensions.length; i++) {
    var angle = angleSlice * i - Math.PI / 2;
    var x1 = center;
    var y1 = center;
    var x2 = center + maxRadius * Math.cos(angle);
    var y2 = center + maxRadius * Math.sin(angle);
    svg += '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="rgba(255,255,255,.1)" stroke-width="1"/>';

    // Labels
    var labelDist = maxRadius + 25;
    var labelX = center + labelDist * Math.cos(angle);
    var labelY = center + labelDist * Math.sin(angle);
    svg += '<text x="' + labelX + '" y="' + labelY + '" text-anchor="middle" dy="0.3em" font-size="11" font-weight="600" fill="rgba(255,255,255,.7)">' + labels[i] + '</text>';
  }

  // Draw data polygon
  var points = '';
  for (var i = 0; i < dimensions.length; i++) {
    var angle = angleSlice * i - Math.PI / 2;
    var pct = percentiles[dimensions[i]];
    var radius = (maxRadius / 100) * pct;
    var x = center + radius * Math.cos(angle);
    var y = center + radius * Math.sin(angle);
    points += x + ',' + y + ' ';
  }
  svg += '<polygon points="' + points + '" fill="rgba(229,184,74,.15)" stroke="#e5b84a" stroke-width="2" opacity="0.8"/>';

  // Draw data points
  for (var i = 0; i < dimensions.length; i++) {
    var angle = angleSlice * i - Math.PI / 2;
    var pct = percentiles[dimensions[i]];
    var radius = (maxRadius / 100) * pct;
    var x = center + radius * Math.cos(angle);
    var y = center + radius * Math.sin(angle);
    svg += '<circle cx="' + x + '" cy="' + y + '" r="4" fill="' + colors[i] + '" stroke="#0a0f1e" stroke-width="1.5"/>';
  }

  svg += '</svg>';
  return svg;
}

function getDimensionInteraction(scores, primary) {
  var interaction = '';
  var strength = '';
  var caution = '';

  if (primary === 'pivot' && scores.startup > scores.income) {
    interaction = 'Pivot to Growth';
    strength = 'You\'re willing to trade security for opportunity and scale. Your entrepreneurial energy + stability mindset is rare and valuable.';
    caution = 'Pivots are disorienting. Surround yourself with others who\'ve made similar moves. The first 18 months are the hardest.';
  } else if (primary === 'pivot' && scores.income > scores.startup) {
    interaction = 'Strategic Shift';
    strength = 'You\'re optimizing for both stability and new direction. This is the most sustainable path for most professionals.';
    caution = 'Slow pivots take longer but reduce risk. Be patient and build your foundation before accelerating.';
  } else if (primary === 'income' && scores.leadership > scores.pivot) {
    interaction = 'Climb the Ladder';
    strength = 'You\'re driven by growth within your existing domain. Promotion, leadership, expertise — this is your path.';
    caution = 'Climbing requires visibility and relationships. Don\'t let technical excellence alone carry you — build political capital.';
  } else if (primary === 'leadership' && scores.startup > 50) {
    interaction = 'Builder & Leader';
    strength = 'You have both the vision to build AND the discipline to lead teams. Rare combination. Seek roles where you can do both.';
    caution = 'Building requires saying no to many opportunities. Stay focused. Leadership without building is hollow.';
  } else if (primary === 'startup' && scores.income > scores.leadership) {
    interaction = 'Solo Operator';
    strength = 'You want freedom and income without managing people. Freelancing, consulting, solo products — these suit you.';
    caution = 'Solo work can isolate you. Build a mastermind group or advisory board. You need outside perspective.';
  } else if (primary === 'remote' || primary === 'ai') {
    interaction = 'Future-Oriented';
    strength = 'You\'re thinking about the future (remote work, AI adoption) while most are stuck in present-day concerns. This is strategic.';
    caution = 'The future takes longer to arrive than you expect. Build for today while preparing for tomorrow.';
  } else {
    interaction = 'Multidimensional Professional';
    strength = 'Your profile shows multiple, sometimes competing drives. This is complex but navigable.';
    caution = 'With multiple priorities, you must be intentional about trade-offs. Don\'t chase everything equally — rank them.';
  }

  return { interaction: interaction, strength: strength, caution: caution };
}

