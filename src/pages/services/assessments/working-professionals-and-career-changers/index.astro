function generateAIRiskAssessment(aiScore, leadershipScore, remote) {
  var assessment = {};

  // Normalize AI score to 0-100 percentile
  var aiPercentile = calculatePercentile(aiScore, -30, 42);

  assessment.percentile = aiPercentile;

  if (aiPercentile >= 70) {
    assessment.level = 'Low Risk';
    assessment.icon = '✓';
    assessment.color = '#10b981';
    assessment.summary = 'You\'re well-positioned for the AI era. Your judgment-based skills are hard to automate.';
  } else if (aiPercentile >= 50) {
    assessment.level = 'Moderate Risk';
    assessment.icon = '◐';
    assessment.color = '#f59e0b';
    assessment.summary = 'Moderate automation exposure. Needs strategic skill development to stay ahead.';
  } else {
    assessment.level = 'High Risk';
    assessment.icon = '⚠';
    assessment.color = '#ef4444';
    assessment.summary = 'Your role has significant automation vulnerability. Urgent action needed.';
  }

  // Safe vs at-risk work breakdown
  var routineWork = Math.max(0, Math.min(100, 70 - (leadershipScore * 3) - (aiPercentile / 2)));
  var judgmentWork = 100 - routineWork;

  assessment.workBreakdown = {
    routine: routineWork,
    judgment: judgmentWork
  };

  // Mitigation strategies based on score
  assessment.safeSkills = [
    'Decision-making authority',
    'Strategic thinking',
    'Complex problem-solving',
    'Stakeholder management',
    'Judgment-based work'
  ];

  assessment.atRiskWork = [
    'Routine analysis',
    'Standard reporting',
    'Template-based documentation',
    'Repetitive processes',
    'Data entry and aggregation'
  ];

  assessment.actions = [];
  if (aiPercentile < 50) {
    assessment.actions = [
      '🔴 Urgent: Move toward high-judgment roles (strategy, leadership, decisions)',
      '→ Build leadership skills to increase decision-making authority',
      '→ Deepen expertise in specialized area (harder to commoditize)',
      '→ Learn to use AI tools (don\'t compete with them, use them)',
      '→ Consider pivoting to roles where AI creates opportunity, not replacement'
    ];
  } else if (aiPercentile < 70) {
    assessment.actions = [
      '→ Build judgment-based skills (strategy, leadership, complex problems)',
      '→ Learn to use AI tools in your domain',
      '→ Move away from routine work toward decision-making',
      '→ Develop AI literacy in your field',
      '→ Position yourself as "AI-enabled professional" using tools effectively'
    ];
  } else {
    assessment.actions = [
      '✓ Your judgment-based skills are hard to automate',
      '→ Lean into decision-making and strategic work',
      '→ Upskill in AI tools to stay ahead of competition',
      '→ Build your expertise deeper (compound your advantage)',
      '→ Establish yourself as irreplaceable decision-maker'
    ];
  }

  return assessment;
}

function generateReadinessScores(scores, percentiles) {
  var readiness = {};

  // Readiness for Career Transition
  var transitionReady = (percentiles.pivot * 0.4) + (percentiles.income * 0.2) + ((100 - percentiles.ai) * 0.2) + (percentiles.remote * 0.1) + (percentiles.leadership * 0.1);
  readiness.transition = {
    score: Math.round(transitionReady),
    label: transitionReady >= 70 ? 'Go' : transitionReady >= 50 ? 'Possible' : 'Prepare',
    missing: transitionReady < 70 ? (percentiles.pivot < 60 ? 'Higher pivot readiness' : percentiles.income < 60 ? 'Financial runway' : 'Skill transferability') : null
  };

  // Readiness for Entrepreneurship
  var startupReady = (percentiles.startup * 0.4) + (percentiles.remote * 0.2) + (percentiles.income * 0.2) + (percentiles.pivot * 0.2);
  readiness.startup = {
    score: Math.round(startupReady),
    label: startupReady >= 70 ? 'Strong Fit' : startupReady >= 50 ? 'Viable' : 'Test First',
    missing: startupReady < 70 ? (percentiles.startup < 60 ? 'Entrepreneurial aptitude' : 'Risk tolerance or runway') : null
  };

  // Readiness for Leadership Acceleration
  var leadershipReady = (percentiles.leadership * 0.4) + (percentiles.income * 0.2) + (percentiles.pivot * 0.2) + (percentiles.remote * 0.2);
  readiness.leadership = {
    score: Math.round(leadershipReady),
    label: leadershipReady >= 70 ? 'Ready' : leadershipReady >= 50 ? 'Developable' : 'Build First',
    missing: leadershipReady < 70 ? (percentiles.leadership < 60 ? 'Leadership experience' : 'Strategic thinking') : null
  };

  return readiness;
}

function getAnswerValue(answer) {
  // Handle both single-select (number) and multi-select (array) answers
  if (Array.isArray(answer)) {
    return answer.length > 0 ? answer[0] : null;
  }
  return answer;
}

function analyzeResponsePatterns(answers) {
  var patterns = {};

  // Check for contradictions
  patterns.contradictions = [];
  var ans6 = getAnswerValue(answers[6]);
  var ans3 = getAnswerValue(answers[3]);
  var ans19 = getAnswerValue(answers[19]);
  var ans1 = getAnswerValue(answers[1]);
  var ans0 = getAnswerValue(answers[0]);
  var ans27 = getAnswerValue(answers[27]);

  if (ans6 !== null && ans3 !== null && ans6 < 2 && ans3 >= 4) { // Low autonomy preference but high unstructured work comfort
    patterns.contradictions.push('Says prefers structure but comfortable in ambiguity');
  }
  if (ans19 !== null && ans1 !== null && ans19 >= 4 && ans1 < 2) { // High risk tolerance but no financial runway
    patterns.contradictions.push('High risk appetite but limited financial safety net');
  }
  if (ans0 !== null && ans27 !== null && ans0 < 2 && ans27 >= 4) { // Very satisfied but high AI concern
    patterns.contradictions.push('Content in role but concerned about automation');
  }

  // Calculate response distribution (concentrated vs spread)
  // Extract numeric values for distribution calculation
  var allAnswerValues = answers.map(function(a) { return getAnswerValue(a); }).filter(function(a) { return a !== null; });

  if (allAnswerValues.length > 0) {
    var avgAnswer = allAnswerValues.reduce(function(a,b) { return a+b; }, 0) / allAnswerValues.length;
    var variance = allAnswerValues.reduce(function(sum, a) { return sum + Math.pow(a - avgAnswer, 2); }, 0) / allAnswerValues.length;
    var stdDev = Math.sqrt(variance);
    var distribution = 100 - (stdDev * 15); // Convert to confidence score

    patterns.conviction = distribution > 70 ? 'Strong conviction' : distribution > 50 ? 'Clear direction' : 'Exploring options';
    patterns.convictionScore = Math.max(0, Math.min(100, Math.round(distribution)));
  } else {
    patterns.conviction = 'Exploring options';
    patterns.convictionScore = 0;
  }

  // Response bias detection
  var optionCounts = [0, 0, 0, 0, 0, 0];
  allAnswerValues.forEach(function(a) { if (a !== null && typeof a === 'number' && a >= 0 && a < optionCounts.length) { optionCounts[a]++; }});
  var bias = Math.max.apply(null, optionCounts);
  if (bias > 0 && bias > answers.length * 0.4) {
    var biasOption = optionCounts.indexOf(bias);
    patterns.bias = 'Tends to choose option ' + String.fromCharCode(65 + biasOption);
  }

  return patterns;
}

function inferCareerStage(scores, answers) {
  var stage = {};

  // Q8: Leadership experience (index 7)
  var leadershipExp = getAnswerValue(answers[7]);
  if (leadershipExp === null) leadershipExp = 0;
  var yearsExperience = leadershipExp === 0 ? 0 : leadershipExp <= 2 ? 3 : leadershipExp <= 3 ? 5 : leadershipExp <= 4 ? 8 : leadershipExp === 5 ? 12 : 20;

  // Q1: Role satisfaction (index 0) - inverse of pivot score correlates with tenure
  var satisfaction = getAnswerValue(answers[0]);
  if (satisfaction === null) satisfaction = 3;
  var tenure = (6 - satisfaction) * 2; // Higher frustration might mean longer tenure

  // Infer stage based on patterns
  if (leadershipExp <= 1 && yearsExperience < 5) {
    stage.name = 'Early Career (0-5 years)';
    stage.description = 'You\'re building foundational expertise and learning organizational dynamics.';
    stage.focus = ['Build deep expertise', 'Develop strong relationships', 'Master your current domain'];
    stage.cautions = ['Too early to pivot for most', 'Focus on skills > salary', 'Stay at least 2-3 years'];
  } else if (leadershipExp <= 2 || yearsExperience < 8) {
    stage.name = 'Mid Career (5-10 years)';
    stage.description = 'You\'re experienced enough to be valuable but early enough to pivot. This is your opportunity window.';
    stage.focus = ['Transition if changing domains', 'Build leadership skills', 'Specialize or generalize intentionally'];
    stage.cautions = ['Best window for pivots closing', 'Leadership commitment expected soon', 'Income expectations rising'];
  } else if (leadershipExp <= 4 || yearsExperience < 15) {
    stage.name = 'Senior Career (10-15 years)';
    stage.description = 'You\'re an expert with significant experience. Your choices now define your final 15-20 year trajectory.';
    stage.focus = ['Strategic positioning', 'Leadership or deep expertise', 'Narrow your focus'];
    stage.cautions = ['Pivots are risky and visible', 'Expect senior-level salary requirements', 'Build your legacy'];
  } else {
    stage.name = 'Executive (15+ years)';
    stage.description = 'You\'re in the final phase of your career. Decisions now are about impact, legacy, and fulfillment.';
    stage.focus = ['Leadership at scale', 'Mentoring next generation', 'Define your impact'];
    stage.cautions = ['Steep salary expectations', 'Limited pivots due to market positioning', 'Consider board roles, advisory'];
  }

  stage.yearsEstimate = yearsExperience;

  return stage;
}

function classifyMotivationType(scores, answers) {
  var motivation = {};

  // Calculate motivation drivers
  var moneyScore = scores.income;
  var ans2 = getAnswerValue(answers[2]);
  var ans11 = getAnswerValue(answers[11]);
  var ans6 = getAnswerValue(answers[6]);
  var ans3 = getAnswerValue(answers[3]);
  var ans8 = getAnswerValue(answers[8]);
  var ans1 = getAnswerValue(answers[1]);
  var ans5 = getAnswerValue(answers[5]);
  var ans4 = getAnswerValue(answers[4]);

  var impactScore = (ans2 === 3 ? 1 : 0) * 3 + (ans11 ? 2 : 0) * 2; // Meaningful work, autonomy preference
  var autonomyScore = scores.remote + (ans6 !== null && ans6 >= 4 ? 3 : 0) + (ans3 !== null && ans3 >= 4 ? 2 : 0);
  var statusScore = scores.leadership + (ans8 !== null && ans8 >= 4 ? 2 : 0);
  var securityScore = (ans1 !== null && ans1 <= 1) ? 6 : (ans1 !== null && ans1 <= 2) ? 4 : 0; // Financial runway inverse
  var growthScore = (ans5 !== null && ans5 >= 4 ? 3 : 0) + (ans4 !== null && ans4 >= 4 ? 2 : 0); // Learning comfort

  var scores_array = [
    {name: 'Money-Driven', score: moneyScore, color: '#f59e0b', desc: 'Primary focus is salary growth and financial optimization'},
    {name: 'Impact-Driven', score: impactScore, color: '#10b981', desc: 'Work that matters and meaningful contribution drive decisions'},
    {name: 'Autonomy-Driven', score: autonomyScore, color: '#8b5cf6', desc: 'Independence, freedom, and self-direction are paramount'},
    {name: 'Status-Driven', score: statusScore, color: '#3b82f6', desc: 'Leadership, recognition, and advancement matter most'},
    {name: 'Security-Driven', score: securityScore, color: '#6b7280', desc: 'Stability, predictability, and risk avoidance are key'},
    {name: 'Growth-Driven', score: growthScore, color: '#ec4899', desc: 'Learning, skill development, and evolution drive your choices'}
  ];

  scores_array.sort(function(a, b) { return b.score - a.score; });

  motivation.primary = scores_array[0];
  motivation.secondary = scores_array[1];
  motivation.tertiary = scores_array[2];
  motivation.all = scores_array;

  return motivation;
}

