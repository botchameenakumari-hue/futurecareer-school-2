---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/working-professionals-and-career-changers/';
const plansConfig = getAssessmentPlansConfig('professional');
const guidanceCardHref = plansConfig.jumpHref;
const guidanceResultsHref = plansConfig.jumpHref;
const guidanceResultsLabel = plansConfig.jumpLabel;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Career Assessment for Working Professionals', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Career Assessment for Working Professionals and Career Changers',
    description: 'A free 32-question psychometric career assessment for working professionals and career changers. Covers career pivot feasibility, income leverage, leadership potential, remote work readiness, AI career risk, and entrepreneurial aptitude. Instant results. No sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
];
---

<BaseLayout
  title="Free Career Assessment for Working Professionals and Career Changers | Future Career School"
  description="Free 32-question psychometric career assessment for professionals with 5+ years of experience. Covers career pivot feasibility, income leverage, leadership potential, remote work readiness, AI automation risk, and entrepreneurial aptitude. Instant results. No sign-up."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Working Professionals</span>
      </nav>
      <div class="pill"><span class="dot"></span>Free &nbsp;&middot;&nbsp; 32 Questions &nbsp;&middot;&nbsp; 15–20 Minutes &nbsp;&middot;&nbsp; Instant Results &nbsp;&middot;&nbsp; No Sign-Up</div>
      <h1>Career Growth Strategy for <span class="gold-text">Working Professionals &amp; Career Changers</span></h1>
      <p class="hero-sub">Assess your career pivot feasibility, income leverage potential, leadership readiness, and entrepreneurial fit. Designed for professionals with 5+ years of experience — when experience becomes your competitive advantage.</p>
      <div class="meta-chips">
        <span class="meta-chip">📊 32 questions</span>
        <span class="meta-chip">⏱ ~20 minutes</span>
        <span class="meta-chip">✨ Instant results</span>
        <span class="meta-chip">✓ 100% free</span>
        <span class="meta-chip">🎯 6 dimensions</span>
      </div>
      <div class="hero-actions">
        <a href="#assessment" class="btn-gold pulse hero-cta">Start Free Assessment <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></a>
        <a href={plansConfig.jumpHref} class="btn-outline hero-cta">{plansConfig.jumpLabel}</a>
      </div>
    </div>
  </section>

  <div class="assessment-first-flow">
  <!-- WHAT THIS TESTS -->
  <section id="what-this-tests">
    <div class="container">
      <div class="section-pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;What This Assessment Covers</div>
      <h2 class="section-title">Six Dimensions of Professional Growth</h2>
      <p class="section-sub">32 questions assess your readiness across career transitions, income optimization, leadership capability, remote-work fit, AI-era career safety, and entrepreneurial potential. All scored independently so you see your profile across every dimension.</p>
      <div class="signals-grid">
        <div class="signal-card signal-pivot">
          <div class="signal-icon-wrap"><span class="signal-icon">🔄</span></div>
          <div class="signal-tag">Career Transition</div>
          <h3>Pivot Feasibility</h3>
          <p>Assess how realistic a career change is for you — skill transferability, risk tolerance, financial runway, and the transition timeline you're willing to accept.</p>
        </div>
        <div class="signal-card signal-income">
          <div class="signal-icon-wrap"><span class="signal-icon">💰</span></div>
          <div class="signal-tag">Income Strategy</div>
          <h3>Income Leverage</h3>
          <p>Identify the highest-value skills and roles for your profile — what actually moves the needle on salary, and which roles offer the best leverage in your domain.</p>
        </div>
        <div class="signal-card signal-leadership">
          <div class="signal-icon-wrap"><span class="signal-icon">👥</span></div>
          <div class="signal-tag">Leadership Profile</div>
          <h3>Leadership Potential</h3>
          <p>Evaluate your readiness for management — people leadership style, strategic thinking capability, team dynamics comfort, and whether management is actually right for you.</p>
        </div>
        <div class="signal-card signal-remote">
          <div class="signal-icon-wrap"><span class="signal-icon">🌐</span></div>
          <div class="signal-tag">Work Mode</div>
          <h3>Remote Work Readiness</h3>
          <p>Assess how well-suited you are for remote-first or hybrid roles — autonomy, communication style, timezone flexibility, and whether you thrive without office structure.</p>
        </div>
        <div class="signal-card signal-ai">
          <div class="signal-icon-wrap"><span class="signal-icon">🤖</span></div>
          <div class="signal-tag">Future-Proofing</div>
          <h3>AI Career Readiness</h3>
          <p>Evaluate your automation risk — which aspects of your role are vulnerable, what judgment-based skills make you irreplaceable, and how to position yourself in the AI era.</p>
        </div>
        <div class="signal-card signal-startup">
          <div class="signal-icon-wrap"><span class="signal-icon">🚀</span></div>
          <div class="signal-tag">Entrepreneurship</div>
          <h3>Entrepreneurial Aptitude</h3>
          <p>Explore your founder or solopreneur fit — risk appetite, independence needs, operational thinking, and whether starting something is actually your stronger career move.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <div class="section-pill"><span style="color:var(--gold)">&#128203;</span>&nbsp;Career Assessment</div>
      <h2 class="section-title">Assess Your Professional Trajectory</h2>
      <p class="section-sub">These 32 questions map your experience, capabilities, and preferences across six dimensions. Be honest — there are no right answers, only answers that reflect your actual situation and what matters to you.</p>
      <!-- LANGUAGE SELECTOR -->
      <div class="lang-selector" id="lang-selector">
        <span class="lang-label">Language:</span>
        <button class="lang-btn lang-btn--active" data-lang="en">English</button>
        <button class="lang-btn" data-lang="hi">हिन्दी</button>
        <button class="lang-btn" data-lang="te">తెలుగు</button>
        <button class="lang-btn" data-lang="ta">தமிழ்</button>
        <button class="lang-btn" data-lang="mr">मराठी</button>
      </div>

      <div id="quiz-container" class="quiz-box" role="main" aria-label="Career Assessment Quiz">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 32</span>
            <span id="q-pct" class="q-pct">0% complete</span>
          </div>
          <div class="progress-bar-wrap" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Quiz progress">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>
        <div id="q-display" role="region" aria-live="polite" aria-atomic="true">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading...</p>
          <fieldset id="q-opts" class="q-opts"><legend class="sr-only">Select your answer</legend></fieldset>
        </div>
        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()" aria-label="Go to previous question"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg><span>Back</span></button>
          <span class="keyboard-hint" title="Press 1-6 to select, Enter to continue">⌨️ Keyboard shortcuts</span>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()" aria-label="Go to next question or see results"><span>Next Question</span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <div id="results-container" class="results-box" style="display:none" role="main" aria-live="polite" aria-label="Assessment Results"></div>
    </div>
  </section>
  </div>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <div class="section-pill"><span style="color:var(--gold)">&#10067;</span>&nbsp;Common Questions</div>
      <h2 class="section-title">FAQ</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">Who should take this assessment?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Working professionals with 5+ years of experience who are considering a career change, want to grow their salary, explore leadership, or test entrepreneurial fit. Whether you feel stuck, want a lateral move, or are actively planning a transition, this assessment helps you assess feasibility across six dimensions.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What does this assessment cover?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Six dimensions in 32 questions: (1) Career pivot feasibility — how realistic a change is, (2) Income leverage — what roles and skills move the needle, (3) Leadership potential — your management readiness, (4) Remote work fit — your suitability for distributed work, (5) AI automation risk — your role's vulnerability and your judgment-based strengths, and (6) Entrepreneurial aptitude — your founder or solo-work fit.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">I'm not sure if I want to change careers. Is this still relevant?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Yes — the assessment isn't just for career changers. It also maps income leverage, leadership potential, and entrepreneurial fit. Even if you stay in your field, these dimensions help you understand how to accelerate salary growth, whether to move into management, or if starting something on the side makes sense for you.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does this guarantee I can make the career change I want?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">No. This assesses feasibility and readiness, not guarantee. A high pivot score means you have many of the qualities and circumstances that make a change realistic — skills, financial runway, openness to risk. But execution and effort still matter. This is clarity, not destiny.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is this free?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Completely free. No sign-up, no payment, no login required. Take it whenever you want, retake it anytime. Results are instant.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- INTERNAL LINKS -->
  <section id="next-steps">
    <div class="container">
      <div class="section-pill"><span style="color:var(--teal)">&#8635;</span>&nbsp;After This Assessment</div>
      <h2 class="section-title">Where to Go Next</h2>
      <p class="section-sub">This assessment clarifies where you stand. These resources help you turn free clarity into a stronger professional decision.</p>
      <div class="links-grid">
        <a href={guidanceCardHref} class="link-card">
          <div class="lc-icon">💼</div>
          <div><div class="lc-title">See Working Professional Plans</div><div class="lc-desc">Move from free results to the pricing section when pivot quality, positioning, and compensation growth need a sharper plan.</div></div>
        </a>
        <a href="/services/assessments" class="link-card">
          <div class="lc-icon">📋</div>
          <div><div class="lc-title">All Assessments</div><div class="lc-desc">Explore other career assessment tools across different experience levels</div></div>
        </a>
        <a href="/career-resources" class="link-card">
          <div class="lc-icon">📚</div>
          <div><div class="lc-title">Career Resources</div><div class="lc-desc">Skill-building guides, career transition strategies, and entrepreneurship resources</div></div>
        </a>
        <a href="/career-skills-compass" class="link-card">
          <div class="lc-icon">🔍</div>
          <div><div class="lc-title">Career & Skills Compass</div><div class="lc-desc">Explore high-value skills for your next career phase based on your profile</div></div>
        </a>
      </div>
    </div>
  </section>

  <AssessmentGuidanceCta mode="professional" sectionId="guidance-bridge" />

  <GuidancePlansSection
    sectionId="plans"
    audience={plansConfig.audience}
    serviceLabel={plansConfig.serviceLabel}
    title={plansConfig.sectionTitle}
  />

  <AssessmentReportTools
    title="Working Professional Career Assessment Report"
    fileName="working-professional-career-assessment-report.pdf"
    reportKicker="PROFESSIONAL GROWTH AND PIVOT REPORT"
    guidanceLabel="Explore Working Professional Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/working-professional-career-guidance/"
  />
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ guidanceResultsHref, guidanceResultsLabel }}>
globalThis.guidanceResultsHref = guidanceResultsHref;
globalThis.guidanceResultsLabel = guidanceResultsLabel;
</script>
<script is:inline>
var scores = {pivot:0, income:0, leadership:0, remote:0, ai:0, startup:0};
var currentQ = 0;
var answers = new Array(32).fill(null);
var currentLang = 'en';

function getQText(idx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[idx].q;
  var tr = TRANSLATIONS[currentLang];
  return (tr[idx] && tr[idx].q) ? tr[idx].q : QUESTIONS[idx].q;
}
function getOptText(qIdx, optIdx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[qIdx].opts[optIdx].t;
  var tr = TRANSLATIONS[currentLang];
  return (tr[qIdx] && tr[qIdx].opts && tr[qIdx].opts[optIdx]) ? tr[qIdx].opts[optIdx] : QUESTIONS[qIdx].opts[optIdx].t;
}

var QUESTIONS = [
  {q:"How happy are you with your current job?", opts:[
    {t:"Very happy — I am in the right place but want to grow", s:{pivot:1,income:1}},
    {t:"Mostly happy — no problems but the top is getting close", s:{pivot:2,income:2}},
    {t:"Neutral — I do good work but do not care about the direction", s:{pivot:3}},
    {t:"Somewhat frustrated — work is fine but my career is not moving", s:{pivot:4,income:2}},
    {t:"Frustrated — I feel stuck and need a big change", s:{pivot:5,income:1}},
    {t:"Very frustrated — I am looking for a different field or job", s:{pivot:6}},
  ]},
  {q:"Can you afford to not work while changing jobs?", opts:[
    {t:"No — I need money right now", s:{pivot:0}},
    {t:"A little — 1–2 months without pay, but not more", s:{pivot:2}},
    {t:"Medium — 3–6 months of bills are covered", s:{pivot:4}},
    {t:"Good — 6–12 months of money saved", s:{pivot:6}},
    {t:"Very good — I have over a year of money saved", s:{pivot:7}},
    {t:"Not needed — my partner or others cover bills", s:{pivot:6}},
  ]},
  {q:"Why do you want to change your job?", opts:[
    {t:"More money in my field or similar jobs", s:{income:6,pivot:2}},
    {t:"Better life balance or flexibility (work from home, less hours)", s:{remote:4,pivot:2}},
    {t:"Leadership — I want to manage people", s:{leadership:6,pivot:2}},
    {t:"Meaningful work — the mission or field matters more", s:{pivot:4}},
    {t:"Build something — I want to start a business", s:{startup:6,pivot:3}},
    {t:"Escape — I just want to get out of this situation", s:{pivot:5}},
  ]},
  {q:"How well do you work with unclear rules or unclear expectations?", opts:[
    {t:"I struggle without clear plans and a boss to report to", s:{remote:1,leadership:1,startup:0}},
    {t:"I like structure but can change when needed", s:{remote:2,startup:1}},
    {t:"I am okay with it but I like some guidance", s:{remote:3,startup:2}},
    {t:"I work well even without clear rules and figure it out", s:{remote:5,startup:4,leadership:2}},
    {t:"I love unclear situations and I drive my own direction", s:{remote:6,startup:6,leadership:4}},
    {t:"I am good at both — structure and no structure", s:{remote:6,startup:6,leadership:6}},
  ]},
  {q:"Can you use your skills in a different field?", opts:[
    {t:"Very hard — my skills only work in my field", s:{pivot:1,income:3}},
    {t:"Hard — most of my skills are just for my field", s:{pivot:2,income:3}},
    {t:"Medium — some skills transfer but I need to learn more", s:{pivot:4,income:3}},
    {t:"Good — most of my skills work in other jobs", s:{pivot:5,income:5}},
    {t:"Very good — my skills work in many fields", s:{pivot:6,income:6}},
    {t:"Excellent — I have changed fields before and can do it again", s:{pivot:7,income:6}},
  ]},
  {q:"Can you learn new tools and software quickly?", opts:[
    {t:"No — I stick with what I know", s:{pivot:1,ai:1,income:2}},
    {t:"Not really — it takes me longer to learn", s:{pivot:2,ai:2,income:2}},
    {t:"Neutral — I learn when I have to", s:{pivot:3,ai:3}},
    {t:"Yes — I pick up new tools pretty quickly", s:{pivot:4,ai:4,income:3}},
    {t:"Very well — I enjoy learning new tech", s:{pivot:5,ai:5,income:4}},
    {t:"Excellent — I try new things before others", s:{pivot:6,ai:6,income:5}},
  ]},
  {q:"How do you like to work?", opts:[
    {t:"I like clear instructions and a boss to report to", s:{leadership:0,remote:0,startup:0}},
    {t:"I work best with a boss who sets direction but gives freedom", s:{leadership:1,remote:2,startup:1}},
    {t:"I can work alone but I like some structure", s:{leadership:2,remote:4,startup:2}},
    {t:"I work alone with check-ins sometimes", s:{remote:5,startup:4}},
    {t:"I drive my own direction with little oversight", s:{remote:6,startup:6,leadership:3}},
    {t:"I am completely independent and love freedom", s:{remote:7,startup:7,leadership:2}},
  ]},
  {q:"Have you managed people or projects?", opts:[
    {t:"No — I have not managed anyone", s:{leadership:1}},
    {t:"Informally — I mentored or led without a title", s:{leadership:3}},
    {t:"Yes, 1–2 years of managing a team or project", s:{leadership:4}},
    {t:"Yes, 3–5 years of managing a team", s:{leadership:5}},
    {t:"Yes, 5+ years managing teams or big projects", s:{leadership:6}},
    {t:"Yes, senior leadership — I am responsible for big outcomes", s:{leadership:7}},
  ]},
  {q:"Do you like working with a team or alone?", opts:[
    {t:"Team is essential — I need people and connection", s:{remote:1,startup:1}},
    {t:"Team is important — I like working together but can work alone", s:{remote:2,startup:2}},
    {t:"Neutral — I am happy either way", s:{remote:4,startup:4}},
    {t:"I like working alone but can work with others", s:{remote:6,startup:5}},
    {t:"I strongly prefer working alone", s:{remote:7,startup:6}},
    {t:"I thrive alone — I do not like collaboration", s:{remote:7,startup:7}},
  ]},
  {q:"Have you been promoted or moved up in your job?", opts:[
    {t:"Not much — I am stuck at the same level for 5+ years", s:{income:1,leadership:1}},
    {t:"Some — 1–2 promotions in 10+ years", s:{income:2,leadership:2}},
    {t:"Regular — promoted every 2–3 years", s:{income:4,leadership:4}},
    {t:"Fast — promoted every 1–2 years", s:{income:5,leadership:5}},
    {t:"Very fast — promoted often or moved to leadership", s:{income:6,leadership:6}},
    {t:"Always — people regularly want me for bigger roles", s:{income:7,leadership:7}},
  ]},
  {q:"How much has your pay grown in the last 5 years?", opts:[
    {t:"Very little — almost no growth", s:{income:1,pivot:3}},
    {t:"Slow — 10–25% growth", s:{income:2,pivot:3}},
    {t:"Medium — 25–50% growth", s:{income:4}},
    {t:"Good — 50–100% growth", s:{income:5}},
    {t:"Strong — 100–150% growth", s:{income:6}},
    {t:"Very strong — 150%+ growth or much more money", s:{income:7}},
  ]},
  {q:"How important is making more money in your next job?", opts:[
    {t:"Not important — I care about meaning and balance more", s:{income:1}},
    {t:"Somewhat important — money matters but so do other things", s:{income:3}},
    {t:"Moderately important — I want more money but not at any cost", s:{income:4}},
    {t:"Very important — I am looking for jobs that pay more", s:{income:6}},
    {t:"Extremely important — money is my main reason", s:{income:7}},
    {t:"I want to reach a certain money goal no matter what", s:{income:7}},
  ]},
  {q:"Do you want to work from an office or at home?", opts:[
    {t:"Must be in office — I need the office", s:{remote:0}},
    {t:"Mostly office with some days at home", s:{remote:2}},
    {t:"Hybrid — 2–3 days in office", s:{remote:3}},
    {t:"Mostly at home with some office days", s:{remote:5}},
    {t:"Fully at home — no commute", s:{remote:6}},
    {t:"From anywhere — I want to work from anywhere in the world", s:{remote:7}},
  ]},
  {q:"How well did you work fully at home?", opts:[
    {t:"Struggled — isolation and distractions were hard", s:{remote:1}},
    {t:"Challenging — it took me time to adjust", s:{remote:2}},
    {t:"Fine — I worked okay and was productive", s:{remote:3}},
    {t:"Well — I was productive and comfortable", s:{remote:5}},
    {t:"Great — I actually preferred it", s:{remote:6}},
    {t:"Never tried working fully at home", s:{remote:3}},
  ]},
  {q:"How do you like to communicate with your team?", opts:[
    {t:"Need lots of in-person or face-to-face meetings", s:{remote:1}},
    {t:"Like in-person but video calls are okay", s:{remote:2}},
    {t:"Good with both in-person and video", s:{remote:3}},
    {t:"Comfortable with mostly video meetings", s:{remote:4}},
    {t:"Like written messages and fewer meetings", s:{remote:5}},
    {t:"Strongly like written messages, very few meetings", s:{remote:6}},
  ]},
