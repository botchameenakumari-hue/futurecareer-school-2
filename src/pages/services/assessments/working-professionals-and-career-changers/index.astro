function calculateCognitiveBalance(scores) {
  var logical = (scores.pivot || 0 + scores.income || 0) / 2;
  var creative = (scores.startup || 0) / 1;
  var social = (scores.leadership || 0) / 1;
  var practical = (scores.remote || 0 + scores.ai || 0) / 2;

  var all = [logical, creative, social, practical];
  var max = Math.max(...all);
  var min = Math.min(...all);
  var range = max - min;

  var balance = Math.round(100 - Math.min(100, (range / (max || 1)) * 80));
  var profile = balance > 70 ? 'Well-Rounded' : balance > 50 ? 'Balanced' : 'Specialized';

  return {
    score: balance,
    profile: profile,
    logical: Math.round(logical),
    creative: Math.round(creative),
    social: Math.round(social),
    practical: Math.round(practical),
    interpretation: balance > 70 ? 'You have diverse strengths across professional dimensions. You can adapt to many roles.' :
                   balance > 50 ? 'You have a mix of strengths with one primary area. Good flexibility while staying true to your expertise.' :
                   'You have a clear dominant professional strength. Leverage it as your competitive advantage.'
  };
}

function calculateLearningStyleAlignment(topLS, primary) {
  var alignment = {
    vis: {pivot: 70, income: 75, leadership: 65, startup: 70, remote: 75, ai: 70},
    aud: {leadership: 85, income: 75, pivot: 55, startup: 65, remote: 50, ai: 50},
    kin: {startup: 85, income: 65, leadership: 70, pivot: 60, remote: 65, ai: 45}
  };

  var score = (alignment[topLS] && alignment[topLS][primary]) || 60;
  var lsName = {vis: 'Visual', aud: 'Auditory', kin: 'Kinesthetic'}[topLS];

  return {
    learningStyle: lsName,
    alignmentScore: score,
    careerAlignment: score > 75 ? 'Excellent alignment. Your learning style matches your career approach.' :
                    score > 60 ? 'Good alignment. You can leverage your learning style in your career decisions.' :
                    'Moderate alignment. You may need to develop complementary learning approaches.',
    implication: lsName === 'Visual' ? 'Seek roles involving strategic planning, systems thinking, and clear frameworks.' :
                lsName === 'Auditory' ? 'Seek roles involving mentorship, communication, collaboration, and group leadership.' :
                'Seek roles involving hands-on execution, experimentation, and direct application.'
  };
}

function calculateAptitudeProfile(scores) {
  var num = (scores.income || 0) + (scores.pivot || 0);
  var ver = (scores.leadership || 0) + (scores.remote || 0);
  var lgc = (scores.startup || 0) + (scores.ai || 0);

  var max = Math.max(num, ver, lgc);
  var total = num + ver + lgc;

  var primary = num >= ver && num >= lgc ? 'Financial' : ver >= num && ver >= lgc ? 'Leadership' : 'Technical';
  var strength = max > 0 ? Math.round((max / (total || 1)) * 100) : 50;

  return {
    primary: primary,
    numerical: num,
    verbal: ver,
    logical: lgc,
    dominanceStrength: strength,
    profile: strength > 60 ? 'Specialized: ' + primary + ' focus dominant' : 'Balanced across dimensions',
    careerImplication: primary === 'Financial' ? 'Income leverage, financial planning, and compensation strategies suit you best.' :
                      primary === 'Leadership' ? 'People leadership, influence, and organizational roles suit you best.' :
                      'Technical innovation, automation, and strategic technical decisions suit you best.'
  };
}

function calculateCareerReadiness(patterns, percentiles, primary) {
  var convictionScore = patterns && patterns.convictionLevel === 'High' ? 85 : patterns && patterns.convictionLevel === 'Moderate' ? 65 : 45;
  var clarityScore = percentiles && percentiles[primary] ? percentiles[primary] : 50;
  var consistencyScore = patterns && patterns.consistency ? patterns.consistency : 50;

  var readiness = Math.round((convictionScore + clarityScore + consistencyScore) / 3);
  var stage = readiness > 75 ? 'Ready to Execute' : readiness > 60 ? 'Building Strategy' : 'Early Assessment';

  return {
    score: readiness,
    stage: stage,
    conviction: convictionScore,
    clarity: clarityScore,
    consistency: consistencyScore,
    recommendation: readiness > 75 ? 'You are ready to act on your strategic insights and make career moves.' :
                   readiness > 60 ? 'Continue building your strategy with targeted skill development.' :
                   'Take time to assess your options before making major career decisions.'
  };
}

function calculateAdaptability(patterns, conflicts) {
  var consistencyBonus = patterns && patterns.consistency > 70 ? 20 : 10;
  var conflictPenalty = (conflicts && Object.keys(conflicts).length > 0) ? -10 : 10;
  var convictionBonus = patterns && patterns.convictionLevel === 'Exploring' ? 30 : 0;

  var score = Math.max(0, Math.min(100, 50 + consistencyBonus + conflictPenalty + convictionBonus));
  var adaptability = score > 70 ? 'Highly Adaptable' : score > 50 ? 'Moderately Adaptable' : 'Needs Stability';

  return {
    score: score,
    adaptability: adaptability,
    interpretation: score > 70 ? 'You can navigate career pivots and changing conditions easily. Uncertainty is your strength.' :
             score > 50 ? 'You can adapt with strategic planning. Try new opportunities while maintaining focus.' :
             'You thrive with clear direction. Build deep expertise in your chosen area.'
  };
}

function computeProfile() {
  var max = Math.max(scores.pivot, scores.income, scores.leadership, scores.remote, scores.ai, scores.startup);
  var profiles = Object.keys(scores).sort(function(a, b) { return scores[b] - scores[a]; });
  var primary = profiles[0];
  var secondary = profiles[1];

  // Calculate percentiles and strengths
  var percentiles = {};
  var strengths = {};
  for (var key in DIMENSION_RANGES) {
    var range = DIMENSION_RANGES[key];
    percentiles[key] = calculatePercentile(scores[key], range.min, range.max);
    strengths[key] = classifyStrength(percentiles[key]);
  }

  // Assign archetype
  var archetype = assignArchetype(scores);

  // Estimate timeline
  var timeline = estimateTimeline(scores.pivot, scores.leadership, scores.income);

  // Get dimension interaction
  var dimInteraction = getDimensionInteraction(scores, primary);

  // Detect dimension conflicts
  var conflicts = detectDimensionConflicts(scores, primary);

  // Get coaches frameworks
  var coachesRecommendations = mapProfileToCoachesSkills(primary);

  // Set up Rule of 30 financial framework
  var ruleOf30 = {
    baseline_monthly: '₹3,00,000',
    baseline_yearly: '₹36,00,000',
    freedom_number: '₹10.8 Crore',
    multiplier: 30,
    inflation_assumption: '12% per year'
  };

  // Additional metrics
  var patterns = analyzeResponsePatterns(answers);
  var cogBalance = calculateCognitiveBalance(scores);
  var readiness = calculateCareerReadiness(patterns, percentiles, primary);
  var adapt = calculateAdaptability(patterns, conflicts);
  var lsAlign = calculateLearningStyleAlignment('aud', primary);
  var aptProfile = calculateAptitudeProfile(scores);

  return {
    primary: primary,
    secondary: secondary,
    max: max,
    percentiles: percentiles,
    strengths: strengths,
    archetype: archetype,
    archetypeData: ARCHETYPES[archetype],
    timeline: timeline,
    dimInteraction: dimInteraction,
    conflicts: conflicts,
    coachesRecommendations: coachesRecommendations,
    ruleOf30: ruleOf30,
    // Additional metrics
    cognitiveBalance: cogBalance,
    careerReadiness: readiness,
    learningStyleAlignment: lsAlign,
    aptitudeProfile: aptProfile,
    adaptabilityIndex: adapt
  };
}

