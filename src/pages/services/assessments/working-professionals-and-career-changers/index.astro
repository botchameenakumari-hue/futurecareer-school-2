function calculatePercentile(score, min, max) {
  if (max <= min) return 50;
  return Math.round(((score - min) / (max - min)) * 100);
}

function classifyStrength(percentile) {
  if (percentile >= 85) return {tier: 'Critical Strength', icon: '🔴', color: '#ef4444'};
  if (percentile >= 70) return {tier: 'Strong', icon: '🟠', color: '#f59e0b'};
  if (percentile >= 50) return {tier: 'Moderate', icon: '🟡', color: '#eab308'};
  if (percentile >= 30) return {tier: 'Emerging', icon: '🟢', color: '#10b981'};
  return {tier: 'Low Focus', icon: '⚪', color: '#6b7a99'};
}

function assignArchetype(scores) {
  for (var key in ARCHETYPES) {
    if (ARCHETYPES[key].match(scores)) {
      return key;
    }
  }
  return 'balanced-explorer';
}

function estimateTimeline(pivot, skills, income) {
  if (pivot < 30) return '3+ years OR stay and optimize';
  if (pivot > 70 && skills > 60) return '6-12 months (rapid track)';
  if (pivot > 60 && skills > 40) return '12-18 months (standard track)';
  if (pivot > 50) return '18-24 months (deliberate build)';
  return 'Not recommended at this time';
}

