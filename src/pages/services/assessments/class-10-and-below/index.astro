───────────────────────────────────────────── */
let currentQ = 0;
let currentLang = 'en';
const answers = new Array(QUESTIONS.length).fill(null);

function getQText(idx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[idx].q;
  var tr = TRANSLATIONS[currentLang];
  return (tr[idx] && tr[idx].q) ? tr[idx].q : QUESTIONS[idx].q;
}
function getOptText(qIdx, optIdx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[qIdx].opts[optIdx].t;
  var tr = TRANSLATIONS[currentLang];
  return (tr[qIdx] && tr[qIdx].opts && tr[qIdx].opts[optIdx]) ? tr[qIdx].opts[optIdx] : QUESTIONS[qIdx].opts[optIdx].t;
}

document.addEventListener('DOMContentLoaded', function() {
  renderQuestion(0);
  updateProgress();

  // Language selector
  document.querySelectorAll('.lang-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.remove('lang-btn--active'); });
      this.classList.add('lang-btn--active');
      currentLang = this.getAttribute('data-lang');
      renderQuestion(currentQ);
    });
  });
});

/* ─────────────────────────────────────────────
   RENDER QUESTION
───────────────────────────────────────────── */
function renderQuestion(idx) {
  const q = QUESTIONS[idx];
  const isMultiselect = q.multiselect === true;
  let questionLabel = 'Question ' + (idx + 1);
  if (isMultiselect) {
    questionLabel += ' (Select all that apply)';
  }
  document.getElementById('q-num').textContent = questionLabel;
  document.getElementById('q-text').textContent = getQText(idx);

  const container = document.getElementById('q-opts');
  container.innerHTML = '';
  const selectedAnswers = isMultiselect ? (answers[idx] || []) : (answers[idx] !== null ? [answers[idx]] : []);

  q.opts.forEach(function(opt, i) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'opt-btn' + (selectedAnswers.includes(i) ? ' selected' : '');
    btn.setAttribute('aria-pressed', selectedAnswers.includes(i) ? 'true' : 'false');
    btn.setAttribute('data-opt-index', i);
    btn.innerHTML = '<span class="opt-letter">' + String.fromCharCode(65 + i) + '</span><span class="opt-text">' + getOptText(idx, i) + '</span>';
    btn.onclick = function() { selectOption(idx, parseInt(this.getAttribute('data-opt-index'))); };
    container.appendChild(btn);
  });
}

/* ─────────────────────────────────────────────
   SELECT OPTION (supports both single and multi-select)
───────────────────────────────────────────── */
function selectOption(qIdx, optIdx) {
  // Safety checks
  if (!QUESTIONS || !QUESTIONS[qIdx]) {
    console.error('Invalid question index:', qIdx);
    return;
  }
  const q = QUESTIONS[qIdx];
  if (!q.opts || !q.opts[optIdx]) {
    console.error('Invalid option index:', optIdx, 'for question:', qIdx, 'Total options:', q.opts ? q.opts.length : 0);
    return;
  }

  const isMultiselect = q.multiselect === true;

  if (isMultiselect) {
    // Multi-select: toggle selection
    if (!answers[qIdx]) answers[qIdx] = [];
    const idx = answers[qIdx].indexOf(optIdx);

    if (idx > -1) {
      // Remove selection
      const prev = q.opts[optIdx].s;
      if (prev) Object.keys(prev).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prev[k]; });
      answers[qIdx].splice(idx, 1);
    } else {
      // Add selection
      const cur = q.opts[optIdx].s;
      if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
      answers[qIdx].push(optIdx);
    }
  } else {
    // Single-select: replace selection
    if (answers[qIdx] !== null && answers[qIdx] !== undefined) {
      const prevOpt = q.opts[answers[qIdx]];
      if (prevOpt && prevOpt.s) {
        Object.keys(prevOpt.s).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prevOpt.s[k]; });
      }
    }
    const cur = q.opts[optIdx].s;
    if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
    answers[qIdx] = optIdx;
  }

  renderQuestion(qIdx);

  const nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = false;
  nextBtn.focus();
}

/* ─────────────────────────────────────────────
   NAVIGATION
───────────────────────────────────────────── */
function nextQuestion() {
  const q = QUESTIONS[currentQ];
  const isMultiselect = q.multiselect === true;

  // Check if question is answered
  const isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);
  if (!isAnswered) return;

  currentQ++;
  if (currentQ >= QUESTIONS.length) { showResults(); return; }
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function prevQuestion() {
  if (currentQ === 0) return;
  currentQ--;
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/* ─────────────────────────────────────────────
   PROGRESS
───────────────────────────────────────────── */
function updateProgress() {
  const total = QUESTIONS.length;
  const pct = Math.round((currentQ / total) * 100);
  document.getElementById('q-counter').textContent = 'Question ' + (currentQ + 1) + ' of ' + total;
  document.getElementById('q-pct').textContent = pct + '% complete';

  const fill = document.getElementById('progress-fill');
  fill.style.width = pct + '%';
  fill.closest('[role=progressbar]').setAttribute('aria-valuenow', pct);
  document.getElementById('btn-back').disabled = currentQ === 0;

  const q = QUESTIONS[currentQ];
  const isMultiselect = q && q.multiselect === true;
  const isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);

  const nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = !isAnswered;
  const isLast = currentQ === total - 1;
  nextBtn.innerHTML = (isLast ? 'See My Results' : 'Next Question') + ' <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>';
}

/* ─────────────────────────────────────────────
   COMPREHENSIVE HELPER FUNCTIONS - Class 10 Deep Personalization
───────────────────────────────────────────── */

function calculatePercentile(score, min, max) {
  if (max <= min) return 50;
  return Math.round(((score - min) / (max - min)) * 100);
}

function classifyStrength(percentile) {
  if (percentile >= 85) return {tier: 'Critical Strength', icon: '🔴', color: '#ef4444'};
  if (percentile >= 70) return {tier: 'Strong', icon: '🟠', color: '#f59e0b'};
  if (percentile >= 50) return {tier: 'Moderate', icon: '🟡', color: '#eab308'};
  if (percentile >= 30) return {tier: 'Emerging', icon: '🟢', color: '#10b981'};
  return {tier: 'Developing', icon: '⚪', color: '#6b7a99'};
}

function analyzeResponsePatterns() {
  var allScores = Object.keys(scores).map(function(k) { return scores[k]; });
  var avgScore = allScores.reduce(function(a,b){return a+b;},0) / allScores.length;
  var variance = allScores.reduce(function(sum, s) { return sum + Math.pow(s - avgScore, 2); }, 0) / allScores.length;
  var stdDev = Math.sqrt(variance);

  var convictionLevel = stdDev > 3 ? 'High' : stdDev > 1.5 ? 'Moderate' : 'Exploring';
  var consistency = 100 - Math.min(100, stdDev * 15);

  return {
    convictionLevel: convictionLevel,
    consistency: Math.round(consistency),
    avgScore: Math.round(avgScore),
    variance: Math.round(variance * 100) / 100,
    interpretation: convictionLevel === 'High' ? 'Your answers show strong, consistent patterns about what interests you.' :
                   convictionLevel === 'Moderate' ? 'Your answers show moderate clarity — you\'re exploring thoughtfully.' :
                   'Your answers are varied — you\'re discovering different interests, which is exactly right for your age.'
  };
}

function inferSelfAwareness() {
  var patterns = analyzeResponsePatterns();
  var confidenceScore = Math.min(100, Math.round(patterns.consistency));

  return {
    convictionLevel: patterns.convictionLevel,
    readiness: patterns.convictionLevel === 'High' ? 'Committed' : 'Exploring',
    confidenceScore: confidenceScore,
    consistency: patterns.consistency,
    message: patterns.interpretation
  };
}

