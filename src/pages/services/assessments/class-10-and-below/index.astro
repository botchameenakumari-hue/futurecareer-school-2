function calculateCognitiveBalance(scores) {
  var logical = (scores.I + scores.lgc) / 2;
  var creative = (scores.A + scores.spa + scores.mus) / 3;
  var social = (scores.S + scores.inter) / 2;
  var practical = (scores.R + scores.bk) / 2;

  var all = [logical, creative, social, practical];
  var max = Math.max(...all);
  var min = Math.min(...all);
  var range = max - min;

  var balance = Math.round(100 - Math.min(100, (range / (max || 1)) * 80));
  var profile = balance > 70 ? 'Well-Rounded' : balance > 50 ? 'Balanced' : 'Specialized';

  return {
    score: balance,
    profile: profile,
    logical: Math.round(logical),
    creative: Math.round(creative),
    social: Math.round(social),
    practical: Math.round(practical),
    interpretation: balance > 70 ? 'You have diverse strengths across thinking styles. You can adapt to many roles.' :
                   balance > 50 ? 'You have a mix of strengths with one primary style. Good flexibility while staying true to your nature.' :
                   'You have a clear dominant thinking style. Choose roles that match your natural style for best results.'
  };
}

function calculateConflictIntensity(conflicts) {
  if (!conflicts || Object.keys(conflicts).length === 0) {
    return { hasConflict: false, intensity: 0, message: 'No major conflicts. Your interests align well.' };
  }

  var conflictCount = Object.keys(conflicts).length;
  var intensity = Math.min(100, conflictCount * 25);

  return {
    hasConflict: true,
    intensity: intensity,
    conflictCount: conflictCount,
    message: intensity > 60 ? 'You have competing interests. Explore which one energizes you most.' :
             'You have some contrasting interests. This creates flexibility in your career choices.'
  };
}

function calculateCareerReadiness(patterns, percentiles, primary) {
  var convictionScore = patterns.convictionLevel === 'High' ? 85 : patterns.convictionLevel === 'Moderate' ? 65 : 45;
  var clarityScore = percentiles[primary] || 50;
  var consistencyScore = patterns.consistency || 50;

  var readiness = Math.round((convictionScore + clarityScore + consistencyScore) / 3);
  var stage = readiness > 75 ? 'Ready to Explore Seriously' : readiness > 60 ? 'Building Clarity' : 'Early Discovery';

  return {
    score: readiness,
    stage: stage,
    conviction: convictionScore,
    clarity: clarityScore,
    consistency: consistencyScore,
    recommendation: readiness > 75 ? 'Consider deeper exploration through shadowing and projects.' :
                   readiness > 60 ? 'Continue exploring different career paths and skills.' :
                   'Keep experimenting. Clarity comes from trying different things.'
  };
}

function calculateLearningStyleAlignment(topLS, riasecPrimary) {
  var alignment = {
    vis: {I: 70, A: 80, C: 75, E: 60, S: 50, R: 55},
    aud: {S: 85, E: 75, I: 55, A: 65, C: 50, R: 45},
    kin: {R: 90, A: 70, S: 65, I: 50, E: 60, C: 45}
  };

  var score = (alignment[topLS] && alignment[topLS][riasecPrimary]) || 60;
  var lsName = {vis: 'Visual', aud: 'Auditory', kin: 'Kinesthetic'}[topLS];

  return {
    learningStyle: lsName,
    alignmentScore: score,
    careerAlignment: score > 75 ? 'Excellent alignment. Your learning style matches your career strengths.' :
                    score > 60 ? 'Good alignment. You can leverage your learning style in your career.' :
                    'Moderate alignment. You may need to develop complementary learning approaches.',
    implication: lsName === 'Visual' ? 'Seek careers involving design, visualization, and clear systems.' :
                lsName === 'Auditory' ? 'Seek careers involving communication, collaboration, and group work.' :
                'Seek careers involving hands-on work, physical problem-solving, and direct application.'
  };
}

function calculateAptitudeProfile(scores) {
  var num = scores.num || 0;
  var ver = scores.ver || 0;
  var lgc = scores.lgc || 0;

  var max = Math.max(num, ver, lgc);
  var total = num + ver + lgc;

  var primary = num >= ver && num >= lgc ? 'Numerical' : ver >= num && ver >= lgc ? 'Verbal' : 'Logical';
  var strength = max > 0 ? Math.round((max / (total || 1)) * 100) : 50;

  return {
    primary: primary,
    numerical: num,
    verbal: ver,
    logical: lgc,
    dominanceStrength: strength,
    profile: strength > 60 ? 'Specialized: ' + primary + ' strength dominant' : 'Balanced across aptitudes',
    careerImplication: primary === 'Numerical' ? 'Data, statistics, and quantitative roles suit you best.' :
                      primary === 'Verbal' ? 'Communication, writing, and language-based roles suit you best.' :
                      'Problem-solving, analysis, and structured thinking roles suit you best.'
  };
}

function calculateAdaptability(patterns, conflicts) {
  var consistencyBonus = patterns.consistency > 70 ? 20 : 10;
  var conflictPenalty = (conflicts && Object.keys(conflicts).length > 0) ? -10 : 10;
  var convictionBonus = patterns.convictionLevel === 'Exploring' ? 30 : 0;

  var score = Math.max(0, Math.min(100, 50 + consistencyBonus + conflictPenalty + convictionBonus));
  var adaptability = score > 70 ? 'Highly Adaptable' : score > 50 ? 'Moderately Adaptable' : 'Needs Stability';

  return {
    score: score,
    adaptability: adaptability,
    message: score > 70 ? 'You can easily pivot and try different paths. Uncertainty is your strength.' :
             score > 50 ? 'You can adapt with some planning. Try new things while maintaining structure.' :
             'You thrive with clear direction. Build deep skills in your chosen area.'
  };
}

