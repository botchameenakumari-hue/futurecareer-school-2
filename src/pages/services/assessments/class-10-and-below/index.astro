/* ─────────────────────────────────────────────
   COMPUTE PROFILE
───────────────────────────────────────────── */
function computeProfile() {
  // RIASEC top 2
  const riasecKeys = ['R','I','A','S','E','C'];
  const riasecSorted = riasecKeys.slice().sort(function(a,b){ return scores[b]-scores[a]; });
  const primary = riasecSorted[0];
  const secondary = riasecSorted[1];

  // Stream recommendation
  const streamAdj = { pcm: scores.pcm, pcb: scores.pcb, com: scores.com, hum: scores.hum };
  const streamBoosts = { R:{pcb:3,pcm:2}, I:{pcm:4,pcb:2}, A:{hum:4,com:2}, S:{hum:3,pcb:3,com:1}, E:{com:4,pcm:1}, C:{com:3,pcm:3} };
  if (streamBoosts[primary])   Object.keys(streamBoosts[primary]).forEach(function(s){ streamAdj[s]   += streamBoosts[primary][s]; });
  if (streamBoosts[secondary]) Object.keys(streamBoosts[secondary]).forEach(function(s){ streamAdj[s] += Math.round(streamBoosts[secondary][s]/2); });
  const streamSorted = Object.keys(streamAdj).sort(function(a,b){ return streamAdj[b]-streamAdj[a]; });
  const topStream = streamSorted[0];
  const altStream = streamSorted[1];

  // MI top 2
  const miKeys = ['lin','log','spa','bk','inter','intra','mus','nat'];
  const miSorted = miKeys.slice().sort(function(a,b){ return scores[b]-scores[a]; });
  const topMI = miSorted[0];
  const altMI = miSorted[1];

  // Learning style
  const lsKeys = ['vis','aud','kin'];
  const topLS = lsKeys.reduce(function(a,b){ return scores[a]>=scores[b]?a:b; });

  // Aptitude
  const aptMax = Math.max(scores.num, scores.ver, scores.lgc, 1);

  // Calculate percentiles for all RIASEC dimensions
  const riasecMax = Math.max(scores.R, scores.I, scores.A, scores.S, scores.E, scores.C);
  var percentiles = {};
  riasecKeys.forEach(function(k) {
    percentiles[k] = calculatePercentile(scores[k], 0, riasecMax);
  });

  // Calculate percentiles for aptitudes
  percentiles.num = calculatePercentile(scores.num, 0, aptMax);
  percentiles.ver = calculatePercentile(scores.ver, 0, aptMax);
  percentiles.lgc = calculatePercentile(scores.lgc, 0, aptMax);

  // Classify strengths
  var strengths = {};
  riasecKeys.forEach(function(k) {
    strengths[k] = classifyStrength(percentiles[k]);
  });
  strengths.num = classifyStrength(percentiles.num);
  strengths.ver = classifyStrength(percentiles.ver);
  strengths.lgc = classifyStrength(percentiles.lgc);

  // Analyze response patterns
  var patterns = analyzeResponsePatterns();

  // Get dimension interaction
  var dimInteraction = getDimensionInteraction(scores, primary);

  // Detect dimension conflicts
  var conflicts = detectDimensionConflicts(scores, primary);

  // Get coaches frameworks (High-Income Skills, Deep Skills, Business Types)
  var coachesRecommendations = mapRIASECToCoachesSkills(primary, secondary);

  // ADDITIONAL METRICS: Cognitive Balance, Conflict Intensity, Career Readiness
  var cognitiveBalance = calculateCognitiveBalance(scores);
  var conflictIntensity = calculateConflictIntensity(conflicts);
  var careerReadiness = calculateCareerReadiness(patterns, percentiles, primary);
  var learningStyleAlignment = calculateLearningStyleAlignment(topLS, primary);
  var aptitudeProfile = calculateAptitudeProfile(scores);
  var adaptabilityIndex = calculateAdaptability(patterns, conflicts);

  return {
    primary: primary,
    secondary: secondary,
    riasecSorted: riasecSorted,
    topStream: topStream,
    altStream: altStream,
    streamAdj: streamAdj,
    topMI: topMI,
    altMI: altMI,
    topLS: topLS,
    aptMax: aptMax,
    percentiles: percentiles,
    strengths: strengths,
    patterns: patterns,
    dimInteraction: dimInteraction,
    conflicts: conflicts,
    coachesRecommendations: coachesRecommendations,
    // Additional metrics
    cognitiveBalance: cognitiveBalance,
    conflictIntensity: conflictIntensity,
    careerReadiness: careerReadiness,
    learningStyleAlignment: learningStyleAlignment,
    aptitudeProfile: aptitudeProfile,
    adaptabilityIndex: adaptabilityIndex
  };
}

/* ─────────────────────────────────────────────
   BUILD RIASEC BARS
───────────────────────────────────────────── */
function buildRiasecBars(riasecSorted) {
  const maxScore = Math.max(...riasecSorted.map(function(k){ return scores[k]; }), 1);
  return riasecSorted.map(function(k) {
    const p = RIASEC[k];
    const pct = Math.max(Math.round((scores[k] / maxScore) * 100), 2);
    return '<div class="rb-row">' +
      '<div class="rb-label"><span class="rb-dot" style="background:' + p.color + '"></span>' + p.emoji + ' <strong>' + p.label + '</strong></div>' +
      '<div class="rb-track"><div class="rb-fill" style="width:' + pct + '%;background:' + p.color + '"></div></div>' +
      '<div class="rb-pct" style="color:' + p.color + '">' + pct + '%</div>' +
    '</div>';
  }).join('');
}

/* ─────────────────────────────────────────────
   BUILD APTITUDE BARS
───────────────────────────────────────────── */
function buildAptitudeBars(aptMax) {
  const items = [
    { key:'num', label:'Numerical', emoji:'🔢', color:'#6366f1' },
    { key:'ver', label:'Verbal',    emoji:'📝', color:'#8b5cf6' },
    { key:'lgc', label:'Logical',   emoji:'🧩', color:'#14b8a6' },
  ];
  return items.map(function(it) {
    const pct = Math.max(Math.round((scores[it.key] / aptMax) * 100), 2);
    const level = pct >= 80 ? 'Very Strong' : pct >= 55 ? 'Strong' : pct >= 35 ? 'Moderate' : 'Developing';
    return '<div class="apt-row">' +
      '<div class="apt-label">' + it.emoji + ' <strong>' + it.label + '</strong> <span class="apt-level" style="color:' + it.color + '">' + level + '</span></div>' +
      '<div class="apt-track"><div class="apt-fill" style="width:' + pct + '%;background:' + it.color + '"></div></div>' +
    '</div>';
  }).join('');
}

