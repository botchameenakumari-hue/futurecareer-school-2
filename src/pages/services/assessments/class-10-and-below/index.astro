/* ─────────────────────────────────────────────
   DOWNLOAD RESULTS AS PDF
───────────────────────────────────────────── */
function downloadResultsAsPDF() {
  var resultsContainer = document.getElementById('results-container');
  if (!resultsContainer || !window.downloadAssessmentReportPdf) {
    return;
  }

  window.downloadAssessmentReportPdf({
    title: 'Class 10 and Below Career Assessment Report',
    fileName: 'class-10-career-assessment-report.pdf',
    container: resultsContainer
  });
}

/* ─────────────────────────────────────────────
   RETAKE
───────────────────────────────────────────── */
function retakeQuiz() {
  currentQ = 0;
  answers.fill(null);
  Object.keys(scores).forEach(function(k){ scores[k] = 0; });
  document.getElementById('results-container').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'block';
  renderQuestion(0);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

globalThis.prevQuestion = prevQuestion;
globalThis.nextQuestion = nextQuestion;
globalThis.downloadResultsAsPDF = downloadResultsAsPDF;
globalThis.retakeQuiz = retakeQuiz;
</script>

