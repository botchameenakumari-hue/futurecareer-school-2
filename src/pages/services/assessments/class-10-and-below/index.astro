---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/class-10-and-below/';
const plansConfig = getAssessmentPlansConfig('student');
const guidanceCardHref = plansConfig.jumpHref;
const guidanceResultsHref = plansConfig.jumpHref;
const guidanceResultsLabel = plansConfig.jumpLabel;
const focusedTests = [
  {
    href: '/services/assessments/stream-selector-test-after-10th/',
    title: 'Stream Selector Test After 10th',
    description: 'A quick 15-question stream quiz for a direct Science, Commerce, or Arts recommendation.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-10th/',
    title: 'Career Aptitude Test After 10th',
    description: 'A focused aptitude test for understanding strengths before choosing a stream.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Career Assessment for Class 10 and Below', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Career Assessment for School Students (Class 10 and Below)',
    description: 'A free 25-question psychometric career assessment for school students. Covers RIASEC career interests, multiple intelligence profile, aptitude signals, learning style, and stream recommendation. Instant results. No sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Who should take this career assessment?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'School students in Class 10 or below who want clarity on which stream fits them, what their natural strengths are, and which career directions are worth exploring. Class 8 and 9 students benefit just as much — the earlier you start mapping this, the better your decisions.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is this assessment completely free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Fully free. No sign-up, no payment, no login required. All assessments on Future Career School are free.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does this assessment actually test?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Six things simultaneously in 25 questions: (1) Career interests using the RIASEC model, (2) Stream recommendation for Class 11, (3) Multiple intelligence profile based on Gardner\'s 8 types, (4) Subject preference and learning style, (5) Numerical, verbal, and logical aptitude signals, and (6) Work environment and personality fit.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the RIASEC model?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'RIASEC is a widely used career interest framework developed by psychologist John Holland. It identifies six career personality types: Realistic (hands-on, practical), Investigative (analytical, scientific), Artistic (creative, expressive), Social (people-oriented, helping), Enterprising (leadership, business), and Conventional (organised, systematic). Your top two types form your Holland Code — a useful starting point for career direction.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long does this assessment take?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'About 12 to 18 minutes. There are 25 scenario-based questions. Most students complete it in under 15 minutes.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is this result a definitive career decision?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. This is a practical starting point — a direction, not a destination. It shows you patterns worth exploring. For fuller clarity before stream and academic decisions harden, the stronger move is updated, skill-first career guidance built around your future readiness and long-term earning direction.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Free Career Assessment for School Students (Class 10 and Below) | Future Career School"
  description="Free 25-question psychometric career assessment. Covers RIASEC career interests, multiple intelligence profile, stream recommendation, aptitude signals, and learning style. Instant results. No sign-up."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Class 10 and Below</span>
      </nav>

      <div class="pill">
        <span class="dot"></span>
        Free &nbsp;&middot;&nbsp; 25 Questions &nbsp;&middot;&nbsp; 6 Tests in One &nbsp;&middot;&nbsp; Instant Results &nbsp;&middot;&nbsp; No Sign-Up
      </div>

      <h1>
        Free Career Assessment for<br/>
        <span class="gold-text">School Students (Class 10 and Below)</span>
      </h1>

      <p class="hero-sub">
        Discover your RIASEC career type, multiple intelligence profile, aptitude signals, learning style,
        and stream recommendation — all from 25 carefully designed questions.
        No guesswork. No generic advice. A real profile built around how your mind actually works.
      </p>

      <div class="meta-chips">
        <span class="meta-chip">&#128203; 25 questions</span>
        <span class="meta-chip">&#9200; ~15 minutes</span>
        <span class="meta-chip">&#127775; Instant results</span>
        <span class="meta-chip">&#9989; 100% free</span>
        <span class="meta-chip">&#128100; Class 8–10</span>
        <span class="meta-chip">&#127919; 6 tests in one</span>
      </div>

      <div class="hero-actions">
        <a href="#assessment" class="btn-gold pulse hero-cta">
          Start Free Assessment
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href={plansConfig.jumpHref} class="btn-outline hero-cta">{plansConfig.jumpLabel}</a>
      </div>
    </div>
  </section>

  <div class="assessment-first-flow">
  <!-- WHAT THIS TESTS -->
  <section id="what-this-tests">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--teal)">&#9673;</span>&nbsp;What This Assessment Covers
      </div>
      <h2 class="section-title">Six Tests. One Assessment. Instant Results.</h2>
      <p class="section-sub">
        Each question in this assessment is engineered to capture multiple signals at once.
        25 questions give you what would normally take six separate tests to uncover.
      </p>

      <div class="signals-grid">
        <div class="signal-card signal-riasec">
          <div class="signal-icon-wrap"><span class="signal-icon">&#127919;</span></div>
          <div class="signal-tag">RIASEC Model</div>
          <h3>Career Interest Test</h3>
          <p>Maps your interests across all 6 Holland types — Realistic, Investigative, Artistic, Social, Enterprising, and Conventional — to find your career personality code.</p>
        </div>
        <div class="signal-card signal-stream">
          <div class="signal-icon-wrap"><span class="signal-icon">&#128218;</span></div>
          <div class="signal-tag">Stream Fit</div>
          <h3>Stream Selection Test</h3>
          <p>Combines your RIASEC profile, subject preferences, and aptitude signals to recommend your best-fit stream — Science PCM, PCB, Commerce, or Humanities.</p>
        </div>
        <div class="signal-card signal-mi">
          <div class="signal-icon-wrap"><span class="signal-icon">&#129504;</span></div>
          <div class="signal-tag">Gardner's 8 Types</div>
          <h3>Multiple Intelligence Profile</h3>
          <p>Identifies which of the 8 intelligence types is dominant in you — linguistic, logical, spatial, bodily-kinesthetic, interpersonal, intrapersonal, musical, or naturalist.</p>
        </div>
        <div class="signal-card signal-apt">
          <div class="signal-icon-wrap"><span class="signal-icon">&#129299;</span></div>
          <div class="signal-tag">Aptitude Signals</div>
          <h3>Numerical, Verbal &amp; Logical Aptitude</h3>
          <p>Captures early signals of numerical, verbal, and logical reasoning strength — not to judge ability, but to guide subject and career direction.</p>
        </div>
        <div class="signal-card signal-ls">
          <div class="signal-icon-wrap"><span class="signal-icon">&#127775;</span></div>
          <div class="signal-tag">VAK Framework</div>
          <h3>Learning Style Assessment</h3>
          <p>Identifies whether you learn best visually, auditorily, or kinesthetically — and gives you specific, practical study tips based on how your brain actually retains information.</p>
        </div>
        <div class="signal-card signal-career">
          <div class="signal-icon-wrap"><span class="signal-icon">&#128172;</span></div>
          <div class="signal-tag">Career Discovery</div>
          <h3>Career Discovery Assessment</h3>
          <p>Combines all signals to show which career directions genuinely fit your profile — not a generic list, but paths matched to your specific RIASEC type and intelligence profile.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--gold)">&#128203;</span>&nbsp;Career Assessment
      </div>
      <h2 class="section-title">Discover Your Career Profile</h2>
      <p class="section-sub">
        Read each question carefully. Choose the option that feels most genuinely true for you —
        not what sounds impressive or what adults might want to hear.
        There are no right or wrong answers.
      </p>

      <!-- LANGUAGE SELECTOR -->
      <div class="lang-selector" id="lang-selector">
        <span class="lang-label">Language:</span>
        <button class="lang-btn lang-btn--active" data-lang="en">English</button>
        <button class="lang-btn" data-lang="hi">हिन्दी</button>
        <button class="lang-btn" data-lang="te">తెలుగు</button>
        <button class="lang-btn" data-lang="ta">தமிழ்</button>
        <button class="lang-btn" data-lang="mr">मराठी</button>
      </div>

      <!-- QUIZ CONTAINER -->
      <div id="quiz-container" class="quiz-box">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 25</span>
            <span id="q-pct" class="q-pct">0% complete</span>
          </div>
          <div class="progress-bar-wrap" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>

        <div id="q-display">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading question...</p>
          <div id="q-opts" class="q-opts" role="group" aria-labelledby="q-text"></div>
        </div>

        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back
          </button>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()">
            Next Question
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- RESULTS CONTAINER -->
      <div id="results-container" class="results-box" style="display:none" aria-live="polite"></div>
    </div>
  </section>
  </div>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--gold)">&#10067;</span>&nbsp;Questions About This Assessment
      </div>
      <h2 class="section-title">Common Questions</h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">Who should take this assessment?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Any school student in Class 10 or below who wants to start making sense of their strengths and career direction. Class 8 and Class 9 students get just as much value — the earlier you start mapping this, the better the decisions you make before stream selection becomes a pressure decision.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What is the RIASEC model and why does it matter?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">RIASEC is a career personality framework developed by psychologist John Holland. It identifies six types — Realistic, Investigative, Artistic, Social, Enterprising, and Conventional. Your top two types form your Holland Code, which has been used in career counselling globally for decades. It's one of the most well-validated tools for matching people to careers that actually fit how their mind works.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What are multiple intelligences and are they real?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">The multiple intelligences framework was developed by psychologist Howard Gardner. It proposes that intelligence isn't a single thing — people have different types of cognitive strengths: linguistic, logical-mathematical, spatial, bodily-kinesthetic, interpersonal, intrapersonal, musical, and naturalist. While this framework is more descriptive than a hard scientific measurement, it's practically useful for understanding how you process information best and which types of work feel natural.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What if my answers change depending on the day?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">That's completely normal. Pick the answer that feels most consistently true across your life — not what sounds best or what you think you should say. If you're genuinely unsure between two options, pick the one that felt slightly more you. The overall pattern across 25 questions matters far more than any single answer.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Is this result a definitive career decision?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">No. This is a practical starting point — a direction, not a destination. It gives you a useful pattern to begin exploring, not a final answer. For fuller clarity before stream and academic decisions harden, the stronger move is updated, skill-first career guidance built around future readiness, stronger skills, and better long-term decisions.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">How is this different from a standard aptitude test?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">A standard aptitude test measures ability — what you can do under pressure. This assessment maps interest, preference, and natural inclination — what you gravitate toward, how your brain works best, and what kinds of problems you're naturally drawn to solve. Both matter, but for stream and career direction, preference mapping is often more useful than raw ability scores.</div>
        </details>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="focused-tests"
    title="Focused Free Tests for After 10th"
    subtitle="If you want a faster answer to one specific question, use these dedicated free assessments for after 10th."
    items={focusedTests}
    altBackground={true}
  />

  <!-- INTERNAL LINKS -->
  <section id="next-steps">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--teal)">&#8635;</span>&nbsp;After This Assessment
      </div>
      <h2 class="section-title">Where to Go Next</h2>
      <p class="section-sub">This assessment is a starting point. These options help you move from free clarity to a stronger student decision.</p>
      <div class="links-grid">
        <a href={guidanceCardHref} class="link-card">
          <div class="lc-icon">&#128172;</div>
          <div>
            <div class="lc-title">See Student Guidance Plans</div>
            <div class="lc-desc">Move from free signals to a paid guidance plan when the stream decision needs sharper support.</div>
          </div>
        </a>
        <a href="#guidance-bridge" class="link-card">
          <div class="lc-icon">&#127891;</div>
          <div>
            <div class="lc-title">Why Paid Guidance Helps</div>
            <div class="lc-desc">See why updated, skill-first guidance gives fuller clarity than a free test alone.</div>
          </div>
        </a>
        <a href="/services/assessments" class="link-card">
          <div class="lc-icon">&#128203;</div>
          <div>
            <div class="lc-title">All Assessments</div>
            <div class="lc-desc">See all career assessment tools available across different life stages</div>
          </div>
        </a>
        <a href="/career-skills-compass" class="link-card">
          <div class="lc-icon">&#128269;</div>
          <div>
            <div class="lc-title">Career & Skills Compass</div>
            <div class="lc-desc">Explore which high-value skills match your thinking style and career direction</div>
          </div>
        </a>
        <a href="/career-resources" class="link-card">
          <div class="lc-icon">&#128218;</div>
          <div>
            <div class="lc-title">Career Resources</div>
            <div class="lc-desc">Free guides, articles, and tools to help you make better career decisions</div>
          </div>
        </a>
        <a href="/services" class="link-card">
          <div class="lc-icon">&#9881;&#65039;</div>
          <div>
            <div class="lc-title">Career Guidance and Assessments</div>
            <div class="lc-desc">See career guidance, assessments, and tools in one place.</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <AssessmentGuidanceCta mode="student" sectionId="guidance-bridge" />

  <GuidancePlansSection
    sectionId="plans"
    audience={plansConfig.audience}
    serviceLabel={plansConfig.serviceLabel}
    title={plansConfig.sectionTitle}
  />

  <AssessmentReportTools
    title="Class 10 and Below Career Assessment Report"
    fileName="class-10-career-assessment-report.pdf"
    reportKicker="STUDENT CAREER DISCOVERY REPORT"
    guidanceLabel="Explore Student Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-counselling-for-class-10-students/"
  />
  <Footer />
</BaseLayout>

<!-- ═══════════════════════════════════════════
     QUIZ ENGINE
═══════════════════════════════════════════ -->
<script is:inline define:vars={{ guidanceResultsHref, guidanceResultsLabel }}>
/* ─────────────────────────────────────────────
   SCORE DIMENSIONS
   RIASEC: R, I, A, S, E, C
   Multiple Intelligence: lin, log, spa, bk, inter, intra, mus, nat
   Aptitude signals: num, ver, lgc
   Learning style: vis, aud, kin
   Stream: pcm, pcb, com, hum
───────────────────────────────────────────── */
const scores = { R:0,I:0,A:0,S:0,E:0,C:0, lin:0,log:0,spa:0,bk:0,inter:0,intra:0,mus:0,nat:0, num:0,ver:0,lgc:0, vis:0,aud:0,kin:0, pcm:0,pcb:0,com:0,hum:0 };

/* ─────────────────────────────────────────────
   QUESTIONS (25)
   Each option scores 2–4 dimensions
───────────────────────────────────────────── */
const QUESTIONS = [
  {
    q: "When you have free time, what do you like to do? (Pick all that you like)",
    multiselect: true,
    opts: [
      { t: "Play sports, explore outside, or build things with my hands", s: {R:3,bk:2,kin:1,nat:1} },
      { t: "Draw, write, make music, or do crafts", s: {A:3,lin:1,spa:1,mus:1} },
      { t: "Spend time with friends - talking, helping, playing together", s: {S:3,inter:2} },
      { t: "Solve puzzles, read about new things, or learn something new", s: {I:3,log:1,intra:1} },
    ]
  },
  {
    q: "Which school subjects do you enjoy? (Pick all that you like)",
    multiselect: true,
    opts: [
      { t: "Maths or Science (Physics or Chemistry)", s: {I:2,C:1,log:2,num:2,pcm:2} },
      { t: "English, Hindi, or language subjects", s: {A:2,lin:2,ver:2,hum:1} },
      { t: "History, Civics, or Social Studies", s: {S:2,inter:1,hum:2,ver:1} },
      { t: "Art, Music, or Sports", s: {A:2,R:1,spa:1,mus:1,bk:1,hum:1} },
    ]
  },
  {
    q: "Your school is making an event. Which job would you like to do?",
    opts: [
      { t: "Build and set up - stage, lights, equipment, or displays", s: {R:3,bk:1,kin:2} },
      { t: "Make posters, decorate, design, or perform on stage", s: {A:3,spa:2,vis:1} },
      { t: "Host the event, announce things, or talk to the audience", s: {E:2,S:1,lin:1,aud:1} },
      { t: "Plan the schedule and make sure everything works right", s: {C:3,log:1,lgc:1} },
    ]
  },
  {
    q: "When something breaks at home, what do you do?",
    opts: [
      { t: "Open it and try to fix it - you want to know how it works", s: {R:3,I:1,kin:1,lgc:1} },
      { t: "Learn how it works first, then fix it step by step", s: {I:3,log:1,lgc:2,num:1} },
      { t: "Ask someone else to fix it - you like helping people work together", s: {S:2,E:1,inter:2} },
      { t: "Don't worry about it - fixing broken things is not for me", s: {A:1,intra:2} },
    ]
  },
  {
    q: "Which one sounds like you?",
    opts: [
      { t: "I like numbers and patterns - I notice when things are wrong", s: {I:2,C:2,log:2,num:2,lgc:1} },
      { t: "I like words and stories - I can say my ideas clearly and nicely", s: {A:3,lin:2,ver:2} },
      { t: "I like people - I know what others feel without them saying", s: {S:3,inter:3} },
      { t: "I like making things - when I think of something, I need to build or draw it", s: {R:2,A:1,bk:1,spa:1,kin:1} },
    ]
  },
  {
    q: "What activities do you really enjoy and forget about time? (Pick all that you like)",
    multiselect: true,
    opts: [
      { t: "Reading about science, history, or how things are made", s: {I:3,lin:1,intra:1,ver:1} },
      { t: "Drawing, writing, making music, or doing crafts", s: {A:3,spa:1,mus:2,lin:1} },
      { t: "Talking with friends you like and care about", s: {S:3,inter:2,aud:1} },
      { t: "Sports, challenges, or exploring outside", s: {R:3,bk:2,kin:2,nat:1} },
    ]
  },
  {
