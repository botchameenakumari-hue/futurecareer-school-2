  .btn-back { display: inline-flex; align-items: center; gap: 6px; background: transparent; border: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.55); font-size: 13px; font-weight: 600; padding: 9px 16px; border-radius: 8px; cursor: pointer; font-family: inherit; transition: .18s; }
  .btn-back:disabled { opacity: .3; cursor: not-allowed; }
  .btn-back:not(:disabled):hover { border-color: rgba(255,255,255,.28); color: rgba(255,255,255,.8); }
  .btn-next { display: inline-flex; align-items: center; gap: 7px; background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a); color: #0a0f1e; font-size: 14px; font-weight: 800; padding: 11px 22px; border-radius: 9px; border: none; cursor: pointer; font-family: inherit; transition: opacity .18s, transform .18s; }
  .btn-next:disabled { opacity: .4; cursor: not-allowed; }
  .btn-next:not(:disabled):hover { opacity: .9; transform: translateY(-1px); }

  /* ── RESULTS CONTAINER ── */
  .results-box { max-width: 820px; margin: 0 auto; text-align: left; }

  /* ── RESULT HEADER ── */
  .res-header { display: flex; align-items: flex-start; gap: 1.5rem; background: linear-gradient(135deg, rgba(255,255,255,.04), rgba(255,255,255,.015)); border: 2px solid rgba(255,255,255,.1); border-radius: 20px; padding: 1.75rem 2rem; margin-bottom: 1.25rem; }
  .res-hero-left { display: flex; flex-direction: column; align-items: center; gap: .75rem; flex-shrink: 0; }
  .res-emoji-wrap { width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center; }
  .res-emoji { font-size: 2.5rem; line-height: 1; }
  .res-code-badge { display: inline-block; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 8px; letter-spacing: .05em; white-space: nowrap; }
  .res-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.45); margin-bottom: .4rem; }
  .res-title { font-size: clamp(1.6rem, 3.5vw, 2.3rem); font-weight: 800; line-height: 1.1; margin-bottom: .45rem; }
  .res-secondary-badge { display: inline-block; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.65); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); padding: 4px 12px; border-radius: 8px; margin-bottom: .6rem; }
  .res-tagline { font-size: 15px; color: rgba(255,255,255,.68); line-height: 1.6; }

  /* ── RESULT SECTIONS ── */
  .res-section { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 1.5rem 1.6rem; margin-bottom: 1.1rem; }
  .res-section-header { display: flex; align-items: center; gap: .75rem; margin-bottom: .9rem; }
  .res-section-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; line-height: 1; }
  .res-section-header h3 { font-size: 16px; font-weight: 800; color: #fff; }
  .res-section-note { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 1rem; line-height: 1.65; }

  /* RIASEC bars */
  .riasec-bars { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1rem; }
  .rb-row { display: flex; align-items: center; gap: .75rem; }
  .rb-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .rb-label { display: flex; align-items: center; gap: .45rem; font-size: 12.5px; color: rgba(255,255,255,.7); min-width: 170px; flex-shrink: 0; }
  .rb-track { flex: 1; height: 9px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .rb-fill { height: 100%; border-radius: 999px; transition: width .7s cubic-bezier(.22,.68,0,1.2); }
  .rb-pct { font-size: 12px; font-weight: 700; min-width: 34px; text-align: right; }
  .riasec-legend { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem .75rem; font-size: 12px; color: rgba(255,255,255,.45); }
  .legend-item span { font-weight: 800; }

  /* Two-col layout */
  .res-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.1rem; }

  /* Profile cards */
  .res-profile-card { border: 1px solid rgba(255,255,255,.1); border-radius: 16px; overflow: hidden; }
  .rpc-head { display: flex; align-items: center; gap: .9rem; padding: 1rem 1.25rem; }
  .rpc-emoji { font-size: 1.8rem; line-height: 1; flex-shrink: 0; }
  .rpc-type-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .2rem; }
  .rpc-type-name { font-size: 15px; font-weight: 800; color: #fff; }
  .rpc-desc { font-size: 13.5px; line-height: 1.7; color: rgba(255,255,255,.65); padding: 1rem 1.25rem .75rem; }
  .rpc-strengths-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: rgba(255,255,255,.45); padding: 0 1.25rem .5rem; }
  .rpc-strengths { list-style: none; display: flex; flex-direction: column; gap: .45rem; padding: 0 1.25rem 1.25rem; }
  .rpc-strengths li { display: flex; align-items: flex-start; gap: .5rem; font-size: 13px; color: rgba(255,255,255,.7); line-height: 1.55; }
  .check-icon { color: var(--teal,#2dd4bf); font-weight: 700; font-size: 12px; flex-shrink: 0; margin-top: 2px; }
  .rpc-combo-note { font-size: 13px; line-height: 1.68; color: rgba(255,255,255,.6); padding: 0 1.25rem 1.25rem; }

  /* Stream section */
  .res-stream-section { border-left: 4px solid var(--teal,#2dd4bf); }
  .stream-primary-block { margin-bottom: 1.1rem; }
  .stream-main-badge { display: inline-block; font-size: 14px; font-weight: 800; padding: 7px 16px; border-radius: 10px; margin-bottom: .65rem; }
  .stream-subjs { font-size: 13px; font-weight: 600; color: rgba(255,255,255,.5); margin-bottom: .75rem; letter-spacing: .02em; }
  .stream-reason { font-size: 14.5px; color: rgba(255,255,255,.78); line-height: 1.68; margin-bottom: .5rem; }
  .stream-opens { font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.6; }
  .stream-alt-block { border-top: 1px solid rgba(255,255,255,.07); padding-top: .9rem; }
  .stream-alt-label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: rgba(255,255,255,.4); margin-bottom: .45rem; }
  .stream-alt-badge { display: inline-block; font-size: 13px; font-weight: 700; padding: 5px 14px; border-radius: 8px; margin-bottom: .55rem; }
  .stream-alt-note { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.65; }

  /* MI */
  .mi-badge { display: inline-block; font-size: 13px; font-weight: 800; padding: 5px 14px; border-radius: 8px; margin-bottom: .75rem; }
  .mi-desc { font-size: 13.5px; line-height: 1.7; color: rgba(255,255,255,.65); margin-bottom: .9rem; }
  .mi-tip-box { padding: .75rem 1rem; border-radius: 0 8px 8px 0; background: rgba(255,255,255,.03); margin-bottom: .75rem; }
  .mi-tip-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.4); margin-bottom: .3rem; }
  .mi-tip { font-size: 13px; color: rgba(255,255,255,.7); line-height: 1.65; }
  .mi-secondary { font-size: 12.5px; color: rgba(255,255,255,.45); }
  .mi-sec-label { font-weight: 700; color: rgba(255,255,255,.35); }

  /* Learning style */
  .ls-badge { display: inline-block; font-size: 13px; font-weight: 800; padding: 5px 14px; border-radius: 8px; margin-bottom: .75rem; }
  .ls-tip-box { padding: .75rem 1rem; border-radius: 0 8px 8px 0; background: rgba(255,255,255,.03); }
  .ls-tip { font-size: 13px; color: rgba(255,255,255,.7); line-height: 1.65; }

  /* Aptitude bars */
  .apt-bars { display: flex; flex-direction: column; gap: .7rem; }
  .apt-row { display: flex; flex-direction: column; gap: .35rem; }
  .apt-label { display: flex; align-items: center; gap: .5rem; font-size: 13px; color: rgba(255,255,255,.7); }
  .apt-level { font-size: 11.5px; font-weight: 700; }
  .apt-track { height: 8px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .apt-fill { height: 100%; border-radius: 999px; transition: width .7s ease; }

  /* Careers */
  .res-careers { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: .55rem .9rem; }
  .res-careers li { display: flex; align-items: flex-start; gap: .5rem; font-size: 13.5px; color: rgba(255,255,255,.72); line-height: 1.5; }
  .career-arr { color: var(--gold,#e5b84a); font-weight: 700; font-size: 12px; flex-shrink: 0; margin-top: 2px; }

  /* Start now */
  .res-start { list-style: none; display: flex; flex-direction: column; gap: .7rem; }
  .res-start li { font-size: 14px; color: rgba(255,255,255,.72); padding-left: 1.5rem; position: relative; line-height: 1.65; }
  .res-start li::before { content: '→'; position: absolute; left: 0; color: var(--teal,#2dd4bf); font-weight: 700; font-size: 12px; top: 3px; }

  /* Guidance CTA */
  .res-guidance { background: linear-gradient(135deg, rgba(229,184,74,.07), rgba(229,184,74,.02)); border: 1px solid rgba(229,184,74,.25); border-radius: 18px; padding: 1.75rem 2rem; text-align: center; }
  .rg-icon-row { font-size: 2rem; margin-bottom: .75rem; letter-spacing: .25rem; }
  .rg-title { font-size: 17px; font-weight: 800; color: #fff; margin-bottom: .65rem; }
  .rg-body { font-size: 14.5px; line-height: 1.75; color: rgba(255,255,255,.7); max-width: 580px; margin: 0 auto 1.4rem; }
  .rg-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; margin-bottom: .9rem; }
  .rg-note { font-size: 12.5px; color: rgba(255,255,255,.4); }

  /* ── FAQ ── */
  #faq { padding: 5.5rem 0; text-align: center; }
  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: .65rem; text-align: left; }
  .faq-item { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.09); border-radius: 12px; overflow: hidden; }
  .faq-q { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 1.35rem; font-size: 14.5px; font-weight: 700; color: rgba(255,255,255,.85); cursor: pointer; list-style: none; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-arr { flex-shrink: 0; transition: transform .26s; color: rgba(255,255,255,.4); }
  details[open] .faq-arr { transform: rotate(180deg); }
  .faq-a { padding: .85rem 1.35rem 1.2rem; font-size: 14px; line-height: 1.73; color: rgba(255,255,255,.62); border-top: 1px solid rgba(255,255,255,.07); }

  /* ── NEXT STEPS ── */
  #next-steps { padding: 5.5rem 0; text-align: center; }
  .links-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: left; }
  .link-card { display: flex; align-items: flex-start; gap: .9rem; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.09); border-radius: 13px; padding: 1.2rem; text-decoration: none; transition: border-color .18s, background .18s; }
  .link-card:hover { border-color: rgba(229,184,74,.35); background: rgba(255,255,255,.05); }
  .lc-icon { font-size: 1.4rem; flex-shrink: 0; line-height: 1; margin-top: .1rem; }
  .lc-title { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: .3rem; }
  .lc-desc { font-size: 12.5px; line-height: 1.55; color: rgba(255,255,255,.5); }

  /* ── FINAL CTA ── */
  #final-cta { padding: 6rem 0 7rem; text-align: center; }
  .cta-inner { position: relative; z-index: 1; }
  .cta-pill { display: inline-flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); padding: 6px 14px; border-radius: 999px; margin-bottom: 1.5rem; }
  .cta-headline { font-size: clamp(1.9rem, 4.2vw, 2.8rem); font-weight: 800; line-height: 1.12; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; }
  .cta-sub { font-size: 15.5px; line-height: 1.75; color: rgba(255,255,255,.56); max-width: 640px; margin: 0 auto 2rem; }
  .cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .85rem; margin-bottom: 1rem; }
  .cta-note { font-size: 12.5px; color: rgba(255,255,255,.38); }

  /* Flow state */
  .fs-main-card { padding: 1rem 1.2rem; border-radius: 0 12px 12px 0; margin-bottom: .9rem; }
  .fs-title { font-size: 16px; font-weight: 800; margin-bottom: .5rem; }
  .fs-desc { font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.7; margin-bottom: .7rem; }
  .fs-jobs-row { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; font-size: 12.5px; }
  .fs-jobs-label { font-weight: 700; color: rgba(255,255,255,.5); flex-shrink: 0; }
  .fs-jobs { color: rgba(255,255,255,.65); }
  .fs-insight-box { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: .85rem 1rem; }
  .fs-insight-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.4); margin-bottom: .4rem; }
  .fs-insight-box p { font-size: 13.5px; color: rgba(255,255,255,.65); line-height: 1.7; }

  /* Skill roadmap */
  .roadmap-phases { display: flex; flex-direction: column; gap: .7rem; margin-bottom: .9rem; }
  .rp-phase { padding: .9rem 1.1rem; border-radius: 12px; }
  .rp-free    { background: rgba(45,212,191,.06);  border: 1px solid rgba(45,212,191,.2); }
  .rp-taste   { background: rgba(229,184,74,.06);  border: 1px solid rgba(229,184,74,.2); }
  .rp-commit  { background: rgba(99,102,241,.06);  border: 1px solid rgba(99,102,241,.2); }
  .rp-tag { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .4rem; }
  .rp-free .rp-tag   { color: #2dd4bf; }
  .rp-taste .rp-tag  { color: #e5b84a; }
  .rp-commit .rp-tag { color: #818cf8; }
  .rp-phase p { font-size: 13.5px; color: rgba(255,255,255,.7); line-height: 1.7; }
  .rp-endurance-box { background: rgba(99,102,241,.08); border: 1px solid rgba(99,102,241,.25); border-radius: 10px; padding: .8rem 1rem; font-size: 13.5px; color: rgba(255,255,255,.7); line-height: 1.65; }

  /* AI readiness */
  .air-rating-badge { display: inline-block; font-size: 14px; font-weight: 800; padding: 6px 16px; border-radius: 10px; margin-bottom: .9rem; }
  .air-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-bottom: .85rem; }
  .air-card { padding: .85rem 1rem; border-radius: 12px; font-size: 13.5px; line-height: 1.65; }
  .air-green { background: rgba(16,185,129,.06);  border: 1px solid rgba(16,185,129,.2);  color: rgba(255,255,255,.7); }
  .air-blue  { background: rgba(99,102,241,.06);  border: 1px solid rgba(99,102,241,.2);  color: rgba(255,255,255,.7); }
  .air-card-title { font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.55); margin-bottom: .4rem; text-transform: uppercase; letter-spacing: .06em; }
  .air-action-box { padding: .8rem 1rem; border-radius: 0 10px 10px 0; font-size: 13.5px; color: rgba(255,255,255,.7); line-height: 1.65; margin-bottom: .75rem; }
  .air-risk-box { background: rgba(245,158,11,.06); border: 1px solid rgba(245,158,11,.2); border-radius: 10px; padding: .75rem 1rem; font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.65; margin-bottom: .9rem; }
  .air-4c-box { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 1rem 1.1rem; }
  .air-4c-title { font-size: 13px; font-weight: 800; color: rgba(255,255,255,.8); margin-bottom: .8rem; }
  .air-4c-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .6rem; margin-bottom: .65rem; }
  .air-4c-item { text-align: center; padding: .6rem .4rem; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07); border-radius: 10px; }
  .air-4c-icon { font-size: 1.2rem; display: block; margin-bottom: .3rem; }
  .air-4c-item strong { font-size: 12px; color: rgba(255,255,255,.8); display: block; margin-bottom: .2rem; }
  .air-4c-item p { font-size: 11px; color: rgba(255,255,255,.5); line-height: 1.5; }
  .air-4c-note { font-size: 12px; color: rgba(255,255,255,.42); text-align: center; font-style: italic; }

  /* Ambition profile */
  .ap-card { border-radius: 14px; padding: 1.1rem 1.3rem; margin-bottom: .85rem; }
  .ap-label { font-size: 17px; font-weight: 800; margin-bottom: .5rem; }
  .ap-desc { font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.7; }
  .ap-all-row { display: grid; grid-template-columns: repeat(3,1fr); gap: .65rem; }
  .ap-mini { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 11px; padding: .75rem .9rem; }
  .ap-mini-active { border-width: 2px; }
  .ap-mini-label { font-size: 13px; font-weight: 800; margin-bottom: .35rem; }
  .ap-mini p { font-size: 12px; color: rgba(255,255,255,.55); line-height: 1.6; }

  /* profile header extra */
  .res-combo-note { font-size: 13.5px; color: rgba(255,255,255,.6); line-height: 1.65; margin-top: .65rem; padding: .65rem 1rem; background: rgba(255,255,255,.03); border-radius: 8px; border-left: 3px solid rgba(255,255,255,.12); }

  /* RIASEC bars improved */
  .rb-fill { height: 100%; border-radius: 999px; transition: width .8s cubic-bezier(.22,.68,0,1.2); }
  .rb-track { flex: 1; height: 11px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .rb-pct { font-size: 13px; font-weight: 800; min-width: 38px; text-align: right; }

  /* Thinking style grid */
  .ts-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: .75rem; margin-bottom: 1rem; }
  .ts-card { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 1rem 1.1rem; transition: border-color .18s; }
  .ts-active { border-width: 2px; }
  .ts-emoji { font-size: 1.6rem; margin-bottom: .4rem; line-height: 1; }
  .ts-name { font-size: 13.5px; font-weight: 800; color: rgba(255,255,255,.85); margin-bottom: .35rem; display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .ts-me { font-size: 10px; font-weight: 700; background: var(--gold,#e5b84a); color: #0a0f1e; padding: 2px 7px; border-radius: 999px; letter-spacing: .05em; }
  .ts-desc { font-size: 12.5px; color: rgba(255,255,255,.55); line-height: 1.6; }
  .ts-summary-box { padding: .85rem 1.1rem; border-radius: 0 10px 10px 0; font-size: 13.5px; color: rgba(255,255,255,.7); line-height: 1.65; }

  /* Biology check sliders */
  .bio-sliders { display: flex; flex-direction: column; gap: 1.1rem; margin-bottom: .9rem; }
  .bio-row { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07); border-radius: 12px; padding: .9rem 1rem; }
  .bio-labels { display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; margin-bottom: .5rem; }
  .bio-track { display: flex; height: 12px; border-radius: 999px; overflow: hidden; margin-bottom: .35rem; }
  .bio-fill-left  { height: 100%; transition: width .8s ease; }
  .bio-fill-right { height: 100%; transition: width .8s ease; }
  .bio-pct-row { display: flex; justify-content: space-between; font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.45); }
  .bio-note { font-size: 12.5px; color: rgba(255,255,255,.4); line-height: 1.6; font-style: italic; }

  /* Stream compare cards */
  .sc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; margin-bottom: 1rem; }
  .sc-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; overflow: hidden; transition: border-color .18s; }
  .sc-top { border-width: 2px; }
  .sc-head { padding: .75rem 1rem; background: rgba(255,255,255,.03); display: flex; justify-content: space-between; align-items: center; }
  .sc-name { font-size: 14px; font-weight: 800; color: rgba(255,255,255,.8); }
  .sc-stars { font-size: 16px; letter-spacing: .05em; }
  .sc-body { padding: .75rem 1rem 1rem; }
  .sc-pct-row { height: 6px; background: rgba(255,255,255,.06); border-radius: 999px; overflow: hidden; margin-bottom: .3rem; }
  .sc-pct-bar { height: 100%; border-radius: 999px; transition: width .8s ease; }
  .sc-pct-label { font-size: 11px; font-weight: 700; margin-bottom: .55rem; }
  .sc-subjs { font-size: 12px; color: rgba(255,255,255,.45); margin-bottom: .4rem; line-height: 1.55; }
  .sc-note { font-size: 12px; color: rgba(255,255,255,.5); line-height: 1.6; }
