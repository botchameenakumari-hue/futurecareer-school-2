    strength = 'You naturally love solving problems step-by-step and understanding how things work. This is perfect for STEM careers.';
    caution = 'Remember to also practice explaining your ideas clearly — even brilliant thinkers need to communicate.';
  } else if (riasecPrimary === 'I' && scores.num > scores.lgc) {
    interaction = 'Quantitative Mind';
    strength = 'You\'re comfortable with numbers and patterns. Math, data, and systems make sense to you naturally.';
    caution = 'Don\'t neglect creative and communication skills — they\'ll make your analytical abilities even more valuable.';
  } else if (riasecPrimary === 'A') {
    interaction = 'Creative Thinker';
    strength = 'You see the world through aesthetics and imagination. Creating, designing, and expressing ideas is where you come alive.';
    caution = 'Creative careers are rewarding but require business skills too. Plan how you\'ll sustain yourself while building your craft.';
  } else if (riasecPrimary === 'S') {
