  }

  .final-inner strong { color: var(--gold); }
  .final-inner .hero-actions { justify-content: center; }



  #assessment-browser { padding: 5.8rem 0; background: rgba(255,255,255,.012); border-top: 1px solid rgba(255,255,255,.06); border-bottom: 1px solid rgba(255,255,255,.06); }
  .assessment-browser-head { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-bottom: 1.25rem; }
  .assessment-count { min-width: 118px; text-align: right; font-size: 13px; color: rgba(255,255,255,.58); }
  .assessment-count span { color: var(--gold); font-weight: 800; }
  .assessment-controls { display: grid; grid-template-columns: minmax(240px, 1.4fr) repeat(4, minmax(142px, 1fr)) auto; gap: .7rem; align-items: end; margin-bottom: 1.1rem; }
  .assessment-control { display: grid; gap: .35rem; min-width: 0; }
  .assessment-control span { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .assessment-control input,
  .assessment-control select { width: 100%; min-height: 44px; border-radius: 8px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.045); color: rgba(255,255,255,.88); padding: 0 .8rem; }
  .assessment-clear,
  .assessment-page-button { min-height: 44px; border-radius: 8px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); color: rgba(255,255,255,.82); font-weight: 800; padding: 0 .9rem; cursor: pointer; }
  .assessment-browser-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .assessment-card { padding: 1.05rem; min-height: 100%; }
  .assessment-card[hidden] { display: none; }
  .assessment-card__meta { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .65rem; }
  .assessment-card__meta span { font-size: 10.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.62); border: 1px solid rgba(255,255,255,.1); border-radius: 999px; padding: .32rem .5rem; }
  .assessment-card h3 { font-size: 1rem; line-height: 1.25; margin: 0 0 .55rem; }
  .assessment-card h3 a { color: rgba(255,255,255,.94); }
  .assessment-card p { margin: 0 0 .85rem; font-size: 13px; line-height: 1.58; color: rgba(255,255,255,.58); }
  .assessment-card__link { font-size: 12.5px; font-weight: 800; color: var(--gold); }
  .assessment-empty { display: grid; gap: .25rem; text-align: center; padding: 1.4rem; border: 1px solid rgba(255,255,255,.1); border-radius: 8px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.62); }
  .assessment-empty[hidden] { display: none; }
  .assessment-pagination { display: flex; justify-content: center; align-items: center; gap: .9rem; margin-top: 1.2rem; }
  .assessment-page-button:disabled { opacity: .42; cursor: not-allowed; }
