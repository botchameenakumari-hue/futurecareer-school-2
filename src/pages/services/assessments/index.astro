  /* Live assessment badge and CTA */
  .track-card--live { border-color: rgba(229,184,74,.28); }
  .track-live-badge { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: rgba(45,212,191,.9); background: rgba(45,212,191,.08); border: 1px solid rgba(45,212,191,.22); padding: 4px 10px; border-radius: 999px; margin-bottom: .75rem; }
  .track-cta { display: inline-flex; align-items: center; gap: 7px; margin-top: .85rem; font-size: 13px; font-weight: 700; color: #0a0f1e; background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a); padding: 9px 18px; border-radius: 8px; text-decoration: none; transition: opacity .18s; }
  .track-cta:hover { opacity: .88; }

  .named-tests-inner { padding: 2rem; border-color: rgba(229,184,74,.2); background: linear-gradient(135deg, rgba(229,184,74,.05), rgba(255,255,255,.02)); }
  .name-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .name-list a {
    display: block;
    font-size: 13px;
