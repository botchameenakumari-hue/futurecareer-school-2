  @media (max-width: 1120px) {
    .assessment-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .assessment-start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .assessment-control--search { grid-column: 1 / -1; }
    .assessment-browser-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .assessment-browser-head { display: grid; align-items: start; }
    .assessment-count { text-align: left; }
    .assessment-start-head { display: grid; align-items: start; }
    .assessment-start-grid { grid-template-columns: 1fr; }
    .assessment-controls,
    .assessment-browser-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 920px) {
    .track-grid { grid-template-columns: 1fr; }
    .name-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    #hero { padding: 118px 0 70px; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn-gold,
    .hero-actions .btn-outline { justify-content: center; }
  }
  @media (max-width: 520px) {
    #assessment-topic-clusters,
    #assessment-tracks,
    #named-tests,
    #final-cta { padding: 4.6rem 0; }
    .track-card { padding: 1.25rem 1rem; }
    .named-tests-inner { padding: 1.25rem 1rem; }
    .name-list a { padding: .68rem .72rem; }
    .hero-sub,
    .section-sub { font-size: 14.5px; line-height: 1.72; }
  }

</style>

<script>
  const assessmentBrowser = document.querySelector('[data-assessment-browser]');

  if (assessmentBrowser) {
    const normalize = (value) => (value || '').toString().trim().toLowerCase();
    const cards = Array.from(assessmentBrowser.querySelectorAll('[data-assessment-card]'));
    const searchInput = assessmentBrowser.querySelector('#assessment-search');
    const audienceSelect = assessmentBrowser.querySelector('#assessment-audience');
    const typeSelect = assessmentBrowser.querySelector('#assessment-type');
    const sortSelect = assessmentBrowser.querySelector('#assessment-sort');
    const pageSizeSelect = assessmentBrowser.querySelector('#assessment-page-size');
    const clearButton = assessmentBrowser.querySelector('[data-assessment-clear]');
    const visibleCount = assessmentBrowser.querySelector('[data-assessment-visible-count]');
    const emptyState = assessmentBrowser.querySelector('[data-assessment-empty]');
    const pagination = assessmentBrowser.querySelector('[data-assessment-pagination]');
    const prevButton = assessmentBrowser.querySelector('[data-assessment-prev]');
    const nextButton = assessmentBrowser.querySelector('[data-assessment-next]');
    const pageStatus = assessmentBrowser.querySelector('[data-assessment-page-status]');
    const presetButtons = Array.from(document.querySelectorAll('[data-assessment-preset]'));
    let currentPage = 1;

    const sortCards = (items) => {
      const sortValue = sortSelect.value;
      return [...items].sort((a, b) => {
        if (sortValue === 'az') return a.dataset.title.localeCompare(b.dataset.title);
        if (sortValue === 'students') {
          const aScore = a.dataset.audiences.includes('students') ? 0 : 1;
          const bScore = b.dataset.audiences.includes('students') ? 0 : 1;
          return aScore - bScore || Number(a.dataset.order) - Number(b.dataset.order);
        }
        if (sortValue === 'professionals') {
          const aScore = a.dataset.audiences.includes('professionals') ? 0 : 1;
          const bScore = b.dataset.audiences.includes('professionals') ? 0 : 1;
          return aScore - bScore || Number(a.dataset.order) - Number(b.dataset.order);
        }
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
    };

    const applyFilters = () => {
      const query = normalize(searchInput.value);
      const audience = audienceSelect.value;
      const type = typeSelect.value;
      const pageSize = Number(pageSizeSelect.value) || 12;
      const matches = cards.filter((card) => {
        const searchMatches = !query || normalize(card.dataset.search).includes(query);
        const audienceMatches = audience === 'all' || card.dataset.audiences.split(' ').includes(audience);
        const typeMatches = type === 'all' || card.dataset.type === type;
        return searchMatches && audienceMatches && typeMatches;
      });
      const sorted = sortCards(matches);
      const totalPages = Math.max(1, Math.ceil(sorted.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const start = (currentPage - 1) * pageSize;
      const visibleSet = new Set(sorted.slice(start, start + pageSize));
      cards.forEach((card) => { card.hidden = !visibleSet.has(card); });
      visibleCount.textContent = String(sorted.length);
      emptyState.hidden = sorted.length !== 0;
      pagination.hidden = sorted.length <= pageSize;
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;
      pageStatus.textContent = `Page ${currentPage} of ${totalPages}`;
    };

    const resetToFirstPage = () => { currentPage = 1; applyFilters(); };
    [searchInput, audienceSelect, typeSelect, sortSelect, pageSizeSelect].forEach((control) => {
      control.addEventListener('input', resetToFirstPage);
      control.addEventListener('change', resetToFirstPage);
    });
    presetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        searchInput.value = '';
        audienceSelect.value = button.dataset.audience || 'all';
        typeSelect.value = button.dataset.type || 'all';
        sortSelect.value = button.dataset.audience === 'professionals' ? 'professionals' : 'recommended';
        currentPage = 1;
        applyFilters();
        assessmentBrowser.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      audienceSelect.value = 'all';
      typeSelect.value = 'all';
      sortSelect.value = 'recommended';
      pageSizeSelect.value = '12';
      resetToFirstPage();
    });
    prevButton.addEventListener('click', () => { currentPage -= 1; applyFilters(); assessmentBrowser.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    nextButton.addEventListener('click', () => { currentPage += 1; applyFilters(); assessmentBrowser.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    applyFilters();
  }
</script>



