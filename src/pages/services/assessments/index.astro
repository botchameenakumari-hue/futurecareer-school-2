      'A free 24-question test for students, job seekers, and professionals with six domain scores, evidence and language diagnostics, timing analysis, worked explanations, and a detailed PDF report.',
    note: 'Free, no sign-up, audience-specific interpretation, practical diagnostics, and a focused improvement plan',
  },
  {
    href: '/services/assessments/placement-aptitude-test/',
    title: 'Placement Aptitude Test',
    description:
      'A free 20-question aptitude test for jobs and placement preparation, covering numerical reasoning, logic, verbal ability, data interpretation, and workplace judgement.',
    note: 'Free, no sign-up, instant score, domain-wise readiness, explanations, and practice priorities',
  },
];

const personalityAndWorkStyleTests = [
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description:
      'A free original 40-statement Big Five career assessment with five trait scores, 20 facets, cross-trait career indicators, work-environment hypotheses, practical experiments, and a detailed PDF report.',
    note: 'Free, no sign-up, all audiences, balanced reverse scoring, audience-specific interpretation, and no claim that personality determines career fit',
  },
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Career Preference Type Test',
    description:
      'A free independent 32-question Myers Briggs career test alternative with four preference pairs, preference strength, context sensitivity, work-environment implications, career experiments, and a detailed PDF report.',
    note: 'Original questions, no sign-up, all audiences, balanced-dimension reporting, and no claim that a type determines career fit',
  },
  {
    href: '/services/assessments/personality-test-for-career/',
    title: 'Personality Test for Career',
    description:
      'Use the broader personality-for-career guide when you want to understand how work-style clues should connect with interests, readiness, and fuller career direction.',
    note: 'Links directly to both free personality frameworks and other relevant career assessments',
  },
];

const careerAssessmentPages = orderedAssessmentPages.filter((page) => page.hubGroup === 'career').map(
  (page) => ({
    href: `/services/assessments/${page.slug}/`,
    title: page.hubTitle,
    description: page.hubDescription.replace(/\bpages\b/gi, 'options').replace(/\bpage\b/gi, 'option'),
  }),
);

const skillAssessmentPages = orderedAssessmentPages.filter((page) => page.hubGroup === 'skill').map(
  (page) => ({
    href: `/services/assessments/${page.slug}/`,
    title: page.hubTitle,
    description: page.hubDescription.replace(/\bpages\b/gi, 'options').replace(/\bpage\b/gi, 'option'),
  }),
);

const assessmentAudienceOptions = [
  { value: 'all', label: 'All audiences' },
  { value: 'students', label: 'Students' },
  { value: 'graduates', label: 'Graduates' },
  { value: 'professionals', label: 'Working professionals' },
  { value: 'job-seekers', label: 'Job seekers' },
];

const assessmentTypeOptions = [
  { value: 'all', label: 'All assessment types' },
  { value: 'career', label: 'Career tests' },
  { value: 'aptitude', label: 'Aptitude and reasoning' },
  { value: 'personality', label: 'Personality and work style' },
  { value: 'stream', label: 'Stream selection' },
  { value: 'skill', label: 'Skill readiness' },
];

const assessmentSortOptions = [
  { value: 'recommended', label: 'Recommended' },
  { value: 'az', label: 'A-Z' },
  { value: 'students', label: 'Students first' },
  { value: 'professionals', label: 'Professionals first' },
];

const assessmentPageSizeOptions = [12, 24, 50];

const getAssessmentAudience = (page: (typeof ASSESSMENT_PAGES)[number]) => {
  const text = `${page.slug} ${page.hubTitle} ${page.hubDescription}`.toLowerCase();
  const audiences = new Set<string>();
  if (/class|school|student|teen|kid|10th|12th|stream/.test(text)) audiences.add('students');
  if (/college|graduate|fresher|placement|low cgpa/.test(text)) audiences.add('graduates');
  if (/adult|professional|career change|midlife|transition|working/.test(text)) audiences.add('professionals');
  if (/job|placement|interview|employability/.test(text)) audiences.add('job-seekers');
  if (audiences.size === 0) audiences.add('students');
  return Array.from(audiences);
};

const getAssessmentType = (page: (typeof ASSESSMENT_PAGES)[number]) => {
  const text = `${page.slug} ${page.hubTitle}`.toLowerCase();
  if (/aptitude|reasoning|placement|numerical|verbal/.test(text)) return 'aptitude';
  if (/personality|psychometric|myers|big-5|holland|riasec|interest/.test(text)) return 'personality';
  if (/stream|10th|12th/.test(text)) return 'stream';
  if (/skill|readiness|transition|ai/.test(text) || page.hubGroup === 'skill') return 'skill';
  return 'career';
};

const getAssessmentOptionLabel = (options: { value: string; label: string }[], value: string) =>
  options.find((option) => option.value === value)?.label ?? value;

const assessmentBrowseItems = orderedAssessmentPages.map((page, index) => {
  const audiences = getAssessmentAudience(page);
  const type = getAssessmentType(page);
  const title = page.hubTitle;
  const description = page.hubDescription.replace(/\bpages\b/gi, 'options').replace(/\bpage\b/gi, 'option');
  return {
    href: `/services/assessments/${page.slug}/`,
    title,
    description,
    type,
    typeLabel: getAssessmentOptionLabel(assessmentTypeOptions, type),
    audiences,
    audienceLabel: audiences.map((audience) => getAssessmentOptionLabel(assessmentAudienceOptions, audience)).join(', '),
    order: index,
    searchText: [title, description, page.slug, type, ...audiences].join(' ').toLowerCase(),
  };
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Career Assessment and Psychometric Tests | Future Career School',
    description: 'Explore free career assessments for students, graduates, job seekers, and professionals: psychometric, aptitude, placement, stream-selection, skill readiness, and career transition assessments.',
    url: 'https://futurecareerschool.com/services/assessments',
    inLanguage: 'en-IN',
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Are these career assessments free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. All assessments on Future Career School are completely free - no login, no payment, no sign-up required. You get instant results after completing the questions.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which test should a student take first?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Students usually start with a psychometric career test, then move to stream selection and aptitude mapping based on their class stage.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do graduates and professionals need different assessments?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Graduates and professionals need market-fit, employability, and career-transition focused assessments rather than only school-stage stream tests.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Career Assessment and Psychometric Tests for Students and Professionals | Future Career School"
  description="Explore free career assessments and psychometric tests by audience, including career aptitude, placement aptitude, stream selection, interest, personality, and job-readiness assessments."
  canonical="https://futurecareerschool.com/services/assessments"
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Assessments</span>
      </nav>
      <div class="pill">
        <span class="dot"></span>
        Career test and psychometric assessment hub
      </div>
      <h1>
        All Assessment Tracks for
        <span class="gold-text"> Career Decisions That Need Clarity</span>
      </h1>
      <p class="hero-sub">
        Career aptitude tests, psychometric assessments, stream selection tests, personality tests,
        skill readiness checks, and career transition evaluations - all designed to give you real
        clarity, not generic labels. Pick the track that matches where you are right now.
        Every assessment can be taken in English, Hindi, Telugu, Tamil, or Marathi.
      </p>
      <div class="hero-actions">
        <a href="#assessment-tracks" class="btn-gold pulse">Free career and skill assessments</a>
        <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
      </div>
    </div>
  </section>

  <section id="assessment-topic-clusters">
    <div class="container">
      <h2 class="section-title">Assessments Covering Every Career Decision Point</h2>
      <p class="section-sub">
        Whether you want a career aptitude test, psychometric test, personality assessment,
        stream selection test, or job readiness evaluation - it is here under one roof.
      </p>
      <div class="chip-grid">
        {assessmentTopicClusters.map((name) => <span class="chip">{name}</span>)}
      </div>
    </div>
  </section>

  <section id="assessment-start-points">
    <div class="container">
      <div class="assessment-start-head">
        <div>
          <h2 class="section-title section-title-left">Start with the situation closest to yours</h2>
          <p class="section-sub section-sub-left">
            If you do not know which test name to choose, use these starting points first. You can still browse every assessment below.
          </p>
        </div>
        <a class="assessment-start-browse" href="#assessment-browser">Browse all assessments</a>
      </div>
      <div class="assessment-start-grid">
        {assessmentStartCards.map((card) => (
          <article class="assessment-start-card card">
            <div class="assessment-start-label">{card.label}</div>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <div class="assessment-start-actions">
              <a href={card.href}>Open starting test</a>
              <button type="button" data-assessment-preset data-audience={card.browserAudience} data-type={card.browserType}>Filter list</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="assessment-tracks">
    <div class="container">
      <h2 class="section-title">Career Tests by Life Stage - Pick Where You Are</h2>
      <p class="section-sub">
        Each track combines multiple assessments into one experience - career interest tests,
        aptitude mapping, personality profiling, and stream or role recommendations built for your stage.
      </p>

      <div class="track-grid">
        {tracks.map((track) => (
          <article id={track.id} class={'track-card card' + (track.liveLink ? ' track-card--live' : '')}>
            {track.liveLink && <div class="track-live-badge">&#9679;&nbsp;100% Free and Live</div>}
            <h3>{track.title}</h3>
            <p>{track.summary}</p>
            <div class="subhead">Tests</div>
            <ul>
              {track.tests.map((testName) => <li>{testName}</li>)}
            </ul>
            <div class="subhead">Related Test Names</div>
            <div class="mini-chips">
              {track.relatedNames.map((name) => <span>{name}</span>)}
            </div>
            {track.liveLink && (
              <a href={track.liveLink} class="track-cta">
                {track.liveLinkLabel}
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>



  <section id="assessment-browser" data-assessment-browser>
    <div class="container">
      <div class="assessment-browser-head">
        <div>
          <h2 class="section-title section-title-left">Browse every free assessment</h2>
          <p class="section-sub section-sub-left">
            Search by keyword, filter by audience or assessment type, and choose how many assessment pages you want to see at once.
          </p>
        </div>
        <div class="assessment-count" aria-live="polite"><span data-assessment-visible-count>{assessmentBrowseItems.length}</span> shown</div>
      </div>

      <form class="assessment-controls" role="search" aria-label="Search and filter assessments">
        <label class="assessment-control assessment-control--search" for="assessment-search">
          <span>Search</span>
          <input id="assessment-search" type="search" placeholder="Search aptitude, psychometric, class 10, adults..." autocomplete="off" />
        </label>
        <label class="assessment-control" for="assessment-audience">
          <span>Audience</span>
          <select id="assessment-audience">
            {assessmentAudienceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label class="assessment-control" for="assessment-type">
          <span>Type</span>
          <select id="assessment-type">
            {assessmentTypeOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label class="assessment-control" for="assessment-sort">
          <span>Sort</span>
          <select id="assessment-sort">
            {assessmentSortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label class="assessment-control" for="assessment-page-size">
          <span>Per page</span>
          <select id="assessment-page-size">
            {assessmentPageSizeOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </label>
        <button type="button" class="assessment-clear" data-assessment-clear>Clear</button>
      </form>
      <div class="assessment-quick-filters" aria-label="Quick assessment filters">
        <span>Quick filters</span>
        {assessmentStartCards.map((card) => (
          <button type="button" data-assessment-preset data-audience={card.browserAudience} data-type={card.browserType}>{card.label}</button>
        ))}
      </div>

      <div class="assessment-browser-grid" data-assessment-grid>
        {assessmentBrowseItems.map((item) => (
          <article
            class="assessment-card card"
            data-assessment-card
            data-type={item.type}
            data-audiences={item.audiences.join(' ')}
            data-title={item.title.toLowerCase()}
            data-order={item.order}
            data-search={item.searchText}
          >
            <div class="assessment-card__meta">
              <span>{item.typeLabel}</span>
              <span>{item.audienceLabel}</span>
            </div>
            <h3><a href={item.href}>{item.title}</a></h3>
            <p>{item.description}</p>
            <a class="assessment-card__link" href={item.href}>Open assessment</a>
          </article>
        ))}
      </div>

      <div class="assessment-empty" data-assessment-empty hidden>
        <strong>No assessment pages match those filters.</strong>
        <span>Try a broader search, audience, or assessment type.</span>
      </div>

      <div class="assessment-pagination" data-assessment-pagination>
        <button type="button" class="assessment-page-button" data-assessment-prev>Previous</button>
        <span data-assessment-page-status>Page 1</span>
        <button type="button" class="assessment-page-button" data-assessment-next>Next</button>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="focused-tests-after-10th"
    title="Focused Free Tests for After 10th"
    subtitle="Quick free tests for students choosing a stream or checking strength-fit after Class 10."
    items={focusedTestsAfter10th}
    altBackground={true}
  />

  <LinkDirectorySection
    sectionId="focused-tests-after-12th"
    title="Focused Free Tests for After 12th"
    subtitle="Quick free tests for students comparing courses, directions, and aptitude-fit after Class 12."
    items={focusedTestsAfter12th}
  />

  <LinkDirectorySection
    sectionId="reasoning-and-placement-tests"
    sectionClass="assessment-featured-directory"
    title="Free Reasoning and Placement Tests"
    subtitle="Measure practical numerical or verbal reasoning, or check the wider aptitude areas used in placement and job screening preparation."
    items={reasoningAndPlacementTests}
    altBackground={true}
  />

  <LinkDirectorySection
    sectionId="personality-and-work-style-tests"
    sectionClass="assessment-featured-directory"
    title="Free Personality and Work-Style Tests"
    subtitle="Compare continuous Big Five traits with familiar work-style preference pairs without treating either framework as a fixed identity or career verdict."
    items={personalityAndWorkStyleTests}
  />

  <LinkDirectorySection
    sectionId="career-assessment-pages"
    title="More Free Career Assessment and Career Test Options"
    subtitle="Use these options when you want a broader career assessment, psychometric test, personality test, or student career test before choosing the right free assessment."
    items={careerAssessmentPages}
  />

  <LinkDirectorySection
    sectionId="skill-assessment-pages"
    title="More Free Skill Assessment and Career Transition Test Options"
    subtitle="Use these options when you want to check skill readiness, job fit, professional leverage, career transition, or AI-era career pressure."
    items={skillAssessmentPages}
  />

  <section id="named-tests">
    <div class="container card named-tests-inner">
      <div>
        <h2 class="section-title section-title-left">
          All Assessment Types You Can Take Here
        </h2>
        <p class="section-sub section-sub-left">
          Choose a standalone specialist assessment or a broader life-stage assessment depending on the decision you need to make.
        </p>
      </div>
      <div class="name-list">
        <a id="psychometric-career-test" href="/services/assessments/class-10-and-below/">Psychometric Career Test</a>
        <a id="career-aptitude-test" href="/services/assessments/class-11-to-12/">Career Aptitude Test</a>
        <a id="career-interest-test" href="/services/assessments/class-10-and-below/">Career Interest Test (RIASEC)</a>
        <a id="personality-test-for-career" href="/services/assessments/myers-briggs-career-test/">Career Preference Type Test</a>
        <a id="big-5-personality-test-careers" href="/services/assessments/big-5-personality-test-careers/">Big 5 Personality Test for Careers</a>
        <a id="stream-selection-test" href="/services/assessments/class-10-and-below/">Stream Selection Test</a>
        <a id="career-fit-framework" href="/services/assessments/graduates-and-early-professionals/">Career Fit Framework</a>
        <a id="skill-readiness-assessment" href="/services/assessments/graduates-and-early-professionals/">Skill Readiness Assessment</a>
        <a id="job-readiness-assessment" href="/services/assessments/graduates-and-early-professionals/">Job Readiness Assessment</a>
        <a id="placement-aptitude-test" href="/services/assessments/placement-aptitude-test/">Placement Aptitude Test</a>
        <a id="numerical-reasoning-test" href="/services/assessments/numerical-reasoning-test/">Numerical Reasoning Test</a>
        <a id="verbal-reasoning-test" href="/services/assessments/verbal-reasoning-test/">Verbal Reasoning Test</a>
        <a id="career-transition-test" href="/services/assessments/working-professionals-and-career-changers/">Career Transition Readiness Test</a>
        <a id="ai-career-readiness-test" href="/services/assessments/working-professionals-and-career-changers/">AI Career Readiness Test</a>
      </div>
    </div>
  </section>

  <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />

  <GuidancePlansSection
    sectionId="plans"
    audience={plansConfig.audience}
    serviceLabel={plansConfig.serviceLabel}
    title={plansConfig.sectionTitle}
  />

  <Footer />
</BaseLayout>

<style is:inline>
  section { position: relative; overflow: hidden; }
  .hero-inner { position: relative; z-index: 1; }
  #hero { padding: 138px 0 84px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .orb-gold { width: 480px; height: 480px; top: -120px; left: -60px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -10px; right: -80px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .breadcrumb { display: flex; gap: 8px; align-items: center; margin-bottom: 1.8rem; font-size: 13px; color: rgba(255,255,255,.38); }
  .breadcrumb a { color: rgba(255,255,255,.5); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }
  h1 { font-size: clamp(2.25rem, 5vw, 3.7rem); line-height: 1.06; letter-spacing: -.04em; margin-bottom: 1.15rem; max-width: 930px; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); line-height: 1.78; color: rgba(255,255,255,.58); max-width: 760px; margin: 1rem 0 2rem; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  #assessment-topic-clusters,
  #assessment-tracks,
  #named-tests { padding: 5.8rem 0; }
  #final-cta { padding: 5.8rem 0 6.8rem; text-align: center; }
  .section-title { font-size: clamp(1.95rem, 4.2vw, 3rem); line-height: 1.1; letter-spacing: -.03em; margin-bottom: .95rem; text-align: center; }
  .section-title-left { text-align: left; }
  .section-sub { font-size: 15px; line-height: 1.75; color: rgba(255,255,255,.55); max-width: 760px; margin: 0 auto 2.4rem; text-align: center; }
  .section-sub-left { text-align: left; margin-left: 0; }

  .chip-grid { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: center; }
  #assessment-start-points { padding: 4.8rem 0; background: rgba(255,255,255,.018); border-top: 1px solid rgba(255,255,255,.06); border-bottom: 1px solid rgba(255,255,255,.06); }
  .assessment-start-head { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-bottom: 1.4rem; }
  .assessment-start-browse { color: #e5b84a; font-weight: 800; white-space: nowrap; }
  .assessment-start-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .assessment-start-card { padding: 1.15rem; }
  .assessment-start-label { color: #2dd4bf; font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .45rem; }
  .assessment-start-card h3 { margin: 0 0 .55rem; font-size: 1.05rem; line-height: 1.25; color: #fff; }
  .assessment-start-card p { margin: 0; color: rgba(255,255,255,.72); font-size: 14px; line-height: 1.65; }
  .assessment-start-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .assessment-start-actions a,
  .assessment-start-actions button,
  .assessment-quick-filters button { border: 1px solid rgba(229,184,74,.32); background: rgba(229,184,74,.1); color: #f7d778; border-radius: 999px; padding: .55rem .75rem; font-weight: 800; font-size: 13px; cursor: pointer; }
  .assessment-start-actions button,
  .assessment-quick-filters button { font-family: inherit; }
  .assessment-quick-filters { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; margin: 0 0 1.1rem; color: rgba(255,255,255,.66); font-size: 13px; }
  .assessment-quick-filters span { font-weight: 900; text-transform: uppercase; letter-spacing: .04em; }
  .chip {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,.72);
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 999px;
    background: rgba(255,255,255,.03);
  }

  .track-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.15rem; }
  .track-card { padding: 1.6rem; }
  .track-card h3 { font-size: 1.18rem; margin-bottom: .55rem; }
  .track-card p { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.56); margin-bottom: 1rem; }
  .subhead { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: rgba(229,184,74,.7); margin: .8rem 0 .55rem; font-weight: 700; }
  .track-card ul { list-style: none; display: flex; flex-direction: column; gap: .48rem; margin-bottom: .9rem; }
