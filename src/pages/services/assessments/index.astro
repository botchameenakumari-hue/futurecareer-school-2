const orderedAssessmentPages = [...ASSESSMENT_PAGES].sort((a, b) => {
  const aIndex = assessmentPagePriority.indexOf(a.slug);
  const bIndex = assessmentPagePriority.indexOf(b.slug);
  const safeA = aIndex === -1 ? 999 : aIndex;
  const safeB = bIndex === -1 ? 999 : bIndex;
  return safeA - safeB;
});

