---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/vark-learning-style-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/emotional-intelligence-test-careers/',
    title: 'Emotional Intelligence Test for Careers',
    description: 'Use five emotional-skill scores when the question is workplace behaviour and relationships rather than how you learn best.',
  },
  {
    href: '/services/assessments/riasec-holland-code-career-test/',
    title: 'RIASEC Holland Code Career Test',
    description: 'Use six interest types and a three-letter Holland Code when the bigger question is which career families to investigate.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous personality traits and 20 facets for a broader behaviour-based profile beyond learning preferences.',
  },
  {
    href: '/services/assessments/entrepreneurial-aptitude-test/',
    title: 'Entrepreneurial Aptitude Test',
    description: 'Use five practical readiness scores when the real question is venture-building fit rather than how you learn best.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does VARK stand for?',
    a: 'VARK describes four learning-preference channels: Visual (diagrams and images), Auditory (listening and discussion), Read/Write (text-based learning), and Kinesthetic (hands-on practice). Most people show a blend rather than one pure style.',
  },
  {
    q: 'Is this the official VARK questionnaire?',
    a: 'No. This is an independent, original 24-statement assessment from Future Career School inspired by VARK theory. It is not the official VARK questionnaire and is not affiliated with or endorsed by its creator or publisher.',
  },
  {
    q: 'How is my learning-style blend calculated?',
    a: 'You rate 24 learning situations across the four VARK channels (six per channel). Each channel gets a 0-100 score, and your top two, in order, form your reported learning-style blend.',
  },
  {
    q: 'Does research fully support fixed learning styles?',
    a: 'Learning-style preferences can be a genuinely useful, motivating way to study, but research on matching teaching methods strictly to a fixed style is mixed. Treat your result as a preference to experiment with, not a rule about how you are able to learn.',
  },
  {
    q: 'Can my learning style change?',
    a: 'Yes. Preferences can shift with subject, context, and practice. Many people also learn best from a mix of methods rather than one channel alone, especially for complex or unfamiliar material.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all four channel scores, your learning-style blend, study strategies, career-environment notes, and all 24 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'VARK Learning Style Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free VARK Learning Style Test',
    alternateName: 'VARK Study Style Test',
    description: 'A free original 24-statement VARK-style learning-preference assessment with four channel scores, a learning-style blend, study strategies, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="VARK Learning Style Test | Free Study Style Test"
  description="Take a free VARK-style learning style test. Get all four channel scores, your learning-style blend, study strategies, and a free detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="vark-hero">
      <div class="vark-grid-bg" aria-hidden="true"></div>
      <div class="vark-orb vark-orb--blue" aria-hidden="true"></div>
      <div class="vark-orb vark-orb--amber" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">VARK Learning Style Test</span>
        </nav>
        <div class="eyebrow"><span></span> Four learning-preference channels</div>
        <h1>VARK Learning Style <span>Test</span></h1>
        <p class="hero-sub">Rate 24 real learning situations and get your Visual, Auditory, Read/Write, and Kinesthetic scores, your learning-style blend, and practical study strategies you can use this week.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>24</strong><span>original statements</span></div>
          <div><strong>4</strong><span>learning channels</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment inspired by VARK theory. Not the official VARK questionnaire. No affiliation or endorsement is claimed.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Four learning channels</span><h2>Most people learn best from a blend</h2><p>The report scores all four channels and reports your top two together, instead of forcing you into a single style.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--v"><b>V</b><h3>Visual</h3><p>Diagrams, charts, colour, and images.</p></article>
          <article class="type-card type-card--a"><b>A</b><h3>Auditory</h3><p>Listening, discussion, and talking ideas through.</p></article>
          <article class="type-card type-card--r"><b>R</b><h3>Read/Write</h3><p>Text, lists, and written explanation.</p></article>
          <article class="type-card type-card--k"><b>K</b><h3>Kinesthetic</h3><p>Hands-on practice and real examples.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual studying pattern</span><h2>How much does each situation help you learn?</h2><p>Think about how you actually study best, not how you think you are supposed to learn.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Find study methods that actually work for exams and daily revision.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Match your learning style to lecture notes, projects, and self-study time.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Choose training and interview preparation methods that suit how you actually learn.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Pick upskilling formats you will actually stick with and retain.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each situation on how much it helps you learn.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Learning-preference situations</span><span id="question-counter">Situation 1 of 24</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Situation 1 of 24"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">Understanding a new concept better when it's shown as a diagram, chart, or picture.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how much this helps you learn">
            <button type="button" data-value="1"><strong>1</strong><span>Not at all</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>A little</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Somewhat</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>A lot</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly helps</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="VARK learning style results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not the official VARK questionnaire and does not fix a permanent or exclusive learning ability.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use it as a study starting point</span><h2>Turn a preference into a real study system</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which channels help you retain material fastest and which feel like a struggle.</p></article>
          <article><strong>2</strong><h3>Combine</h3><p>Use your top two channels together for difficult material instead of relying on one alone.</p></article>
          <article><strong>3</strong><h3>Test</h3><p>Try one new study method from your report and check your actual recall a week later.</p></article>
          <article><strong>4</strong><h3>Adapt</h3><p>Switch methods by subject. A style that works for one topic may not work for another.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you rely on your learning style</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when interests, personality traits, or emotional skills also need to be covered alongside how you learn best." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="VARK Learning Style Report"
    fileName="future-career-school-vark-learning-style-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="VARK LEARNING STYLE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .vark-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#081226 0%,#0d1a2c 60%,#1a1424 100%)}.vark-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.vark-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.17}.vark-orb--blue{left:-180px;top:-60px;background:#38bdf8}.vark-orb--amber{right:-170px;bottom:-95px;background:#f59e0b}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#7dd3fc;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(125,211,252,.28);border-radius:999px;background:rgba(125,211,252,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#7dd3fc;box-shadow:0 0 0 5px rgba(125,211,252,.1)}.vark-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.35rem,6.2vw,4.85rem);line-height:.97;letter-spacing:-.058em;text-wrap:balance}.vark-hero h1 span{display:block;background:linear-gradient(90deg,#38bdf8,#a78bfa,#f59e0b);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#eef2f4;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}.type-card{position:relative;overflow:hidden;padding:1.25rem;border:1px solid #d3dbe0;border-radius:19px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--vark)}.type-card b{display:grid;width:44px;height:44px;place-items:center;border-radius:13px;background:color-mix(in srgb,var(--vark) 15%,white);color:var(--vark);font-size:1.25rem}.type-card h3{margin:1.05rem 0 .45rem;font-size:1.02rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:13px;line-height:1.6}.type-card--v{--vark:#38bdf8}.type-card--a{--vark:#a78bfa}.type-card--r{--vark:#10b981}.type-card--k{--vark:#f59e0b}.assessment-section{background:#0a1220}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#7dd3fc;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:4%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#38bdf8,#a78bfa,#10b981,#f59e0b);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(125,211,252,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(125,211,252,.16),transparent 62%),#0f1c2e;text-align:center}.code-mark strong{color:#fff;font-size:2.35rem;letter-spacing:.05em}.code-mark span,.result-kicker{margin-top:.5rem;color:#7dd3fc;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.8rem;margin-top:1rem}.type-result{--vark:#7dd3fc;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{margin:0;color:#fff}.type-result-head strong{color:var(--vark);font-size:1.15rem}.type-track{position:relative;height:10px;margin:.85rem 0 .55rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.type-track i{display:block;height:100%;border-radius:inherit;background:var(--vark)}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.indicator-grid,.career-grid{margin-top:.9rem}.indicator-card strong{display:block;color:#fff;font-size:1.25rem}.indicator-card span{color:#7dd3fc;font-size:11px}.career-card b{color:#fff;display:block;margin-bottom:.3rem}.career-card span{color:var(--gold);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.result-section details{margin-top:1rem}.result-section details>summary{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.035);color:#fff;font-weight:800;cursor:pointer}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
  @media(max-width:980px){.type-grid{grid-template-columns:repeat(2,1fr)}.method-layout{grid-template-columns:1fr}.result-metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.vark-hero{padding-top:112px}.audience-grid,.insight-grid,.indicator-grid,.career-grid,.type-grid,.method-grid{grid-template-columns:1fr}.hero-stats{border-radius:15px}.hero-stats div{padding:.8rem .35rem}.start-shell,.quiz-shell,.result-shell{border-radius:20px}.scale-options{gap:.3rem}.scale-options button{min-height:84px;padding:.25rem}.scale-options button span{font-size:9px;line-height:1.2}.result-head{grid-template-columns:1fr;text-align:center}.code-mark{margin:0 auto}.response-row{grid-template-columns:28px 1fr}.response-row>span:last-child{grid-column:2}.hero-actions>*,.result-actions>*{width:100%;justify-content:center}}
  .assessment-section{overflow-anchor:none}.start-shell,.quiz-shell,.result-shell{scroll-margin-top:92px}.audience-option:focus-visible,.scale-options button:focus-visible,.quiz-button:focus-visible,.result-actions a:focus-visible,.result-section summary:focus-visible{outline:3px solid #7dd3fc;outline-offset:3px}.scale-options button{touch-action:manipulation}@media(prefers-reduced-motion:reduce){.audience-option,.scale-options button,.progress-track span{transition:none}}
</style>

<script>
  // @ts-nocheck
  var ORDER=['V','A','R','K'];
  var TYPES={
    V:{name:'Visual',label:'Learning through seeing',color:'#38bdf8',summary:'You may understand and remember material better when it is shown as diagrams, charts, colour-coding, or images rather than plain text or speech.',environment:'Look for training and study materials that use diagrams, visual summaries, and colour-coded structure.',strategies:['Turn notes into mind maps, flowcharts, or diagrams instead of long paragraphs.','Use colour-coding to separate topics, priorities, or steps in a process.','Watch a visual explainer or demonstration before reading dense text on the same topic.'],careers:['Design, UX, and visual communication roles','Architecture and the built environment','Data visualisation and analytics reporting','Engineering and technical fields that rely on diagrams and schematics','Video, film, and visual media production']},
    A:{name:'Auditory',label:'Learning through hearing',color:'#a78bfa',summary:'You may understand and remember material better after hearing it explained, discussed, or talked through out loud.',environment:'Look for training and study formats built around lectures, discussion, podcasts, or verbal explanation.',strategies:['Explain a concept out loud to yourself or someone else to check real understanding.','Use recorded lectures, podcasts, or verbal explanations instead of relying only on text.','Join or create a study discussion group to process material through conversation.'],careers:['Teaching, training, and public speaking roles','Counselling, coaching, and human resources','Sales, negotiation, and client-facing communication roles','Podcasting, broadcasting, and audio content creation','Law and other argument-based, discussion-heavy fields']},
    R:{name:'Read/Write',label:'Learning through text',color:'#10b981',summary:'You may understand and remember material better through well-organised written text, lists, and definitions rather than images or speech.',environment:'Look for training and study formats with structured written material, manuals, and text-based resources.',strategies:['Rewrite or summarise material in your own words rather than only highlighting text.','Turn spoken lectures into detailed written notes as soon as possible afterward.','Use lists, definitions, and structured outlines to organise complex material.'],careers:['Research, writing, journalism, and content roles','Law, policy, and regulatory work','Software engineering and technical documentation','Academic and analytical research roles','Editing, publishing, and technical writing']},
    K:{name:'Kinesthetic',label:'Learning through doing',color:'#f59e0b',summary:'You may understand and remember material better through hands-on practice, real examples, and direct experience rather than passive reading or listening.',environment:'Look for training and study formats with labs, simulations, case studies, and real practice.',strategies:['Practise a skill directly instead of only reading or watching how it is done.','Use real case studies, simulations, or worked examples to ground abstract material.','Take short movement breaks while studying and use physical objects or models where possible.'],careers:['Skilled trades, engineering, and manufacturing','Sports, fitness, and physical-performance roles','Healthcare and other hands-on clinical fields','Culinary arts and other craft-based professions','Performing arts, theatre, and other embodied-practice fields']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Use your learning style to study smarter, not just harder',body:'Your channel scores can guide which revision methods to try first. It should widen your study toolkit, not become an excuse to avoid methods that are less natural for you.',actions:['Try one new study method from your top channel this week and compare your recall a few days later.','Ask a teacher for material in a format closer to your top channel when it is available.','Use a blend of methods for difficult subjects instead of relying on one channel alone.'],caution:'Learning preferences can shift with subject and practice at this stage. Treat this as a starting toolkit, not a fixed limitation.'},
    college:{label:'College student',title:'Match study methods to your actual retention, not habit',body:'Use your channel scores to choose note-taking methods, revision formats, and project approaches that actually improve retention for difficult material.',actions:['Convert one dense reading into your top-channel format and test your recall against the original text.','Combine two channels for your hardest subject and track which combination works best.','Ask professors or seniors for resources in a format closer to your strongest channel.'],caution:'A learning-style match will not replace consistent effort, spaced repetition, or practice testing, which matter for retention regardless of style.'},
    job:{label:'Job seeker',title:'Choose interview and skill-building preparation that sticks',body:'Use your channel scores to choose training formats and interview-preparation methods you will actually retain, rather than defaulting to whatever is most common.',actions:['Prepare interview answers using your top channel, such as writing them out, saying them aloud, or diagramming your story structure.','Choose an online course format (video, text, hands-on labs) that matches your strongest channel.','Test your retention of key talking points a few days before an interview, not the night before.'],caution:'Employers assess demonstrated skill and communication in the moment, not your preferred learning channel. Practise delivering material in multiple formats.'},
    professional:{label:'Working professional',title:'Pick upskilling formats you will actually finish',body:'Use your channel scores to choose courses, certifications, and internal training formats you are more likely to complete and retain, rather than abandoning training that does not fit how you learn.',actions:['Choose a course format (video, text-based, hands-on labs, discussion-based) that matches your top channel before enrolling.','Convert dense material from a mismatched format into your top channel before a key deadline or exam.','Track completion rates across different training formats to see which ones you actually finish.'],caution:'Time pressure and workload often explain unfinished training more than learning style alone. Address both.'}
  };
  var QUESTIONS=[
    {type:'V',text:'Understanding a new concept better when it\'s shown as a diagram, chart, or picture.'},
    {type:'A',text:'Understanding something better after hearing it explained aloud.'},
    {type:'R',text:'Preferring to learn from well-organised written text over pictures or speech.'},
    {type:'K',text:'Understanding something better after physically trying it yourself.'},
    {type:'V',text:'Remembering something more easily after seeing it written out or illustrated.'},
    {type:'A',text:'Remembering a lecture or discussion better than the same material in a textbook.'},
    {type:'R',text:'Taking detailed written notes to understand and remember material.'},
    {type:'K',text:'Learning more effectively through hands-on practice than through reading or listening.'},
    {type:'V',text:'Preferring maps, colour-coded notes, or visual summaries over long paragraphs.'},
    {type:'A',text:'Talking a problem through out loud to think it through.'},
    {type:'R',text:'Preferring lists, definitions, and written explanations over diagrams.'},
    {type:'K',text:'Needing to move, build, or do something physically to stay focused while learning.'},
    {type:'V',text:'Picturing information in your mind to help you recall it later.'},
    {type:'A',text:'Preferring a podcast or verbal explanation over reading the same material.'},
    {type:'R',text:'Rewriting or summarising information in your own words to learn it.'},
    {type:'K',text:'Remembering a skill better after practising it directly rather than just watching.'},
    {type:'V',text:'Following a process more easily from a flowchart than from spoken instructions.'},
    {type:'A',text:'Following spoken instructions more easily than written ones.'},
    {type:'R',text:'Finding it easier to learn from a manual or article than a video.'},
    {type:'K',text:'Preferring real examples, case studies, or simulations over abstract theory.'},
    {type:'V',text:'Noticing visual details, layout, and formatting when you study.'},
    {type:'A',text:'Remembering conversations and discussions in detail.'},
    {type:'R',text:'Preferring an assignment you can read and revise over one you must listen to.'},
    {type:'K',text:'Learning a new tool or process faster by trying it than by reading instructions first.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Learning-preference situations';questionCounter.textContent='Situation '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Situation '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My Learning Style':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 24-Situation Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(value){return(value-1)*25;}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(answers[item.index]);});
      var score=round(average(scored));
      return{type:type,name:TYPES[type].name,label:TYPES[type].label,color:TYPES[type].color,score:score};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||ORDER.indexOf(a.type)-ORDER.indexOf(b.type);});
    var top2=ranked.slice(0,2),blendCode=top2.map(function(item){return item.type;}).join('');
    var spread=ranked[0].score-ranked[1].score;
    var blendLabel=spread<=10?'Your top two channels are close together, so a mixed, multi-channel study method will likely work best for you.':spread<=25?'Your top channel leads clearly, with your second channel useful for specific kinds of material.':'Your top channel clearly leads your usual learning pattern, with your second channel as a smaller supporting method.';
    var flatness=ranked[0].score-ranked[3].score;
    var flatnessLabel=flatness<=20?'Your four scores are fairly close together, so you likely learn reasonably well across multiple formats rather than depending heavily on one channel.':'Your scores show a clearer preference pattern, so matching study material to your top channels is likely to make a bigger difference.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=9?'You used the "somewhat" rating often. That may reflect genuine range or uncertainty; test real study methods before drawing a strong conclusion.':extremeCount>=14?'You used many strong ratings. Check whether they reflect a repeated real pattern rather than a general impression.':run>=7?'A long sequence used the same rating. This may be genuine, but review whether attention or a response habit influenced the pattern.':'The response pattern includes a workable mix of ratings, though it still needs validation against your real study results.';
    var primary=TYPES[top2[0].type],secondary=TYPES[top2[1].type];
    var profileTitle=primary.name+' with '+secondary.name;
    var profileSummary='Your strongest learning channel is '+primary.name+' ('+primary.label+') at '+ranked[0].score+'%, followed by '+secondary.name+' ('+secondary.label+') at '+ranked[1].score+'%. '+blendLabel;
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strategies=mergeUnique(primary.strategies,secondary.strategies).slice(0,6);
    var careerNotes=mergeUnique(primary.careers,secondary.careers).slice(0,6);
    var experiments=[
      'Convert one difficult topic into '+primary.name.toLowerCase()+' format this week and test your recall three days later.',
      'Try one study method from '+secondary.name.toLowerCase()+' for a subject that is currently not working well.',
      'Combine your top two channels for your hardest subject and compare the result with using one channel alone.',
      'Ask a teacher, mentor, or manager for material in a format closer to your top channel when it is available.'
    ];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,top2:top2,blendCode:blendCode,primary:primary,secondary:secondary,spread:spread,blendLabel:blendLabel,flatness:flatness,flatnessLabel:flatnessLabel,profileTitle:profileTitle,profileSummary:profileSummary,strategies:strategies,careerNotes:careerNotes,experiments:experiments,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Convert one topic into your top-channel format and test your recall three days later.','Week 2 - Try one method from your second channel on a subject that is not currently working well.','Week 3 - Combine your top two channels for your hardest subject and compare the result.','Week 4 - Compare evidence from all three weeks against this report before settling on a permanent study system.'],
      decisionFilters:['Retention evidence - do you actually remember more using your top-channel method, tested a few days later?','Subject evidence - does the same channel work across different kinds of material, or only some?','Time evidence - does the method fit realistically into your available study time?','Combination evidence - does mixing two channels outperform using one channel alone for hard material?','Consistency evidence - are you actually able to stick with the method, not just find it appealing?'],
      retestPlan:['Wait at least four to six weeks so the same situations feel less familiar.','Retake after trying at least two real study methods from your report, not only from memory.','Compare all four channel scores, not only your top two.','Investigate a change of 15 points or more by considering new subjects, formats, or deliberate practice.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--vark:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. '+item.name+' ('+item.label+')</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var careerCards=function(items){return items.map(function(item){return'<article class="career-card"><span>Worth exploring</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Not at all',2:'A little',3:'Somewhat',4:'A lot',5:'Strongly helps'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>'+TYPES[item.question.type].name+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.blendCode+'</strong><span>Learning blend</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.profileTitle)+'</h3><p>'+escapeHtml(r.profileSummary)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.typeResults[0].score+'%</strong><span>Top channel score</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Gap between top two channels</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>"Somewhat" ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your four VARK channel scores</h4><p>Scores are based only on these 24 situations and are not a diagnostic measure. Your top two, in order, form your learning-style blend.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this blend carry?</h4><div class="insight-grid"><article><h5>Blend pattern</h5><p>'+escapeHtml(r.blendLabel)+'</p></article><article><h5>Profile shape</h5><p>'+escapeHtml(r.flatnessLabel)+'</p></article><article><h5>Response pattern</h5><p>'+escapeHtml(r.responseSummary)+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' situations were re-rated. Reconsidering is fine; use real study results when two ratings both feel plausible.</p></article></div></div>'+
      '<div class="result-section"><h4>Study strategies for your top two channels</h4>'+listHtml(r.strategies)+'</div>'+
      '<div class="result-section"><h4>Career environments where this learning style is a natural advantage</h4><p>These are directions worth investigating, not guarantees. Every field rewards more than one learning style.</p><div class="career-grid">'+careerCards(r.careerNotes)+'</div></div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before trusting this result</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a diagnosis</h5><p>It does not measure intelligence, ability, or guarantee academic or career success.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 24 situations and are not comparisons with a national or student norm.</p></article><article><h5>Not a fixed limit</h5><p>Learning preferences can shift with subject, context, and deliberate practice. Retest periodically.</p></article><article><h5>Not a replacement for proven study techniques</h5><p>Spaced repetition, practice testing, and consistent effort matter regardless of your preferred channel.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'VARK Learning Style Report',fileName:'future-career-school-vark-learning-style-report.pdf'});}
</script>
