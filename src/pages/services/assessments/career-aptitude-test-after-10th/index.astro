---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';

const pageUrl = 'https://futurecareerschool.com/services/assessments/career-aptitude-test-after-10th/';
const keywordAliases = [
  'career aptitude test after 10th',
  'aptitude test for career after 10th',
  'aptitude test after 10th',
  'free aptitude test after 10th',
];
const relatedLinks = [
  {
    href: '/services/assessments/class-10-and-below/',
    title: 'Full Class 10 Assessment',
    description: 'Go deeper with the broader Class 10 assessment for psychometric input, stream fit, and early direction.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-10th/',
    title: 'Stream Selector Test After 10th',
    description: 'Take the sister quiz when you want a stream recommendation after Class 10, not just an aptitude pattern.',
  },
  {
    href: '/services/assessments/class-11-to-12/',
    title: 'Full Class 11 and 12 Assessment',
    description: 'Use the next-stage assessment when your questions have moved beyond stream choice into course and career direction.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Browse every free assessment, aptitude test, and career quiz available across student stages.',
  },
];

const faqs = [
  {
    q: 'What is a career aptitude test after 10th?',
    a: 'It is a short, free aptitude test after 10th that shows your natural skills — like number skill, word skill, thinking skill, hands-on skill, people skill, and creative skill. It helps a Class 10 student see which careers, subjects, and future directions match their strengths.',
  },
  {
    q: 'Is this aptitude test after 10th free?',
    a: 'Yes. It is fully free. There is no login, no payment, and no sign-up. You get your result at once.',
  },
  {
    q: 'Should I take this or a stream selector test after 10th?',
    a: 'They solve two different problems. A stream selector test after 10th helps you choose between Science, Commerce, and Arts. This aptitude test for career after 10th helps you understand what you are naturally good at. Taking both usually gives a much clearer picture.',
  },
  {
    q: 'Can I take this before choosing a stream?',
    a: 'Yes. In fact, that is one of the best times to take it. An aptitude test after 10th helps you see your natural strengths before you lock yourself into a stream decision based only on marks, friends, or pressure.',
  },
  {
    q: 'Does the test pass or fail me?',
    a: 'No. There is no pass or fail and no marks. Every skill is good. The test only shows which skills are strongest in you right now.',
  },
];

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Career Aptitude Test After 10th', item: pageUrl },
    ],
  },
  {
    '@type': 'WebApplication',
    name: 'Aptitude Test for Career After 10th',
    description: 'A free 15-question aptitude test for career after Class 10. Find your strongest skills — number, word, thinking, hands-on, people, and creative — and the careers that fit. Simple words, instant result, no sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': 'EducationalOrganization', name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Career Aptitude Test After 10th | Free Aptitude Test for Career After 10th | Future Career School"
  description="Free career aptitude test after 10th. Take this aptitude test for career after 10th, answer 15 simple questions, and find your strongest skills with instant results."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Career Aptitude Test After 10th</span>
      </nav>

      <div class="pill">
        <span class="dot"></span>
        Free &nbsp;&middot;&nbsp; 15 Questions &nbsp;&middot;&nbsp; Aptitude Quiz After 10th &nbsp;&middot;&nbsp; Instant Result
      </div>

      <h1>
        Career Aptitude Test
        <span class="gold-text">After 10th</span>
      </h1>

      <p class="hero-sub">
        If you are looking for an aptitude test after 10th, this free quiz helps you find your strongest skills.
        Answer 15 short questions and see which careers, subjects, and future paths match the way
        your mind naturally works before you choose your next stream.
      </p>

      <div class="meta-chips">
        <span class="meta-chip">📘 15 questions</span>
        <span class="meta-chip">⏱️ About 9 minutes</span>
        <span class="meta-chip">🎯 Instant result</span>
        <span class="meta-chip">✅ 100% free</span>
        <span class="meta-chip">🆓 No sign-up</span>
      </div>

      <div class="meta-chips meta-chips-keywords">
        {keywordAliases.map((keyword) => <span class="meta-chip meta-chip-muted">{keyword}</span>)}
      </div>

      <a href="#assessment" class="btn-gold pulse hero-cta">Start the Test</a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="container">
      <h2 class="section-title">How This Test Works</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-num">1</div>
          <h3>Answer 15 questions</h3>
          <p>Each question is short and uses easy words. Pick the answer that feels most true for you.</p>
        </div>
        <div class="how-card">
          <div class="how-num">2</div>
          <h3>We find your skills</h3>
          <p>The test looks at six skills — number, word, thinking, hands-on, people, and creative.</p>
        </div>
        <div class="how-card">
          <div class="how-num">3</div>
          <h3>Get your top skills</h3>
          <p>You see your two strongest skills, with the subjects and jobs that match them best.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <h2 class="section-title">Find Your Strongest Skills</h2>
      <p class="section-sub">
        There are no right or wrong answers, and no marks. Just pick what is true for you.
      </p>

      <div id="quiz-container" class="quiz-box">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 15</span>
            <span id="q-pct" class="q-pct">0% done</span>
          </div>
          <div class="progress-bar-wrap">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>

        <div id="q-display">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading...</p>
          <div id="q-opts" class="q-opts"></div>
        </div>

        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()">Back</button>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()">Next</button>
        </div>
      </div>

      <div id="results-container" class="results-box" style="display:none" aria-live="polite"></div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <h2 class="section-title">Common Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="related-assessment-pages"
    title="More Assessment Pages for Students"
    subtitle="Pair the focused stream and aptitude pages when you want both stream clarity and strength-fit clarity."
    items={relatedLinks}
    altBackground={true}
  />

  <!-- CTA -->
  <section id="cta">
    <div class="container cta-inner">
      <h2 class="cta-headline">Want a Full Plan, Not Just a Result?</h2>
      <p class="cta-sub">
        This test shows your strengths. A one-on-one career guidance session turns that into a clear plan —
        which stream and subjects to take, and what to do next.
      </p>
      <div class="cta-actions">
        <a href="/services/career-counselling-and-career-guidance" class="btn-gold pulse">Get Career Guidance</a>
        <a href="/services/assessments" class="btn-outline">See All Assessments</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style is:global>
  #hero { padding: 130px 0 70px; position: relative; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .5rem; font-size: 13px; color: rgba(255,255,255,.45); margin-bottom: 1.5rem; }
  .breadcrumb a:hover { color: var(--gold); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }
  #hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; color: #fff; margin: 1.25rem 0; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 17px); line-height: 1.8; color: rgba(255,255,255,.6); max-width: 660px; margin-bottom: 1.75rem; }
  .meta-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin-bottom: 2rem; }
  .meta-chip { font-size: 13px; font-weight: 600; color: rgba(255,255,255,.72); background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 999px; padding: .4rem .85rem; }
  .meta-chips-keywords { margin-top: -0.4rem; }
  .meta-chip-muted { color: rgba(255,255,255,.58); }
  .hero-cta { font-size: 15px; padding: 15px 32px; }

  section { padding: 4.5rem 0; }
  .section-title { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: #fff; text-align: center; margin-bottom: .75rem; }
  .section-sub { font-size: 15px; line-height: 1.7; color: rgba(255,255,255,.6); text-align: center; max-width: 600px; margin: 0 auto 2rem; }

  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; }
  .how-card { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 1.75rem 1.5rem; }
  .how-num { width: 38px; height: 38px; border-radius: 50%; background: rgba(229,184,74,.14); border: 1px solid rgba(229,184,74,.35); color: var(--gold); font-weight: 800; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .how-card h3 { font-size: 17px; color: #fff; margin-bottom: .5rem; }
  .how-card p { font-size: 14px; line-height: 1.65; color: rgba(255,255,255,.62); }

  #assessment { text-align: center; }
  .quiz-box { max-width: 720px; margin: 0 auto; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem 2.1rem; text-align: left; }
  .quiz-progress { margin-bottom: 1.6rem; }
  .progress-header { display: flex; justify-content: space-between; margin-bottom: .55rem; }
  .q-counter { font-size: 12px; font-weight: 700; color: rgba(255,255,255,.55); text-transform: uppercase; letter-spacing: .05em; }
  .q-pct { font-size: 12px; font-weight: 600; color: var(--teal); }
  .progress-bar-wrap { height: 7px; background: rgba(255,255,255,.08); border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--teal), var(--gold)); border-radius: 999px; transition: width .4s ease; }
  .q-num { font-size: 11.5px; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: .07em; margin-bottom: .55rem; }
  .q-text { font-size: clamp(17px, 2.4vw, 21px); font-weight: 700; color: #fff; line-height: 1.45; margin-bottom: 1.4rem; }
  .q-opts { display: flex; flex-direction: column; gap: .65rem; }
  .opt-btn { display: flex; align-items: flex-start; gap: .85rem; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07); border-radius: 13px; padding: 1rem 1.15rem; text-align: left; color: rgba(255,255,255,.82); font-size: 15px; line-height: 1.55; font-family: inherit; cursor: pointer; transition: background .18s, transform .15s, border-color .18s; }
  .opt-btn:hover { background: rgba(255,255,255,.08); color: #fff; transform: translateX(3px); }
  .opt-letter { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; background: rgba(255,255,255,.08); font-size: 13px; font-weight: 800; color: rgba(255,255,255,.55); flex-shrink: 0; }
  .opt-btn.selected { background: linear-gradient(135deg, rgba(229,184,74,.14), rgba(229,184,74,.05)); border-color: rgba(229,184,74,.4); color: #fff; }
  .opt-btn.selected .opt-letter { background: var(--gold); color: #0a0f1e; }
  .quiz-nav { display: flex; justify-content: space-between; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.07); }
  .btn-back, .btn-next { padding: .7rem 1.4rem; border-radius: 10px; font-family: "Sora", sans-serif; font-weight: 700; font-size: 14px; cursor: pointer; transition: all .2s; }
  .btn-back { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.7); }
  .btn-back:hover:not(:disabled) { color: #fff; border-color: rgba(255,255,255,.25); }
  .btn-next { background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a); border: none; color: #0a0f1e; }
  .btn-next:disabled, .btn-back:disabled { opacity: .4; cursor: not-allowed; }

  .results-box { max-width: 720px; margin: 2rem auto 0; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem 2.1rem; text-align: left; }
  .res-top { text-align: center; margin-bottom: 1.75rem; }
  .res-emoji { font-size: 3rem; }
  .res-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--teal); margin: .6rem 0 .25rem; }
  .res-stream { font-size: clamp(1.4rem, 4vw, 2rem); font-weight: 800; color: #fff; }
  .res-desc { font-size: 15px; line-height: 1.75; color: rgba(255,255,255,.7); margin: 1rem 0 1.5rem; }
  .res-bars { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.75rem; }
  .res-bar-row { display: flex; align-items: center; gap: .8rem; }
  .res-bar-label { width: 140px; flex-shrink: 0; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.78); }
  .res-bar-track { flex: 1; height: 11px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .res-bar-fill { display: block; height: 100%; border-radius: 999px; min-width: 2px; }
  .res-bar-val { width: 38px; text-align: right; font-size: 12px; font-weight: 700; color: rgba(255,255,255,.6); }
  .res-section { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07); border-radius: 14px; padding: 1.2rem 1.3rem; margin-bottom: 1rem; }
  .res-section h4 { font-size: 14px; color: var(--gold); margin-bottom: .55rem; }
  .res-section p, .res-section li { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.72); }
  .res-section ul { padding-left: 1.1rem; }
  .res-section p + p { margin-top: .6rem; }
  .res-section.res-highlight { border-color: rgba(229,184,74,.4); background: rgba(229,184,74,.07); }
  .res-section.res-highlight h4 { color: var(--gold); }
  .res-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 1.5rem; }
  .res-retake { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.75); padding: 13px 26px; border-radius: 12px; font-family: "Sora", sans-serif; font-weight: 600; font-size: 14px; cursor: pointer; }

  .faq-list { max-width: 720px; margin: 2rem auto 0; display: flex; flex-direction: column; gap: .7rem; }
  .faq-item { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 13px; padding: 1.1rem 1.3rem; }
  .faq-item summary { font-size: 15px; font-weight: 700; color: #fff; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--gold); font-weight: 700; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.65); margin-top: .8rem; }

  #cta { text-align: center; }
  .cta-inner { max-width: 640px; margin: 0 auto; }
  .cta-headline { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; color: #fff; margin-bottom: .75rem; }
  .cta-sub { font-size: 15px; line-height: 1.75; color: rgba(255,255,255,.62); margin-bottom: 1.75rem; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }

  @media (max-width: 760px) {
    .how-grid { grid-template-columns: 1fr; }
    .quiz-box, .results-box { padding: 1.5rem 1.2rem; }
    .res-bar-label { width: 108px; font-size: 12px; }
  }
</style>

<script is:inline>
/* ── Aptitude Test for Career After 10th ── */
var QUESTIONS = [
  { q: "Which task is easy and fun for you?", opts: [
    { t: "Doing maths sums quickly", s: "num" },
    { t: "Reading a long story", s: "word" },
    { t: "Solving a tricky puzzle", s: "logic" },
    { t: "Fixing or building something", s: "hands" },
    { t: "Helping a friend who is sad", s: "people" },
    { t: "Drawing or designing something", s: "create" },
  ]},
  { q: "Pick the game you like best:", opts: [
    { t: "A number or maths game", s: "num" },
    { t: "A word or spelling game", s: "word" },
    { t: "A brain teaser or strategy game", s: "logic" },
    { t: "Building blocks or model kits", s: "hands" },
    { t: "A team game with friends", s: "people" },
    { t: "Drawing, painting, or craft", s: "create" },
  ]},
  { q: "In class, you are best at:", opts: [
    { t: "Quick mental maths", s: "num" },
    { t: "Reading and writing well", s: "word" },
    { t: "Finding the smart answer", s: "logic" },
    { t: "Lab work and making things", s: "hands" },
    { t: "Group work and talking", s: "people" },
    { t: "Art, music, or design", s: "create" },
  ]},
  { q: "What kind of problem do you enjoy?", opts: [
    { t: "What is the total cost?", s: "num" },
    { t: "What does this word mean?", s: "word" },
    { t: "What comes next in this pattern?", s: "logic" },
    { t: "How do I fix this?", s: "hands" },
    { t: "How can I help this person?", s: "people" },
    { t: "How can I make this look nice?", s: "create" },
  ]},
  { q: "Friends often ask you to:", opts: [
    { t: "Check their maths", s: "num" },
    { t: "Help with writing or spelling", s: "word" },
    { t: "Solve a tricky question", s: "logic" },
    { t: "Repair or build something", s: "hands" },
    { t: "Listen to their problem", s: "people" },
    { t: "Make something look good", s: "create" },
  ]},
  { q: "Which job sounds the most fun?", opts: [
    { t: "Accountant or data expert", s: "num" },
    { t: "Writer or news reader", s: "word" },
    { t: "Scientist or planner", s: "logic" },
    { t: "Engineer or mechanic", s: "hands" },
    { t: "Teacher or counsellor", s: "people" },
    { t: "Artist or designer", s: "create" },
  ]},
  { q: "You feel proud when you:", opts: [
    { t: "Solve a hard maths sum", s: "num" },
    { t: "Write a good essay or speech", s: "word" },
    { t: "Crack a difficult puzzle", s: "logic" },
    { t: "Build or fix something well", s: "hands" },
    { t: "Make someone feel better", s: "people" },
    { t: "Create something beautiful", s: "create" },
  ]},
  { q: "What do you like to do after school?", opts: [
    { t: "Play number or money games", s: "num" },
    { t: "Read books or write stories", s: "word" },
    { t: "Play chess or strategy games", s: "logic" },
    { t: "Make models or fix gadgets", s: "hands" },
    { t: "Spend time and talk with friends", s: "people" },
    { t: "Draw, sing, dance, or design", s: "create" },
  ]},
  { q: "Which school subject do you do best in?", opts: [
    { t: "Maths", s: "num" },
    { t: "English or languages", s: "word" },
    { t: "Science or reasoning", s: "logic" },
    { t: "Workshop, lab, or computer practicals", s: "hands" },
    { t: "Group projects and speaking", s: "people" },
    { t: "Art, craft, or music", s: "create" },
  ]},
  { q: "A new project starts. You want to:", opts: [
    { t: "Handle the numbers and budget", s: "num" },
    { t: "Write the report and notes", s: "word" },
    { t: "Plan the steps and logic", s: "logic" },
    { t: "Build the model or product", s: "hands" },
    { t: "Lead the team and share work", s: "people" },
    { t: "Design the look and posters", s: "create" },
  ]},
  { q: "Which puzzle would you pick?", opts: [
    { t: "A number or Sudoku puzzle", s: "num" },
    { t: "A crossword or word puzzle", s: "word" },
    { t: "A riddle or logic puzzle", s: "logic" },
    { t: "A build-it-yourself kit", s: "hands" },
    { t: "A role-play or acting game", s: "people" },
    { t: "A drawing or colouring page", s: "create" },
  ]},
  { q: "People say you are good at:", opts: [
    { t: "Maths and counting", s: "num" },
    { t: "Speaking and writing", s: "word" },
    { t: "Thinking and planning", s: "logic" },
    { t: "Making and fixing things", s: "hands" },
    { t: "Caring and helping", s: "people" },
    { t: "Imagining and creating", s: "create" },
  ]},
  { q: "What would you like to learn more about?", opts: [
    { t: "How to work with numbers and money", s: "num" },
    { t: "How to write and speak well", s: "word" },
    { t: "How to solve hard problems", s: "logic" },
    { t: "How to build and repair things", s: "hands" },
