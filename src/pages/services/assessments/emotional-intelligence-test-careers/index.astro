---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/emotional-intelligence-test-careers/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/disc-personality-test-careers/',
    title: 'DISC Personality Test for Careers',
    description: 'Use four workplace behaviour styles and a style blend when you want a communication-style profile alongside your emotional intelligence signals.',
  },
  {
    href: '/services/assessments/riasec-holland-code-career-test/',
    title: 'RIASEC Holland Code Career Test',
    description: 'Use six interest types and a three-letter Holland Code when the bigger question is which career families to investigate.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous personality traits and 20 facets for a broader behaviour-based profile beyond emotional skills.',
  },
  {
    href: '/services/assessments/vark-learning-style-test/',
    title: 'VARK Learning Style Test',
    description: 'Use four learning channels and study strategies when the goal is faster, more effective learning rather than emotional skills.',
  },
  {
    href: '/services/assessments/enneagram-personality-test-careers/',
    title: 'Enneagram Personality Test for Careers',
    description: 'Use nine core motivation patterns when you want a deeper look at what drives your behaviour, not just how you regulate it.',
  },
  {
    href: '/services/assessments/entrepreneurial-aptitude-test/',
    title: 'Entrepreneurial Aptitude Test',
    description: 'Use five practical readiness scores when the real question is venture-building fit rather than emotional skills.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does this emotional intelligence test measure?',
    a: 'It estimates five practical emotional-skill areas from your answers: self-awareness, self-regulation, motivation, empathy, and social skills, plus an overall composite score.',
  },
  {
    q: 'Is this a clinically validated or official EQ test?',
    a: 'No. This is an independent, original 25-statement educational assessment from Future Career School. It is not a clinical or medical instrument and cannot diagnose any condition.',
  },
  {
    q: 'Why should I trust a self-reported emotional intelligence score?',
    a: 'You should treat it as a starting hypothesis, not a fact. Self-reported scores can be inflated by how you see yourself rather than how you actually behave. Use the report to guide real observation and feedback from others, not as a final verdict.',
  },
  {
    q: 'Can emotional intelligence be improved?',
    a: 'Yes. Unlike some traits, the skills behind emotional intelligence, such as noticing triggers, pausing before reacting, and reading others accurately, can be practised and improved with deliberate effort and feedback.',
  },
  {
    q: 'Which careers reward higher emotional intelligence?',
    a: 'Leadership, people management, sales, negotiation, counselling-adjacent roles, healthcare, education, and customer-facing roles under pressure tend to reward strong emotional skills, though every role benefits from them to some degree.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all five emotional-skill scores, your composite score, workplace-leverage notes, a growth plan for your lowest area, and all 25 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Emotional Intelligence Test for Careers', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Emotional Intelligence Test for Careers',
    alternateName: 'EQ Career Test',
    description: 'A free original 25-statement emotional intelligence assessment covering self-awareness, self-regulation, motivation, empathy, and social skills, with workplace-leverage guidance and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Emotional Intelligence Test for Careers | Free EQ Test"
  description="Take a free emotional intelligence test for careers. Get five EQ skill scores, a composite score, workplace-leverage guidance, and a free detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="eq-hero">
      <div class="eq-grid-bg" aria-hidden="true"></div>
      <div class="eq-orb eq-orb--teal" aria-hidden="true"></div>
      <div class="eq-orb eq-orb--rose" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Emotional Intelligence Test for Careers</span>
        </nav>
        <div class="eyebrow"><span></span> Five practical emotional skills</div>
        <h1>Emotional Intelligence Test <span>for Careers</span></h1>
        <p class="hero-sub">Rate 25 real situations and get your self-awareness, self-regulation, motivation, empathy, and social-skills scores, an overall composite, and a practical growth plan instead of a single vague EQ number.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>25</strong><span>original statements</span></div>
          <div><strong>5</strong><span>emotional-skill areas</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment. Not a clinical or medical instrument. Self-reported scores are a starting hypothesis, not proof of actual behaviour.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Five practical skill areas</span><h2>Emotional intelligence is a skill set, not a fixed trait</h2><p>Each area can be observed, practised, and improved with real feedback, unlike some personality traits that stay more stable over time.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--sa"><b>SA</b><h3>Self-Awareness</h3><p>Recognising your own emotions, triggers, and their impact.</p></article>
          <article class="type-card type-card--sr"><b>SR</b><h3>Self-Regulation</h3><p>Managing impulses and staying steady under pressure.</p></article>
          <article class="type-card type-card--mo"><b>MO</b><h3>Motivation</h3><p>Sustaining drive, resilience, and optimism toward goals.</p></article>
          <article class="type-card type-card--em"><b>EM</b><h3>Empathy</h3><p>Reading other people's emotions and perspectives accurately.</p></article>
          <article class="type-card type-card--ss"><b>SS</b><h3>Social Skills</h3><p>Managing relationships, conflict, and influence effectively.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual behaviour</span><h2>Rate how true each statement is of you</h2><p>Use your common pattern across study, work, and relationships, not the version of yourself you wish were always true.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Build emotional skills early through teamwork, feedback, and self-reflection.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Connect emotional skills to group projects, leadership roles, and internships.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Prepare interview stories that show real emotional-skill evidence, not just a score.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Diagnose leadership, team, and pressure-related friction at work.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each statement on how accurately it describes your usual pattern.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Emotional-skill statements</span><span id="question-counter">Statement 1 of 25</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Statement 1 of 25"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">I can usually name exactly what emotion I'm feeling in the moment.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how accurately this describes you">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly disagree</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Disagree</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neither</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Agree</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly agree</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Emotional intelligence results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not a clinical or medical instrument and cannot measure emotional intelligence with certainty from self-report alone.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use the score as a starting hypothesis</span><h2>Turn self-report into real evidence</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which emotional-skill areas are strongest and which need deliberate practice.</p></article>
          <article><strong>2</strong><h3>Verify</h3><p>Ask people who know you well whether your self-rating matches what they actually observe.</p></article>
          <article><strong>3</strong><h3>Practise</h3><p>Pick one small, repeatable habit for your lowest-scoring area.</p></article>
          <article><strong>4</strong><h3>Apply</h3><p>Use your strongest areas deliberately in interviews, teams, and leadership moments.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use this score</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when interests, work-style preferences, or personality traits also need to be covered alongside emotional skills." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Emotional Intelligence Report"
    fileName="future-career-school-emotional-intelligence-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="EMOTIONAL INTELLIGENCE SKILLS REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .eq-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#071a18 0%,#0d211f 60%,#141f2b 100%)}.eq-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.eq-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.17}.eq-orb--teal{left:-180px;top:-60px;background:#2dd4bf}.eq-orb--rose{right:-170px;bottom:-95px;background:#fb7185}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#5eead4;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(94,234,212,.28);border-radius:999px;background:rgba(94,234,212,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#5eead4;box-shadow:0 0 0 5px rgba(94,234,212,.1)}.eq-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.3rem,6.1vw,4.75rem);line-height:.97;letter-spacing:-.056em;text-wrap:balance}.eq-hero h1 span{display:block;background:linear-gradient(90deg,#2dd4bf,#fbbf24,#fb7185);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#f2f4f0;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem}.type-card{position:relative;overflow:hidden;padding:1.1rem;border:1px solid #d6ddd2;border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--eq)}.type-card b{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--eq) 15%,white);color:var(--eq);font-size:1rem}.type-card h3{margin:.95rem 0 .42rem;font-size:.98rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:12.5px;line-height:1.55}.type-card--sa{--eq:#2dd4bf}.type-card--sr{--eq:#38bdf8}.type-card--mo{--eq:#fbbf24}.type-card--em{--eq:#fb7185}.type-card--ss{--eq:#a78bfa}.assessment-section{background:#081716}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#5eead4;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:4%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#2dd4bf,#38bdf8,#fbbf24,#fb7185,#a78bfa);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(94,234,212,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(94,234,212,.16),transparent 62%),#0d201d;text-align:center}.code-mark strong{color:#fff;font-size:2.35rem}.code-mark span,.result-kicker{margin-top:.5rem;color:#5eead4;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.8rem;margin-top:1rem}.type-result{--eq:#5eead4;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{margin:0;color:#fff}.type-result-head strong{color:var(--eq);font-size:1.15rem}.type-track{position:relative;height:10px;margin:.85rem 0 .55rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.type-track i{display:block;height:100%;border-radius:inherit;background:var(--eq)}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.indicator-grid,.career-grid{margin-top:.9rem}.indicator-card strong{display:block;color:#fff;font-size:1.25rem}.indicator-card span{color:#5eead4;font-size:11px}.career-card b{color:#fff;display:block;margin-bottom:.3rem}.career-card span{color:var(--gold);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.result-section details{margin-top:1rem}.result-section details>summary{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.035);color:#fff;font-weight:800;cursor:pointer}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
