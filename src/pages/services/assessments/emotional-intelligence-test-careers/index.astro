</style>

<script>
  // @ts-nocheck
  var ORDER=['SA','SR','MO','EM','SS'];
  var TYPES={
    SA:{name:'Self-Awareness',label:'Reading yourself accurately',color:'#2dd4bf',summary:'You may notice your own emotions, triggers, and their impact on your decisions and work reasonably well.',environment:'Look for roles with room for reflection, honest feedback, and regular check-ins rather than nonstop reactive pace.',leverage:['Coaching, mentoring, and people-development roles','Leadership and management roles that require honest self-assessment','Roles requiring careful judgement under ambiguity','Executive coaching and leadership-development consulting','Roles involving public accountability, such as journalism or public relations'],highPay:'Leadership-development, HR business-partner, and senior coaching or mentoring roles that combine self-awareness with real business results tend to be better compensated than junior individual-contributor roles.',skills:['A regular reflection habit, such as a short journal after demanding days','Structured feedback requests from people who see your blind spots','Naming emotions specifically rather than generically ("frustrated by the delay" rather than "bad")']},
    SR:{name:'Self-Regulation',label:'Staying steady under pressure',color:'#38bdf8',summary:'You may manage impulses and stay comparatively steady when a situation becomes tense, uncertain, or frustrating.',environment:'Look for roles with real pressure and consequence, supported by clear escalation paths and recovery time.',leverage:['Roles under sustained pressure, such as live operations, trading, or crisis or escalation handling','Client-facing roles where composure under criticism matters','Roles requiring calm decision-making during ambiguity','Emergency-response, aviation, and other roles requiring composure in high-stakes moments','Negotiation-heavy roles such as procurement or dispute resolution'],highPay:'Roles that combine self-regulation with high-stakes decision-making, such as trading, operations leadership, or senior client management, tend to carry a pay premium tied to the pressure and consequence involved.',skills:['A specific pause technique before responding to criticism or conflict','Pre-agreed escalation and support systems for high-pressure periods','Post-event debriefs to separate facts from emotional reaction']},
    MO:{name:'Motivation',label:'Sustaining drive through setbacks',color:'#fbbf24',summary:'You may sustain effort, optimism, and personal standards toward a goal even when progress is slow or uncertain.',environment:'Look for roles with a meaningful goal, visible progress markers, and enough autonomy to set your own standards.',leverage:['Entrepreneurship and founder-led ventures','Sales and business-development roles with long sales cycles','Research, product, or project roles requiring sustained effort toward a distant outcome','Athletic coaching and performance-development roles','Academic research or long-cycle product-development roles requiring sustained focus'],highPay:'Entrepreneurship, sales, and business-development roles that reward sustained effort tend to have the highest compensation ceiling in this group, since pay is often tied to results achieved over time rather than a fixed salary band.',skills:['Breaking a long-term goal into visible weekly milestones','A pre-written recovery plan for predictable low-motivation periods','Separating a temporary setback from a signal to quit entirely']},
    EM:{name:'Empathy',label:'Reading others accurately',color:'#fb7185',summary:'You may notice other people\'s emotions, perspectives, and unspoken needs reasonably well, even when they are not stated directly.',environment:'Look for roles with real human interaction and enough time to actually listen rather than constant rushed transactions.',leverage:['Counselling-adjacent, healthcare, and education roles','Customer success, user research, and service-design roles','Human resources and people-operations roles','User experience research and design roles','Community management and stakeholder-relations roles'],highPay:'Specialised healthcare, senior HR/people-operations, and user-research roles that combine empathy with a technical or clinical qualification tend to pay more than generic front-line service roles.',skills:['Actively summarising what you heard before responding, to check accuracy','Deliberately noticing tone and body language, not only words','Asking one more clarifying question before assuming you understand']},
    SS:{name:'Social Skills',label:'Managing relationships and influence',color:'#a78bfa',summary:'You may manage relationships, conflict, and group influence effectively, helping people move toward a shared outcome.',environment:'Look for roles with real collaboration, negotiation, or group decision-making rather than mostly solitary work.',leverage:['Leadership, general management, and team-lead roles','Sales, negotiation, and partnerships roles','Public relations, communications, and stakeholder-management roles','Diplomacy, public affairs, and cross-team coordination roles','Facilitation, training, and organisational-development roles'],highPay:'Leadership, sales, and stakeholder-management roles that combine strong social skills with measurable business outcomes tend to command the strongest pay in this group.',skills:['Structured conflict-resolution practice, such as naming shared goals before disagreement','Feedback delivery practised so it is heard rather than defended against','Facilitation practice for group decisions with competing opinions']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Build emotional skills through everyday practice',body:'Your scores can guide which habits to practise now, such as naming emotions accurately or staying calm during a disagreement with a friend or teammate. It should build skills, not label you permanently this early.',actions:['Practise naming your emotion specifically instead of saying "fine" or "bad".','Ask a trusted friend or teacher for one honest example of how you handled a recent conflict.','Take on a group role that stretches your lowest-scoring area.'],caution:'Emotional skills develop a great deal during adolescence. Treat this as a snapshot to practise from, not a fixed verdict.'},
    college:{label:'College student',title:'Turn emotional-skill awareness into leadership evidence',body:'Use your scores to choose project roles, internships, and leadership opportunities that build real, demonstrable emotional-skill evidence for interviews later.',actions:['Take a leadership or mediation role in one group project to test your social skills under real stakes.','Ask a mentor or senior for specific feedback on how you handle pressure and disagreement.','Practise one deliberate habit for your lowest-scoring area for four weeks.'],caution:'A self-reported score is not the same as demonstrated skill. Build real examples you can describe specifically in interviews.'},
    job:{label:'Job seeker',title:'Prepare specific evidence, not just a score',body:'Use your top two areas to prepare interview stories that show real emotional-skill evidence with a measurable outcome, and target roles that reward those strengths.',actions:['Prepare one specific story for each of your top two areas with a clear situation, action, and result.','Ask interviewers what emotional demands the role actually involves day to day.','Practise handling a mock difficult conversation before a real interview or role.'],caution:'Interviewers assess demonstrated behaviour, not self-reported scores. Always support this report with specific, verifiable examples.'},
    professional:{label:'Working professional',title:'Diagnose leadership and team friction accurately',body:'Use your scores to understand recurring friction in your team, under pressure, or in your own leadership style, and separate an emotional-skill gap from a role, workload, or systems problem.',actions:['Ask two trusted colleagues for specific, honest feedback on your lowest-scoring area.','Practise one deliberate habit for four weeks and track a real example of the change.','Test whether recurring team friction is really about emotional skill or about unclear roles, workload, or incentives.'],caution:'Persistent team or leadership friction often has multiple causes. Do not assume an emotional-skill score explains everything.'}
  };
  var QUESTIONS=[
    {type:'SA',reverse:false,text:'I can usually name exactly what emotion I\'m feeling in the moment.'},
    {type:'SR',reverse:false,text:'I can stay calm and think clearly during a tense conversation.'},
    {type:'MO',reverse:false,text:'I keep working toward a goal even when progress is slow.'},
    {type:'EM',reverse:false,text:'I can tell when someone is upset even if they don\'t say so directly.'},
    {type:'SS',reverse:false,text:'I can resolve a disagreement without it damaging the relationship.'},
    {type:'SA',reverse:false,text:'I notice early warning signs before a small frustration turns into anger.'},
    {type:'SR',reverse:false,text:'I pause before reacting when someone criticises my work.'},
    {type:'MO',reverse:false,text:'Setbacks make me more determined rather than less.'},
    {type:'EM',reverse:false,text:'I genuinely try to understand a situation from another person\'s point of view.'},
    {type:'SS',reverse:false,text:'People come to me to help mediate a conflict.'},
    {type:'SA',reverse:true,text:'I\'m often surprised by how strongly I react to something.'},
    {type:'SR',reverse:true,text:'Once I\'m upset, it\'s hard for me to think about anything else.'},
    {type:'MO',reverse:true,text:'I tend to give up quickly when something feels difficult.'},
    {type:'EM',reverse:true,text:'I sometimes miss how my words affect other people\'s feelings.'},
    {type:'SS',reverse:true,text:'I find it hard to build rapport with people who are very different from me.'},
    {type:'SA',reverse:false,text:'I understand what specific situations tend to trigger stress for me.'},
    {type:'SR',reverse:false,text:'I can adjust my plans calmly when something unexpected happens.'},
    {type:'MO',reverse:false,text:'I set my own standards rather than waiting to be pushed by others.'},
    {type:'EM',reverse:false,text:'I notice small changes in someone\'s tone or body language.'},
    {type:'SS',reverse:false,text:'I can persuade a group toward a shared decision without forcing it.'},
    {type:'SA',reverse:false,text:'I can tell how my mood is affecting my work or decisions.'},
    {type:'SR',reverse:false,text:'I keep my temper in check even when provoked.'},
    {type:'MO',reverse:false,text:'I stay optimistic about a project even during a rough patch.'},
    {type:'EM',reverse:false,text:'I adjust how I communicate based on how the other person seems to be feeling.'},
    {type:'SS',reverse:false,text:'I give feedback in a way that people can actually hear and use.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Emotional-skill statements';questionCounter.textContent='Statement '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Statement '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My EQ Report':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 25-Statement Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(question,value){var raw=(value-1)*25;return question.reverse?100-raw:raw;}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(item.q,answers[item.index]);});
      var score=round(average(scored));
      return{type:type,name:TYPES[type].name,label:TYPES[type].label,color:TYPES[type].color,score:score};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||ORDER.indexOf(a.type)-ORDER.indexOf(b.type);});
    var composite=round(average(typeResults.map(function(item){return item.score;})));
    var compositeLabel=composite>=70?'Your self-reported answers suggest comparatively strong emotional-skill signals overall.':composite>=45?'Your self-reported answers suggest a moderate, fairly typical emotional-skill profile.':'Your self-reported answers suggest real room to build emotional-skill habits deliberately.';
    var strongest=ranked[0],weakest=ranked[ranked.length-1];
    var spread=strongest.score-weakest.score;
    var spreadLabel=spread>=35?'Your five areas differ quite a lot - '+strongest.name+' is a clear relative strength and '+weakest.name+' is a clear area to build.':spread>=15?'Your five areas differ moderately, with '+strongest.name+' leading and '+weakest.name+' trailing.':'Your five areas are fairly close together, so your emotional-skill profile does not show one dominant strength or weakness.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=9?'You used the neutral rating often. That may reflect genuine range or uncertainty; use real feedback from others before drawing a strong conclusion.':extremeCount>=15?'You used many strong ratings. Self-reported extreme scores can reflect how you want to see yourself as much as real behaviour; verify with others.':run>=8?'A long sequence used the same rating. This may be genuine, but review whether attention or a response habit influenced the pattern.':'The response pattern includes a workable mix of agreement, disagreement, and neutral ratings, though it still needs validation against real feedback from others.';
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strongLeverage=mergeUnique(TYPES[strongest.type].leverage,TYPES[ranked[1].type].leverage).slice(0,6);
    var highPayNotes=[TYPES[strongest.type].name+': '+TYPES[strongest.type].highPay,TYPES[ranked[1].type].name+': '+TYPES[ranked[1].type].highPay];
    var growthPlan=TYPES[weakest.type].skills;
    var experiments=[
      'Ask two people who know you well to rate your top and bottom area from this report, then compare their view with yours.',
      'Practise one specific habit from your growth plan for two weeks and note one real example of the change.',
      'Use '+TYPES[strongest.type].name.toLowerCase()+' deliberately in one real situation this week: '+TYPES[strongest.type].environment.toLowerCase(),
      'Notice one moment this week when '+TYPES[weakest.type].name.toLowerCase()+' would have helped, and write down what you would try differently.'
    ];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(q,answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,composite:composite,compositeLabel:compositeLabel,strongest:strongest,weakest:weakest,spread:spread,spreadLabel:spreadLabel,strongLeverage:strongLeverage,highPayNotes:highPayNotes,growthPlan:growthPlan,experiments:experiments,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Ask two people who know you well to rate your strongest and weakest area, and compare with your own scores.','Week 2 - Practise one specific habit from your growth plan and record one real example of using it.','Week 3 - Deliberately use your strongest area in a real, meaningful situation and note the outcome.','Week 4 - Compare evidence from all three weeks against this report before treating it as a settled conclusion.'],
      decisionFilters:['Feedback evidence - does your self-rating match what people who know you well actually observe?','Behaviour evidence - can you point to a specific recent example, not just a general feeling?','Pressure evidence - does your self-rating hold up during a genuinely stressful event, not only calm days?','Growth evidence - have you practised your lowest area deliberately, or only noticed it?','Role evidence - does your target role actually reward the emotional skills you scored highest on?'],
      retestPlan:['Wait at least six to eight weeks so the same statements feel less familiar.','Retake after collecting real feedback from at least two other people.','Compare all five area scores, not only the composite number.','Investigate a change of 15 points or more by considering new roles, feedback, or deliberate practice.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--eq:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. '+item.name+' ('+item.label+')</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var leverageCards=function(items){return items.map(function(item){return'<article class="career-card"><span>Worth exploring</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Strongly disagree',2:'Disagree',3:'Neither',4:'Agree',5:'Strongly agree'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>'+TYPES[item.question.type].name+(item.question.reverse?' / reverse-scored':'')+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.composite+'%</strong><span>Composite EQ score</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.strongest.name+' leads, '+r.weakest.name+' trails')+'</h3><p>'+escapeHtml(r.compositeLabel)+' '+escapeHtml(r.spreadLabel)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.composite+'%</strong><span>Composite score</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Spread between strongest and weakest</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>Neutral ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your five emotional-skill scores</h4><p>Scores are based only on these 25 statements and are not population percentiles or a clinical measure.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this score carry?</h4><div class="insight-grid"><article><h5>Overall pattern</h5><p>'+escapeHtml(r.compositeLabel)+'</p></article><article><h5>Spread across areas</h5><p>'+escapeHtml(r.spreadLabel)+'</p></article><article><h5>Response pattern</h5><p>'+escapeHtml(r.responseSummary)+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' statements were re-rated. Reconsidering is fine; use real feedback from others when two ratings both feel plausible.</p></article></div></div>'+
      '<div class="result-section"><h4>Where your top two areas create the most leverage at work</h4><p>These are functional directions to investigate, not a guarantee of fit. Every role benefits from emotional skill to some degree.</p><div class="career-grid">'+leverageCards(r.strongLeverage)+'</div></div>'+
      '<div class="result-section"><h4>Where higher pay tends to concentrate around your top areas</h4><p>These are general, directional patterns from common industry knowledge, not guaranteed figures. Always verify current compensation against live job listings for your city and experience level.</p>'+listHtml(r.highPayNotes)+'</div>'+
      '<div class="result-section"><h4>A growth plan for your lowest-scoring area</h4>'+listHtml(r.growthPlan)+'</div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before trusting this score</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a diagnosis</h5><p>It does not measure ability, intelligence, or diagnose any mental-health condition.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 25 statements and are not comparisons with a national, student, or employer norm.</p></article><article><h5>Not proof of behaviour</h5><p>Self-reported scores can differ from how you actually behave. Verify with real feedback from people who know you.</p></article><article><h5>Not complete career clarity</h5><p>Fuller decisions still need demonstrated skill, market evidence, constraints, and real experiments.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'Emotional Intelligence Report',fileName:'future-career-school-emotional-intelligence-report.pdf'});}
</script>
