/* ─────────────────────────────────────────────
   COMPUTE PROFILE WITH PERCENTILES
───────────────────────────────────────────── */
function computeProfile() {
  var riasecKeys = ['R','I','A','S','E','C'];
  var riasecSorted = riasecKeys.slice().sort(function(a,b){ return scores[b]-scores[a]; });
  var primary = riasecSorted[0];
  var secondary = riasecSorted[1];

  var streamKeys = ['pcm','pcb','com','hum'];
  var streamSorted = streamKeys.slice().sort(function(a,b){ return scores[b]-scores[a]; });
  var detectedStream = streamSorted[0];

  var miKeys = ['lin','log','spa','bk','inter','intra','mus','nat'];
  var miSorted = miKeys.slice().sort(function(a,b){ return scores[b]-scores[a]; });
  var topMI = miSorted[0];
  var altMI = miSorted[1];

  var lsKeys = ['vis','aud','kin'];
  var topLS = lsKeys.reduce(function(a,b){ return scores[a]>=scores[b]?a:b; });
  var aptMax = Math.max(scores.num, scores.ver, scores.lgc, 1);

  // Calculate percentiles for all RIASEC dimensions
  var riasecMax = Math.max(scores.R, scores.I, scores.A, scores.S, scores.E, scores.C);
  var percentiles = {};
  riasecKeys.forEach(function(k) {
    percentiles[k] = calculatePercentile(scores[k], 0, riasecMax);
  });

  // Calculate percentiles for aptitudes
  percentiles.num = calculatePercentile(scores.num, 0, aptMax);
  percentiles.ver = calculatePercentile(scores.ver, 0, aptMax);
  percentiles.lgc = calculatePercentile(scores.lgc, 0, aptMax);

  // Calculate stream percentiles
  var streamMax = Math.max(scores.pcm, scores.pcb, scores.com, scores.hum);
  percentiles.pcm = calculatePercentile(scores.pcm, 0, streamMax);
  percentiles.pcb = calculatePercentile(scores.pcb, 0, streamMax);
  percentiles.com = calculatePercentile(scores.com, 0, streamMax);
  percentiles.hum = calculatePercentile(scores.hum, 0, streamMax);

  // Classify strengths
  var strengths = {};
  riasecKeys.forEach(function(k) {
    strengths[k] = classifyStrength(percentiles[k]);
  });
  strengths.num = classifyStrength(percentiles.num);
  strengths.ver = classifyStrength(percentiles.ver);
  strengths.lgc = classifyStrength(percentiles.lgc);

  // Analyze response patterns
  var patterns = analyzeResponsePatterns();

  // Get academic stage
  var stage = inferAcademicStage();

  // Get exam readiness
  var examReadiness = classifyEntranceExamFit(primary, detectedStream);

  // Get dimension interactions
  var dimInteraction = getDimensionInteraction(scores, primary, detectedStream);

  // Detect dimension conflicts
  var conflicts = detectDimensionConflicts(scores, primary, secondary);

  // Get coaches frameworks (High-Income Skills, Deep Skills, Business Types)
  var coachesRecommendations = mapRIASECToCoachesSkills(primary, secondary);

  // Additional metrics
  var cogBalance = calculateCognitiveBalance(scores);
  var readiness = calculateCareerReadiness(patterns, percentiles, primary);
  var lsAlign = calculateLearningStyleAlignment(topLS, primary);
  var aptProfile = calculateAptitudeProfile(scores);
  var adapt = calculateAdaptability(patterns, conflicts);

  return {
    primary: primary,
    secondary: secondary,
    riasecSorted: riasecSorted,
    detectedStream: detectedStream,
    topMI: topMI,
    altMI: altMI,
    topLS: topLS,
    aptMax: aptMax,
    percentiles: percentiles,
    strengths: strengths,
    patterns: patterns,
    stage: stage,
    examReadiness: examReadiness,
    dimInteraction: dimInteraction,
    conflicts: conflicts,
    coachesRecommendations: coachesRecommendations,
    // Additional metrics
    cognitiveBalance: cogBalance,
    careerReadiness: readiness,
    learningStyleAlignment: lsAlign,
    aptitudeProfile: aptProfile,
    adaptabilityIndex: adapt
  };
}

/* ─────────────────────────────────────────────
   BUILD BAR HELPERS
───────────────────────────────────────────── */
function buildRiasecBars(riasecSorted) {
  var maxScore = Math.max.apply(null, riasecSorted.map(function(k){ return scores[k]; }).concat([1]));
  return riasecSorted.map(function(k) {
    var p = RIASEC[k];
    var pct = Math.max(Math.round((scores[k] / maxScore) * 100), 2);
    return '<div class="rb-row">' +
      '<div class="rb-label"><span class="rb-dot" style="background:' + p.color + '"></span>' + p.emoji + ' <strong>' + p.label + '</strong></div>' +
      '<div class="rb-track"><div class="rb-fill" style="width:' + pct + '%;background:' + p.color + '"></div></div>' +
    '</div>';
  }).join('');
}

function buildAptitudeBars(aptMax) {
  var items = [
    { key:'num', label:'Numerical', emoji:'🔢', color:'#6366f1' },
    { key:'ver', label:'Verbal',    emoji:'📝', color:'#8b5cf6' },
    { key:'lgc', label:'Logical',   emoji:'🧩', color:'#14b8a6' },
  ];
  return items.map(function(it) {
    var pct = Math.max(Math.round((scores[it.key] / aptMax) * 100), 2);
    var level = pct >= 80 ? 'Very Strong' : pct >= 55 ? 'Strong' : pct >= 35 ? 'Moderate' : 'Developing';
    return '<div class="apt-row">' +
      '<div class="apt-label">' + it.emoji + ' <strong>' + it.label + '</strong> <span class="apt-level" style="color:' + it.color + '">' + level + '</span></div>' +
      '<div class="apt-track"><div class="apt-fill" style="width:' + pct + '%;background:' + it.color + '"></div></div>' +
    '</div>';
  }).join('');
}

