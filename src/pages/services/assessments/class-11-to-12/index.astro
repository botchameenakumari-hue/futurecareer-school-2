/* ─────────────────────────────────────────────
   QUIZ STATE
───────────────────────────────────────────── */
var currentQ = 0;
var answers = new Array(QUESTIONS.length).fill(null);
var currentLang = 'en';

function getQText(idx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[idx].q;
  var tr = TRANSLATIONS[currentLang];
  return (tr[idx] && tr[idx].q) ? tr[idx].q : QUESTIONS[idx].q;
}
function getOptText(qIdx, optIdx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[qIdx].opts[optIdx].t;
  var tr = TRANSLATIONS[currentLang];
  return (tr[qIdx] && tr[qIdx].opts && tr[qIdx].opts[optIdx]) ? tr[qIdx].opts[optIdx] : QUESTIONS[qIdx].opts[optIdx].t;
}

document.addEventListener('DOMContentLoaded', function() {
  renderQuestion(0);
  updateProgress();

  document.querySelectorAll('.lang-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.remove('lang-btn--active'); });
      this.classList.add('lang-btn--active');
      currentLang = this.getAttribute('data-lang');
      renderQuestion(currentQ);
    });
  });
});

function renderQuestion(idx) {
  var q = QUESTIONS[idx];
  var isMultiselect = q.multiselect === true;
  var questionLabel = 'Question ' + (idx + 1);
  if (isMultiselect) {
    questionLabel += ' (Select all that apply)';
  }
  document.getElementById('q-num').textContent = questionLabel;
  document.getElementById('q-text').textContent = getQText(idx);
  var container = document.getElementById('q-opts');
  container.innerHTML = '';
  var selectedAnswers = isMultiselect ? (answers[idx] || []) : (answers[idx] !== null ? [answers[idx]] : []);

  q.opts.forEach(function(opt, i) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'opt-btn' + (selectedAnswers.includes(i) ? ' selected' : '');
    btn.setAttribute('aria-pressed', selectedAnswers.includes(i) ? 'true' : 'false');
    btn.setAttribute('data-opt-index', i);
    btn.innerHTML = '<span class="opt-letter">' + String.fromCharCode(65 + i) + '</span><span class="opt-text">' + getOptText(idx, i) + '</span>';
    btn.onclick = function() { selectOption(idx, parseInt(this.getAttribute('data-opt-index'))); };
    container.appendChild(btn);
  });
}

function selectOption(qIdx, optIdx) {
  // Safety checks
  if (!QUESTIONS || !QUESTIONS[qIdx]) {
    console.error('Invalid question index:', qIdx);
    return;
  }
  var q = QUESTIONS[qIdx];
  if (!q.opts || !q.opts[optIdx]) {
    console.error('Invalid option index:', optIdx, 'for question:', qIdx, 'Total options:', q.opts ? q.opts.length : 0);
    return;
  }

  var isMultiselect = q.multiselect === true;

  if (isMultiselect) {
    if (!answers[qIdx]) answers[qIdx] = [];
    var idx = answers[qIdx].indexOf(optIdx);
    if (idx > -1) {
      var prev = q.opts[optIdx].s;
      if (prev) Object.keys(prev).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prev[k]; });
      answers[qIdx].splice(idx, 1);
    } else {
      var cur = q.opts[optIdx].s;
      if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
      answers[qIdx].push(optIdx);
    }
  } else {
    if (answers[qIdx] !== null && answers[qIdx] !== undefined) {
      var prevOpt = q.opts[answers[qIdx]];
      if (prevOpt && prevOpt.s) {
        Object.keys(prevOpt.s).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prevOpt.s[k]; });
      }
    }
    var cur = q.opts[optIdx].s;
    if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
    answers[qIdx] = optIdx;
  }
  renderQuestion(qIdx);
  var nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = false;
  nextBtn.focus();
}

function nextQuestion() {
  var q = QUESTIONS[currentQ];
  var isMultiselect = q && q.multiselect === true;
  var isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);
  if (!isAnswered) return;
  currentQ++;
  if (currentQ >= QUESTIONS.length) { showResults(); return; }
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function prevQuestion() {
  if (currentQ === 0) return;
  currentQ--;
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function updateProgress() {
  var total = QUESTIONS.length;
  var pct = Math.round((currentQ / total) * 100);
  document.getElementById('q-counter').textContent = 'Question ' + (currentQ + 1) + ' of ' + total;
  document.getElementById('q-pct').textContent = pct + '% complete';
  var fill = document.getElementById('progress-fill');
  fill.style.width = pct + '%';
  fill.closest('[role=progressbar]').setAttribute('aria-valuenow', pct);
  document.getElementById('btn-back').disabled = currentQ === 0;

  var q = QUESTIONS[currentQ];
  var isMultiselect = q && q.multiselect === true;
  var isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);

  var nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = !isAnswered;
  var isLast = currentQ === total - 1;
  nextBtn.innerHTML = (isLast ? 'See My Results' : 'Next Question') + ' <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>';
}

globalThis.prevQuestion = prevQuestion;
globalThis.nextQuestion = nextQuestion;
</script>

