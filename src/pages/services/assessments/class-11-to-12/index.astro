---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/class-11-to-12/';
const plansConfig = getAssessmentPlansConfig('student');
const guidanceCardHref = plansConfig.jumpHref;
const guidanceResultsHref = plansConfig.jumpHref;
const guidanceResultsLabel = plansConfig.jumpLabel;
const focusedTests = [
  {
    href: '/services/assessments/stream-selector-test-after-12th/',
    title: 'Career Test After 12th',
    description: 'A quick 15-question test for broad course and career-direction clarity after Class 12.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-12th/',
    title: 'Career Aptitude Test After 12th',
    description: 'A focused aptitude test for clearer strength-fit before choosing a degree or course.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Career Assessment for Class 11 and 12', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Career Assessment for Class 11 and 12 Students',
    description: 'A free 25-question psychometric career assessment for Class 11 and 12 students across all streams — PCM, PCB, Commerce, and Humanities. Covers RIASEC career interests, multiple intelligence profile, aptitude signals, learning style, college entrance strategy, and career direction within your stream. Instant results. No sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Who should take this assessment?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Class 11 and 12 students across all streams — Science PCM, Science PCB, Commerce, and Humanities. The assessment adapts its career guidance and college entrance strategy to your stream. Whether you are in Class 11 just starting out or in Class 12 making final decisions, this assessment gives you a structured picture of your career direction.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is this assessment free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Completely free. No sign-up, no payment, no login required.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does this assessment cover?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Six things in 25 questions: (1) RIASEC career interest profile, (2) College entrance strategy personalised to your stream, (3) Multiple intelligence profile, (4) Aptitude signals — numerical, verbal, logical, (5) Learning style, and (6) Career direction within your specific stream with entrance exam guidance.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does it matter which stream I am in?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No — and yes. The assessment works for all stream students. Your RIASEC type, multiple intelligence profile, and aptitude signals are universal. But the career table, college entrance guidance, and reflection questions are personalised to your stream based on your answers.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long does this take?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'About 15 to 20 minutes. There are 25 questions. The results are detailed — give yourself time to read them properly.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Free Career Assessment for Class 11 and 12 Students | Future Career School"
  description="Free 25-question psychometric career assessment for Class 11 and 12 students — all streams. Covers RIASEC career interests, college entrance strategy, multiple intelligence profile, aptitude signals, and career direction. Instant results. No sign-up."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Class 11 &amp; 12</span>
      </nav>

      <div class="pill">
        <span class="dot"></span>
        Free &nbsp;&middot;&nbsp; 25 Questions &nbsp;&middot;&nbsp; All Streams &nbsp;&middot;&nbsp; Instant Results &nbsp;&middot;&nbsp; No Sign-Up
      </div>

      <h1>
        Free Career Assessment for<br/>
        <span class="gold-text">Class 11 &amp; 12 Students</span>
      </h1>

      <p class="hero-sub">
        Stream chosen. Now what? This assessment maps your RIASEC career type, multiple intelligence profile,
        aptitude signals, and college entrance strategy — all personalised to your stream.
        Works for PCM, PCB, Commerce, and Humanities students.
      </p>

      <div class="meta-chips">
        <span class="meta-chip">&#128203; 25 questions</span>
        <span class="meta-chip">&#9200; ~18 minutes</span>
        <span class="meta-chip">&#127775; Instant results</span>
        <span class="meta-chip">&#9989; 100% free</span>
        <span class="meta-chip">&#128100; Class 11–12 · All streams</span>
        <span class="meta-chip">&#127919; 6 tests in one</span>
      </div>

      <div class="hero-actions">
        <a href="#assessment" class="btn-gold pulse hero-cta">
          Start Free Assessment
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href={plansConfig.jumpHref} class="btn-outline hero-cta">{plansConfig.jumpLabel}</a>
      </div>
    </div>
  </section>

  <div class="assessment-first-flow">
  <!-- WHAT THIS TESTS -->
  <section id="what-this-tests">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--teal)">&#9673;</span>&nbsp;What This Assessment Covers
      </div>
      <h2 class="section-title">Six Tests. One Assessment. Personalised to Your Stream.</h2>
      <p class="section-sub">
        25 questions capture multiple signals at once — RIASEC type, intelligence profile, aptitude,
        learning style, and a college entrance roadmap specific to the stream you are in right now.
      </p>

      <div class="signals-grid">
        <div class="signal-card signal-riasec">
          <div class="signal-icon-wrap"><span class="signal-icon">&#127919;</span></div>
          <div class="signal-tag">RIASEC Model</div>
          <h3>Career Interest Profile</h3>
          <p>Maps your interests across all 6 Holland types — Realistic, Investigative, Artistic, Social, Enterprising, and Conventional — to identify your career personality code regardless of stream.</p>
        </div>
        <div class="signal-card signal-stream">
          <div class="signal-icon-wrap"><span class="signal-icon">&#127891;</span></div>
          <div class="signal-tag">College Strategy</div>
          <h3>College Entrance Roadmap</h3>
          <p>Based on your stream, maps the specific entrance exams to target (JEE / NEET / CA Foundation / CLAT / CUET), timeline, and career paths that open from your combination of stream and RIASEC type.</p>
        </div>
        <div class="signal-card signal-mi">
          <div class="signal-icon-wrap"><span class="signal-icon">&#129504;</span></div>
          <div class="signal-tag">Gardner's 8 Types</div>
          <h3>Multiple Intelligence Profile</h3>
          <p>Identifies your dominant intelligence type from Gardner's 8 — and connects it to how you process information, which careers suit your cognitive style, and how to study more effectively.</p>
        </div>
        <div class="signal-card signal-apt">
          <div class="signal-icon-wrap"><span class="signal-icon">&#129299;</span></div>
          <div class="signal-tag">Aptitude Signals</div>
          <h3>Numerical, Verbal &amp; Logical Aptitude</h3>
          <p>Captures your relative strengths across three aptitude dimensions — numerical, verbal, and logical reasoning — and maps them to the specific career directions that reward each one.</p>
        </div>
        <div class="signal-card signal-ls">
          <div class="signal-icon-wrap"><span class="signal-icon">&#127775;</span></div>
          <div class="signal-tag">VAK Framework</div>
          <h3>Learning Style Assessment</h3>
          <p>Identifies whether you learn best visually, auditorily, or kinesthetically — with specific study techniques for Class 11-12 board and entrance exam preparation based on your style.</p>
        </div>
        <div class="signal-card signal-career">
          <div class="signal-icon-wrap"><span class="signal-icon">&#128172;</span></div>
          <div class="signal-tag">Career Discovery</div>
          <h3>Career Direction Assessment</h3>
          <p>Combines your RIASEC type, stream, and intelligence profile to show the specific career paths worth pursuing — with entrance exam requirements and the skill to start building now.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--gold)">&#128203;</span>&nbsp;Career Assessment
      </div>
      <h2 class="section-title">Discover Your Career Direction</h2>
      <p class="section-sub">
        Read each question carefully. Choose the option that is most genuinely true for you —
        not what sounds impressive or what you think you should say. There are no right or wrong answers.
      </p>

      <!-- LANGUAGE SELECTOR -->
      <div class="lang-selector" id="lang-selector">
        <span class="lang-label">Language:</span>
        <button class="lang-btn lang-btn--active" data-lang="en">English</button>
        <button class="lang-btn" data-lang="hi">हिन्दी</button>
        <button class="lang-btn" data-lang="te">తెలుగు</button>
        <button class="lang-btn" data-lang="ta">தமிழ்</button>
        <button class="lang-btn" data-lang="mr">मराठी</button>
      </div>

      <!-- QUIZ CONTAINER -->
      <div id="quiz-container" class="quiz-box">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 25</span>
            <span id="q-pct" class="q-pct">0% complete</span>
          </div>
          <div class="progress-bar-wrap" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>

        <div id="q-display">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading question...</p>
          <div id="q-opts" class="q-opts" role="group" aria-labelledby="q-text"></div>
        </div>

        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Back
          </button>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()">
            Next Question
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- RESULTS CONTAINER -->
      <div id="results-container" class="results-box" style="display:none" aria-live="polite"></div>
    </div>
  </section>
  </div>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--gold)">&#10067;</span>&nbsp;Questions About This Assessment
      </div>
      <h2 class="section-title">Common Questions</h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">I am already in Class 12. Is this still useful?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Yes — especially if you have not clearly mapped your career direction or college entrance strategy yet. Class 12 students often know their stream but have not connected it to a specific career path. This assessment does that mapping. The reflection questions at the end are particularly useful for students close to making final decisions.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What if my stream and my RIASEC type don't match well?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">This is more common than you think — and it is important information. It does not mean you are in the wrong stream. RIASEC type describes your natural interests and inclinations. Many students with an Artistic RIASEC type are in PCM and find careers in architecture or UX design. Many Investigative types are in Commerce and thrive in fintech or data analytics. The results show you the specific paths where your type and stream actually intersect, not just the obvious ones.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Does this assessment tell me which college or entrance exam to target?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Yes — it provides a College Entrance Strategy section personalised to your stream (JEE / NEET / CA Foundation / CLAT / CUET depending on what you are studying). It gives you the relevant exams, a preparation timeline, and the career paths that open from each. For a more detailed, personalised plan — including which specific colleges to target based on your current preparation level — the stronger move is updated, skill-first career guidance built around your future readiness and long-term direction.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">What is the RIASEC model?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">RIASEC is a career personality framework developed by psychologist John Holland. It identifies six types — Realistic, Investigative, Artistic, Social, Enterprising, and Conventional. Your top two types form your Holland Code. It is one of the most widely validated tools in career counselling and helps predict which types of work you will find naturally engaging versus draining over a long career.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">Is this result a final career decision?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">No. This is a structured starting point — a framework for thinking about direction, not a final answer. It identifies patterns worth taking seriously. For decisions as significant as college choice or career commitment, the stronger move is updated, skill-first career guidance that accounts for your specific situation, constraints, and long-term goals.</div>
        </details>

        <details class="faq-item">
          <summary class="faq-q">How is this different from a standard aptitude test?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">A standard aptitude test measures ability under pressure. This maps interest, natural inclination, and cognitive style — what you are drawn toward, how your mind works best, and which kinds of problems energise you. For career direction, how you naturally think is often more predictive than what you can produce under exam conditions. Both matter, but they answer different questions.</div>
        </details>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="focused-tests"
    title="Focused Free Tests for After 12th"
    subtitle="If you want a quicker answer to one specific decision after Class 12, use these dedicated free assessments."
    items={focusedTests}
    altBackground={true}
  />

  <!-- INTERNAL LINKS -->
  <section id="next-steps">
    <div class="container">
      <div class="section-pill">
        <span style="color:var(--teal)">&#8635;</span>&nbsp;After This Assessment
      </div>
      <h2 class="section-title">Where to Go Next</h2>
      <p class="section-sub">This assessment is a starting point. These options help you move from free clarity to a stronger academic and career decision.</p>
      <div class="links-grid">
        <a href={guidanceCardHref} class="link-card">
          <div class="lc-icon">&#128172;</div>
          <div>
            <div class="lc-title">See Student Guidance Plans</div>
            <div class="lc-desc">Move from free results to a paid guidance plan when the next course or career decision needs stronger support.</div>
          </div>
        </a>
        <a href="#guidance-bridge" class="link-card">
          <div class="lc-icon">&#127891;</div>
          <div>
            <div class="lc-title">Why Paid Guidance Helps</div>
            <div class="lc-desc">See why updated, skill-first guidance gives fuller clarity than a free test alone.</div>
          </div>
        </a>
        <a href="/services/assessments" class="link-card">
          <div class="lc-icon">&#128203;</div>
          <div>
            <div class="lc-title">All Assessments</div>
            <div class="lc-desc">See all career assessment tools available across different life stages</div>
          </div>
        </a>
        <a href="/services/assessments/class-10-and-below" class="link-card">
          <div class="lc-icon">&#128218;</div>
          <div>
            <div class="lc-title">Class 10 Assessment</div>
            <div class="lc-desc">Share this with a younger sibling — the Class 10 version covers stream selection</div>
          </div>
        </a>
        <a href="/career-skills-compass" class="link-card">
          <div class="lc-icon">&#128269;</div>
          <div>
            <div class="lc-title">Career & Skills Compass</div>
            <div class="lc-desc">Explore which high-value skills match your thinking style and career direction</div>
          </div>
        </a>
        <a href="/services" class="link-card">
          <div class="lc-icon">&#9881;&#65039;</div>
          <div>
            <div class="lc-title">Career Guidance and Assessments</div>
            <div class="lc-desc">See career guidance, assessments, and tools in one place.</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <AssessmentGuidanceCta mode="student" sectionId="guidance-bridge" />

  <GuidancePlansSection
    sectionId="plans"
    audience={plansConfig.audience}
    serviceLabel={plansConfig.serviceLabel}
    title={plansConfig.sectionTitle}
  />

  <AssessmentReportTools
    title="Class 11 and 12 Career Assessment Report"
    fileName="class-11-12-career-assessment-report.pdf"
    reportKicker="STREAM AND CAREER DIRECTION REPORT"
    guidanceLabel="Explore Guidance After Class 12"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance-after-12th/"
  />
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ guidanceResultsHref, guidanceResultsLabel }}>
globalThis.guidanceResultsHref = guidanceResultsHref;
globalThis.guidanceResultsLabel = guidanceResultsLabel;
</script>
<script is:inline>
/* ─────────────────────────────────────────────
   SCORE DIMENSIONS
   RIASEC: R, I, A, S, E, C
   Multiple Intelligence: lin, log, spa, bk, inter, intra, mus, nat
   Aptitude signals: num, ver, lgc
   Learning style: vis, aud, kin
   Stream detection: pcm, pcb, com, hum
───────────────────────────────────────────── */
var scores = { R:0,I:0,A:0,S:0,E:0,C:0, lin:0,log:0,spa:0,bk:0,inter:0,intra:0,mus:0,nat:0, num:0,ver:0,lgc:0, vis:0,aud:0,kin:0, pcm:0,pcb:0,com:0,hum:0 };

/* ─────────────────────────────────────────────
   QUESTIONS (25)
   Q1 is explicit stream detection.
   All others score RIASEC + MI + aptitude + learning style.
───────────────────────────────────────────── */
var QUESTIONS = [
  {
    q: "Which stream are you in right now?",
    opts: [
      { t: "Science - Physics, Chemistry, Maths", s: {pcm:8,I:1,log:1,num:1} },
      { t: "Science - Physics, Chemistry, Biology", s: {pcb:8,I:1,nat:1} },
      { t: "Commerce - Business and Maths", s: {com:8,E:1,C:1,num:1} },
      { t: "Humanities - History, Politics, Sociology, Literature", s: {hum:8,A:1,S:1,ver:1} },
    ]
  },
  {
    q: "In 10 years, what does success mean to you?",
    opts: [
      { t: "Lead a research team or run a technical company at the top", s: {I:3,log:2,intra:1,pcm:1} },
      { t: "Run my own company or be a leader in a big organization", s: {E:3,inter:1,com:1,lin:1} },
      { t: "Make work like writing, design, film, or music that many people love", s: {A:3,lin:1,spa:1,hum:1} },
      { t: "Help people's lives through care, teaching, or social work", s: {S:3,inter:2,pcb:1,hum:1} },
    ]
  },
  {
    q: "What kind of problem makes you happiest when you solve it?",
    opts: [
      { t: "A hard math problem or system where you figure it out step by step", s: {I:2,C:1,log:2,num:3,lgc:1} },
      { t: "Writing an essay or making an argument with your own idea", s: {A:2,lin:2,ver:3,hum:1} },
      { t: "A business problem where you find the best choice", s: {E:2,C:2,num:2,lgc:1,com:2} },
      { t: "A science problem where you observe and understand why", s: {I:2,R:1,nat:2,log:1,pcb:1} },
    ]
  },
  {
    q: "If you work on one project for a year, which is most meaningful?",
    opts: [
      { t: "Build a tech product or system that solves a real problem", s: {I:2,E:1,log:2,pcm:2,vis:1} },
      { t: "Make a film, book, or campaign that tells an important story", s: {A:3,lin:1,spa:1,hum:1,vis:1} },
      { t: "Start and grow a real business or social project", s: {E:3,inter:1,com:2,intra:1} },
      { t: "Do science research or work directly in health or community care", s: {I:2,S:1,nat:1,pcb:1,hum:1} },
    ]
  },
  {
    q: "When facing something hard and new, how do you start?",
    opts: [
      { t: "Read and learn - I study before I start anything", s: {I:3,intra:2,log:1,lgc:1} },
      { t: "Just do it - I learn by trying and failing", s: {R:3,bk:2,kin:2,E:1} },
      { t: "Talk it through - I think best by discussing with others", s: {S:2,E:1,inter:2,aud:2} },
      { t: "Make a plan - I break it down into steps and follow them", s: {C:3,log:1,lgc:2,vis:1} },
    ]
  },
  {
    q: "Which challenge excites you, not scares you?",
    opts: [
      { t: "Solve a hard problem that others gave up on", s: {I:3,lgc:3,log:2} },
      { t: "Convince people to believe in your idea", s: {E:3,inter:1,lin:1,aud:1} },
      { t: "Make something new and original under pressure", s: {A:3,spa:1,lin:1,intra:1} },
      { t: "Manage many things at once without dropping anything", s: {C:3,log:1,lgc:2,vis:1} },
    ]
  },
  {
    q: "What goals excite you? (Pick all that matter to you)",
