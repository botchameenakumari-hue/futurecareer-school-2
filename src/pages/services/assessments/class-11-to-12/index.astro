function getBiologyCheck() {
  var people   = scores.S * 1.5 + scores.E * 0.8;
  var alone    = scores.I * 1.5 + scores.C * 0.8;
  var feelings = scores.A * 1.5 + scores.S * 0.8;
  var rules    = scores.I + scores.C * 1.5;
  var making   = scores.A + scores.R + scores.E * 0.8;
  var fixing   = scores.I + scores.C;
  return {
    peoplePct:   Math.round(people   / Math.max(people   + alone,  1) * 100),
    feelingsPct: Math.round(feelings / Math.max(feelings + rules,  1) * 100),
    makingPct:   Math.round(making   / Math.max(making   + fixing, 1) * 100),
  };
}

/* ─────────────────────────────────────────────
   COMPREHENSIVE HELPER FUNCTIONS - DEEP PERSONALIZATION
───────────────────────────────────────────── */

function calculatePercentile(score, min, max) {
  if (max <= min) return 50;
  return Math.round(((score - min) / (max - min)) * 100);
}

function classifyStrength(percentile) {
  if (percentile >= 85) return {tier: 'Critical Strength', icon: '🔴', color: '#ef4444'};
  if (percentile >= 70) return {tier: 'Strong', icon: '🟠', color: '#f59e0b'};
  if (percentile >= 50) return {tier: 'Moderate', icon: '🟡', color: '#eab308'};
  if (percentile >= 30) return {tier: 'Emerging', icon: '🟢', color: '#10b981'};
  return {tier: 'Developing', icon: '⚪', color: '#6b7a99'};
}

function analyzeResponsePatterns() {
  var allScores = Object.keys(scores).map(function(k) { return scores[k]; });
  var avgScore = allScores.reduce(function(a,b){return a+b;},0) / allScores.length;
  var variance = allScores.reduce(function(sum, s) { return sum + Math.pow(s - avgScore, 2); }, 0) / allScores.length;
  var stdDev = Math.sqrt(variance);

  var convictionLevel = stdDev > 3 ? 'High' : stdDev > 1.5 ? 'Moderate' : 'Exploring';
  var consistency = 100 - Math.min(100, stdDev * 15);

  return {
    convictionLevel: convictionLevel,
    consistency: Math.round(consistency),
    avgScore: Math.round(avgScore),
    variance: Math.round(variance * 100) / 100,
    interpretation: convictionLevel === 'High' ? 'Your answers show strong, consistent conviction about your direction.' :
                   convictionLevel === 'Moderate' ? 'Your answers show moderate clarity — you have a direction but are still exploring.' :
                   'Your answers are varied — you\'re exploring multiple directions, which is normal and healthy.'
  };
}

function inferAcademicStage() {
  var stage = 'Mid-Class-11';
  var monthsUntilExam = 20;
  var urgency = 'Moderate';

  if (answers[10] !== null && answers[15] !== null) {
    var examUrgency = (QUESTIONS[10].opts[answers[10]].text||'').toLowerCase().includes('urgent') ? 1 : 0;
    var timeAwareness = (QUESTIONS[15].opts[answers[15]].text||'').toLowerCase().includes('soon') ? 1 : 0;

    if (examUrgency + timeAwareness >= 2) {
      stage = 'Late-Class-12';
      monthsUntilExam = 3;
      urgency = 'Critical';
    } else {
      stage = 'Mid-to-Late-Class-11';
      monthsUntilExam = 14;
      urgency = 'Moderate';
    }
  }

  return { stage: stage, monthsUntilExam: monthsUntilExam, urgency: urgency };
}

function classifyEntranceExamFit(riasecPrimary, detectedStream) {
  // Calculate max scores for normalization
  var riasecMax = Math.max(scores.R, scores.I, scores.A, scores.S, scores.E, scores.C);
  var aptMax = Math.max(scores.num, scores.ver, scores.lgc, 1);

  var readiness = {};

  // JEE (PCM students)
  if (detectedStream === 'pcm') {
    var jeeScore = (scores.lgc/aptMax * 40) + (scores.num/aptMax * 35) + (riasecPrimary === 'I' ? 25 : riasecPrimary === 'R' ? 15 : 5);
    readiness.jee = Math.min(100, Math.round(jeeScore));
  } else {
    readiness.jee = 20;
  }

  // NEET (PCB students)
  if (detectedStream === 'pcb') {
    var neetScore = (scores.ver/aptMax * 30) + (scores.num/aptMax * 25) + (riasecPrimary === 'I' || riasecPrimary === 'S' ? 25 : 10);
    readiness.neet = Math.min(100, Math.round(neetScore));
  } else {
    readiness.neet = 20;
  }

  // CLAT
  if (detectedStream === 'hum' || detectedStream === 'com') {
    var clatScore = (scores.ver/aptMax * 40) + (scores.lgc/aptMax * 40) + (riasecPrimary === 'A' || riasecPrimary === 'S' ? 20 : 10);
    readiness.clat = Math.min(100, Math.round(clatScore));
  } else {
    readiness.clat = 25;
  }

  // CA Foundation
  if (detectedStream === 'com') {
    var caScore = (scores.num/aptMax * 50) + (riasecPrimary === 'C' ? 30 : riasecPrimary === 'I' ? 20 : 5);
    readiness.ca = Math.min(100, Math.round(caScore));
  } else {
    readiness.ca = 15;
  }

  // CUET
  readiness.cuet = Math.min(100, Math.round((scores.ver/aptMax * 30) + (scores.lgc/aptMax * 30) + 40));

  return readiness;
}

function getExamReadinessInterpretation(readiness, examType) {
  var score = readiness[examType];
  if (score >= 75) {
    return {message: 'Excellent readiness. You have strong foundational aptitude for this exam. With focused preparation, you are positioned for top performance.', color: '#10b981', icon: '✓'};
  } else if (score >= 60) {
    return {message: 'Good readiness. You have adequate aptitude. Success requires consistent, structured preparation and possibly guided coaching.', color: '#f59e0b', icon: '◐'};
  } else if (score >= 40) {
    return {message: 'Developing readiness. You have foundational potential but will need intensive preparation and strong mentoring to succeed.', color: '#ec4899', icon: '→'};
  } else {
    return {message: 'Build foundations first. Your current aptitude profile suggests this exam requires significant skill-building before core exam prep.', color: '#ef4444', icon: '⚠'};
  }
}

function getDimensionInteraction(scores, riasecPrimary, detectedStream) {
  var aptTotal = scores.num + scores.ver + scores.lgc;
  var aptMax = Math.max(scores.num, scores.ver, scores.lgc);

  var interaction = '';
  var strength = '';
  var caution = '';

  if (riasecPrimary === 'I' && scores.lgc > scores.num) {
    interaction = 'Analytical + Logical Focus';
    strength = 'You naturally gravitate toward pattern-recognition and systematic problem-solving. This is your highest leverage in competitive exams.';
    caution = 'Ensure you also build speed and application skills — not just conceptual understanding.';
  } else if (riasecPrimary === 'I' && scores.num > scores.lgc) {
    interaction = 'Analytical + Quantitative Focus';
    strength = 'You combine analytical thinking with numerical strength. Mathematics and quantitative reasoning are your natural advantages.';
    caution = 'In exams like NEET where language is critical, don\'t neglect verbal comprehension.';
  } else if (riasecPrimary === 'S' || riasecPrimary === 'A') {
    interaction = 'Creative/People-Oriented Profile in Academic Stream';
    strength = 'Your strength is in understanding concepts deeply and communicating them. You excel at subjects with real-world application.';
    caution = 'Competitive exams reward precision and speed. Build systematic practice habits to complement your conceptual strength.';
  } else if (riasecPrimary === 'R' && detectedStream === 'pcm') {
    interaction = 'Practical Learner in Technical Stream';
    strength = 'You learn best through hands-on application and real-world problem-solving. Physics practicals and engineering applications energize you.';
    caution = 'Board exams and competitive exams require theoretical knowledge too. Balance practical work with conceptual study.';
  } else {
    interaction = 'Your Dimension Balance';
    strength = 'Your profile suggests a versatile learner with multiple strengths. Use this flexibility to find subjects that genuinely interest you.';
    caution = 'With versatility comes the risk of spreading too thin. Focus preparation on exam requirements, not just interests.';
  }

  return { interaction: interaction, strength: strength, caution: caution };
}

function detectDimensionConflicts(riasecScores, primary, secondary) {
  var conflicts = [];
  var r = riasecScores.R; var i = riasecScores.I; var a = riasecScores.A;
  var s = riasecScores.S; var e = riasecScores.E; var c = riasecScores.C;

  // Conflict 1: High E (entrepreneurial) but Low R (practical implementation)
  if (e >= 35 && r <= 20) {
    conflicts.push({
      conflict: 'Visionary without Builder Energy',
      impact: 'You have leadership and idea energy, but may struggle with hands-on execution and practical details.',
      solution: 'Find a co-founder or mentor who is high-R (hands-on). Pair your vision with operational support. Roles: Product Manager, Founder + CTO partnership.',
      skills_to_build: ['Delegation', 'Systems Thinking', 'Project Management', 'Prototype Building']
    });
  }

  // Conflict 2: High A (creative) but Low E and Low S (isolation risk)
  if (a >= 35 && e <= 20 && s <= 20) {
    conflicts.push({
      conflict: 'Creative Perfectionist in Isolation',
      impact: 'You create beautiful work but may struggle to share it, market it, or work with teams.',
      solution: 'Build a small trusted team or find mentors in design/creative fields who can teach business side. Roles: Designer with business partner, Creative director.',
      skills_to_build: ['Storytelling', 'Collaboration', 'Design Thinking', 'Portfolio Building']
    });
  }

  // Conflict 3: High C (precision) but High E (startup impulse) - tension between order and chaos
  if (c >= 35 && e >= 35) {
    conflicts.push({
      conflict: 'Perfectionist Startup Builder',
      impact: 'You want to build quickly AND perfectly — which creates decision paralysis. Startups require messy action; perfection comes later.',
      solution: 'Embrace phased execution: Ship messy MVP, then perfect. Or choose structured growth (corporate track) over startup chaos. Roles: Operations-focused founder, Corporate leader.',
      skills_to_build: ['Rapid Prototyping', 'Lean Methodology', 'Risk Management', 'Decision Making']
    });
  }

  // Conflict 4: High I (analytical) but Low C (disorganised execution)
  if (i >= 35 && c <= 20) {
    conflicts.push({
      conflict: 'Brilliant Ideas, Disorganised Implementation',
      impact: 'Your thinking is deep and nuanced, but execution falls apart due to lack of structure and follow-through.',
      solution: 'Hire or partner with organized people. Your strength is problem-solving, not project management. Roles: Research, Analysis, Strategy — with support team.',
      skills_to_build: ['Documentation', 'Process Design', 'Time Management', 'Delegation']
    });
  }

  // Conflict 5: High S (people-focused) but High I (withdrawn thinker) - overthinking vs connecting
  if (s >= 35 && i >= 35 && s > i + 10) {
    conflicts.push({
      conflict: 'People-Focused Analytical Mind',
      impact: 'You naturally connect with people AND think deeply. Your strength: complex human systems, psychology, behavioral data.',
      solution: 'Lean into this unique combination. Roles: UX research, Organizational psychology, Social science research, Empathetic product design.',
      skills_to_build: ['User Research', 'Data Analysis', 'Psychology Fundamentals', 'Communication']
    });
  }

  return conflicts;
}

