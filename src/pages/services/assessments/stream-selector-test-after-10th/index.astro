---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';

const pageUrl = 'https://futurecareerschool.com/services/assessments/stream-selector-test-after-10th/';
const keywordAliases = [
  'stream selector test after 10th',
  'stream selector test after 10th free',
  'which stream to choose after 10th quiz',
  'after 10th stream selection quiz',
];
const relatedLinks = [
  {
    href: '/services/assessments/class-10-and-below/',
    title: 'Full Class 10 Assessment',
    description: 'Go deeper with the broader Class 10 assessment for psychometric input, stream fit, and early direction.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-10th/',
    title: 'Career Aptitude Test After 10th',
    description: 'Pair this with the aptitude test if you also want strength-fit clarity alongside stream clarity.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-12th/',
    title: 'Career Test After 12th',
    description: 'Save the after-12th version for the next stage when you start choosing degree and career paths.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Browse every free assessment, stream quiz, and aptitude test available across stages.',
  },
];

const faqs = [
  {
    q: 'What is a stream selector test after 10th?',
    a: 'It is a short, free quiz that helps a Class 10 student see which stream fits them best — Science with Maths, Science with Biology, Commerce, or Arts. You answer 15 simple questions about what you like and what you are good at, and you get an instant result.',
  },
  {
    q: 'Is this stream selector test after 10th free?',
    a: 'Yes. It is fully free. There is no login, no payment, and no sign-up. You get your result right away.',
  },
  {
    q: 'Is this the same as a which stream to choose after 10th quiz?',
    a: 'Yes. Students often search for this page using phrases like which stream to choose after 10th quiz or stream selector test after 10th free. It is the same type of quick stream-fit quiz.',
  },
  {
    q: 'Should I also take an aptitude test after 10th?',
    a: 'Usually yes. This quiz helps with the stream decision. An aptitude test after 10th helps you understand your natural strengths. Together they reduce the chance of choosing a stream only because of marks, friends, or pressure.',
  },
  {
    q: 'Which streams does the test cover?',
    a: 'Four streams: Science with Maths (PCM), Science with Biology (PCB), Commerce, and Arts or Humanities. You see your best-fit stream and your second-best stream too.',
  },
];

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Stream Selector Test After 10th', item: pageUrl },
    ],
  },
  {
    '@type': 'WebApplication',
    name: 'Stream Selector Test After 10th',
    description: 'A free 15-question stream selector test for students after Class 10. Find your best-fit stream — Science (PCM), Science (PCB), Commerce, or Arts. Simple words, instant result, no sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': 'EducationalOrganization', name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Stream Selector Test After 10th | Free Which Stream to Choose After 10th Quiz | Future Career School"
  description="Free stream selector test after 10th. Take this which stream to choose after 10th quiz and find your best-fit stream — PCM, PCB, Commerce, or Arts — with instant results."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Stream Selector Test After 10th</span>
      </nav>

      <div class="pill">
        <span class="dot"></span>
        Free &nbsp;&middot;&nbsp; 15 Questions &nbsp;&middot;&nbsp; Stream Quiz After 10th &nbsp;&middot;&nbsp; Instant Result
      </div>

      <h1>
        Stream Selector Test
        <span class="gold-text">After 10th</span>
      </h1>

      <p class="hero-sub">
        If you are trying to figure out which stream to choose after 10th, this free stream selector test makes that decision easier.
        Answer 15 short questions about what you like and what you are good at, and see your best-fit stream right away — Science, Commerce, or Arts.
      </p>

      <div class="meta-chips">
        <span class="meta-chip">📘 15 questions</span>
        <span class="meta-chip">⏱️ About 9 minutes</span>
        <span class="meta-chip">🎯 Instant result</span>
        <span class="meta-chip">✅ 100% free</span>
        <span class="meta-chip">🆓 No sign-up</span>
      </div>

      <div class="meta-chips meta-chips-keywords">
        {keywordAliases.map((keyword) => <span class="meta-chip meta-chip-muted">{keyword}</span>)}
      </div>

      <a href="#assessment" class="btn-gold pulse hero-cta">Start the Test</a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="container">
      <h2 class="section-title">How This Test Works</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-num">1</div>
          <h3>Answer 15 questions</h3>
          <p>Each question is short and uses easy words. Just pick the answer that feels most true for you.</p>
        </div>
        <div class="how-card">
          <div class="how-num">2</div>
          <h3>We add up your answers</h3>
          <p>Your answers point to one of four streams. The test counts them for you. No marks, no pass or fail.</p>
        </div>
        <div class="how-card">
          <div class="how-num">3</div>
          <h3>Get your best stream</h3>
          <p>You see your top stream and your second stream, with the subjects and jobs that go with each one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <h2 class="section-title">Find Your Stream</h2>
      <p class="section-sub">
        There are no right or wrong answers. Pick what is true for you — not what your friends pick.
      </p>

      <div id="quiz-container" class="quiz-box">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 15</span>
            <span id="q-pct" class="q-pct">0% done</span>
          </div>
          <div class="progress-bar-wrap">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>

        <div id="q-display">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading...</p>
          <div id="q-opts" class="q-opts"></div>
        </div>

        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()">Back</button>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()">Next</button>
        </div>
      </div>

      <div id="results-container" class="results-box" style="display:none" aria-live="polite"></div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <h2 class="section-title">Common Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="related-assessment-pages"
    title="More Assessment Pages Around Stream Choice"
    subtitle="Use these pages together when you want stream clarity now and broader career-direction clarity for the next stage."
    items={relatedLinks}
    altBackground={true}
  />

  <!-- CTA -->
  <section id="cta">
    <div class="container cta-inner">
      <h2 class="cta-headline">Want a Full Plan, Not Just a Result?</h2>
      <p class="cta-sub">
        This test shows your direction. A one-on-one career guidance session turns that into a clear plan —
        which subjects to take, which exams to aim for, and what to do next.
      </p>
      <div class="cta-actions">
        <a href="/services/career-counselling-and-career-guidance" class="btn-gold pulse">Get Career Guidance</a>
        <a href="/services/assessments" class="btn-outline">See All Assessments</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style is:global>
  #hero { padding: 130px 0 70px; position: relative; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .5rem; font-size: 13px; color: rgba(255,255,255,.45); margin-bottom: 1.5rem; }
  .breadcrumb a:hover { color: var(--gold); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }
  #hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; color: #fff; margin: 1.25rem 0; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 17px); line-height: 1.8; color: rgba(255,255,255,.6); max-width: 660px; margin-bottom: 1.75rem; }
  .meta-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin-bottom: 2rem; }
  .meta-chip { font-size: 13px; font-weight: 600; color: rgba(255,255,255,.72); background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 999px; padding: .4rem .85rem; }
  .meta-chips-keywords { margin-top: -0.4rem; }
  .meta-chip-muted { color: rgba(255,255,255,.58); }
  .hero-cta { font-size: 15px; padding: 15px 32px; }

  section { padding: 4.5rem 0; }
  .section-title { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: #fff; text-align: center; margin-bottom: .75rem; }
  .section-sub { font-size: 15px; line-height: 1.7; color: rgba(255,255,255,.6); text-align: center; max-width: 600px; margin: 0 auto 2rem; }

  /* How it works */
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; }
  .how-card { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 1.75rem 1.5rem; }
  .how-num { width: 38px; height: 38px; border-radius: 50%; background: rgba(229,184,74,.14); border: 1px solid rgba(229,184,74,.35); color: var(--gold); font-weight: 800; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .how-card h3 { font-size: 17px; color: #fff; margin-bottom: .5rem; }
  .how-card p { font-size: 14px; line-height: 1.65; color: rgba(255,255,255,.62); }

  /* Quiz */
  #assessment { text-align: center; }
  .quiz-box { max-width: 720px; margin: 0 auto; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem 2.1rem; text-align: left; }
  .quiz-progress { margin-bottom: 1.6rem; }
  .progress-header { display: flex; justify-content: space-between; margin-bottom: .55rem; }
  .q-counter { font-size: 12px; font-weight: 700; color: rgba(255,255,255,.55); text-transform: uppercase; letter-spacing: .05em; }
  .q-pct { font-size: 12px; font-weight: 600; color: var(--teal); }
  .progress-bar-wrap { height: 7px; background: rgba(255,255,255,.08); border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--teal), var(--gold)); border-radius: 999px; transition: width .4s ease; }
  .q-num { font-size: 11.5px; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: .07em; margin-bottom: .55rem; }
  .q-text { font-size: clamp(17px, 2.4vw, 21px); font-weight: 700; color: #fff; line-height: 1.45; margin-bottom: 1.4rem; }
  .q-opts { display: flex; flex-direction: column; gap: .65rem; }
  .opt-btn { display: flex; align-items: flex-start; gap: .85rem; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07); border-radius: 13px; padding: 1rem 1.15rem; text-align: left; color: rgba(255,255,255,.82); font-size: 15px; line-height: 1.55; font-family: inherit; cursor: pointer; transition: background .18s, transform .15s, border-color .18s; }
  .opt-btn:hover { background: rgba(255,255,255,.08); color: #fff; transform: translateX(3px); }
  .opt-letter { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; background: rgba(255,255,255,.08); font-size: 13px; font-weight: 800; color: rgba(255,255,255,.55); flex-shrink: 0; }
  .opt-btn.selected { background: linear-gradient(135deg, rgba(229,184,74,.14), rgba(229,184,74,.05)); border-color: rgba(229,184,74,.4); color: #fff; }
  .opt-btn.selected .opt-letter { background: var(--gold); color: #0a0f1e; }
  .quiz-nav { display: flex; justify-content: space-between; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.07); }
  .btn-back, .btn-next { padding: .7rem 1.4rem; border-radius: 10px; font-family: "Sora", sans-serif; font-weight: 700; font-size: 14px; cursor: pointer; transition: all .2s; }
  .btn-back { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.7); }
  .btn-back:hover:not(:disabled) { color: #fff; border-color: rgba(255,255,255,.25); }
  .btn-next { background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a); border: none; color: #0a0f1e; }
  .btn-next:disabled, .btn-back:disabled { opacity: .4; cursor: not-allowed; }

  /* Results */
  .results-box { max-width: 720px; margin: 2rem auto 0; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem 2.1rem; text-align: left; }
  .res-top { text-align: center; margin-bottom: 1.75rem; }
  .res-emoji { font-size: 3rem; }
  .res-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--teal); margin: .6rem 0 .25rem; }
  .res-stream { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 800; color: #fff; }
  .res-desc { font-size: 15px; line-height: 1.75; color: rgba(255,255,255,.7); margin: 1rem 0 1.5rem; }
  .res-bars { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.75rem; }
  .res-bar-row { display: flex; align-items: center; gap: .8rem; }
  .res-bar-label { width: 130px; flex-shrink: 0; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.78); }
  .res-bar-track { flex: 1; height: 11px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .res-bar-fill { display: block; height: 100%; border-radius: 999px; min-width: 2px; }
  .res-bar-val { width: 38px; text-align: right; font-size: 12px; font-weight: 700; color: rgba(255,255,255,.6); }
  .res-section { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07); border-radius: 14px; padding: 1.2rem 1.3rem; margin-bottom: 1rem; }
  .res-section h4 { font-size: 14px; color: var(--gold); margin-bottom: .55rem; }
  .res-section p, .res-section li { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.72); }
  .res-section ul { padding-left: 1.1rem; }
  .res-section p + p { margin-top: .6rem; }
  .res-section.res-highlight { border-color: rgba(229,184,74,.4); background: rgba(229,184,74,.07); }
  .res-section.res-highlight h4 { color: var(--gold); }
  .res-section.res-warn { border-color: rgba(245,158,11,.45); background: rgba(245,158,11,.08); }
  .res-section.res-warn h4 { color: #f7a93b; }
  .res-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 1.5rem; }
  .res-retake { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.75); padding: 13px 26px; border-radius: 12px; font-family: "Sora", sans-serif; font-weight: 600; font-size: 14px; cursor: pointer; }

  /* FAQ */
  .faq-list { max-width: 720px; margin: 2rem auto 0; display: flex; flex-direction: column; gap: .7rem; }
  .faq-item { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 13px; padding: 1.1rem 1.3rem; }
  .faq-item summary { font-size: 15px; font-weight: 700; color: #fff; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--gold); font-weight: 700; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.65); margin-top: .8rem; }

  /* CTA */
  #cta { text-align: center; }
  .cta-inner { max-width: 640px; margin: 0 auto; }
  .cta-headline { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; color: #fff; margin-bottom: .75rem; }
  .cta-sub { font-size: 15px; line-height: 1.75; color: rgba(255,255,255,.62); margin-bottom: 1.75rem; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }

  @media (max-width: 760px) {
    .how-grid { grid-template-columns: 1fr; }
    .quiz-box, .results-box { padding: 1.5rem 1.2rem; }
    .res-bar-label { width: 100px; font-size: 12px; }
  }
</style>

<script is:inline>
/* ── Stream Selector Test After 10th ── */
var QUESTIONS = [
  { q: "Which subject do you like the most in school?", opts: [
    { t: "Maths and solving sums", s: "pcm" },
    { t: "Science, plants, animals, and the human body", s: "pcb" },
    { t: "Money, business, and how shops work", s: "com" },
    { t: "History, languages, and how people live", s: "arts" },
  ]},
  { q: "What do you like to do in your free time?", opts: [
    { t: "Build things, fix gadgets, or solve puzzles", s: "pcm" },
    { t: "Watch nature shows or care for plants and pets", s: "pcb" },
    { t: "Sell things, plan small events, or handle money", s: "com" },
    { t: "Read stories, draw, write, or follow the news", s: "arts" },
  ]},
  { q: "Which work sounds the most fun to you?", opts: [
    { t: "Making machines, apps, or buildings", s: "pcm" },
    { t: "Helping sick people get better", s: "pcb" },
    { t: "Running a shop or a company", s: "com" },
    { t: "Writing, teaching, or making art", s: "arts" },
  ]},
  { q: "Which question do you enjoy answering?", opts: [
    { t: "How does this machine work?", s: "pcm" },
    { t: "How does the body fight a cold?", s: "pcb" },
    { t: "How can this shop earn more money?", s: "com" },
    { t: "Why do people act the way they do?", s: "arts" },
  ]},
  { q: "In a school project, which part do you pick?", opts: [
    { t: "The maths, charts, and the building part", s: "pcm" },
    { t: "The part about plants, animals, or health", s: "pcb" },
    { t: "The planning, budget, and selling part", s: "com" },
    { t: "The writing, drawing, and speaking part", s: "arts" },
  ]},
  { q: "Which show or video would you like to watch?", opts: [
    { t: "A show about robots, space, or engineering", s: "pcm" },
    { t: "A show about doctors, animals, or the body", s: "pcb" },
    { t: "A show about business and money", s: "com" },
    { t: "A show about history, art, or people's lives", s: "arts" },
  ]},
  { q: "What are you good at?", opts: [
    { t: "Numbers and step-by-step thinking", s: "pcm" },
    { t: "Remembering facts about living things", s: "pcb" },
    { t: "Talking, planning, and selling", s: "com" },
    { t: "Words, drawing, and new ideas", s: "arts" },
  ]},
  { q: "Pick a job you would like when you grow up:", opts: [
    { t: "Engineer, coder, or architect", s: "pcm" },
    { t: "Doctor, nurse, or scientist", s: "pcb" },
    { t: "Business owner, banker, or accountant", s: "com" },
    { t: "Writer, teacher, lawyer, or designer", s: "arts" },
  ]},
  { q: "Which class makes time go fast for you?", opts: [
    { t: "Maths or Physics", s: "pcm" },
    { t: "Biology or Chemistry", s: "pcb" },
    { t: "A class about money or business", s: "com" },
    { t: "English, History, or Art", s: "arts" },
  ]},
  { q: "How do you like to solve a problem?", opts: [
    { t: "Use a formula or a step-by-step method", s: "pcm" },
    { t: "Study it like a science experiment", s: "pcb" },
    { t: "Find the smartest and cheapest way", s: "com" },
    { t: "Think about people and tell a story", s: "arts" },
  ]},
  { q: "What would you like to learn more about?", opts: [
    { t: "Computers, machines, and how things are built", s: "pcm" },
    { t: "The human body, medicine, and living things", s: "pcb" },
    { t: "Money, trade, and starting a company", s: "com" },
    { t: "Books, design, news, and culture", s: "arts" },
  ]},
  { q: "A friend needs help. You like to:", opts: [
    { t: "Fix their broken gadget or phone", s: "pcm" },
    { t: "Help them feel better when they are sick", s: "pcb" },
    { t: "Help them plan and save their pocket money", s: "com" },
    { t: "Help them write or speak well", s: "arts" },
  ]},
  { q: "Which puzzle do you enjoy?", opts: [
    { t: "Number puzzles and logic games", s: "pcm" },
    { t: "Quizzes about nature and the body", s: "pcb" },
    { t: "Games about buying, selling, and money", s: "com" },
    { t: "Word games, riddles, and drawing", s: "arts" },
  ]},
  { q: "What do you want your future job to give you?", opts: [
    { t: "The chance to build and invent things", s: "pcm" },
    { t: "The chance to care for people and health", s: "pcb" },
    { t: "The chance to grow a business and earn well", s: "com" },
    { t: "The chance to create, write, or help society", s: "arts" },
  ]},
  { q: "Pick the sentence that feels most like you:", opts: [
    { t: "I love maths and how things work.", s: "pcm" },
    { t: "I love science and living things.", s: "pcb" },
    { t: "I love money, plans, and business.", s: "com" },
    { t: "I love words, art, and people.", s: "arts" },
  ]},
];

var ORDER = ['pcm', 'pcb', 'com', 'arts'];
var META = {
  pcm:  { label: 'Science (PCM)', emoji: '🔬', color: '#6366f1' },
  pcb:  { label: 'Science (PCB)', emoji: '🧬', color: '#10b981' },
  com:  { label: 'Commerce',      emoji: '📊', color: '#f59e0b' },
  arts: { label: 'Arts',          emoji: '🎨', color: '#ec4899' },
};
var RESULTS = {
  pcm: {
    title: 'Science with Maths (PCM)',
    desc: 'The PCM stream — Physics, Chemistry, and Maths — fits the way you think. It is the path for students who enjoy building, calculating, and solving.',
    fit: 'Your answers show that you enjoy numbers, logic, and finding out how things work. PCM is the stream built for minds like yours.',
    strengths: ['You think in a clear, step-by-step way', 'You enjoy solving problems and cracking puzzles', 'You like to build, design, and understand how machines work'],
    subjects: 'Physics · Chemistry · Mathematics (you can often add Computer Science)',
