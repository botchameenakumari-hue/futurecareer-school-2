var currentQ = 0;
var answers = new Array(QUESTIONS.length).fill(null);

document.addEventListener('DOMContentLoaded', function () {
  renderQuestion(0);
  updateProgress();
});

function renderQuestion(idx) {
  var q = QUESTIONS[idx];
  document.getElementById('q-num').textContent = 'Question ' + (idx + 1);
  document.getElementById('q-text').textContent = q.q;
  var box = document.getElementById('q-opts');
  box.innerHTML = '';
  q.opts.forEach(function (opt, i) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'opt-btn' + (answers[idx] === i ? ' selected' : '');
    btn.innerHTML = '<span class="opt-letter">' + String.fromCharCode(65 + i) + '</span><span class="opt-text">' + opt.t + '</span>';
    btn.onclick = function () { selectOption(idx, i); };
    box.appendChild(btn);
  });
  document.getElementById('btn-back').disabled = idx === 0;
  var nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = answers[idx] === null;
  nextBtn.textContent = idx === QUESTIONS.length - 1 ? 'See My Result' : 'Next';
}

function selectOption(idx, optIdx) {
  answers[idx] = optIdx;
  renderQuestion(idx);
  updateProgress();
}

function nextQuestion() {
  if (answers[currentQ] === null) return;
  if (currentQ === QUESTIONS.length - 1) { showResults(); return; }
  currentQ++;
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function prevQuestion() {
  if (currentQ === 0) return;
  currentQ--;
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function updateProgress() {
  var answered = answers.filter(function (a) { return a !== null; }).length;
  var pct = Math.round((answered / QUESTIONS.length) * 100);
  document.getElementById('q-counter').textContent = 'Question ' + (currentQ + 1) + ' of ' + QUESTIONS.length;
  document.getElementById('q-pct').textContent = pct + '% done';
  document.getElementById('progress-fill').style.width = pct + '%';
}

function computeScores() {
  var s = {};
  ORDER.forEach(function (k) { s[k] = 0; });
  answers.forEach(function (a, i) {
    if (a !== null) {
      var cat = QUESTIONS[i].opts[a].s;
      if (s[cat] !== undefined) s[cat]++;
    }
  });
  return s;
}

function showResults() {
  var scores = computeScores();
  var ranked = ORDER.slice().sort(function (a, b) { return scores[b] - scores[a]; });
  var top = ranked[0];
  var second = ranked[1];
  var total = QUESTIONS.length;
  var r = RESULTS[top];

  var html = '';
  html += '<div class="res-top">';
  html += '<div class="res-emoji">' + META[top].emoji + '</div>';
  html += '<div class="res-label">Your Best-Fit Stream</div>';
  html += '<div class="res-stream">' + r.title + '</div>';
  html += '</div>';
  html += '<p class="res-desc">' + r.desc + '</p>';

  html += '<div class="res-bars">';
  ORDER.forEach(function (k) {
    var pct = Math.round((scores[k] / total) * 100);
    html += '<div class="res-bar-row">';
    html += '<span class="res-bar-label">' + META[k].emoji + ' ' + META[k].label + '</span>';
    html += '<span class="res-bar-track"><span class="res-bar-fill" style="width:' + pct + '%;background:' + META[k].color + '"></span></span>';
    html += '<span class="res-bar-val">' + pct + '%</span>';
    html += '</div>';
  });
  html += '</div>';

  html += '<div class="res-section"><h4>Why this stream fits you</h4><p>' + r.fit + '</p></div>';

  html += '<div class="res-section"><h4>What this says about you</h4><ul>';
  r.strengths.forEach(function (s) { html += '<li>' + s + '</li>'; });
  html += '</ul></div>';

  html += '<div class="res-section"><h4>Subjects in this stream</h4><p>' + r.subjects + '</p></div>';

  html += '<div class="res-section"><h4>Jobs this stream can lead to</h4><ul>';
  r.careers.forEach(function (c) { html += '<li>' + c + '</li>'; });
  html += '</ul></div>';

  html += '<div class="res-section"><h4>Exams and paths this opens</h4><p>' + r.exams + '</p></div>';

  html += '<div class="res-section"><h4>What to do next</h4><ul>';
  r.nextSteps.forEach(function (s) { html += '<li>' + s + '</li>'; });
  html += '</ul></div>';

  html += '<div class="res-section"><h4>One thing to think about</h4><p>' + r.watchOut + '</p></div>';

  html += '<div class="res-section"><h4>Your second-best stream</h4><p>' + META[second].emoji + ' <strong>' + RESULTS[second].title + '</strong> — ' + RESULTS[second].fit + ' Keep this in mind as a backup while you decide.</p></div>';

  if (top === 'pcb') {
    html += '<div class="res-section res-warn"><h4>⚠️ Please read this carefully — about the Biology path</h4>'
      + '<p>Biology is a wonderful subject, but be honest with yourself about the careers that come after it. The medical path is extremely competitive. Every year a very large number of students compete through the NEET exam for a small number of good MBBS seats — and the tough competition starts all over again for PG (specialisation) seats. Becoming a settled, successful doctor takes many years of very hard study, and it truly works out for only a small share of the students who start.</p>'
      + '<p>The other biology paths — biotechnology, bioinformatics, and research — sound exciting, but in India these fields are still growing slowly. Many are not fully developed yet, good jobs can be limited, and the pay often does not match the long years of study and effort. Growth in the pharma industry is also slow.</p>'
      + '<p>This does not mean you must drop Biology. If it is truly your passion, you can still choose it — but choose it with open eyes, knowing the real picture, not only the dream. For many students who like science, the MPC group (Maths, Physics, Chemistry) is a safer and more flexible choice. Please talk to a career guidance expert before you decide.</p></div>';
  }

  html += '<div class="res-section res-highlight"><h4>★ One important point for every student</h4>'
    + '<p>Whatever your result above, the Science group with Maths, Physics, and Chemistry — often called MPC or PCM — keeps the most doors open. It is the most flexible choice after Class 10. It suits a very large number of future careers, including engineering, technology, computers and data, design, defence, and even many roles in business and research.</p>'
    + '<p>If you are able to handle Maths and enjoy it even a little, choosing MPC gives you the widest set of options later. You can still move toward commerce or creative fields after MPC, but it is much harder to move into MPC-based careers later if you do not pick it now. Keep this in mind while you make your choice.</p></div>';

  html += '<div class="res-section"><h4>A useful tip for every student</h4>'
    + '<p>You are at the best age to explore. Try small skills now — a little coding, writing, or design — to find out what you truly enjoy. You do not need to earn money yet; the goal is simply to learn about yourself.</p>'
    + '<p>Also build the habit of deep focus — try to study or work hard for two hours without checking your phone. This one habit will help you in every stream and every career. And start using AI tools as helpers for boring tasks, not as a replacement for your own thinking.</p></div>';

  html += '<div class="res-section"><h4>Remember</h4><p>This result is a helpful starting point, not a final decision. The choice is yours. For a clear, one-on-one plan made just for you, a career guidance session is the best next step.</p></div>';

  html += '<div class="res-actions">';
  html += '<a href="/services/career-counselling-and-career-guidance" class="btn-gold">Get Career Guidance</a>';
  html += '<button class="res-retake" onclick="retakeQuiz()">Take Test Again</button>';
  html += '</div>';

  document.getElementById('quiz-container').style.display = 'none';
  var rc = document.getElementById('results-container');
  rc.innerHTML = html;
  rc.style.display = 'block';
  rc.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function retakeQuiz() {
  currentQ = 0;
  answers = new Array(QUESTIONS.length).fill(null);
  document.getElementById('results-container').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'block';
  renderQuestion(0);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>
