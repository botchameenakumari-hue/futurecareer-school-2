---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/graduates-and-early-professionals/';
const plansConfig = getAssessmentPlansConfig('graduate');
const guidanceCardHref = plansConfig.jumpHref;
const guidanceResultsHref = plansConfig.jumpHref;
const guidanceResultsLabel = plansConfig.jumpLabel;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Career Assessment for Graduates & Early Professionals', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Career Assessment for Graduates & Early Professionals',
    description: 'A free 26-question psychometric career assessment for graduates and early professionals (0–3 years). Covers RIASEC career interests, role fit, market readiness, multiple intelligence profile, aptitude signals, learning style, and role-specific career direction. Instant results. No sign-up.',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
];
---

<BaseLayout
  title="Free Career Assessment for Graduates & Early Professionals | Future Career School"
  description="Free 26-question psychometric career assessment for graduates and professionals with 0–3 years of experience. Covers career clarity, role fit, skill readiness, employability, and career direction. Instant results. No sign-up."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Graduates &amp; Professionals</span>
      </nav>
      <div class="pill"><span class="dot"></span>Free &nbsp;&middot;&nbsp; 26 Questions &nbsp;&middot;&nbsp; 12–15 Minutes &nbsp;&middot;&nbsp; Instant Results &nbsp;&middot;&nbsp; No Sign-Up</div>
      <h1>Career Clarity for <span class="gold-text">Graduates &amp; Early Professionals</span></h1>
      <p class="hero-sub">Pinpoint your strongest career direction, skill gaps, and role-fit strategy. Designed for graduates and professionals in their first 0–3 years — when career momentum is built.</p>
      <div class="meta-chips">
        <span class="meta-chip">📋 26 questions</span>
        <span class="meta-chip">⏱ ~15 minutes</span>
        <span class="meta-chip">✨ Instant results</span>
        <span class="meta-chip">✓ 100% free</span>
        <span class="meta-chip">🎯 6 tests in one</span>
      </div>
      <div class="hero-actions">
        <a href="#assessment" class="btn-gold pulse hero-cta">Start Free Assessment <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></a>
        <a href={plansConfig.jumpHref} class="btn-outline hero-cta">{plansConfig.jumpLabel}</a>
      </div>
    </div>
  </section>

  <div class="assessment-first-flow">
  <!-- WHAT THIS TESTS -->
  <section id="what-this-tests">
    <div class="container">
      <div class="section-pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;What This Assessment Covers</div>
      <h2 class="section-title">Six Tests. One Assessment. Built for Your Stage.</h2>
      <p class="section-sub">26 questions capture multiple signals at once — RIASEC career interests, role and domain fit, intelligence profile, aptitude, learning style, and a professional role strategy specific to where you are right now.</p>
      <div class="signals-grid">
        <div class="signal-card signal-riasec">
          <div class="signal-icon-wrap"><span class="signal-icon">🎯</span></div>
          <div class="signal-tag">RIASEC Model</div>
          <h3>Career Interest Profile</h3>
          <p>Maps your interests across all 6 Holland types to identify your career personality code and which types of work naturally energise you versus drain you.</p>
        </div>
        <div class="signal-card signal-stream">
          <div class="signal-icon-wrap"><span class="signal-icon">🗺️</span></div>
          <div class="signal-tag">Role Strategy</div>
          <h3>Role &amp; Domain Guide</h3>
          <p>Based on your background and interests, maps specific roles you're suited for, salary ranges, entry paths, and the stronger career move to accelerate your growth.</p>
        </div>
        <div class="signal-card signal-mi">
          <div class="signal-icon-wrap"><span class="signal-icon">🧠</span></div>
          <div class="signal-tag">Gardner's 8 Types</div>
          <h3>Multiple Intelligence Profile</h3>
          <p>Identifies your dominant intelligence type and connects it to which types of work suit your cognitive style and how you learn most effectively.</p>
        </div>
        <div class="signal-card signal-apt">
          <div class="signal-icon-wrap"><span class="signal-icon">📊</span></div>
          <div class="signal-tag">Aptitude Signals</div>
          <h3>Professional Aptitude</h3>
          <p>Captures your relative strengths across numerical, verbal, and logical reasoning — and maps them to specific career directions that reward each one.</p>
        </div>
        <div class="signal-card signal-ls">
          <div class="signal-icon-wrap"><span class="signal-icon">📚</span></div>
          <div class="signal-tag">VAK Framework</div>
          <h3>Learning Style Assessment</h3>
          <p>Identifies whether you learn best visually, auditorily, or kinesthetically — with specific strategies for skill-building and professional development.</p>
        </div>
        <div class="signal-card signal-career">
          <div class="signal-icon-wrap"><span class="signal-icon">💼</span></div>
          <div class="signal-tag">Career Discovery</div>
          <h3>Work Values &amp; Direction</h3>
          <p>Combines your RIASEC type, domain, and intelligence profile to show specific career paths, salary benchmarks, and the skill to build next.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section id="assessment">
    <div class="container">
      <div class="section-pill"><span style="color:var(--gold)">&#128203;</span>&nbsp;Career Assessment</div>
      <h2 class="section-title">Discover Your Career Direction</h2>
      <p class="section-sub">Read each question carefully. Choose the option most genuinely true for you — not what sounds impressive. There are no right or wrong answers.</p>
      <!-- LANGUAGE SELECTOR -->
      <div class="lang-selector" id="lang-selector">
        <span class="lang-label">Language:</span>
        <button class="lang-btn lang-btn--active" data-lang="en">English</button>
        <button class="lang-btn" data-lang="hi">हिन्दी</button>
        <button class="lang-btn" data-lang="te">తెలుగు</button>
        <button class="lang-btn" data-lang="ta">தமிழ்</button>
        <button class="lang-btn" data-lang="mr">मराठी</button>
      </div>

      <div id="quiz-container" class="quiz-box" role="main" aria-label="Career Assessment Quiz">
        <div class="quiz-progress">
          <div class="progress-header">
            <span id="q-counter" class="q-counter">Question 1 of 26</span>
            <span id="q-pct" class="q-pct">0% complete</span>
          </div>
          <div class="progress-bar-wrap" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Quiz progress">
            <div id="progress-fill" class="progress-fill"></div>
          </div>
        </div>
        <div id="q-display" role="region" aria-live="polite" aria-atomic="true">
          <p id="q-num" class="q-num">Question 1</p>
          <p id="q-text" class="q-text">Loading...</p>
          <fieldset id="q-opts" class="q-opts"><legend class="sr-only">Select your answer</legend></fieldset>
        </div>
        <div class="quiz-nav">
          <button id="btn-back" class="btn-back" disabled onclick="prevQuestion()" aria-label="Go to previous question"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg><span>Back</span></button>
          <span class="keyboard-hint" title="Press 1-6 to select, Enter to continue">⌨️ Keyboard shortcuts</span>
          <button id="btn-next" class="btn-next" disabled onclick="nextQuestion()" aria-label="Go to next question or see results"><span>Next Question</span><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <div id="results-container" class="results-box" style="display:none" role="main" aria-live="polite" aria-label="Assessment Results"></div>
    </div>
  </section>
  </div>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <div class="section-pill"><span style="color:var(--gold)">&#10067;</span>&nbsp;Common Questions</div>
      <h2 class="section-title">FAQ</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">Who should take this assessment?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Graduates (just out of college) and early professionals with 0–3 years of experience. Whether you are clear on your direction or completely lost, this assessment gives you a structured picture of your career interests, role fit, and the stronger move to accelerate your growth.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What does this assessment cover?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Six things in 26 questions: (1) RIASEC career interest profile, (2) Role and domain guide personalised to your background, (3) Multiple intelligence profile, (4) Professional aptitude signals — numerical, verbal, logical, (5) Learning style, and (6) Career direction with specific role fits and salary benchmarks.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">I feel lost in my career right now — is this relevant?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Yes — especially if you feel lost. This assessment identifies your genuine strengths and interests independent of your current job or situation. It shows you the role and domain directions that actually fit how you think and work. That clarity is exactly what you need right now.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is this different from a standard aptitude test?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Yes. An aptitude test measures ability under pressure. This maps your career interests, natural inclinations, and cognitive style — what you are drawn toward, how your mind works best, and which kinds of work energise you. For career direction, how you naturally think is often more predictive than what you can do under exam conditions.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is this free?<svg class="faq-arr" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="faq-a">Completely free. No sign-up, no payment, no login required. Take it whenever you want, retake it anytime.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- INTERNAL LINKS -->
  <section id="next-steps">
    <div class="container">
      <div class="section-pill"><span style="color:var(--teal)">&#8635;</span>&nbsp;After This Assessment</div>
      <h2 class="section-title">Where to Go Next</h2>
      <p class="section-sub">This assessment is a starting point. These options help you move from free clarity to a stronger role, skill, or career decision.</p>
      <div class="links-grid">
        <a href={guidanceCardHref} class="link-card">
          <div class="lc-icon">💼</div>
          <div><div class="lc-title">{plansConfig.jumpLabel}</div><div class="lc-desc">Move from free results to the pricing section when role direction, skills, and positioning need a sharper plan.</div></div>
        </a>
        <a href="/services/assessments" class="link-card">
          <div class="lc-icon">📋</div>
          <div><div class="lc-title">All Assessments</div><div class="lc-desc">See all career assessment tools available across different life stages</div></div>
        </a>
        <a href="/career-resources" class="link-card">
          <div class="lc-icon">📚</div>
          <div><div class="lc-title">Career Resources</div><div class="lc-desc">Explore career guides, skill-building resources, and role research</div></div>
        </a>
        <a href="/services/assessments/class-11-to-12" class="link-card">
          <div class="lc-icon">🎓</div>
          <div><div class="lc-title">Class 11–12 Assessment</div><div class="lc-desc">Share with a younger sibling for stream selection and college planning</div></div>
        </a>
        <a href="/career-skills-compass" class="link-card">
          <div class="lc-icon">🔍</div>
          <div><div class="lc-title">Career & Skills Compass</div><div class="lc-desc">Explore high-value skills that match your career direction</div></div>
        </a>
        <a href="/services" class="link-card">
          <div class="lc-icon">⚙️</div>
          <div><div class="lc-title">Career Guidance and Assessments</div><div class="lc-desc">See career guidance, assessments, and tools in one place.</div></div>
        </a>
      </div>
    </div>
  </section>

  <AssessmentGuidanceCta mode="graduate" sectionId="guidance-bridge" />

  <GuidancePlansSection
    sectionId="plans"
    audience={plansConfig.audience}
    serviceLabel={plansConfig.serviceLabel}
    title={plansConfig.sectionTitle}
  />

  <AssessmentReportTools
    title="Graduates and Early Professionals Assessment Report"
    fileName="graduate-career-assessment-report.pdf"
    reportKicker="EARLY CAREER GROWTH REPORT"
    guidanceLabel="Explore Early Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />
  <Footer />
</BaseLayout>

<script is:inline define:vars={{ guidanceResultsHref, guidanceResultsLabel }}>
globalThis.guidanceResultsHref = guidanceResultsHref;
globalThis.guidanceResultsLabel = guidanceResultsLabel;
</script>
<script is:inline>
var scores = {R:0,I:0,A:0,S:0,E:0,C:0, lin:0,log:0,spa:0,bk:0,inter:0,intra:0,mus:0,nat:0, num:0,ver:0,lgc:0, vis:0,aud:0,kin:0, tech:0,biz:0,cre:0,sci:0,hum:0};
var currentQ = 0;
var answers = new Array(26).fill(null);
var currentLang = 'en';

function getQText(idx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[idx].q;
  var tr = TRANSLATIONS[currentLang];
  return (tr[idx] && tr[idx].q) ? tr[idx].q : QUESTIONS[idx].q;
}
function getOptText(qIdx, optIdx) {
  if (currentLang === 'en' || !TRANSLATIONS || !TRANSLATIONS[currentLang]) return QUESTIONS[qIdx].opts[optIdx].t;
  var tr = TRANSLATIONS[currentLang];
  return (tr[qIdx] && tr[qIdx].opts && tr[qIdx].opts[optIdx]) ? tr[qIdx].opts[optIdx] : QUESTIONS[qIdx].opts[optIdx].t;
}

var QUESTIONS = [
  {q:"What is your work or study field?", opts:[
    {t:"Technology, Engineering, or Computer Science", s:{tech:8,R:1,I:1,log:1}},
    {t:"Business, Management, Commerce, or Finance", s:{biz:8,E:1,C:1,num:1}},
    {t:"Creative fields — Design, Media, Arts, Communication, or Marketing", s:{cre:8,A:1,ver:1}},
    {t:"Pure or Applied Sciences — Biology, Chemistry, Physics, or Research", s:{sci:8,I:1,nat:1,log:1}},
    {t:"Humanities, Social Sciences, Law, Education, or Psychology", s:{hum:8,S:1,A:1,ver:1}},
  ]},
  {q:"What makes you happy at work? (Pick all that matter to you)", multiselect:true, opts:[
    {t:"Building or fixing things — code, systems, products, or stuff that works", s:{R:3,I:1,kin:1}},
    {t:"Deep research, data analysis, solving hard problems", s:{I:3,log:2,lgc:1}},
    {t:"Creating — writing, designing, making something new or original", s:{A:3,ver:1,lin:1}},
    {t:"Helping — teaching, coaching, helping, serving people directly", s:{S:3,inter:2}},
    {t:"Leading — pitching ideas, persuading, making decisions, building plans", s:{E:3,inter:1,ver:1}},
    {t:"Organising — making processes work, ensuring quality, managing data", s:{C:3,lgc:1,num:1}},
  ]},
  {q:"When someone has too much work, you:", opts:[
    {t:"Jump in and figure out what needs doing — hands-on help", s:{R:2,S:1,kin:1}},
    {t:"Diagnose the bottleneck systematically, then solve it", s:{I:2,C:1,lgc:1}},
    {t:"Question the plan — maybe the whole approach is wrong", s:{A:2,I:1,log:1}},
    {t:"Calm them down and emotionally support them through it", s:{S:2,inter:2}},
    {t:"Take charge, redistribute work, drive it to completion", s:{E:2,inter:1}},
    {t:"Organize a checklist and track every item systematically", s:{C:2,lgc:1}},
  ]},
  {q:"How do you understand hard information?", opts:[
    {t:"I experiment — try things, see what breaks, learn from output", s:{R:2,kin:2,log:1}},
    {t:"I read deeply, connect to first principles, reason from evidence", s:{I:2,log:2,lgc:1}},
    {t:"I make it visual — diagrams, mind maps, rewriting in my own words", s:{A:1,spa:2,vis:2}},
    {t:"I talk it through — discussion makes it click", s:{S:2,inter:2,aud:1}},
    {t:"I debate it — pressure-test from opposing angles", s:{E:2,ver:1,lgc:1}},
    {t:"I break it into structured steps and go through methodically", s:{C:2,lgc:2,num:1}},
  ]},
  {q:"Which skill is easiest for you right now?", opts:[
    {t:"Technical work — coding, engineering, or hands-on skills", s:{R:2,I:1,log:1}},
    {t:"Analysis and research — understanding data and complex problems", s:{I:2,lgc:2,log:1}},
    {t:"Storytelling — writing, presenting, or design", s:{A:2,ver:2,lin:1}},
    {t:"People skills — building trust, listening, mentoring", s:{S:2,inter:2,intra:1}},
    {t:"Persuasion — negotiating, selling, or leading", s:{E:2,ver:1,inter:1}},
    {t:"Organization — systems, processes, accuracy", s:{C:2,num:2,lgc:1}},
  ]},
  {q:"What kind of feedback makes you want to get better?", opts:[
    {t:"When something is broken — I want to fix it right away", s:{R:2,I:1,lgc:1}},
    {t:"When my thinking is not complete — I dig deeper to understand", s:{I:2,log:2}},
    {t:"When my work is not good enough — I redo it until it is mine", s:{A:2,intra:1}},
    {t:"When I hurt someone — I feel it and work to make it right", s:{S:2,inter:2,intra:1}},
    {t:"When my ideas are weak — I research and come back with better ones", s:{E:2,ver:1,log:1}},
    {t:"When my system does not work — I trace it back and fix it", s:{C:2,lgc:2}},
  ]},
  {q:"Two job offers with the same pay. You pick the one with:", opts:[
    {t:"Hard technical challenges and hands-on building", s:{R:3,I:1,log:1}},
    {t:"More learning and harder thinking", s:{I:3,log:2}},
    {t:"Creative freedom and your name on the work", s:{A:3,intra:1}},
    {t:"Meaningful work with people and helping them", s:{S:3,inter:2}},
    {t:"Leadership and faster growth", s:{E:3,inter:1}},
    {t:"Stability, structure, and high-quality work", s:{C:3,lgc:1,num:1}},
  ]},
  {q:"After 5 years, what would make you feel proud?", opts:[
    {t:"Built something real — product, system, or infrastructure that works", s:{R:2,I:1,kin:1}},
    {t:"Become an expert in something I care about", s:{I:2,log:2,intra:1}},
    {t:"Created work that moves or inspires people", s:{A:2,lin:1,intra:1}},
    {t:"Helped hundreds of people in real ways", s:{S:2,inter:2}},
    {t:"Built a team, business, or movement", s:{E:2,inter:1,intra:1}},
    {t:"Become the most trusted person in my field", s:{C:2,lgc:1,num:1}},
  ]},
  {q:"How do you make big decisions?", opts:[
    {t:"Test with small experiments first before committing", s:{R:2,I:1,kin:1}},
    {t:"Research all angles until I am sure", s:{I:2,log:2,lgc:1}},
    {t:"Trust your gut — if it feels right, do it", s:{A:2,intra:2}},
    {t:"Talk with trusted people and think about impact", s:{S:2,inter:2}},
    {t:"Pick the best option and figure it out as you go", s:{E:2,lgc:1,intra:1}},
    {t:"List pros, cons, and risks — then pick the best one", s:{C:2,lgc:2,num:1}},
  ]},
  {q:"What kinds of projects did you enjoy? (Pick all that you like)", multiselect:true, opts:[
    {t:"Building — robots, apps, models, fixing equipment", s:{R:3,kin:2,spa:1}},
    {t:"Investigating — science projects, debates, research", s:{I:3,log:2,lgc:1}},
    {t:"Creating — writing, music, art, design, or film", s:{A:3,lin:1,mus:1}},
    {t:"Organizing people — clubs, events, helping others", s:{S:3,inter:2}},
    {t:"Competing — hackathons, competitions, leading", s:{E:3,inter:1,ver:1}},
    {t:"Organizing — systems, spreadsheets, careful work", s:{C:3,lgc:2,num:1}},
  ]},
  {q:"Can you work alone without feedback for a long time?", opts:[
    {t:"Yes, I like deep focus without interruptions", s:{I:2,intra:2}},
    {t:"Yes, but I like check-ins sometimes", s:{R:2,C:1,intra:1}},
    {t:"Kind of, but I like to share my work", s:{A:2,intra:1}},
    {t:"No, I need people around me", s:{S:2,inter:2}},
    {t:"No, I think out loud and need a team", s:{E:2,inter:2,aud:1}},
    {t:"It depends on the task", s:{C:1,lgc:1}},
  ]},
  {q:"Startup pays 40% less but gives you more learning and ownership. You:", opts:[
    {t:"Take it if the technical work is harder", s:{R:2,I:1}},
    {t:"Take it if the problem excites you", s:{I:2,log:1}},
    {t:"Take it if you have creative control", s:{A:2,intra:1}},
    {t:"Take it if the mission matters to you", s:{S:2,inter:1}},
    {t:"Take it — more learning and ownership is almost always better", s:{E:3,inter:1}},
    {t:"Decline unless the company shows good financial discipline", s:{C:2,lgc:1}},
  ]},
