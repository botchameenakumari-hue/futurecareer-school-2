   HELPER FUNCTIONS FOR ASSESSMENT ANALYTICS
─────────────────────────────────────────────── */

function calculatePercentile(score, min, max) {
  if (max <= min) return 50;
  return Math.round(((score - min) / (max - min)) * 100);
}

function classifyStrength(percentile) {
  if (percentile >= 85) return {tier: 'Critical Strength', icon: '🔴', color: '#ef4444'};
  if (percentile >= 70) return {tier: 'Strong', icon: '🟠', color: '#f59e0b'};
  if (percentile >= 50) return {tier: 'Moderate', icon: '🟡', color: '#eab308'};
  if (percentile >= 30) return {tier: 'Emerging', icon: '🟢', color: '#10b981'};
  return {tier: 'Low Focus', icon: '⚪', color: '#6b7a99'};
}

function analyzeResponsePatterns() {
  // Calculate conviction level based on variance in responses
  var scores_array = [];
  for (var key in scores) {
    if (typeof scores[key] === 'number') {
      scores_array.push(scores[key]);
    }
  }
  var mean = scores_array.reduce(function(a, b) { return a + b; }, 0) / scores_array.length;
  var variance = scores_array.reduce(function(a, b) { return a + Math.pow(b - mean, 2); }, 0) / scores_array.length;
  var stdDev = Math.sqrt(variance);
  var convictionScore = Math.max(0, Math.min(100, 100 - (stdDev * 8)));

  // Detect contradictions
  var contradictions = [];
  if (scores.R > 40 && scores.A > 40) {
    contradictions.push('High Realistic + High Artistic: Your hands-on nature meets creative drive — balance making with designing.');
  }
  if (scores.S > 40 && scores.I > 40 && scores.E < 35) {
    contradictions.push('High Social + High Investigative but Low Enterprising: You care about people and ideas, but may struggle to sell them.');
  }
  if (scores.E > 40 && scores.I > 40 && scores.A < 35) {
    contradictions.push('High Enterprising + Investigative but Low Artistic: You want to lead analytical teams, but may miss creative approaches.');
  }

  // Detect response bias
  var maxScore = Math.max.apply(null, scores_array);
  var minScore = Math.min.apply(null, scores_array);
  var maxCount = scores_array.filter(function(s) { return s === maxScore; }).length;
  var bias = '';
  if (maxCount > scores_array.length / 2) {
    bias = 'Strong agreement pattern';
  } else if (Math.abs(maxScore - minScore) < 10) {
    bias = 'Balanced neutral pattern';
  }

  return {
    convictionScore: Math.round(convictionScore),
    conviction: convictionScore > 70 ? 'High' : convictionScore > 50 ? 'Moderate' : 'Exploring',
    contradictions: contradictions,
    bias: bias
  };
}

function inferMonthsSinceGraduation() {
  // Infer from response patterns about job search confidence, experience with workplace dynamics
  // This is a heuristic based on how they answer about domain knowledge and workplace situations
  var inference = {
    months: 0,
    stage: 'Recently Graduated (0-3 months)',
    label: 'Just Starting'
  };

  if (scores.E && scores.E > 30 && scores.S && scores.S > 25) {
    inference.months = 6;
    inference.stage = 'Early Career (3-12 months)';
    inference.label = 'Adjusting';
  }
  if (scores.I && scores.I > 35 && scores.C && scores.C > 35) {
    inference.months = 12;
    inference.stage = 'Established (1-2 years)';
    inference.label = 'Building';
  }
  if (scores.E && scores.E > 40) {
    inference.months = 24;
    inference.stage = 'Experienced (2-5 years)';
    inference.label = 'Growing';
  }

  return inference;
}

function calculateCognitiveBalance(scores) {
  var logical = (scores.I + (scores.lgc || 0)) / 2;
  var creative = (scores.A + (scores.spa || 0) + (scores.mus || 0)) / 3;
  var social = (scores.S + (scores.inter || 0)) / 2;
  var practical = (scores.R + (scores.bk || 0)) / 2;
  var all = [logical, creative, social, practical];
  var max = Math.max(...all);
  var min = Math.min(...all);
  var balance = Math.round(100 - Math.min(100, ((max - min) / (max || 1)) * 80));
  return {
    score: balance,
    profile: balance > 70 ? 'Well-Rounded' : balance > 50 ? 'Balanced' : 'Specialized',
    logical: Math.round(logical),
    creative: Math.round(creative),
    social: Math.round(social),
    practical: Math.round(practical),
    interpretation: balance > 70 ? 'You have diverse strengths across thinking styles. You can adapt to many roles and take on various responsibilities.' :
                   balance > 50 ? 'You have a mix of strengths with one primary style. Good flexibility while staying true to your nature.' :
                   'You have a clear dominant thinking style. Choose roles that match your natural style for best results.'
  };
}

function calculateCareerReadiness(patterns, percentiles, primary) {
  var convictionScore = patterns.convictionLevel === 'High' ? 85 : patterns.convictionLevel === 'Moderate' ? 65 : 45;
  var clarityScore = percentiles[primary] || 50;
  var consistencyScore = patterns.consistency || 50;

  var readiness = Math.round((convictionScore + clarityScore + consistencyScore) / 3);
  var stage = readiness > 75 ? 'Ready to Move' : readiness > 60 ? 'Building Clarity' : 'Still Exploring';

  return {
    score: readiness,
    stage: stage,
    conviction: convictionScore,
    clarity: clarityScore,
    consistency: consistencyScore,
    recommendation: readiness > 75 ? 'You\'re ready to make concrete career moves. Consider applying to roles, freelancing, or starting a project.' :
                   readiness > 60 ? 'Continue exploring through projects, side hustles, and conversations with people in fields that interest you.' :
                   'Keep experimenting across different domains. Clarity will come from trying different things.'
  };
}

function calculateLearningStyleAlignment(topLS, riasecPrimary) {
  var alignment = {
    vis: {I: 75, A: 85, C: 75, E: 60, S: 50, R: 55},
    aud: {S: 85, E: 75, I: 55, A: 65, C: 50, R: 45},
    kin: {R: 90, A: 75, S: 70, I: 50, E: 60, C: 45}
  };

  var score = (alignment[topLS] && alignment[topLS][riasecPrimary]) || 60;
  var lsName = {vis: 'Visual', aud: 'Auditory', kin: 'Kinesthetic'}[topLS];

  return {
    learningStyle: lsName,
    alignmentScore: score,
    careerAlignment: score > 75 ? 'Excellent alignment. Your learning style matches your career strengths.' :
                    score > 60 ? 'Good alignment. You can leverage your learning style in your career.' :
                    'Moderate alignment. You may need to develop complementary learning approaches.',
    implication: lsName === 'Visual' ? 'Seek careers involving design, visualization, product thinking, and clear systems.' :
                lsName === 'Auditory' ? 'Seek careers involving communication, collaboration, mentoring, and group work.' :
                'Seek careers involving hands-on work, physical problem-solving, building, and direct application.'
  };
}

function calculateAptitudeProfile(scores) {
  var num = scores.num || 0;
  var ver = scores.ver || 0;
  var lgc = scores.lgc || 0;

  var max = Math.max(num, ver, lgc);
  var total = num + ver + lgc;

  var primary = num >= ver && num >= lgc ? 'Numerical' : ver >= num && ver >= lgc ? 'Verbal' : 'Logical';
  var strength = max > 0 ? Math.round((max / (total || 1)) * 100) : 50;

  return {
    primary: primary,
    numerical: num,
    verbal: ver,
    logical: lgc,
    dominanceStrength: strength,
    profile: strength > 60 ? 'Specialized: ' + primary + ' strength dominant' : 'Balanced across aptitudes',
    careerImplication: primary === 'Numerical' ? 'Data, statistics, finance, and quantitative roles suit you best. Consider careers in analytics, data science, or finance.' :
                      primary === 'Verbal' ? 'Communication, writing, language, and relationship-based roles suit you best. Consider careers in content, HR, or business.' :
                      'Problem-solving, analysis, architecture, and structured thinking roles suit you best. Consider careers in tech, engineering, or strategy.'
  };
}

function calculateAdaptability(patterns, conflicts) {
  var consistencyBonus = patterns.consistency > 70 ? 20 : 10;
  var conflictPenalty = (conflicts && Object.keys(conflicts).length > 0) ? -10 : 10;
  var convictionBonus = patterns.convictionLevel === 'Exploring' ? 30 : 0;

  var score = Math.max(0, Math.min(100, 50 + consistencyBonus + conflictPenalty + convictionBonus));
  var adaptability = score > 70 ? 'Highly Adaptable' : score > 50 ? 'Moderately Adaptable' : 'Prefers Clarity';

  return {
    score: score,
    adaptability: adaptability,
    interpretation: score > 70 ? 'You can easily pivot and try different paths. Uncertainty is your strength in a changing job market.' :
             score > 50 ? 'You can adapt with some planning. Try new things while maintaining structure in your transition.' :
             'You thrive with clear direction. Build deep expertise in your chosen area before pivoting.'
  };
}

