  if (q26Answer === 0) {
    // "Stable income and clear career growth"
    profileType = 'Perfect Plan';
    profileDesc = 'You want a secure path with clear growth. Build skills that lead to stable, profitable roles.';
  } else if (q26Answer === 1) {
    // "Work on something I truly care about"
    profileType = 'Passion Plan';
    profileDesc = 'You are willing to go after your passion. Pair it with a backup job for financial safety.';
  } else if (q26Answer === 2) {
