function downloadResultsAsPDF() {
  var resultsContainer = document.getElementById('results-container');
  if (!resultsContainer || !window.downloadAssessmentReportPdf) {
    return;
  }

  window.downloadAssessmentReportPdf({
    title: 'Graduates and Early Professionals Assessment Report',
    fileName: 'graduate-career-assessment-report.pdf',
    container: resultsContainer
  });
}

function retakeQuiz() {
  currentQ = 0;
  answers.fill(null);
  Object.keys(scores).forEach(function(k){ scores[k] = 0; });
  document.getElementById('results-container').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'block';
  renderQuestion(0);
  updateProgress();
  document.getElementById('q-opts').focus();
  document.getElementById('quiz-container').scrollIntoView({behavior:'smooth',block:'start'});
}

globalThis.downloadResultsAsPDF = downloadResultsAsPDF;
globalThis.retakeQuiz = retakeQuiz;

function classifyJobSearchReadiness(riasec, domain, ap) {
  var readiness = {};
  var directScore = (ap.num + ap.ver) / 2;
  var referralScore = 70;
  var startupScore = ap.lgc + 20;
  readiness.direct = {score: Math.min(100, Math.round(directScore * 1.2)), label: directScore > 60 ? 'Strong' : 'Moderate', tip: 'Apply directly to postings. Build portfolio on GitHub/Behance. Get feedback early.'};
  readiness.referral = {score: Math.min(100, Math.round(referralScore)), label: 'Strong', tip: 'Ask 10 people you know: "Who should I talk to in [domain]?" Warm intros beat cold emails 3:1.'};
  readiness.startup = {score: Math.min(100, Math.round(startupScore)), label: startupScore > 70 ? 'Strong' : 'Moderate', tip: 'Startups hire for potential + learning speed over 5 years of refined expertise.'};
  return readiness;
}

function generateSkillRoadmap(domain, riasec, aptMax) {
  var tracks = {
    fast: {name: 'Fast Track (3-6 months)', condition: 'You already have 70% of needed skills', timeline: ['Month 1: Complete certifications', 'Month 2-3: Portfolio project', 'Month 4-6: Interviews & landing']},
    standard: {name: 'Standard Track (6-12 months)', condition: 'You have 40-70% of needed skills', timeline: ['Month 1-3: Core skill building', 'Month 4-6: Build portfolio pieces', 'Month 7-12: Network & apply']},
    rebuild: {name: 'Rebuild Track (12-18 months)', condition: 'New domain, <40% skill match', timeline: ['Month 1-6: Foundational learning', 'Month 7-12: Projects & depth', 'Month 13-18: Credibility building']}
  };
  return tracks;
}

function generatePortfolioStrategy(domain) {
  var strategies = {
    tech: {pieces: ['GitHub profile with 3-5 quality projects', '1 full-stack project (frontend + backend)', 'Contributions to open source', 'Blog post explaining your work'], where: ['GitHub', 'Personal website', 'Dev.to or Medium', 'LinkedIn']},
    biz: {pieces: ['Case study: "How I increased X metric by Y%"', 'Analysis document on your industry', 'Business plan or strategy for a real problem', 'Testimonials from people you\'ve helped'], where: ['LinkedIn', 'Medium/Substack', 'Personal website', 'Slide deck']},
    cre: {pieces: ['5-10 best creative pieces', 'Case study: Brief to final work + process', 'Personal project showing range', 'Process documentation'], where: ['Behance/Dribbble', 'Portfolio website', 'Instagram/YouTube', 'LinkedIn']},
    sci: {pieces: ['Research paper or analysis', '1-2 completed projects with write-ups', 'Data visualization of interesting findings', 'Contribution to research community'], where: ['LinkedIn', 'ResearchGate', 'Medium', 'Personal blog']}
  };
  return strategies[domain] || strategies.tech;
}

function shareResults() {
  var prof = computeProfile();
  var primary = prof.primary;
  var secondary = prof.secondary;
  var shareText = 'I took the Future Career School Career Assessment and got ' + RIASEC[primary].label + ' as my primary type (secondary: ' + RIASEC[secondary].label + '). Find out your career type: https://futurecareerschool.com/services/assessments/graduates-and-early-professionals/';

  if (navigator.share) {
    navigator.share({
      title: 'My Career Assessment Result',
      text: shareText
    }).catch(function(err) {
      console.log('Share cancelled');
    });
  } else {
    // Fallback: Copy to clipboard
    var textArea = document.createElement('textarea');
    textArea.value = shareText;
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand('copy');
    document.body.removeChild(textArea);
    alert('Results copied to clipboard! You can paste and share them now.');
  }
}

// Add results section toggle functionality
function setupResultsTabs() {
  var toggles = document.querySelectorAll('[data-toggle-section]');
  toggles.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var section = this.getAttribute('data-toggle-section');
      var content = document.getElementById('section-' + section);
      var isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

      if (isOpen) {
        content.style.maxHeight = '0';
        content.style.opacity = '0';
        this.setAttribute('aria-expanded', 'false');
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        this.setAttribute('aria-expanded', 'true');
      }
    });
  });
}
</script>

