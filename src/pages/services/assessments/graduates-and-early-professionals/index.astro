document.addEventListener('DOMContentLoaded', function() {
  renderQuestion(0);
  updateProgress();

  document.querySelectorAll('.lang-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.remove('lang-btn--active'); });
      this.classList.add('lang-btn--active');
      currentLang = this.getAttribute('data-lang');
      renderQuestion(currentQ);
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && document.getElementById('btn-next').offsetParent !== null) {
      if (!document.getElementById('btn-next').disabled) {
        nextQuestion();
      }
    } else if (e.key === 'Backspace' && document.getElementById('btn-back').offsetParent !== null) {
      if (!document.getElementById('btn-back').disabled) {
        prevQuestion();
      }
    } else if (e.key >= '1' && e.key <= '6') {
      var optIndex = parseInt(e.key) - 1;
      var q = QUESTIONS[currentQ];
      if (optIndex < q.opts.length) {
        selectOption(currentQ, optIndex);
      }
    }
  });
});

function renderQuestion(idx) {
  var q = QUESTIONS[idx];
  var isMultiselect = q.multiselect === true;
  var questionLabel = 'Question ' + (idx + 1);
  if (isMultiselect) {
    questionLabel += ' (Select all that apply)';
  }
  document.getElementById('q-num').textContent = questionLabel;
  document.getElementById('q-text').textContent = getQText(idx);
  var container = document.getElementById('q-opts');
  container.innerHTML = '';
  var selectedAnswers = isMultiselect ? (answers[idx] || []) : (answers[idx] !== null ? [answers[idx]] : []);

  q.opts.forEach(function(opt, i) {
    var label = document.createElement('label');
    label.className = 'opt-label' + (selectedAnswers.includes(i) ? ' selected' : '');

    var input = document.createElement('input');
    input.type = isMultiselect ? 'checkbox' : 'radio';
    input.name = 'question_' + idx;
    input.value = i;
    input.checked = selectedAnswers.includes(i);
    input.className = 'opt-radio';
    input.onchange = function() { selectOption(idx, parseInt(this.value)); };
    input.setAttribute('aria-label', String.fromCharCode(65 + i) + '. ' + getOptText(idx, i));

    var letter = document.createElement('span');
    letter.className = 'opt-letter';
    letter.textContent = String.fromCharCode(65 + i);

    var text = document.createElement('span');
    text.className = 'opt-text';
    text.textContent = getOptText(idx, i);

    label.appendChild(input);
    label.appendChild(letter);
    label.appendChild(text);
    container.appendChild(label);
  });
}

function selectOption(qIdx, optIdx) {
  // Safety checks
  if (!QUESTIONS || !QUESTIONS[qIdx]) {
    console.error('Invalid question index:', qIdx);
    return;
  }
  var q = QUESTIONS[qIdx];
  if (!q.opts || !q.opts[optIdx]) {
    console.error('Invalid option index:', optIdx, 'for question:', qIdx, 'Total options:', q.opts ? q.opts.length : 0);
    return;
  }

  var isMultiselect = q.multiselect === true;

  if (isMultiselect) {
    if (!answers[qIdx]) answers[qIdx] = [];
    var idx = answers[qIdx].indexOf(optIdx);
    if (idx > -1) {
      var prev = q.opts[optIdx].s;
      if (prev) Object.keys(prev).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prev[k]; });
      answers[qIdx].splice(idx, 1);
    } else {
      var cur = q.opts[optIdx].s;
      if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
      answers[qIdx].push(optIdx);
    }
  } else {
    if (answers[qIdx] !== null && answers[qIdx] !== undefined) {
      var prevOpt = q.opts[answers[qIdx]];
      if (prevOpt && prevOpt.s) {
        Object.keys(prevOpt.s).forEach(function(k) { if (scores[k] !== undefined) scores[k] -= prevOpt.s[k]; });
      }
    }
    var cur = q.opts[optIdx].s;
    if (cur) Object.keys(cur).forEach(function(k) { if (scores[k] !== undefined) scores[k] += cur[k]; });
    answers[qIdx] = optIdx;
  }

  renderQuestion(qIdx);
  document.getElementById('btn-next').disabled = false;
  document.getElementById('btn-next').focus();
}

function nextQuestion() {
  var q = QUESTIONS[currentQ];
  var isMultiselect = q && q.multiselect === true;
  var isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);
  if (!isAnswered) {
    alert('Please select an answer before continuing.');
    return;
  }
  currentQ++;
  if (currentQ >= QUESTIONS.length) {
    if (validateAnswers()) {
      showResults();
    } else {
      alert('There was an error processing your answers. Please try again.');
      currentQ--;
    }
    return;
  }
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({behavior:'smooth',block:'start'});
}

function validateAnswers() {
  for (var i = 0; i < QUESTIONS.length; i++) {
    var q = QUESTIONS[i];
    var isMultiselect = q && q.multiselect === true;
    var isAnswered = isMultiselect ? (answers[i] && answers[i].length > 0) : (answers[i] !== null && answers[i] !== undefined);
    if (!isAnswered) {
      return false;
    }
  }
  var hasScores = false;
  Object.keys(scores).forEach(function(k) {
    if (scores[k] > 0) hasScores = true;
  });
  return hasScores;
}

function prevQuestion() {
  if (currentQ === 0) return;
  currentQ--;
  renderQuestion(currentQ);
  updateProgress();
  document.getElementById('quiz-container').scrollIntoView({behavior:'smooth',block:'start'});
}

function updateProgress() {
  var total = QUESTIONS.length;
  var pct = Math.round((currentQ / total) * 100);
  document.getElementById('q-counter').textContent = 'Question ' + (currentQ + 1) + ' of ' + total;
  document.getElementById('q-pct').textContent = pct + '% complete';
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('btn-back').disabled = currentQ === 0;

  var q = QUESTIONS[currentQ];
  var isMultiselect = q && q.multiselect === true;
  var isAnswered = isMultiselect ? (answers[currentQ] && answers[currentQ].length > 0) : (answers[currentQ] !== null);

  var nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = !isAnswered;
  nextBtn.innerHTML = (currentQ === total - 1 ? 'See My Results' : 'Next Question') + ' <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>';
}

globalThis.prevQuestion = prevQuestion;
globalThis.nextQuestion = nextQuestion;
</script>

