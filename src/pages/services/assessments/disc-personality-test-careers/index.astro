---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/disc-personality-test-careers/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/riasec-holland-code-career-test/',
    title: 'RIASEC Holland Code Career Test',
    description: 'Use six interest types and a three-letter Holland Code when you want career-family matches built from activities you enjoy rather than workplace behaviour style.',
  },
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Career Preference Type Test',
    description: 'Compare four work-style preference pairs when you want a type-style hypothesis instead of a four-quadrant behavioural style.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous personality traits and 20 facets when you want a deeper behaviour-based profile than a four-quadrant model.',
  },
  {
    href: '/services/assessments/emotional-intelligence-test-careers/',
    title: 'Emotional Intelligence Test for Careers',
    description: 'Use five emotional-skill scores and a composite EQ score when the real question is self-awareness, regulation, empathy, and social skills rather than behaviour style.',
  },
  {
    href: '/services/assessments/vark-learning-style-test/',
    title: 'VARK Learning Style Test',
    description: 'Use four learning channels and study strategies when the goal is how you absorb information rather than how you behave with others.',
  },
  {
    href: '/services/assessments/enneagram-personality-test-careers/',
    title: 'Enneagram Personality Test for Careers',
    description: 'Use nine core motivation patterns when you want to understand the driving fears and desires behind your behaviour style.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does DISC stand for?',
    a: 'DISC describes four behavioural style dimensions: Dominance (direct, results-driven), Influence (enthusiastic, persuasive), Steadiness (patient, dependable), and Conscientiousness (analytical, precise). Most people show a blend of two styles rather than a single pure type.',
  },
  {
    q: 'Is this an official DISC assessment?',
    a: 'No. This is an independent, original 24-statement behavioural-style assessment from Future Career School inspired by DISC theory. It is not an official DISC instrument and is not affiliated with or endorsed by any DISC publisher or certification body.',
  },
  {
    q: 'How is my style blend calculated?',
    a: 'You rate 24 workplace behaviours across the four DISC styles (six behaviours per style). Each style gets a 0-100 score, and your top two styles, in order, form your reported style blend, such as "Dominance with Influence" or "Steadiness with Conscientiousness".',
  },
  {
    q: 'Does a DISC-style result predict job performance?',
    a: 'No. It describes tendencies in communication and work behaviour, not skill, intelligence, or ability. Career and hiring decisions still need demonstrated capability, evidence, and real experiments, not a style label alone.',
  },
  {
    q: 'What if my top two scores are close together?',
    a: 'That is common and simply means your behavioural style flexes more by situation than a sharply defined single style. Use real workplace examples to see which style shows up under pressure versus in calm conditions.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all four style scores, your style blend, intensity and flexibility indicators, communication guidance, matched career directions, and all 24 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'DISC Personality Test for Careers', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free DISC Personality Test for Careers',
    alternateName: 'DISC Workplace Style Test',
    description: 'A free original 24-statement DISC-style workplace behaviour assessment with four style scores, a style blend, communication guidance, career directions, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="DISC Personality Test for Careers | Free DISC Workplace Test"
  description="Take a free DISC-style personality test for careers. Get four style scores, your style blend, communication guidance, career directions, and a free PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="disc-hero">
      <div class="disc-grid-bg" aria-hidden="true"></div>
      <div class="disc-orb disc-orb--red" aria-hidden="true"></div>
      <div class="disc-orb disc-orb--blue" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">DISC Personality Test for Careers</span>
        </nav>
        <div class="eyebrow"><span></span> Four workplace behaviour styles</div>
        <h1>DISC Personality Test <span>for Careers</span></h1>
        <p class="hero-sub">Rate 24 real workplace behaviours and get your Dominance, Influence, Steadiness, and Conscientiousness scores, your style blend, and practical communication and career guidance.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>24</strong><span>original behaviours</span></div>
          <div><strong>4</strong><span>DISC styles</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment inspired by DISC theory. Not an official DISC instrument. No affiliation or endorsement is claimed.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Four behavioural styles</span><h2>Most people are a blend of two styles</h2><p>The report scores all four styles and reports your top two together as a blend, instead of forcing you into one box.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--d"><b>D</b><h3>Dominance</h3><p>Direct, decisive, results-driven, and comfortable with risk.</p></article>
          <article class="type-card type-card--i"><b>I</b><h3>Influence</h3><p>Enthusiastic, persuasive, social, and optimistic.</p></article>
          <article class="type-card type-card--s"><b>S</b><h3>Steadiness</h3><p>Patient, dependable, cooperative, and consistent.</p></article>
          <article class="type-card type-card--c"><b>C</b><h3>Conscientiousness</h3><p>Analytical, precise, systematic, and quality-focused.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual workplace behaviour</span><h2>How much is each behaviour like you at work or in study?</h2><p>Use your common pattern under normal conditions, not your best day or your worst day.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Understand your natural style in group projects and leadership roles before it hardens.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Connect your style with team roles, internships, and project leadership choices.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Prepare sharper interview stories and target roles that fit your natural style.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Diagnose team friction, leadership fit, and communication mismatches at work.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each behaviour on how accurately it describes your usual pattern.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Workplace behaviour style</span><span id="question-counter">Behaviour 1 of 24</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Behaviour 1 of 24"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">Taking charge of a group when a decision needs to be made quickly.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how accurately this describes you">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly unlike me</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Unlike me</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neutral</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Like me</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly like me</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="DISC workplace style results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not an official DISC instrument, does not fix a permanent style, and cannot determine career suitability by itself.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use style as a working hypothesis</span><h2>Turn a style blend into better decisions</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which styles are strongest, blended, or clearly lower under normal conditions.</p></article>
          <article><strong>2</strong><h3>Compare</h3><p>Check how your style changes under pressure versus in calm, low-stakes settings.</p></article>
          <article><strong>3</strong><h3>Communicate</h3><p>Use the guidance to adjust how you brief, ask for, and receive information from others.</p></article>
          <article><strong>4</strong><h3>Verify</h3><p>Test career and role hypotheses against real tasks, not the style label alone.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use your style blend</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when interests, personality traits, or student-stage direction also need to be covered alongside workplace behaviour style." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="DISC Workplace Style Report"
    fileName="future-career-school-disc-workplace-style-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="DISC WORKPLACE BEHAVIOUR STYLE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .disc-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#180a0a 0%,#1f1015 60%,#141225 100%)}.disc-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.disc-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.17}.disc-orb--red{left:-180px;top:-60px;background:#ef4444}.disc-orb--blue{right:-170px;bottom:-95px;background:#0ea5e9}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#fca5a5;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(252,165,165,.28);border-radius:999px;background:rgba(252,165,165,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#fca5a5;box-shadow:0 0 0 5px rgba(252,165,165,.1)}.disc-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.35rem,6.2vw,4.85rem);line-height:.97;letter-spacing:-.058em;text-wrap:balance}.disc-hero h1 span{display:block;background:linear-gradient(90deg,#ef4444,#f59e0b,#0ea5e9);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#f5f1e8;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}.type-card{position:relative;overflow:hidden;padding:1.25rem;border:1px solid #ddd7cb;border-radius:19px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--disc)}.type-card b{display:grid;width:44px;height:44px;place-items:center;border-radius:13px;background:color-mix(in srgb,var(--disc) 15%,white);color:var(--disc);font-size:1.25rem}.type-card h3{margin:1.05rem 0 .45rem;font-size:1.02rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:13px;line-height:1.6}.type-card--d{--disc:#ef4444}.type-card--i{--disc:#f59e0b}.type-card--s{--disc:#10b981}.type-card--c{--disc:#0ea5e9}.assessment-section{background:#120a17}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#fca5a5;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:4%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#ef4444,#f59e0b,#10b981,#0ea5e9);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(252,165,165,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(252,165,165,.16),transparent 62%),#1a0f12;text-align:center}.code-mark strong{color:#fff;font-size:1.65rem;letter-spacing:.02em;line-height:1.15}.code-mark span,.result-kicker{margin-top:.5rem;color:#fca5a5;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.8rem;margin-top:1rem}.type-result{--disc:#fca5a5;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{margin:0;color:#fff}.type-result-head strong{color:var(--disc);font-size:1.15rem}.type-track{positi