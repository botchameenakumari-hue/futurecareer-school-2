<script>
  // @ts-nocheck
  var ORDER=['D','I','S','C'];
  var TYPES={
    D:{name:'Dominance',label:'The Driver',color:'#ef4444',summary:'You may prefer direct communication, fast decisions, and a strong push toward results, even when that creates friction along the way.',environment:'Look for roles with real ownership, clear targets, and room to make fast decisions rather than seeking consensus on everything.',careers:['General management and P&L ownership roles','Sales leadership and business development','Operations leadership and turnaround roles','Entrepreneurship and founder-led ventures','Project and programme leadership under pressure'],highPay:'Leadership, sales-leadership, and general-management roles that combine dominance with measurable results tend to have the highest compensation ceiling in this group, since pay is often tied to targets, ownership, and negotiated outcomes.',skills:['Structured decision-making under time pressure','Delegation and follow-through systems so speed does not sacrifice quality','Stakeholder communication that explains the reasoning behind fast calls']},
    I:{name:'Influence',label:'The Connector',color:'#f59e0b',summary:'You may prefer enthusiasm, storytelling, and building rapport quickly, using energy and persuasion to move people and ideas forward.',environment:'Look for roles with real interaction, visibility, and room to persuade or motivate rather than heads-down solitary work.',careers:['Sales, marketing, and brand roles','Public relations, communications, and media','Training, facilitation, and event leadership','Business development and partnerships','Customer-facing roles that build relationships'],highPay:'Roles that pair influence with a measurable commercial or growth outcome, such as sales, marketing, or business development, tend to pay more consistently than purely brand or PR-focused roles.',skills:['Converting enthusiasm into a documented, followed-up plan','Data-backed persuasion alongside storytelling','Follow-through systems so momentum does not fade after the pitch']},
    S:{name:'Steadiness',label:'The Stabiliser',color:'#10b981',summary:'You may prefer patience, dependable follow-through, and a cooperative, calm approach that keeps a team steady over the long run.',environment:'Look for roles with predictable structure, real teamwork, and enough time to build trust rather than constant last-minute change.',careers:['Operations, customer support, and service delivery','Human resources and employee relations','Healthcare, education, and other long-term care roles','Project coordination and team support roles','Administration and process-stability roles'],highPay:'Operations, customer success, and HR roles that combine steadiness with process ownership or team leadership tend to pay more than individual-contributor support roles.',skills:['Assertive boundary-setting so steadiness does not become being overlooked','Change-readiness practice so stability does not turn into resistance to necessary change','Visible progress reporting so consistent work stays noticed']},
    C:{name:'Conscientiousness',label:'The Analyst',color:'#0ea5e9',summary:'You may prefer precision, structured process, and thorough research before committing, prioritising accuracy and quality over speed.',environment:'Look for roles with clear standards, real data, and enough time to verify work rather than constant improvisation under pressure.',careers:['Finance, accounting, and audit','Quality assurance, compliance, and risk','Data analysis, engineering, and research','Legal and regulatory roles','Systems administration and technical documentation'],highPay:'Finance, quality assurance, compliance, data, and engineering roles that combine conscientiousness with a technical or quantitative qualification tend to be the higher-paying options in this group.',skills:['Timeboxing analysis so precision does not delay real decisions','Communicating technical findings in plain, decision-ready language','Comfort presenting a recommendation before every variable is confirmed']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Use your style to choose better group roles',body:'Your style blend can help you choose which role to take in group projects and clubs. It should widen how you contribute, not label you permanently this early.',actions:['Try leading a small group task if Dominance or Influence scored high, or supporting one if Steadiness or Conscientiousness scored high.','Notice which group roles feel natural and which ones cost you the most energy.','Ask a teacher for feedback on how your communication style comes across to others.'],caution:'Behavioural style can shift a lot with practice, confidence, and exposure at this stage. Treat this as a starting map.'},
    college:{label:'College student',title:'Match your style to stronger team and project roles',body:'Use your style blend to choose project roles, internships, and leadership opportunities that build on your natural communication pattern.',actions:['Take on a role in your top style for one project and a role in your lowest style for another, then compare the experience.','Ask internship teams what communication style the team values most.','Practise one communication skill from a style that is not your natural strength.'],caution:'A style match is not the same as employable skill. Build demonstrated capability alongside style awareness.'},
    job:{label:'Job seeker',title:'Prepare sharper interview stories using your style blend',body:'Use your top styles to choose roles and prepare examples that show how you naturally communicate, decide, and work with others.',actions:['Prepare one story that shows your top style in action with a measurable result.','Ask interviewers what communication style succeeds on their team.','Target roles where the daily communication style matches your natural blend.'],caution:'A style label does not replace demonstrated skill in interviews. Always support it with real, specific examples.'},
    professional:{label:'Working professional',title:'Diagnose team friction and leadership fit',body:'Use your style blend to understand recurring friction with colleagues, managers, or teams, and to decide whether a role or a team is the real mismatch.',actions:['Compare your style with your manager\'s and your closest collaborators\' likely styles to spot friction points.','Adjust how you brief and receive information from people with a different style.','Test a leadership or team-change hypothesis with a small project before a bigger move.'],caution:'Style differences explain some friction, but not all of it. Check workload, role clarity, and team norms too.'}
  };
  var QUESTIONS=[
    {type:'D',text:'Taking charge of a group when a decision needs to be made quickly.'},
    {type:'I',text:'Energising a group with enthusiasm before a big effort.'},
    {type:'S',text:'Providing steady, patient support to a teammate over time.'},
    {type:'C',text:'Checking a plan carefully for errors before it goes out.'},
    {type:'D',text:'Pushing hard toward a result even when it creates some friction.'},
    {type:'I',text:'Persuading people through storytelling and personal connection.'},
    {type:'S',text:'Keeping a team calm and cooperative during a stressful period.'},
    {type:'C',text:'Following a precise, established process rather than improvising.'},
    {type:'D',text:'Speaking up directly when you disagree with a plan.'},
    {type:'I',text:'Meeting new people and building rapport quickly.'},
    {type:'S',text:'Sticking with a long-term commitment even when it becomes routine.'},
    {type:'C',text:'Researching thoroughly before committing to a decision.'},
    {type:'D',text:'Setting an ambitious target and driving the group toward it.'},
    {type:'I',text:'Generating excitement around a new idea before all the details exist.'},
    {type:'S',text:'Listening carefully before offering your own opinion.'},
    {type:'C',text:'Setting a high, exact quality standard for your own work.'},
    {type:'D',text:'Making a fast decision with incomplete information rather than waiting.'},
    {type:'I',text:'Keeping the mood positive when a project hits a setback.'},
    {type:'S',text:'Avoiding unnecessary conflict in favour of a workable compromise.'},
    {type:'C',text:'Organising complex information into a clear, accurate structure.'},
    {type:'D',text:'Competing to win rather than settling for an average outcome.'},
    {type:'I',text:'Speaking in front of a group to inspire action.'},
    {type:'S',text:'Maintaining consistent effort and reliability week after week.'},
    {type:'C',text:'Preferring proven data and evidence over gut instinct.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Workplace behaviour style';questionCounter.textContent='Behaviour '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Behaviour '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My Style Blend':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 24-Behaviour Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(value){return(value-1)*25;}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(answers[item.index]);});
      var score=round(average(scored));
      return{type:type,name:TYPES[type].name,label:TYPES[type].label,color:TYPES[type].color,score:score};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||ORDER.indexOf(a.type)-ORDER.indexOf(b.type);});
    var top2=ranked.slice(0,2),blendCode=top2.map(function(item){return item.type;}).join('');
    var spread=ranked[0].score-ranked[1].score;
    var intensity=ranked[0].score;
    var intensityLabel=intensity>=75?'A strong, clearly expressed primary style.':intensity>=55?'A moderately expressed primary style.':'A fairly even profile across styles - your behaviour likely flexes a lot by situation.';
    var blendLabel=spread<=10?'Your top two styles are close together, so you likely move fluidly between them depending on the situation.':spread<=25?'Your top style leads, with your second style showing up in specific situations.':'Your top style clearly leads your usual behaviour, with your second style as a smaller supporting pattern.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=9?'You used the neutral rating often. That may reflect genuine range or uncertainty; use real workplace examples before drawing a strong conclusion.':extremeCount>=14?'You used many strong ratings. Check whether they reflect a repeated real pattern rather than how you feel right now.':run>=7?'A long sequence used the same rating. This may be genuine, but review whether a response habit influenced the pattern.':'The response pattern includes a workable mix of agreement, disagreement, and neutral ratings, though it still needs validation against real behaviour.';
    var primary=TYPES[top2[0].type],secondary=TYPES[top2[1].type];
    var profileTitle=primary.name+' with '+secondary.name;
    var profileSummary='Your strongest style is '+primary.name+' ('+primary.label+') at '+ranked[0].score+'%, followed by '+secondary.name+' ('+secondary.label+') at '+ranked[1].score+'%. '+blendLabel;
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strongFitCareers=primary.careers.filter(function(career){return secondary.careers.indexOf(career)!==-1;});
    var exploreCareers=mergeUnique(primary.careers,secondary.careers).filter(function(career){return strongFitCareers.indexOf(career)===-1;});
    var communicationGuidance=[
      'With '+primary.name.toLowerCase()+' as your lead style: '+primary.environment.toLowerCase(),
      'Ask others to be direct and specific with you rather than vague or overly cautious, since your style tends to value clarity.',
      'When working with an opposite style, slow down slightly and explain your reasoning rather than assuming the pace or logic is obvious to them.',
      'Use your second style, '+secondary.name.toLowerCase()+', deliberately in situations where your primary style alone would not work well.'
    ];
    var experiments=[
      'Spend a week noticing which of the four styles shows up most in your real meetings and tasks, not just in this quiz.',
      'Try one small real task from '+secondary.name.toLowerCase()+' work this week: '+secondary.environment.toLowerCase(),
      'Ask a colleague, teammate, or manager for one specific example of how your communication style helped or hurt a recent situation.',
      'Compare how your style shows up under normal conditions versus under real pressure or a tight deadline.'
    ];
    var skillPlan=mergeUnique(primary.skills,secondary.skills).slice(0,5);
    var highPayNotes=[primary.name+': '+primary.highPay,secondary.name+': '+secondary.highPay];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,top2:top2,blendCode:blendCode,primary:primary,secondary:secondary,intensity:intensity,intensityLabel:intensityLabel,spread:spread,blendLabel:blendLabel,profileTitle:profileTitle,profileSummary:profileSummary,strongFitCareers:strongFitCareers.length?strongFitCareers:mergeUnique(primary.careers,secondary.careers).slice(0,3),exploreCareers:exploreCareers,communicationGuidance:communicationGuidance,experiments:experiments,skillPlan:skillPlan,highPayNotes:highPayNotes,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Notice which style shows up most in real meetings, emails, and decisions, not only in this quiz.','Week 2 - Ask two colleagues, classmates, or managers for one specific example of your style in action.','Week 3 - Deliberately practise one behaviour from your lower-scoring styles in a low-stakes setting.','Week 4 - Compare evidence from all three weeks against this report before making a bigger role or team decision.'],
      decisionFilters:['Task evidence - have you tried representative work rather than relying on a style label alone?','Team evidence - does your style clash or combine well with your closest collaborators?','Pressure evidence - does your style hold up under real deadlines, not only in calm conditions?','Growth evidence - can you flex into your non-dominant styles when a situation needs it?','Market evidence - have you checked whether your target roles reward your natural style?'],
      retestPlan:['Wait at least four to six weeks so the same behaviours feel less familiar.','Retake after a real high-pressure event to see whether your style shifts under stress.','Compare all four style scores, not only your top two.','Investigate a change of 15 points or more by considering new roles, feedback, or deliberate practice.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--disc:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. '+item.name+' ('+item.label+')</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var careerCards=function(items,tag){return items.map(function(item){return'<article class="career-card"><span>'+tag+'</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Strongly unlike me',2:'Unlike me',3:'Neutral',4:'Like me',5:'Strongly like me'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>'+TYPES[item.question.type].name+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.blendCode+'</strong><span>Style blend</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.profileTitle)+'</h3><p>'+escapeHtml(r.profileSummary)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.intensity+'%</strong><span>Primary style intensity</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Gap between top two styles</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>Neutral ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your four DISC-style scores</h4><p>Scores are based only on these 24 behaviours and are not population percentiles. Your top two, in order, form your style blend.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this blend carry?</h4><div class="insight-grid"><article><h5>Style intensity</h5><p>'+r.intensityLabel+'</p></article><article><h5>Blend pattern</h5><p>'+r.blendLabel+'</p></article><article><h5>Response pattern</h5><p>'+r.responseSummary+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' behaviours were re-rated. Reconsidering is fine; use real workplace examples when two ratings both feel plausible.</p></article></div></div>'+
      '<div class="result-section"><h4>Career directions that match your top two styles</h4><p>Strongest-fit directions appear in both your primary and secondary style. The rest are worth exploring but lean more toward one style.</p><div class="career-grid">'+careerCards(r.strongFitCareers,'Strongest fit')+careerCards(r.exploreCareers,'Worth exploring')+'</div></div>'+
      '<div class="result-section"><h4>Where higher pay tends to concentrate in your top styles</h4><p>These are general, directional patterns from common industry knowledge, not guaranteed figures. Always verify current compensation against live job listings for your city and experience level.</p>'+listHtml(r.highPayNotes)+'</div>'+
      '<div class="result-section"><h4>How to communicate using this style blend</h4>'+listHtml(r.communicationGuidance)+'</div>'+
      '<div class="result-section"><h4>Skills worth building next</h4>'+listHtml(r.skillPlan)+'</div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before a career decision</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a diagnosis</h5><p>It does not measure ability, intelligence, or guarantee success in any career direction.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 24 behaviours and are not comparisons with a national, student, or employer norm.</p></article><article><h5>Not a fixed identity</h5><p>Behavioural style can flex with role, team, pressure, and deliberate practice. Retest periodically.</p></article><article><h5>Not complete career clarity</h5><p>Fuller decisions still need demonstrated skill, market evidence, constraints, and real experiments.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'DISC Workplace Style Report',fileName:'future-career-school-disc-workplace-style-report.pdf'});}
</script>
