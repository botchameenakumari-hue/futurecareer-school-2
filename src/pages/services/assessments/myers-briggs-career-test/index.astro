      slowest:slowest.meta.title+' took the longest on average at '+slowest.averageTime+' seconds per item.'
    };
    var rhythm={EJ:['Coordinated execution','You may gain momentum by aligning people early, assigning ownership, and moving toward visible closure.'],EP:['Interactive exploration','You may gain momentum by talking through possibilities, testing quickly, and adapting through live feedback.'],IJ:['Independent planned depth','You may gain momentum through private preparation, clear milestones, and dependable completion.'],IP:['Independent adaptive depth','You may gain momentum through uninterrupted exploration, flexible methods, and room to revise before committing.']};
