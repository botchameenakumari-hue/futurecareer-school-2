---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/myers-briggs-career-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous traits and 20 facets when you want a different personality framework without a four-letter type code.',
  },
  {
    href: '/services/assessments/personality-test-for-career/',
    title: 'Personality Test for Career',
    description: 'Use the broader career-personality page when you want to compare work-style assessment options before choosing one.',
  },
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduate and Early Professional Assessment',
    description: 'Use the wider assessment when role readiness, employability, skill direction, and career clarity matter alongside work style.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'Is this the official MBTI assessment?',
    a: 'No. This is an independent, original career-preference assessment from Future Career School. It is not the official MBTI assessment and is not affiliated with or endorsed by The Myers-Briggs Company or the Myers & Briggs Foundation.',
  },
  {
    q: 'What does the assessment measure?',
    a: 'It explores four familiar preference pairs: outward engagement or inward reflection, concrete evidence or patterns and possibilities, analytical consistency or people-and-values impact, and structure or adaptability.',
  },
  {
    q: 'Can a four-letter result choose my career?',
    a: 'No. A preference result can generate useful hypotheses about work style, but career decisions also need interests, demonstrated skills, values, constraints, opportunity, and real experiments.',
  },
  {
    q: 'Why can a result be close to the middle?',
    a: 'Preferences are not all-or-nothing boxes. A close score can mean you use both approaches, your context matters, or the brief assessment does not show a strong preference. The report preserves that uncertainty.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all four preference pairs, strength and consistency indicators, work-environment implications, career hypotheses, practical experiments, cautions, and all 32 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Myers Briggs Career Test Alternative', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Career Preference Type Test',
    alternateName: 'Myers Briggs Career Test Alternative',
    description: 'An independent free 32-question career-preference assessment with four preference pairs, practical career interpretation, experiments, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Myers Briggs Career Test Alternative | Free Career Preference Test"
  description="Take a free independent Myers Briggs career test alternative. Explore four work-style preference pairs, career hypotheses, practical experiments, and a detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="type-hero">
      <div class="type-grid-bg" aria-hidden="true"></div>
      <div class="type-orb type-orb--gold" aria-hidden="true"></div>
      <div class="type-orb type-orb--cyan" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Career Preference Type Test</span>
        </nav>
        <div class="eyebrow"><span></span> Independent career-preference assessment</div>
        <h1>Myers Briggs Career Test <span>Alternative for Real Career Decisions</span></h1>
        <p class="hero-sub">Explore how you tend to engage, notice information, decide, and organise work. Get a nuanced preference profile, practical career experiments, and clear cautions instead of a four-letter career verdict.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>32</strong><span>original scenarios</span></div>
          <div><strong>4</strong><span>preference pairs</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Not the official MBTI assessment. No affiliation or endorsement is claimed.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="pair-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Four preference continuums</span><h2>Both sides can be valuable</h2><p>The result shows which approach feels more natural and how strong that signal is. A close score is reported as balanced, not forced into false certainty.</p></div>
        <div class="pair-grid">
          <article><div class="pair-code"><b>E</b><span>or</span><b>I</b></div><h3>Engage or reflect</h3><p>Where attention and working energy tend to move first.</p></article>
          <article><div class="pair-code"><b>S</b><span>or</span><b>N</b></div><h3>Evidence or possibilities</h3><p>Whether concrete detail or patterns and potential lead first.</p></article>
          <article><div class="pair-code"><b>T</b><span>or</span><b>F</b></div><h3>Logic or human impact</h3><p>Which criteria receive first weight when making a decision.</p></article>
          <article><div class="pair-code"><b>J</b><span>or</span><b>P</b></div><h3>Structure or adaptability</h3><p>How you prefer to organise action, closure, and changing options.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual behaviour</span><h2>Choose what is more naturally like you</h2><p>Do not answer as the person you think a job demands. Use your common pattern across study, work, and meaningful projects.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Explore learning, teamwork, and decision preferences without locking a future career.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Connect work style with projects, internships, and role exploration.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Prepare better questions about role tasks, team culture, and working conditions.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Examine role design, collaboration, leadership, and transition fit.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right or wrong answers. Choose the middle only when both descriptions genuinely fit about equally.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="axis-label" class="axis-label">Engagement and reflection</span><span id="question-counter">Question 1 of 32</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="3" aria-valuetext="Question 1 of 32"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">When beginning a new project, which approach is more naturally like you?</p>
          <div class="choice-poles">
            <article><span>A</span><p id="left-choice">I start by discussing it with people.</p></article>
            <article><span>B</span><p id="right-choice">I start by thinking it through privately.</p></article>
          </div>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose between statement A and statement B">
            <button type="button" data-value="1"><strong>A</strong><span>Much more</span></button>
            <button type="button" data-value="2"><strong>A</strong><span>A little more</span></button>
            <button type="button" data-value="3"><strong>=</strong><span>Both equally</span></button>
            <button type="button" data-value="4"><strong>B</strong><span>A little more</span></button>
            <button type="button" data-value="5"><strong>B</strong><span>Much more</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Career preference results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not the official MBTI assessment, does not establish a fixed personality type, and cannot determine career suitability by itself.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use type as a hypothesis</span><h2>Test the result against real life</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Preference</h3><p>Notice what feels more natural, not what you are capable of doing.</p></article>
          <article><strong>2</strong><h3>Skill</h3><p>Check what you can demonstrate through work, projects, and feedback.</p></article>
          <article><strong>3</strong><h3>Environment</h3><p>Examine tasks, autonomy, pace, team norms, and decision conditions.</p></article>
          <article><strong>4</strong><h3>Experiment</h3><p>Try small real tasks before making a costly education or career commitment.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use the type code</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when the decision also includes aptitude, readiness, role direction, or career transition beyond work-style preferences." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Career Preference Report"
    fileName="future-career-school-career-preference-evidence-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="CAREER PREFERENCE EVIDENCE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .type-hero{position:relative;overflow:hidden;padding:132px 0 78px}.type-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,#000,transparent 85%)}.type-orb{position:absolute;width:430px;height:430px;border-radius:50%;filter:blur(115px);opacity:.16}.type-orb--gold{left:-180px;top:-40px;background:#e5b84a}.type-orb--cyan{right:-180px;bottom:-90px;background:#38bdf8}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#6dd5ed;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(109,213,237,.25);border-radius:999px;background:rgba(109,213,237,.07)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#6dd5ed;box-shadow:0 0 0 5px rgba(109,213,237,.1)}.type-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.25rem,6vw,4.7rem);line-height:.98;letter-spacing:-.055em;text-wrap:balance}.type-hero h1 span{display:block;color:var(--gold)}.hero-sub{max-width:780px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.4);font-size:11px}.pair-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.pair-section,.faq-section{background:#f4f1e8;color:#17202c}.section-heading{max-width:770px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.pair-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.pair-grid article{padding:1.35rem;border:1px solid #d9d5cb;border-radius:18px;background:rgba(255,255,255,.75);box-shadow:0 12px 30px rgba(23,32,44,.05)}.pair-code{display:flex;align-items:center;gap:.45rem}.pair-code b{display:grid;width:38px;height:38px;place-items:center;border-radius:10px;background:#17202c;color:var(--gold);font-size:1.1rem}.pair-code span{color:#8b929b;font-size:11px}.pair-grid h3{margin:1.2rem 0 .45rem}.pair-grid p,.method-grid p{margin:0;color:#68717d;line-height:1.6}.assessment-section{background:#0a1220}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1050px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(229,184,74,.7);background:rgba(229,184,74,.1);box-shadow:0 12px 28px rgba(229,184,74,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.axis-label{color:#6dd5ed;font-weight:800}.progress-track{height:5px;margin:.8rem 0 1.7rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:3%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#6dd5ed,var(--gold));transition:width .25s}.question-prompt{max-width:850px;margin:0 auto 1.2rem;color:#fff;text-align:center;font-size:clamp(1.2rem,2.6vw,1.75rem);font-weight:780;line-height:1.45}.choice-poles{display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem}.choice-poles article{display:grid;grid-template-columns:36px 1fr;align-items:center;gap:.7rem;min-height:105px;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035)}.choice-poles span{display:grid;width:34px;height:34px;place-items:center;border-radius:9px;background:rgba(109,213,237,.12);color:#6dd5ed;font-weight:850}.choice-poles p{margin:0;color:#fff;line-height:1.5}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.4rem}.scale-options button{display:grid;gap:.25rem;min-height:74px;place-content:center;border:1px solid rgba(255,255,255,.1);border-radius:13px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.1rem}.scale-options button span{color:rgba(255,255,255,.48);font-size:10px}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(229,184,74,.75);background:rgba(229,184,74,.11);box-shadow:0 12px 24px rgba(229,184,74,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.type-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(229,184,74,.35);border-radius:30px;background:radial-gradient(circle at top,rgba(229,184,74,.16),transparent 62%),#111b2a;text-align:center;box-shadow:inset 0 0 40px rgba(229,184,74,.05)}.type-mark strong{color:#fff;font-size:2.5rem;letter-spacing:.08em}.type-mark span,.result-kicker{color:#6dd5ed;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.axis-grid,.experiment-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.axis-card,.experiment-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.axis-card{padding:1.1rem}.axis-card-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}.axis-card h5{margin:0;color:#fff}.axis-card-head strong{color:var(--gold)}.axis-track{position:relative;height:9px;margin:.9rem 0 .55rem;border-radius:99px;background:linear-gradient(90deg,#38bdf8,var(--gold));}.axis-track:after{content:'';position:absolute;top:-3px;left:50%;width:1px;height:15px;background:#fff;opacity:.65}.axis-track i{position:absolute;top:-4px;width:17px;height:17px;border:3px solid #0f1928;border-radius:50%;background:#fff;transform:translateX(-50%)}.axis-labels{display:flex;justify-content:space-between;color:rgba(255,255,255,.52);font-size:11px}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.experiment-grid,.axis-grid{margin-top:.9rem}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
  @media(max-width:900px){.pair-grid{grid-template-columns:repeat(2,1fr)}.method-layout{grid-template-columns:1fr}.result-metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.type-hero{padding-top:112px}.audience-grid,.choice-poles,.axis-grid,.insight-grid,.experiment-grid,.pair-grid,.method-grid{grid-template-columns:1fr}.hero-stats{border-radius:15px}.hero-stats div{padding:.8rem .35rem}.start-shell,.quiz-shell,.result-shell{border-radius:20px}.scale-options{gap:.3rem}.scale-options button{min-height:72px;padding:.3rem}.scale-options button span{font-size:9px;line-height:1.2}.result-head{grid-template-columns:1fr;text-align:center}.type-mark{margin:0 auto}.response-row{grid-template-columns:28px 1fr}.response-row>span:last-child{grid-column:2}.hero-actions>*,.result-actions>*{width:100%;justify-content:center}}
