    var communication={ET:['Direct collaborative reasoning','You may prefer to surface ideas aloud and challenge them with explicit criteria.'],EF:['Relational collaborative reasoning','You may prefer to build understanding aloud while tracking trust, motivation, and human impact.'],IT:['Reflective analytical communication','You may prefer time to form a precise view before presenting the reasoning and trade-offs.'],IF:['Reflective values-led communication','You may prefer time to understand the people and values involved before sharing a considered view.']};
