  }
  function showResults(){latestReport=buildEnhancedReport();var r=latestReport;var axisHtml=r.axisList.map(function(item){return'<article class="axis-card"><div class="axis-card-head"><h5>'+item.meta.title+'</h5><strong>'+item.preferred+' - '+item.band+'</strong></div><div class="axis-track"><i style="left:'+item.secondPct+'%"></i></div><div class="axis-labels"><span>'+item.meta.first+' '+item.firstPct+'% - '+item.meta.firstName+'</span><span>'+item.meta.second+' '+item.secondPct+'% - '+item.meta.secondName+'</span></div><p>Response consistency: '+item.consistency+'% | Average: '+item.averageTime+' sec/item</p></article>';}).join('');var workHtml=r.workSignals.map(function(item){return'<article><h5>'+item.title+'</h5><p>'+item.body+'</p><p><strong>Signal:</strong> '+item.band+'</p></article>';}).join('');var experimentHtml=r.experiments.map(function(item,index){return'<article class="experiment-card"><strong>Experiment '+(index+1)+'</strong><p>'+item+'</p></article>';}).join('');var stretchHtml=r.stretchSkills.map(function(item){return'<article><h5>'+item.title+'</h5><p>'+item.body+'</p><p><strong>Practice:</strong> '+item.action+'</p></article>';}).join('');var responseHtml=r.responses.map(function(item){var q=item.question,label={1:'A much more',2:'A a little more',3:'Both equally',4:'B a little more',5:'B much more'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(q.prompt)+'</strong><p>'+escapeHtml(q.left)+' / '+escapeHtml(q.right)+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');resultShell.innerHTML='<div class="result-head"><div class="type-mark"><strong>'+r.displayCode+'</strong><span>career preference code</span></div><div><span class="result-kicker">'+r.audience.label+' profile</span><h3>'+r.displayProfile.title+'</h3><p>'+r.displayProfile.summary+'</p></div></div>'+
    '<div class="result-metrics"><div class="result-metric"><strong>'+r.clarity+'%</strong><span>Average preference clarity</span></div><div class="result-metric"><strong>'+r.consistency+'%</strong><span>Across-half consistency</span></div><div class="result-metric"><strong>'+r.neutralCount+'/32</strong><span>Balanced responses</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
