    });
    if(!report.alternatives.length){var nearest=supportOrder[0],index=axisOrder.indexOf(nearest.axis),letters=report.code.split('');letters[index]=nearest.preferred===nearest.meta.first?nearest.meta.second:nearest.meta.first;var nearestCode=letters.join('');report.alternatives=[{code:nearestCode,title:PROFILES[nearestCode].title,axis:nearest.meta.title,reason:'it is your nearest comparison profile; '+nearest.meta.title.toLowerCase()+' was still the least separated pair'}];}
    var mostNeutral=report.axisList.slice().sort(function(a,b){return b.neutralCount-a.neutralCount;})[0];
    var mostDecisive=report.axisList.slice().sort(function(a,b){return b.strongCount-a.strongCount;})[0];
