    '<div class="result-section"><h4>'+r.audience.title+'</h4><p>'+r.audience.body+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.applications)+'</article><article><h5>Important caution</h5><p>'+r.audience.caution+'</p></article></div></div>'+
