    report.axisList.forEach(function(item,index){if(item.responseSupport<20){report.workSignals[index]={title:tentativeWork[item.axis].title,body:tentativeWork[item.axis].body,band:'Context-sensitive'};report.experiments[index]=tentativeExperiment[item.axis];report.stretchSkills[index]=tentativeStretch[item.axis];report.friction[index]=tentativeFriction[item.axis];}});
