      A:{high:['Respectful candour, stakeholder care, and boundaries that make disagreement safe.','Harmony language used to avoid standards, accountability, or difficult decisions.','Ask for a recent example of constructive disagreement and what happened afterward.'],mid:['Clear decision criteria alongside attention to relationships and implementation.','Trust and cooperation depending entirely on personalities rather than team norms.','Ask how expectations and conflict rules are made explicit.'],low:['Direct debate, independent judgement, and evidence-based decisions with implementation support.','A culture rewarding aggression, cynicism, or winning arguments regardless of adoption cost.','Ask how direct challenge is separated from disrespect.']},
      N:{high:['Predictable escalation, early clarification, humane workload design, and real recovery support.','Chronic ambiguity, stacked emergencies, or pressure presented as a permanent badge of commitment.','Ask what creates sustained pressure and what changes when load becomes unsafe or ineffective.'],mid:['Visible priorities and recovery practices when several demands converge.','A role that looks manageable task by task but routinely stacks unresolved demands.','Ask how competing priorities are resolved during busy periods.'],low:['Meaningful challenge with deliberate risk review and access to cautious perspectives.','A culture where confidence substitutes for pre-mortems, weak-signal detection, or stakeholder concern.','Ask how the team catches risks before results fail.']}
    };
    report.roleGreenFlags=report.traitResults.map(function(item){var data=roleSignals[item.trait][item.band.key];return{title:item.name,green:data[0],caution:data[1],verify:data[2]};});
    var pressureCandidates=[
      {title:'Uncertainty looping',score:round(average([facetScore('Worry'),facetScore('Stress sensitivity')])),signal:'Repeatedly revisiting uncertain outcomes without gaining decision-relevant evidence.',response:'Write current facts, assumptions, probabilities, controllable actions, decision date, and stopping rule.'},
      {title:'Emotional carry-over',score:round(average([facetScore('Volatility'),facetScore('Recovery')])),signal:'A difficult event continues affecting attention, confidence, or the next task.',response:'Create a transition ritual, close unresolved communication, and delay unnecessary high-stakes judgement until baseline returns.'},
      {title:'Deadline compression',score:round(average([100-facetScore('Organisation'),100-facetScore('Self-discipline')])),signal:'Important work begins late or becomes urgent before structure appears.',response:'Expose the first deliverable, owner, checkpoint, and deadline before motivation or pressure is required.'},
      {title:'Interaction depletion',score:100-facetScore('Social energy'),signal:'Heavy interaction reduces the quality of later concentration or recovery.',response:'Batch interaction, protect preparation, and place a lower-stimulation block after demanding social work.'},
      {title:'Change overload',score:round(average([100-facetScore('Variety'),facetScore('Stress sensitivity')])),signal:'Several changing methods, priorities, or unfamiliar demands arrive before a stable base exists.',response:'Freeze the minimum stable process and introduce one meaningful change at a time.'},
      {title:'Boundary pressure',score:round(average([facetScore('Compassion'),facetScore('Cooperation'),facetScore('Patience')])),signal:'Supporting people or preserving harmony begins displacing priorities, standards, or recovery.',response:'State capacity, trade-offs, decision criteria, and what support is possible before agreeing.'}
    ];
    report.pressurePlan=pressureCandidates.sort(function(a,b){return b.score-a.score;}).slice(0,4);
    var audienceProofContext={school:'a subject, stream, high-value skill, or emerging field',college:'an internship task, role family, industry problem, or employable skill',job:'a target role, employer problem, or job-relevant skill',professional:'an adjacent role, promotion path, consulting problem, or career transition'}[audience];
    var projectTemplates={
      'Discovery and new-problem work':function(){return{title:'Research-to-recommendation brief',body:'Compare three routes within '+audienceProofContext+', identify current evidence and trade-offs, and finish with one recommendation plus a low-cost validation step.'};},
      'Structured delivery':function(){return{title:'Execution proof project',body:'Turn a realistic goal within '+audienceProofContext+' into milestones, quality criteria, a working deliverable, and a short retrospective showing dependable completion.'};},
      'Live collaboration':function(){return{title:'Interview-and-synthesis project',body:'Speak with three relevant people about '+audienceProofContext+', identify repeated problems, and publish a concise synthesis with one proposed improvement.'};},
      'Stakeholder care':function(){return{title:'User or stakeholder improvement case',body:'Study one person\'s journey through '+audienceProofContext+', identify friction and constraints, and design a practical improvement that preserves both outcomes and human needs.'};},
      'Visible influence':function(){return{title:'Teach, demonstrate, or persuade',body:'Create a short presentation, explainer, workshop, or demonstration about '+audienceProofContext+' and use feedback to improve clarity and usefulness.'};}
    };
    report.proofProjects=report.workModeMap.filter(function(item){return projectTemplates[item.title];}).sort(function(a,b){return b.score-a.score;}).slice(0,3).map(function(item){var project=projectTemplates[item.title]();project.source=item.title+' at '+item.score+'%';return project;});
    var capitalContext={school:'Build career capital before expensive education choices become difficult to reverse.',college:'Convert college time into skill, proof, relationships, and current market understanding.',job:'Improve role targeting by strengthening evidence instead of only increasing application volume.',professional:'Protect accumulated advantages while creating credible evidence for growth or transition.'}[audience];
    report.careerCapitalPlan={context:capitalContext,items:[
      'Skill depth - choose one valuable capability connected to real problems and practise it beyond introductory familiarity.',
      'Proof of work - use the strongest project idea in this report to create an output another person can inspect, test, or discuss.',
      'Execution reliability - '+(conscientiousnessBand==='low'?'use external milestones, accountability, and a narrow finish condition.':conscientiousnessBand==='high'?'ship an earlier version before standards expand and collect real feedback.':'use a light plan, an early checkpoint, and a clear completion date.'),
      'Opportunity relationships - '+(extraversionBand==='low'?'build a smaller number of prepared, relevant one-to-one relationships and follow up with useful work.':extraversionBand==='high'?'turn conversations into specific follow-up, shared value, and visible proof rather than collecting contacts.':'combine selective conversations with consistent written or portfolio visibility.'),
      'Market intelligence - compare current demand, proof requirements, entry routes, economics, and likely future leverage instead of relying on course or role titles.',
      'Sustainable capacity - '+(sensitivityBand==='high'?'design clarity, support, recovery, and financial fallback before increasing uncertainty.':'keep risk review and recovery visible even when pressure feels manageable.')
    ]};
    report.opportunityStrategy=[
      'Discovery - '+(opennessBand==='high'?'use curiosity to ask specific questions, then close each conversation with one decision or experiment.':opennessBand==='low'?'begin with a concrete shared problem or example rather than broad exploratory networking.':'use a practical question with room for one unfamiliar perspective.'),
      'Format - '+(extraversionBand==='high'?'use live conversations, events, demonstrations, and introductions, followed by written next steps.':extraversionBand==='low'?'use thoughtful messages, prepared one-to-one conversations, communities with a clear purpose, and visible work.':'mix focused conversations with asynchronous follow-up and public proof.'),
      'Relationship value - '+(agreeablenessBand==='high'?'help selectively, but keep the request, boundary, and mutual value explicit.':agreeablenessBand==='low'?'lead with useful evidence and direct relevance while showing that you understand the other person\'s priorities.':'balance useful support, candid questions, and a clear reason to continue the relationship.'),
      'Consistency - '+(conscientiousnessBand==='low'?'schedule two small outreach or follow-up actions each week and track the next action.':conscientiousnessBand==='high'?'avoid overpreparing every message; send a useful version and learn from response.':'use a simple weekly rhythm for outreach, contribution, and follow-up.'),
      'Evidence rule - never ask personality language to carry the opportunity. Share a useful observation, work sample, result, thoughtful question, or relevant introduction.'
    ];
    report.workArrangementTests=[
      'Remote test - complete a meaningful output with limited supervision. Track self-starting, focus, isolation, asynchronous visibility, clarification speed, and end-of-day shutdown.',
      'Hybrid test - compare office and remote days for context-switching cost, collaboration quality, commute recovery, deep-work protection, and continuity of ownership.',
      'On-site test - track interaction energy, interruption cost, access to feedback, relationship learning, visible contribution, and recovery after the workday.',
      'Decision rule - do not select an arrangement from Extraversion alone. Compare real output, learning, communication, support, health, responsibilities, and opportunity access.'
    ];
    report.trainableBehaviours=[
      'Organisation and follow-through can improve through systems, smaller deliverables, accountability, and repeated execution practice.',
      'Visibility and communication can improve through preparation, useful work, selective exposure, teaching, and structured feedback.',
      'Candour, cooperation, boundaries, and conflict navigation are behaviours that can be practised in more than one style.',
      'Recovery can be supported through workload design, sleep and health basics, clearer decisions, support, decompression, and professional help when distress is persistent or severe.',
      'Curiosity and practical grounding can both expand through deliberate exposure, evidence standards, real projects, and reflection.',
      'A trait score does not set a ceiling on skill, leadership, earnings, learning, or career change.'
    ];
    report.decisionJournal=[
      'Decision - what exactly am I choosing, and by what date?',
      'Evidence - what have I directly tried, observed, built, measured, or verified?',
      'Trait hypothesis - how might '+report.mostDistinctive.name.toLowerCase()+' be shaping what attracts or repels me?',
      'Counter-evidence - what result, feedback, or context does not fit the personality story?',
      'Market reality - what do current demand, entry requirements, economics, and opportunity pathways show?',
      'Risk control - what is reversible, what is expensive to reverse, and what small experiment should happen first?',
      'Review - what evidence would make me keep, revise, or abandon the decision?'
    ];
    return report;
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function enhancedSectionsHtml(r){
