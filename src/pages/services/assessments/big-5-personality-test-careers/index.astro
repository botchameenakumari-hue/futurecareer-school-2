---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/big-5-personality-test-careers/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Career Preference Type Test',
    description: 'Compare four familiar work-style preference pairs when you want a type-style hypothesis rather than five continuous trait scores.',
  },
  {
    href: '/services/assessments/personality-test-for-career/',
    title: 'Personality Test for Career',
    description: 'Use the broader guide when you want to compare personality, work-style, aptitude, and life-stage assessment routes.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does this Big 5 personality test measure?',
    a: 'It estimates five continuous trait dimensions from your answers: openness, conscientiousness, extraversion, agreeableness, and emotional sensitivity. It also reports 20 narrower facets and practical career implications.',
  },
  {
    q: 'Is this an official or clinically validated Big Five test?',
    a: 'No. It is an independent educational assessment with original statements. The scores are based only on this question set and are not clinical diagnoses, population percentiles, or employer norms.',
  },
  {
    q: 'Can a personality score choose the right career?',
    a: 'No. Traits can improve questions about tasks, teams, pressure, learning, and work environment. Career decisions still need interests, demonstrated capabilities, values, constraints, market evidence, and real experiments.',
  },
  {
    q: 'Why does emotional sensitivity appear instead of labelling someone emotionally stable or unstable?',
    a: 'The result uses less stigmatising language while preserving the underlying trait direction. A higher score means stronger sensitivity to stress and negative emotion in these answers, not weakness, low ability, or poor employability.',
  },
  {
    q: 'Can I download the full result?',
    a: 'Yes. The PDF includes all five traits, 20 facets, response-pattern observations, cross-trait indicators, work hypotheses, practical experiments, audience-specific actions, cautions, and all 40 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Big 5 Personality Test for Careers', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Big 5 Personality Test for Careers',
    alternateName: 'Big Five Career Personality Test',
    description: 'A free original 40-statement Big Five career personality assessment with five trait scores, 20 facets, career interpretation, practical experiments, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Big 5 Personality Test for Careers | Free Big Five Career Test"
  description="Take a free Big 5 personality test for careers. Get five trait scores, 20 facets, career and work-environment insights, practical experiments, and a detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="big5-hero">
      <div class="trait-grid-bg" aria-hidden="true"></div>
      <div class="trait-orb trait-orb--coral" aria-hidden="true"></div>
      <div class="trait-orb trait-orb--blue" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Big 5 Personality Test for Careers</span>
        </nav>
        <div class="eyebrow"><span></span> Five continuous career-relevant traits</div>
        <h1>Big 5 Personality Test <span>for Careers</span></h1>
        <p class="hero-sub">Understand how curiosity, execution, social energy, cooperation, and emotional sensitivity may shape your work. Get practical evidence questions instead of a personality label pretending to choose your career.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>40</strong><span>original statements</span></div>
          <div><strong>20</strong><span>trait facets</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment. Scores are not clinical diagnoses, percentiles, or employer norms.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="trait-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Five dimensions, not five boxes</span><h2>Every trait can help or hinder depending on the task</h2><p>The report treats each score as a continuum. Higher is not automatically better, lower is not automatically worse, and no single trait determines career fit.</p></div>
        <div class="trait-grid">
          <article class="trait-card trait-card--o"><b>O</b><h3>Openness</h3><p>Curiosity, imagination, variety, and comfort with ideas.</p></article>
          <article class="trait-card trait-card--c"><b>C</b><h3>Conscientiousness</h3><p>Organisation, persistence, dependability, and self-discipline.</p></article>
          <article class="trait-card trait-card--e"><b>E</b><h3>Extraversion</h3><p>Social energy, assertiveness, activity, and stimulation.</p></article>
          <article class="trait-card trait-card--a"><b>A</b><h3>Agreeableness</h3><p>Compassion, cooperation, trust, and patience.</p></article>
          <article class="trait-card trait-card--n"><b>N</b><h3>Emotional sensitivity</h3><p>Stress sensitivity, worry, emotional reactivity, and recovery.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer from repeated behaviour</span><h2>Rate how accurately each statement describes you</h2><p>Use your usual pattern across study, work, projects, and relationships. Avoid answering as the person you think an employer wants.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Explore learning, projects, teamwork, and future environments without locking in a career.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Use traits to design stronger projects, internships, skill practice, and role experiments.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Ask sharper questions about daily tasks, teams, pressure, autonomy, and execution expectations.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Examine role design, leadership, collaboration, stress patterns, and transition hypotheses.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. The statements include opposite wording so agreement alone cannot create a high score.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="trait-label" class="trait-label">Personality and work behaviour</span><span id="question-counter">Statement 1 of 40</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="3" aria-valuetext="Statement 1 of 40"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">I create a clear system for important tasks.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how accurately the statement describes you">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly disagree</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Disagree</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neither</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Agree</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly agree</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Big Five career personality results"></div>
        <p class="assessment-note">This original educational assessment is not a clinical instrument. It cannot diagnose a condition, establish a fixed personality, predict job performance, or choose a career by itself.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Turn traits into evidence</span><h2>Use the report to test work, not stereotype yourself</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which trait and facet signals are distinctive, balanced, or context-sensitive.</p></article>
          <article><strong>2</strong><h3>Compare</h3><p>Test contrasting tasks and environments instead of assuming one score tells the whole story.</p></article>
          <article><strong>3</strong><h3>Prove</h3><p>Connect personality hypotheses with demonstrated skill, output, feedback, and market evidence.</p></article>
          <article><strong>4</strong><h3>Design</h3><p>Build systems, boundaries, recovery, and opposite-side habits that improve performance.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you act on a personality score</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Compare another personality framework or use a wider assessment when aptitude, readiness, interests, and career direction also matter." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Big 5 Career Personality Report"
    fileName="future-career-school-big-5-career-personality-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="BIG FIVE CAREER PERSONALITY EVIDENCE REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .big5-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#07131f 0%,#0d1725 62%,#111827 100%)}.trait-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:46px 46px;mask-image:linear-gradient(to bottom,#000,transparent 88%)}.trait-orb{position:absolute;width:450px;height:450px;border-radius:50%;filter:blur(120px);opacity:.17}.trait-orb--coral{left:-180px;top:-70px;background:#fb7185}.trait-orb--blue{right:-170px;bottom:-100px;background:#22d3ee}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#67e8f9;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(103,232,249,.25);border-radius:999px;background:rgba(103,232,249,.07)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#67e8f9;box-shadow:0 0 0 5px rgba(103,232,249,.1)}.big5-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.45rem,6.4vw,5rem);line-height:.96;letter-spacing:-.06em;text-wrap:balance}.big5-hero h1 span{display:block;background:linear-gradient(90deg,#fb7185,#fbbf24,#67e8f9);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.trait-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.trait-section,.faq-section{background:#f5f1e8;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.trait-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem}.trait-card{position:relative;overflow:hidden;padding:1.25rem;border:1px solid #ddd7cb;border-radius:19px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.trait-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--trait)}.trait-card b{display:grid;width:44px;height:44px;place-items:center;border-radius:13px;background:color-mix(in srgb,var(--trait) 15%,white);color:var(--trait);font-size:1.25rem}.trait-card h3{margin:1.05rem 0 .45rem;font-size:1.02rem}.trait-card p,.method-grid p{margin:0;color:#68717d;font-size:13px;line-height:1.6}.trait-card--o{--trait:#8b5cf6}.trait-card--c{--trait:#0ea5e9}.trait-card--e{--trait:#f59e0b}.trait-card--a{--trait:#10b981}.trait-card--n{--trait:#f43f5e}.assessment-section{background:#08121f}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.trait-label{color:#67e8f9;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:2.5%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#8b5cf6,#22d3ee,#fbbf24,#10b981,#fb7185);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.3rem,3vw,1.95rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.profile-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(103,232,249,.28);border-radius:32px;background:radial-gradient(circle at top,rgba(103,232,249,.14),transparent 62%),#101b2a;text-align:center}.profile-mark strong{color:#fff;font-size:2rem;line-height:1}.profile-mark span,.result-kicker{margin-top:.5rem;color:#67e8f9;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.facet-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.facet-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.trait-results{display:grid;gap:.8rem;margin-top:1rem}.trait-result{--trait:#67e8f9;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.trait-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.trait-result h5{margin:0;color:#fff}.trait-result-head strong{color:var(--trait);font-size:1.15rem}.trait-track{position:relative;height:10px;margin:.85rem 0 .55rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.trait-track i{display:block;height:100%;border-radius:inherit;background:var(--trait)}.trait-track:after{content:'';position:absolute;left:50%;top:0;width:1px;height:100%;background:#fff;opacity:.65}.trait-result-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.4rem;color:rgba(255,255,255,.48);font-size:11px}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.indicator-grid,.facet-grid{margin-top:.9rem}.indicator-card strong{display:block;color:#fff;font-size:1.25rem}.indicator-card span{color:#67e8f9;font-size:11px}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.facet-card b{color:#fff}.facet-card span{float:right;color:var(--gold)}.result-section details{margin-top:1rem}.result-section details>summary{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.035);color:#fff;font-weight:800;cursor:pointer}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
  .playbook-heading{margin:1.25rem 0 .5rem!important;padding-top:1.1rem;border-top:1px solid rgba(255,255,255,.08)}
  @media(max-width:980px){.trait-grid{grid-template-columns:repeat(3,1fr)}.method-layout{grid-template-columns:1fr}.result-metrics{grid-template-columns:repeat(2,1fr)}}
