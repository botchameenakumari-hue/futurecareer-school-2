    var pairs=r.pairPatterns.map(function(item){return'<article><h5>'+escapeHtml(item.name)+'</h5><p><strong>'+escapeHtml(item.title)+':</strong> '+escapeHtml(item.body)+'</p><p>'+escapeHtml(item.scores)+'</p></article>';}).join('');
    var dials=r.environmentDials.map(function(item){return'<article class="indicator-card"><span>'+item.band+'</span><strong>'+item.score+'%</strong><h5>'+item.title+'</h5><p>'+item.body+'</p></article>';}).join('');
    var priorities=r.supportPriorities.map(function(item,index){return'<article><h5>'+(index+1)+'. '+item.title+' - '+item.score+'%</h5><p>'+item.action+'</p></article>';}).join('');
    var risks=r.overuseRisks.map(function(item){return'<article><h5>'+item.title+'</h5><p>'+item.body+'</p><p><strong>Counterbalance:</strong> '+item.counterbalance+'</p></article>';}).join('');
    var evidence=r.answerEvidence.map(function(item){return'<article><h5>'+item.name+'</h5><p><strong>Answers pulling upward:</strong></p>'+(item.up.length?listHtml(item.up):'<p>No answers clearly pulled this score upward.</p>')+'<p><strong>Answers pulling downward:</strong></p>'+(item.down.length?listHtml(item.down):'<p>No answers clearly pulled this score downward.</p>')+'</article>';}).join('');
    var workModes=r.workModeMap.map(function(item){return'<article class="indicator-card"><span>'+item.band+'</span><strong>'+item.score+'%</strong><h5>'+item.title+'</h5><p>'+item.body+'</p></article>';}).join('');
    var contributions=r.contributionMap.map(function(item){return'<article class="indicator-card"><span>'+item.band+'</span><strong>'+item.score+'%</strong><h5>'+item.title+'</h5><p>'+item.body+'</p></article>';}).join('');
    var friction=r.skillFrictionMap.map(function(item,index){return'<article><h5>'+(index+1)+'. '+item.title+' - '+item.score+'%</h5><p>'+item.action+'</p></article>';}).join('');
    var roleFlags=r.roleGreenFlags.map(function(item){return'<article><h5>'+item.title+'</h5><p><strong>Green flag:</strong> '+item.green+'</p><p><strong>Caution flag:</strong> '+item.caution+'</p><p><strong>Verify:</strong> '+item.verify+'</p></article>';}).join('');
    var pressure=r.pressurePlan.map(function(item,index){return'<article><h5>'+(index+1)+'. '+item.title+' - '+item.score+'%</h5><p><strong>Watch for:</strong> '+item.signal+'</p><p><strong>Response:</strong> '+item.response+'</p></article>';}).join('');
    var projects=r.proofProjects.map(function(item){return'<article><h5>'+item.title+'</h5><p>'+item.body+'</p><p><strong>Selected from:</strong> '+item.source+'</p></article>';}).join('');
    return '<div class="result-section"><h4>Trait support and hidden facet differences</h4><p>Response support combines distance from the midpoint with paired-item coherence. It describes this answer set only and is not clinical confidence or test-retest reliability.</p><div class="insight-grid">'+support+'</div></div>'+
      '<div class="result-section"><h4>Evidence inside your own answers</h4><p>These statements show what pulled each trait upward or downward. Counter-evidence matters because a useful profile must preserve range and context.</p><div class="insight-grid">'+evidence+'</div></div>'+
      '<div class="result-section"><h4>Four trait-combination patterns</h4><p>Traits often become more useful when interpreted together. These combinations are practical hypotheses, not additional validated scales.</p><div class="insight-grid">'+pairs+'</div></div>'+
      '<div class="result-section"><h4>Your work-environment dials</h4><p>Use the dials to compare environments rather than searching for a perfect personality match.</p><div class="indicator-grid">'+dials+'</div></div>'+
      '<div class="result-section"><h4>Your work-mode map</h4><p>These indicators estimate expressed pull toward different ways of working. They do not measure skill, productivity, leadership, or job performance.</p><div class="indicator-grid">'+workModes+'</div></div>'+
      '<div class="result-section"><h4>Support priorities ranked from the same answers</h4><p>A higher score means the support may deserve earlier testing. It does not mean deficiency or inability.</p><div class="insight-grid">'+priorities+'</div></div>'+
      '<div class="result-section"><h4>When a natural pattern is overused</h4><p>Every trait direction can become costly when used automatically. Counterbalances create range without asking you to become a different person.</p><div class="insight-grid">'+risks+'</div></div>'+
      '<div class="result-section"><h4>How others can work with you more effectively</h4>'+listHtml(r.collaborationManual)+'</div>'+
      '<div class="result-section"><h4>Your feedback and communication protocol</h4><p>Test the protocol with real people and revise it when the situation requires a different approach.</p>'+listHtml(r.feedbackProtocol)+'</div>'+
      '<div class="result-section"><h4>Contribution and leadership modes to test</h4><p>Higher scores suggest a stronger expressed pull in these answers, not leadership ability or readiness.</p><div class="indicator-grid">'+contributions+'</div></div>'+
      '<div class="result-section"><h4>Learning and skill-building playbook</h4>'+listHtml(r.learningPlaybook)+'</div>'+
      '<div class="result-section"><h4>Skill-building friction to design around</h4><p>The four highest planning scores identify where a system may help. They are not fixed weaknesses.</p><div class="insight-grid">'+friction+'</div></div>'+
      '<div class="result-section"><h4>Decision safeguards for your trait pattern</h4>'+listHtml(r.decisionSafeguards)+'</div>'+
