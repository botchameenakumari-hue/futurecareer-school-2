---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/enneagram-personality-test-careers/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Career Preference Type Test',
    description: 'Compare four work-style preference pairs when you want a simpler type-style hypothesis than nine motivation-driven types.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous personality traits and 20 facets when you want a behaviour-based profile instead of a motivation-based type.',
  },
  {
    href: '/services/assessments/disc-personality-test-careers/',
    title: 'DISC Personality Test for Careers',
    description: 'Use four workplace behaviour styles and a style blend when the real question is communication style rather than core motivation.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What is the Enneagram?',
    a: 'The Enneagram describes nine personality types built around core motivations and fears, rather than only observable behaviour. Your result highlights your dominant type and a secondary supporting pattern from your next-highest score.',
  },
  {
    q: 'Is this an official Enneagram test?',
    a: 'No. This is an independent, original 27-statement assessment from Future Career School inspired by Enneagram theory. It is not affiliated with or endorsed by any specific Enneagram institute, author, or certification body.',
  },
  {
    q: 'How is my type calculated?',
    a: 'You rate 27 statements across the nine types (three per type). Each type gets a 0-100 score, and your highest-scoring type becomes your dominant type, with your next-highest score reported as a supporting pattern.',
  },
  {
    q: 'Can my Enneagram type predict which career is right for me?',
    a: 'No. It highlights core motivations that can shape how you experience work, but career decisions still need demonstrated skill, market evidence, constraints, and real experiments, not a type label alone.',
  },
  {
    q: 'What if my top two scores are close together?',
    a: 'That is common. It means you show a genuine blend of two motivational patterns rather than one dominant type, and both are worth paying attention to.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all nine type scores, your dominant type and supporting pattern, workplace guidance, matched career directions, and all 27 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Enneagram Personality Test for Careers', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Enneagram Personality Test for Careers',
    alternateName: 'Enneagram Career Type Test',
    description: 'A free original 27-statement Enneagram-style assessment with all nine type scores, a dominant type and supporting pattern, career-direction matches, and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Enneagram Personality Test for Careers | Free Enneagram Test"
  description="Take a free Enneagram-style personality test for careers. Get all nine type scores, your dominant type, career directions, and a free detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="ennea-hero">
      <div class="ennea-grid-bg" aria-hidden="true"></div>
      <div class="ennea-orb ennea-orb--violet" aria-hidden="true"></div>
      <div class="ennea-orb ennea-orb--rose" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Enneagram Personality Test for Careers</span>
        </nav>
        <div class="eyebrow"><span></span> Nine core motivation types</div>
        <h1>Enneagram Personality <span>Test for Careers</span></h1>
        <p class="hero-sub">Rate 27 real statements and get all nine type scores, your dominant type and supporting pattern, and practical career directions built from core motivation, not just behaviour.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>27</strong><span>original statements</span></div>
          <div><strong>9</strong><span>Enneagram types</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment inspired by Enneagram theory. Not affiliated with or endorsed by any specific Enneagram institute or author.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Nine motivation-driven types</span><h2>Your type is about core motivation, not just behaviour</h2><p>The report scores all nine types and reports your dominant type together with your next-highest score as a supporting pattern.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--1"><b>1</b><h3>The Reformer</h3><p>Principled, improvement-driven, and high standards.</p></article>
          <article class="type-card type-card--2"><b>2</b><h3>The Helper</h3><p>Caring, people-focused, and relationship-driven.</p></article>
          <article class="type-card type-card--3"><b>3</b><h3>The Achiever</h3><p>Success-driven, adaptable, and results-focused.</p></article>
          <article class="type-card type-card--4"><b>4</b><h3>The Individualist</h3><p>Creative, identity-driven, and meaning-seeking.</p></article>
          <article class="type-card type-card--5"><b>5</b><h3>The Investigator</h3><p>Analytical, private, and knowledge-driven.</p></article>
          <article class="type-card type-card--6"><b>6</b><h3>The Loyalist</h3><p>Security-driven, prepared, and reliability-focused.</p></article>
          <article class="type-card type-card--7"><b>7</b><h3>The Enthusiast</h3><p>Adventurous, optimistic, and possibility-driven.</p></article>
          <article class="type-card type-card--8"><b>8</b><h3>The Challenger</h3><p>Assertive, protective, and control-driven.</p></article>
          <article class="type-card type-card--9"><b>9</b><h3>The Peacemaker</h3><p>Harmony-driven, steady, and accommodating.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual, underlying pattern</span><h2>Rate how true each statement is of you</h2><p>Think about your underlying motivation across situations, not just how you act in one specific setting.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Understand what genuinely motivates you before career pressure sets in.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Connect your core motivation to project choices, roles, and career exploration.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Target roles and cultures that genuinely fit what drives you.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Diagnose burnout, mismatch, or leadership patterns tied to core motivation.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each statement on how accurately it describes your usual motivation.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Core motivation statements</span><span id="question-counter">Statement 1 of 27</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Statement 1 of 27"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">I hold myself to a high standard and notice when something isn't done right.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how accurately this describes you">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly disagree</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Disagree</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neither</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Agree</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly agree</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Enneagram type results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not an official Enneagram instrument, does not fix a permanent type, and cannot determine career suitability by itself.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use your type as a motivation map</span><h2>Turn core motivation into better decisions</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which type is dominant and which forms your supporting pattern.</p></article>
          <article><strong>2</strong><h3>Reflect</h3><p>Check whether the underlying motivation, not just the behaviour, actually matches you.</p></article>
          <article><strong>3</strong><h3>Apply</h3><p>Use the career directions as a starting map to investigate, not a final answer.</p></article>
          <article><strong>4</strong><h3>Verify</h3><p>Test your hypothesis against real tasks, feedback, and market evidence.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use your type</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when interests, work-style preferences, or personality traits also need to be covered alongside core motivation." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Enneagram Career Report"
    fileName="future-career-school-enneagram-career-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="ENNEAGRAM CAREER MOTIVATION REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .ennea-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#140a1f 0%,#1b0f26 60%,#241129 100%)}.ennea-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.ennea-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.18}.ennea-orb--violet{left:-180px;top:-60px;background:#a78bfa}.ennea-orb--rose{right:-170px;bottom:-95px;background:#fb7185}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#d8b4fe;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(216,180,254,.28);border-radius:999px;background:rgba(216,180,254,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#d8b4fe;box-shadow:0 0 0 5px rgba(216,180,254,.1)}.ennea-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.3rem,6vw,4.7rem);line-height:.97;letter-spacing:-.056em;text-wrap:balance}.ennea-hero h1 span{display:block;background:linear-gradient(90deg,#a78bfa,#fb7185,#fbbf24);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#f3f0f6;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.type-card{position:relative;overflow:hidden;padding:1.1rem;border:1px solid #ded6e6;border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--ennea)}.type-card b{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--ennea) 15%,white);color:var(--ennea);font-size:1.1rem}.type-card h3{margin:.95rem 0 .42rem;font-size:.98rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:12.5px;line-height:1.55}.type-card--1{--ennea:#0ea5e9}.type-card--2{--ennea:#fb7185}.type-card--3{--ennea:#f59e0b}.type-card--4{--ennea:#a78bfa}.type-card--5{--ennea:#0d9488}.type-card--6{--ennea:#6366f1}.type-card--7{--ennea:#fbbf24}.type-card--8{--ennea:#ef4444}.type-card--9{--ennea:#10b981}.assessment-section{background:#12081a}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#d8b4fe;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:3.7%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#0ea5e9,#fb7185,#f59e0b,#a78bfa,#0d9488,#6366f1,#fbbf24,#ef4444,#10b981);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(216,180,254,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(216,180,254,.16),transparent 62%),#1a0f24;text-align:center}.code-mark strong{color:#fff;font-size:2.6rem}.code-mark span,.result-kicker{margin-top:.5rem;color:#d8b4fe;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.7rem;margin-top:1rem}.type-result{--ennea:#d8b4fe;padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{margin:0;color:#fff;font-size:.95rem}.type-result-head strong{color:var(--ennea);font-size:1.1rem}.type-track{position:relative;height:9px;margin:.75rem 0 .45rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.type-track i{display:block;height:100%;border-radius:inherit;background:var(--ennea)}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.indicator-grid,.career-grid{margin-top:.9rem}.indicator-card strong{display:block;color:#fff;font-size:1.25rem}.indicator-card span{color:#d8b4fe;font-size:11px}.career-card b{color:#fff;display:block;margin-bottom:.3rem}.career-card span{color:var(--gold);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.result-section details{margin-top:1rem}.result-section details>summary{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.035);color:#fff;font-weight:800;cursor:pointer}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
  @media(max-width:980px){.type-grid{grid-template-columns:repeat(3,1fr)}.method-layout{grid-template-columns:1fr}.result-metrics{grid-template-columns:repeat(2,1fr)}}
