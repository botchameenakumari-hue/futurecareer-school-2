  .assessment-section{overflow-anchor:none}.start-shell,.quiz-shell,.result-shell{scroll-margin-top:92px}.audience-option:focus-visible,.scale-options button:focus-visible,.quiz-button:focus-visible,.result-actions a:focus-visible,.result-section summary:focus-visible{outline:3px solid #d8b4fe;outline-offset:3px}.scale-options button{touch-action:manipulation}@media(prefers-reduced-motion:reduce){.audience-option,.scale-options button,.progress-track span{transition:none}}
</style>

<script>
  // @ts-nocheck
  var ORDER=['1','2','3','4','5','6','7','8','9'];
  var TYPES={
    '1':{name:'The Reformer',color:'#0ea5e9',summary:'You may be driven by a wish to act with integrity and improve what is wrong, holding yourself and your work to a high standard.',environment:'Look for roles with clear standards, room to improve real systems, and enough autonomy to do things properly.',careers:['Quality assurance, compliance, and audit','Law, policy, and regulatory work','Engineering and process-improvement roles','Editing, proofreading, and standards-focused writing','Ethics, governance, and operational excellence roles'],highPay:'Compliance, audit, and quality-leadership roles that combine high standards with a formal qualification tend to pay more than general operations roles.',skills:['Distinguishing "good enough" from "must be perfect" to avoid unnecessary delay','Giving feedback on standards without it feeling like personal criticism','Delegating instead of redoing others\' work to your own standard']},
    '2':{name:'The Helper',color:'#fb7185',summary:'You may be driven by a wish to be genuinely useful and valued through supporting other people\'s needs and success.',environment:'Look for roles with real human connection and visible impact on people, with enough boundaries to avoid overextending.',careers:['Human resources, people operations, and employee relations','Healthcare, counselling-adjacent, and education roles','Customer success and client relationship management','Community development and social work','Team coordination and people-development roles'],highPay:'Senior HR, people-operations leadership, and specialised healthcare or counselling-adjacent roles tend to pay more than general front-line support positions.',skills:['Setting boundaries so helping others does not consistently displace your own priorities','Asking directly for support rather than waiting to be noticed','Accepting help and recognition without deflecting it']},
    '3':{name:'The Achiever',color:'#f59e0b',summary:'You may be driven by a wish to succeed and be recognised for visible accomplishment, adapting readily to what earns results.',environment:'Look for roles with clear goals, visible metrics, and real recognition for delivered results.',careers:['Sales, business development, and account management','Management, consulting, and strategy roles','Entrepreneurship and growth-focused roles','Marketing and brand-performance roles','Competitive, results-measured professional fields'],highPay:'Sales, consulting, and management roles that combine achievement drive with measurable results tend to have the highest compensation ceiling in this group, since pay often scales with delivered outcomes.',skills:['Checking whether a goal is genuinely yours or mainly about external recognition','Building in downtime so image and pace do not come at the cost of health','Being honest about setbacks rather than only presenting polished outcomes']},
    '4':{name:'The Individualist',color:'#a78bfa',summary:'You may be driven by a wish for authentic self-expression and meaning, often feeling most alive when work reflects something personally significant.',environment:'Look for roles with creative latitude, meaningful content, and room for a distinctive personal voice.',careers:['Design, art direction, and creative roles','Writing, film, and other original-content fields','Brand strategy and creative marketing roles','Architecture and other meaning-driven design fields','Counselling-adjacent or narrative-based roles that value depth of feeling'],highPay:'Roles that pair creative distinctiveness with a measurable business outcome, such as brand strategy or senior creative direction, tend to pay more consistently than purely expressive creative work.',skills:['Finishing and shipping work rather than endlessly refining for the "right" feeling','Separating a temporary mood from a durable judgement about a role or project','Building routine systems that support consistency without feeling like a loss of identity']},
    '5':{name:'The Investigator',color:'#0d9488',summary:'You may be driven by a wish to understand deeply and maintain independence, gathering knowledge and privacy before committing to action.',environment:'Look for roles with real intellectual depth, autonomy, and enough quiet time to think and analyse properly.',careers:['Data science, research, and analytics','Software engineering and systems architecture','Scientific research and specialised technical fields','Strategy, forecasting, and analytical consulting','Academic and independent research roles'],highPay:'Specialised technical and research roles that combine deep expertise with in-demand skills such as programming or advanced analysis tend to be among the better-paying options in this group.',skills:['Sharing a partial analysis instead of waiting until it feels fully complete','Building in scheduled interaction so independence does not tip into isolation','Practising communicating complex findings simply to non-specialists']},
    '6':{name:'The Loyalist',color:'#6366f1',summary:'You may be driven by a wish for security and reliability, thinking carefully about risk and valuing people and systems you can trust.',environment:'Look for roles with clear structure, dependable teams, and realistic risk management rather than constant uncertainty.',careers:['Operations, risk management, and business continuity','Finance, accounting, and insurance','Project management and process coordination','Cybersecurity and systems-reliability roles','Public service and other stability-oriented institutions'],highPay:'Risk-management, cybersecurity, and finance roles that combine careful risk analysis with a technical or professional qualification tend to pay more than generalist administrative roles.',skills:['Separating a realistic risk from a worst-case scenario before it drives a decision','Building confidence to act on your own judgement without needing constant reassurance','Communicating concerns early and specifically rather than through general worry']},
    '7':{name:'The Enthusiast',color:'#fbbf24',summary:'You may be driven by a wish to stay engaged with possibility and avoid being trapped by limitation, generating ideas and options readily.',environment:'Look for roles with variety, new challenges, and room to pursue promising ideas rather than repetitive, narrow tasks.',careers:['Entrepreneurship and new-venture roles','Marketing, brand, and growth roles','Event, travel, and experience-design fields','Innovation, product, and business-development roles','Journalism and other varied, fast-moving fields'],highPay:'Entrepreneurship, growth, and business-development roles that reward generating and pursuing new opportunities tend to have a high compensation ceiling, though with more income variability than a fixed role.',skills:['Finishing one commitment before starting the next exciting option','Sitting with a difficult feeling or boring task instead of immediately seeking a distraction','Turning a promising idea into a concrete, scoped plan before moving on']},
    '8':{name:'The Challenger',color:'#ef4444',summary:'You may be driven by a wish for control over your own situation and protection of people you care about, acting directly and decisively.',environment:'Look for roles with real ownership, high stakes, and room to act decisively rather than constant committee-style consensus.',careers:['General management and executive leadership','Entrepreneurship and founder-led ventures','Law, advocacy, and negotiation-heavy roles','Operations leadership and turnaround roles','Roles requiring direct confrontation of difficult problems'],highPay:'Executive leadership, entrepreneurship, and high-stakes negotiation roles that combine decisiveness with measurable results tend to have the highest compensation ceiling in this group.',skills:['Checking in on the impact of directness before it damages a relationship you value','Allowing others real influence over decisions instead of controlling every outcome','Naming vulnerability or uncertainty rather than defaulting to control']},
    '9':{name:'The Peacemaker',color:'#10b981',summary:'You may be driven by a wish for internal and external harmony, seeing multiple perspectives easily and avoiding unnecessary conflict.',environment:'Look for roles with a genuinely cooperative culture and enough structure to prevent your own priorities from being lost.',careers:['Mediation, HR, and organisational-development roles','Operations and team-coordination roles','Counselling-adjacent and community roles','Customer service and support leadership','Diplomacy, facilitation, and consensus-building roles'],highPay:'Organisational-development, mediation, and senior HR roles that combine steady facilitation with real business results tend to pay more than general support or coordination roles.',skills:['Stating your own preference clearly instead of automatically deferring to the group','Noticing and addressing a real disagreement instead of smoothing it over','Setting a personal priority and protecting time for it deliberately']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Use your type to understand what genuinely motivates you',body:'Your dominant type can help you notice what draws you to certain subjects, group roles, and activities. It should widen your self-understanding, not lock in a career this early.',actions:['Notice which school activities align with your dominant type\'s core motivation.','Try a role in group work that stretches a less comfortable pattern.','Ask a teacher or mentor for honest feedback on how your motivation shows up in your work.'],caution:'Core motivation can still be developing significantly at this stage. Treat this as a starting reflection, not a fixed identity.'},
    college:{label:'College student',title:'Connect core motivation to stronger project and role choices',body:'Use your type to choose projects, internships, and electives that genuinely engage your core motivation, and to notice when a role fights against it.',actions:['Choose one project or internship that clearly engages your dominant type\'s core motivation.','Ask internship teams what actually matters most in their day-to-day culture.','Notice patterns in which environments drain you versus energise you.'],caution:'A motivation match does not replace demonstrated skill. Build real capability alongside self-understanding.'},
    job:{label:'Job seeker',title:'Target roles and cultures that fit your core motivation',body:'Use your type to filter job searches toward roles and cultures more likely to genuinely engage you long enough to build real expertise.',actions:['Research a target company\'s culture for signs it matches or conflicts with your core motivation.','Prepare interview stories that show your dominant type\'s strengths with a specific, measurable outcome.','Ask interviewers what actually gets rewarded and recognised on their team.'],caution:'A title or brand can look appealing without actually matching your core motivation. Verify with people already doing the job.'},
    professional:{label:'Working professional',title:'Diagnose burnout, mismatch, and leadership patterns',body:'Use your type to understand recurring frustration, burnout, or leadership friction tied to core motivation, and to separate a role problem from a deeper mismatch.',actions:['Identify which parts of your current role genuinely engage your core motivation and which consistently fight against it.','Notice your stress patterns and whether they connect to your dominant type\'s known pressure points.','Test a role redesign or small transition project before assuming a full career change is required.'],caution:'Burnout has many causes beyond personality type, including workload, team, and systems. Do not assume type explains everything.'}
  };
  var QUESTIONS=[
    {type:'1',text:'I hold myself to a high standard and notice when something isn\'t done right.'},
    {type:'2',text:'I go out of my way to notice what other people need and help them.'},
    {type:'3',text:'I\'m driven to succeed and be recognised for my accomplishments.'},
    {type:'4',text:'I feel most authentic when I\'m expressing something uniquely personal.'},
    {type:'5',text:'I prefer to understand something thoroughly before acting on it.'},
    {type:'6',text:'I think carefully about what could go wrong before committing to something.'},
    {type:'7',text:'I get excited about new possibilities and experiences.'},
    {type:'8',text:'I speak my mind directly and don\'t back down easily.'},
    {type:'9',text:'I prefer keeping the peace over pushing my own agenda.'},
    {type:'1',text:'I feel a strong pull to fix or improve things that are clearly wrong.'},
    {type:'2',text:'I feel most valuable when I\'m supporting someone else\'s success.'},
    {type:'3',text:'I adapt how I present myself depending on what will impress the audience.'},
    {type:'4',text:'I often feel different from other people in a way that matters to me.'},
    {type:'5',text:'I need real privacy and time alone to recharge and think.'},
    {type:'6',text:'I value loyalty, security, and having people I can rely on.'},
    {type:'7',text:'I have a hard time sitting with discomfort or boredom for long.'},
    {type:'8',text:'I want to be in control of my own situation rather than depending on others.'},
    {type:'9',text:'I can see multiple sides of a disagreement, which makes it hard to take a firm stance.'},
    {type:'1',text:'I try hard to act with integrity, even when it\'s inconvenient.'},
    {type:'2',text:'I find it hard to say no when someone asks for my help.'},
    {type:'3',text:'Winning or achieving a visible result matters a lot to me.'},
    {type:'4',text:'I\'m drawn to depth of feeling and meaning over surface-level routine.'},
    {type:'5',text:'I feel more comfortable observing and analysing than jumping into action.'},
    {type:'6',text:'I often look for reassurance or a trusted second opinion before deciding.'},
    {type:'7',text:'I like keeping my options open rather than committing too early.'},
    {type:'8',text:'I protect people I care about and confront unfairness directly.'},
    {type:'9',text:'I tend to go along with the group rather than assert my own preference.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Core motivation statements';questionCounter.textContent='Statement '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Statement '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My Type':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 27-Statement Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(value){return(value-1)*25;}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(answers[item.index]);});
      var score=round(average(scored));
      return{type:type,name:TYPES[type].name,color:TYPES[type].color,score:score};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||ORDER.indexOf(a.type)-ORDER.indexOf(b.type);});
    var dominant=ranked[0],supporting=ranked[1];
    var spread=dominant.score-supporting.score;
    var patternLabel=spread<=8?'Your top two types are close together, so you likely show a genuine blend of both motivational patterns rather than one dominant type.':spread<=20?'Your dominant type leads clearly, with your supporting type showing up in specific situations.':'Your dominant type clearly leads your usual motivation pattern, with your supporting type as a smaller secondary influence.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=10?'You used the neutral rating often. That may reflect genuine range or uncertainty; use real examples of your motivation before drawing a strong conclusion.':extremeCount>=16?'You used many strong ratings. Check whether they reflect a repeated real pattern rather than how you see yourself right now.':run>=8?'A long sequence used the same rating. This may be genuine, but review whether a response habit influenced the pattern.':'The response pattern includes a workable mix of agreement, disagreement, and neutral ratings, though it still needs validation against real self-observation.';
    var primary=TYPES[dominant.type],secondary=TYPES[supporting.type];
    var profileTitle=primary.name+' with a '+secondary.name+' supporting pattern';
    var profileSummary='Your dominant type is '+primary.name+' at '+dominant.score+'%, with '+secondary.name+' as your supporting pattern at '+supporting.score+'%. '+patternLabel;
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strongFitCareers=primary.careers.filter(function(career){return secondary.careers.indexOf(career)!==-1;});
    var exploreCareers=mergeUnique(primary.careers,secondary.careers).filter(function(career){return strongFitCareers.indexOf(career)===-1;});
    var highPayNotes=[primary.name+': '+primary.highPay,secondary.name+': '+secondary.highPay];
    var skillPlan=mergeUnique(primary.skills,secondary.skills).slice(0,5);
    var experiments=[
      'Spend two hours this week on a real, small task connected to '+primary.name.toLowerCase()+' work: '+primary.environment.toLowerCase(),
      'Ask one person who knows you well whether your dominant type\'s core motivation actually matches how they see you.',
      'Notice one moment this week when your supporting pattern, '+secondary.name.toLowerCase()+', showed up alongside your dominant type.',
      'Practise one growth skill from your report in a low-stakes, real situation this week.'
    ];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,dominant:dominant,supporting:supporting,spread:spread,patternLabel:patternLabel,profileTitle:profileTitle,profileSummary:profileSummary,strongFitCareers:strongFitCareers.length?strongFitCareers:mergeUnique(primary.careers,secondary.careers).slice(0,3),exploreCareers:exploreCareers,highPayNotes:highPayNotes,skillPlan:skillPlan,experiments:experiments,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Notice which situations most clearly trigger your dominant type\'s core motivation.','Week 2 - Ask two people who know you well whether your self-rating matches what they observe.','Week 3 - Try one real, small task from your top career directions.','Week 4 - Compare evidence from all three weeks against this report before making a bigger decision.'],
      decisionFilters:['Motivation evidence - does the underlying "why", not just the behaviour, genuinely match you?','Feedback evidence - do people who know you well agree with your dominant type?','Task evidence - have you tried representative work in your top career directions?','Stress evidence - does your type\'s known pressure point show up in how you actually respond to setbacks?','Market evidence - have you checked current demand and entry routes for your top directions?'],
      retestPlan:['Wait at least six to eight weeks so the same statements feel less familiar.','Retake after reflecting on real recent situations, not only from memory.','Compare all nine type scores, not only your top two.','Investigate a change of 15 points or more by considering new roles, feedback, or major life changes.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--ennea:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. Type '+item.type+' - '+item.name+'</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var careerCards=function(items,tag){return items.map(function(item){return'<article class="career-card"><span>'+tag+'</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Strongly disagree',2:'Disagree',3:'Neither',4:'Agree',5:'Strongly agree'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>Type '+item.question.type+' - '+TYPES[item.question.type].name+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.dominant.type+'</strong><span>Dominant type</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.profileTitle)+'</h3><p>'+escapeHtml(r.profileSummary)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.dominant.score+'%</strong><span>Dominant type score</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Gap to supporting type</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>Neutral ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your nine Enneagram-style type scores</h4><p>Scores are based only on these 27 statements and are not population percentiles. Your highest score is your dominant type; your next-highest is your supporting pattern.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this type carry?</h4><div class="insight-grid"><article><h5>Pattern strength</h5><p>'+escapeHtml(r.patternLabel)+'</p></article><article><h5>Response pattern</h5><p>'+escapeHtml(r.responseSummary)+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' statements were re-rated. Reconsidering is fine; use real self-observation when two ratings both feel plausible.</p></article><article><h5>A note on self-report</h5><p>Core-motivation questions rely on self-insight, which can be incomplete. Verify with feedback from people who know you well.</p></article></div></div>'+
      '<div class="result-section"><h4>Career directions that match your dominant and supporting type</h4><p>Strongest-fit directions appear in both types. The rest are worth exploring but lean more toward one type.</p><div class="career-grid">'+careerCards(r.strongFitCareers,'Strongest fit')+careerCards(r.exploreCareers,'Worth exploring')+'</div></div>'+
      '<div class="result-section"><h4>Where higher pay tends to concentrate in your top types</h4><p>These are general, directional patterns from common industry knowledge, not guaranteed figures. Always verify current compensation against live job listings for your city and experience level.</p>'+listHtml(r.highPayNotes)+'</div>'+
      '<div class="result-section"><h4>Growth skills worth practising</h4>'+listHtml(r.skillPlan)+'</div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before a career decision</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a diagnosis</h5><p>It does not measure ability, intelligence, or guarantee success in any career direction.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 27 statements and are not comparisons with a national or professional norm.</p></article><article><h5>Not a fixed identity</h5><p>Core motivation can be understood more clearly with age, reflection, and real feedback. Retest periodically.</p></article><article><h5>Not complete career clarity</h5><p>Fuller decisions still need demonstrated skill, market evidence, constraints, and real experiments.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'Enneagram Career Report',fileName:'future-career-school-enneagram-career-report.pdf'});}
</script>
