---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/entrepreneurial-aptitude-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/riasec-holland-code-career-test/',
    title: 'RIASEC Holland Code Career Test',
    description: 'Use six interest types and a three-letter Holland Code when the bigger question is which career families fit you, not only whether venture-building suits you.',
  },
  {
    href: '/services/assessments/disc-personality-test-careers/',
    title: 'DISC Personality Test for Careers',
    description: 'Use four workplace behaviour styles and a style blend for a communication-style profile alongside your entrepreneurial readiness.',
  },
  {
    href: '/services/assessments/emotional-intelligence-test-careers/',
    title: 'Emotional Intelligence Test for Careers',
    description: 'Use five emotional-skill scores when leading people, handling rejection, and staying composed under pressure matter alongside readiness.',
  },
  {
    href: '/services/assessments/enneagram-personality-test-careers/',
    title: 'Enneagram Personality Test for Careers',
    description: 'Use nine core motivation patterns for a deeper look at what drives you beyond your readiness scores.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What does this entrepreneurial aptitude test measure?',
    a: 'It estimates five practical readiness areas from your answers: risk tolerance, resilience, opportunity recognition, execution discipline, and financial and people leadership, plus an overall Entrepreneurial Readiness Score.',
  },
  {
    q: 'Does a high score mean I will succeed as an entrepreneur?',
    a: 'No. This is an independent, original 25-statement educational self-assessment from Future Career School, not a predictor of business outcomes. Venture success depends heavily on market timing, funding, execution, and factors this report cannot measure.',
  },
  {
    q: 'Is a low score a reason not to start something?',
    a: 'Not on its own. Every area on this report can be built deliberately through practice, mentorship, and real experience. Treat a lower score as a specific area to strengthen before or while you build, not a verdict on your potential.',
  },
  {
    q: 'Is this only useful for people who want to start a company?',
    a: 'No. These same five areas also predict how well someone performs in intrapreneurial roles, such as leading a new product line, running a business unit, or driving change inside an existing organisation.',
  },
  {
    q: 'Can entrepreneurial readiness be developed?',
    a: 'Yes. Risk tolerance, resilience, opportunity recognition, execution discipline, and financial and people leadership can all be strengthened through deliberate practice, mentorship, small real experiments, and honest feedback.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all five readiness scores, your overall Entrepreneurial Readiness Score, strengths and gaps, a growth plan, and all 25 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'Entrepreneurial Aptitude Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free Entrepreneurial Aptitude Test',
    alternateName: 'Startup Readiness Test',
    description: 'A free original 25-statement entrepreneurial aptitude assessment covering risk tolerance, resilience, opportunity recognition, execution discipline, and financial and people leadership, with an overall readiness score and a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Entrepreneurial Aptitude Test | Free Readiness Test"
  description="Take a free entrepreneurial aptitude test. Get five readiness scores, an overall Entrepreneurial Readiness Score, strengths, gaps, and a free detailed PDF."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="ea-hero">
      <div class="ea-grid-bg" aria-hidden="true"></div>
      <div class="ea-orb ea-orb--green" aria-hidden="true"></div>
      <div class="ea-orb ea-orb--orange" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">Entrepreneurial Aptitude Test</span>
        </nav>
        <div class="eyebrow"><span></span> Five practical readiness areas</div>
        <h1>Entrepreneurial Aptitude <span>Test</span></h1>
        <p class="hero-sub">Rate 25 real situations and get your risk tolerance, resilience, opportunity recognition, execution discipline, and financial and people leadership scores, an overall Entrepreneurial Readiness Score, and a practical growth plan.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>25</strong><span>original statements</span></div>
          <div><strong>5</strong><span>readiness areas</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational self-assessment. Not a predictor of business success or funding outcomes. Self-reported scores are a starting hypothesis, not proof of actual behaviour.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Five practical readiness areas</span><h2>Entrepreneurial readiness is a skill set, not a fixed trait</h2><p>Each area can be observed, practised, and improved with real experience, not only measured once and left alone.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--rt"><b>RT</b><h3>Risk Tolerance</h3><p>Making calculated decisions under real uncertainty.</p></article>
          <article class="type-card type-card--rs"><b>RS</b><h3>Resilience</h3><p>Recovering from setbacks, rejection, and failed attempts.</p></article>
          <article class="type-card type-card--or"><b>OR</b><h3>Opportunity Recognition</h3><p>Spotting unmet needs and useful problem gaps.</p></article>
          <article class="type-card type-card--ed"><b>ED</b><h3>Execution Discipline</h3><p>Turning ideas into shipped, finished work.</p></article>
          <article class="type-card type-card--fl"><b>FL</b><h3>Financial &amp; People Leadership</h3><p>Managing money discipline and leading others.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Answer for your usual behaviour</span><h2>Rate how true each statement is of you</h2><p>Use your real pattern across study, work, and personal projects, not the version of yourself you wish were always true.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Explore entrepreneurial thinking through projects, clubs, and small real experiments.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Test venture ideas, competitions, or side projects before committing fully.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Compare founder-track, startup, and intrapreneurial roles against stable employment.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Weigh a venture, side business, or internal intrapreneurial move against your current role.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each statement on how accurately it describes your usual pattern.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Readiness statements</span><span id="question-counter">Statement 1 of 25</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" aria-valuetext="Statement 1 of 25"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">I would rather take a calculated risk on a promising idea than wait for a guaranteed but smaller outcome.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how accurately this describes you">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly disagree</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Disagree</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neither</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Agree</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly agree</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="Entrepreneurial aptitude results"></div>
        <p class="assessment-note">This independent test is educational, not predictive. It does not forecast business success, funding outcomes, or financial results.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use the score as a starting hypothesis</span><h2>Turn self-report into real evidence</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which readiness areas are strongest and which need deliberate practice before you commit further.</p></article>
          <article><strong>2</strong><h3>Test</h3><p>Run one small, low-cost real experiment instead of relying on the score alone.</p></article>
          <article><strong>3</strong><h3>Practise</h3><p>Pick one repeatable habit for your lowest-scoring area.</p></article>
          <article><strong>4</strong><h3>Decide</h3><p>Use evidence from real experiments, not the score alone, before a major commitment.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use this score</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when interests, work-style preferences, or personality traits also need to be covered alongside entrepreneurial readiness." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="Entrepreneurial Aptitude Report"
    fileName="future-career-school-entrepreneurial-aptitude-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="ENTREPRENEURIAL READINESS REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .ea-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#07170f 0%,#0d2116 60%,#241a0d 100%)}.ea-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.ea-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.17}.ea-orb--green{left:-180px;top:-60px;background:#22c55e}.ea-orb--orange{right:-170px;bottom:-95px;background:#f97316}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#4ade80;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(74,222,128,.28);border-radius:999px;background:rgba(74,222,128,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 5px rgba(74,222,128,.1)}.ea-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.3rem,6.1vw,4.75rem);line-height:.97;letter-spacing:-.056em;text-wrap:balance}.ea-hero h1 span{display:block;background:linear-gradient(90deg,#4ade80,#facc15,#f97316);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#f1f4ee;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem}.type-card{position:relative;overflow:hidden;padding:1.1rem;border:1px solid #d5ddd0;border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--ea)}.type-card b{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--ea) 15%,white);color:var(--ea);font-size:1rem}.type-card h3{margin:.95rem 0 .42rem;font-size:.98rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:12.5px;line-height:1.55}.type-card--rt{--ea:#f97316}.type-card--rs{--ea:#22c55e}.type-card--or{--ea:#38bdf8}.type-card--ed{--ea:#a78bfa}.type-card--fl{--ea:#facc15}.assessment-section{background:#081310}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#4ade80;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:4%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#f97316,#22c55e,#38bdf8,#a78bfa,#facc15);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(74,222,128,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(74,222,128,.16),transparent 62%),#0c1f14;text-align:center}.code-mark strong{color:#fff;font-size:2.35rem}.code-mark span,.result-kicker{margin-top:.5rem;color:#4ade80;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.8rem;margin-top:1rem}.type-result{--ea:#4ade80;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{margin:0;color:#fff}.type-result-head strong{color:var(--ea);font-size:1.15rem}.type-track{position:relative;height:10px;margin:.85rem 0 .55rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.type-track i{display:block;height:100%;border-radius:inherit;background:var(--ea)}.result-section{margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid rgba(255,255,255,.09)}.result-section h4{margin:0 0 .55rem;color:#fff;font-size:1.25rem}.result-section h5{margin:0 0 .45rem;color:#fff}.insight-grid,.indicator-grid,.career-grid{margin-top:.9rem}.indicator-card strong{display:block;color:#fff;font-size:1.25rem}.indicator-card span{color:#4ade80;font-size:11px}.career-card b{color:#fff;display:block;margin-bottom:.3rem}.career-card span{color:var(--gold);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.signal-list{margin:.6rem 0 0;padding-left:1.1rem}.signal-list li+li{margin-top:.45rem}.result-section details{margin-top:1rem}.result-section details>summary{padding:.9rem 1rem;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.035);color:#fff;font-weight:800;cursor:pointer}.response-table{display:grid;gap:.55rem}.response-row{display:grid;grid-template-columns:36px 1fr auto;gap:.75rem;align-items:start;padding:.75rem;border-radius:10px;background:rgba(255,255,255,.035);font-size:13px}.response-row b{color:var(--gold)}.response-row span{color:rgba(255,255,255,.52)}.result-actions{margin-top:1.4rem}.method-section{background:#fff;color:#17202c}.method-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;align-items:start}.method-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.method-grid article{padding:1.2rem;border:1px solid #e2ded4;border-radius:16px;background:#faf8f3}.method-grid strong{color:#b18425;font-size:12px}.method-grid h3{margin:.8rem 0 .45rem}.faq-list{max-width:900px;margin:0 auto}.faq-list details{border-bottom:1px solid #d9d5cb}.faq-list summary{padding:1rem 0;color:#17202c;font-weight:800;cursor:pointer}.faq-list p{margin:0 0 1rem;color:#68717d;line-height:1.7}[hidden]{display:none!important}
  @media(max-width:980px){.type-grid{grid-template-columns:repeat(3,1fr)}.method-layout{grid-template-columns:1fr}.result-metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.ea-hero{padding-top:112px}.audience-grid,.insight-grid,.indicator-grid,.career-grid,.type-grid,.method-grid{grid-template-columns:1fr}.hero-stats{border-radius:15px}.hero-stats div{padding:.8rem .35rem}.start-shell,.quiz-shell,.result-shell{border-radius:20px}.scale-options{gap:.3rem}.scale-options button{min-height:84px;padding:.25rem}.scale-options button span{font-size:9px;line-height:1.2}.result-head{grid-template-columns:1fr;text-align:center}.code-mark{margin:0 auto}.response-row{grid-template-columns:28px 1fr}.response-row>span:last-child{grid-column:2}.hero-actions>*,.result-actions>*{width:100%;justify-content:center}}
  .assessment-section{overflow-anchor:none}.start-shell,.quiz-shell,.result-shell{scroll-margin-top:92px}.audience-option:focus-visible,.scale-options button:focus-visible,.quiz-button:focus-visible,.result-actions a:focus-visible,.result-section summary:focus-visible{outline:3px solid #4ade80;outline-offset:3px}.scale-options button{touch-action:manipulation}@media(prefers-reduced-motion:reduce){.audience-option,.scale-options button,.progress-track span{transition:none}}
</style>

<script>
  // @ts-nocheck
  var ORDER=['RT','RS','OR','ED','FL'];
  var TYPES={
    RT:{name:'Risk Tolerance',label:'Deciding well under uncertainty',color:'#f97316',summary:'You may be comfortable making calculated decisions without a guaranteed outcome, weighing the upside against a real but bounded downside.',environment:'Look for roles or projects with a defined budget for experiments and real decision-making authority rather than only executing someone else\'s fully fixed plan.',directions:['Early-stage product or venture roles where decisions are made with incomplete information','New-market entry or new-category roles inside an existing company','Roles that involve pitching, negotiating, or defending an unproven idea'],skills:['Writing down the specific worst case before a decision, not just the hoped-for outcome','Setting a small, defined budget of money or time for one real experiment','Distinguishing a calculated risk with a clear hypothesis from an impulsive one']},
    RS:{name:'Resilience',label:'Recovering from setbacks and rejection',color:'#22c55e',summary:'You may recover from a failed attempt, a rejection, or a setback and keep working toward the goal rather than treating one result as final.',environment:'Look for environments with fast feedback loops and room to iterate, rather than a single high-stakes attempt with no chance to adjust.',directions:['Sales, fundraising, or partnership roles with a high volume of rejection before a yes','Product or venture-building roles that involve repeated iteration after failed attempts','Roles inside turnarounds or recovery situations that require sustained effort through setbacks'],skills:['A specific post-setback routine, such as a short written debrief before moving on','Separating a rejected idea from a rejected self-worth judgement','Tracking a rolling log of setbacks and what changed after each one']},
    OR:{name:'Opportunity Recognition',label:'Spotting unmet needs and useful gaps',color:'#38bdf8',summary:'You may notice unmet needs, inefficiencies, or gaps that other people overlook, and reframe them as a specific, testable opportunity.',environment:'Look for roles with direct exposure to real customers, users, or operational friction rather than only secondhand reports about problems.',directions:['Product discovery, research, or customer-insight roles','New-venture scouting or corporate-innovation roles inside larger organisations','Roles that involve auditing a process or market for inefficiency and waste'],skills:['Keeping a running list of small daily frustrations as potential opportunity signals','Talking directly to the people closest to a problem before assuming a solution','Testing whether a noticed gap is common enough for others to pay to solve it']},
    ED:{name:'Execution Discipline',label:'Turning ideas into finished work',color:'#a78bfa',summary:'You may consistently convert ideas into shipped, finished work rather than leaving promising plans unfinished or endlessly refined.',environment:'Look for environments with clear deadlines, visible milestones, and real accountability for finishing rather than only generating ideas.',directions:['Operations, project-management, and delivery-focused roles','Founder or co-founder roles responsible for shipping a minimum viable product','Roles that turn an approved strategy into a concrete, time-bound execution plan'],skills:['Breaking a large idea into one small, shippable version within a set deadline','A weekly review that checks completed output, not only effort spent','Treating "good enough to test" as the real finish line for a first version']},
    FL:{name:'Financial & People Leadership',label:'Managing money and motivating others',color:'#facc15',summary:'You may combine basic financial discipline, such as tracking cost and cash, with the ability to motivate, direct, and retain other people toward a shared goal.',environment:'Look for roles with real budget ownership or team leadership responsibility, even at a small scale, rather than only individual contribution.',directions:['Small-team leadership, general-management, or operations-leadership roles','Roles that involve budgeting, pricing, or unit-economics decisions','Roles that involve recruiting, motivating, and retaining a small team or group of collaborators'],skills:['Tracking a simple weekly budget or cost sheet for any project you run','Practising a specific way of giving a team member honest, useful feedback','Setting one clear, shared goal for a group before assigning individual tasks']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Explore entrepreneurial thinking through small real projects',body:'Your scores can guide which school clubs, competitions, or small projects to try first. It should build a toolkit early, not lock you into a founder identity this soon.',actions:['Run one small, real project this term, such as a club fundraiser or a mini product for classmates.','Ask a mentor or teacher for honest feedback on how you handled a setback in a recent project.','Practise pitching an idea to a small group and note what questions they asked.'],caution:'Entrepreneurial skills develop a great deal with real experience. Treat this as a starting toolkit, not a fixed verdict on whether you should start a company.'},
    college:{label:'College student',title:'Test venture ideas before committing fully',body:'Use your scores to choose competitions, incubator programmes, side projects, or internships that build real, demonstrable evidence before a bigger commitment after graduation.',actions:['Run one small, low-cost experiment for an idea you are curious about, such as a landing page or a pilot sale.','Join a case competition, incubator, or student venture programme to test your execution discipline under real deadlines.','Ask a mentor or founder for specific feedback on your lowest-scoring area.'],caution:'A self-reported score is not the same as demonstrated execution. Build real evidence you can describe specifically to investors, employers, or yourself.'},
    job:{label:'Job seeker',title:'Compare founder-track, startup, and stable roles honestly',body:'Use your scores to compare a startup, founder-track, or intrapreneurial role against a more stable option, and prepare specific evidence for interviews either way.',actions:['Prepare one specific story for each of your top two areas with a clear situation, action, and result.','Ask a startup or intrapreneurial employer what level of ambiguity and risk the role actually involves day to day.','Weigh your current financial runway and risk tolerance honestly before choosing an early-stage role.'],caution:'A single score should not outweigh your actual financial situation, market conditions, and the specific opportunity in front of you.'},
    professional:{label:'Working professional',title:'Weigh a venture or internal move with real evidence',body:'Use your scores to understand whether a side venture, a full-time startup move, or an internal intrapreneurial role fits your current readiness, and where you would need to grow first.',actions:['Run one small, real, low-cost test of your idea before making a full-time decision.','Ask two people who know your work well for honest feedback on your lowest-scoring area.','Model your realistic financial runway before committing to a lower or uncertain income period.'],caution:'A venture decision has real financial and career consequences. Use this report alongside a concrete financial plan and real market evidence, not instead of them.'}
  };
  var QUESTIONS=[
    {type:'RT',reverse:false,text:'I would rather take a calculated risk on a promising idea than wait for a guaranteed but smaller outcome.'},
    {type:'RS',reverse:false,text:'A significant setback usually makes me more determined rather than making me want to quit.'},
    {type:'OR',reverse:false,text:'I regularly notice problems or inefficiencies that other people seem to overlook.'},
    {type:'ED',reverse:false,text:'I usually finish and ship an idea rather than leaving it half-built.'},
    {type:'FL',reverse:false,text:'I keep a fairly clear picture of the money coming in and going out of any project I run.'},
    {type:'RT',reverse:false,text:'I can make a reasonable decision with incomplete information rather than waiting for full certainty.'},
    {type:'RS',reverse:false,text:'I can separate a rejected idea from a judgement about my own worth.'},
    {type:'OR',reverse:false,text:'I can usually reframe a common complaint as a specific, testable opportunity.'},
    {type:'ED',reverse:false,text:'I hit self-imposed deadlines even when no one else is checking on me.'},
    {type:'FL',reverse:false,text:'I can motivate a team or group toward a shared goal even without formal authority over them.'},
    {type:'RT',reverse:true,text:'I tend to avoid a promising opportunity if the outcome is not fully guaranteed.'},
    {type:'RS',reverse:true,text:'One significant failure tends to make me want to give up on the whole idea.'},
    {type:'OR',reverse:true,text:'I rarely notice gaps or unmet needs until someone else points them out.'},
    {type:'ED',reverse:true,text:'I tend to keep refining a plan instead of shipping an imperfect first version.'},
    {type:'FL',reverse:true,text:'I tend to lose track of costs and budgets once a project is underway.'},
    {type:'RT',reverse:false,text:'I can commit resources to an idea while accepting that it might not work out.'},
    {type:'RS',reverse:false,text:'I actively review what went wrong after a setback instead of avoiding the topic.'},
    {type:'OR',reverse:false,text:'I ask the people closest to a problem what they actually need before assuming a solution.'},
    {type:'ED',reverse:false,text:'I break large, vague ideas into small, concrete next steps.'},
    {type:'FL',reverse:false,text:'I give people specific, honest feedback rather than avoiding a difficult conversation.'},
    {type:'RT',reverse:false,text:'I am comfortable defending an unproven idea to sceptical people.'},
    {type:'RS',reverse:false,text:'I keep going on a difficult project even when early results are discouraging.'},
    {type:'OR',reverse:false,text:'I notice patterns across different situations that suggest a bigger underlying opportunity.'},
    {type:'ED',reverse:false,text:'I treat "good enough to test" as a real finish line, not a failure to be perfect.'},
    {type:'FL',reverse:false,text:'I set one clear, shared goal for a group before assigning individual tasks.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Readiness statements';questionCounter.textContent='Statement '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Statement '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My Readiness Report':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 25-Statement Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(question,value){var raw=(value-1)*25;return question.reverse?100-raw:raw;}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(item.q,answers[item.index]);});
      var score=round(average(scored));
      return{type:type,name:TYPES[type].name,label:TYPES[type].label,color:TYPES[type].color,score:score};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||ORDER.indexOf(a.type)-ORDER.indexOf(b.type);});
    var composite=round(average(typeResults.map(function(item){return item.score;})));
    var compositeLabel=composite>=70?'Your self-reported answers suggest comparatively strong entrepreneurial readiness signals overall.':composite>=45?'Your self-reported answers suggest a moderate, fairly typical readiness profile.':'Your self-reported answers suggest real room to build entrepreneurial readiness deliberately before a major commitment.';
    var strongest=ranked[0],weakest=ranked[ranked.length-1];
    var spread=strongest.score-weakest.score;
    var spreadLabel=spread>=35?'Your five areas differ quite a lot - '+strongest.name+' is a clear relative strength and '+weakest.name+' is a clear area to build.':spread>=15?'Your five areas differ moderately, with '+strongest.name+' leading and '+weakest.name+' trailing.':'Your five areas are fairly close together, so your readiness profile does not show one dominant strength or weakness.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=9?'You used the neutral rating often. That may reflect genuine range or uncertainty; run a real small experiment before drawing a strong conclusion.':extremeCount>=15?'You used many strong ratings. Self-reported extreme scores can reflect how you want to see yourself as much as real behaviour; verify with a real test.':run>=8?'A long sequence used the same rating. This may be genuine, but review whether attention or a response habit influenced the pattern.':'The response pattern includes a workable mix of agreement, disagreement, and neutral ratings, though it still needs validation against real experience.';
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strongDirections=mergeUnique(TYPES[strongest.type].directions,TYPES[ranked[1].type].directions).slice(0,5);
    var growthPlan=TYPES[weakest.type].skills;
    var experiments=[
      'Ask two people who know your work well to rate your top and bottom area from this report, then compare their view with yours.',
      'Practise one specific habit from your growth plan for two weeks and note one real example of the change.',
      'Use '+TYPES[strongest.type].name.toLowerCase()+' deliberately in one real situation this week: '+TYPES[strongest.type].environment.toLowerCase(),
      'Run one small, low-cost real test of an idea this month instead of relying on the score alone to decide.'
    ];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(q,answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,composite:composite,compositeLabel:compositeLabel,strongest:strongest,weakest:weakest,spread:spread,spreadLabel:spreadLabel,strongDirections:strongDirections,growthPlan:growthPlan,experiments:experiments,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Ask two people who know your work well to rate your strongest and weakest area, and compare with your own scores.','Week 2 - Practise one specific habit from your growth plan and record one real example of using it.','Week 3 - Run one small, low-cost real test of an idea and record what actually happened, not what you expected.','Week 4 - Compare evidence from all three weeks against this report before treating it as a settled conclusion.'],
      decisionFilters:['Feedback evidence - does your self-rating match what people who know your work actually observe?','Behaviour evidence - can you point to a specific recent example, not just a general feeling?','Financial evidence - have you modelled your realistic runway and downside before committing further?','Market evidence - does a real person outside your circle actually want what you are proposing to build?','Growth evidence - have you practised your lowest area deliberately, or only noticed it?'],
      retestPlan:['Wait at least six to eight weeks so the same statements feel less familiar.','Retake after running at least one real, small experiment rather than only from memory.','Compare all five area scores, not only the composite number.','Investigate a change of 15 points or more by considering new experience, feedback, or deliberate practice.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--ea:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. '+item.name+' ('+item.label+')</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var directionCards=function(items){return items.map(function(item){return'<article class="career-card"><span>Worth exploring</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Strongly disagree',2:'Disagree',3:'Neither',4:'Agree',5:'Strongly agree'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>'+TYPES[item.question.type].name+(item.question.reverse?' / reverse-scored':'')+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.composite+'%</strong><span>Entrepreneurial Readiness Score</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.strongest.name+' leads, '+r.weakest.name+' trails')+'</h3><p>'+escapeHtml(r.compositeLabel)+' '+escapeHtml(r.spreadLabel)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.composite+'%</strong><span>Readiness score</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Spread between strongest and weakest</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>Neutral ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your five readiness scores</h4><p>Scores are based only on these 25 statements and are not population percentiles or a predictor of business outcomes.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this score carry?</h4><div class="insight-grid"><article><h5>Overall pattern</h5><p>'+escapeHtml(r.compositeLabel)+'</p></article><article><h5>Spread across areas</h5><p>'+escapeHtml(r.spreadLabel)+'</p></article><article><h5>Response pattern</h5><p>'+escapeHtml(r.responseSummary)+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' statements were re-rated. Reconsidering is fine; use real experience when two ratings both feel plausible.</p></article></div></div>'+
      '<div class="result-section"><h4>Where your top two areas create the most leverage</h4><p>These are directions worth investigating, not a guarantee of business success. Market timing, funding, and execution all matter far more than any single score.</p><div class="career-grid">'+directionCards(r.strongDirections)+'</div></div>'+
      '<div class="result-section"><h4>A growth plan for your lowest-scoring area</h4>'+listHtml(r.growthPlan)+'</div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before trusting this score</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a predictor</h5><p>It does not forecast business success, funding outcomes, revenue, or financial results.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 25 statements and are not comparisons with a national, founder, or investor norm.</p></article><article><h5>Not proof of behaviour</h5><p>Self-reported scores can differ from how you actually behave under real pressure. Verify with a real small experiment.</p></article><article><h5>Not complete decision evidence</h5><p>A real decision still needs a financial plan, market evidence, and honest conversations with people who know your situation.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'Entrepreneurial Aptitude Report',fileName:'future-career-school-entrepreneurial-aptitude-report.pdf'});}
</script>
