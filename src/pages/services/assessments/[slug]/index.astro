---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import BofuFeatureSection from '../../../../components/bofu/BofuFeatureSection.astro';
import BofuFaqSection from '../../../../components/bofu/BofuFaqSection.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import {
  ASSESSMENT_PAGES,
  ASSESSMENT_PAGE_REDIRECTS,
  ASSESSMENT_TARGETS,
  type AssessmentPage,
  type AssessmentTargetId,
} from '../../../../config/assessmentPages';
import {
  getAssessmentPlansConfig,
  resolveAssessmentPlansMode,
} from '../../../../config/assessmentPlans';

export function getStaticPaths() {
  return [
    ...ASSESSMENT_PAGES.map((page) => ({
      params: { slug: page.slug },
      props: { page },
    })),
    ...Object.entries(ASSESSMENT_PAGE_REDIRECTS).map(([slug, canonicalSlug]) => ({
      params: { slug },
      props: { redirectTarget: `/services/assessments/${canonicalSlug}/` },
    })),
  ];
}

const { page, redirectTarget } = Astro.props as {
  page?: AssessmentPage;
  redirectTarget?: string;
};

if (redirectTarget) {
  return Astro.redirect(redirectTarget, 301);
}

if (!page) {
  return Astro.redirect('/services/assessments/', 302);
}
const target = ASSESSMENT_TARGETS[page.target];
const pageUrl = `https://futurecareerschool.com/services/assessments/${page.slug}/`;
const requestedAssessmentTargets: AssessmentTargetId[] = [
  page.target,
  ...(page.relatedTargets ?? []),
];
const expandedAssessmentTargets = requestedAssessmentTargets.includes('personality')
  ? [...requestedAssessmentTargets, 'big5' as AssessmentTargetId]
  : requestedAssessmentTargets;
const relevantAssessmentTargets = expandedAssessmentTargets.filter((id, index, all) => all.indexOf(id) === index).map((id) => ({
  id,
  ...ASSESSMENT_TARGETS[id],
}));
const plansMode = resolveAssessmentPlansMode(
  relevantAssessmentTargets.map((item) => item.guidanceMode),
);
const plansConfig = getAssessmentPlansConfig(plansMode);
const showRelevantAssessmentChoices = relevantAssessmentTargets.length > 1;
const heroPrimaryHref = showRelevantAssessmentChoices ? '#hero-assessment-choices' : target.href;
const heroPrimaryLabel = showRelevantAssessmentChoices ? 'Choose Your Free Assessment' : target.label;
const heroSecondaryHref = plansConfig.jumpHref;
const heroSecondaryLabel = plansConfig.jumpLabel;
const visibleRelatedPhrases = [
  ...new Set([page.hubTitle, ...page.relatedPhrases, ...(page.coveredPhrases ?? [])]),
].slice(0, 6);

const toSentenceCase = (value: string) =>
  value
    .split(/(\s+)/)
    .map((part, index) => {
      if (!part.trim()) {
        return part;
      }

      if (/^[A-Z0-9]{2,}$/.test(part)) {
        return part;
      }

      const lowered = part.toLowerCase();
      return index === 0 ? lowered.charAt(0).toUpperCase() + lowered.slice(1) : lowered;
    })
    .join('');

const cleanAssessmentCopy = (value: string) =>
  value
    .replace(
      /\bA broad landing page for ([^.]*) before deciding\b/gi,
      'A broad starting point for $1 before choosing',
    )
    .replace(/\bFor (?:a |an )?broad [a-z0-9 -]+? search,\s*/gi, 'When the need is broad, ')
    .replace(/\bFor (?:a |an )?[a-z0-9 -]+? search,\s*/gi, 'For this kind of need, ')
    .replace(/\bWhen (?:a |an )?broad ([a-z0-9 -]+?) search becomes useful\b/gi, 'When to use a broad $1')
    .replace(/\bWhen ([^.]+?) becomes useful\b/gi, 'When to use $1')
    .replace(/\bA ([^.]+?) search is usually broad\./gi, 'Many people start with a broad $1.')
    .replace(/\bA ([a-z0-9 -]+?) search usually appears when\b/gi, 'Use $1 when')
    .replace(/\bThis search matters when\b/gi, 'Use this when')
    .replace(/\bA broad ([a-z0-9 -]+?) search should\b/gi, 'A broad $1 need should')
    .replace(/\bA ([a-z0-9 -]+?) search should\b/gi, 'A $1 need should')
    .replace(/\bthe search to the correct\b/gi, 'the need to the correct')
    .replace(/\bsearch people use\b/gi, 'phrase people use')
    .replace(/\bsearch looks broad\b/gi, 'need looks broad')
    .replace(/\bsearches\b/gi, 'needs')
    .replace(/\bbroad ([a-z0-9 -]+?) search\b/gi, 'broad $1 need')
    .replace(/\bThe better first move is not\b/gi, 'A better first step is not')
    .replace(/\bthe person knows\b/gi, 'you know')
    .replace(/\byour search still feels\b/gi, 'your situation still feels')
    .replace(/\bsearch is really about\b/gi, 'need is really about')
    .replace(/\bsearch still\b/gi, 'need still')
    .replace(/\bsearch feels\b/gi, 'need feels')
    .replace(/\bsearch is\b/gi, 'need is')
    .replace(/\bfor this search\b/gi, '')
    .replace(/\bthis search is broad enough\b/gi, '')
    .replace(/\bsearchers who want\b/gi, 'people who want')
    .replace(/\bfor people searching\b/gi, 'for')
    .replace(/\bfor people who want\b/gi, 'for')
    .replace(/\bBut users should still compare\b/gi, 'Compare')
    .replace(/\bBut users should compare\b/gi, 'Compare')
    .replace(/\busers should still compare\b/gi, 'compare')
    .replace(/\busers should compare\b/gi, 'compare')
    .replace(/\bbroad searchers should compare\b/gi, 'compare')
    .replace(/\bstudent searchers should compare\b/gi, 'students should compare')
    .replace(/\bbroad online searchers should compare\b/gi, 'compare')
    .replace(/\bwhen users\b/gi, 'when you')
    .replace(/\bSchool students, after-12th users\b/gi, 'School students, after-12th students')
    .replace(/\bschool and after-12th users\b/gi, 'school and after-12th students')
    .replace(/\bschool-stage users\b/gi, 'school-stage students')
    .replace(/\bClass 11 and 12 users\b/gi, 'Class 11 and 12 students')
    .replace(/\bafter-12th users\b/gi, 'after-12th students')
    .replace(/\bShould after-10th and after-12th users (use|take)\b/gi, 'Should after-10th and after-12th students $1')
    .replace(/\busers from taking\b/gi, 'people from taking')
    .replace(/\busers can\b/gi, 'you can')
    .replace(/\busers\b/gi, 'people')
    .replace(/\bwhat people usually mean\b/gi, 'what this usually points to')
    .replace(/\blanding page\b/gi, 'option')
    .replace(/\bpaid guidance layer\b/gi, 'updated career guidance')
    .replace(/\bthe paid layer\b/gi, 'updated career guidance')
    .replace(/\bfree first layer\b/gi, 'free starting point')
    .replace(/\bfuller career guidance\b/gi, 'updated career guidance')
    .replace(/\bfuller guidance\b/gi, 'stronger guidance')
    .replace(/\bbroader career guidance\b/gi, 'career guidance')
    .replace(/\bbroader guidance\b/gi, 'more complete guidance')
    .replace(/\bThe stronger first move is choosing\b/gi, 'Start with')
    .replace(/\bThe stronger first move is\b/gi, 'Start with')
    .replace(/\bThe stronger move is choosing\b/gi, 'Start with')
    .replace(/\bStart with not\b/gi, 'The right first step is not')
    .replace(/\bThe useful first step is\b/gi, 'Start with')
    .replace(/\bThe stronger move is\b/gi, 'Start with')
    .replace(
      /\bWhat still needs the updated career guidance after the test\b/gi,
      'What may still need updated guidance after the test',
    )
    .replace(/\bThis search usually appears when\b/gi, 'Use this when')
    .replace(/\s{2,}/g, ' ')
    .replace(/\s+([,.])/g, '$1')
    .trim();

const renderedPage = {
  metaTitle: cleanAssessmentCopy(page.metaTitle),
  metaDescription: cleanAssessmentCopy(page.metaDescription),
  hubTitle: cleanAssessmentCopy(page.hubTitle),
  h1: toSentenceCase(cleanAssessmentCopy(page.h1)),
  pill: cleanAssessmentCopy(page.pill),
  heroSub: cleanAssessmentCopy(page.heroSub),
  fitTitle: cleanAssessmentCopy(page.fitTitle),
  fitSubtitle: cleanAssessmentCopy(page.fitSubtitle),
  fitItems: page.fitItems.map((item) => ({
    title: cleanAssessmentCopy(item.title),
    body: cleanAssessmentCopy(item.body),
  })),
  decideTitle: cleanAssessmentCopy(page.decideTitle),
  decideSubtitle: cleanAssessmentCopy(page.decideSubtitle),
  decideItems: page.decideItems.map((item) => ({
    title: cleanAssessmentCopy(item.title),
    body: cleanAssessmentCopy(item.body),
  })),
  bestFitTitle: cleanAssessmentCopy(page.bestFitTitle),
  bestFitBody: cleanAssessmentCopy(page.bestFitBody),
  faqItems: page.faqItems.map((item) => ({
    question: cleanAssessmentCopy(item.question),
    answer: cleanAssessmentCopy(item.answer),
  })),
};

const bestFitHeading = renderedPage.bestFitTitle.replace(/ for this search/gi, '');
const bestFitBody = renderedPage.bestFitBody;
const relatedAssessmentHrefs = new Set(relevantAssessmentTargets.map((item) => item.href));
const supportLinksByTarget: Record<
  AssessmentTargetId,
  { href: string; title: string; description: string }[]
> = {
  class10: [
    {
      href: '/services/assessments/class-10-and-below/',
      title: 'Class 10 and Below Assessment',
      description:
        'Use the full student assessment when the question is not only stream choice, but overall student fit and early direction.',
    },
    {
      href: '/services/assessments/stream-selector-test-after-10th/',
      title: 'Stream Selector Test After 10th',
      description:
        'Use the direct stream quiz when the decision is specifically Science, Commerce, or Arts after Class 10.',
    },
    {
      href: '/services/assessments/career-aptitude-test-after-10th/',
      title: 'Career Aptitude Test After 10th',
      description:
        'Use the aptitude test when the bigger need is understanding natural strengths before stream pressure hardens.',
    },
  ],
  class1112: [
    {
      href: '/services/assessments/class-11-to-12/',
      title: 'Class 11 and 12 Assessment',
      description:
        'Use the full student assessment when the real need is student direction across interests, aptitude, learning style, and fuller clarity.',
    },
    {
      href: '/services/assessments/stream-selector-test-after-12th/',
      title: 'Career Test After 12th',
      description:
        'Use the direct after-12th quiz when you want broader path-fit clarity before choosing a degree or course family.',
    },
    {
      href: '/services/assessments/career-aptitude-test-after-12th/',
      title: 'Career Aptitude Test After 12th',
      description:
        'Use the aptitude test when the stronger need is skill-fit clarity before choosing a degree or training path after Class 12.',
    },
  ],
  graduates: [
    {
      href: '/services/assessments/graduates-and-early-professionals/',
      title: 'Graduates and Early Professionals Assessment',
      description:
        'Use the full graduate assessment when the issue is role fit, employability, career clarity, or skill direction after graduation.',
    },
    {
      href: '/services/assessments/working-professionals-and-career-changers/',
      title: 'Working Professional and Career Changer Assessment',
      description:
        'Use this when the decision is starting to lean toward transition, salary growth, or under-leveraged professional skills.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare all twelve free assessments when you want to see every student, graduate, job-seeker, and working-professional option in one place.',
    },
  ],
  placement: [
    {
      href: '/services/assessments/placement-aptitude-test/',
      title: 'Placement Aptitude Test',
      description:
        'Check numerical, logical, verbal, data-interpretation, and workplace-judgement readiness before placement or job aptitude rounds.',
    },
    {
      href: '/services/assessments/graduates-and-early-professionals/',
      title: 'Graduates and Early Professionals Assessment',
      description:
        'Use the broader graduate assessment when the question also includes role fit, employability, skill direction, and career clarity.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare the complete set of free assessments for students, graduates, job seekers, and working professionals.',
    },
  ],
  numerical: [
    {
      href: '/services/assessments/numerical-reasoning-test/',
      title: 'Numerical Reasoning Test',
      description:
        'Check percentages, ratios, rates, number logic, data interpretation, estimation, and practical quantitative decisions.',
    },
    {
      href: '/services/assessments/placement-aptitude-test/',
      title: 'Placement Aptitude Test',
      description:
        'Use the wider placement test when you also need logical, verbal, data, and workplace-judgement practice.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare the complete set of free assessments for students, graduates, job seekers, and working professionals.',
    },
  ],
  verbal: [
    {
      href: '/services/assessments/verbal-reasoning-test/',
      title: 'Verbal Reasoning Test',
      description:
        'Check comprehension, vocabulary in context, language precision, inference, verbal relationships, and clear communication.',
    },
    {
      href: '/services/assessments/placement-aptitude-test/',
      title: 'Placement Aptitude Test',
      description:
        'Use the wider placement test when you also need numerical, logical, data-interpretation, and workplace-judgement practice.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare the complete set of free assessments for students, graduates, job seekers, and working professionals.',
    },
  ],
  personality: [
    {
      href: '/services/assessments/myers-briggs-career-test/',
      title: 'Career Preference Type Test',
      description:
        'Explore four work-style preference pairs, preference strength, context sensitivity, career experiments, and environment fit without turning a type code into a career verdict.',
    },
    {
      href: '/services/assessments/graduates-and-early-professionals/',
      title: 'Graduates and Early Professionals Assessment',
      description:
        'Use the broader graduate assessment when the question also includes readiness, employability, role direction, and high-value skill building.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare the complete set of free assessments for students, graduates, job seekers, and working professionals.',
    },
  ],
  professionals: [
    {
      href: '/services/assessments/working-professionals-and-career-changers/',
      title: 'Working Professional and Career Changer Assessment',
      description:
        'Use the full professional assessment when the issue is transition, stagnation, AI pressure, skill under-leverage, or a higher-value career move.',
    },
    {
      href: '/services/assessments/graduates-and-early-professionals/',
      title: 'Graduates and Early Professionals Assessment',
      description:
        'Use this if your situation still feels closer to early-career role fit and employability than a full professional pivot.',
    },
    {
      href: '/services/assessments/',
      title: 'All Free Career Assessments',
      description:
        'Compare every free assessment when you want to choose between graduate, transition, aptitude, and student-first assessment options.',
    },
  ],
  stream10: [
    {
      href: '/services/assessments/stream-selector-test-after-10th/',
      title: 'Stream Selector Test After 10th',
      description:
        'Use the direct free stream quiz when the decision is specifically Science, Commerce, or Arts after Class 10.',
    },
    {
      href: '/services/assessments/career-aptitude-test-after-10th/',
      title: 'Career Aptitude Test After 10th',
      description:
        'Use the aptitude test when the stronger need is understanding natural strength patterns before stream selection.',
    },
    {
      href: '/services/assessments/class-10-and-below/',
      title: 'Class 10 and Below Assessment',
      description:
        'Use the full student assessment when stream choice is only one part of a larger student-direction question.',
    },
  ],
  aptitude10: [
    {
      href: '/services/assessments/career-aptitude-test-after-10th/',
      title: 'Career Aptitude Test After 10th',
      description:
        'Use the direct free aptitude test when the question is strength-fit before stream choice after Class 10.',
    },
    {
      href: '/services/assessments/stream-selector-test-after-10th/',
      title: 'Stream Selector Test After 10th',
      description:
        'Use the stream quiz when the issue is choosing Science, Commerce, or Arts rather than aptitude alone.',
    },
    {
      href: '/services/assessments/class-10-and-below/',
      title: 'Class 10 and Below Assessment',
      description:
        'Use the full student assessment when stream choice is only one part of a larger school-stage direction question.',
    },
  ],
  stream12: [
    {
      href: '/services/assessments/stream-selector-test-after-12th/',
      title: 'Career Test After 12th',
      description:
        'Use the direct free path-fit test when the bigger question is which course or broad direction fits better after Class 12.',
    },
    {
      href: '/services/assessments/career-aptitude-test-after-12th/',
      title: 'Career Aptitude Test After 12th',
      description:
        'Use the aptitude test when the stronger question is natural strengths before choosing a course or degree path.',
    },
    {
      href: '/services/assessments/class-11-to-12/',
      title: 'Class 11 and 12 Assessment',
      description:
        'Use the full student assessment when you still need interests, aptitude, and direction together instead of one narrower test only.',
    },
  ],
  aptitude12: [
    {
      href: '/services/assessments/career-aptitude-test-after-12th/',
      title: 'Career Aptitude Test After 12th',
      description:
        'Use the direct free aptitude test when the key question is skill fit before choosing a degree or training path after Class 12.',
    },
    {
      href: '/services/assessments/stream-selector-test-after-12th/',
      title: 'Career Test After 12th',
      description:
        'Use the after-12th path quiz when the issue is course or degree direction beyond aptitude alone.',
    },
    {
      href: '/services/assessments/class-11-to-12/',
      title: 'Class 11 and 12 Assessment',
      description:
        'Use the full student assessment when the issue includes interests, learning style, aptitude, and after-school direction together.',
    },
  ],
};

const siblingAssessmentLinks = ASSESSMENT_PAGES.filter(
  (item) => item.slug !== page.slug && item.hubGroup === page.hubGroup,
)
  .slice(0, 3)
  .map((item) => ({
    href: `/services/assessments/${item.slug}/`,
    title: cleanAssessmentCopy(item.hubTitle),
    description: cleanAssessmentCopy(item.hubDescription),
  }));

const clientFacingDescription = (value: string) =>
  cleanAssessmentCopy(value)
    .replace(/\bpages\b/gi, 'options')
    .replace(/\bpage\b/gi, 'option');

const relatedLinks = [...supportLinksByTarget[page.target], ...siblingAssessmentLinks]
  .filter((item) => !(showRelevantAssessmentChoices && relatedAssessmentHrefs.has(item.href)))
  .filter((item, index, all) => all.findIndex((candidate) => candidate.href === item.href) === index)
  .map((item) => ({
    ...item,
    description: clientFacingDescription(item.description),
  }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://futurecareerschool.com/services',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Assessments',
        item: 'https://futurecareerschool.com/services/assessments',
      },
      { '@type': 'ListItem', position: 4, name: renderedPage.hubTitle, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: renderedPage.metaTitle,
    description: renderedPage.metaDescription,
    url: pageUrl,
    inLanguage: 'en-IN',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: renderedPage.faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={renderedPage.metaTitle}
  description={renderedPage.metaDescription}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/services/assessments">Assessments</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{renderedPage.hubTitle}</span>
      </nav>

      <div class="pill">
        <span class="dot"></span>
        {renderedPage.pill}
      </div>

      <h1>{renderedPage.h1}</h1>
      <p class="hero-sub">{renderedPage.heroSub}</p>

      <div class="meta-chips">
        <span class="meta-chip">100% free</span>
        <span class="meta-chip">Practical and updated</span>
        <span class="meta-chip">AI-based career and skill assessment</span>
        <span class="meta-chip">No payment required</span>
      </div>

      <div class="meta-chips meta-chips-muted">
        {visibleRelatedPhrases.map((phrase) => <span class="meta-chip meta-chip-muted">{phrase}</span>)}
      </div>

      <div class="hero-actions">
        <a href={heroPrimaryHref} class="btn-gold pulse">{heroPrimaryLabel}</a>
        <a href={heroSecondaryHref} class="btn-outline">{heroSecondaryLabel}</a>
      </div>

      {showRelevantAssessmentChoices && (
        <div id="hero-assessment-choices" class="hero-choice-wrap card">
          <div class="hero-choice-copy">
            <div class="hero-choice-kicker">Start here</div>
            <h2>Choose the free assessment that fits you best</h2>
            <p>
              Different stages need different free assessments. Pick the one that matches where
              you are and the kind of clarity you need right now.
            </p>
          </div>

          <div class="hero-choice-grid">
            {relevantAssessmentTargets.map((item) => (
              <article class="hero-choice-card">
                <div class="hero-choice-badge">100% free</div>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <a href={item.href} class="btn-gold hero-choice-cta">{item.label}</a>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <BofuFeatureSection
    sectionId="when-it-fits"
    title={renderedPage.fitTitle}
    subtitle={renderedPage.fitSubtitle}
    items={renderedPage.fitItems}
    variant="signal"
    columns={3}
  />

  {!showRelevantAssessmentChoices && (
    <section id="best-fit">
      <div class="container">
        <div class="best-fit-card card">
          <div class="best-fit-copy">
            <div class="best-fit-kicker">Recommended free assessment</div>
            <h2>{bestFitHeading}</h2>
            <p class="best-fit-body">{bestFitBody}</p>
          </div>

          <div class="best-fit-panel">
            <div class="best-fit-panel-title">{target.title}</div>
            <p>{target.summary}</p>
            <div class="best-fit-actions">
              <a href={target.href} class="btn-gold pulse">{target.label}</a>
              <a href={heroSecondaryHref} class="btn-outline">{heroSecondaryLabel}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <BofuFeatureSection
    sectionId="what-it-should-help"
    title={renderedPage.decideTitle}
    subtitle={renderedPage.decideSubtitle}
    items={renderedPage.decideItems}
    variant="decision"
    columns={3}
  />

  <LinkDirectorySection
    sectionId="related-assessment-pages"
    title={showRelevantAssessmentChoices ? 'You may also want these next' : 'Related free assessments'}
    subtitle={
      showRelevantAssessmentChoices
        ? 'If your decision is already more specific, use one of these options next.'
        : 'Use these options if the decision needs a different stage, a narrower test, or a more complete assessment.'
    }
    items={relatedLinks}
    altBackground={true}
  />

  <BofuFaqSection
    sectionId="faq"
    title="Common questions before you start"
    items={renderedPage.faqItems}
  />

  <AssessmentGuidanceCta mode={plansMode} sectionId="guidance-bridge" />

  <GuidancePlansSection
