---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import AssessmentReportTools from '../../../../components/AssessmentReportTools.astro';
import AssessmentGuidanceCta from '../../../../components/bofu/AssessmentGuidanceCta.astro';
import GuidancePlansSection from '../../../../components/bofu/GuidancePlansSection.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';
import { getAssessmentPlansConfig } from '../../../../config/assessmentPlans';

const pageUrl = 'https://futurecareerschool.com/services/assessments/riasec-holland-code-career-test/';
const plansConfig = getAssessmentPlansConfig('mixed');

const relatedLinks = [
  {
    href: '/services/assessments/myers-briggs-career-test/',
    title: 'Career Preference Type Test',
    description: 'Compare four work-style preference pairs when you want a type-style hypothesis instead of six interest scores.',
  },
  {
    href: '/services/assessments/big-5-personality-test-careers/',
    title: 'Big 5 Personality Test for Careers',
    description: 'Use five continuous personality traits and 20 facets when you want a behaviour-based profile instead of an interest profile.',
  },
  {
    href: '/services/assessments/disc-personality-test-careers/',
    title: 'DISC Personality Test for Careers',
    description: 'Use four workplace behaviour styles and a style blend when you want communication and team-fit insight alongside your interest profile.',
  },
  {
    href: '/services/assessments/emotional-intelligence-test-careers/',
    title: 'Emotional Intelligence Test for Careers',
    description: 'Use five emotional-skill scores and a composite EQ score when self-awareness, regulation, empathy, and social skills matter alongside your interest profile.',
  },
  {
    href: '/services/assessments/class-11-to-12/',
    title: 'Class 11 and 12 Career Assessment',
    description: 'Use the broader student assessment when interests, aptitude, and stream or degree direction all need to be covered together.',
  },
  {
    href: '/services/assessments/',
    title: 'All Free Career Assessments',
    description: 'Compare every free assessment for school students, college students, job seekers, and working professionals.',
  },
];

const faqs = [
  {
    q: 'What is RIASEC and the Holland Code?',
    a: 'RIASEC stands for six interest types identified by psychologist John Holland: Realistic, Investigative, Artistic, Social, Enterprising, and Conventional. Your three strongest types, in order, form your three-letter Holland Code, such as IAS or ECS.',
  },
  {
    q: 'Is this an official Holland Code or Self-Directed Search test?',
    a: 'No. This is an independent, original 36-item interest assessment from Future Career School inspired by RIASEC theory. It is not the official Self-Directed Search (SDS) instrument and is not affiliated with or endorsed by its publisher.',
  },
  {
    q: 'How is my three-letter code calculated?',
    a: 'You rate 36 activities across the six RIASEC types (six activities per type). Each type gets a 0-100 score from your ratings, and your three highest-scoring types, ranked in order, become your Holland Code.',
  },
  {
    q: 'Can my Holland Code tell me exactly which job to take?',
    a: 'No. It highlights the kinds of activities and environments you tend to enjoy and points to real career families to investigate. Career decisions still need demonstrated skill, market evidence, constraints, and real experiments, not an interest code alone.',
  },
  {
    q: 'What does it mean if my top scores are close together?',
    a: 'A flat or undifferentiated profile means your interests are fairly even across several types. This is common and simply means you should sample a wider range of activities before narrowing down, rather than forcing a single clear-cut code.',
  },
  {
    q: 'Can I download the result?',
    a: 'Yes. The PDF includes all six type scores, your three-letter Holland Code, consistency and differentiation indicators, matched career families, skill-building suggestions, and all 36 responses.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://futurecareerschool.com/services' },
      { '@type': 'ListItem', position: 3, name: 'Assessments', item: 'https://futurecareerschool.com/services/assessments' },
      { '@type': 'ListItem', position: 4, name: 'RIASEC Holland Code Career Test', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free RIASEC Holland Code Career Test',
    alternateName: 'RIASEC Career Test',
    description: 'A free original 36-item RIASEC interest assessment that scores all six Holland types, generates a three-letter Holland Code, matches real career families, and produces a downloadable report.',
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="RIASEC Holland Code Career Test | Free RIASEC Career Test"
  description="Take a free RIASEC Holland Code career test. Get all six interest scores, your three-letter Holland Code, matched career families, and a detailed PDF report."
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <Nav activePage="services" />
  <main>
    <section id="hero" class="riasec-hero">
      <div class="riasec-grid-bg" aria-hidden="true"></div>
      <div class="riasec-orb riasec-orb--amber" aria-hidden="true"></div>
      <div class="riasec-orb riasec-orb--violet" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services">Services</a><span aria-hidden="true">&rsaquo;</span>
          <a href="/services/assessments">Assessments</a><span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">RIASEC Holland Code Career Test</span>
        </nav>
        <div class="eyebrow"><span></span> Six interest types, one Holland Code</div>
        <h1>RIASEC Holland Code <span>Career Test</span></h1>
        <p class="hero-sub">Rate 36 real activities across six interest types and get your three-letter Holland Code, matched career families, and high-potential directions to investigate, not a single job title verdict.</p>
        <div class="hero-stats" aria-label="Assessment details">
          <div><strong>36</strong><span>original activities</span></div>
          <div><strong>6</strong><span>RIASEC interest types</span></div>
          <div><strong>Free</strong><span>detailed PDF</span></div>
        </div>
        <div class="hero-actions">
          <a href="#assessment" class="btn-gold pulse">Start the Test</a>
          <a href={plansConfig.jumpHref} class="btn-outline">{plansConfig.jumpLabel}</a>
        </div>
        <p class="independent-note">Independent educational assessment inspired by Holland's RIASEC theory. Not the official Self-Directed Search (SDS) instrument. No affiliation or endorsement is claimed.</p>
      </div>
    </section>

    <div class="assessment-first-flow">
    <section class="type-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Six interest types on a hexagon</span><h2>Every type points to real, different career families</h2><p>Adjacent types on the hexagon tend to combine naturally. Opposite types can still both matter, but usually pull toward different kinds of work.</p></div>
        <div class="type-grid">
          <article class="type-card type-card--r"><b>R</b><h3>Realistic</h3><p>Hands-on, tools, machines, physical or outdoor work.</p></article>
          <article class="type-card type-card--i"><b>I</b><h3>Investigative</h3><p>Analysis, research, data, science, and problem solving.</p></article>
          <article class="type-card type-card--a"><b>A</b><h3>Artistic</h3><p>Original creation, design, and open-ended expression.</p></article>
          <article class="type-card type-card--s"><b>S</b><h3>Social</h3><p>Teaching, guiding, counselling, and helping people.</p></article>
          <article class="type-card type-card--e"><b>E</b><h3>Enterprising</h3><p>Leading, persuading, selling, and building ventures.</p></article>
          <article class="type-card type-card--c"><b>C</b><h3>Conventional</h3><p>Structure, accuracy, systems, and organised process.</p></article>
        </div>
      </div>
    </section>

    <section id="assessment" class="assessment-section">
      <div class="container">
        <div class="section-heading"><span class="section-kicker">Rate each activity honestly</span><h2>How much would you enjoy each activity?</h2><p>Answer based on activities themselves, not your current skill level or what you think pays well. You can be a beginner and still enjoy an activity.</p></div>
        <div id="start-shell" class="start-shell">
          <div class="audience-grid" role="radiogroup" aria-label="Choose your current stage">
            <button type="button" class="audience-option" data-audience="school" role="radio" aria-checked="false"><strong>School student</strong><span>Explore interests broadly before stream or subject choices narrow your options.</span></button>
            <button type="button" class="audience-option" data-audience="college" role="radio" aria-checked="false"><strong>College student</strong><span>Connect interest type with majors, projects, internships, and electives.</span></button>
            <button type="button" class="audience-option" data-audience="job" role="radio" aria-checked="false"><strong>Job seeker</strong><span>Target roles and industries that match your strongest interest combination.</span></button>
            <button type="button" class="audience-option" data-audience="professional" role="radio" aria-checked="false"><strong>Working professional</strong><span>Check whether a transition should change your field, your role, or both.</span></button>
          </div>
          <button id="start-button" type="button" class="quiz-button quiz-button--primary" disabled>Choose Your Stage</button>
          <p>There are no right answers. Rate each activity on how much you would enjoy doing it.</p>
        </div>

        <div id="quiz-shell" class="quiz-shell" hidden>
          <div class="quiz-topline"><span id="type-label" class="type-label">Career interest activities</span><span id="question-counter">Activity 1 of 36</span></div>
          <div class="progress-track" role="progressbar" aria-label="Assessment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="3" aria-valuetext="Activity 1 of 36"><span id="progress-fill"></span></div>
          <p id="question-prompt" class="question-prompt" tabindex="-1">Repairing or assembling a machine, engine, or piece of equipment.</p>
          <div id="scale-options" class="scale-options" role="radiogroup" aria-label="Choose how much you would enjoy this activity">
            <button type="button" data-value="1"><strong>1</strong><span>Strongly dislike</span></button>
            <button type="button" data-value="2"><strong>2</strong><span>Dislike</span></button>
            <button type="button" data-value="3"><strong>3</strong><span>Neutral</span></button>
            <button type="button" data-value="4"><strong>4</strong><span>Enjoy</span></button>
            <button type="button" data-value="5"><strong>5</strong><span>Strongly enjoy</span></button>
          </div>
          <div class="quiz-nav"><button id="back-button" type="button" class="quiz-button quiz-button--secondary" disabled>Back</button><button id="next-button" type="button" class="quiz-button quiz-button--primary" disabled>Next</button></div>
        </div>

        <div id="result-shell" class="result-shell" data-guidance-href={plansConfig.jumpHref} data-guidance-label={plansConfig.jumpLabel} hidden aria-live="polite" tabindex="-1" role="region" aria-label="RIASEC Holland Code results"></div>
        <p class="assessment-note">This independent test is educational, not diagnostic. It is not the official Self-Directed Search instrument, does not fix a permanent type, and cannot choose a career by itself.</p>
      </div>
    </section>
    </div>

    <section class="method-section">
      <div class="container method-layout">
        <div><span class="section-kicker">Use the code as a starting map</span><h2>Turn interest scores into a real decision</h2></div>
        <div class="method-grid">
          <article><strong>1</strong><h3>Notice</h3><p>See which interest types are strongest, close together, or clearly lower.</p></article>
          <article><strong>2</strong><h3>Map</h3><p>Match your top types to real career families, not a single job title.</p></article>
          <article><strong>3</strong><h3>Sample</h3><p>Try one small real task from your top career families before committing.</p></article>
          <article><strong>4</strong><h3>Verify</h3><p>Check current demand, entry routes, and pay ranges instead of assuming.</p></article>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section"><div class="container"><div class="section-heading"><span class="section-kicker">Common questions</span><h2>Before you use your Holland Code</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></section>
    <LinkDirectorySection sectionId="related-assessments" title="Related Free Assessments" subtitle="Use a wider assessment when aptitude, personality, or student-stage direction also need to be covered alongside interests." items={relatedLinks} altBackground={true} />
    <AssessmentGuidanceCta mode="mixed" sectionId="guidance-bridge" />
    <GuidancePlansSection sectionId="plans" audience={plansConfig.audience} serviceLabel={plansConfig.serviceLabel} title={plansConfig.sectionTitle} />
  </main>

  <AssessmentReportTools
    title="RIASEC Holland Code Report"
    fileName="future-career-school-riasec-holland-code-report.pdf"
    containerId="result-shell"
    downloadButtonId="download-button"
    reportKicker="RIASEC HOLLAND CODE CAREER INTEREST REPORT"
    guidanceLabel="Explore Personalised Career Guidance"
    guidanceUrl="https://futurecareerschool.com/services/career-counselling-and-career-guidance/career-guidance/"
  />

  <Footer />
</BaseLayout>

<style is:global>
  .riasec-hero{position:relative;overflow:hidden;padding:132px 0 78px;background:linear-gradient(165deg,#0c0a1a 0%,#151022 60%,#1b1330 100%)}.riasec-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:47px 47px;mask-image:linear-gradient(to bottom,#000,transparent 86%)}.riasec-orb{position:absolute;width:440px;height:440px;border-radius:50%;filter:blur(118px);opacity:.18}.riasec-orb--amber{left:-180px;top:-60px;background:#f59e0b}.riasec-orb--violet{right:-170px;bottom:-95px;background:#8b5cf6}.hero-inner{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:1.6rem;color:rgba(255,255,255,.46);font-size:13px}.eyebrow,.section-kicker{color:#c4b5fd;font-size:12px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;border:1px solid rgba(196,181,253,.28);border-radius:999px;background:rgba(196,181,253,.08)}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#c4b5fd;box-shadow:0 0 0 5px rgba(196,181,253,.1)}.riasec-hero h1{max-width:980px;margin:1.2rem 0 .9rem;color:#fff;font-size:clamp(2.35rem,6.2vw,4.85rem);line-height:.97;letter-spacing:-.058em;text-wrap:balance}.riasec-hero h1 span{display:block;background:linear-gradient(90deg,#f59e0b,#f43f5e,#8b5cf6);background-clip:text;color:transparent}.hero-sub{max-width:800px;margin:0;color:rgba(255,255,255,.68);font-size:clamp(15px,1.8vw,18px);line-height:1.72}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);width:min(620px,100%);margin:2rem 0;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.035);overflow:hidden}.hero-stats div{display:grid;gap:.15rem;padding:1rem}.hero-stats div+div{border-left:1px solid rgba(255,255,255,.09)}.hero-stats strong{color:#fff;font-size:1.2rem}.hero-stats span{color:rgba(255,255,255,.48);font-size:12px}.hero-actions,.result-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.8rem}.independent-note{margin:1rem 0 0;color:rgba(255,255,255,.42);font-size:11px}.type-section,.assessment-section,.faq-section,.method-section{padding:82px 0}.type-section,.faq-section{background:#f5f1e8;color:#17202c}.section-heading{max-width:790px;margin:0 auto 2.2rem;text-align:center}.section-heading h2,.method-layout h2{margin:.55rem 0 .7rem;color:inherit;font-size:clamp(2rem,4vw,3.15rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.section-heading p{color:#68717d;line-height:1.7}.type-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:.7rem}.type-card{position:relative;overflow:hidden;padding:1.1rem;border:1px solid #ddd7cb;border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 14px 32px rgba(23,32,44,.055)}.type-card:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--riasec)}.type-card b{display:grid;width:40px;height:40px;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--riasec) 15%,white);color:var(--riasec);font-size:1.15rem}.type-card h3{margin:.9rem 0 .4rem;font-size:.98rem}.type-card p,.method-grid p{margin:0;color:#68717d;font-size:12.5px;line-height:1.55}.type-card--r{--riasec:#0ea5e9}.type-card--i{--riasec:#8b5cf6}.type-card--a{--riasec:#f43f5e}.type-card--s{--riasec:#10b981}.type-card--e{--riasec:#f59e0b}.type-card--c{--riasec:#64748b}.assessment-section{background:#0b0918}.assessment-section .section-heading{color:#fff}.assessment-section .section-heading p{color:rgba(255,255,255,.58)}.start-shell,.quiz-shell,.result-shell{max-width:1080px;margin:0 auto;padding:clamp(1.15rem,3vw,2rem);border:1px solid rgba(255,255,255,.1);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 70px rgba(0,0,0,.25)}.audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-bottom:1rem}.audience-option{display:grid;gap:.35rem;width:100%;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-align:left;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.audience-option span{color:rgba(255,255,255,.55);font-size:13px;line-height:1.45}.audience-option:hover,.audience-option.is-selected{border-color:rgba(251,191,36,.72);background:rgba(251,191,36,.09);box-shadow:0 12px 28px rgba(251,191,36,.14)}.start-shell>p,.assessment-note{margin:.8rem 0 0;color:rgba(255,255,255,.43);text-align:center;font-size:12px}.quiz-button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:.75rem 1.15rem;border:1px solid transparent;border-radius:12px;font-weight:800;cursor:pointer}.quiz-button--primary{background:var(--gold);color:#111827}.quiz-button--secondary{border-color:rgba(255,255,255,.15);background:transparent;color:#fff}.quiz-button:disabled{cursor:not-allowed;opacity:.38}#start-button{width:100%}.quiz-topline,.quiz-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.48);font-size:12px}.type-label{color:#c4b5fd;font-weight:800}.progress-track{height:5px;margin:.8rem 0 2rem;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.progress-track span{display:block;width:2.7%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#0ea5e9,#8b5cf6,#f43f5e,#10b981,#f59e0b,#64748b);transition:width .25s}.question-prompt{max-width:820px;min-height:92px;margin:0 auto 1.5rem;color:#fff;text-align:center;font-size:clamp(1.25rem,3vw,1.9rem);font-weight:780;line-height:1.45;display:grid;place-items:center}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem;margin:1rem 0 1.5rem}.scale-options button{display:grid;gap:.3rem;min-height:90px;place-content:center;padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.025);color:#fff;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}.scale-options button strong{color:var(--gold);font-size:1.2rem}.scale-options button span{color:rgba(255,255,255,.5);font-size:10px;line-height:1.25}.scale-options button:hover,.scale-options button.is-selected{border-color:rgba(251,191,36,.76);background:rgba(251,191,36,.1);box-shadow:0 12px 24px rgba(251,191,36,.14)}.quiz-nav{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}.result-shell{color:rgba(255,255,255,.7)}.result-head{display:grid;grid-template-columns:190px 1fr;align-items:center;gap:1.5rem}.code-mark{display:grid;width:180px;height:180px;place-content:center;border:1px solid rgba(196,181,253,.3);border-radius:32px;background:radial-gradient(circle at top,rgba(196,181,253,.16),transparent 62%),#150f24;text-align:center}.code-mark strong{color:#fff;font-size:2.35rem;letter-spacing:.07em}.code-mark span,.result-kicker{margin-top:.5rem;color:#c4b5fd;font-size:11px}.result-head h3{margin:.35rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem);line-height:1.08}.result-head p,.result-section p{line-height:1.65}.result-metrics,.insight-grid,.indicator-grid,.career-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.result-metrics{grid-template-columns:repeat(4,1fr);margin:1.5rem 0}.result-metric,.insight-grid article,.indicator-card,.career-card{padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.035)}.result-metric{display:grid;gap:.35rem}.result-metric strong{color:#fff}.result-metric span{color:rgba(255,255,255,.43);font-size:11px}.type-results{display:grid;gap:.8rem;margin-top:1rem}.type-result{--riasec:#c4b5fd;padding:1.1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.035)}.type-result-head{display:flex;align-items:start;justify-content:space-between;gap:1rem}.type-result h5{marg