<script>
  // @ts-nocheck
  var HEX_ORDER=['R','I','A','S','E','C'];
  var TYPES={
    R:{name:'Realistic',label:'The Builder',color:'#0ea5e9',summary:'You may enjoy working with tools, machines, physical systems, or the outdoors, and prefer visible, tangible results over long abstract discussion.',environment:'Look for roles with real equipment, physical or technical systems, and concrete outcomes rather than open-ended meetings.',careers:['Engineering and technical trades (mechanical, electrical, civil, automotive)','Skilled crafts, manufacturing, and field service roles','Agriculture, environmental, and outdoor-resource work','Sports, fitness, and physical-performance roles','Defence, aviation, and technical operations'],highPay:'Engineering-adjacent and technical-operations roles that combine hands-on skill with certifications or specialised equipment knowledge tend to command stronger pay than purely manual roles.',skills:['Technical or trade certification relevant to the equipment or systems you enjoy','Basic troubleshooting and maintenance documentation','Safety and quality-standard familiarity for your chosen field']},
    I:{name:'Investigative',label:'The Analyst',color:'#8b5cf6',summary:'You may enjoy researching, analysing data, testing ideas, and solving complex or ambiguous problems before acting.',environment:'Look for roles with real problems to investigate, access to data or evidence, and room for independent analysis.',careers:['Data science, analytics, and applied research','Software engineering and computer science','Medicine, biotechnology, and life sciences','Actuarial science, finance analytics, and quantitative research','Scientific and engineering research and development'],highPay:'Roles that pair investigative strength with in-demand technical skills such as programming, data analysis, or specialised scientific training are consistently among the better-paying options in the current job market, though actual pay still depends on skill depth, employer, and location.',skills:['A programming or data-analysis language relevant to your field','Structured research or experimental method','Ability to communicate technical findings to non-specialists']},
    A:{name:'Artistic',label:'The Creator',color:'#f43f5e',summary:'You may enjoy original expression, design, storytelling, or building things that did not exist before, and prefer flexible, less rule-bound work.',environment:'Look for roles with creative latitude, original output, and fewer rigid step-by-step procedures.',careers:['Design (UI or UX, graphic, product, or fashion)','Content, writing, film, and media production','Architecture and the built environment','Music, performing arts, and creative direction','Marketing and brand creative roles'],highPay:'Roles that pair creative skill with a measurable business outcome, such as product design, UX, or brand and marketing creative work, tend to be paid more consistently than purely expressive creative work, especially with a strong portfolio.',skills:['A portfolio of original, finished creative work','One relevant creative or design tool at a professional level','Ability to take structured feedback without losing originality']},
    S:{name:'Social',label:'The Helper',color:'#10b981',summary:'You may enjoy teaching, guiding, counselling, or working directly with people to support their growth, wellbeing, or understanding.',environment:'Look for roles with real interaction, visible impact on people, and cooperative rather than purely competitive settings.',careers:['Teaching, training, and education leadership','Counselling, psychology, and human resources','Healthcare and allied health services','Social work, public service, and community development','Customer success and people-facing service roles'],highPay:'Healthcare leadership, organisational HR or learning-and-development, and specialised counselling or therapy practice tend to offer stronger long-term compensation than entry-level service roles, particularly with additional certification or clinical training.',skills:['A recognised teaching, counselling, or facilitation certification where relevant','Active listening and conflict-resolution practice','Ability to track and communicate real outcomes for the people you support']},
    E:{name:'Enterprising',label:'The Persuader',color:'#f59e0b',summary:'You may enjoy leading, persuading, negotiating, and taking calculated risks to achieve a goal or build something commercially.',environment:'Look for roles with ownership, measurable targets, and room to influence decisions or outcomes.',careers:['Sales, business development, and account management','Entrepreneurship and startup founding','Management, consulting, and strategy roles','Marketing leadership and growth roles','Law, policy, and public leadership'],highPay:'This group includes some of the highest-ceiling career paths overall, since sales, consulting, management, and entrepreneurship compensation typically scales with results, ownership, and negotiated deals rather than a fixed pay band, though it also carries more income variability than salaried roles.',skills:['A track record of a real result you drove, with numbers attached','Negotiation and persuasive communication practice','Basic commercial or financial literacy for your sector']},
    C:{name:'Conventional',label:'The Organiser',color:'#64748b',summary:'You may enjoy structured, detail-accurate work such as organising data, following established procedures, and maintaining accuracy and order.',environment:'Look for roles with clear processes, defined responsibilities, and measurable accuracy or compliance standards.',careers:['Accounting, finance, and audit','Operations, supply chain, and logistics','Data administration, compliance, and quality control','Banking and financial operations','Project coordination and business administration'],highPay:'Chartered accountancy, financial analysis, and compliance or audit roles that require a formal qualification tend to pay meaningfully more than general administrative or data-entry roles.',skills:['A recognised qualification relevant to accounting, operations, or compliance','Advanced spreadsheet or systems-of-record proficiency','Process documentation and error-checking discipline']}
  };
  var AUDIENCE={
    school:{label:'School student',title:'Use your code to explore before narrowing',body:'Your interest profile can guide which subjects, clubs, and projects to try next. It should widen your exploration before Class 11 or 12 choices, not lock in a single career this early.',actions:['Try one real activity from each of your top two types before choosing a stream.','Ask a teacher or senior what a normal day looks like in a career family that interests you.','Keep a short list of activities that consistently feel engaging across different settings.'],caution:'Interests can shift quickly with exposure and development at this stage. Treat this code as a starting map, not a final answer.'},
    college:{label:'College student',title:'Turn your code into stronger project and internship choices',body:'Use your top types to choose electives, projects, and internships that test real career families before you commit years of study or a first job to one direction.',actions:['Choose one project or internship that matches your top type and one that tests your second type.','Ask internship teams what daily tasks actually look like versus the job title.','Build one visible output (a portfolio piece, dataset, or case study) tied to your top career family.'],caution:'An interest match is not the same as employable skill. Build real proof of capability in your top career families.'},
    job:{label:'Job seeker',title:'Target roles that match your strongest combination',body:'Use your top two or three types to filter job searches toward roles and industries that are more likely to hold your interest long enough to build real expertise.',actions:['Search roles using your top career families as keywords, not only generic job titles.','Ask interviewers what proportion of the role matches each of your top interest types.','Prepare examples that show real experience in your top career family, even if unpaid or self-directed.'],caution:'A title can look like a strong match on paper but differ completely in daily reality. Verify with people already doing the job.'},
    professional:{label:'Working professional',title:'Decide whether to change your field, your role, or both',body:'Use your code to separate a mismatch with your current tasks from a mismatch with your entire field, before making a costly full career change.',actions:['Compare your current daily tasks against your top two interest types to locate the real mismatch.','Test a transition through a side project, certification, or internal role move before resigning.','Translate transferable skills into your new target career family instead of starting from zero.'],caution:'A career change driven only by short-term frustration can repeat the same mismatch in a new field. Verify the target career family with real tasks first.'}
  };
  var QUESTIONS=[
    {type:'R',text:'Repairing or assembling a machine, engine, or piece of equipment.'},
    {type:'I',text:'Analysing data to find a pattern or answer a research question.'},
    {type:'A',text:'Designing something original, such as a visual, product, or space.'},
    {type:'S',text:'Teaching or explaining a concept to someone until they understand it.'},
    {type:'E',text:'Persuading someone to support an idea, product, or plan.'},
    {type:'C',text:'Organising records, files, or data with careful accuracy.'},
    {type:'R',text:'Building or fixing something with your hands using tools.'},
    {type:'I',text:'Investigating why something is not working before fixing it.'},
    {type:'A',text:'Writing a story, script, or piece of original content.'},
    {type:'S',text:'Listening to a person\'s problem and helping them find a way forward.'},
    {type:'E',text:'Leading a team or project toward a specific measurable goal.'},
    {type:'C',text:'Following a clear, established procedure step by step.'},
    {type:'R',text:'Working outdoors with plants, animals, or natural materials.'},
    {type:'I',text:'Reading deeply about a scientific or technical topic out of curiosity.'},
    {type:'A',text:'Performing, composing, or creating music or visual art.'},
    {type:'S',text:'Organising a group activity where people work well together.'},
    {type:'E',text:'Negotiating a deal, price, or agreement with another party.'},
    {type:'C',text:'Checking numbers or details closely to catch errors.'},
    {type:'R',text:'Operating or maintaining technical equipment or vehicles.'},
    {type:'I',text:'Designing an experiment or test to check whether an idea is true.'},
    {type:'A',text:'Coming up with an unconventional idea instead of following a template.'},
    {type:'S',text:'Mentoring, coaching, or guiding someone\'s development over time.'},
    {type:'E',text:'Starting or pitching a new business, product, or initiative.'},
    {type:'C',text:'Maintaining a system so information stays accurate and current.'},
    {type:'R',text:'Following blueprints or diagrams to construct something physical.'},
    {type:'I',text:'Solving a complex logical or mathematical puzzle.'},
    {type:'A',text:'Working in a role with few fixed rules about how the output should look.'},
    {type:'S',text:'Working directly with people rather than mostly with data or machines.'},
    {type:'E',text:'Taking a calculated risk to pursue a bigger opportunity.'},
    {type:'C',text:'Managing a schedule, budget, or set of ongoing tasks.'},
    {type:'R',text:'Doing physically active work rather than sitting at a desk all day.'},
    {type:'I',text:'Working independently on a problem that has no obvious answer yet.'},
    {type:'A',text:'Expressing an idea visually, verbally, or through a creative medium.'},
    {type:'S',text:'Resolving a disagreement between two people fairly.'},
    {type:'E',text:'Competing to win a target, deal, or measurable result.'},
    {type:'C',text:'Working with clearly defined rules rather than open-ended ambiguity.'}
  ];

  var startShell=document.getElementById('start-shell'),quizShell=document.getElementById('quiz-shell'),resultShell=document.getElementById('result-shell'),startButton=document.getElementById('start-button'),nextButton=document.getElementById('next-button'),backButton=document.getElementById('back-button'),questionPrompt=document.getElementById('question-prompt'),questionCounter=document.getElementById('question-counter'),progressFill=document.getElementById('progress-fill'),typeLabel=document.getElementById('type-label');
  var progressTrack=progressFill.parentElement;
  var TOTAL=QUESTIONS.length;
  var audience=null,currentQuestion=0,answers=new Array(TOTAL).fill(null),changes=new Array(TOTAL).fill(0),times=new Array(TOTAL).fill(0),enteredAt=0,latestReport=null,guidanceHref=resultShell.dataset.guidanceHref||'#plans',guidanceLabel=resultShell.dataset.guidanceLabel||'See Career Guidance Pricing';
  document.documentElement.style.overflowAnchor='none';
  function escapeHtml(value){return String(value).replace(/[&<>'"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c];});}
  function revealPanel(panel,focusTarget){function positionPanel(){var top=panel.getBoundingClientRect().top+window.scrollY-84;window.scrollTo({top:Math.max(0,top),behavior:'instant'});}(focusTarget||panel).focus({preventScroll:true});positionPanel();requestAnimationFrame(function(){requestAnimationFrame(positionPanel);});window.setTimeout(positionPanel,80);window.setTimeout(positionPanel,320);}
  function average(values){return values.length?values.reduce(function(a,b){return a+b;},0)/values.length:0;}
  function round(value){return Math.round(value);}
  function formatDuration(seconds){return Math.floor(seconds/60)+'m '+String(seconds%60).padStart(2,'0')+'s';}
  function recordTime(){if(!enteredAt)return;times[currentQuestion]+=Math.max(.2,(Date.now()-enteredAt)/1000);enteredAt=Date.now();}
  function renderQuestion(){var q=QUESTIONS[currentQuestion],progress=Math.round((currentQuestion+1)/TOTAL*100);typeLabel.textContent='Career interest activities';questionCounter.textContent='Activity '+(currentQuestion+1)+' of '+TOTAL;progressFill.style.width=progress+'%';progressTrack.setAttribute('aria-valuenow',String(progress));progressTrack.setAttribute('aria-valuetext','Activity '+(currentQuestion+1)+' of '+TOTAL);questionPrompt.textContent=q.text;document.querySelectorAll('#scale-options button').forEach(function(button){var selected=answers[currentQuestion]===Number(button.dataset.value);button.classList.toggle('is-selected',selected);button.setAttribute('aria-checked',selected?'true':'false');});backButton.disabled=currentQuestion===0;nextButton.disabled=answers[currentQuestion]===null;nextButton.textContent=currentQuestion===TOTAL-1?'See My Holland Code':'Next';}
  document.querySelectorAll('.audience-option').forEach(function(button){button.addEventListener('click',function(){audience=button.dataset.audience;document.querySelectorAll('.audience-option').forEach(function(item){var selected=item===button;item.classList.toggle('is-selected',selected);item.setAttribute('aria-checked',selected?'true':'false');});startButton.disabled=false;startButton.textContent='Start 36-Activity Test';});});
  startButton.addEventListener('click',function(){if(!audience)return;startShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);});
  document.querySelectorAll('#scale-options button').forEach(function(button){button.addEventListener('click',function(){var value=Number(button.dataset.value);if(answers[currentQuestion]!==null&&answers[currentQuestion]!==value)changes[currentQuestion]+=1;answers[currentQuestion]=value;renderQuestion();});});
  backButton.addEventListener('click',function(){if(currentQuestion===0)return;recordTime();currentQuestion-=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});});
  nextButton.addEventListener('click',function(){if(answers[currentQuestion]===null)return;recordTime();if(currentQuestion<TOTAL-1){currentQuestion+=1;enteredAt=Date.now();renderQuestion();questionPrompt.focus({preventScroll:true});}else showResults();});

  function scoreAnswer(value){return(value-1)*25;}
  function hexDistance(a,b){var ia=HEX_ORDER.indexOf(a),ib=HEX_ORDER.indexOf(b),d=Math.abs(ia-ib);return Math.min(d,6-d);}
  function longestRun(values){var longest=0,current=0,last=null;values.forEach(function(value){if(value===last)current+=1;else{last=value;current=1;}longest=Math.max(longest,current);});return longest;}
  function buildReport(){
    var typeResults=HEX_ORDER.map(function(type){
      var items=QUESTIONS.map(function(q,index){return{q:q,index:index};}).filter(function(item){return item.q.type===type;});
      var scored=items.map(function(item){return scoreAnswer(answers[item.index]);});
      var score=round(average(scored));
      var avgTime=round(items.reduce(function(sum,item){return sum+times[item.index];},0)/items.length);
      return{type:type,name:TYPES[type].name,label:TYPES[type].label,color:TYPES[type].color,score:score,averageTime:avgTime};
    });
    var ranked=typeResults.slice().sort(function(a,b){return b.score-a.score||HEX_ORDER.indexOf(a.type)-HEX_ORDER.indexOf(b.type);});
    var top3=ranked.slice(0,3),code=top3.map(function(item){return item.type;}).join('');
    var dist12=hexDistance(top3[0].type,top3[1].type),dist13=hexDistance(top3[0].type,top3[2].type);
    var consistencyScore=round(((3-dist12)+(3-dist13))/6*100);
    var consistencyLabel=consistencyScore>=75?'Highly consistent code - your top interests naturally reinforce each other.':consistencyScore>=45?'Moderately consistent code - your top interests combine reasonably well.':'Differentiated code - your top interests pull toward fairly different kinds of work, so investigate both sides deliberately.';
    var spread=ranked[0].score-ranked[5].score;
    var differentiationLabel=spread>=45?'Clear, well-differentiated interests - your top types stand out strongly from the rest.':spread>=22?'Moderately differentiated interests - your top types are somewhat ahead of the others.':'Fairly flat profile - your interest scores are close across several types, so sample broadly before narrowing.';
    var neutralCount=answers.filter(function(value){return value===3;}).length,extremeCount=answers.filter(function(value){return value===1||value===5;}).length,changedCount=changes.filter(function(value){return value>0;}).length,run=longestRun(answers),elapsed=Math.max(1,round(times.reduce(function(a,b){return a+b;},0)));
    var responseSummary=neutralCount>=14?'You used the neutral rating often. That may reflect genuine range or uncertainty; use real trial activities before drawing a strong conclusion.':extremeCount>=22?'You used many strong ratings. Check whether they reflect a repeated real pattern rather than how you feel about the topic right now.':run>=10?'A long sequence used the same rating. This may be genuine, but review whether attention or a response habit influenced the pattern.':'The response pattern includes a workable mix of enjoyment, dislike, and neutral ratings, though it still needs validation against real activities.';
    var primary=TYPES[top3[0].type],secondary=TYPES[top3[1].type],tertiary=TYPES[top3[2].type];
    var profileTitle=primary.name+' primary, '+secondary.name+' secondary';
    var profileSummary='Your strongest interest type is '+primary.name+' ('+primary.label+') at '+ranked[0].score+'%, followed by '+secondary.name+' at '+ranked[1].score+'% and '+tertiary.name+' at '+ranked[2].score+'%. Together these form your Holland Code, '+code+'.';
    function mergeUnique(a,b){var seen={},out=[];a.concat(b).forEach(function(item){if(!seen[item]){seen[item]=true;out.push(item);}});return out;}
    var strongFitCareers=primary.careers.filter(function(career){return secondary.careers.indexOf(career)!==-1;});
    var exploreCareers=mergeUnique(primary.careers,secondary.careers).filter(function(career){return strongFitCareers.indexOf(career)===-1;});
    var experiments=[
      'Spend two hours this week on a real, small task from '+primary.name.toLowerCase()+' work: '+primary.environment.toLowerCase(),
      'Spend two hours on a real, small task from '+secondary.name.toLowerCase()+' work: '+secondary.environment.toLowerCase(),
      'Ask one person already working in your top career family what a normal week actually looks like.',
      'Compare your energy, output quality, and interest level across both experiments before choosing a direction.'
    ];
    var skillPlan=mergeUnique(primary.skills,secondary.skills).slice(0,5);
    var highPayNotes=[primary.name+': '+primary.highPay,secondary.name+': '+secondary.highPay];
    var responses=QUESTIONS.map(function(q,index){return{number:index+1,question:q,value:answers[index],score:scoreAnswer(answers[index]),time:round(times[index]),changed:changes[index]};});
    var audienceData=AUDIENCE[audience];
    return{typeResults:ranked,top3:top3,code:code,primary:primary,secondary:secondary,tertiary:tertiary,consistencyScore:consistencyScore,consistencyLabel:consistencyLabel,differentiationLabel:differentiationLabel,spread:spread,profileTitle:profileTitle,profileSummary:profileSummary,strongFitCareers:strongFitCareers.length?strongFitCareers:mergeUnique(primary.careers,secondary.careers).slice(0,3),exploreCareers:exploreCareers,experiments:experiments,skillPlan:skillPlan,highPayNotes:highPayNotes,responses:responses,neutralCount:neutralCount,extremeCount:extremeCount,changedCount:changedCount,longestRun:run,elapsed:elapsed,responseSummary:responseSummary,audience:audienceData,
      validationPlan:['Week 1 - Try one real, small task from each of your top two types and record what you notice about energy and focus.','Week 2 - Ask two people already working in your top career family about daily tasks, pressure, and entry routes.','Week 3 - Build one small visible output (a project, sample, or write-up) tied to your top career family.','Week 4 - Compare evidence from all three weeks against your Holland Code before making a bigger commitment.'],
      decisionFilters:['Task evidence - have you tried representative work rather than relying on an interest code alone?','Capability evidence - can you demonstrate real skill, output quality, or a credible learning path?','Market evidence - have you checked current demand, entry routes, and realistic pay ranges?','Fit evidence - does the daily reality of the role match what you enjoyed in your trial activities?','Sustainability evidence - does the path fit your constraints, responsibilities, and long-term goals?'],
      retestPlan:['Wait at least four to six weeks so the same activities feel less familiar.','Retake after trying at least one real activity from your top types, not only from memory.','Compare all six type scores, not only the top three letters.','Investigate a change of 15 points or more by considering new exposure, skill growth, or a shift in context.']
    };
  }
  function listHtml(items){return'<ul class="signal-list">'+items.map(function(item){return'<li>'+escapeHtml(item)+'</li>';}).join('')+'</ul>';}
  function showResults(){
    latestReport=buildReport();var r=latestReport;
    var typeHtml=r.typeResults.map(function(item,index){return'<article class="type-result" style="--riasec:'+item.color+'"><div class="type-result-head"><div><h5>'+(index+1)+'. '+item.name+' ('+item.label+')</h5></div><strong>'+item.score+'%</strong></div><div class="type-track"><i style="width:'+item.score+'%"></i></div></article>';}).join('');
    var careerCards=function(items,tag){return items.map(function(item){return'<article class="career-card"><span>'+tag+'</span><b>'+escapeHtml(item)+'</b></article>';}).join('');};
    var responseHtml=r.responses.map(function(item){var label={1:'Strongly dislike',2:'Dislike',3:'Neutral',4:'Enjoy',5:'Strongly enjoy'}[item.value];return'<div class="response-row"><b>'+item.number+'</b><div><strong>'+escapeHtml(item.question.text)+'</strong><p>'+TYPES[item.question.type].name+'</p></div><span>'+label+' | '+item.time+' sec'+(item.changed?' | changed '+item.changed+'x':'')+'</span></div>';}).join('');
    resultShell.innerHTML='<div class="result-head"><div class="code-mark"><strong>'+r.code+'</strong><span>Holland Code</span></div><div><span class="result-kicker">'+r.audience.label+' result</span><h3>'+escapeHtml(r.profileTitle)+'</h3><p>'+escapeHtml(r.profileSummary)+'</p></div></div>'+
      '<div class="result-metrics"><div class="result-metric"><strong>'+r.consistencyScore+'%</strong><span>Code consistency</span></div><div class="result-metric"><strong>'+r.spread+' pts</strong><span>Interest differentiation spread</span></div><div class="result-metric"><strong>'+r.neutralCount+'/'+TOTAL+'</strong><span>Neutral ratings</span></div><div class="result-metric"><strong>'+formatDuration(r.elapsed)+'</strong><span>Active completion time</span></div></div>'+
      '<div class="result-section"><h4>Your six RIASEC interest scores</h4><p>Scores are based only on these 36 activities and are not population percentiles. Your top three, in order, form your Holland Code.</p><div class="type-results">'+typeHtml+'</div></div>'+
      '<div class="result-section"><h4>How much weight should this code carry?</h4><div class="insight-grid"><article><h5>Code consistency</h5><p>'+r.consistencyLabel+'</p></article><article><h5>Interest differentiation</h5><p>'+r.differentiationLabel+'</p></article><article><h5>Response pattern</h5><p>'+r.responseSummary+'</p></article><article><h5>Ratings reconsidered</h5><p>'+r.changedCount+' activities were re-rated. Reconsidering is fine; use real trial activities when two ratings both feel plausible.</p></article></div></div>'+
      '<div class="result-section"><h4>Career families that match your top two types</h4><p>Strongest-fit families appear in both your primary and secondary type. The rest are worth exploring but lean more toward one type.</p><div class="career-grid">'+careerCards(r.strongFitCareers,'Strongest fit')+careerCards(r.exploreCareers,'Worth exploring')+'</div></div>'+
      '<div class="result-section"><h4>Where higher pay tends to concentrate in your top types</h4><p>These are general, directional patterns from common industry knowledge, not guaranteed figures. Always verify current compensation against live job listings for your city and experience level.</p>'+listHtml(r.highPayNotes)+'</div>'+
      '<div class="result-section"><h4>Skills worth building next</h4>'+listHtml(r.skillPlan)+'</div>'+
      '<div class="result-section"><h4>Four practical experiments</h4>'+listHtml(r.experiments)+'</div>'+
      '<div class="result-section"><h4>'+escapeHtml(r.audience.title)+'</h4><p>'+escapeHtml(r.audience.body)+'</p><div class="insight-grid"><article><h5>Apply the result now</h5>'+listHtml(r.audience.actions)+'</article><article><h5>Important caution</h5><p>'+escapeHtml(r.audience.caution)+'</p></article></div></div>'+
      '<div class="result-section"><h4>A 30-day evidence plan</h4>'+listHtml(r.validationPlan)+'</div>'+
      '<div class="result-section"><h4>Five filters before a career decision</h4>'+listHtml(r.decisionFilters)+'</div>'+
      '<div class="result-section"><h4>How to retest meaningfully</h4>'+listHtml(r.retestPlan)+'</div>'+
      '<div class="result-section"><h4>What this result cannot tell you</h4><div class="insight-grid"><article><h5>Not a diagnosis</h5><p>It does not measure ability, intelligence, or guarantee success in any career family.</p></article><article><h5>Not a percentile</h5><p>The scores are based only on these 36 activities and are not comparisons with a national, student, or employer norm.</p></article><article><h5>Not a fixed identity</h5><p>Interests can change with exposure, skill growth, and life stage. Retest periodically.</p></article><article><h5>Not complete career clarity</h5><p>Fuller decisions still need demonstrated skill, market evidence, constraints, and real experiments.</p></article></div></div>'+
      '<div class="result-section"><h4>Complete response review</h4><details><summary>Open all '+TOTAL+' responses and timings</summary><div class="response-table">'+responseHtml+'</div></details></div>'+
      '<div class="result-actions"><button id="download-button" type="button" class="quiz-button quiz-button--primary">Download Detailed PDF</button><a href="'+guidanceHref+'" class="btn-gold">'+guidanceLabel+'</a><button id="retake-button" type="button" class="quiz-button quiz-button--secondary">Retake Test</button></div>';
    quizShell.hidden=true;resultShell.hidden=false;revealPanel(resultShell);document.getElementById('download-button').addEventListener('click',downloadVisualReport);document.getElementById('retake-button').addEventListener('click',retake);
  }
  function retake(){currentQuestion=0;answers=new Array(TOTAL).fill(null);changes=new Array(TOTAL).fill(0);times=new Array(TOTAL).fill(0);latestReport=null;resultShell.hidden=true;quizShell.hidden=false;enteredAt=Date.now();renderQuestion();revealPanel(quizShell,questionPrompt);}
  function downloadVisualReport(){if(!window.downloadAssessmentReportPdf)return;window.downloadAssessmentReportPdf({container:resultShell,title:'RIASEC Holland Code Report',fileName:'future-career-school-riasec-holland-code-report.pdf'});}
</script>
