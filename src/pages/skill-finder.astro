// ── META ────────────────────────────────────────────────────────────────────
const categoryMeta: Record<string, { label: string; color: string; short: string }> = {
  'software-dev': { label: 'Software Development & Architecture', color: '#60a5fa', short: 'Software Dev' },
  'ai-ml':        { label: 'AI & Machine Learning',              color: '#e5b84a', short: 'AI/ML' },
  'data-cloud':   { label: 'Data, Cloud & Infrastructure',       color: '#2dd4bf', short: 'Data/Cloud' },
  'cybersecurity':{ label: 'Cybersecurity',                       color: '#f87171', short: 'Security' },
  'design':       { label: 'Design, Product & Content',          color: '#f472b6', short: 'Design' },
  'marketing':    { label: 'Marketing & Growth',                 color: '#fb923c', short: 'Marketing' },
  'business':     { label: 'Business Acumen & Soft Skills',      color: '#34d399', short: 'Business' },
  // 'document-checking' — future expansion for Deep Document Checking
};

const skillTypeMeta: Record<string, { label: string; note: string }> = {
  'foundational': { label: 'Foundational',  note: 'Table-stakes everyone needs' },
  'high-value':   { label: 'High-Value',    note: 'Specialization differentiator' },
};

const workFocusMeta: Record<string, { label: string; color: string }> = {
  'technical':   { label: 'Technical',      color: '#60a5fa' },
  'data':        { label: 'Data & Analytics', color: '#2dd4bf' },
  'design':      { label: 'Design & Creative', color: '#f472b6' },
  'product':     { label: 'Product & Strategy', color: '#a78bfa' },
  'people':      { label: 'People & Communication', color: '#fb923c' },
  'sales':       { label: 'Sales & Revenue', color: '#fbbf24' },
  'marketing':   { label: 'Marketing & Growth', color: '#f87171' },
  'operations':  { label: 'Operations',     color: '#34d399' },
};

const difficultyMeta: Record<string, { label: string; color: string }> = {
  'easy':     { label: 'Easy to Start',   color: '#34d399' },
  'moderate': { label: 'Moderate',        color: '#e5b84a' },
  'steep':    { label: 'Steep Learning',  color: '#f87171' },
};

const thinkingMeta: Record<string, { label: string; note: string }> = {
  'systems': { label: 'Systems thinker',  note: 'Logic, patterns, structures' },
  'people':  { label: 'People thinker',   note: 'Empathy, story, persuasion' },
  'both':    { label: 'Balanced',         note: 'Comfortable in both worlds' },
};

const makingMeta: Record<string, { label: string }> = {
  'build':   { label: 'Making / building' },
  'analyse': { label: 'Analysing / interpreting' },
  'both':    { label: 'Making + analysing' },
};

const incomeLevelMeta: Record<string, { label: string; note: string; color: string }> = {
  'high':     { label: 'High',     note: '₹25L+ LPA long-term ceiling',        color: '#fbbf24' },
  'medium':   { label: 'Medium',   note: '₹12–25L LPA long-term ceiling',      color: '#e5b84a' },
  'moderate': { label: 'Moderate', note: '₹8–12L LPA long-term ceiling',       color: '#34d399' },
};

const timeMeta: Record<string, { label: string; order: number }> = {
  '<3m':   { label: 'Under 3 months', order: 1 },
  '3-6m':  { label: '3 – 6 months',   order: 2 },
  '6-12m': { label: '6 – 12 months',  order: 3 },
  '1-2y':  { label: '1 – 2 years', order: 4 },
};

const demandMeta: Record<string, { label: string; color: string }> = {
  'hot':    { label: 'Hot demand',    color: '#f87171' },
  'rising': { label: 'Rising demand', color: '#e5b84a' },
  'stable': { label: 'Stable demand', color: '#2dd4bf' },
};

function waLink(skill: string): string {
  return `https://wa.me/917815927259?text=${encodeURIComponent(`Hi, I'd like guidance on the ${skill} path`)}`;
}

const totalCount = skills.length;
const foundationalCount = skills.filter(s => s.skillType === 'foundational').length;
const highValueCount = skills.filter(s => s.skillType === 'high-value').length;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "Skill Finder", "item": "https://futurecareerschool.com/skill-finder" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Skill & Career Finder — Foundational + High-Value Skills for the Next Decade",
    "description": `A hand-picked library of ${totalCount} curated skills (${foundationalCount} foundational, ${highValueCount} high-value specializations) for the next decade in India. Find the real problem: which skills you need as table-stakes, and which become your edge. No trend-chasing.`,
    "url": "https://futurecareerschool.com/skill-finder",
    "inLanguage": "en-IN",
    "numberOfItems": totalCount,
    "publisher": {
      "@type": "EducationalOrganization",
      "name": "Future Career School",
      "url": "https://futurecareerschool.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What's the difference between foundational and high-value skills?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Foundational skills are table-stakes—the minimum everyone needs (communication, problem-solving, SQL literacy). High-value skills are specialization differentiators (deep technical expertise, rare domain knowledge). You need both: foundational to survive, high-value to stand out."
        }
      },
      {
        "@type": "Question",
        "name": "What does thinking style mean here?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It refers to how your mind naturally works: 'Systems' thinkers enjoy logic, patterns, and structures; 'People' thinkers enjoy empathy, story, and persuasion. Picking a skill that matches your natural wiring is the single biggest predictor of whether you'll stay with it long enough to earn well."
        }
      },
      {
        "@type": "Question",
        "name": "What does 'income ceiling' mean?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It's the long-term earning potential of the skill if you master it. High: ₹25L+ LPA. Medium: ₹12–25L LPA. Moderate: ₹8–12L LPA. It's a ceiling, not a promise—your actual earnings depend on how you execute, your market, and your network."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to pay for courses from this list?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Almost never, to start. Every skill has a 'Start with' entry that is free or near-free. Try a skill for 2–4 weeks at zero cost before spending on paid courses. The learning curve matters less than whether it genuinely fits."
        }
      }
    ]
  }
];
---

<BaseLayout
  title={`Skill Finder — Foundational + High-Value Skills for the Next Decade | Future Career School`}
  description="Find the right skill — foundational (table-stakes) or high-value (specialization). Curated for India, sorted by thinking style, time to start, income ceiling, and category."
  canonical="https://futurecareerschool.com/skill-finder"
  jsonLd={jsonLd}
>
  <Nav activePage="skill-finder" />

  <!-- ═══════════════════════════════════════
       PAGE HERO
  ═══════════════════════════════════════ -->
  <section id="sf-hero">
    <div class="sf-hero-bg">
      <div class="sf-orb sf-orb-1"></div>
      <div class="sf-orb sf-orb-2"></div>
    </div>
    <div class="container sf-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Skill Finder</span>
      </nav>
      <div class="sf-hero-tag pill">
        <span class="pill-dot"></span>
        {totalCount} Curated Skills — For the Next Decade
      </div>
      <h1 class="sf-h1">
        Foundational or High-Value? <br />
        <span class="gold-text">You need both to build a career.</span>
      </h1>
      <p class="sf-sub">
        Foundational skills are table-stakes (communication, SQL, problem-solving). High-value skills are your differentiator (deep expertise, rare domain knowledge).
        Each skill starts with a free resource you can try this weekend.
      </p>
      <div class="sf-hero-ctas">
        <a href="#finder" class="btn-gold">
          Start Filtering
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <a href="https://wa.me/917815927259?text=Hi%2C+I%27d+like+help+picking+a+skill+to+learn" target="_blank" rel="noopener noreferrer" class="btn-outline">
          Ask for Guidance
        </a>
      </div>

      <!-- Thinking-style quick start -->
      <div class="sf-think-jump" role="navigation" aria-label="Filter by thinking style">
        <span class="sf-think-label">How I think:</span>
        <button class="tj-btn" data-group="thinking" data-value="systems">Logic & patterns</button>
        <button class="tj-btn" data-group="thinking" data-value="people">People & stories</button>
        <button class="tj-btn" data-group="thinking" data-value="both">Both equally</button>
        <a href="/services/career-counselling-and-career-guidance" class="tj-help">Not sure? <span>Start with a session →</span></a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       STICKY FILTER BAR
  ═══════════════════════════════════════ -->
  <div class="filter-wrap" id="filter-wrap" role="search" aria-label="Filter skills">
    <div class="container" id="finder">

      <!-- Search + Sort row -->
      <div class="filter-search-row">
        <div class="fs-input-wrap">
          <svg class="fs-search-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="search"
            id="search-input"
            class="fs-input"
            placeholder={`Search ${totalCount} skills by name, tag, income, tool…`}
            aria-label="Search skills"
            autocomplete="off"
          />
          <button class="fs-clear-btn" id="search-clear" type="button" aria-label="Clear search" style="display:none">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="fs-sort-wrap">
          <label for="sort-select" class="fs-sort-label">Sort</label>
          <select id="sort-select" class="fs-sort-select" aria-label="Sort skills">
            <option value="default">Recommended</option>
            <option value="income-desc">Income — high to low</option>
            <option value="income-asc">Income — low to high</option>
            <option value="difficulty-easy-first">Difficulty — easy first</option>
            <option value="difficulty-steep-first">Difficulty — steep first</option>
            <option value="name-asc">Name A–Z</option>
          </select>
        </div>
      </div>

      <div class="filter-rows">

        <div class="filter-group">
          <span class="fg-label">Work Focus</span>
          <div class="fg-chips fg-chips--wrap">
            <button class="fc-btn fc-btn--active" data-group="workFocus" data-value="all">All types</button>
            {Object.entries(workFocusMeta).map(([key, meta]) => (
              <button class="fc-btn" data-group="workFocus" data-value={key} style={`--fc-color:${meta.color}`}>{meta.label}</button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="fg-label">Skill Type</span>
          <div class="fg-chips">
            <button class="fc-btn fc-btn--active" data-group="skillType" data-value="all">All types</button>
            <button class="fc-btn fc-btn--foundational" data-group="skillType" data-value="foundational">Foundational</button>
            <button class="fc-btn fc-btn--highvalue" data-group="skillType" data-value="high-value">High-Value</button>
          </div>
        </div>

        <div class="filter-group">
          <span class="fg-label">Difficulty</span>
          <div class="fg-chips">
            <button class="fc-btn fc-btn--active" data-group="difficulty" data-value="all">Any</button>
            {Object.entries(difficultyMeta).map(([key, meta]) => (
              <button class="fc-btn" data-group="difficulty" data-value={key} style={`--fc-color:${meta.color}`}>{meta.label}</button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="fg-label">Category</span>
          <div class="fg-chips fg-chips--wrap">
            <button class="fc-btn fc-btn--active" data-group="category" data-value="all">All categories</button>
            {Object.entries(categoryMeta).map(([key, meta]) => (
              <button class="fc-btn" data-group="category" data-value={key} style={`--fc-color:${meta.color}`}>{meta.short}</button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="fg-label">Income Ceiling</span>
          <div class="fg-chips">
            <button class="fc-btn fc-btn--active" data-group="incomeLevel" data-value="all">Any range</button>
            <button class="fc-btn fc-btn--high" data-group="incomeLevel" data-value="high">High (₹25L+)</button>
            <button class="fc-btn fc-btn--medium" data-group="incomeLevel" data-value="medium">Medium (₹12–25L)</button>
            <button class="fc-btn fc-btn--moderate" data-group="incomeLevel" data-value="moderate">Moderate (₹8–12L)</button>
          </div>
        </div>

      </div>

      <div class="filter-meta">
        <span class="filter-count">Showing <strong id="res-count">{totalCount}</strong> of {totalCount} skills</span>
        <div class="filter-meta-right">
          <span id="active-filters" class="active-filters" aria-live="polite"></span>
          <button class="reset-btn" id="reset-btn" aria-label="Reset all filters">Reset filters</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       MAIN SKILL GRID
  ═══════════════════════════════════════ -->
  <main class="container sf-main">

  <!-- ═══════════════════════════════════════
       BOTTOM CTA
  ═══════════════════════════════════════ -->
  <section id="sf-cta">
    <div class="container">
      <div class="sf-cta-inner card">
        <div class="sf-cta-left">
          <h2>Still unsure which foundational + high-value combo fits?<br /><span class="gold-text">Career guidance can map it clearly.</span></h2>
          <p>Filters narrow the field. A real conversation—your situation, finances, goals—picks the path. We show you exactly which skills compound, which are table-stakes, and which become your edge.</p>
        </div>
        <div class="sf-cta-right">
          <a
            href="https://wa.me/917815927259?text=Hi%2C+I%27d+like+help+picking+a+skill+to+learn"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold pulse"
          >
            Get Career Guidance
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/services/career-counselling-and-career-guidance" class="btn-outline">Career Guidance</a>
        </div>
      </div>
    </div>
  </section>

    <!-- Skill grid -->
    <div class="sk-grid" id="sk-grid" aria-live="polite" aria-label="Skill list">
      {skills.map((s, idx) => {
        const cat = categoryMeta[s.category];
        const skillTypeLabel = skillTypeMeta[s.skillType];
        const think = thinkingMeta[s.thinking];
        const timeL = timeMeta[s.timeToStart];
        const incLevel = incomeLevelMeta[s.incomeLevel];
        const dem = demandMeta[s.demand];
        const diff = difficultyMeta[s.difficulty];
        const wfocs = s.workFocus.map(wf => workFocusMeta[wf]);
        const searchBlob = [
          s.name, s.whyNow, s.startWith.label, s.startWith.note,
          ...s.tags, cat.label, skillTypeLabel.label, think.label, timeL.label, dem.label, incLevel.label,
        ].join(' ').toLowerCase();
        return (
          <article
            class={`sk sk--${s.category} sk--${s.skillType}`}
            data-thinking={s.thinking}
            data-making={s.making}
            data-skillType={s.skillType}
            data-time={s.timeToStart}
            data-time-order={timeL.order}
            data-category={s.category}
            data-demand={s.demand}
            data-incomeLevel={s.incomeLevel}
            data-difficulty={s.difficulty}
            data-workFocus={s.workFocus.join(' ')}
            data-name={s.name.toLowerCase()}
            data-search={searchBlob}
            data-order={idx}
            aria-label={s.name}
          >
            <div class="sk-top">
              <span class="sk-cat" style={`--c:${cat.color}`}>
                <span class="sk-cat-dot"></span>{cat.short}
              </span>
              <span class={`sk-demand sk-demand--${s.demand}`} style={`--c:${dem.color}`}>{dem.label}</span>
            </div>

            <div class="sk-type-badge">
              <span class={`sk-type-label sk-type--${s.skillType}`}>{skillTypeLabel.label}</span>
            </div>

            <h3 class="sk-title">{s.name}</h3>

            <div class="sk-metrics">
              <div class="sk-metric">
                <span class="sk-metric-label">Income ceiling</span>
                <strong class="sk-metric-value" style={`--ic:${incLevel.color}`}>{incLevel.label}</strong>
              </div>
              <div class="sk-metric">
                <span class="sk-metric-label">Difficulty</span>
                <strong class="sk-metric-value" style={`--ic:${diff.color}`}>{diff.label}</strong>
              </div>
              <div class="sk-metric">
                <span class="sk-metric-label">Time to Start</span>
                <strong class="sk-metric-value">{timeL.label}</strong>
              </div>
            </div>

            <div class="sk-workfocus">
              <span class="sk-workfocus-label">Work Focus</span>
              <div class="sk-workfocus-tags">
                {wfocs.map(wf => (
                  <span class="sk-wf-tag" style={`--wf-color:${wf.color}`}>{wf.label}</span>
                ))}
              </div>
            </div>

            <div class="sk-why">
              <span class="sk-why-label">Why now</span>
              <p>{s.whyNow}</p>
            </div>

            <div class="sk-start">
              <span class="sk-start-label">Start with</span>
              <strong>{s.startWith.label}</strong>
              <p>{s.startWith.note}</p>
            </div>

            <div class="sk-footer">
              <a href={waLink(s.name)} target="_blank" rel="noopener noreferrer" class="sk-cta" aria-label={`Get guidance on ${s.name}`}>
                Get Guidance <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="empty-state" style="display:none" aria-live="polite">
      <div class="empty-icon">🔍</div>
      <h3>No skills match your filters</h3>
      <p>Try removing one filter, or reset all of them.</p>
      <button id="reset-empty-btn" class="btn-outline">Reset All Filters</button>
    </div>

  </main>

  <!-- ═══════════════════════════════════════
       BOTTOM CTA
  ═══════════════════════════════════════ -->
  <section id="sf-cta">
    <div class="container">
      <div class="sf-cta-inner card">
        <div class="sf-cta-left">
          <h2>Still caught between two options?<br /><span class="gold-text">Career guidance helps you choose the right one.</span></h2>
          <p>The filters narrow the field. A real conversation — your situation, your finances, your family context — picks the one.</p>
        </div>
        <div class="sf-cta-right">
          <a
            href="https://wa.me/917815927259?text=Hi%2C+I%27d+like+help+picking+a+skill+to+learn"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold pulse"
          >
            Get Career Guidance
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/services/career-counselling-and-career-guidance" class="btn-outline">Career Guidance</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ── PAGE HERO ── */
  #sf-hero { position: relative; padding: 9rem 0 3.5rem; overflow: hidden; }
  .sf-hero-bg { position: absolute; inset: 0; z-index: 0; }
