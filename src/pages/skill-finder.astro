---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// ── SKILL DATA ─────────────────────────────────────────────────────────────────
// Organized by Coach's Master Menu (8 deep-skill categories) + Foundational/High-Value classification
// Curated for the current market and the next decade. No trend-chasing, no outdated picks.
// Each skill is evaluated on:
//   • category       — one of 8 Master Menu categories (Software Dev, AI/ML, Data/Cloud, Cybersecurity, Design, Marketing, Business, Document Checking)
//   • skillType      — "foundational" (table-stakes everyone needs) | "high-value" (specialization differentiator)
//   • thinking       — your natural thinking style: "systems" (logic/patterns) | "people" (empathy/communication) | "both"
//   • making         — "build" (create) | "analyse" (interpret) | "both"
//   • incomeLevel    — long-term ceiling: "high" (₹25L+) | "medium" (₹12–25L) | "moderate" (₹8–12L)
//   • timeToStart    — realistic months to first billable work: "<3m" | "3-6m" | "6-12m" | "1-2y"
//   • demand         — "rising" | "stable" | "hot"
//   • whyNow         — one-line reason this is worth your next 6–12 months
//   • startWith      — a concrete, free (or near-free) starting resource
//   • tags           — search keywords

type SkillType = "foundational" | "high-value";
type Thinking = "systems" | "people" | "both";
type Making = "build" | "analyse" | "both";
type IncomeLevel = "high" | "medium" | "moderate";
type TimeKey = "<3m" | "3-6m" | "6-12m" | "1-2y";
type Demand = "rising" | "stable" | "hot";
type WorkFocus = "technical" | "data" | "design" | "product" | "people" | "sales" | "marketing" | "operations";
type Difficulty = "easy" | "moderate" | "steep";

interface Skill {
  name: string;
  category: string;
  skillType: SkillType;
  thinking: Thinking;
  making: Making;
  timeToStart: TimeKey;
  incomeLevel: IncomeLevel;
  demand: Demand;
  difficulty: Difficulty;
  workFocus: WorkFocus[];
  whyNow: string;
  startWith: { label: string; note: string };
  tags: string[];
}

