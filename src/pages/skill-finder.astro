  .sf-orb-2 { width: 440px; height: 440px; background: radial-gradient(circle, rgba(167,139,250,.08) 0%, transparent 70%); bottom: -40px; right: -60px; }
  .sf-hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: rgba(255,255,255,.35); margin-bottom: 1.5rem; }
