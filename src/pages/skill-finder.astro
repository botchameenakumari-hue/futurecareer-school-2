  }
  .tj-help span { color: var(--gold); font-weight: 600; }
  .tj-help:hover { color: rgba(255,255,255,.7); }

  /* ── STICKY FILTER BAR ── */
  .filter-wrap {
    position: sticky; top: 72px; z-index: 50;
    background: rgba(8,12,24,.95);
    backdrop-filter: blur(20px);
