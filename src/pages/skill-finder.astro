</style>

<script>
  // ── FILTER + SEARCH + SORT ENGINE ─────────────────────────────────────────
  type FilterGroup = 'workFocus' | 'skillType' | 'difficulty' | 'category' | 'incomeLevel' | 'thinking';
  type SortKey = 'default' | 'income-desc' | 'income-asc' | 'difficulty-easy-first' | 'difficulty-steep-first' | 'name-asc' | 'time-asc' | 'time-desc';

  const state: Record<FilterGroup, string> & { query: string; sort: SortKey } = {
    workFocus: 'all',
    skillType: 'all',
    difficulty: 'all',
    category: 'all',
    incomeLevel: 'all',
    thinking: 'all',
    query: '',
    sort: 'default',
  };

  const grid = document.getElementById('sk-grid') as HTMLElement | null;
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.sk')) : [];
  const countEl = document.getElementById('res-count');
  const empty = document.getElementById('empty-state');
  const activeFilters = document.getElementById('active-filters');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;

  const groupLabels: Record<FilterGroup, string> = {
    workFocus: 'Work Focus', skillType: 'Skill Type', difficulty: 'Difficulty', category: 'Category', incomeLevel: 'Income Ceiling', thinking: 'Thinking Style',
  };

  const valueLabels: Record<string, Record<string, string>> = {
    workFocus: {
      technical: 'Technical', data: 'Data & Analytics', design: 'Design & Creative',
      product: 'Product & Strategy', people: 'People & Communication', sales: 'Sales & Revenue',
      marketing: 'Marketing & Growth', operations: 'Operations',
    },
    skillType: { foundational: 'Foundational', 'high-value': 'High-Value' },
    difficulty: { easy: 'Easy to Start', moderate: 'Moderate', steep: 'Steep Learning' },
    category: {
      'software-dev': 'Software Development & Architecture', 'ai-ml': 'AI & Machine Learning',
      'data-cloud': 'Data, Cloud & Infrastructure', cybersecurity: 'Cybersecurity',
      design: 'Design, Product & Content', marketing: 'Marketing & Growth',
      business: 'Business Acumen & Soft Skills',
    },
    incomeLevel: { high: 'High (₹25L+)', medium: 'Medium (₹12–25L)', moderate: 'Moderate (₹8–12L)' },
    thinking: { systems: 'Logic & patterns', people: 'People & stories', both: 'Both equally' },
  };

  function updateChipStates() {
    document.querySelectorAll<HTMLButtonElement>('.fc-btn').forEach(btn => {
      const g = btn.dataset.group as FilterGroup | undefined;
      const v = btn.dataset.value;
      if (!g || !v) return;
      btn.classList.toggle('fc-btn--active', state[g] === v);
    });
    document.querySelectorAll<HTMLButtonElement>('.tj-btn').forEach(btn => {
      const v = btn.dataset.value;
      btn.classList.toggle('tj-btn--active', Boolean(v) && state.thinking === v);
    });
  }

  function sortCards() {
    if (!grid) return;
    const all = Array.from(grid.querySelectorAll<HTMLElement>('.sk'));
    const diffOrder = { 'easy': 1, 'moderate': 2, 'steep': 3 };
    all.sort((a, b) => {
      const sort = state.sort;
      if (sort === 'income-desc' || sort === 'income-asc') {
        const am = parseFloat(a.dataset.incomeMid || '0');
        const bm = parseFloat(b.dataset.incomeMid || '0');
        return sort === 'income-desc' ? bm - am : am - bm;
      }
      if (sort === 'difficulty-easy-first' || sort === 'difficulty-steep-first') {
        const aord = diffOrder[a.dataset.difficulty as keyof typeof diffOrder] || 2;
        const bord = diffOrder[b.dataset.difficulty as keyof typeof diffOrder] || 2;
        return sort === 'difficulty-easy-first' ? aord - bord : bord - aord;
      }
      if (sort === 'time-asc' || sort === 'time-desc') {
        const at = parseInt(a.dataset.timeOrder || '0', 10);
        const bt = parseInt(b.dataset.timeOrder || '0', 10);
        return sort === 'time-asc' ? at - bt : bt - at;
      }
      if (sort === 'name-asc') {
        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      }
      // default (recommended = original order)
      return parseInt(a.dataset.order || '0', 10) - parseInt(b.dataset.order || '0', 10);
    });
    const frag = document.createDocumentFragment();
    all.forEach(c => frag.appendChild(c));
    grid.appendChild(frag);
  }

  function renderActiveFilters() {
    if (!activeFilters) return;
    const chips: string[] = [];
    (Object.keys(groupLabels) as FilterGroup[]).forEach(g => {
      const v = state[g];
      if (v && v !== 'all') {
        const label = valueLabels[g]?.[v] || v;
        chips.push(`<span class="af-pill">${label}<button type="button" data-af-group="${g}" aria-label="Remove ${label}"><svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button></span>`);
      }
    });
    if (state.query) {
      const safe = state.query.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      chips.push(`<span class="af-pill">"${safe}"<button type="button" data-af-group="query" aria-label="Clear search"><svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button></span>`);
    }
    activeFilters.innerHTML = chips.join('');
  }

  function applyFilters() {
    let visible = 0;
    const q = state.query.trim().toLowerCase();
    cards.forEach(card => {
      const workFocusStr = card.dataset.workFocus || '';
      const skillType = card.dataset.skillType || '';
      const difficulty = card.dataset.difficulty || '';
      const categoryVal = card.dataset.category || '';
      const incomeVal = card.dataset.incomeLevel || '';
      const thinkingVal = card.dataset.thinking || '';
      const blob = card.dataset.search || '';

      // workFocus is space-separated string; match if ANY selected focus is present
      const workFocusArray = workFocusStr.split(' ').filter(x => x);
      const matchWorkFocus = state.workFocus === 'all'
        || workFocusArray.includes(state.workFocus);
      const matchSkillType = state.skillType === 'all' || skillType === state.skillType;
      const matchDifficulty = state.difficulty === 'all' || difficulty === state.difficulty;
      const matchCat = state.category === 'all' || categoryVal === state.category;
      const matchIncome = state.incomeLevel === 'all' || incomeVal === state.incomeLevel;
      const matchThinking = state.thinking === 'all' || thinkingVal === state.thinking;
      const matchQ = !q || blob.includes(q);

      const show = matchWorkFocus && matchSkillType && matchDifficulty && matchCat && matchIncome && matchThinking && matchQ;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = String(visible);
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    if (grid) grid.style.display = visible === 0 ? 'none' : '';
    renderActiveFilters();
  }

  // Filter chip clicks
  document.querySelectorAll<HTMLButtonElement>('.fc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const g = btn.dataset.group as FilterGroup | undefined;
      const v = btn.dataset.value;
      if (!g || !v) return;
      state[g] = v;
      updateChipStates();
      applyFilters();
    });
  });

  // Hero thinking-style quick jumps
  document.querySelectorAll<HTMLButtonElement>('.tj-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.dataset.value;
      if (!v) return;
      state.thinking = v;
      updateChipStates();
      applyFilters();
      const finder = document.getElementById('finder');
      finder?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Active-filter pill removal
  activeFilters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-af-group]');
    if (!btn) return;
    const g = btn.dataset.afGroup;
    if (g === 'query') {
      state.query = '';
      if (searchInput) searchInput.value = '';
      if (searchClear) searchClear.style.display = 'none';
    } else if (g && g in state) {
      (state as any)[g] = 'all';
      updateChipStates();
    }
    applyFilters();
  });

  // Search (debounced)
  let searchTimer: number | undefined;
  searchInput?.addEventListener('input', () => {
    const v = searchInput.value;
    if (searchClear) searchClear.style.display = v ? 'flex' : 'none';
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      state.query = v;
      applyFilters();
    }, 120);
  });
  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    state.query = '';
    searchClear.style.display = 'none';
    applyFilters();
    searchInput?.focus();
  });

  // Sort
  sortSelect?.addEventListener('change', () => {
    state.sort = sortSelect.value as SortKey;
    sortCards();
  });

  // Reset
  function resetAll() {
    (['workFocus', 'skillType', 'difficulty', 'category', 'incomeLevel', 'thinking'] as FilterGroup[]).forEach(g => { state[g] = 'all'; });
    state.query = '';
    state.sort = 'default';
    if (searchInput) searchInput.value = '';
    if (searchClear) searchClear.style.display = 'none';
    if (sortSelect) sortSelect.value = 'default';
    updateChipStates();
    sortCards();
    applyFilters();
  }
  document.getElementById('reset-btn')?.addEventListener('click', resetAll);
  document.getElementById('reset-empty-btn')?.addEventListener('click', resetAll);

  // Deep-link: ?q=... &workFocus=... &skillType=... &difficulty=... &category=... &incomeLevel=... &thinking=... &sort=...
  const params = new URLSearchParams(window.location.search);
  (['workFocus','skillType','difficulty','category','incomeLevel','thinking'] as FilterGroup[]).forEach(g => {
    const v = params.get(g);
    if (v) state[g] = v;
  });
  const pq = params.get('q');
  if (pq && searchInput) {
    searchInput.value = pq;
    state.query = pq;
    if (searchClear) searchClear.style.display = 'flex';
  }
  const ps = params.get('sort') as SortKey | null;
  if (ps && sortSelect) {
    sortSelect.value = ps;
    state.sort = ps;
  }
  updateChipStates();
  sortCards();
  applyFilters();
</script>
