---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "About", "item": "https://futurecareerschool.com/about" },
      { "@type": "ListItem", "position": 3, "name": "Allu Vagdevi", "item": "https://futurecareerschool.com/about/allu-vagdevi" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Allu Vagdevi",
    "url": "https://futurecareerschool.com/about/allu-vagdevi/",
    "jobTitle": "Career Researcher and Writer",
    "worksFor": {
      "@type": "EducationalOrganization",
      "name": "Future Career School",
      "url": "https://futurecareerschool.com"
    },
    "knowsAbout": [
      "Career guidance",
      "Non-traditional career paths",
      "Science and agriculture to career transitions",
      "High-income skill alternatives",
      "First-generation professional career planning",
      "Career counselling for diverse educational backgrounds"
    ],
    "description": "Allu Vagdevi is a career researcher and writer at Future Career School with a BSc Agriculture background. She researches practical career alternatives for graduates from non-engineering, non-medicine backgrounds and writes career guidance content with a focus on real outcomes over conventional advice."
  }
];
---

<BaseLayout
  title="Allu Vagdevi | Career Researcher and Writer | Future Career School"
  description="Allu Vagdevi is a career researcher and writer at Future Career School. BSc Agriculture graduate focused on practical career alternatives, non-traditional skill paths, and guidance for first-generation professionals."
  canonical="https://futurecareerschool.com/about/allu-vagdevi"
  jsonLd={jsonLd}
>
  <Nav />

  <section id="bio-hero">
    <div class="hero-bg">
      <div class="orb orb-teal"></div>
      <div class="orb orb-gold"></div>
    </div>
    <div class="container bio-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/about">About</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Allu Vagdevi</span>
      </nav>

      <div class="bio-header">
        <div class="avatar">AV</div>
        <div class="bio-meta">
          <div class="pill bio-role-pill">
            <span class="pill-dot"></span>
            Career Researcher &amp; Writer
          </div>
          <h1 class="bio-name">Allu Vagdevi</h1>
          <p class="bio-org">Future Career School &mdash; Visakhapatnam, India</p>
        </div>
      </div>
    </div>
  </section>

  <section id="bio-body">
    <div class="container bio-content-grid">

      <div class="bio-main">
        <div class="bio-section card">
          <h2>About Vagdevi</h2>
          <p>
            Allu Vagdevi (Devi) is a career researcher and writer at Future Career School.
            She holds a BSc in Agriculture from Acharya N.G. Ranga Agricultural University, Andhra Pradesh,
            and brings a perspective rarely seen in career guidance: what it actually looks like to build
            a high-income career from a non-engineering, non-medicine background.
          </p>
          <p>
            Her interest in career guidance grew from personal experience.
            Coming from an agriculture science background, she found herself in the same position
            as thousands of graduates every year &mdash; holding a legitimate degree,
            with no clear map for what comes next, surrounded by advice that assumed
            you were either a software engineer or a doctor.
          </p>
          <p>
            She began researching what actually worked for people from similar backgrounds:
            which skills opened doors, which transitions were realistic, and where the real income opportunities
            were for people whose degrees did not come with a built-in job pipeline.
            That research is now what she writes about at Future Career School.
          </p>
        </div>

        <div class="bio-section card">
          <h2>Focus Areas</h2>
          <ul class="focus-list">
            <li>
              <strong>Non-traditional career paths</strong> — guidance for graduates from agriculture,
              arts, commerce, and science backgrounds navigating a job market built around tech and medicine
            </li>
            <li>
              <strong>High-income alternatives</strong> — identifying skill paths with real earning potential
              that do not require starting over or taking on debt for another degree
            </li>
            <li>
              <strong>First-generation career planning</strong> — practical frameworks for professionals
              who lack a family or peer network with relevant career experience
            </li>
            <li>
              <strong>Rural-to-urban career transitions</strong> — how students from smaller cities and towns
              can compete and grow in modern, urban, and remote job markets
            </li>
            <li>
              <strong>Skills over credentials</strong> — the practical case for building a skill portfolio
              that outperforms a generic degree in real hiring situations
            </li>
          </ul>
        </div>

        <div class="bio-section card">
          <h2>Background</h2>
          <p>
            Vagdevi graduated with a BSc Agriculture degree and, like most graduates in non-professional courses,
            encountered the reality that career guidance systems in India are overwhelmingly designed
            for students in engineering and medical fields.
            That gap &mdash; and the frustration it creates &mdash; became her subject.
          </p>
          <p>
            She spent time researching career paths across digital marketing, content, sales, UI/UX,
            data entry to data analytics transitions, and a range of other skill-first careers
            that genuinely hire from diverse educational backgrounds.
            Her research involved talking to professionals who had made these transitions successfully
            and documenting what they actually did differently.
          </p>
          <p>
            At Future Career School, she writes career guidance content that respects the reader's
            real constraints &mdash; financial, geographic, and educational &mdash; and gives
            practical, actionable direction instead of advice built for a different kind of student.
          </p>
        </div>
      </div>

      <aside class="bio-sidebar">
        <div class="sidebar-card card">
          <h3>Credentials</h3>
          <ul class="cred-list">
            <li>
              <span class="cred-label">Education</span>
              <span class="cred-val">BSc Agriculture &mdash; Acharya N.G. Ranga Agricultural University</span>
            </li>
            <li>
              <span class="cred-label">Role</span>
              <span class="cred-val">Career Researcher and Writer</span>
            </li>
            <li>
              <span class="cred-label">Organisation</span>
              <span class="cred-val">Future Career School</span>
            </li>
            <li>
              <span class="cred-label">Speciality</span>
              <span class="cred-val">Non-traditional career paths, first-gen professionals, skill alternatives</span>
            </li>
          </ul>
        </div>

        <div class="sidebar-card card">
          <h3>Articles by Vagdevi</h3>
          <p class="sidebar-note">
            Career guidance articles researched and written by Vagdevi are published regularly on the Future Career School blog.
          </p>
          <a href="/blog" class="sidebar-link">Browse the Blog &rsaquo;</a>
        </div>

        <div class="sidebar-card card sidebar-cta">
          <h3>Get Career Guidance</h3>
          <p>
            Future Career School provides initial 1-on-1 career guidance and continuous guidance for students, graduates, and professionals.
          </p>
          <a href="/services/career-counselling-and-career-guidance" class="btn-gold">Explore Guidance</a>
        </div>
      </aside>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

  #bio-hero {
    position: relative;
    padding: 130px 0 60px;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .orb {
    position: absolute; border-radius: 50%;
    filter: blur(100px); opacity: .35;
  }
  .orb-teal { width: 500px; height: 500px; background: radial-gradient(circle, rgba(45,212,191,.2), transparent 70%); top: -160px; left: -80px; }
  .orb-gold { width: 350px; height: 350px; background: radial-gradient(circle, rgba(229,184,74,.2), transparent 70%); top: 0; right: 0; }

  .bio-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2.5rem; }
  .breadcrumb a { color: rgba(255,255,255,.4); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.7); }

  .bio-header { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(45,212,191,.2), rgba(45,212,191,.06));
    border: 2px solid rgba(45,212,191,.3);
    display: flex; align-items: center; justify-content: center;
    font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.4rem;
    color: var(--teal); flex-shrink: 0;
  }
  .bio-role-pill { font-size: 12px; font-weight: 600; color: rgba(255,255,255,.5); margin-bottom: 1rem; width: fit-content; }
  .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); display: inline-block; flex-shrink: 0; }
  .bio-name {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800; letter-spacing: -.04em;
    color: #fff; margin-bottom: .4rem;
  }
  .bio-org { font-size: 14px; color: rgba(255,255,255,.4); }

  #bio-body { padding: 60px 0 100px; }
  .bio-content-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }
  .bio-section {
    padding: 2rem 2.25rem;
    margin-bottom: 1.5rem;
  }
  .bio-section h2 {
    font-family: "Sora", sans-serif;
    font-size: 1.15rem; font-weight: 700; color: #fff;
    margin-bottom: 1.25rem;
  }
  .bio-section p {
    font-size: 15px; color: rgba(255,255,255,.55); line-height: 1.8;
    margin-bottom: 1rem;
  }
  .bio-section p:last-child { margin-bottom: 0; }

  .focus-list { list-style: none; display: flex; flex-direction: column; gap: .9rem; }
  .focus-list li { font-size: 14.5px; color: rgba(255,255,255,.5); padding-left: 1.5rem; position: relative; line-height: 1.65; }
  .focus-list li::before { content: '›'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

  .bio-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-card { padding: 1.5rem 1.75rem; }
  .sidebar-card h3 { font-family: "Sora", sans-serif; font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: 1rem; }

  .cred-list { list-style: none; display: flex; flex-direction: column; gap: .85rem; }
  .cred-list li { display: flex; flex-direction: column; gap: .2rem; }
  .cred-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.3); }
  .cred-val { font-size: 13px; color: rgba(255,255,255,.6); line-height: 1.5; }

  .sidebar-note { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.65; margin-bottom: 1rem; }
  .sidebar-link { font-size: 13px; font-weight: 600; color: var(--teal); transition: opacity .2s; }
  .sidebar-link:hover { opacity: .75; }

  .sidebar-cta { border-color: rgba(229,184,74,.18); background: rgba(229,184,74,.02); }
  .sidebar-cta p { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.65; margin-bottom: 1.25rem; }
  .btn-gold {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; padding: 11px 20px;
    background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
    color: #080c18; font-family: "Sora", sans-serif; font-weight: 700; font-size: 13px;
    border-radius: 10px; transition: all .3s;
    box-shadow: 0 4px 14px rgba(229,184,74,.25);
  }
  .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(229,184,74,.4); }

  @media (max-width: 900px) {
    .bio-content-grid { grid-template-columns: 1fr; }
    .bio-sidebar { order: -1; }
  }
  @media (max-width: 600px) {
    #bio-hero { padding: 110px 0 48px; }
    .bio-header { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  }
</style>
