---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { WHATSAPP_BOOKING_URL } from '../../config/site';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "About", "item": "https://futurecareerschool.com/about" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "About Future Career School",
    "description": "Future Career School provides practical career guidance focused on practical assessments, high-value skill building, market readiness, and an early financial freedom roadmap for students, graduates, and professionals across India.",
    "url": "https://futurecareerschool.com/about",
    "inLanguage": "en-IN",
    "publisher": {
      "@type": "EducationalOrganization",
      "name": "Future Career School",
      "url": "https://futurecareerschool.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "13-420, Durga Nagar, Arilova",
        "addressLocality": "Visakhapatnam",
        "addressRegion": "Andhra Pradesh",
        "postalCode": "530040",
        "addressCountry": "IN"
      }
    }
  }
];
---

<BaseLayout
  title="About Future Career School | Mission, Team, and Vision"
  description="Future Career School provides practical career guidance for high-value skill building, market readiness, and earlier financial freedom. Learn about our mission, team, and approach."
  canonical="https://futurecareerschool.com/about"
  jsonLd={jsonLd}
>
  <Nav />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">About</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Built for real career decisions
      </div>

      <h1 class="hero-title">
        About
        <span class="gold-text"> Future Career School</span>
      </h1>
      <p class="hero-sub">
        We are not a generic counselling service.
        Future Career School exists to give students, graduates, and professionals practical direction through an initial 1-on-1 session, continuous guidance when needed, and fully free assessment and finder tools.
      </p>
      <div class="hero-actions">
        <a href="/services/career-counselling-and-career-guidance" class="btn-gold pulse">Get Career Guidance</a>
        <a href={WHATSAPP_BOOKING_URL} class="btn-outline" target="_blank" rel="noopener noreferrer">Message on WhatsApp</a>
      </div>
    </div>
  </section>

  <section id="mission">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--gold)">&#9675;</span>&nbsp;Our Mission</div>
      <h2 class="section-headline">Career Guidance That Actually Follows Through</h2>
            <p class="section-sub">
        Most career counselling stops at advice. We focus on clarity, high-value skill building, market readiness, and an earlier financial freedom roadmap.
      </p>

      <div class="mission-grid">
        <div class="mission-card card">
          <div class="mission-icon">&#127919;</div>
          <h3>Direction First</h3>
          <p>
            Before picking a career, students and professionals need a clear picture of their biology, context, market reality,
            and AI-era survival. We start with that picture, not a generic questionnaire.
          </p>
        </div>
        <div class="mission-card card">
          <div class="mission-icon">&#128295;</div>
          <h3>Skills That Pay</h3>
          <p>
            We guide you toward skills that match your constraints and have real market demand. Not popular — practical.
            High-income skills, transferable skills, and AI-aware positioning.
          </p>
        </div>
        <div class="mission-card card">
          <div class="mission-icon">&#128200;</div>
          <h3>Continuous Support</h3>
          <p>
            A single session gives you a starting point. Continued guidance gives you follow-through, course correction,
            and accountability as your situation evolves. That is what we are built for.
          </p>
        </div>
        <div class="mission-card card">
          <div class="mission-icon">&#127775;</div>
          <h3>Financial Independence</h3>
          <p>
            The end goal is not just a job. It is early financial independence through smart skill stacking, proof of work,
            and understanding how income is actually built — not just earned.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="positioning">
    <div class="container">
      <div class="two-col">
        <div class="pos-content">
          <div class="section-tag pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;What Makes Us Different</div>
          <h2>Practical, Affordable, and Honest</h2>
          <ul class="pos-list">
            <li>
              <strong>Not generic counselling</strong> — every session uses structured frameworks, not motivational talk
            </li>
            <li>
              <strong>Not a one-time personality test</strong> — real guidance needs context, follow-up, and correction
            </li>
            <li>
              <strong>Not degree-obsessed</strong> — we evaluate college ROI honestly and plan skill paths that work with or without expensive degrees
            </li>
            <li>
              <strong>AI-aware</strong> — every career path is assessed for automation risk and future-proofing in an AI-first economy
            </li>
            <li>
              <strong>Market-honest</strong> — we do not tell you what you want to hear; we tell you what the market and your constraints actually allow
            </li>
            <li>
              <strong>Affordable and accessible</strong> — practical career guidance should not require a fortune or a loan
            </li>
          </ul>
        </div>
        <div class="pos-stat-block">
          <div class="stat-card card">
            <div class="stat-num">38</div>
            <div class="stat-label">Curated skills mapped for students and professionals</div>
          </div>
          <div class="stat-card card">
            <div class="stat-num">93+</div>
            <div class="stat-label">Career resources organized by topic, audience, and type</div>
          </div>
          <div class="stat-card card">
            <div class="stat-num">1-on-1</div>
            <div class="stat-label">First session is always personal — no group onboarding</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="sub-pages">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--gold)">&#9675;</span>&nbsp;Learn More</div>
      <h2 class="section-headline">Explore This Section</h2>
      <p class="section-sub">Learn more about the people, purpose, and standards behind Future Career School.</p>

      <div class="sub-grid">
        <a class="sub-card card" href="/about/shivanshi-sehgal/">
          <div class="sub-kicker sub-kicker--live">Writer</div>
          <h3>Shivanshi Sehgal</h3>
          <p>Career researcher and writer. MCA graduate focusing on tech-adjacent careers, skill-first planning, and career transitions.</p>
          <div class="sub-link">View Profile &rsaquo;</div>
        </a>
        <a class="sub-card card" href="/about/allu-vagdevi/">
          <div class="sub-kicker sub-kicker--live">Writer</div>
          <h3>Allu Vagdevi</h3>
          <p>Career researcher and writer. BSc Agriculture graduate specialising in non-traditional career paths and first-generation professionals.</p>
          <div class="sub-link">View Profile &rsaquo;</div>
        </a>
        <article id="team" class="sub-card card">
          <div class="sub-kicker">Team</div>
          <h3>Meet the Team</h3>
          <p>The people behind Future Career School — their experience, methodology, and commitment to real career outcomes.</p>
          <div class="sub-link">View Team &rsaquo;</div>
        </article>
        <article id="vision" class="sub-card card">
          <div class="sub-kicker">Vision</div>
          <h3>Our Vision</h3>
          <p>Where we are going and why: making practical career guidance accessible across India and beyond.</p>
          <div class="sub-link">Read Vision &rsaquo;</div>
        </article>
        <article id="reviews" class="sub-card card">
          <div class="sub-kicker">Reviews</div>
          <h3>Client Reviews</h3>
          <p>Real outcomes from students, graduates, and professionals who went through our guidance process.</p>
          <div class="sub-link">Read Reviews &rsaquo;</div>
        </article>
      </div>

      <p class="coming-soon-note">
        For now, you can explore the live service pages below or reach out directly.
      </p>
    </div>
  </section>

  <section id="nav-links">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;Live Services</div>
      <h2 class="section-headline">Start With These</h2>
      <div class="nav-link-grid">
        <a class="nav-link-card card" href="/services">
          <strong>All Services</strong>
          <span>Overview of guidance, assessments, and coaching tracks</span>
        </a>
        <a class="nav-link-card card" href="/services/career-counselling-and-career-guidance">
          <strong>Career Guidance</strong>
          <span>Initial 1-on-1 guidance and continuous support</span>
        </a>
        <a class="nav-link-card card" href="/services/assessments">
          <strong>Assessments</strong>
          <span>Psychometric tests, aptitude tests, and career interest tools</span>
        </a>
        <a class="nav-link-card card" href="/services/career-counselling-and-career-guidance#guidance-expectations">
          <strong>What Guidance Is and Isn't</strong>
          <span>Clear expectations before you start</span>
        </a>
        <a class="nav-link-card card" href="/skill-finder">
          <strong>Skill Finder</strong>
          <span>38 curated skills mapped to career paths</span>
        </a>
        <a class="nav-link-card card" href="/contact">
          <strong>Contact</strong>
          <span>Reach us directly for career guidance</span>
        </a>
      </div>
    </div>
  </section>

  <section id="cta">
    <div class="container">
      <div class="cta-inner card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <div class="pill cta-pill">Ready to start?</div>
          <h2 class="cta-title">Get Career Guidance</h2>
          <p class="cta-sub">
            Start with one 1-on-1 guidance session. If continuous guidance is the right fit, you decide the next step from there.
          </p>
          <div class="cta-actions">
            <a href={WHATSAPP_BOOKING_URL} class="btn-gold pulse" target="_blank" rel="noopener noreferrer">Get Guidance on WhatsApp</a>
            <a href="/services/career-counselling-and-career-guidance" class="btn-outline">See Career Guidance</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #mission { padding: 6rem 0; background: rgba(255,255,255,.012); }
  #positioning { padding: 6rem 0; }
  #sub-pages { padding: 6rem 0; background: rgba(255,255,255,.012); }
  #nav-links { padding: 6rem 0; }
  #cta { padding: 6rem 0 7rem; }

  .section-tag { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 1.25rem; align-items: center; gap: 6px; }
  .section-headline { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-align: center; }
  .section-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.55); max-width: 720px; margin: 0 auto 3rem; text-align: center; line-height: 1.7; }

  .mission-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .mission-card { padding: 2rem; display: flex; flex-direction: column; gap: .75rem; }
  .mission-icon { font-size: 2rem; margin-bottom: .25rem; }
  .mission-card h3 { font-size: 1.15rem; color: #fff; }
  .mission-card p { font-size: 14px; color: rgba(255,255,255,.58); line-height: 1.75; }

  .two-col { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: start; }
  .pos-content h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin: 1.25rem 0 1.75rem; }
  .pos-list { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
  .pos-list li { font-size: 14.5px; color: rgba(255,255,255,.65); padding-left: 1.25rem; position: relative; line-height: 1.65; }
  .pos-list li::before { content: '>'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
  .pos-list strong { color: rgba(255,255,255,.9); }
  .pos-stat-block { display: flex; flex-direction: column; gap: 1rem; }
  .stat-card { padding: 1.5rem 1.75rem; }
  .stat-num { font-family: "Sora", sans-serif; font-size: 2.2rem; font-weight: 900; letter-spacing: -.04em; color: var(--gold); margin-bottom: .35rem; }
  .stat-label { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.55; }

  .sub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .sub-card { padding: 1.75rem; display: flex; flex-direction: column; transition: transform .25s, border-color .25s; }
  .sub-card:hover { transform: translateY(-3px); border-color: rgba(229,184,74,.3); }
  .sub-kicker { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--teal); margin-bottom: .7rem; }
  .sub-kicker--live { color: var(--gold); }
  .sub-card h3 { font-size: 1.1rem; color: #fff; margin-bottom: .65rem; }
  .sub-card p { font-size: 13.5px; color: rgba(255,255,255,.55); line-height: 1.7; margin-bottom: 1.25rem; flex: 1; }
  .sub-link { margin-top: auto; font-size: 13px; font-weight: 800; color: var(--gold); }
  .coming-soon-note { margin-top: 2rem; text-align: center; font-size: 13px; color: rgba(255,255,255,.32); }

  .nav-link-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .nav-link-card { padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: .5rem; transition: transform .2s, border-color .2s; }
  .nav-link-card:hover { transform: translateY(-3px); border-color: rgba(45,212,191,.3); }
  .nav-link-card strong { color: #fff; font-size: 14px; }
  .nav-link-card span { color: rgba(255,255,255,.45); font-size: 13px; line-height: 1.5; }

  .cta-inner { position: relative; overflow: hidden; padding: 3.25rem; text-align: center; border-color: rgba(229,184,74,.14); background: rgba(229,184,74,.02); }
  .cta-glow { position: absolute; inset: 0; background: radial-gradient(circle at 50% 0%, rgba(229,184,74,.16), transparent 60%); pointer-events: none; }
  .cta-content { position: relative; z-index: 1; }
  .cta-pill { margin: 0 auto 1.4rem; width: fit-content; color: rgba(255,255,255,.55); }
  .cta-title { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 900; letter-spacing: -.03em; color: #fff; margin-bottom: .9rem; }
  .cta-sub { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.75; max-width: 620px; margin: 0 auto 2.25rem; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 980px) {
    .mission-grid { grid-template-columns: 1fr; }
    .two-col { grid-template-columns: 1fr; gap: 2.5rem; }
    .sub-grid { grid-template-columns: 1fr; }
    .nav-link-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 680px) {
    #hero { padding: 120px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
    .nav-link-grid { grid-template-columns: 1fr; }
    .cta-inner { padding: 2.25rem 1.5rem; }
    .cta-actions { flex-direction: column; align-items: stretch; }
    .cta-actions .btn-gold, .cta-actions .btn-outline { justify-content: center; }
  }
</style>
