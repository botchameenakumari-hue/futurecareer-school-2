---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "About", "item": "https://futurecareerschool.com/about" },
      { "@type": "ListItem", "position": 3, "name": "Shivanshi Sehgal", "item": "https://futurecareerschool.com/about/shivanshi-sehgal" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Shivanshi Sehgal",
    "url": "https://futurecareerschool.com/about/shivanshi-sehgal/",
    "jobTitle": "Career Researcher and Writer",
    "worksFor": {
      "@type": "EducationalOrganization",
      "name": "Future Career School",
      "url": "https://futurecareerschool.com"
    },
    "knowsAbout": [
      "Career guidance",
      "Tech career paths",
      "Data science and AI skill development",
      "Career transitions",
      "High-income skill planning",
      "Career counselling for students and graduates"
    ],
    "description": "Shivanshi Sehgal is a career researcher and writer at Future Career School with an MCA background. She researches skill markets, career trajectories, and practical guidance for students and professionals navigating the modern job market."
  }
];
---

<BaseLayout
  title="Shivanshi Sehgal | Career Researcher and Writer | Future Career School"
  description="Shivanshi Sehgal is a career researcher and writer at Future Career School. MCA graduate with a focus on practical career guidance, high-income skill paths, and data and tech careers."
  canonical="https://futurecareerschool.com/about/shivanshi-sehgal"
  jsonLd={jsonLd}
>
  <Nav />

  <section id="bio-hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
    </div>
    <div class="container bio-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/about">About</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Shivanshi Sehgal</span>
      </nav>

      <div class="bio-header">
        <div class="avatar">SS</div>
        <div class="bio-meta">
          <div class="pill bio-role-pill">
            <span class="pill-dot"></span>
            Career Researcher &amp; Writer
          </div>
          <h1 class="bio-name">Shivanshi Sehgal</h1>
          <p class="bio-org">Future Career School &mdash; Visakhapatnam, India</p>
        </div>
      </div>
    </div>
  </section>

  <section id="bio-body">
    <div class="container bio-content-grid">

      <div class="bio-main">
        <div class="bio-section card">
          <h2>About Shivanshi</h2>
          <p>
            Shivanshi Sehgal is a career researcher and writer at Future Career School.
            She holds an MCA (Master of Computer Applications) and spent her early career
            in the tech industry before shifting full-time into career research and guidance writing.
          </p>
          <p>
            The shift happened for a specific reason: she kept noticing the same gap.
            Students and graduates would finish their degrees, absorb all the conventional advice,
            and still end up with no clear picture of what to actually do or build next.
            The advice available &mdash; online, in colleges, from counsellors &mdash; was either generic, outdated, or designed to sell a course.
          </p>
          <p>
            She started documenting what actually works instead: which skill paths lead to real income,
            why certain careers plateau early, and what separates professionals who grow from those who stay stuck.
            That research is now the foundation of her writing at Future Career School.
          </p>
        </div>

        <div class="bio-section card">
          <h2>Focus Areas</h2>
          <ul class="focus-list">
            <li>
              <strong>Tech-adjacent careers</strong> — data, AI, product, and digital operations paths
              that do not require a CS degree to enter or grow
            </li>
            <li>
              <strong>Skill-first career planning</strong> — how to identify and build the right skill
              before committing time and money to a course or degree
            </li>
            <li>
              <strong>Career transitions</strong> — practical frameworks for moving from the wrong field
              to the right one without financial disaster or wasted years
            </li>
            <li>
              <strong>Income and market fit</strong> — understanding what the job market actually rewards
              versus what educational institutions and social media make look attractive
            </li>
            <li>
              <strong>AI-era career planning</strong> — how automation and AI tools are reshaping which
              skills hold value and which are being commoditised
            </li>
          </ul>
        </div>

        <div class="bio-section card">
          <h2>Background</h2>
          <p>
            Shivanshi completed her MCA and entered the tech workforce, where she observed firsthand
            how inconsistent career outcomes were even among peers with identical qualifications.
            Some advanced quickly; most did not &mdash; and the difference was rarely the degree.
          </p>
          <p>
            She spent several years interviewing students, fresh graduates, and working professionals
            to understand the real drivers of career progress: which decisions mattered, which wasted time,
            and what the people actually earning well had done differently.
            Her research covers career paths across tech, data, marketing, sales, design, and operations.
          </p>
          <p>
            At Future Career School, she translates that research into practical, no-fluff content
            that helps people make better career decisions &mdash; not just more informed ones.
          </p>
        </div>
      </div>

      <aside class="bio-sidebar">
        <div class="sidebar-card card">
          <h3>Credentials</h3>
          <ul class="cred-list">
            <li>
              <span class="cred-label">Education</span>
              <span class="cred-val">MCA &mdash; Master of Computer Applications</span>
            </li>
            <li>
              <span class="cred-label">Role</span>
              <span class="cred-val">Career Researcher and Writer</span>
            </li>
            <li>
              <span class="cred-label">Organisation</span>
              <span class="cred-val">Future Career School</span>
            </li>
            <li>
              <span class="cred-label">Speciality</span>
              <span class="cred-val">Tech careers, skill-first planning, career transitions</span>
            </li>
          </ul>
        </div>

        <div class="sidebar-card card">
          <h3>Articles by Shivanshi</h3>
          <p class="sidebar-note">
            Career guidance articles researched and written by Shivanshi are published regularly on the Future Career School blog.
          </p>
          <a href="/blog" class="sidebar-link">Browse the Blog &rsaquo;</a>
        </div>

        <div class="sidebar-card card sidebar-cta">
          <h3>Get Career Guidance</h3>
          <p>
            Future Career School provides initial 1-on-1 career guidance and continuous guidance for students, graduates, and professionals.
          </p>
          <a href="/services/career-counselling-and-career-guidance" class="btn-gold">Explore Guidance</a>
        </div>
      </aside>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

  /* Hero */
  #bio-hero {
    position: relative;
    padding: 130px 0 60px;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .orb {
    position: absolute; border-radius: 50%;
    filter: blur(100px); opacity: .35;
  }
  .orb-gold { width: 500px; height: 500px; background: radial-gradient(circle, rgba(229,184,74,.25), transparent 70%); top: -160px; left: -80px; }
  .orb-teal { width: 350px; height: 350px; background: radial-gradient(circle, rgba(45,212,191,.18), transparent 70%); top: 0; right: 0; }

  .bio-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.35); margin-bottom: 2.5rem; }
  .breadcrumb a { color: rgba(255,255,255,.4); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.7); }

  .bio-header { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(229,184,74,.25), rgba(229,184,74,.08));
    border: 2px solid rgba(229,184,74,.3);
    display: flex; align-items: center; justify-content: center;
    font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.4rem;
    color: var(--gold); flex-shrink: 0;
  }
  .bio-role-pill { font-size: 12px; font-weight: 600; color: rgba(255,255,255,.5); margin-bottom: 1rem; width: fit-content; }
  .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); display: inline-block; flex-shrink: 0; }
  .bio-name {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800; letter-spacing: -.04em;
    color: #fff; margin-bottom: .4rem;
  }
  .bio-org { font-size: 14px; color: rgba(255,255,255,.4); }

  /* Body */
  #bio-body { padding: 60px 0 100px; }
  .bio-content-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }
  .bio-section {
    padding: 2rem 2.25rem;
    margin-bottom: 1.5rem;
  }
  .bio-section h2 {
    font-family: "Sora", sans-serif;
    font-size: 1.15rem; font-weight: 700; color: #fff;
    margin-bottom: 1.25rem;
  }
  .bio-section p {
    font-size: 15px; color: rgba(255,255,255,.55); line-height: 1.8;
    margin-bottom: 1rem;
  }
  .bio-section p:last-child { margin-bottom: 0; }

  .focus-list { list-style: none; display: flex; flex-direction: column; gap: .9rem; }
  .focus-list li { font-size: 14.5px; color: rgba(255,255,255,.5); padding-left: 1.5rem; position: relative; line-height: 1.65; }
  .focus-list li::before { content: '›'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }

  /* Sidebar */
  .bio-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-card { padding: 1.5rem 1.75rem; }
  .sidebar-card h3 { font-family: "Sora", sans-serif; font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: 1rem; }

  .cred-list { list-style: none; display: flex; flex-direction: column; gap: .85rem; }
  .cred-list li { display: flex; flex-direction: column; gap: .2rem; }
  .cred-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.3); }
  .cred-val { font-size: 13px; color: rgba(255,255,255,.6); line-height: 1.5; }

  .sidebar-note { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.65; margin-bottom: 1rem; }
  .sidebar-link { font-size: 13px; font-weight: 600; color: var(--gold); transition: opacity .2s; }
  .sidebar-link:hover { opacity: .75; }

  .sidebar-cta { border-color: rgba(229,184,74,.18); background: rgba(229,184,74,.02); }
  .sidebar-cta p { font-size: 13px; color: rgba(255,255,255,.45); line-height: 1.65; margin-bottom: 1.25rem; }
  .btn-gold {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; padding: 11px 20px;
    background: linear-gradient(135deg, #e5b84a, #f5d98c, #c49a2a);
    color: #080c18; font-family: "Sora", sans-serif; font-weight: 700; font-size: 13px;
    border-radius: 10px; transition: all .3s;
    box-shadow: 0 4px 14px rgba(229,184,74,.25);
  }
  .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(229,184,74,.4); }

  @media (max-width: 900px) {
    .bio-content-grid { grid-template-columns: 1fr; }
    .bio-sidebar { order: -1; }
  }
  @media (max-width: 600px) {
    #bio-hero { padding: 110px 0 48px; }
    .bio-header { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  }
</style>
