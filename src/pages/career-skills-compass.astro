  function skillLayer(title,description,skills,role) { return `<section class="skill-layer" data-inventory-layer-section="${escapeHtml(title)}"><div class="skill-layer-head"><h4>${escapeHtml(title)}</h4><p>${escapeHtml(description)} · ${skills.length} skills</p></div><div class="skill-cards">${skills.map((name)=>{const g=skillGuidance(name,title,role);return `<article class="skill-card" data-inventory-skill data-skill-name="${escapeHtml(name)}" data-skill-layer="${escapeHtml(title)}" data-evidence-state="unassessed"><div class="skill-card-title"><h5>${escapeHtml(name)}</h5><label><span>Where I am now</span><select data-skill-evidence aria-label="Current skill status for ${escapeHtml(name)}"><option value="unassessed">Not checked yet</option><option value="learning">I want to learn this</option><option value="practising">I’m practising this</option><option value="ready">I can show a real example</option></select></label></div><dl><dt>Why it matters</dt><dd>${escapeHtml(g.why)}</dd><dt>How to practise</dt><dd>${escapeHtml(g.practice)}</dd><dt>What you could show</dt><dd>${escapeHtml(g.proof)}</dd></dl></article>`}).join('')}</div></section>`; }
  function priorityRunway(role,stage) {
    const stageFoundation = { school:'Learning agility', college:'Critical thinking', fresher:'Clear communication', early:'Learning agility', mid:'Self-awareness', senior:'Digital, data and AI literacy', returner:'Self-awareness', switcher:'Career and financial agency', independent:'Career and financial agency' };
    const used = new Set();
    const pick = (candidates) => { const name=candidates.flat().find((item)=>item && !used.has(item)); if(name) used.add(name); return name; };
    const phases = [
      { phase:'Start now', time:'Use in the 30-day experiment', skills:[pick([stageFoundation[stage]]),pick(role.skills.roleSpecific)] },
      { phase:'Build next', time:'Add after one real attempt', skills:[pick(role.skills.transferable),pick([role.ai.prepare,role.skills.aiDigital])] },
      { phase:'Deepen later', time:'Invest after the path earns confidence', skills:[pick(role.skills.roleSpecific),pick([role.skills.aiDigital,role.ai.prepare.slice(1),role.skills.transferable.slice(1),role.skills.roleSpecific.slice(2)])] },
    ];
    return `<div class="priority-runway">${phases.map((group,index)=>`<section><header><span>0${index+1}</span><div><h4>${escapeHtml(group.phase)}</h4><p>${escapeHtml(group.time)}</p></div></header>${group.skills.map((name)=>{const layer=data.foundationSkills.some((skill)=>skill.name===name)?'Foundation':role.skills.aiDigital.includes(name)||role.ai.prepare.includes(name)?'AI & digital fluency':'Role craft';const guidance=skillGuidance(name,layer,role);return `<article><h5>${escapeHtml(name)}</h5><p>${escapeHtml(guidance.practice)}</p><small><b>Evidence:</b> ${escapeHtml(guidance.proof)}</small></article>`}).join('')}</section>`).join('')}</div>`;
  }
