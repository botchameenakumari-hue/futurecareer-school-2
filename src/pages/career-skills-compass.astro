    const namedIn=(skill,sourceText)=>{ const sourceWords=new Set(sourceText.split(' ')); const phrase=normalise(skill); if(sourceText.includes(phrase))return true; const words=phrase.split(' ').filter((word)=>word.length>3&&!ignored.has(word)); return words.length>0 && words.filter((word)=>sourceWords.has(word)).length>=Math.max(1,Math.ceil(words.length*.67)); };
    const frequencies=roleSkills.map((skill)=>({skill,count:normalisedAds.filter((ad)=>namedIn(skill,ad)).length})).filter((item)=>item.count).sort((a,b)=>b.count-a.count || a.skill.localeCompare(b.skill));
    const matched=frequencies.map((item)=>item.skill); const important=[...new Set([...role.skills.roleSpecific.slice(0,4),...role.skills.transferable.slice(0,3),...role.skills.aiDigital.slice(0,3)])]; const missing=important.filter((skill)=>!matched.includes(skill));
    const conditionDefinitions=[[/\bhybrid\b|\bremote\b|on[- ]?site/,'Location model stated'],[/\btravel\b|site visits?/,'Travel / site movement'],[/\bshift\b|\bweekends?\b|\bnight\b/,'Shift or out-of-hours work'],[/on[- ]?call|pager duty/,'On-call responsibility'],[/\btargets?\b|\bquota\b|\bcommission\b/,'Targets or variable pressure'],[/licen[cs]e|certification|registration/,'Credential requirement'],[/\b\d{1,2}\+?\s*(years|yrs)\b/,'Experience threshold']];
    const conditionFrequencies=conditionDefinitions.map(([pattern,label])=>({label,count:normalisedAds.filter((ad)=>pattern.test(ad)).length})).filter((item)=>item.count); const conditions=conditionFrequencies.map((item)=>sampleCount>1?`${item.label} · ${item.count}/${sampleCount} ads`:item.label);
    const chips=(items,empty)=>items.length?items.slice(0,10).map((item)=>`<span>${escapeHtml(item)}</span>`).join(''):`<p>${escapeHtml(empty)}</p>`;
