<script>
  const dataElement = document.getElementById('compass-data');
  const data = JSON.parse(dataElement?.textContent || '{}');
  const roles = data.roles || [];
  const byId = new Map(roles.map((role) => [role.id, role]));
  const $ = (selector, root=document) => root.querySelector(selector);
  const $$ = (selector, root=document) => [...root.querySelectorAll(selector)];
  const escapeHtml = (value='') => String(value).replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const profile = { stage:'', goal:'', interests:[], values:[], modes:[], access:'', pace:'', constraints:[] };
  let currentStep = 1;
  let matchPage = 1;
  let plannerHours = 5;
  let plannerStage = '';
  let activePlannerRole = '';
  let returnRoleScroll = 0;
  let lastRanked = [];
  let browsePage = 1;
  let skillPage = 1;
  let careerChangePage = 1;
  const staticPages = { future:1, evidence:1, practice:1 };
  let activeSkillInterest = 'all';
  let activeSkillSprint = null;
  let skillSprintStage = '';
  let skillSprintMinutes = 30;
  let skillSprintPace = 'steady';
  let skillSprintLevel = 'new';
  const selectedSkills = new Set();
  const selectedExperienceThemes = new Set();
  const experienceThemeMatchers = {
    organise:['planning','organis','coordination','process improvement','systems thinking','prioritisation'],
    people:['empathy','communication','facilitation','collaboration','coaching','stakeholder','customer','listening'],
    solve:['problem','systems thinking','critical thinking','decision','risk','diagnosis','question framing'],
    communicate:['writing','storytelling','presentation','editorial','information organisation','research and synthesis'],
    analyse:['research','quantitative','analysis','evidence','experimental','data storytelling','question framing'],
    lead:['leadership','coaching','collaboration','ownership','service','stakeholder','conflict resolution','facilitation'],
  };
  const experienceThemeLabels = {
    organise:'Organise and improve work',people:'Work with people',solve:'Understand and solve problems',communicate:'Explain and create',analyse:'Research and analyse',lead:'Lead, deliver or support others',
  };
  const experimentRatings = new Map();
  const experimentCriteria = [
    ['energy','Energy after ordinary tasks'],['improvement','Ability improved with feedback'],['routine','Interest in the routine work'],['access','Entry route feels feasible'],['life','Fits time, money and wellbeing'],['leverage','Human strength worth deepening'],
  ];
  const pinned = new Set();
  const paceOrder = { 'sample-now':0, months:1, years:2 };
  const cardsPerPage = 9;

  function renderPagination(holderId,total,page,onChange) {
    const holder=$(holderId); if(!holder)return;
    const pages=Math.ceil(total/cardsPerPage);
    holder.hidden=pages<=1;
    if(pages<=1){holder.innerHTML='';return;}
    const numbers=[...new Set([1,2,page-1,page,page+1,pages-1,pages].filter((value)=>value>=1&&value<=pages))].sort((a,b)=>a-b);
    const items=[]; items.push(`<button type="button" data-page="${page-1}" aria-label="Previous page" ${page===1?'disabled':''}>←</button>`);
    numbers.forEach((value,index)=>{ if(index&&value-numbers[index-1]>1)items.push('<span aria-hidden="true">…</span>'); items.push(`<button type="button" data-page="${value}" ${value===page?'aria-current="page"':''} aria-label="Page ${value}">${value}</button>`); });
    items.push(`<button type="button" data-page="${page+1}" aria-label="Next page" ${page===pages?'disabled':''}>→</button>`);
    holder.innerHTML=items.join('');
    $$('[data-page]',holder).forEach((button)=>button.addEventListener('click',()=>{onChange(Number(button.dataset.page));requestAnimationFrame(()=>holder.querySelector('[aria-current="page"]')?.focus({preventScroll:true}));}));
  }
  function pageRange(page){const start=(page-1)*cardsPerPage;return [start,start+cardsPerPage];}

  function setSingle(group, value) {
    profile[group] = value;
    $$(`[data-group="${group}"]`).forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.value === value)));
    if(group==='stage')showStageGuidance(value);
    updateStepState();
  }
  function toggleMulti(button) {
    const group = button.dataset.group;
    const list = profile[group];
    const value = button.dataset.value;
    const index = list.indexOf(value);
    if (index >= 0) list.splice(index,1);
    else if (list.length < Number(button.dataset.max || 3)) list.push(value);
    else { const note = $(`[data-note="${group}"]`); note?.classList.add('error'); if(note) note.textContent = `Choose up to ${button.dataset.max}`; return; }
    button.setAttribute('aria-pressed', String(index < 0));
    const note = $(`[data-note="${group}"]`); note?.classList.remove('error'); if(note) note.textContent = `${list.length} selected`;
    updateStepState();
  }
  function validStep(step) { return [null,profile.stage,profile.goal,profile.interests.length,profile.values.length,profile.modes.length,profile.access && profile.pace][step]; }
  function updateStepState() {
    $('#next-step').disabled = !validStep(currentStep);
    $('#show-matches').disabled = !validStep(6);
  }
  function goStep(step, moveFocus=true) {
    currentStep = Math.max(1,Math.min(6,step));
    $$('.match-step').forEach((item) => item.classList.toggle('active', Number(item.dataset.step)===currentStep));
    $$('.rail-step').forEach((button,index) => { const active=index+1===currentStep; button.classList.toggle('active',active); button.classList.toggle('done',index+1<currentStep); button.disabled = index+1>currentStep && !validStep(index); if(active) button.setAttribute('aria-current','step'); else button.removeAttribute('aria-current'); });
    $('#back-step').hidden = currentStep===1;
    $('#next-step').hidden = currentStep===6;
    $('#show-matches').hidden = currentStep!==6;
    updateStepState();
    if(moveFocus){ const active=$(`.match-step[data-step="${currentStep}"]`); if(active){ active.tabIndex=-1; active.focus({preventScroll:true}); } }
  }
  function followIntent(link,event){
    event?.preventDefault(); const intent=link.dataset.routeIntent; const plans={
      match:{target:'#match',focus:'#match-title',message:'Route selected: make six preference choices, inspect the reasons behind the top three, then test one ordinary task.'},
      vacancy:{target:'#explore',focus:'#career-search',message:'Route selected: search a career, open its complete map, compare real vacancies and check the entry route before applying.'},
