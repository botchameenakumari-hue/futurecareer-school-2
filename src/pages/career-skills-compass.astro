  function skillGuidance(name,layer,role) {
    const foundation = data.foundationSkills.find((skill)=>skill.name===name);
    if(foundation) return { why:foundation.why, practice:foundation.practice, proof:'Keep the output, feedback received and the specific change you made.' };
    const digital = layer==='AI & digital fluency';
    const why = digital ? `Helps you use modern tools in ${role.title} without outsourcing judgment, safety or accountability.` : layer==='Role craft' ? `This is a direct capability used to produce reliable ${role.title} outcomes.` : `Transfers into the communication, decisions and collaboration that make ${role.title} work effective.`;
    const practice = digital ? `Use ${name.toLowerCase()} on one bounded task; verify accuracy, privacy, bias, cost and failure cases.` : `Choose a small real task requiring ${name.toLowerCase()}, attempt it, request task-specific feedback and repeat.`;
    const proof = digital ? `A before/after artifact with validation notes, limitations and human checkpoints.` : `A work sample showing context, your decisions, result, feedback and revision.`;
    return {why,practice,proof};
  }
  function skillInventory(role) {
    const layers=[['Foundation',data.foundationSkills.length],['Transferable',role.skills.transferable.length],['Role craft',role.skills.roleSpecific.length],['AI & digital fluency',role.skills.aiDigital.length]];
