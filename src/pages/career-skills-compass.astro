---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { careerRoles, foundationSkills, interestLabels, modeLabels, stageLabels, valueLabels } from '../data/careerSkillsCompass';
import { accessLabels, careerGoals, getCareerMeta, paceLabels, stagePlaybook } from '../data/careerCompassEnrichment';
import { aiStagePlaybook, futureCareerRoles, futureCareerMeta, futureEvidence, practitionerSignals, getAITransition } from '../data/futureCareerProfiles';

const description = 'A free career and skills exploration system for students, freshers, professionals, career changers, returners and independent workers. Compare realistic work, entry routes and complete skill stacks.';
const routeConfig = {
  hub: { label:'Career & Skills Compass', title:'Career & Skills Compass — Find Work and Skills That Fit | Future Career School', eyebrow:'Choose one useful next step', heading:'What would be most useful today?', description:'Choose one focused route. You can return to the Compass whenever your question changes.' },
  direction: { label:'Find career direction', title:'Find Career Direction | Future Career School', eyebrow:'Focused route', heading:'Find career direction', description:'Answer six practical questions, then investigate the career maps that best fit your answers.' },
  careers: { label:'Explore careers', title:'Explore Career Maps | Future Career School', eyebrow:'Focused route', heading:'Explore careers', description:'Search the complete career library by title, work, skills, route or work conditions.' },
  transition: { label:'Change direction', title:'Change Career Direction | Future Career School', eyebrow:'Focused route', heading:'Use what you have already done', description:'Start with real experience, see connected careers, and identify only the gaps worth building.' },
  skills: { label:'Build skills', title:'Build Skills for Career Growth | Future Career School', eyebrow:'Focused route', heading:'Build skills at your own pace', description:'Choose your stage, strengthen foundations, practise a transferable skill, and use AI wisely in your next chapter.' },
  method: { label:'How this guide works', title:'How the Career & Skills Compass Works | Future Career School', eyebrow:'Background and research', heading:'How this guide works', description:'The research, practical boundaries and real-world signals behind the Compass are available here when you want them.' },
} as const;
const requestedRoute = Astro.props.route;
const route = requestedRoute && requestedRoute in routeConfig ? requestedRoute as keyof typeof routeConfig : 'hub';
const isHub = route === 'hub';
const title = routeConfig[route].title;
const allCareerRoles = [...futureCareerRoles, ...careerRoles];
const clusters = [...new Set(allCareerRoles.map((role) => role.cluster))];
const enrichedRoles = allCareerRoles.map((role) => ({ ...role, meta: futureCareerMeta[role.id] ?? getCareerMeta(role), ai: getAITransition(role) }));
const transferableSkillIndex = [...enrichedRoles.reduce((index,role) => {
  role.skills.transferable.forEach((name) => {
    const item = index.get(name) ?? { name, roles: [], clusters: new Set<string>(), interests: new Set<string>() };
    item.roles.push({ id:role.id, title:role.title }); role.interests.forEach((value) => item.interests.add(value)); item.clusters.add(role.cluster); index.set(name,item);
  }); return index;
},new Map<string,{name:string;roles:{id:string;title:string}[];clusters:Set<string>;interests:Set<string>}>()).values()].map((item) => ({ ...item, clusters:[...item.clusters], interests:[...item.interests], count:item.roles.length })).sort((a,b) => b.count-a.count || a.name.localeCompare(b.name));
const careerChangeStartingSkills = ['Communication','Planning','Problem solving','Writing','Teaching','Customer service','Teamwork','Research','Decision making','Project coordination','Stakeholder communication','Process improvement'];
const careerChangeSkillIndex = [...transferableSkillIndex].sort((a,b) => {
  const aPriority=careerChangeStartingSkills.indexOf(a.name); const bPriority=careerChangeStartingSkills.indexOf(b.name);
  const aRank=aPriority<0?Number.MAX_SAFE_INTEGER:aPriority; const bRank=bPriority<0?Number.MAX_SAFE_INTEGER:bPriority;
  return aRank-bRank || b.count-a.count || a.name.localeCompare(b.name);
});
const constraintLabels = { 'long-study':'Long study or licensing', 'field-travel':'Regular field work or travel', 'unpredictable-hours':'On-call, shifts or urgent interruptions', 'sales-targets':'Sales or revenue targets', 'emotional-load':'High emotional load', 'screen-heavy':'Mostly screen-based work' };
const clientData = { roles: enrichedRoles, foundationSkills, transferableSkillIndex, interestLabels, modeLabels, stageLabels, valueLabels, accessLabels, paceLabels, careerGoals, stagePlaybook, futureEvidence, constraintLabels };
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Career & Skills Compass', applicationCategory: 'EducationalApplication', operatingSystem: 'Any', description,
  url: 'https://futurecareerschool.com/career-skills-compass', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  provider: { '@type': 'Organization', name: 'Future Career School', url: 'https://futurecareerschool.com' },
};
---

<BaseLayout {title} {description} {jsonLd}>
  <Nav activePage="compass" />
  <main class="compass-page" data-compass-route={route}>
    <section class="compass-hero" aria-labelledby="page-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div>
          <p class="eyebrow"><span></span> Free · private · no sign-up</p>
          <h1 id="page-title">Find work that fits your life.<br /><em>Build every skill it takes.</em></h1>
          <p class="hero-lede">For school students, graduates, experienced professionals, returners and people changing direction. Start with the work you want to do and the life you need—not a fashionable title.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/career-skills-compass/direction">Find career direction <span aria-hidden="true">→</span></a>
            <a class="button button-ghost" href="/career-skills-compass/careers">Explore {allCareerRoles.length} career maps</a>
          </div>
          <ul class="hero-proof" aria-label="What this tool provides">
            <li><b>6</b><span>fit dimensions</span></li><li><b>4</b><span>skill layers per role</span></li><li><b>{futureCareerRoles.length}</b><span>emerging role maps</span></li>
          </ul>
        </div>
        <aside class="fit-model" aria-label="How career fit is considered">
          <p>Career fit model</p>
          <div class="model-centre"><strong>YOU</strong><span>fit evolves</span></div>
          <ol>
            <li><span>01</span><b>Stage & goal</b><small>What decision is useful now?</small></li>
            <li><span>02</span><b>Activities</b><small>What work pulls you in?</small></li>
            <li><span>03</span><b>Values</b><small>What must work provide?</small></li>
            <li><span>04</span><b>Environment</b><small>Where do you function well?</small></li>
            <li><span>05</span><b>Access</b><small>What route is feasible?</small></li>
            <li><span>06</span><b>Reality</b><small>What costs can you accept?</small></li>
          </ol>
        </aside>
      </div>
    </section>

    <nav class="jump-nav" aria-label="Career and skills routes"><div class="container"><a href="/career-skills-compass">Compass home</a><a href="/career-skills-compass/direction" aria-current={route==='direction'?'page':undefined}>Find direction</a><a href="/career-skills-compass/careers" aria-current={route==='careers'?'page':undefined}>Explore careers</a><a href="/career-skills-compass/transition" aria-current={route==='transition'?'page':undefined}>Change direction</a><a href="/career-skills-compass/skills" aria-current={route==='skills'?'page':undefined}>Build skills</a></div></nav>

    {!isHub && <section class="route-page-banner" aria-labelledby="route-page-title"><div class="container"><a href="/career-skills-compass">← Career &amp; Skills Compass</a><p>{routeConfig[route].eyebrow}</p><h1 id="route-page-title">{routeConfig[route].heading}</h1><span>{routeConfig[route].description}</span></div></section>}

    <section class="route-picker" id="choose-route" aria-labelledby="route-picker-title">
      <div class="container">
        <header class="route-picker-head"><div><p class="kicker">One Compass · four useful routes</p><h2 id="route-picker-title">What are you trying to do today?</h2></div><p>Choose one route. The next page will show only the tools for that decision, in a clear order—you do not need to scroll through every part of the Compass.</p></header>
        <div class="route-card-grid">
          <a href="/career-skills-compass/direction"><span>01 · Find direction</span><h3>I need career ideas that fit me.</h3><p>Answer six questions about the work, values, setting and practical routes that suit you.</p><b>Get: career suggestions with clear reasons →</b></a>
          <a href="/career-skills-compass/careers"><span>02 · Explore a career</span><h3>I have a role or vacancy in mind.</h3><p>Search one complete library, then open a role’s skills, work conditions and entry route.</p><b>Get: practical career maps and next steps →</b></a>
          <a href="/career-skills-compass/transition"><span>03 · Change direction</span><h3>I want to use experience I already have.</h3><p>Choose familiar kinds of work from work, study, care, volunteering or projects.</p><b>Get: connected careers and only the gaps to build →</b></a>
          <a href="/career-skills-compass/skills"><span>04 · Build skills</span><h3>I want to grow at my own pace.</h3><p>Choose your stage, strengthen foundations and make a flexible practice plan for one useful skill.</p><b>Get: a realistic practice route and proof to create →</b></a>
        </div>
        <div class="route-status"><b>Not sure?</b><span>Start with “I need career ideas.” You can inspect roles and skills without completing every route. <a href="/career-skills-compass/method">How this guide uses research and real-world signals →</a></span></div>
      </div>
    </section>

    {isHub && <section class="universal-foundations" id="universal-foundations" aria-labelledby="universal-foundations-title"><div class="container"><header class="section-heading"><p class="kicker">Useful at every career stage</p><h2 id="universal-foundations-title">Eight foundations for work, growth and a thriving life.</h2><p>These are not prerequisites or a checklist to finish. They are the common capabilities that help people learn, choose, work with others and adapt—whether they are at school, returning to work, leading others or changing direction.</p></header><div class="universal-foundation-grid">{foundationSkills.map((skill,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{skill.name}</h3><p>{skill.why}</p><div><b>A simple place to start</b><small>{skill.practice}</small></div></article>)}</div><footer><div><b>Start with one foundation, not all eight.</b><span>Pick the one that would make the biggest difference to your work or life right now. The Build Skills route turns it into a practice plan at a pace you choose.</span></div><a class="button button-dark" href="/career-skills-compass/skills">Build one foundation at my pace →</a></footer></div></section>}

    <section class="match-section" id="match" aria-labelledby="match-title">
      <div class="container narrow-container">
        <header class="section-heading centred"><p class="kicker">Find my direction</p><h2 id="match-title">Six short choices. A practical shortlist.</h2><p>No test can name your one perfect career. These questions suggest options worth exploring and explain why they may suit you.</p></header>
        <div class="matcher">
          <div class="step-rail" aria-label="Profile progress">
            {['Stage','Goal','Activities','Values','Setting','Access'].map((label,index) => <button type="button" class:list={['rail-step',{active:index===0}]} data-go-step={index+1} disabled={index>0}><span>{index+1}</span><em>{label}</em></button>)}
          </div>
          <form id="fit-form" autocomplete="off">
            <fieldset class="match-step active" data-step="1"><legend>Where are you right now?</legend><p class="step-help">This changes the route and next action—not which careers you are allowed to consider.</p><div class="choice-grid stage-grid">
              {Object.entries(stageLabels).map(([value,label]) => <button type="button" class="choice-card single-choice" data-group="stage" data-value={value} aria-pressed="false"><strong>{label}</strong><small>{stagePlaybook[value].question}</small></button>)}
            </div></fieldset>
            <fieldset class="match-step" data-step="2"><legend>What decision are you trying to make?</legend><p class="step-help">Choose the job your compass needs to do today.</p><div class="choice-grid two-grid">
              {Object.entries(careerGoals).map(([value,item]) => <button type="button" class="choice-card single-choice" data-group="goal" data-value={value} aria-pressed="false"><strong>{item.label}</strong><small>{item.hint}</small></button>)}
            </div></fieldset>
            <fieldset class="match-step" data-step="3"><legend>Which kinds of activity pull you in?</legend><p class="step-help">Choose one to three. Think about the work itself, not your marks or current title.</p><div class="choice-grid two-grid">
              {Object.entries(interestLabels).map(([value,item]) => <button type="button" class="choice-card multi-choice" data-group="interests" data-value={value} data-max="3" aria-pressed="false"><i aria-hidden="true">✓</i><strong>{item.label}</strong><small>{item.hint}</small></button>)}
            </div><p class="selection-note" data-note="interests">Choose 1–3 activities</p></fieldset>
            <fieldset class="match-step" data-step="4"><legend>What must this chapter of work give you?</legend><p class="step-help">Choose one to three. Income, rest and stability are legitimate needs—not lesser values.</p><div class="chip-grid">
              {Object.entries(valueLabels).map(([value,label]) => <button type="button" class="option-chip multi-choice" data-group="values" data-value={value} data-max="3" aria-pressed="false">{label}</button>)}
            </div><p class="selection-note" data-note="values">Choose 1–3 priorities</p></fieldset>
            <fieldset class="match-step" data-step="5"><legend>Which conditions help you do good work?</legend><p class="step-help">Choose one to four. A suitable occupation in an unsuitable workplace can still be a poor fit.</p><div class="chip-grid">
              {Object.entries(modeLabels).map(([value,label]) => <button type="button" class="option-chip multi-choice" data-group="modes" data-value={value} data-max="4" aria-pressed="false">{label}</button>)}
            </div><p class="selection-note" data-note="modes">Choose 1–4 conditions</p></fieldset>
            <fieldset class="match-step" data-step="6"><legend>What route is feasible for you now?</legend><p class="step-help">Choose one preferred access route and how quickly you need to test the work. Filters can be changed later.</p>
              <div class="access-block"><h3>Preferred route</h3><div class="chip-grid">{Object.entries(accessLabels).map(([value,label]) => <button type="button" class="option-chip single-choice" data-group="access" data-value={value} aria-pressed="false">{label}</button>)}</div></div>
              <div class="access-block"><h3>Time horizon</h3><div class="chip-grid">{Object.entries(paceLabels).map(([value,label]) => <button type="button" class="option-chip single-choice" data-group="pace" data-value={value} aria-pressed="false">{label}</button>)}</div></div>
              <div class="access-block"><h3>Optional deal-breakers</h3><p class="step-help">Choose up to three conditions you cannot accept right now. A conflict may mean you need a different route or workplace; it does not measure your ability or long-term potential.</p><div class="chip-grid">{Object.entries(constraintLabels).map(([value,label]) => <button type="button" class="option-chip multi-choice" data-group="constraints" data-value={value} data-max="3" aria-pressed="false">{label}</button>)}</div><p class="selection-note" data-note="constraints">Optional · choose up to 3</p></div>
            </fieldset>
            <div class="form-actions"><button class="text-button" id="back-step" type="button" hidden>← Back</button><button class="button button-dark" id="next-step" type="button" disabled>Continue →</button><button class="button button-primary" id="show-matches" type="button" hidden disabled>Show my matches →</button></div>
          </form>
        </div>
      </div>
    </section>

    <section class="results-section" id="results" aria-live="polite" hidden>
      <div class="container">
        <header class="results-header"><div><p class="kicker">Based on your answers</p><h2>Career suggestions worth exploring</h2><p id="result-summary"></p></div><div class="results-actions"><button type="button" class="button button-dark" id="compare-shortlist">Compare top 3</button><button type="button" class="button button-light" id="copy-shortlist">Copy top 3</button><button type="button" class="button button-light" id="edit-profile">Edit answers</button><span id="shortlist-status" aria-live="polite"></span></div></header>
        <div class="profile-summary" id="profile-summary"></div>
        <section class="decision-brief" id="decision-brief" aria-labelledby="decision-brief-title"><div class="decision-brief-lead"><p>Your decision brief</p><h3 id="decision-brief-title">What matters at this stage</h3></div><div><span>Useful question</span><p data-brief-question></p></div><div><span>Use</span><p data-brief-use></p></div><div><span>Avoid</span><p data-brief-avoid></p></div><div><span>First move</span><p data-brief-action></p></div></section>
        <section class="shortlist-stress" data-shortlist-stress hidden aria-labelledby="shortlist-stress-title"><header><div><span>Check how stable your shortlist is</span><h3 id="shortlist-stress-title">Would changing one answer change your career suggestions?</h3></div><p>We temporarily remove one of your selected preferences at a time and compare the results. This helps you see which suggestions are steady and which depend heavily on one answer. It is not a prediction or career verdict.</p></header><div class="stress-summary"><div><span>Suggestions that stayed</span><b data-stable-count></b><p data-stable-roles></p></div><div><span>Answers checked</span><b data-scenario-count></b><p>Your career stage, goal, available route and time stay the same.</p></div><div><span>Biggest change</span><b data-largest-move></b><p data-largest-move-note></p></div></div><div class="stress-cases" data-stress-cases></div><footer><span data-stress-status>Private: your answers and results are not saved or sent.</span><button type="button" data-copy-sensitivity>Copy this stability check</button></footer></section>
        <div class="interpret-note"><strong>Look at fit and feasibility separately.</strong><span><b>Work fit</b> reflects the activities, values and setting you prefer. <b>How ready you are to start</b> reflects your current stage, available route and time. A lower score here can mean “build a bridge first,” not “this career is wrong for you.”</span></div>
        <div class="career-grid results-grid" id="match-grid">
          {enrichedRoles.map((role) => <article class="career-card result-card" data-role-id={role.id} hidden>
            <div class="card-top"><span>{role.cluster}</span><strong class="match-score"><b data-score>0</b><small>% fit guide</small></strong></div>
            <h3>{role.title}</h3><p>{role.summary}</p><div class="result-ai-shift"><span>{role.ai.position}</span><b>{role.ai.exposure}</b><p><strong>Where people add value:</strong> {role.ai.humanLeverage}</p></div><div class="decision-signals"><div><span>Work fit</span><b data-work-fit>0%</b><i><em data-work-bar></em></i></div><div><span>Ready to start</span><b data-readiness>0%</b><i><em data-readiness-bar></em></i></div></div><div class="reason-list" data-reasons></div><div class="gap-list" data-gaps></div><div class="carry-signal" data-carry-signal hidden></div><div class="friction-preview"><b>Check carefully</b><span data-friction>{role.meta.friction[0]}</span></div>
            <div class="snapshot"><span><b>{paceLabels[role.meta.pace]}</b><small>entry horizon</small></span><span><b>{role.meta.taskMix[0]}</b><small>typical work</small></span></div>
            <div class="card-actions"><button type="button" class="open-role" data-open={role.id} aria-label={`View ${role.title} career and skill map`}>View career + skill map →</button><button type="button" class="pin-role" data-compare={role.id} aria-pressed="false" aria-label={`Pin ${role.title} for comparison`}>Pin to compare</button></div>
          </article>)}
        </div>
        <nav class="card-pagination" id="match-pagination" aria-label="Career suggestion pages"></nav>
      </div>
    </section>

    <section class="explore-section" id="explore" aria-labelledby="explore-title">
      <div class="container">
        <header class="section-heading split-heading"><div><p class="kicker">One complete career library</p><h2 id="explore-title">Browse the work, not the hype.</h2><p>Search by title, skill, task or industry. This single library includes emerging AI-era roles alongside established careers; use the future-position filter when that is useful.</p></div><div class="browse-count"><strong id="browse-count">{allCareerRoles.length}</strong><span>career maps shown</span></div></header>
        <div class="browse-layout">
          <aside class="filter-panel" aria-label="Career filters">
            <div class="filter-title"><h3>Filters</h3><button type="button" id="clear-filters">Clear all</button></div>
            <details open><summary>Career family</summary><div class="filter-options">{clusters.map((cluster) => <label><input class="browse-filter" type="checkbox" data-filter="cluster" value={cluster} /><span>{cluster}</span></label>)}</div></details>
            <details open><summary>Future position</summary><div class="filter-options">{['AI-native','AI-reinvented','Human-centred + AI','Physical-world + AI'].map((value) => <label><input class="browse-filter" type="checkbox" data-filter="position" value={value} /><span>{value}</span></label>)}</div></details>
            <details><summary>AI task change</summary><div class="filter-options">{['High task change','Moderate task change','Lower direct automation'].map((value) => <label><input class="browse-filter" type="checkbox" data-filter="exposure" value={value} /><span>{value}</span></label>)}</div></details>
            <details><summary>Useful at my stage</summary><div class="filter-options">{Object.entries(stageLabels).map(([value,label]) => <label><input class="browse-filter" type="checkbox" data-filter="stage" value={value} /><span>{label}</span></label>)}</div></details>
            <details><summary>Activities</summary><div class="filter-options">{Object.entries(interestLabels).map(([value,item]) => <label><input class="browse-filter" type="checkbox" data-filter="interests" value={value} /><span>{item.label}</span></label>)}</div></details>
            <details><summary>Work setting</summary><div class="filter-options">{Object.entries(modeLabels).map(([value,label]) => <label><input class="browse-filter" type="checkbox" data-filter="modes" value={value} /><span>{label}</span></label>)}</div></details>
            <details><summary>Access route</summary><div class="filter-options">{Object.entries(accessLabels).map(([value,label]) => <label><input class="browse-filter" type="checkbox" data-filter="access" value={value} /><span>{label}</span></label>)}</div></details>
            <details><summary>Time to credible entry</summary><div class="filter-options">{Object.entries(paceLabels).map(([value,label]) => <label><input class="browse-filter" type="checkbox" data-filter="pace" value={value} /><span>{label}</span></label>)}</div></details>
            <details><summary>Learning commitment</summary><div class="filter-options">{['low','medium','high'].map((value) => <label><input class="browse-filter" type="checkbox" data-filter="commitment" value={value} /><span>{value[0].toUpperCase()+value.slice(1)}</span></label>)}</div></details>
          </aside>
          <div class="browse-main">
            <div class="browse-tools"><label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search careers</span><input id="career-search" type="search" placeholder="Search ‘AI governance’, ‘robotics’, ‘health’, ‘field’, ‘teaching’…" /></label><label class="sort-field"><span>Sort</span><select id="career-sort"><option value="recommended">Recommended order</option><option value="future">Emerging first</option><option value="change">Fastest AI change</option><option value="name">Name A–Z</option><option value="fastest">Fastest to sample</option><option value="skills">Most skills mapped</option></select></label></div>
            <div class="active-filters" id="active-filters" aria-live="polite"></div>
            <div class="career-grid browse-grid" id="browse-grid">
              {enrichedRoles.map((role) => <article class="career-card browse-card" data-role-id={role.id} data-ai-position={role.ai.position} data-ai-exposure={role.ai.exposure}>
                <div class="card-top"><span>{role.cluster}</span><span class:list={['ai-pill',role.ai.position==='AI-native'&&'ai-native']}>{role.ai.position}</span></div>
                <h3>{role.title}</h3><p>{role.summary}</p>
                <dl class="quick-facts"><div><dt>Entry horizon</dt><dd>{paceLabels[role.meta.pace]}</dd></div><div><dt>Common route</dt><dd>{accessLabels[role.meta.access[0]]}</dd></div></dl>
                <div class="task-preview"><b>Ordinary work includes</b><ul>{role.meta.taskMix.slice(0,3).map((task) => <li>{task}</li>)}</ul></div>
                <div class="ai-card-preview"><div><b>AI absorbs</b><p>{role.ai.delegates}</p></div><div><b>Human leverage</b><p>{role.ai.humanLeverage}</p></div></div>
                <div class="skill-strip">{role.skills.transferable.slice(0,2).map((skill) => <span>{skill}</span>)}<span>+ {foundationSkills.length + role.skills.transferable.length + role.skills.roleSpecific.length + role.skills.aiDigital.length - 2} mapped skills</span></div>
                <div class="card-actions"><button type="button" class="open-role" data-open={role.id} aria-label={`View ${role.title} career and skill map`}>View career + skill map →</button><button type="button" class="pin-role" data-compare={role.id} aria-pressed="false" aria-label={`Pin ${role.title} for comparison`}>Pin to compare</button></div>
              </article>)}
            </div><nav class="card-pagination" id="browse-pagination" aria-label="Career explorer pages"></nav>
            <div class="empty-state" id="no-results" hidden><h3>No career maps match every filter.</h3><p>Remove one constraint or use a broader search. A near match can still reveal an adjacent route.</p><button type="button" class="button button-dark" data-clear-filters>Clear filters</button></div>
          </div>
        </div>
      </div>
    </section>

    <section class="career-change-section" id="career-change" aria-labelledby="career-change-title"><div class="container">
      <header class="section-heading split-heading"><div><p class="kicker">Change career without discarding your experience</p><h2 id="career-change-title">Start with the kind of work you have actually done.</h2><p>Choose up to three experience themes from work, study, care, volunteering or projects. This suggests careers worth investigating; it does not declare you qualified or decide what suits you.</p></div><div class="route-boundary"><b>A practical starting point</b><span>Open a career map to check its day-to-day work, entry route and extra skills before investing time or money.</span></div></header>
      <section class="skill-bridge-builder" aria-labelledby="skill-bridge-title"><header><div><p class="kicker">Your existing-experience route</p><h3 id="skill-bridge-title">Find careers connected to the work you have done.</h3></div><p>Start broad. You can add a precise skill only when you can describe a real example of using it.</p></header><div class="skill-bridge-explainer" aria-label="How this tool works"><div><span>1</span><p>Choose an experience theme that sounds like work you have done.</p></div><div><span>2</span><p>See careers where related transferable skills appear.</p></div><div><span>3</span><p>Open a career to check the real work, route and gaps.</p></div></div>
        <div class="experience-theme-grid" aria-label="Choose experience themes"><button id="experience-theme-organise" type="button" data-experience-theme="organise" aria-pressed="false"><b>Organise and improve work</b><span>Planning, coordination, systems or process improvement</span></button><button type="button" data-experience-theme="people" aria-pressed="false"><b>Work with people</b><span>Supporting, teaching, listening, facilitating or influencing</span></button><button type="button" data-experience-theme="solve" aria-pressed="false"><b>Understand and solve problems</b><span>Analysis, diagnosis, decisions, risk or systems thinking</span></button><button type="button" data-experience-theme="communicate" aria-pressed="false"><b>Explain and create</b><span>Writing, presenting, storytelling, research or making ideas clear</span></button><button type="button" data-experience-theme="analyse" aria-pressed="false"><b>Research and analyse</b><span>Finding evidence, working with numbers, testing or synthesising</span></button><button type="button" data-experience-theme="lead" aria-pressed="false"><b>Lead, deliver or support others</b><span>Coaching, collaboration, ownership, service or stakeholder work</span></button></div>
        <details class="precision-skill-search"><summary>Or search for one specific transferable skill</summary><div class="career-change-picker"><label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search skills you already use</span><input id="career-change-search" type="search" placeholder="Search ‘writing’, ‘planning’, ‘systems’ or ‘teaching’…" /></label><p id="career-change-options-status">Search across all {careerChangeSkillIndex.length} transferable skills.</p><div class="career-change-options" id="career-change-options">{careerChangeSkillIndex.map((skill) => { const useLabel=`Used in ${skill.count} ${skill.count===1?'career':'careers'}`; return <button type="button" data-change-skill-option data-skill-name={skill.name.toLowerCase()} data-skill-bridge={skill.name} data-skill-use-label={useLabel} aria-label={`Add ${skill.name} as a skill I have used`} aria-pressed="false" hidden><span>{skill.name}</span><small>{useLabel}</small></button> })}</div><nav class="card-pagination compact-pagination" id="career-change-pagination" aria-label="Specific skill result pages"></nav><div class="skill-index-empty" id="career-change-empty" hidden><h3>No exact skill name found.</h3><p>Try a broader word such as “planning”, “people”, “writing”, “risk” or “research”.</p></div></div></details>
        <div class="skill-bridge-tray"><div><b>Skills I have used</b><div id="skill-bridge-selected"><span>Choose a skill above to begin.</span></div></div><button type="button" id="clear-skill-bridge" hidden>Clear my skills</button></div><p class="skill-bridge-status" id="skill-bridge-status" aria-live="polite">No skills added. Choose only skills you can explain with a real example.</p><div class="skill-bridge-results" id="skill-bridge-results" hidden></div>
      </section>
    </div></section>

    <section class="foundation-section skill-builder-section" id="build-skills" aria-labelledby="foundations-title"><span id="foundations" class="anchor-alias" aria-hidden="true"></span><div class="container foundation-layout"><header class="foundation-intro"><p class="kicker">Build skills for life, work and career change</p><h2 id="foundations-title">Start with eight foundations that support almost every career.</h2><p>These help you learn, decide, communicate, recover and create value across roles. Start with one that would improve your work or life now, then explore transferable skills connected to real careers.</p><a href="#transferable-skills">Browse role-related transferable skills ↓</a></header><div class="foundation-list">
      {foundationSkills.map((skill,index) => <article><span>{String(index+1).padStart(2,'0')}</span><div><h3>{skill.name}</h3><p>{skill.why}</p><details><summary>How to practise and what to keep</summary><p>{skill.practice}</p><p><b>Useful proof:</b> Keep the output, feedback and the change you made after reflection.</p></details><button type="button" class="foundation-sprint-button" data-skill-sprint={skill.name} data-skill-layer="Foundation">Make a flexible practice plan →</button></div></article>)}
    </div></div>

    <div class="skill-pathways-panel" id="transferable-skills" aria-labelledby="skills-title"><span id="skills" class="anchor-alias" aria-hidden="true"></span><div class="container"><header class="section-heading split-heading"><div><p class="kicker">Then choose a transferable skill</p><h2 id="skills-title">Choose one skill that can travel between careers.</h2><p>Search {transferableSkillIndex.length} reusable capabilities or filter by the kind of activity you enjoy. Make a flexible practice plan when you find one worth practising.</p></div><div class="browse-count"><strong id="skill-count">9</strong><span>skills on this page</span></div></header>
      <div class="skill-pathway-controls"><label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search transferable skills</span><input id="skill-search" type="search" placeholder="Search ‘decision’, ‘writing’, ‘systems’, ‘empathy’…" /></label><div class="skill-interest-filter" aria-label="Filter skills by preferred activity"><button type="button" data-skill-interest="all" aria-pressed="true">All activities</button>{Object.entries(interestLabels).map(([value,item]) => <button type="button" data-skill-interest={value} aria-pressed="false">{item.label}</button>)}</div></div>
      <div class="skill-index-grid" id="skill-index-grid">{transferableSkillIndex.map((skill,index) => <article class="transferable-skill-card" data-skill-card data-skill-name={skill.name.toLowerCase()} data-skill-interests={skill.interests.join(' ')} hidden={index>=9}><div class="transferable-skill-top"><span>Useful across careers</span><b>{skill.count} {skill.count===1?'role':'roles'} · {skill.clusters.length} {skill.clusters.length===1?'field':'fields'}</b></div><h3>{skill.name}</h3><p>Practise it on a real task, ask for specific feedback, revise once and keep the before-and-after example.</p><div class="connected-roles"><b>Careers that use it</b>{skill.roles.slice(0,3).map((role) => <button type="button" data-open={role.id} aria-label={`Open ${role.title} career map`}>{role.title}</button>)}</div><div class="skill-card-actions single-action"><button type="button" class="skill-sprint-button" data-skill-sprint={skill.name} data-skill-layer="Transferable" data-skill-role-ids={skill.roles.slice(0,5).map((role)=>role.id).join(' ')}>Make a 14-day practice plan →</button></div></article>)}</div>
      <div class="skill-index-empty" id="skill-index-empty" hidden><h3>No skill uses those exact words.</h3><p>Try a broader word such as “planning”, “people”, “writing”, “risk” or choose another activity.</p></div><nav class="card-pagination" id="skill-pagination" aria-label="Transferable skill pages"></nav>
    </div></div></section>

    <section class="stages-section" id="stages" aria-labelledby="stages-title"><div class="container"><header class="section-heading"><p class="kicker">Personalise your skills route</p><h2 id="stages-title">Choose your stage once. Your next move and AI guidance adapt together.</h2><p>Choose your current stage—not your age. You can explore, return, lead or change direction at any point in life.</p></header><label class="stage-picker"><span>Show guidance for</span><select id="stage-guidance-select">{Object.entries(stageLabels).map(([stage,label]) => <option value={stage}>{label}</option>)}</select></label><div class="stage-playbook">
      {Object.entries(stageLabels).map(([stage,label],index) => { const play = stagePlaybook[stage]; return <article data-stage-guidance={stage} hidden={index!==0}><div class="stage-card-head"><span>{label}</span><button type="button" data-use-stage={stage}>Use this in my questions →</button></div><h3>{play.question}</h3><p><b>Focus on:</b> {play.use}</p><p class="avoid"><b>Try not to:</b> {play.avoid}</p><ol>{play.action.map((action) => <li>{action}</li>)}</ol></article> })}
    </div></div></section>

    <section class="future-radar" id="future-radar" aria-labelledby="future-title">
      <div class="container">
        <header class="section-heading split-heading"><div><p class="kicker">Future & AI · updated July 2026</p><h2 id="future-title">New work growing between familiar job titles.</h2><p>These roles are emerging where organisations need people to redesign work with AI, check system quality, keep automated tools secure, connect robotics with real operations and protect public trust.</p></div><a class="button button-light" href="#latest-evidence">See the newest research ↓</a></header>
        <div class="future-grid">
          {futureCareerRoles.map((futureRole,index) => { const role = enrichedRoles.find((item) => item.id === futureRole.id); return <article class="future-card" data-future-card hidden={index>=9}>
            <div class="future-card-top"><span>{role?.cluster}</span><b>{role?.ai.position}</b></div>
            <h3>{role?.title}</h3><p>{role?.summary}</p>
            <div class="future-why"><b>Why this work is needed now</b><p>{role?.ai.humanLeverage}</p></div>
            <div class="future-skills">{role?.ai.prepare.map((skill) => <span>{skill}</span>)}</div>
            <button type="button" data-open={role?.id} aria-label={`Open ${role?.title} career map`}>See this career + skill map →</button>
          </article> })}
        </div><nav class="card-pagination" id="future-pagination" aria-label="Future career pages"></nav>
        <section class="ai-stage-panel" aria-labelledby="ai-stage-title"><header><p class="kicker">Continue with stage-relevant AI guidance</p><h3 id="ai-stage-title">How to respond to AI at your career stage.</h3><p>Your selected stage above opens the most relevant guidance. You can still inspect another stage whenever it is useful.</p></header><div class="ai-stage-grid">{Object.entries(stageLabels).map(([stage,label]) => { const guide=aiStagePlaybook[stage]; return <details data-ai-stage={stage}><summary><span>{label}</span><b>Open my next steps +</b></summary><div><p class="stage-risk"><strong>Watch:</strong> {guide.risk}</p><p><strong>Your advantage:</strong> {guide.advantage}</p><ol>{guide.moves.map((move)=><li>{move}</li>)}</ol></div></details> })}</div></section>
      </div>
    </section>

    <section class="method-section" id="method" aria-labelledby="method-title"><div class="container"><header class="section-heading centred"><p class="kicker">How this tool works</p><h2 id="method-title">A guide for exploration—not a personality verdict.</h2><p>Your preferences, access and real-life needs are considered separately. Career choice is treated as something you explore, test and learn from over time.</p></header>
      <div class="principle-grid"><article><span>01</span><h3>Match tasks and conditions</h3><p>O*NET distinguishes interests, worker requirements, activities and work context. The tool therefore shows ordinary tasks and environments—not only titles.</p></article><article><span>02</span><h3>Layer reusable skills</h3><p>LifeComp, UNICEF, ILO, OECD, DigComp and ESCO inform the foundation and transferable layers; occupation craft remains separate.</p></article><article><span>03</span><h3>Respect access and decent work</h3><p>Education, licensing, time, safety, adequate income, rest, flexibility and values can constrain fit. Preference alone is insufficient.</p></article><article><span>04</span><h3>Learn through evidence</h3><p>Small projects, work exposure, feedback and reflection turn curiosity into proof. Certificates are not treated as demonstrated competence.</p></article></div>
      <div class="research-ledger"><div><p class="kicker">What the research changed</p><h3>You can see the thinking behind the guidance.</h3></div><ul><li><b>Adapt as your life changes:</b> every career stage includes practical questions and small experiments.</li><li><b>Start with skills:</b> every career includes the skills to build, ways to practise and examples of useful proof.</li><li><b>More than one route:</b> vocational, experience-led, return-to-work and prior-learning routes sit alongside degrees.</li><li><b>Be realistic about AI:</b> changing tasks and the need for human checking are shown without calling any career future-proof.</li><li><b>Learn by doing:</b> planning, practice, feedback and revision are built into each development path.</li><li><b>Test before committing:</b> conversations, workplace exposure and low-risk projects are recommended before a major investment.</li></ul></div>
      <section class="latest-evidence" id="latest-evidence" aria-labelledby="evidence-title"><header><p class="kicker">Recently updated research</p><h3 id="evidence-title">New information that changed this guide.</h3><p>Career information changes, so we show recent sources that led to an update. These sources improve the guidance; they do not guarantee that a field will grow.</p></header><div class="evidence-grid">{futureEvidence.map((item,index) => <a href={item.url} target="_blank" rel="noreferrer" data-evidence-card hidden={index>=9}><span>{item.date}</span><h4>{item.label}</h4><p>{item.source} ↗</p><small><b>What we updated:</b> {item.impact}</small></a>)}</div><nav class="card-pagination" id="evidence-pagination" aria-label="Research source pages"></nav><p class="evidence-policy"><b>How we use videos, blogs and interviews:</b> we use them to understand changing work and hear real examples. We do not make a career claim from one opinion. Important claims must also be supported by labour-market, employer, professional or public evidence.</p></section>
      <section class="practice-window" aria-labelledby="practice-window-title"><header><div><p class="kicker">What people doing the work say</p><h3 id="practice-window-title">Real-world perspectives behind the career maps.</h3></div><p>These conversations show how people describe changing work and hiring. We use them to improve questions, small career tests and ways to show your skills—not to promise demand or claim everyone has the same experience.</p></header><div class="practice-signal-grid">{practitionerSignals.map((item,index) => <a href={item.url} target="_blank" rel="noreferrer" data-practice-card hidden={index>=9}><div class="practice-signal-top"><span>{item.date}</span><em>{item.medium}</em></div><h4>{item.title}</h4><p>{item.source} ↗</p><dl><dt>What we noticed</dt><dd>{item.observed}</dd><dt>How it improved this guide</dt><dd>{item.applied}</dd></dl></a>)}</div><nav class="card-pagination" id="practice-pagination" aria-label="Practitioner perspective pages"></nav></section>
      <details class="sources"><summary>Open research sources and review notes <span>+</span></summary><div class="source-body"><p>Primary frameworks and recent evidence reviewed for this build:</p><div class="source-grid">
        <a href="https://www.onetcenter.org/content.html" target="_blank" rel="noreferrer"><b>O*NET Content Model</b><span>Worker characteristics, requirements, activities and context</span></a>
        <a href="https://esco.ec.europa.eu/en/classification/skill_main" target="_blank" rel="noreferrer"><b>ESCO v1.2.1</b><span>Occupation-skill relationships and transversal hierarchy</span></a>
        <a href="https://joint-research-centre.ec.europa.eu/lifecomp_en" target="_blank" rel="noreferrer"><b>EU LifeComp</b><span>Personal, social and learning-to-learn competences</span></a>
        <a href="https://www.unicef.org/reports/global-framework-transferable-skills" target="_blank" rel="noreferrer"><b>UNICEF transferable skills</b><span>Cognitive, instrumental, individual and social dimensions</span></a>
        <a href="https://www.oecd.org/en/data/tools/oecd-learning-compass-2030.html" target="_blank" rel="noreferrer"><b>OECD Learning Compass</b><span>Agency, wellbeing, knowledge, skills, attitudes and values</span></a>
        <a href="https://www.oecd.org/en/data/dashboards/teenage-career-readiness.html" target="_blank" rel="noreferrer"><b>OECD Career Readiness 2025</b><span>Exploration, employer engagement and work exposure</span></a>
        <a href="https://www.oecd.org/en/publications/education-policy-outlook-2025_c3f402ba-en/full-report/mid-career_bc903efa.html" target="_blank" rel="noreferrer"><b>OECD mid-career learning 2025</b><span>Modular learning, constraints and learner agency</span></a>
        <a href="https://www.ilo.org/publications/generative-ai-and-jobs-2025-update" target="_blank" rel="noreferrer"><b>ILO GenAI and Jobs 2025</b><span>Task transformation, exposure and human judgment</span></a>
        <a href="https://www.ncs.gov.in/content-repository/Pages/Main.aspx" target="_blank" rel="noreferrer"><b>India National Career Service</b><span>Occupation and sector information</span></a>
        <a href="https://www.niit.ai/india/press-release/niit-india-skills-gap-report" target="_blank" rel="noreferrer"><b>NIIT India Skills Gap 2026</b><span>AI, cyber, data and mid-career reskilling</span></a>
        <a href="https://educationendowmentfoundation.org.uk/education-evidence/guidance-reports/metacognition" target="_blank" rel="noreferrer"><b>EEF metacognition 2025</b><span>Planning, monitoring, evaluation and scaffolding</span></a>
        <a href="https://www.gov.uk/government/publications/returner-toolkit-helping-you-back-to-work/returner-toolkit-helping-you-back-to-work" target="_blank" rel="noreferrer"><b>Returner toolkit</b><span>Transferable skills, refresh, support and flexible re-entry</span></a>
      </div><p class="updated-note">Research reviewed 15 July 2026. Sources guide the structure; role maps are editorial syntheses, not official occupational standards. The tool does not diagnose personality, guarantee employment or replace local licensing and safety requirements.</p></div></details>
    </div></section>
  </main>

  <div class="compare-tray" id="compare-tray" hidden><div><strong><span id="compare-count">0</span>/3 pinned for this visit</strong><span id="compare-names">Nothing is stored or sent anywhere.</span></div><div><button type="button" id="clear-compare">Clear</button><button type="button" id="open-compare">Compare side by side</button></div></div>
  <dialog class="career-dialog" id="role-dialog" aria-labelledby="dialog-role-title"><div class="dialog-shell"><button type="button" class="dialog-close" data-close-role aria-label="Close career map">×</button><div id="role-dialog-content"></div></div></dialog>
  <dialog class="career-dialog" id="compare-dialog" aria-labelledby="compare-title"><div class="dialog-shell compare-shell"><button type="button" class="dialog-close" data-close-compare aria-label="Close comparison">×</button><div id="compare-content"></div></div></dialog>
  <dialog class="career-dialog" id="experiment-dialog" aria-labelledby="experiment-title"><div class="dialog-shell experiment-shell"><button type="button" class="dialog-close" data-close-experiment aria-label="Close career experiment">×</button><div id="experiment-content"></div></div></dialog>
  <dialog class="career-dialog" id="skill-sprint-dialog" aria-labelledby="skill-sprint-title"><div class="dialog-shell skill-sprint-shell"><button type="button" class="dialog-close" data-close-skill-sprint aria-label="Close skill sprint">×</button><div id="skill-sprint-content"></div></div></dialog>
  <script type="application/json" id="compass-data" set:html={JSON.stringify(clientData)}></script>
  <Footer />
</BaseLayout>

<style is:global>
  :root{--cc-ink:#081523;--cc-paper:#f3efe6;--cc-cream:#fbf8f1;--cc-orange:#ff6b35;--cc-lime:#d9f55d;--cc-blue:#91dcff;--cc-line:rgba(8,21,35,.14);--cc-muted:rgba(8,21,35,.64)}
  [hidden]{display:none!important}.compass-page{background:var(--cc-paper);color:var(--cc-ink);overflow:clip}.compass-page *{box-sizing:border-box}.compass-page .sr-only,.career-dialog .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.compass-page button,.career-dialog button,.compare-tray button{font:inherit;cursor:pointer}.compass-page .container{width:min(1180px,calc(100% - 36px));margin-inline:auto}.compass-page .narrow-container{width:min(1000px,calc(100% - 36px))}
  .route-page-banner{display:none;padding:38px 0 35px;background:#fbf8f1;border-bottom:1px solid var(--cc-line)}.route-page-banner a{color:#075a7b;font-size:12px;font-weight:800;text-decoration:none}.route-page-banner p{margin:25px 0 7px;color:#c94a23;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.route-page-banner h1{margin:0;font:800 clamp(38px,5vw,60px)/1.02 'Sora',sans-serif;letter-spacing:-.055em}.route-page-banner span{display:block;max-width:700px;margin-top:14px;color:var(--cc-muted);font-size:16px;line-height:1.55}
