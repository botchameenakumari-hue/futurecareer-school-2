  function updateSkillInventory(input) {
    const dialog=input?.closest?.('#role-dialog')||$('#role-dialog'); const inventory=$('[data-skill-inventory]',dialog); if(!inventory)return;
    if(input?.matches?.('[data-skill-evidence]')) input.closest('[data-inventory-skill]').dataset.evidenceState=input.value;
    const cards=$$('[data-inventory-skill]',dialog); const assessed=cards.filter((card)=>card.dataset.evidenceState!=='unassessed'); const ready=cards.filter((card)=>card.dataset.evidenceState==='ready'); const active=cards.filter((card)=>['learning','practising'].includes(card.dataset.evidenceState));
    $('[data-inventory-assessed]',inventory).textContent=`${assessed.length} / ${cards.length}`; $('[data-inventory-ready]',inventory).textContent=String(ready.length); $('[data-inventory-gaps]',inventory).textContent=String(active.length);
    $$('[data-inventory-layer]',inventory).forEach((summary)=>{const layer=summary.dataset.inventoryLayer;const layerCards=cards.filter((card)=>card.dataset.skillLayer===layer);const evidenced=layerCards.filter((card)=>card.dataset.evidenceState==='ready').length;$('b',summary).textContent=`${evidenced} / ${layerCards.length} with examples`});
    const priorityNames=$$('.priority-runway h5',dialog).map((node)=>node.textContent.trim()); const priorityOrder=new Map(priorityNames.map((name,index)=>[name,index])); const layerOrder=new Map([['Role craft',0],['AI & digital fluency',1],['Transferable',2],['Foundation',3]]); const stateOrder={practising:0,learning:1,unassessed:2};
    const unresolved=cards.filter((card)=>card.dataset.evidenceState!=='ready').sort((a,b)=>{const ap=priorityOrder.has(a.dataset.skillName)?priorityOrder.get(a.dataset.skillName):99;const bp=priorityOrder.has(b.dataset.skillName)?priorityOrder.get(b.dataset.skillName):99;return ap-bp||stateOrder[a.dataset.evidenceState]-stateOrder[b.dataset.evidenceState]||layerOrder.get(a.dataset.skillLayer)-layerOrder.get(b.dataset.skillLayer)||a.dataset.skillName.localeCompare(b.dataset.skillName)}).slice(0,3);
    const labels={unassessed:'check this skill',learning:'learn the basics',practising:'practise again with feedback'}; $('[data-inventory-priority]',inventory).innerHTML=unresolved.length?unresolved.map((card)=>`<li><div><b>${escapeHtml(card.dataset.skillName)}</b><span>${escapeHtml(card.dataset.skillLayer)} · ${escapeHtml(labels[card.dataset.evidenceState])}</span></div><button type="button" data-skill-sprint="${escapeHtml(card.dataset.skillName)}" data-skill-layer="${escapeHtml(card.dataset.skillLayer)}" data-skill-role-ids="${escapeHtml(inventory.dataset.inventoryRole)}">Make a 14-day practice plan →</button></li>`).join(''):'<li><div><b>You have marked every skill as having an example.</b><span>Ask someone familiar with the work to check whether your examples meet the standard this role needs.</span></div></li>';
    const guidance=$('[data-inventory-guidance]',inventory); guidance.textContent=!assessed.length?'Use a real project, piece of feedback or result to choose each status. You do not need to rate every skill at once.':assessed.length<Math.min(6,cards.length)?`Check ${Math.min(6,cards.length)-assessed.length} more priority skill${Math.min(6,cards.length)-assessed.length===1?'':'s'} before choosing what to learn next.`:ready.length===cards.length?'You have an example for every skill. Ask someone familiar with the work to check their quality and relevance before assuming you are ready for the role.':`${active.length} skill${active.length===1?'':'s'} marked for learning or practice. Work on one useful example at a time.`;
    $$('[data-skill-sprint]',inventory).forEach((button)=>button.textContent=button.textContent.replace(/14-day practice plan/i,'flexible practice plan'));
    const filter=$('[data-inventory-filter]',inventory); const hideReady=filter?.getAttribute('aria-pressed')==='true'; cards.forEach((card)=>card.hidden=hideReady&&card.dataset.evidenceState==='ready'); if(filter)filter.textContent=hideReady?'Show all skills':'Hide skills with examples';
  }
  async function copySkillInventory(button) {
    const dialog=button.closest('#role-dialog'); const inventory=button.closest('[data-skill-inventory]'); if(!dialog||!inventory)return; const role=byId.get(inventory.dataset.inventoryRole); const labels={unassessed:'Not checked yet',learning:'I want to learn this',practising:'I’m practising this',ready:'I can show a real example'}; const groups=['ready','practising','learning','unassessed'].map((state)=>{const items=$$(`[data-inventory-skill][data-evidence-state="${state}"]`,dialog).map((card)=>`- ${card.dataset.skillName} (${card.dataset.skillLayer})`);return `${labels[state]} — ${items.length}\n${items.length?items.join('\n'):'- None recorded'}`}).join('\n\n'); const priorities=$('[data-inventory-priority]',inventory)?.innerText||'No next skills recorded.'; const text=`My skill plan\nCareer: ${role?.title||'Career'}\nDate: ${new Date().toLocaleDateString()}\n\n${groups}\n\nThree skills to work on next\n${priorities}\n\nPlease note: this is a private self-check, not a formal assessment, qualification or guarantee that you are ready for the role. Check current local requirements and ask someone familiar with the work to review your examples.`; let copied=false; try{await navigator.clipboard.writeText(text);copied=true}catch{const field=document.createElement('textarea');field.value=text;field.style.position='fixed';field.style.opacity='0';document.body.appendChild(field);field.select();copied=document.execCommand('copy');field.remove()} const status=$('[data-inventory-status]',inventory);if(status)status.textContent=copied?'Your skill plan was copied. Add links, dates and feedback in your notes.':'Copy was blocked. Please select the text manually.';if(copied)button.textContent='Skill plan copied ✓';
