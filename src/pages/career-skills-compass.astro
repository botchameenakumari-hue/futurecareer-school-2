  function analyseJobAd(button) {
    const role=byId.get(button.dataset.analyseAd); const section=button.closest('.job-ad-decoder'); const result=$('[data-job-ad-results]',section); const raw=$('[data-job-ad]',section)?.value.trim()||'';
    if(!raw){ result.hidden=false; result.innerHTML='<p class="job-ad-empty">Paste the vacancy text first. Nothing leaves this page.</p>'; return; }
    const normalise=(value)=>String(value).toLowerCase().replace(/[^a-z0-9+#]+/g,' ').replace(/\s+/g,' ').trim();
    const ads=raw.split(/\n\s*-{3,}\s*\n/).map((item)=>item.trim()).filter(Boolean).slice(0,5); const sampleCount=ads.length; const normalisedAds=ads.map(normalise); const text=normalise(ads.join(' ')); const ignored=new Set(['with','and','skills','skill','tools','using','management','development','systems','ability']);
