  async function copyEvidenceTriage(button){const section=button.closest('[data-evidence-triage]');if(!section)return;const text=`Prioritised vacancy evidence plan\n\n${$('.triage-summary',section)?.innerText||''}\n\n${$('.triage-plan',section)?.innerText||''}\n\nRecurrence is based only on the pasted adverts and is not market demand.`;let copied=false;try{await navigator.clipboard.writeText(text);copied=true}catch{const field=document.createElement('textarea');field.value=text;field.style.position='fixed';field.style.opacity='0';document.body.appendChild(field);field.select();copied=document.execCommand('copy');field.remove()}const status=$('[data-triage-status]',section);if(status)status.textContent=copied?'Prioritised plan copied. Add evidence links and dates in your notes.':'Copy was blocked; select the plan text manually.';if(copied)button.textContent='Plan copied ✓'}
