    const triageItems=frequencies.slice(0,6); const topCondition=conditionFrequencies.sort((a,b)=>b.count-a.count)[0]; const triageMarkup=triageItems.length?`<section class="evidence-triage" data-evidence-triage data-sample-count="${sampleCount}" data-top-condition="${escapeHtml(topCondition?.label||'No repeated work condition detected')}"><header><div><span>Evidence triage</span><h5>Advert language is not your evidence.</h5></div><p>Mark what you can already prove, what needs a small test and what remains uncertain. The plan below updates privately.</p></header><div class="evidence-triage-list">${triageItems.map((item)=>`<article data-triage-row data-skill="${escapeHtml(item.skill)}" data-count="${item.count}" data-triage-state="unsure"><div><b>${escapeHtml(item.skill)}</b><span>${sampleCount>1?`${item.count}/${sampleCount} adverts`:'Named in this advert'}</span></div><div role="group" aria-label="Evidence status for ${escapeHtml(item.skill)}"><button type="button" data-triage-choice="ready" aria-pressed="false">Evidence ready</button><button type="button" data-triage-choice="test" aria-pressed="false">Need a test</button><button type="button" data-triage-choice="unsure" aria-pressed="true">Not sure</button></div></article>`).join('')}</div><div class="triage-summary" aria-live="polite"><b data-triage-count>0 ready · 0 need a test · ${triageItems.length} uncertain</b><span>Only mark “ready” when you can point to context, your action, result, feedback and limitations.</span></div><div class="triage-plan"><article><span>01 · Prove next</span><b data-triage-prove></b></article><article><span>02 · Tailor truthfully</span><b data-triage-tailor></b></article><article><span>03 · Verify conditions</span><b data-triage-verify></b></article></div><div class="triage-actions"><span data-triage-status>Nothing is saved or sent.</span><button type="button" data-copy-triage>Copy prioritised evidence plan</button></div></section>`:'';
    result.hidden=false; result.innerHTML=`<header><span>${sampleCount>1?`${sampleCount}-vacancy reality check`:'Ad reality check'}</span><h4>${matched.length}/${roleSkills.length} mapped skill phrases surfaced</h4><p>This is wording coverage, not a suitability score. Employers often imply capabilities instead of naming them.</p></header>${sampleMarkup}<div class="job-ad-columns"><div><h5>Explicitly signalled</h5><div class="job-ad-chips positive">${chips(matched,'No mapped skill phrase was detected. The advert may use different wording or be unusually vague.')}</div></div><div><h5>Important but not explicit</h5><div class="job-ad-chips caution">${chips(missing,'The advert explicitly covers the main priority skills in this map.')}</div></div></div><div class="condition-signals"><h5>Work-condition signals</h5><div>${chips(conditions,'No obvious location, hours, target, travel, credential or experience signal was detected.')}</div></div>${triageMarkup}<div class="ad-questions"><h5>Ask before applying or accepting</h5><ol><li>What share of an ordinary week is spent on ${escapeHtml(role.meta.taskMix[0].toLowerCase())}?</li><li>Which tasks are automated or AI-assisted, and who is accountable for checking failures?</li><li>How does the team handle this reality: ${escapeHtml(role.meta.friction[0].toLowerCase())}?</li></ol></div>${applicationSprint(role,matched,missing)}`;
