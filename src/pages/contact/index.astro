---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { CONTACT, WHATSAPP_BOOKING_URL, WHATSAPP_BASE_URL } from '../../config/site';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://futurecareerschool.com/" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://futurecareerschool.com/contact" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Future Career School",
    "description": "Get in touch with Future Career School for career guidance, free assessments, and the right next step for your situation.",
    "url": "https://futurecareerschool.com/contact",
    "inLanguage": "en-IN",
    "publisher": {
      "@type": ["Organization", "ProfessionalService"],
      "name": "Future Career School",
      "url": "https://futurecareerschool.com",
      "telephone": CONTACT.phoneE164,
      "email": CONTACT.email,
      "areaServed": {
        "@type": "Country",
        "name": "India"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "13-420, Durga Nagar, Arilova",
        "addressLocality": "Visakhapatnam",
        "addressRegion": "Andhra Pradesh",
        "postalCode": "530040",
        "addressCountry": "IN"
      }
    }
  }
];
---

<BaseLayout
  title="Contact Future Career School | Career Guidance"
  description="Reach Future Career School via WhatsApp, phone, or email. Ask about career guidance, assessments, or the right next step for your situation."
  canonical="https://futurecareerschool.com/contact"
  jsonLd={jsonLd}
>
  <Nav />

  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
      <div class="grid"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Contact</span>
      </nav>

      <div class="pill hero-pill">
        <span class="pill-dot"></span>
        Reach us directly — no contact form delays
      </div>

      <h1 class="hero-title">
        Contact
        <span class="gold-text"> Future Career School</span>
      </h1>
      <p class="hero-sub">
        The fastest way to start is WhatsApp.
        Tell us whether you are a student, graduate, or working professional, and what you want to figure out.
        We will help you decide whether career guidance or a free assessment is the better first step.
      </p>
      <div class="hero-actions">
        <a href={WHATSAPP_BOOKING_URL} class="btn-gold pulse" target="_blank" rel="noopener noreferrer">Get Career Guidance</a>
        <a href="/services/career-counselling-and-career-guidance#guidance-process" class="btn-outline">See Guidance Details</a>
      </div>
    </div>
  </section>

  <section id="contact-methods">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;Get in Touch</div>
      <h2 class="section-headline">Ways to Reach Us</h2>
      <p class="section-sub">
        We keep contact simple. No forms, no waiting days for a reply. Most questions are answered within a few hours on WhatsApp.
      </p>

      <div class="contact-grid">
        <div class="contact-card card primary-contact">
          <div class="contact-icon whatsapp-icon">
            <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <h3>WhatsApp (Fastest)</h3>
          <p>
            Message us on WhatsApp with your name, where you are in your career, and what you want to figure out.
            This is the most direct way to book and the fastest way to get a response.
          </p>
          <a href={WHATSAPP_BOOKING_URL} class="contact-action btn-gold" target="_blank" rel="noopener noreferrer">
            Message on WhatsApp
          </a>
          <span class="contact-detail">{CONTACT.phoneDisplay}</span>
        </div>

        <div class="contact-card card">
          <div class="contact-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3>Email</h3>
          <p>
            For longer questions, session feedback, or partnership enquiries. Email is monitored daily.
            Allow 24 hours for a response.
          </p>
          <a href={`mailto:${CONTACT.email}`} class="contact-action btn-outline">
            Send an Email
          </a>
          <span class="contact-detail">{CONTACT.email}</span>
        </div>

        <div class="contact-card card">
          <div class="contact-icon">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3>Phone</h3>
          <p>
            For urgent matters or if you prefer a quick call to understand whether a session makes sense for your situation.
          </p>
          <a href={`tel:${CONTACT.phoneE164}`} class="contact-action btn-outline">
            Call Us
          </a>
          <span class="contact-detail">{CONTACT.phoneDisplay}</span>
        </div>
      </div>
    </div>
  </section>

  <section id="address">
    <div class="container">
      <div class="address-grid">
        <div class="address-content">
          <div class="section-tag pill"><span style="color:var(--gold)">&#9675;</span>&nbsp;Our Base</div>
          <h2>Located in Visakhapatnam</h2>
          <p>
            Future Career School is based in Visakhapatnam, Andhra Pradesh.
            All guidance sessions are conducted online so students and professionals from any city in India can access the same quality of career guidance.
          </p>
          <address>
            <div class="addr-line">
              <svg width="14" height="14" fill="none" stroke="rgba(229,184,74,.7)" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>13-420, Durga Nagar, Arilova,<br/>Visakhapatnam, AP 530040, India</span>
            </div>
          </address>
          <a href="/locations" class="locations-link">View all city guides &rsaquo;</a>
        </div>

        <div class="what-to-expect card">
          <h3>What Happens After You Reach Out</h3>
          <ol class="steps-list">
            <li>
              <div class="step-num">01</div>
              <div class="step-content">
                <strong>Send your situation</strong>
                <span>Tell us your name, where you are in your career, and what you want to figure out.</span>
              </div>
            </li>
            <li>
              <div class="step-num">02</div>
              <div class="step-content">
                <strong>We confirm fit</strong>
                <span>We check if career guidance is the right next step or if an assessment would give better inputs first.</span>
              </div>
            </li>
            <li>
              <div class="step-num">03</div>
              <div class="step-content">
                <strong>Schedule your session</strong>
                <span>Agree on a time. Your first session is always 1-on-1, focused on your actual situation.</span>
              </div>
            </li>
            <li>
              <div class="step-num">04</div>
              <div class="step-content">
                <strong>Get clarity and a next step</strong>
                <span>You leave with direction — not just encouragement. A plan for your next concrete action.</span>
              </div>
            </li>
          </ol>
          <a href="/services/career-counselling-and-career-guidance#guidance-process" class="guidance-link">Read full guidance details &rsaquo;</a>
        </div>
      </div>
    </div>
  </section>

  <section id="quick-links">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;Also Useful</div>
      <div class="quick-grid">
        <a class="quick-card card" href="/services">
          <strong>All Services</strong>
          <span>Guidance, assessments, and coaching tracks</span>
        </a>
        <a class="quick-card card" href="/services/career-counselling-and-career-guidance">
          <strong>Career Guidance</strong>
          <span>Initial 1-on-1 guidance and continuous support</span>
        </a>
        <a class="quick-card card" href="/services/assessments">
          <strong>Assessments</strong>
          <span>Career tests before or alongside guidance</span>
        </a>
        <a class="quick-card card" href="/services/career-counselling-and-career-guidance#guidance-expectations">
          <strong>What Guidance Is and Isn't</strong>
          <span>Clear expectations before you start</span>
        </a>
        <a class="quick-card card" href="/career-skills-compass">
          <strong>Career & Skills Compass</strong>
          <span>Explore 38 curated career skills</span>
        </a>
        <a class="quick-card card" href="/about">
          <strong>About Us</strong>
          <span>Who we are and what drives our approach</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #hero { padding: 140px 0 86px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 10%, rgba(0,0,0,.8), transparent 60%);
    opacity: .16;
  }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
  .breadcrumb a:hover { color: rgba(255,255,255,.85); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  #contact-methods { padding: 6rem 0; }
  #address { padding: 6rem 0; background: rgba(255,255,255,.012); }
  #quick-links { padding: 5rem 0 7rem; }

  .section-tag { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 1.25rem; align-items: center; gap: 6px; }
  .section-headline { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-align: center; }
  .section-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.55); max-width: 720px; margin: 0 auto 3rem; text-align: center; line-height: 1.7; }

  .contact-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1.25rem; align-items: start; }
  .contact-card { padding: 2rem; display: flex; flex-direction: column; gap: .9rem; }
  .primary-contact { border-color: rgba(229,184,74,.22); background: rgba(229,184,74,.03); }
  .contact-icon { color: rgba(255,255,255,.7); }
  .whatsapp-icon { color: #25d366; }
  .contact-card h3 { font-size: 1.1rem; color: #fff; }
  .contact-card p { font-size: 13.5px; color: rgba(255,255,255,.56); line-height: 1.75; flex: 1; }
  .contact-action { margin-top: auto; text-align: center; justify-content: center; }
  .contact-detail { display: block; font-size: 12px; color: rgba(255,255,255,.3); text-align: center; margin-top: .25rem; }

  .address-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
  .address-content h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin: 1.25rem 0 1rem; }
  .address-content p { font-size: 14.5px; color: rgba(255,255,255,.58); line-height: 1.75; margin-bottom: 1.5rem; }
  address { font-style: normal; }
  .addr-line { display: flex; align-items: flex-start; gap: 10px; font-size: 13.5px; color: rgba(255,255,255,.45); line-height: 1.65; }
  .locations-link { display: inline-block; margin-top: 1.75rem; font-size: 13px; font-weight: 800; color: var(--gold); }

  .what-to-expect { padding: 2rem; }
  .what-to-expect h3 { font-size: 1.1rem; color: #fff; margin-bottom: 1.5rem; }
  .steps-list { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem; }
  .steps-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num { font-family: "Sora", sans-serif; font-size: 1.3rem; font-weight: 900; color: var(--gold); opacity: .6; flex-shrink: 0; line-height: 1.2; min-width: 2rem; }
  .step-content { display: flex; flex-direction: column; gap: .3rem; }
  .step-content strong { font-size: 14px; color: #fff; }
  .step-content span { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.6; }
  .guidance-link { font-size: 13px; font-weight: 800; color: var(--teal); }

  .quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .quick-card { padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: .5rem; transition: transform .2s, border-color .2s; }
  .quick-card:hover { transform: translateY(-3px); border-color: rgba(229,184,74,.3); }
  .quick-card strong { color: #fff; font-size: 14px; }
  .quick-card span { color: rgba(255,255,255,.45); font-size: 13px; line-height: 1.5; }

  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; }
    .address-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .quick-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    #hero { padding: 120px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
    .quick-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    #contact-methods,
    #address,
    #quick-links { padding: 4.6rem 0; }
    .hero-sub { font-size: 14.5px; line-height: 1.72; }
    .contact-card,
    .what-to-expect,
    .quick-card { padding: 1.3rem 1.05rem; }
    .address-grid { gap: 2rem; }
  }
</style>
