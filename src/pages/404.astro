---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found | Future Career School"
  description="This page is not available. Explore the main services, assessments, blog, and resource pages instead."
  canonical="https://futurecareerschool.com/404"
  noindex={true}
>
  <Nav />

  <main class="not-found">
    <div class="nf-glow nf-glow-one"></div>
    <div class="nf-glow nf-glow-two"></div>

    <section class="container nf-inner" aria-labelledby="nf-title">
      <div class="pill nf-pill">
        <span class="pill-dot"></span>
        Page not found
      </div>

      <h1 id="nf-title">
        We couldn’t find that page.
      </h1>

      <p>
        The page you were trying to reach is not available right now.
        For now, use the live hubs below so you do not hit a dead end.
      </p>

      <div class="nf-actions">
        <a href="/services/career-counselling-and-career-guidance" class="btn-gold">Career Guidance</a>
        <a href="/services/assessments" class="btn-outline">Free career and skill assessments</a>
      </div>

      <div class="nf-grid" aria-label="Helpful live pages">
        <a class="nf-card card" href="/services">
          <span>Guidance, Assessments, and Tools</span>
          <strong>/services/</strong>
        </a>
        <a class="nf-card card" href="/services/career-counselling-and-career-guidance#guidance-process">
          <span>Guidance Model</span>
          <strong>/services/career-counselling-and-career-guidance/#guidance-process</strong>
        </a>
        <a class="nf-card card" href="/career-skills-compass">
          <span>Career & Skills Compass</span>
          <strong>/career-skills-compass/</strong>
        </a>
        <a class="nf-card card" href="/career-resources">
          <span>Resource Library</span>
          <strong>/career-resources/</strong>
        </a>
        <a class="nf-card card" href="/blog">
          <span>Blog</span>
          <strong>/blog/</strong>
        </a>
        <a class="nf-card card" href="/">
          <span>Homepage</span>
          <strong>/</strong>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    position: relative;
    overflow: hidden;
    min-height: 72vh;
    padding: 140px 0 88px;
    background:
      radial-gradient(circle at 12% 18%, rgba(229,184,74,.12), transparent 32%),
      radial-gradient(circle at 86% 22%, rgba(45,212,191,.1), transparent 30%),
      #080c18;
  }

  .nf-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(90px);
    pointer-events: none;
  }

  .nf-glow-one {
    width: 360px;
    height: 360px;
    left: -120px;
    top: 110px;
    background: rgba(229,184,74,.12);
  }

  .nf-glow-two {
    width: 300px;
    height: 300px;
    right: -80px;
    bottom: 80px;
    background: rgba(45,212,191,.1);
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .nf-pill {
    margin-bottom: 1.4rem;
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--teal);
  }

  h1 {
    max-width: 820px;
    margin: 0 auto 1rem;
    color: #fff;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    letter-spacing: -.06em;
    line-height: .98;
  }

  p {
    max-width: 620px;
    margin: 0 auto 2rem;
    color: rgba(255,255,255,.6);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
  }

  .nf-actions {
    display: flex;
    justify-content: center;
    gap: .8rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .nf-card {
    padding: 1.25rem;
    text-align: left;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .nf-card:hover {
    transform: translateY(-3px);
    border-color: rgba(229,184,74,.35);
    background: rgba(255,255,255,.06);
  }

  .nf-card span {
    display: block;
    margin-bottom: .5rem;
    color: rgba(255,255,255,.45);
    font-size: .82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .nf-card strong {
    color: #fff;
    font-size: .95rem;
  }

  @media (max-width: 760px) {
    .not-found { padding: 120px 0 72px; }
    .nf-grid { grid-template-columns: 1fr; }
    .nf-actions { flex-direction: column; }
    .nf-actions .btn-gold,
    .nf-actions .btn-outline { justify-content: center; width: 100%; }
  }
</style>
