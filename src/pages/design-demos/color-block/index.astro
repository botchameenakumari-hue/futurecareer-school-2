---
const photo = (seed, w = 800, h = 600) => `https://picsum.photos/seed/${seed}/${w}/${h}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Direction 03 · Vibrant Color-Block — Future Career School</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--ink:#111018;--cobalt:#2563eb;--coral:#fb5a3c;--lime:#c7f24a;--cream:#fff7e8;--shadow:6px 6px 0 var(--ink)}
    html{scroll-behavior:smooth}
    body{background:var(--cream);color:var(--ink);font-family:"Inter",sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    .disp{font-family:"Bricolage Grotesque",sans-serif;letter-spacing:-.02em;line-height:.98}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    .wrap{max-width:1180px;margin:0 auto;padding:0 1.5rem}
    .badge{position:fixed;top:14px;left:14px;z-index:50;font-size:12px;font-weight:700;padding:8px 14px;border-radius:0;background:var(--lime);border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);color:var(--ink)}
    nav.bar{position:sticky;top:0;z-index:40;background:var(--cream);border-bottom:3px solid var(--ink)}
    .nav-in{display:flex;align-items:center;justify-content:space-between;height:74px}
    .logo{font-family:"Bricolage Grotesque";font-weight:800;font-size:20px}
    .logo span{background:var(--coral);color:#fff;padding:0 6px}
    .nav-links{display:flex;gap:24px;font-size:14px;font-weight:600}
    .btn{display:inline-flex;align-items:center;gap:8px;font-family:"Bricolage Grotesque";font-weight:700;font-size:15px;padding:13px 22px;border:2px solid var(--ink);box-shadow:var(--shadow);cursor:pointer;transition:transform .12s,box-shadow .12s;background:#fff}
    .btn:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--ink)}
    .btn:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}
    .btn-y{background:var(--lime)}
    .btn-c{background:var(--coral);color:#fff}
    .btn-w{background:#fff}
    @media(max-width:860px){.nav-links{display:none}}
    /* hero */
    .hero{padding:4.5rem 0 5rem;display:grid;grid-template-columns:1.15fr .85fr;gap:2.5rem;align-items:center;position:relative}
    .tagpill{display:inline-block;font-family:"Bricolage Grotesque";font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.04em;background:var(--ink);color:var(--cream);padding:7px 14px;margin-bottom:1.4rem}
    .hero h1{font-family:"Bricolage Grotesque";font-weight:800;font-size:clamp(2.8rem,7vw,5.6rem);margin-bottom:1.4rem}
    .hero h1 .hl{background:var(--cobalt);color:#fff;padding:0 .1em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
    .hero h1 .hl2{background:var(--coral);color:#fff;padding:0 .1em}
    .hero p.lead{font-size:18px;line-height:1.6;max-width:42ch;margin-bottom:1.8rem;font-weight:500}
    .cta-row{display:flex;gap:14px;flex-wrap:wrap}
    .hero-art{position:relative}
    .hero-art .frame{border:3px solid var(--ink);box-shadow:10px 10px 0 var(--ink);overflow:hidden;aspect-ratio:4/5;background:var(--cobalt)}
    .hero-art .frame img{width:100%;height:100%;object-fit:cover;mix-blend-mode:luminosity;opacity:.92}
    .shape{position:absolute;border:3px solid var(--ink)}
    .s-star{width:84px;height:84px;background:var(--lime);top:-30px;right:-22px;rotate:12deg;box-shadow:5px 5px 0 var(--ink);display:grid;place-items:center;font-size:34px}
    .s-circ{width:74px;height:74px;border-radius:50%;background:var(--coral);bottom:-26px;left:-26px;box-shadow:5px 5px 0 var(--ink);animation:bob 4s ease-in-out infinite}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
    /* full-bleed blocks */
    .block{padding:5.5rem 0;border-bottom:3px solid var(--ink)}
    .b-cobalt{background:var(--cobalt);color:#fff}
    .b-coral{background:var(--coral);color:#fff}
    .b-lime{background:var(--lime)}
    .b-cream{background:var(--cream)}
    .lab{font-family:"Bricolage Grotesque";font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.8rem;opacity:.85}
    h2.t{font-family:"Bricolage Grotesque";font-weight:800;font-size:clamp(2.1rem,5vw,3.6rem);margin-bottom:1rem}
    .sub{font-size:17px;line-height:1.6;max-width:56ch;margin-bottom:2.6rem;font-weight:500;opacity:.9}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
    .stat{background:#fff;color:var(--ink);border:3px solid var(--ink);box-shadow:var(--shadow);padding:1.6rem}
    .stat .num{font-family:"Bricolage Grotesque";font-weight:800;font-size:2.6rem}
    .stat .cap{font-size:14px;font-weight:500;margin-top:4px}
    .duo{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem}
    .pcard{background:var(--cream);color:var(--ink);border:3px solid var(--ink);box-shadow:8px 8px 0 var(--ink);overflow:hidden;transition:transform .12s,box-shadow .12s}
    .pcard:hover{transform:translate(-3px,-3px);box-shadow:12px 12px 0 var(--ink)}
    .ph{aspect-ratio:16/10;overflow:hidden;border-bottom:3px solid var(--ink)}
    .ph img{width:100%;height:100%;object-fit:cover}
    .pc-body{padding:1.6rem}
    .pc-k{font-family:"Bricolage Grotesque";font-weight:700;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:var(--cobalt);color:#fff;display:inline-block;padding:3px 9px}
    .pc-body h3{font-family:"Bricolage Grotesque";font-weight:800;font-size:1.5rem;margin:.6rem 0 .5rem}
    .pc-body p{font-size:15px;line-height:1.6;font-weight:500}
    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.3rem}
    .step{background:#fff;color:var(--ink);border:3px solid var(--ink);box-shadow:var(--shadow);padding:1.4rem;transition:transform .12s,box-shadow .12s}
    .step:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--ink)}
    .step .no{font-family:"Bricolage Grotesque";font-weight:800;font-size:1.6rem;width:46px;height:46px;display:grid;place-items:center;background:var(--lime);border:2px solid var(--ink);margin-bottom:.8rem}
    .step h3{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.1rem;margin-bottom:.3rem}
    .step p{font-size:13.5px;line-height:1.55;font-weight:500}
    .cta-block{text-align:center}
    .cta-block h2{font-family:"Bricolage Grotesque";font-weight:800;font-size:clamp(2.4rem,6vw,4.4rem);margin-bottom:1rem}
    .cta-block p{font-size:18px;font-weight:500;max-width:46ch;margin:0 auto 2rem}
    footer{padding:2.5rem 0;text-align:center;font-size:13px;font-weight:600;background:var(--ink);color:var(--cream)}
    .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
    .reveal.in{opacity:1;transform:none}
    @media(max-width:980px){.hero{grid-template-columns:1fr}.steps{grid-template-columns:repeat(2,1fr)}.duo{grid-template-columns:1fr}}
    @media(max-width:600px){.stats{grid-template-columns:1fr}.steps{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){.s-circ{animation:none}.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <a class="badge" href="/design-demos/">03 · VIBRANT COLOR-BLOCK — ← all</a>

  <nav class="bar"><div class="wrap nav-in">
    <div class="logo">Future <span>Career</span> School</div>
    <div class="nav-links"><a href="#">Services</a><a href="#">Career & Skills Compass</a><a href="#">Resources</a><a href="#">Blog</a></div>
    <a class="btn btn-y" href="#">Get Guidance →</a>
  </div></nav>

  <header class="wrap hero">
    <div>
      <div class="tagpill">For students, freshers &amp; pros</div>
      <h1 class="disp">Pick the <span class="hl">right skill.</span> Skip the <span class="hl2">wrong years.</span></h1>
      <p class="lead">Practical, skill-first career guidance with proof of work and a real roadmap to earlier financial freedom. Fully online, all India.</p>
      <div class="cta-row"><a class="btn btn-c" href="#">Get Career Guidance →</a><a class="btn btn-w" href="#">Free Assessments</a></div>
    </div>
    <div class="hero-art">
      <div class="shape s-star">★</div>
      <div class="frame"><img src={photo('fcs-cb-hero',800,1000)} alt="A confident student" width="800" height="1000" loading="eager"/></div>
      <div class="shape s-circ"></div>
    </div>
  </header>

  <section class="block b-cobalt"><div class="wrap">
    <div class="lab">By the numbers</div>
    <div class="stats">
      <div class="stat reveal"><div class="num">10,000+</div><div class="cap">guided across India</div></div>
      <div class="stat reveal"><div class="num">4.9/5</div><div class="cap">average clarity rating</div></div>
      <div class="stat reveal"><div class="num">100%</div><div class="cap">online — every city</div></div>
    </div>
  </div></section>

  <section class="block b-cream"><div class="wrap">
    <div class="lab" style="color:var(--cobalt)">Who we work with</div>
    <h2 class="t reveal">Guidance for every growth stage.</h2>
    <p class="sub reveal">Two paths, one foundation: assessments, high-value skills, and a roadmap you actually execute.</p>
    <div class="duo">
      <div class="pcard reveal"><div class="ph"><img src={photo('fcs-cb-stu')} alt="Students together" width="800" height="500" loading="lazy"/></div><div class="pc-body"><span class="pc-k">Students &amp; Freshers</span><h3>Direction before pressure</h3><p>Stream, course, and early skill clarity — avoid expensive wrong turns, build proof early.</p></div></div>
      <div class="pcard reveal"><div class="ph"><img src={photo('fcs-cb-pro')} alt="A professional working" width="800" height="500" loading="lazy"/></div><div class="pc-body"><span class="pc-k">Professionals</span><h3>Leverage &amp; income growth</h3><p>Beat stagnation with positioning, high-value skill stacking, and new income options.</p></div></div>
    </div>
  </div></section>

  <section class="block b-lime"><div class="wrap">
    <div class="lab">The path</div>
    <h2 class="t reveal">Four steps. Zero guesswork.</h2>
    <div class="steps">
      <div class="step reveal"><div class="no">01</div><h3>Map your fit</h3><p>Strengths and work-style mapping first.</p></div>
      <div class="step reveal"><div class="no">02</div><h3>Pick the skill</h3><p>Interest × market × scalability.</p></div>
      <div class="step reveal"><div class="no">03</div><h3>Build proof</h3><p>Portfolio and positioning that gets you hired.</p></div>
      <div class="step reveal"><div class="no">04</div><h3>Reach freedom</h3><p>Your Freedom Number, a compounding plan.</p></div>
    </div>
  </div></section>

  <section class="block b-coral"><div class="wrap cta-block reveal">
    <h2 class="disp">Ready for the right next move?</h2>
    <p>Start with practical clarity. Continue only if you need deeper support.</p>
    <div class="cta-row" style="justify-content:center"><a class="btn btn-y" href="#">Get Career Guidance →</a><a class="btn btn-w" href="#">Free Assessments</a></div>
  </div></section>

  <footer>Future Career School · Vibrant Color-Block exploration</footer>

  <script>
    const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
  </script>
</body>
</html>
