---
// Standalone navigator for the homepage design-direction explorations.
// Not part of the live site (noindex). Pick one, then I build the full homepage in it.
const directions = [
  { n: '05', slug: 'cosmic', name: 'Orbital / Spatial OS', blurb: 'NEW · graphics maxed. Live interactive starfield, a real 3D rotating orbital system, sci-fi HUD, mouse-reactive depth.', sw: ['#04060d', '#22d3ee', '#6366f1', '#d946ef'] },
  { n: '06', slug: 'kinetic', name: 'Liquid Kinetic', blurb: 'NEW · graphics maxed. Gooey morphing metaballs, giant animated masked typography, a 3D rotating photo carousel, acid-electric palette.', sw: ['#06060a', '#c6ff00', '#2b6bff', '#ff2bd6'] },
  { n: '01', slug: 'aurora', name: 'Holographic Aurora', blurb: 'Futuristic dark. Electric violet → cyan → magenta gradients, neon glass, heavy 3D + motion.', sw: ['#0b0614', '#7c3aed', '#22d3ee', '#ec4899'] },
  { n: '02', slug: 'light', name: 'Luminous Light Editorial', blurb: 'Bright, airy, premium. Off-white canvas, giant serif headlines, indigo accent, big photography.', sw: ['#f7f4ee', '#14121a', '#4f46e5', '#ff5a3c'] },
  { n: '03', slug: 'color-block', name: 'Vibrant Color-Block', blurb: 'High-energy. Full-bleed colour blocks, oversized type, hard shadows, playful 3D shapes.', sw: ['#2563eb', '#fb5a3c', '#c7f24a', '#fff7e8'] },
  { n: '04', slug: 'cinematic', name: 'Cinematic Imagery-Led', blurb: 'Immersive. Full-bleed photography with gradient overlays and big type over images.', sw: ['#0a0a0f', '#f97316', '#22d3ee', '#e2e8f0'] },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Homepage Design Directions — Future Career School</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #06060c; color: #e7e7f0; font-family: "Inter", sans-serif; -webkit-font-smoothing: antialiased; min-height: 100vh; }
    .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .bg::before, .bg::after { content: ''; position: absolute; border-radius: 50%; filter: blur(120px); opacity: .5; }
    .bg::before { width: 50vw; height: 50vw; top: -10vw; left: -8vw; background: radial-gradient(circle, #7c3aed, transparent 65%); }
    .bg::after { width: 45vw; height: 45vw; bottom: -12vw; right: -8vw; background: radial-gradient(circle, #22d3ee, transparent 65%); }
    .wrap { position: relative; z-index: 1; max-width: 1080px; margin: 0 auto; padding: 6rem 1.5rem; }
    .kicker { font-family: "Space Grotesk", sans-serif; font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: #9aa0c0; margin-bottom: 1rem; }
    h1 { font-family: "Space Grotesk", sans-serif; font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; margin-bottom: 1rem; }
    h1 b { background: linear-gradient(110deg, #a78bfa, #22d3ee, #ec4899); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .sub { color: #9aa0c0; font-size: 17px; line-height: 1.7; max-width: 60ch; margin-bottom: 3.2rem; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.3rem; }
    a.card { display: block; text-decoration: none; color: inherit; border-radius: 22px; padding: 1.8rem; position: relative; overflow: hidden;
      background: linear-gradient(160deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); border: 1px solid rgba(255,255,255,.12); transition: transform .3s, border-color .3s, box-shadow .3s; }
    a.card:hover { transform: translateY(-6px); border-color: rgba(167,139,250,.5); box-shadow: 0 30px 60px -28px rgba(0,0,0,.8); }
    .n { font-family: "Space Grotesk", sans-serif; font-size: 13px; font-weight: 700; color: #7c3aed; letter-spacing: .1em; }
    .name { font-family: "Space Grotesk", sans-serif; font-size: 1.5rem; font-weight: 700; margin: .4rem 0 .6rem; letter-spacing: -.02em; }
    .blurb { color: #9aa0c0; font-size: 14.5px; line-height: 1.65; margin-bottom: 1.3rem; }
    .sw { display: flex; gap: 8px; margin-bottom: 1.2rem; }
    .sw span { width: 30px; height: 30px; border-radius: 9px; border: 1px solid rgba(255,255,255,.15); }
    .go { font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 14px; color: #fff; display: inline-flex; align-items: center; gap: 8px; }
    .go::after { content: '→'; transition: transform .25s; }
    a.card:hover .go::after { transform: translateX(5px); }
    .note { margin-top: 3rem; font-size: 13.5px; color: #7c819f; }
    @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="bg"></div>
  <div class="wrap">
    <div class="kicker">Future Career School</div>
    <h1>Six homepage <b>design directions</b> to choose from.</h1>
    <p class="sub">Same brand, six completely different visual worlds. The top two (05 &amp; 06) push graphics, 3D and motion to the maximum — live particle systems, real 3D scenes, gooey liquid morphing, kinetic type. Each demo uses minimal placeholder copy and goes heavy on design. Open each, then tell me which one to build the real homepage in.</p>
    <div class="grid">
      {directions.map((d) => (
        <a class="card" href={`/design-demos/${d.slug}/`}>
          <div class="sw">{d.sw.map((c) => <span style={`background:${c}`}></span>)}</div>
          <div class="n">DIRECTION {d.n}</div>
          <div class="name">{d.name}</div>
          <p class="blurb">{d.blurb}</p>
          <span class="go">View this direction</span>
        </a>
      ))}
    </div>
    <p class="note">These pages are explorations only — your live homepage is unchanged.</p>
  </div>
</body>
</html>
