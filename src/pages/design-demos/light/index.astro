---
const photo = (seed, w = 900, h = 1100) => `https://picsum.photos/seed/${seed}/${w}/${h}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Direction 02 · Luminous Light Editorial — Future Career School</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--paper:#f7f4ee;--paper2:#efe9df;--ink:#16131c;--muted:#5b5560;--indigo:#4f46e5;--coral:#ff5a3c;--line:#e2dbcf}
    html{scroll-behavior:smooth}
    body{background:var(--paper);color:var(--ink);font-family:"Inter",sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    .serif{font-family:"Fraunces",serif}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    .wrap{max-width:1200px;margin:0 auto;padding:0 1.6rem}
    .badge{position:fixed;top:14px;left:14px;z-index:50;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;padding:8px 14px;border-radius:999px;background:#fff;border:1px solid var(--line);box-shadow:0 8px 24px rgba(60,40,20,.1);color:var(--muted)}
    .badge b{color:var(--ink)}
    nav.bar{position:sticky;top:0;z-index:40;background:rgba(247,244,238,.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
    .nav-in{display:flex;align-items:center;justify-content:space-between;height:76px}
    .logo{font-family:"Fraunces",serif;font-weight:700;font-size:20px;letter-spacing:-.01em}
    .logo span{font-style:italic;color:var(--indigo)}
    .nav-links{display:flex;gap:28px;font-size:14px;color:var(--muted);font-weight:500}
    .nav-links a:hover{color:var(--ink)}
    .btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;padding:13px 24px;border-radius:999px;cursor:pointer;transition:transform .25s,box-shadow .3s,background .25s}
    .btn-n{background:var(--ink);color:#fff}
    .btn-n:hover{transform:translateY(-2px);background:var(--indigo);box-shadow:0 14px 30px -10px rgba(79,70,229,.5)}
    .btn-g{border:1px solid var(--ink);color:var(--ink)}
    .btn-g:hover{transform:translateY(-2px);background:rgba(0,0,0,.04)}
    @media(max-width:860px){.nav-links{display:none}}
    /* hero */
    .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:3.5rem;align-items:center;padding:4.5rem 0 5rem}
    .eye{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--indigo);font-weight:600;margin-bottom:1.4rem;display:flex;align-items:center;gap:.7rem}
    .eye::before{content:"";width:30px;height:2px;background:var(--coral)}
    .hero h1{font-family:"Fraunces",serif;font-weight:600;font-size:clamp(2.8rem,6vw,5rem);line-height:1.02;letter-spacing:-.02em;margin-bottom:1.5rem}
    .hero h1 em{font-style:italic;color:var(--indigo)}
    .hero p.lead{color:var(--muted);font-size:19px;line-height:1.65;max-width:42ch;margin-bottom:2.2rem}
    .cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:2.4rem}
    .meta{display:flex;gap:24px;flex-wrap:wrap;font-size:14px;color:var(--muted)}
    .meta b{font-family:"Fraunces",serif;font-size:22px;color:var(--ink);display:block;font-weight:700}
    .hero-art{position:relative}
    .hero-art .frame{border-radius:200px 200px 18px 18px;overflow:hidden;aspect-ratio:4/5;box-shadow:0 40px 80px -30px rgba(60,40,20,.4)}
    .hero-art .frame img{width:100%;height:100%;object-fit:cover}
    .hero-art .float{position:absolute;background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px 16px;box-shadow:0 20px 50px -16px rgba(60,40,20,.28)}
    .hf1{top:8%;left:-7%;animation:bob 6s ease-in-out infinite}
    .hf2{bottom:10%;right:-6%;animation:bob 7s ease-in-out infinite .6s}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
    .hf-k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
    .hf-v{font-family:"Fraunces",serif;font-weight:700;font-size:20px}
    .dotgrid{position:absolute;width:120px;height:120px;background-image:radial-gradient(var(--indigo) 1.5px,transparent 1.5px);background-size:16px 16px;opacity:.25;bottom:-24px;left:-24px;z-index:-1}
    /* sections */
    .sec{padding:6rem 0;border-top:1px solid var(--line)}
    .lab{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--coral);font-weight:600;margin-bottom:1rem}
    h2.t{font-family:"Fraunces",serif;font-weight:600;font-size:clamp(2rem,4vw,3.2rem);line-height:1.06;letter-spacing:-.02em;margin-bottom:1rem;max-width:18ch}
    h2.t em{font-style:italic;color:var(--indigo)}
    .sub{color:var(--muted);font-size:17px;line-height:1.7;max-width:58ch;margin-bottom:3rem}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff}
    .stat{padding:2rem;border-right:1px solid var(--line)}
    .stat:last-child{border-right:0}
    .stat .num{font-family:"Fraunces",serif;font-weight:700;font-size:2.6rem;letter-spacing:-.02em}
    .stat .num span{color:var(--indigo)}
    .stat .cap{color:var(--muted);font-size:14px;margin-top:6px}
    /* who */
    .duo{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem}
    .pcard{background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden;transition:transform .35s,box-shadow .35s}
    .pcard:hover{transform:translateY(-6px);box-shadow:0 36px 70px -34px rgba(60,40,20,.35)}
    .ph{aspect-ratio:16/10;overflow:hidden}
    .ph img{width:100%;height:100%;object-fit:cover}
    .pc-body{padding:1.8rem}
    .pc-k{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--indigo);font-weight:600}
    .pc-body h3{font-family:"Fraunces",serif;font-weight:600;font-size:1.6rem;margin:.5rem 0 .6rem}
    .pc-body p{color:var(--muted);font-size:15px;line-height:1.7}
    /* steps editorial list */
    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem}
    .step{padding-top:1.4rem;border-top:2px solid var(--ink)}
    .step .no{font-family:"Fraunces",serif;font-weight:700;font-size:2.2rem;color:var(--indigo)}
    .step h3{font-size:1.1rem;margin:.5rem 0 .4rem}
    .step p{color:var(--muted);font-size:14px;line-height:1.6}
    /* cta */
    .cta{background:var(--ink);color:#fff;border-radius:28px;padding:4.5rem 2rem;text-align:center}
    .cta h2{font-family:"Fraunces",serif;font-weight:600;font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.05;margin-bottom:1rem}
    .cta h2 em{font-style:italic;color:#c4bdff}
    .cta p{color:rgba(255,255,255,.7);max-width:48ch;margin:0 auto 2rem;font-size:17px;line-height:1.6}
    .cta .btn-n{background:#fff;color:var(--ink)}
    .cta .btn-n:hover{background:var(--coral);color:#fff}
    .cta .btn-g{border-color:rgba(255,255,255,.4);color:#fff}
    footer{padding:3rem 0;color:var(--muted);font-size:13px;text-align:center;border-top:1px solid var(--line)}
    .reveal{opacity:0;transform:translateY(26px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
    .reveal.in{opacity:1;transform:none}
    @media(max-width:980px){.hero{grid-template-columns:1fr;gap:3rem}.steps{grid-template-columns:repeat(2,1fr)}.duo{grid-template-columns:1fr}}
    @media(max-width:600px){.stats{grid-template-columns:1fr}.stat{border-right:0;border-bottom:1px solid var(--line)}.steps{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){.hf1,.hf2{animation:none}.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <a class="badge" href="/design-demos/"><b>02 · Luminous Light</b> — ← all directions</a>

  <nav class="bar"><div class="wrap nav-in">
    <div class="logo">Future <span>Career</span> School</div>
    <div class="nav-links"><a href="#">Services</a><a href="#">Career & Skills Compass</a><a href="#">Resources</a><a href="#">Blog</a></div>
    <a class="btn btn-n" href="#">Get Career Guidance</a>
  </div></nav>

  <header class="wrap hero">
    <div>
      <div class="eye">Career guidance for every stage</div>
      <h1 class="serif">Choose your path with <em>real clarity</em> — not guesswork.</h1>
      <p class="lead">Practical, skill-first guidance for students, freshers, and professionals. Build proof of work and a roadmap toward earlier financial freedom — fully online.</p>
      <div class="cta-row">
        <a class="btn btn-n" href="#">Get Career Guidance →</a>
        <a class="btn btn-g" href="#">Free Assessments</a>
      </div>
      <div class="meta"><span><b>10,000+</b> guided</span><span><b>4.9/5</b> rating</span><span><b>All-India</b> online</span></div>
    </div>
    <div class="hero-art">
      <div class="dotgrid"></div>
      <div class="frame"><img src={photo('fcs-light-hero')} alt="A student mapping out their career path" width="900" height="1100" loading="eager"/></div>
      <div class="float hf1"><div class="hf-k">Your fit</div><div class="hf-v">Skill-first</div></div>
      <div class="float hf2"><div class="hf-k">Freedom Number</div><div class="hf-v">On track</div></div>
    </div>
  </header>

  <section class="wrap sec">
    <div class="stats">
      <div class="stat reveal"><div class="num">10,000<span>+</span></div><div class="cap">students &amp; professionals guided</div></div>
      <div class="stat reveal"><div class="num">4.9<span>/5</span></div><div class="cap">average rating on clarity</div></div>
      <div class="stat reveal"><div class="num">100<span>%</span></div><div class="cap">online — every city in India</div></div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="lab">Who we work with</div>
    <h2 class="t reveal serif">Guidance for <em>every growth stage.</em></h2>
    <p class="sub reveal">Two paths, one foundation — practical assessments, high-value skills, and a roadmap you actually execute.</p>
    <div class="duo">
      <div class="pcard reveal"><div class="ph"><img src={photo('fcs-light-stu',900,560)} alt="Students collaborating" width="900" height="560" loading="lazy"/></div><div class="pc-body"><div class="pc-k">Students &amp; Freshers</div><h3 class="serif">Direction before pressure</h3><p>Stream, course, and early skill clarity — avoid expensive wrong turns and start building proof early.</p></div></div>
      <div class="pcard reveal"><div class="ph"><img src={photo('fcs-light-pro',900,560)} alt="A professional reviewing their plan" width="900" height="560" loading="lazy"/></div><div class="pc-body"><div class="pc-k">Working Professionals</div><h3 class="serif">Leverage &amp; income growth</h3><p>Beat stagnation with stronger positioning, high-value skill stacking, and new income options.</p></div></div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="lab">The path</div>
    <h2 class="t reveal serif">Four steps to a <em>stronger next move.</em></h2>
    <div class="steps">
      <div class="step reveal"><div class="no serif">01</div><h3>Map your fit</h3><p>Strengths and work-style mapping before big decisions.</p></div>
      <div class="step reveal"><div class="no serif">02</div><h3>Pick the skill</h3><p>Interest, market, and scalability — choose what pays.</p></div>
      <div class="step reveal"><div class="no serif">03</div><h3>Build proof</h3><p>Portfolio and positioning that gets you found.</p></div>
      <div class="step reveal"><div class="no serif">04</div><h3>Reach freedom</h3><p>Your Freedom Number and a compounding plan.</p></div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="cta reveal">
      <h2 class="serif">Get guidance for the <em>right next move.</em></h2>
      <p>Start with practical clarity. Continue only if you need deeper support.</p>
      <div class="cta-row" style="justify-content:center"><a class="btn btn-n" href="#">Get Career Guidance →</a><a class="btn btn-g" href="#">Free Assessments</a></div>
    </div>
  </section>

  <footer class="wrap">Future Career School · Luminous Light editorial exploration</footer>

  <script>
    const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
  </script>
</body>
</html>
