---
const photo = (seed, w = 1600, h = 1000) => `https://picsum.photos/seed/${seed}/${w}/${h}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Direction 04 · Cinematic Imagery-Led — Future Career School</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--ink:#0a0a0f;--amber:#f97316;--cyan:#22d3ee;--paper:#e8eaf0;--muted:#a6abbd}
    html{scroll-behavior:smooth}
    body{background:var(--ink);color:var(--paper);font-family:"Inter",sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    h1,h2,h3,.dsp{font-family:"Sora",sans-serif;letter-spacing:-.03em;line-height:1.04}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    .grad{background:linear-gradient(100deg,#fb923c,#22d3ee);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
    .wrap{max-width:1180px;margin:0 auto;padding:0 1.6rem;position:relative;z-index:2}
    .badge{position:fixed;top:14px;left:14px;z-index:60;font-size:12px;font-weight:600;padding:8px 14px;border-radius:999px;background:rgba(10,10,15,.7);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(10px);color:#dfe3ef}
    .badge b{color:#fff}
    nav.bar{position:fixed;top:0;left:0;right:0;z-index:50;height:74px;display:flex;align-items:center;backdrop-filter:blur(6px);background:linear-gradient(180deg,rgba(10,10,15,.6),transparent)}
    .nav-in{display:flex;align-items:center;justify-content:space-between;width:100%}
    .logo{font-family:"Sora";font-weight:800;font-size:18px}
    .nav-links{display:flex;gap:26px;font-size:14px;color:#c7ccdb}
    .nav-links a:hover{color:#fff}
    .btn{display:inline-flex;align-items:center;gap:8px;font-family:"Sora";font-weight:700;font-size:14px;padding:12px 22px;border-radius:12px;cursor:pointer;transition:transform .25s,box-shadow .3s}
    .btn-n{color:#0a0a0f;background:linear-gradient(135deg,#fb923c,#f97316);box-shadow:0 10px 30px -8px rgba(249,115,22,.6)}
    .btn-n:hover{transform:translateY(-2px)}
    .btn-g{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.08);color:#fff;backdrop-filter:blur(8px)}
    .btn-g:hover{transform:translateY(-2px);border-color:#fff}
    @media(max-width:860px){.nav-links{display:none}}
    /* cinematic full-bleed hero */
    .hero{position:relative;min-height:100vh;display:flex;align-items:flex-end;padding:0 0 6rem;overflow:hidden}
    .hero .bgimg{position:absolute;inset:0;z-index:0}
    .hero .bgimg img{width:100%;height:100%;object-fit:cover}
    .hero .bgimg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,15,.55) 0%,rgba(10,10,15,.2) 35%,rgba(10,10,15,.92) 100%),linear-gradient(90deg,rgba(10,10,15,.75),transparent 60%)}
    .hero .bgimg::before{content:"";position:absolute;inset:0;z-index:1;background:radial-gradient(900px 500px at 80% 10%,rgba(34,211,238,.22),transparent 70%);mix-blend-mode:screen}
    .eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#dfe3ef;padding:7px 14px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(8px);margin-bottom:1.5rem}
    .eye i{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
    .hero h1{font-size:clamp(2.8rem,7vw,5.6rem);font-weight:800;max-width:16ch;margin-bottom:1.3rem;text-shadow:0 2px 30px rgba(0,0,0,.5)}
    .hero p.lead{font-size:19px;line-height:1.6;max-width:46ch;color:#d3d7e4;margin-bottom:2rem}
    .cta-row{display:flex;gap:14px;flex-wrap:wrap}
    .scrollcue{position:absolute;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:2;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#9aa0b4}
    /* stat ribbon */
    .ribbon{display:flex;flex-wrap:wrap;gap:2.5rem;padding:2.4rem 0;border-bottom:1px solid rgba(255,255,255,.1)}
    .rb{flex:1;min-width:160px}
    .rb .num{font-family:"Sora";font-weight:800;font-size:2.2rem}
    .rb .cap{color:var(--muted);font-size:13px;margin-top:2px}
    /* full-bleed bands */
    .band{position:relative;min-height:88vh;display:flex;align-items:center;overflow:hidden}
    .band .bgimg{position:absolute;inset:0;z-index:0}
    .band .bgimg img{width:100%;height:100%;object-fit:cover}
    .band.left .bgimg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,15,.92),rgba(10,10,15,.55) 55%,transparent),linear-gradient(0deg,rgba(10,10,15,.6),transparent 50%)}
    .band.right{justify-content:flex-end;text-align:right}
    .band.right .bgimg::after{content:"";position:absolute;inset:0;background:linear-gradient(270deg,rgba(10,10,15,.92),rgba(10,10,15,.55) 55%,transparent),linear-gradient(0deg,rgba(10,10,15,.6),transparent 50%)}
    .band-c{max-width:46ch}
    .band.right .band-c{margin-left:auto}
    .lab{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);font-weight:600;margin-bottom:1rem}
    .band h2{font-size:clamp(2rem,4.6vw,3.4rem);font-weight:800;margin-bottom:1rem}
    .band p{color:#cdd2e1;font-size:17px;line-height:1.7;margin-bottom:1.4rem}
    .pill-list{display:flex;gap:10px;flex-wrap:wrap}
    .band.right .pill-list{justify-content:flex-end}
    .pill-list span{font-size:13px;padding:7px 13px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2)}
    /* steps over dark */
    .sec{padding:6rem 0}
    .sec h2.t{font-size:clamp(1.9rem,3.6vw,2.8rem);font-weight:800;margin-bottom:.8rem}
    .sub{color:var(--muted);font-size:16px;line-height:1.7;max-width:56ch;margin-bottom:2.6rem}
    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}
    .step{border-radius:18px;padding:1.5rem;background:linear-gradient(160deg,rgba(255,255,255,.07),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.12);transition:transform .3s,box-shadow .3s}
    .step:hover{transform:translateY(-6px);box-shadow:0 30px 60px -30px #000}
    .step .no{font-family:"Sora";font-weight:800;font-size:1.5rem}
    .step h3{font-size:1.05rem;margin:.5rem 0 .4rem}
    .step p{color:var(--muted);font-size:13.5px;line-height:1.6}
    /* cta over image */
    .cta{position:relative;min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}
    .cta .bgimg{position:absolute;inset:0;z-index:0}
    .cta .bgimg img{width:100%;height:100%;object-fit:cover}
    .cta .bgimg::after{content:"";position:absolute;inset:0;background:radial-gradient(700px 400px at 50% 50%,rgba(10,10,15,.6),rgba(10,10,15,.92))}
    .cta-c{position:relative;z-index:2;max-width:42ch;padding:0 1.5rem}
    .cta h2{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:800;margin-bottom:1rem}
    .cta p{color:#d3d7e4;font-size:18px;line-height:1.6;margin-bottom:2rem}
    footer{padding:3rem 0;border-top:1px solid rgba(255,255,255,.08);color:#8b90a3;font-size:13px;text-align:center}
    .reveal{opacity:0;transform:translateY(28px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
    .reveal.in{opacity:1;transform:none}
    @media(max-width:860px){.steps{grid-template-columns:repeat(2,1fr)}.band,.band.right{text-align:left;justify-content:flex-start}.band.right .band-c{margin-left:0}.band.right .pill-list{justify-content:flex-start}}
    @media(max-width:600px){.steps{grid-template-columns:1fr}.ribbon{gap:1.4rem}}
    @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <a class="badge" href="/design-demos/"><b>04 · Cinematic</b> — ← all directions</a>

  <nav class="bar"><div class="wrap nav-in">
    <div class="logo">Future<span class="grad"> Career</span> School</div>
    <div class="nav-links"><a href="#">Services</a><a href="#">Career & Skills Compass</a><a href="#">Resources</a><a href="#">Blog</a></div>
    <a class="btn btn-n" href="#">Get Guidance</a>
  </div></nav>

  <header class="hero">
    <div class="bgimg"><img src={photo('fcs-cine-hero')} alt="A person looking toward their future" width="1600" height="1000" loading="eager"/></div>
    <div class="wrap">
      <div class="eye"><i></i> Career guidance for every stage</div>
      <h1 class="dsp">Your next move, <span class="grad">in focus.</span></h1>
      <p class="lead">Practical, skill-first guidance with proof of work and a roadmap toward earlier financial freedom — fully online, across India.</p>
      <div class="cta-row"><a class="btn btn-n" href="#">Get Career Guidance →</a><a class="btn btn-g" href="#">Free Assessments</a></div>
    </div>
    <div class="scrollcue">Scroll ↓</div>
  </header>

  <section class="wrap"><div class="ribbon">
    <div class="rb reveal"><div class="num grad">10,000+</div><div class="cap">students &amp; professionals guided</div></div>
    <div class="rb reveal"><div class="num grad">4.9/5</div><div class="cap">average rating on clarity</div></div>
    <div class="rb reveal"><div class="num grad">100%</div><div class="cap">online — every city in India</div></div>
  </div></section>

  <section class="band left">
    <div class="bgimg"><img src={photo('fcs-cine-stu')} alt="Students working together" width="1600" height="1000" loading="lazy"/></div>
    <div class="wrap"><div class="band-c reveal">
      <div class="lab">Students &amp; Freshers</div>
      <h2 class="dsp">Direction before the pressure hits.</h2>
      <p>Stream, course, and early skill clarity — so you avoid expensive wrong turns and start building real proof early.</p>
      <div class="pill-list"><span>Stream &amp; course fit</span><span>Strength mapping</span><span>Free assessments</span></div>
    </div></div>
  </section>

  <section class="band right">
    <div class="bgimg"><img src={photo('fcs-cine-pro')} alt="A professional in their workspace" width="1600" height="1000" loading="lazy"/></div>
    <div class="wrap"><div class="band-c reveal">
      <div class="lab">Working Professionals</div>
      <h2 class="dsp">Leverage, pivots, and income growth.</h2>
      <p>Beat stagnation and AI pressure with stronger positioning, high-value skill stacking, and new income options.</p>
      <div class="pill-list"><span>Positioning</span><span>Skill stacking</span><span>Income optionality</span></div>
    </div></div>
  </section>

  <section class="wrap sec">
    <h2 class="t reveal dsp">From confusion to a clear roadmap.</h2>
    <p class="sub reveal">Four steps, in order, without skipping.</p>
    <div class="steps">
      <div class="step reveal"><div class="no grad">01</div><h3>Map your fit</h3><p>Strengths and work-style mapping first.</p></div>
      <div class="step reveal"><div class="no grad">02</div><h3>Pick the skill</h3><p>Interest, market, and scalability.</p></div>
      <div class="step reveal"><div class="no grad">03</div><h3>Build proof</h3><p>Portfolio and positioning that gets you found.</p></div>
      <div class="step reveal"><div class="no grad">04</div><h3>Reach freedom</h3><p>Your Freedom Number and a compounding plan.</p></div>
    </div>
  </section>

  <section class="cta">
    <div class="bgimg"><img src={photo('fcs-cine-cta')} alt="Open road ahead" width="1600" height="900" loading="lazy"/></div>
    <div class="cta-c reveal">
      <h2 class="dsp">Get guidance for the right next move.</h2>
      <p>Start with practical clarity. Continue only if you need deeper support.</p>
      <div class="cta-row" style="justify-content:center"><a class="btn btn-n" href="#">Get Career Guidance →</a><a class="btn btn-g" href="#">Free Assessments</a></div>
    </div>
  </section>

  <footer class="wrap">Future Career School · Cinematic Imagery-Led exploration</footer>

  <script>
    const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
  </script>
</body>
</html>
