    audience: ["professional"], topic: "portfolio", type: "guide", readTime: "9 min", tags: ["Personal Branding","Content Strategy"] },
  { title: "Resume That Gets Shortlisted in India",
    desc: "ATS, formatting, keywords, and what Indian recruiters actually read first — with before/after examples and a template.",
    audience: ["student","graduate","professional"], topic: "portfolio", type: "guide", readTime: "11 min", tags: ["Resume","ATS"] },

  // ── JOB SEARCH & INTERVIEW ──

  // ── CITY CAREER GUIDES ──

  // ── FOR COACHES & COUNSELORS ──

  // ── INTERNATIONAL ──
];

