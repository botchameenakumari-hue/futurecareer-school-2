---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SKILL_EVIDENCE_DATASET_META, SKILL_EVIDENCE_RECORDS } from '../../config/skillEvidenceDataset';

const title = 'Skill Evidence Project Library Dataset 2026 | Future Career School';
const description = 'Download Future Career School’s editorial skill-project library with practice levels, effort, outcomes and evidence prompts.';
const canonical = 'https://futurecareerschool.com/datasets/skill-evidence-library-2026/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'Future Career School editorial skill evidence project library 2026', description, url: canonical, dateModified: '2026-10-11', isAccessibleForFree: true, creator: { '@type': 'Organization', name: 'Future Career School', url: 'https://futurecareerschool.com/' }, distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://futurecareerschool.com/data/skill-evidence-library-2026.json' }, { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://futurecareerschool.com/data/skill-evidence-library-2026.csv' }] };
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav /><main class="dataset-page"><div class="dataset-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Dataset</span></nav>
    <p class="dataset-kicker">FREE EDITORIAL DATASET · {SKILL_EVIDENCE_DATASET_META.version.toUpperCase()}</p>
    <h1>Skill evidence project library</h1>
    <p class="dataset-lead">A downloadable map of small practice projects that turn a self-rated skill into observable work, reflection and portfolio evidence.</p>
    <div class="dataset-actions"><a href="/data/skill-evidence-library-2026.csv" download>Download CSV</a><a href="/data/skill-evidence-library-2026.json" download>Download JSON</a></div>
    <div class="dataset-callout"><b>Scope:</b> {SKILL_EVIDENCE_RECORDS.length} authored project prompts from the school’s editorial library. <b>Limits:</b> completion and evidence are self-reported; the prompts do not promise employment, income, clients or hiring outcomes, and the library is not a validated predictor.</div>
    <h2>Included project prompts</h2>
    <div class="dataset-table-wrap"><table><thead><tr><th>Skill</th><th>Level</th><th>Project</th><th>Hours</th><th>Finished outcome</th><th>Evidence prompts</th></tr></thead><tbody>{SKILL_EVIDENCE_RECORDS.map((record) => <tr><td>{record.skill}</td><td>{record.level}</td><td><strong>{record.title}</strong></td><td>{record.hours}</td><td>{record.outcome}</td><td>{record.proof.join(' · ')}</td></tr>)}</tbody></table></div>
    <p class="dataset-note">This dataset describes prompts, not participant results. Keep the provenance and limits attached when reusing it. Read the <a href="/data-policy/">data and research policy</a>.</p>
    <p><a href="/services/assessments/skill-portfolio-tracker/">Use the skill portfolio tracker</a> · <a href="/research-and-datasets/">View the publication registry</a></p>
  </div></main><Footer />
</BaseLayout>
<style>
  .dataset-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.dataset-shell{max-width:1150px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.dataset-page a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.dataset-kicker{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.dataset-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.dataset-lead{max-width:820px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.dataset-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.5rem 0}.dataset-actions a{display:inline-flex;align-items:center;min-height:44px;padding:.55rem .9rem;border-radius:10px;background:#e5b84a;color:#17130a!important;font-weight:800;text-decoration:none!important}.dataset-actions a+a{background:rgba(255,255,255,.08);color:#fff!important;border:1px solid rgba(255,255,255,.22)}.dataset-callout{padding:1rem 1.1rem;border:1px solid rgba(229,184,74,.4);border-radius:14px;background:rgba(229,184,74,.08);line-height:1.7;color:rgba(255,255,255,.78)}.dataset-page h2{margin:2rem 0 .7rem;color:#fff}.dataset-table-wrap{overflow-x:auto;margin:1.5rem 0}.dataset-table-wrap table{width:100%;min-width:1100px;border-collapse:collapse}.dataset-table-wrap th,.dataset-table-wrap td{padding:.75rem;border:1px solid rgba(255,255,255,.15);vertical-align:top;text-align:left;line-height:1.55}.dataset-table-wrap th{background:rgba(18,154,141,.18);color:#fff}.dataset-table-wrap td{color:rgba(255,255,255,.72)}.dataset-note{color:rgba(255,255,255,.62);line-height:1.7}
</style>
