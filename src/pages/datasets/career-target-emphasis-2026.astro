---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { CAREER_TARGET_DATASET_META, CAREER_TARGET_RECORDS } from '../../config/careerTargetDataset';

const title = 'Career Target Skill Emphasis Dataset 2026 | Future Career School';
const description = 'Download Future Career School’s editorial directional skill-emphasis model for broad career targets, with proof ideas and first moves.';
const canonical = 'https://futurecareerschool.com/datasets/career-target-emphasis-2026/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'Future Career School editorial career-target skill-emphasis model 2026', description, url: canonical, dateModified: '2026-10-11', isAccessibleForFree: true, creator: { '@type': 'Organization', name: 'Future Career School', url: 'https://futurecareerschool.com/' }, distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://futurecareerschool.com/data/career-target-emphasis-2026.json' }, { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://futurecareerschool.com/data/career-target-emphasis-2026.csv' }] };
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Nav /><main class="dataset-page"><div class="dataset-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Dataset</span></nav>
    <p class="dataset-kicker">FREE EDITORIAL DATASET · {CAREER_TARGET_DATASET_META.version.toUpperCase()}</p>
    <h1>Career-target skill emphasis model</h1>
    <p class="dataset-lead">A downloadable directional model showing which of nine practical skills the school’s broad career targets tend to emphasise, plus a first proof idea and a first move.</p>
    <div class="dataset-actions"><a href="/data/career-target-emphasis-2026.csv" download>Download CSV</a><a href="/data/career-target-emphasis-2026.json" download>Download JSON</a></div>
    <div class="dataset-callout"><b>Important:</b> the 1–5 values are editorial emphasis bands for comparing a learner’s self-rating with a direction. They are not hiring requirements, eligibility rules, salary data, labour-market data or employability predictions. Employers and roles differ, so current job descriptions, course rules and supervised practice remain authoritative.</div>
    <h2>Included career targets</h2>
    <div class="dataset-table-wrap"><table><thead><tr><th>Target</th><th>Family</th><th>Skill emphasis order</th><th>First proof idea</th><th>First move</th></tr></thead><tbody>{CAREER_TARGET_RECORDS.map((record) => <tr><td><strong>{record.name}</strong></td><td>{record.family}</td><td>{record.skillEmphasis.join(' · ')}</td><td>{record.firstProof}</td><td>{record.firstMove}</td></tr>)}</tbody></table></div>
    <p class="dataset-note">The JSON includes the skill-key order needed to interpret the emphasis bands. Read the <a href="/data-policy/">data and research policy</a> before reusing this editorial model.</p>
    <p><a href="/services/assessments/skill-portfolio-tracker/">Use the skill portfolio tracker</a> · <a href="/research-and-datasets/">View the publication registry</a></p>
  </div></main><Footer />
</BaseLayout>
<style>
  .dataset-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.dataset-shell{max-width:1150px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.dataset-page a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.dataset-kicker{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.dataset-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.dataset-lead{max-width:820px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.dataset-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.5rem 0}.dataset-actions a{display:inline-flex;align-items:center;min-height:44px;padding:.55rem .9rem;border-radius:10px;background:#e5b84a;color:#17130a!important;font-weight:800;text-decoration:none!important}.dataset-actions a+a{background:rgba(255,255,255,.08);color:#fff!important;border:1px solid rgba(255,255,255,.22)}.dataset-callout{padding:1rem 1.1rem;border:1px solid rgba(229,184,74,.4);border-radius:14px;background:rgba(229,184,74,.08);line-height:1.7;color:rgba(255,255,255,.78)}.dataset-page h2{margin:2rem 0 .7rem;color:#fff}.dataset-table-wrap{overflow-x:auto;margin:1.5rem 0}.dataset-table-wrap table{width:100%;min-width:1100px;border-collapse:collapse}.dataset-table-wrap th,.dataset-table-wrap td{padding:.75rem;border:1px solid rgba(255,255,255,.15);vertical-align:top;text-align:left;line-height:1.55}.dataset-table-wrap th{background:rgba(18,154,141,.18);color:#fff}.dataset-table-wrap td{color:rgba(255,255,255,.72)}.dataset-note{color:rgba(255,255,255,.62);line-height:1.7}
</style>
