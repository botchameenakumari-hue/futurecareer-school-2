const jumpLinks = [
  { href: '#bridge-stages', label: 'Three-stage bridge' },
  { href: '#offer-design', label: 'First offer design' },
  { href: '#ninety-days', label: '90-day plan' },
  { href: '#runway-dashboard', label: 'Runway dashboard' },
  { href: '#quit-rule', label: 'When not to quit' },
