const relatedItems = [
  {
    href: '/career-resources/salary-negotiation-what-to-say-and-what-never-to-say/',
    title: 'Salary Negotiation: What to Say and What Never to Say',
    description: 'Open this next if you also need stronger language for offer-stage or compensation negotiation beyond the raise conversation.',
  },
  {
    href: '/career-resources/freedom-number-how-much-do-you-actually-need-to-earn/',
    title: 'Freedom Number: How Much Do You Actually Need to Earn?',
    description: 'Use this if your raise target still feels vague and you want a more useful income benchmark first.',
  },
  {
    href: '/career-resources/career-change-without-starting-over/',
    title: 'Career Change Without Starting Over',
    description: 'Open this if the real issue is not only raise timing but whether your current role is already too capped.',
  },
