    title: 'The 4-Checkpoint Career Protocol',
    description: 'Use this right after a sample to compare whether the skill deserves deeper backing.',
  },
  {
    href: '/career-resources/how-to-pick-the-right-online-course/',
    title: 'How to Pick the Right Online Course',
    description: 'Open this once a skill survives the sample and you need to choose the learning path.',
  },
  {
    href: '/career-skills-compass/',
    title: 'Career & Skills Compass',
    description: 'Use the Career & Skills Compass if you still need a broader shortlist before you test one skill deeply.',
  },
];

const visualBase = '/images/career-resources/skill-sampling-try-before-you-commit';
const visuals = {
  hero: `${visualBase}/skill-sampling-try-before-you-commit-hero.webp`,
  social: `${visualBase}/skill-sampling-try-before-you-commit-social.jpg`,
  summary: `${visualBase}/skill-sampling-try-before-you-commit-at-a-glance-summary.webp`,
  timeline: `${visualBase}/skill-sampling-try-before-you-commit-chronological-seven-day-sampling-method.webp`,
  samples: `${visualBase}/skill-sampling-try-before-you-commit-comparison-real-sample-looks-like.webp`,
