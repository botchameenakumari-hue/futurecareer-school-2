  { id: 'employability-gap', label: 'The employability gap nobody mentions' },
  { id: 'ai-risk', label: 'The AI question for engineering' },
  { id: 'other-streams', label: 'What the other streams actually pay' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
