---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';
import {
  CHART_META, OFFICIAL_LINKS, ROUTES, ROUTE_FAMILIES, TIMELINE, TIMELINE_NOTE,
  FLOW, CHECKPOINTS, GATES, MISTAKES, PDF_FILES,
} from '../../../../config/careerChartAfter10th.mjs';
import pdfMeta from '../../../../config/careerChartPdfMeta.json';

const title = 'Career Chart After 10th: Every Route Mapped, With Free PDFs';
const description =
  'Career chart after 10th as a real chart: science, commerce, arts, diploma, ITI and open schooling, what each keeps open, years to work, plus free PDF downloads.';
const canonical = 'https://futurecareerschool.com/blog/stream-selection/career-chart-after-10th/';
const publishedDateISO = '2026-10-10';
const publishedDateLabel = '10 October 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'download', label: 'Download the chart as PDF' },
  { id: 'chart', label: 'The chart: follow your route' },
  { id: 'timeline', label: 'Years until full-time work' },
  { id: 'doors', label: 'Which choice keeps which door open' },
  { id: 'science', label: 'Career chart after 10th: science' },
  { id: 'commerce', label: 'Career chart after 10th: commerce' },
  { id: 'arts', label: 'Career chart after 10th: arts' },
  { id: 'diploma-iti', label: 'Diploma, ITI and open schooling' },
  { id: 'variation', label: 'What changes by state and board' },
  { id: 'checks', label: 'Test the route you lean toward' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'parents', label: 'If you are a parent' },
  { id: 'next', label: 'What to do next' },
  { id: 'sources', label: 'Verify on official sources' },
  { id: 'faq', label: 'FAQs' },
];

const famColor = Object.fromEntries(ROUTE_FAMILIES.map((f) => [f.id, f.color]));
const famLabel = Object.fromEntries(ROUTE_FAMILIES.map((f) => [f.id, f.label]));
const routeById = Object.fromEntries(ROUTES.map((r) => [r.id, r]));
const yrs = (r: number[]) => (r[0] === r[1] ? `${r[0]} years` : `${r[0]} to ${r[1]} years`);
const bySection = (families: string[]) => ROUTES.filter((r) => families.includes(r.family));

// Doors table: which Class 11 / route choice keeps a later door open.
// yes = standard rule keeps it open, no = standard rule closes it, check = depends on the course or state.
const doorCols = ['PCM', 'PCB', 'PCMB', 'Commerce', 'Arts', 'Diploma', 'ITI'];
const doors = [
  { door: 'B.Tech / B.E. degree', cells: ['yes', 'no', 'yes', 'no', 'no', 'check', 'no'], note: 'Needs Maths in Class 12. A diploma can lead to second-year lateral entry; verify the state and college.' },
  { door: 'MBBS, BDS and NEET medical seats', cells: ['no', 'yes', 'yes', 'no', 'no', 'no', 'no'], note: 'Needs Biology in Class 12 with NEET UG.' },
  { door: 'CA, CMA, CS professional courses', cells: ['yes', 'yes', 'yes', 'yes', 'yes', 'check', 'check'], note: 'Open to every stream after Class 12; commerce subjects make the first exams easier.' },
  { door: 'Law (integrated 5-year)', cells: ['yes', 'yes', 'yes', 'yes', 'yes', 'check', 'check'], note: 'Entry tests such as CLAT and CUET take students from any stream after Class 12.' },
  { door: 'Design degrees', cells: ['yes', 'yes', 'yes', 'yes', 'yes', 'check', 'check'], note: 'Design entrance tests usually accept any stream; the portfolio carries the weight.' },
  { door: 'BBA, B.Com, BMS', cells: ['yes', 'yes', 'yes', 'yes', 'yes', 'check', 'check'], note: 'Most accept any stream; some want Maths or Accountancy. Check each college.' },
  { door: 'BCA and computing degrees', cells: ['yes', 'check', 'yes', 'check', 'check', 'check', 'no'], note: 'Many colleges ask for Maths or Computer subjects in Class 12. Read the rule on each admission page.' },
  { door: 'NDA (Air Force and Navy wings)', cells: ['yes', 'no', 'yes', 'no', 'no', 'no', 'no'], note: 'Needs Physics and Maths in Class 12. The Army wing accepts other streams; check the current notice.' },
  { door: 'Civil services and many government exams', cells: ['yes', 'yes', 'yes', 'yes', 'yes', 'check', 'check'], note: 'These ask for a degree in any subject, so no stream closes them. Diploma and ITI holders need to add a degree first.' },
];
const symbol = { yes: '✓', no: '✕', check: 'Check' };

// Pre-render the decision flow as nested HTML.
function flowHtml(id: string): string {
  const term = FLOW.terminals[id];
  if (term) {
    const r = routeById[term];
    return `<a class="fterm" href="#route-${r.id}" style="background:${famColor[r.family]}">${r.label}<small>${yrs(r.yearsToWork)} to work</small></a>`;
  }
  const n = FLOW.nodes[id];
  const opts = n.options
    .map((o: { label: string; to: string }) => `<li class="fopt"><span class="farrow">${o.label}</span><span class="fto">${flowHtml(o.to)}</span></li>`)
    .join('');
  return `<div class="fnode">${n.question}</div><ul class="fopts">${opts}</ul>`;
}
const flowMarkup = flowHtml(FLOW.start);

const maxYears = 8;
const metaMap: Record<string, { pages: number | null; kb: number }> = pdfMeta;
const pdfCards = PDF_FILES.map((p) => ({ ...p, meta: metaMap[p.file] }));
const sym = (c: string) => symbol[c as 'yes' | 'no' | 'check'];

const faqItems = [
  {
    q: 'Where can I download a career chart after 10th as a PDF?',
    a: 'Use the free PDF download section on this page. There is one chart with every route, plus separate PDFs for science, commerce, arts and humanities, and diploma, ITI and open schooling. They download straight away, with no sign-up or email needed, and each one shows the date it was last checked.',
  },
  {
    q: 'What is a career guidance chart after 10th supposed to show?',
    a: 'A useful career guidance chart after 10th shows the route, how long it takes, what it keeps open, what it closes and what to verify. A list of job titles without those four things only tells you what exists, not what fits.',
  },
  {
    q: 'Which route after 10th is best?',
    a: 'No route is best for everyone. Science with Maths keeps engineering open, science with Biology keeps medicine open, commerce and arts keep many degrees and professional courses open, and diploma or ITI starts earning sooner. The best route is the one you can sustain, that your family can afford, and that you can build proof of skill inside.',
  },
  {
    q: 'Can I change my stream after Class 11 starts?',
    a: 'Switching is sometimes possible in the early weeks, but it depends on the school, the board and seat availability, so ask before you rely on it. Dropping Maths or Biology is far easier than adding them later, which is why the subject choice deserves care before Class 11 begins.',
  },
  {
    q: 'Is diploma after 10th a good option?',
    a: 'It can be, if the institute is approved, its labs and faculty are real, and its students move on to jobs or lateral entry. A diploma usually takes 3 years and many states allow lateral entry into the second year of B.E. or B.Tech, but the rules and seats differ by state, so verify them before you join.',
  },
  {
    q: 'What can I do after ITI?',
    a: 'You can work as a skilled tradesperson, join apprenticeship training, start a service business, or continue studying. Some states and institutes let ITI holders join a diploma in the second year, and open schooling lets you complete Class 12 later. Check each of these on its official source.',
  },
  {
    q: 'Can I study Class 11 and 12 through open schooling?',
    a: 'Yes. Open schooling such as NIOS lets students complete Senior Secondary on a flexible schedule, which suits students who are working, training or travelling. Confirm the age rules, the subject groups and whether the degree or exam you want accepts the certificate.',
  },
  {
    q: 'I have low marks in Class 10. What are my options?',
    a: 'Every route in the chart is still open; what changes is how easily you get a seat in a particular school or institute. Ask about subject rules at nearby schools, look at diploma and ITI seats, and consider open schooling. Then build one finished piece of work, because proof of skill matters more than the mark sheet from here on.',
  },
  {
    q: 'How is this different from the career chart after 12th?',
    a: 'This chart covers the decision you face now, which route to take after Class 10 and what each choice keeps open. The career chart after 12th covers what comes next, with entry exams, seats, costs and exam dates for degree routes. Use this one first and that one when Class 12 nears.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const downloadJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Career chart after 10th PDF downloads',
  itemListElement: PDF_FILES.map((p: { title: string; file: string }, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'DigitalDocument',
      name: p.title,
      encodingFormat: 'application/pdf',
      url: `https://futurecareerschool.com/downloads/career-charts/${p.file}`,
    },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="stream-selection"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd, downloadJsonLd]}
>
  <p class="lead-para">
    <strong>A career chart after 10th maps every route open to you, from science, commerce and arts to diploma, ITI and open schooling, and shows how long each takes and which doors it keeps open.</strong>
    This page gives you that chart to follow on screen and to download as a free PDF. Use it to find the route you lean toward, then build a skill portfolio on top of it, because that is what moves you toward stronger income and earlier financial freedom. The route opens the door. Proof of skill decides what happens after it.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>There are nine routes after Class 10, plus a skill layer that runs beside any of them. Each route has a length, an entry rule, a list of doors it keeps open and a list it closes.</li>
      <li>Work-first routes (ITI and diploma) reach full-time work in 1 to 3 years. Class 12 plus a degree takes 5 years or more, and medicine about 7.5.</li>
      <li>Maths and Biology can be dropped later but not added, so that choice is the hardest one to reverse.</li>
      <li>Rules change by state, board and year. Use the chart to ask better questions, then confirm each rule on the official site.</li>
      <li><strong>Run the route you lean toward through The 4-Checkpoint Protocol and The 3 Gates, then build a skill portfolio inside it. That combination decides your income ceiling more than the route label.</strong></li>
    </ul>
  </div>

  <p>
    For a slower written walk-through of the same decision, read <a href="/blog/stream-selection/career-options-after-10th/">career options after 10th</a>. When Class 12 nears, the <a href="/blog/career-options/career-chart-after-12th/">career chart after 12th</a> covers entry exams, seats and costs.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="download">Download the career chart after 10th as a PDF</h2>

  <p>
    The career chart after 10th PDF download is free, opens straight away and needs no sign-up. Print it, put it on the wall and use a pen on it. The all-routes file carries a one-page plan to fill in.
  </p>

  <div class="pdf-grid">
    {pdfCards.map((p) => {
      const m = p.meta;
      return (
        <a class:list={['pdf-card', p.overall && 'pdf-card--main']} href={`/downloads/career-charts/${p.file}`} download>
          <span class="pdf-card__badge">{p.overall ? 'Start here' : 'Per stream'}</span>
          <span class="pdf-card__title">{p.title}</span>
          <span class="pdf-card__blurb">{p.blurb}</span>
          <span class="pdf-card__meta">PDF · {m?.pages ?? '?'} pages · {m?.kb ?? '?'} KB · last checked {CHART_META.lastChecked}</span>
          <span class="pdf-card__go">Download PDF ↓</span>
        </a>
      );
    })}
  </div>

  <h2 id="chart">The career chart after 10th: follow the route that fits you</h2>

  <p>
    Start at the top question and follow the answers down. Each coloured end point is a route. Tap it to jump to that route's full card further down the page.
  </p>

  <div class="chart-board" role="group" aria-label="Career chart after 10th decision flow">
    <div class="flow" set:html={flowMarkup} />
    <div class="legend">
      {ROUTE_FAMILIES.map((f) => (
        <span class="legend__item"><span class="legend__dot" style={`background:${f.color}`}></span>{f.label}</span>
      ))}
    </div>
    <p class="chart-note">{FLOW.note}</p>
  </div>

  <h2 id="timeline">How many years until full-time work on each route</h2>

  <p>
    Time is the one number the usual lists leave out. This chart counts from the day Class 10 ends to the earliest standard start of full-time work. A lighter extension means there is a second stopping point further along the same route.
  </p>

  <div class="bars" role="img" aria-label="Bar chart of years from Class 10 to first full-time work for each route: ITI 1 to 2 years, diploma 3, three-year degree 5, B.Tech 6, integrated law 7, MBBS 7.5.">
    {TIMELINE.map((t) => (
      <div class="brow">
        <div class="blab">{t.label}</div>
        <div class="btrack">
          <div class="bfill" style={`width:${(t.from / maxYears) * 100}%;background:${famColor[t.family]}`}></div>
          {t.to > t.from && <div class="bext" style={`left:${(t.from / maxYears) * 100}%;width:${((t.to - t.from) / maxYears) * 100}%;background:${famColor[t.family]}`}></div>}
        </div>
        <div class="bval"><strong>{t.to > t.from ? `${t.from} to ${t.to} yrs` : `${t.from} yrs`}</strong><span>{t.note}</span></div>
      </div>
    ))}
    <div class="baxis"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8 years</span></div>
  </div>

  <p class="note-line">{TIMELINE_NOTE}</p>

  <p>
    A shorter route is not a better route. A diploma holder who stops learning can earn less than a degree holder with strong proof of work, and the reverse is just as common. The point of the chart is to see the trade-off in years, then decide what you can sustain.
  </p>

  <h2 id="doors">Which Class 11 choice keeps which door open</h2>

  <p>
    This is the part of a career guidance chart after 10th that families check last and should check first. Read across a row to see which choices keep a later door open.
  </p>

  <div class="table-wrap">
    <table class="paths-table doors-table">
      <thead>
        <tr>
          <th>Later door</th>
          {doorCols.map((c) => <th class="center">{c}</th>)}
          <th>Why</th>
        </tr>
      </thead>
      <tbody>
        {doors.map((d) => (
          <tr>
            <td data-label="Later door"><strong>{d.door}</strong></td>
            {d.cells.map((c, i) => (
              <td class={`center door door--${c}`} data-label={doorCols[i]}>{sym(c)}</td>
            ))}
            <td data-label="Why">{d.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    ✓ means the standard rule keeps the door open. ✕ means it closes it. Check means it depends on the course, college or state. Diploma and ITI columns assume no Class 12 is completed yet; open schooling can add Class 12 later.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>The pattern is simple. Biology can only be dropped, never added later, and so can Maths. Commerce and arts keep most professional and degree doors open, but they close engineering and medicine.</p>
    <p>If you are unsure, the useful question is not which stream is safest. It is which door you would hate to find closed in two years.</p>
  </div>

  <h2 id="science">Career chart after 10th for science: PCM, PCB and PCMB</h2>

  <p>
    Science is the widest gateway to technical and medical degrees, and the one with the heaviest school load. Take it when you want one of those degrees or genuinely enjoy the subjects, not because the label sounds safe.
  </p>

  {bySection(['science']).map((r) => (
    <div class="route-detail" id={`route-${r.id}`} style={`--accent:${famColor[r.family]}`}>
      <div class="route-detail__head">
        <span class="route-detail__tag">{famLabel[r.family]}</span>
        <h3>{r.label}</h3>
        <p class="route-detail__meta">{r.length} · about {yrs(r.yearsToWork)} to first full-time work</p>
      </div>
      <div class="route-detail__grid">
        <div>
          <p class="route-detail__lbl">Entry</p><p>{r.gate}</p>
          <p class="route-detail__lbl">Best for</p><p>{r.bestFor}</p>
          <p class="route-detail__lbl">Watch out</p><p>{r.watchOut}</p>
        </div>
        <div>
          <p class="route-detail__lbl">What it keeps open</p>
          <ul>{r.opens.map((o) => <li>{o}</li>)}</ul>
          {r.closes.length > 0 && (<><p class="route-detail__lbl route-detail__lbl--red">What it closes</p><ul class="closes">{r.closes.map((o) => <li>{o}</li>)}</ul></>)}
          <p class="route-detail__lbl">First move this month</p><p>{r.firstMove}</p>
        </div>
      </div>
    </div>
  ))}

  <p>
    If the choice is still blurred, the <a href="/services/assessments/stream-selector-test-after-10th/">stream selector test after 10th</a> turns your interests and strengths into a ranked lean. The <a href="/blog/stream-selection/which-stream-to-choose-in-11th/">guide to choosing a stream in 11th</a> goes deeper on subject combinations.
  </p>

  <h2 id="commerce">Career chart after 10th for commerce: with and without Maths</h2>

  <p>
    Commerce is the stream for business, money, accounting and markets. The decision that matters inside it is Maths, because it decides how many quantitative doors stay open.
  </p>

  {bySection(['commerce']).map((r) => (
    <div class="route-detail" id={`route-${r.id}`} style={`--accent:${famColor[r.family]}`}>
      <div class="route-detail__head">
        <span class="route-detail__tag">{famLabel[r.family]}</span>
        <h3>{r.label}</h3>
        <p class="route-detail__meta">{r.length} · about {yrs(r.yearsToWork)} to first full-time work</p>
      </div>
      <div class="route-detail__grid">
        <div>
          <p class="route-detail__lbl">Entry</p><p>{r.gate}</p>
          <p class="route-detail__lbl">Best for</p><p>{r.bestFor}</p>
          <p class="route-detail__lbl">Watch out</p><p>{r.watchOut}</p>
        </div>
        <div>
          <p class="route-detail__lbl">What it keeps open</p>
          <ul>{r.opens.map((o) => <li>{o}</li>)}</ul>
          {r.closes.length > 0 && (<><p class="route-detail__lbl route-detail__lbl--red">What it closes</p><ul class="closes">{r.closes.map((o) => <li>{o}</li>)}</ul></>)}
          <p class="route-detail__lbl">First move this month</p><p>{r.firstMove}</p>
        </div>
      </div>
    </div>
  ))}

  <h2 id="arts">Career chart after 10th for arts and humanities</h2>

  <p>
    Arts is the most misread stream. Law, psychology, design, media, teaching and civil services all start from it. The risk is not the stream. It is finishing the degree with nothing to show.
  </p>

  {bySection(['arts']).map((r) => (
    <div class="route-detail" id={`route-${r.id}`} style={`--accent:${famColor[r.family]}`}>
      <div class="route-detail__head">
        <span class="route-detail__tag">{famLabel[r.family]}</span>
        <h3>{r.label}</h3>
        <p class="route-detail__meta">{r.length} · about {yrs(r.yearsToWork)} to first full-time work</p>
      </div>
      <div class="route-detail__grid">
        <div>
          <p class="route-detail__lbl">Entry</p><p>{r.gate}</p>
          <p class="route-detail__lbl">Best for</p><p>{r.bestFor}</p>
          <p class="route-detail__lbl">Watch out</p><p>{r.watchOut}</p>
        </div>
        <div>
          <p class="route-detail__lbl">What it keeps open</p>
          <ul>{r.opens.map((o) => <li>{o}</li>)}</ul>
          {r.closes.length > 0 && (<><p class="route-detail__lbl route-detail__lbl--red">What it closes</p><ul class="closes">{r.closes.map((o) => <li>{o}</li>)}</ul></>)}
          <p class="route-detail__lbl">First move this month</p><p>{r.firstMove}</p>
        </div>
      </div>
    </div>
  ))}

  <h2 id="diploma-iti">Career chart after 10th for diploma, ITI and open schooling</h2>

  <p>
    These routes start technical learning or earning sooner, or let you finish school on your own schedule. They work when the institute is verified and when skills keep being added after the certificate.
  </p>

  {bySection(['diploma', 'open']).map((r) => (
    <div class="route-detail" id={`route-${r.id}`} style={`--accent:${famColor[r.family]}`}>
      <div class="route-detail__head">
        <span class="route-detail__tag">{famLabel[r.family]}</span>
        <h3>{r.label}</h3>
        <p class="route-detail__meta">{r.length} · about {yrs(r.yearsToWork)} to first full-time work</p>
      </div>
      <div class="route-detail__grid">
        <div>
          <p class="route-detail__lbl">Entry</p><p>{r.gate}</p>
          <p class="route-detail__lbl">Best for</p><p>{r.bestFor}</p>
          <p class="route-detail__lbl">Watch out</p><p>{r.watchOut}</p>
        </div>
        <div>
          <p class="route-detail__lbl">What it keeps open</p>
          <ul>{r.opens.map((o) => <li>{o}</li>)}</ul>
          {r.closes.length > 0 && (<><p class="route-detail__lbl route-detail__lbl--red">What it closes</p><ul class="closes">{r.closes.map((o) => <li>{o}</li>)}</ul></>)}
          <p class="route-detail__lbl">First move this month</p><p>{r.firstMove}</p>
        </div>
      </div>
    </div>
  ))}

  <p class="note-line">
    The Directorate General of Training's Craftsmen Training Scheme page lists 14,643 ITIs and 169 trades under the national skills framework (checked {CHART_META.lastChecked}). The trade you choose matters less than your willingness to keep adding skills on top of it. For trade-by-trade detail, see the ITI section of <a href="/blog/stream-selection/career-options-after-10th/#iti-trades">career options after 10th</a>.
  </p>

  <h2 id="variation">What changes by state and board, and what to ask</h2>

  <p>
    A chart can show the national pattern. It cannot replace your own state's rules. Before you rely on any row, ask these questions, in writing where you can.
  </p>

  <ol class="rich-list">
    <li><strong>Which subject groups does the school actually offer?</strong> Not every school runs PCMB, commerce with Maths or a given arts combination, and many set their own minimum marks.</li>
    <li><strong>How is the diploma or ITI seat filled?</strong> Usually through the state technical education board or the state skill department, by merit or a test. Dates and cut-offs differ every year.</li>
    <li><strong>Is the institute approved, and what is the total fee?</strong> Ask for the approval proof and the full fee list before paying anything.</li>
    <li><strong>What did last year's students do next?</strong> Ask for the number who found work, joined apprenticeship training or took lateral entry.</li>
    <li><strong>Does the degree you may want accept this certificate?</strong> This matters most for open schooling and for lateral entry, where rules sit with the state and the college.</li>
  </ol>

  <h2 id="checks">Test the route you lean toward before you commit</h2>

  <p>
    The chart gives a first lean. These checks turn it into a decision you can defend. Use the same four checkpoints on every serious option.
  </p>

  <div class="check-grid">
    {CHECKPOINTS.map((c, i) => (
      <div class="check-card">
        <span class="check-card__num">0{i + 1}</span>
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </div>
    ))}
  </div>

  <p>
    Then pass The 3 Gates before the decision gets expensive.
  </p>

  <div class="check-grid check-grid--three">
    {GATES.map((g, i) => (
      <div class="check-card">
        <span class="check-card__num">Gate {i + 1}</span>
        <h3>{g.title}</h3>
