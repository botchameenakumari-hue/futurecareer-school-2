    note: 'Specialty depth (surgery, radiology, E/M, risk adjustment) moves pay more than years of experience alone at this stage.',
  },
  {
    role: 'Coding Auditor / QA Analyst (5-8 years)',
    range: 'Roughly Rs 8-14 LPA',
    note: 'Auditor roles pay more than pure production coding because compliance accuracy carries direct financial and legal weight for the client.',
  },
  {
    role: 'Coding Team Lead / Coding Manager (8-12 years)',
    range: 'Roughly Rs 12-20 LPA',
    note: 'People-management and client-facing communication skills matter as much as coding skill by this stage.',
  },
  {
    role: 'Coding Operations Manager / Director, HIM (12+ years)',
    range: 'Roughly Rs 20-30 LPA and above',
    note: 'A realistic senior outcome for people who built specialty depth, stayed certified, and moved into operational or client-relationship ownership.',
  },
];

const checkpointItems = [
  {
    num: '01',
