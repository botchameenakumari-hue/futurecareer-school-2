];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Complete a recognised certification course and sit for the AAPC CPC or AHIMA CCS exam. Produce a certificate and, ideally, a small practice-coding portfolio you can walk a recruiter through.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'Explain in under two minutes why medical coding specifically fits your work style and financial runway, not why "healthcare BPO sounds stable" in the abstract.',
