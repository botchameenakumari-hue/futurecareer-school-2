];

const mistakeItems = [
  {
    num: '01',
    title: 'Believing you need a medical degree to become a coder',
    body: 'Medical coding does not require MBBS, BDS, or any clinical license. Life sciences, pharmacy, nursing, and even general graduates make up most of India\'s coding workforce, as long as they clear a certification course covering anatomy, physiology, and coding systems.',
  },
  {
    num: '02',
    title: 'Skipping certification because "the company will train me"',
    body: 'Some employers do train freshers, but CPC or CCS certification is a near-universal preference on job listings, and coders who hold it before applying earn meaningfully more from day one than uncertified peers doing the same work.',
  },
  {
    num: '03',
    title: 'Confusing medical coding with medical transcription or data entry',
    body: 'Coding requires interpreting clinical documentation and applying a structured code set with legal and billing consequences. It is closer to a compliance and classification skill than typing speed, and employers filter for that distinction quickly in interviews.',
  },
  {
    num: '04',
    title: 'Treating entry-level pay as the career ceiling',
    body: 'Entry salaries of Rs 2.5-4.5 LPA look modest next to senior coder or auditor numbers, but the jump from certified junior coder to senior specialty coder or auditor typically doubles pay within 3-6 years for people who stay certified and build specialty depth.',
  },
  {
    num: '05',
    title: 'Ignoring the AI shift and staying a pure volume coder',
    body: 'Entry-level, high-volume, low-complexity coding is exactly the work AI-assisted tools speed up first. Coders who move toward auditing, denial analysis, or complex-specialty coding within their first few years protect their income growth better than those who stay on routine outpatient volume alone.',
  },
  {
    num: '06',
    title: 'Choosing a training institute without checking placement and AAPC/AHIMA licensing',
