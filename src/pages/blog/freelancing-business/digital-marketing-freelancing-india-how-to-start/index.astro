---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Digital Marketing Freelancing India: How to Start Without an Agency Job First';
const description =
  'Digital marketing freelancing India how to start: which sub-skill to package first, how to land your first paying client, and whether to charge retainer, project, or performance-based.';
const canonical =
  'https://futurecareerschool.com/blog/freelancing-business/digital-marketing-freelancing-india-how-to-start';
const publishedDateISO = '2026-07-21';
const publishedDateLabel = '21 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'why-accessible', label: 'Why marketing is an accessible freelance lane' },
  { id: 'pick-a-package', label: 'Which sub-skill to package first' },
  { id: 'first-client', label: 'How to land your first paying client' },
  { id: 'pricing-models', label: 'Retainer vs project vs performance-based pricing' },
  { id: 'proof-not-credentials', label: 'Building proof instead of credentials' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you go solo' },
  { id: 'gates', label: 'The 3 Gates before you quit a job for this' },
  { id: 'mistakes', label: 'Mistakes that stall new freelancers' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const packageItems = [
  {
    num: '01',
    title: 'Search engine optimisation (SEO)',
    body: 'You audit a website, fix technical and on-page gaps, and build content or backlinks to grow organic traffic. Slower to show results (often a few months before rankings move), but once a client trusts the process, SEO retainers tend to be the stickiest, longest-running contracts of any marketing service.',
  },
  {
    num: '02',
    title: 'Paid ads and PPC (Google Ads, Meta Ads)',
    body: 'You plan, launch, and optimise paid campaigns using a client\'s ad budget. Results are visible within days, which makes this the fastest way to prove value to a new client — but it also means a bad week is visible just as fast, and you are managing someone else\'s money from day one.',
  },
  {
    num: '03',
    title: 'Social media management',
    body: 'You plan content calendars, write captions, design or brief creatives, and manage posting and community replies across platforms. Lower barrier to enter than paid ads or SEO, which also means more competition and thinner margins unless you specialise by industry or add strategy on top of execution.',
  },
  {
    num: '04',
    title: 'Email marketing and lifecycle campaigns',
    body: 'You build welcome sequences, newsletters, abandoned-cart flows, and segmented campaigns inside tools like Mailchimp or Klaviyo. Underrated as a freelance entry point in India because fewer freelancers specialise in it, and it plugs directly into revenue for e-commerce and D2C brands.',
  },
  {
    num: '05',
    title: 'Content strategy and copywriting',
    body: 'You plan what a brand should publish and where, or you write the landing pages, ads, and emails that other channels depend on. Harder to price cleanly because output quality is subjective, but it becomes a strong multiplier once paired with any of the other four skills above.',
  },
];

const firstClientItems = [
  {
    num: '01',
    title: 'Run one real campaign before you pitch anyone',
    body: 'A local shop, a friend\'s small business, or even your own micro-project counts. Manage a real (even tiny) ad budget, or grow a real page\'s engagement, and track the actual before-and-after numbers. This becomes your first case study and your answer to "what results have you gotten."',
  },
  {
    num: '02',
    title: 'Go narrow before you go broad',
    body: 'Pitch to one industry you already understand a little — a gym, a tuition centre, a local restaurant chain, a small D2C brand — instead of pitching "any business." A narrow pitch reads as expertise; a broad pitch reads as desperation, even at the exact same skill level.',
  },
  {
    num: '03',
    title: 'Use direct outreach, not just marketplaces',
    body: 'Marketplaces like Upwork and Fiverr work, but they put you in a price war with thousands of profiles on day one. Cold but specific outreach — a short audit of what is missing on a real business\'s Instagram or Google listing, sent directly to the owner — usually converts faster for a first client because it proves skill before asking for money.',
  },
  {
    num: '04',
    title: 'Price the first project to get the case study, not the profit',
    body: 'Your first one or two paid projects exist to generate a testimonial and a before-and-after number, not to replace a salary. A fair, not free, price that gets you real client feedback and a usable result is worth more early on than holding out for full market rate on client zero.',
  },
  {
    num: '05',
    title: 'Ask every client for two things at the finish line',
    body: 'A short written testimonial with a specific number in it (leads, traffic, followers, revenue — whatever genuinely moved), and permission to reference the work publicly. Vague praise like "great to work with" barely helps a pitch; a number does.',
  },
];

const pricingRows = [
  {
    model: 'Project-based',
    whenItFits: 'One-off, well-defined work: a website SEO audit, a one-time campaign launch, a content calendar for a quarter.',
    prosCons: 'Clear scope and clear payment, easiest to price when you are new. Risk: scope creep if deliverables are not written down before you start.',
  },
  {
    model: 'Monthly retainer',
    whenItFits: 'Ongoing work: social media management, always-on SEO, or continuous ad management for an active budget.',
    prosCons: 'Predictable monthly income once you have 3-5 retainer clients, and it is the model most freelance marketers eventually build toward. Risk: undercharging early locks in a low rate that is awkward to raise later — anchor the first retainer price to the value delivered, not just your comfort level.',
  },
  {
    model: 'Performance-based',
    whenItFits: 'Paid ads or lead-generation work where results are directly trackable, usually paired with a smaller base fee plus a bonus tied to cost-per-lead or ROAS targets.',
    prosCons: 'Attractive to clients because it lowers their risk, and it can pay very well once you have a proven system. Risk: you carry the downside if a campaign underperforms for reasons outside your control (a weak product, a broken checkout, a saturated market) — agree on a base fee that survives a slow month before accepting a fully performance-only deal.',
  },
];

const proofItems = [
  {
    label: 'Weak proof',
    title: 'A certificate with no client attached',
    body: 'A Google Ads or HubSpot certificate shows you completed a course. It does not show a client that you can run their specific budget and get a specific result. Certificates help you learn the mechanics; they rarely close a deal on their own.',
  },
  {
    label: 'Strong proof',
    title: 'A before-and-after number from a real account',
    body: 'Even a small one: "grew Instagram engagement 40% in 8 weeks for a local bakery" or "cut cost-per-lead from Rs 220 to Rs 140 for a coaching brand." A specific, verifiable number from real work beats a polished portfolio deck with no client names attached.',
  },
  {
    label: 'Strong proof',
    title: 'A screenshot-backed case study, not a claim',
    body: 'Show the actual dashboard, the actual ad account, or the actual analytics screenshot alongside your explanation of what you changed and why. Anyone can claim a number; fewer freelancers show their work, which is exactly why showing it stands out.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Freelance marketing rewards people who are comfortable being publicly, constantly measured by someone else\'s money and someone else\'s deadline, and who can hold ambiguity without a fixed process to follow every time. If chasing a client for feedback or explaining a slow week stresses you more than it teaches you, factor that honestly into the decision.',
    note: 'The work is not just the marketing skill — a large share of freelance success is client communication under pressure.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can your household runway absorb an unpredictable income for the first stretch while you build a client base? Most freelance marketers describe an uneven first year — a few strong months, a few thin ones — before retainers stabilise the income.',
    note: 'If you have zero financial cushion, keep a part-time job or a small retainer client base running while you build toward full-time freelancing, rather than quitting cold on day one.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'India has a large and fast-growing base of freelancers, and marketing-adjacent work (content, design, IT-linked services) already sits among the most common freelance categories in the country. Demand is real, but so is competition — narrow positioning by industry or channel is what separates a freelancer with steady retainers from one competing purely on lowest price.',
    note: 'A narrow, provable specialty beats a broad, unproven generalist pitch in a crowded market.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI tools now draft ad copy, generate campaign variants, and summarise performance data in minutes. The safer freelance position is becoming the person who sets strategy, judges what the AI produced, and explains the "why" behind a number to a client — not the person who only executes tasks an AI can now do just as fast.',
    note: 'The useful question is not "will AI replace this," it is "which client-facing judgment call still needs a human to own it."',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Pitching "I do everything" instead of one clear service',
    body: 'A new freelancer offering SEO, ads, social media, email, and content all at once usually delivers none of them well and looks unfocused to a business owner comparing options. Pick one primary service to lead with, and mention the others as add-ons once trust is built.',
  },
  {
    num: '02',
    title: 'Underpricing the first retainer and never correcting it',
    body: 'A client who signs at a very low monthly rate rarely agrees to a large jump later without friction. Price the first retainer close to a fair rate for the actual work involved, even if it means starting with fewer clients, rather than discounting deeply "to get started" and getting stuck there.',
  },
  {
    num: '03',
    title: 'Skipping a written scope and starting without an advance',
    body: 'Verbal agreements about "managing the social media" quietly expand into designing merchandise, answering customer complaints, and running giveaways with no extra pay. A short written scope — deliverables, number of posts or campaigns, revision limits, and payment terms — protects both sides and looks more professional, not less. Asking for 30-50% upfront on a new or larger client is a normal, professional move too, not a sign of distrust, and it filters out the clients who were never going to pay on time anyway.',
  },
  {
    num: '04',
    title: 'Treating marketplaces as the only client channel',
    body: 'Relying only on Upwork or Fiverr puts you in constant price competition with thousands of other profiles. Direct outreach, referrals from your first happy clients, and a visible LinkedIn presence showing real results usually produce better-paying, longer-term clients than marketplace bidding alone.',
  },
  {
    num: '05',
    title: 'Ignoring cash flow and client concentration risk',
    body: 'One client paying 70% of your income can end a freelance business overnight if they leave. Build toward at least three to four active retainer clients before treating freelancing as your sole income, and always keep the first client conversation going for referrals even after a project wraps.',
  },
];

const faqItems = [
  {
    q: 'Digital marketing freelancing India how to start with zero experience?',
    a: 'Run one small, real campaign first — even a tiny ad budget for a friend\'s business or your own micro-project — and track the actual result. Pick one sub-skill (SEO, paid ads, social media, email, or content) to lead with instead of offering everything, then pitch a narrow set of businesses directly with a specific audit of what is missing in their current marketing, rather than a generic "I do digital marketing" message. Your first one or two projects exist to build a case study, not to replace a salary.',
  },
  {
    q: 'How much should a freelance digital marketer charge in India starting out?',
    a: 'Entry-level freelance rates in India commonly start in the lower range of what global freelance-rate data shows for beginners, often used as project fees or a modest monthly retainer rather than a high hourly rate. The exact number depends heavily on the sub-skill (paid ads and SEO typically command more than basic social media posting), the client\'s industry, and whether you have a verifiable before-and-after result to point to. Price the first project fairly rather than free, and increase your rate as your case-study evidence grows.',
  },
  {
    q: 'Should I use a monthly retainer, a project fee, or performance-based pricing?',
    a: 'Use project-based pricing for clearly scoped, one-time work like an SEO audit or a single campaign launch. Move toward a monthly retainer for ongoing work like social media management or continuous ad management, since retainers create the predictable income most freelance marketers eventually build toward. Performance-based pricing works best for trackable paid-ads work, usually paired with a base fee that survives a slow month, since a fully performance-only deal leaves you carrying the downside of a weak product or a saturated market that is outside your control.',
  },
  {
    q: 'Do I need certifications to freelance in digital marketing in India?',
    a: 'Certifications like Google Ads or HubSpot Academy help you learn the mechanics and can reassure a cautious client, but they rarely close a deal on their own. Clients hire based on proof — a specific, verifiable result from real work, ideally backed by a screenshot or dashboard — far more than a list of completed courses. Treat certifications as a learning step, not the credential that gets you hired.',
  },
  {
    q: 'Which digital marketing skill is easiest to freelance with first in India?',
    a: 'Social media management usually has the lowest barrier to entry, which also means the most competition and thinner margins unless you specialise by industry. Paid ads (Google Ads, Meta Ads) show results fastest, which helps prove value quickly to a new client, but you are managing someone else\'s budget from day one. Email marketing is comparatively underused as an entry point in India and can be a strong, less crowded specialty for freelancers willing to learn one tool well.',
  },
  {
    q: 'How many clients does a freelance digital marketer need to replace a full-time salary?',
    a: 'There is no fixed number — it depends on your pricing model and each client\'s budget. Many freelance marketers describe reaching a stable income once they build three to four ongoing retainer clients, since that spread also protects against losing one client suddenly. Relying on a single large client for most of your income is a common early mistake that creates real cash-flow risk if that client leaves.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="freelancing-business"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Digital marketing freelancing India how to start comes down to three moves in order: pick
    one sub-skill to package instead of offering everything, run one small real campaign to build proof
    before you pitch anyone, and price your first few clients to earn a case study, not a salary.</strong>
    Digital marketing is one of the most accessible service categories to freelance in because the barrier
    to a first paying client is a real result, not a degree — but "accessible" is not the same as "easy,"
    and most people who stall out skip the proof step and go straight to pitching.
  </p>

  <p class="lead-para lead-para--sub">
    Done deliberately, it is also one of the more direct routes to a genuine
    <strong>high-income skill portfolio</strong>: one specialised, in-demand marketing skill plus verifiable
    proof of results compounds into unlocking high income opportunities far faster than staying generalist
    ever does.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Pick one sub-skill to lead with — SEO, paid ads, social media, email marketing, or content strategy — instead of pitching "full-service" on day one.</li>
      <li>Build one real, even tiny, before-and-after result before you pitch a stranger. A specific number beats a certificate every time a client is deciding who to hire.</li>
      <li>Use project fees for clearly scoped one-off work, move toward monthly retainers for ongoing work, and only take performance-based deals with a base fee that survives a slow month.</li>
      <li>Direct, narrow outreach to one industry usually converts faster and pays better than broad marketplace bidding.</li>
      <li>Aim for three to four active retainer clients before treating freelancing as your sole income — one large client paying most of your bills is a real cash-flow risk.</li>
    </ul>
  </div>

  <p>
    If you are still deciding whether freelancing or a salaried marketing role fits you better, read more
    <a href="/blog/freelancing-business/">Freelancing and Business guides</a> for the wider client-acquisition
    and pricing basics before you commit to going solo.
  </p>

  <p>
    If the pressure to decide is real — a job you are unhappy in, or family pressure to "just get a stable
    job instead" — a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you weigh freelancing against your specific situation, not a generic list of pros and cons.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer to digital marketing freelancing India how to start</h2>

  <p>
    Most guides on this topic jump straight to "here are 10 places to find clients" without addressing the
    part that actually determines whether a client says yes: what you are offering, and what proof you can
    show that it works.
  </p>

  <p>
    Start narrow. Choose one marketing sub-skill you can genuinely get good at within a focused stretch of
    consistent practice, build one real result in it, and pitch a small, specific group of businesses that
    sub-skill obviously helps. Broad, unproven offers lose to narrow, proven ones almost every time in a
    market this crowded.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Digital marketing freelancing gets sold two opposite ways online. One version says it is easy money
      because "anyone can post on Instagram." The other says it is oversaturated and not worth trying. Both
      miss the real picture: the entry barrier to trying is genuinely low, but the barrier to earning a
      real, repeatable income is proof of results — and most people who quit did not fail at marketing, they
      failed to ever build one verifiable case study before giving up.
    </p>
  </div>

  <h2 id="why-accessible">Why digital marketing is one of the most accessible freelance lanes</h2>

  <p>
    Compared to freelance lanes that need a formal license, a large starting portfolio, or expensive
    equipment, digital marketing has a genuinely low barrier to a first attempt — you can run a real campaign
    with a small budget, or manage a real page, without waiting for anyone's permission.
  </p>

  <p>
    India's freelance economy backs this up at scale. Industry market research puts India's freelance
    platform market revenue at roughly USD 265 million in 2025, with the country's broader freelancer base
    already past 15 million and projected to keep growing quickly through the rest of the decade. Marketing
    and content-adjacent categories consistently rank among the most active fields for Indian freelancers,
    alongside design and writing.
  </p>

  <p>
    That demand comes from a simple business reality: a small or mid-sized business often cannot justify a
    full in-house marketing team or a large agency retainer, but it still needs someone running its ads,
    social presence, or SEO. A freelancer who can deliver focused, specific results at a lower overhead than
    an agency fills that gap directly.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Accessible does not mean uncompetitive. Because the entry barrier is low, a large number of people try
      freelance marketing every year, and most who fail to differentiate compete purely on price. The
      freelancers who build a real, stable income are the ones who narrow their offer and can show a
      specific number, not the ones who can technically "do" the most services.
    </p>
  </div>

  <h2 id="pick-a-package">Which sub-skill to package first</h2>

  <p>
    Trying to offer SEO, paid ads, social media, email, and content strategy all at once as a beginner
    usually means doing all five at a mediocre level. Pick one to lead with, and treat the rest as add-ons
    you offer once a client already trusts you.
  </p>

  <div class="mistakes-list">
    {packageItems.map((item) => (
      <div class="mistake-item">
        <div class="mistake-item__num">{item.num}</div>
        <div class="mistake-item__content">
          <div class="mistake-item__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p>
      If you cannot decide between two of these, pick the one where you can most realistically get a real
      before-and-after number within the next few weeks — proof speed matters more than which skill sounds
      more impressive.
    </p>
  </div>

  <h2 id="first-client">How to land your first paying client as a solo digital marketer</h2>

  <p>
    Your first client is the hardest one to get, because you have no track record yet. This is the sequence
    that removes that blocker instead of waiting for it to solve itself.
  </p>

  <div class="protocol-stack">
    {firstClientItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <p>
    Notice none of this depends on a large following, a design portfolio, or a marketing degree. It depends
    on being willing to do one small piece of real, visible work before you ask anyone to pay you for the
    bigger version of it.
  </p>

  <h2 id="pricing-models">Retainer vs project vs performance-based pricing for marketing services</h2>

  <p>
    Pricing confuses new freelance marketers more than almost anything else, mostly because the three common
    models fit different kinds of work, not different skill levels.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Pricing model</th>
          <th>When it fits</th>
          <th>Pros and risks</th>
        </tr>
      </thead>
      <tbody>
        {pricingRows.map((item) => (
          <tr>
            <td data-label="Pricing model"><strong>{item.model}</strong></td>
            <td data-label="When it fits">{item.whenItFits}</td>
            <td data-label="Pros and risks">{item.prosCons}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Rate ranges vary widely by client budget, sub-skill, and experience level, and shift over time — treat
    any specific number you see online as directional, and confirm current market rates against live
    freelance listings before quoting a client.
  </p>

  <p>
    Once you have run a few retainers, turn the work into a fixed package instead of quoting each new
    client from scratch, a named tier with a set scope, a set number of deliverables, and a set price band
    for "social media management, starter" versus "social media management, growth," for example. A
    productized offer like this sells faster because a prospect can say yes without a back-and-forth
    negotiation, and it protects your margin because you get faster at delivering the same package instead
    of re-inventing scope on every new client.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">A hybrid model works well once you have proof</div>
      <ul>
        <li>A smaller flat monthly retainer covers your baseline time and effort, protecting you from a slow month.</li>
        <li>A performance bonus on top rewards you when results genuinely beat target, without leaving you fully exposed if the client's product or market is the real bottleneck.</li>
        <li>This is a common structure once you have at least one verifiable case study to justify it.</li>
      </ul>
    </div>
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">Never price entirely on hope</div>
      <ul>
        <li>Avoid a fully performance-only deal until you have enough client history to know what is a realistic target, not an optimistic one.</li>
        <li>Get scope and payment terms in writing before starting, even for a small first project.</li>
        <li>Raise rates as your case-study evidence grows — do not anchor future pricing to your first, lowest, "getting started" rate.</li>
      </ul>
    </div>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Paperwork you cannot skip</p>
    <p>
      Once retainers add up, invoicing and tax stop being optional admin. Track every invoice, pay advance
      tax in the applicable quarterly instalments instead of one lump sum in March, and check whether your
      annual receipts from services cross the current GST registration threshold — many freelance marketers
      cross it faster than they expect once two or three retainers stack up. Watch for reverse-charge GST
      obligations too if you pay for foreign tools or ad platforms directly, since that can apply even below
      the usual turnover threshold. Confirm current thresholds and filing rules with a chartered accountant
      rather than an old blog post, since limits change with each Union Budget. Once income is steady, free
      Udyam/MSME registration is also worth doing for the credit access and payment protection it unlocks —
      check the current process on the official Udyam portal.
    </p>
  </div>

  <h2 id="proof-not-credentials">Building a portfolio through results, not credentials</h2>

  <p>
    A freelance marketing portfolio should read like a set of small case studies, not a design showcase or a
    list of completed courses. Clients hire based on evidence that you can move a number they care about.
  </p>

  <div class="feature-grid">
    {proofItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    Structure each case study the same simple way: what the business's situation was before you started,
    what you specifically did, and the measurable change afterward, backed by a real screenshot wherever
    possible. Two or three of these, even from small accounts, carry more weight than a long list of vague
    service descriptions.
  </p>

  <h2 id="checkpoint">Use The 4-Checkpoint Protocol before you go all-in on freelancing</h2>

  <p>
    A pricing table and a client-outreach checklist cannot tell you whether freelancing genuinely fits your
    life right now. The 4-Checkpoint Protocol narrows this decision to what matters for your situation.
  </p>

  <div class="highlight-box highlight-box--amber">
    <p>
      <strong>The goal is not just "become a freelancer" — it is building a high-income skill portfolio on
      purpose.</strong> That means the right skill mix for your market, visible proof of work, clear client
      communication, deliberate positioning against competitors, honest personal fit, and a financial reality
      check, not a single technical skill in isolation.
    </p>
  </div>

  <div class="protocol-stack">
    {checkpointItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <p>
    If you are still unsure after running this test honestly, a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
