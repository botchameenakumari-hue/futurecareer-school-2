  { href: 'https://www.upwork.com/resources/highest-paying-freelance-jobs', text: 'Upwork: highest paying freelance jobs (hourly ranges in US dollars; no date given on the page)' },
  { href: 'https://investors.upwork.com/node/12681/pdf', text: 'Upwork: In-Demand Skills 2026 report (4 February 2026)' },
  { href: 'https://www.upwork.com/hire/in/', text: 'Upwork: hire freelancers in India (beginner rate range; no date given)' },
  { href: 'https://ambitionbox.com/profile/freelancer-salary', text: 'AmbitionBox: freelancer salary in India (page updated 28 December 2024)' },
  { href: 'https://www.xflowpay.com/blog/gig-economy-india-statistics', text: 'Xflow: gig economy in India statistics (cites Economic Survey 2025-26 and NITI Aayog)' },
