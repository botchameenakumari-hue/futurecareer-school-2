    num: '04',
    title: 'AI-proof',
    body: 'AI now writes first drafts, basic code and rough designs. The part that keeps its price is choosing what to build, checking whether it is right and owning the result for a client. Ask which part of your work you would still be paid for.',
    note: 'The safer rate belongs to the person who checks the AI answer, not the person who types the first draft.',
  },
];

const mistakeItems = [
