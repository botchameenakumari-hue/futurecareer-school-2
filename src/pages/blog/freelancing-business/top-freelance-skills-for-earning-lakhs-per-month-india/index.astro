  { id: 'skills', label: 'The eight skills, ordered by growth room' },
  { id: 'stall', label: 'Skills that rarely reach lakhs alone' },
  { id: 'levers', label: 'What moves a skill from thousands to lakhs' },
  { id: 'who-pays', label: 'Who pays, and how they judge you' },
  { id: 'ai', label: 'AI and these skills' },
  { id: 'checkpoint', label: 'Check before you commit' },
  { id: 'money-check', label: 'Money check before you pay' },
  { id: 'mistakes', label: 'Mistakes that keep income small' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'sources', label: 'Sources checked' },
  { id: 'faq', label: 'FAQs' },
];

