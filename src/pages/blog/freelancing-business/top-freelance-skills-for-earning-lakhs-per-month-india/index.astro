const checkpointItems = [
  {
    num: '01',
    title: 'Your fit',
    body: 'Developers and analysts spend long stretches alone with a problem. Marketers and consultants spend more time talking and chasing. Pick the skill whose ordinary week you can stand, because rates only rise for people who stay and improve.',
