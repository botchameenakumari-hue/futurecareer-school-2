const ruleRows = [
  {
    topic: "Contracts",
    rule: "Under Indian contract law, an agreement made by a minor (under 18) is treated as void, not just risky. The Privy Council decided this in Mohori Bibee v Dharmodas Ghose (1903), and later court summaries say the Supreme Court repeated it in 2014.",
    means: "Before 18, let a parent or guardian be the person who signs with a customer, or keep jobs small, paid on delivery and in writing by message. Ask a lawyer or a chartered accountant (CA) for anything big.",
  },
  {
    topic: "Bank account",
    rule: "An RBI circular reported in April 2025 lets a minor aged 10 or more run a savings account on their own, within the amount and terms each bank sets. Younger minors use a guardian. Overdrafts are not allowed.",
    means: "Ask your bank what it allows. Keep business money in a separate account from pocket money, even if it is a guardian account.",
  },
  {
    topic: "Tax on a minor's income",
    rule: "A minor's income is normally added to the income of the parent who earns more. Income from the child's own skill, talent or manual work is excluded, but returns from investing that money are added. The rule is section 64(1A) of the old Act and moves to section 99(1A) under the Income-tax Act, 2025, which applies from 1 April 2026.",
    means: "Tell your parents about your earnings. Ask a CA how to file. Do not hide income to keep things simple.",
  },
  {
    topic: "GST",
    rule: "Secondary explainers give GST registration limits for service providers of Rs 20 lakh a year (Rs 10 lakh in special category states). E-commerce operators and some other cases need registration whatever the turnover, and platforms differ on what they accept.",
