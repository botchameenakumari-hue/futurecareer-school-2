      <thead>
        <tr>
          <th>Idea</th>
          <th>Meaning</th>
          <th>Quick example</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Idea"><strong>Percentage change</strong></td>
          <td data-label="Meaning">How much something rose or fell compared with before</td>
          <td data-label="Quick example">Sales rose from 200 to 250, so the change is 25 percent</td>
        </tr>
        <tr>
          <td data-label="Idea"><strong>Margin</strong></td>
          <td data-label="Meaning">Share of the selling price left after cost</td>
          <td data-label="Quick example">Price 100, cost 70, margin is 30 percent</td>
        </tr>
        <tr>
          <td data-label="Idea"><strong>Break-even</strong></td>
          <td data-label="Meaning">Sales needed to cover all costs</td>
          <td data-label="Quick example">Fixed cost divided by profit per unit</td>
        </tr>
        <tr>
          <td data-label="Idea"><strong>Average and spread</strong></td>
          <td data-label="Meaning">Typical value and how much it varies</td>
          <td data-label="Quick example">A mean can hide a few extreme orders</td>
        </tr>
        <tr>
          <td data-label="Idea"><strong>Compound growth</strong></td>
          <td data-label="Meaning">Growth building on earlier growth</td>
          <td data-label="Quick example">Ten percent a year for three years is more than thirty percent</td>
        </tr>
      </tbody>
    </table>
  </div>

