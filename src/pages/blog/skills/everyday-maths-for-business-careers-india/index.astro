const title = "Everyday Maths for Business Careers in India: Percentages, Margins and Simple Models";
const seoTitle = "Everyday Maths for Business Careers in India";
const description = "Everyday maths for business careers in India: percentages, margins, growth, break-even and simple models, with practice tasks and honest limits.";
const seoDescription = "Business maths is a small set of ideas used daily.";
const canonical = "https://futurecareerschool.com/blog/skills/everyday-maths-for-business-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How much maths do business careers need?",
    "Mostly percentages, margins, averages and simple models. Roles vary."
  ],
  [
    "Can I learn if I was weak at school maths?",
    "Yes, with real examples and steady practice."
  ],
  [
    "Which tool should I use?",
    "A spreadsheet is enough for most beginners."
  ],
  [
    "How do I show maths skill on a resume?",
    "With small projects that show clear assumptions and results."
  ],
  [
    "Is statistics needed?",
    "Basics help for analyst roles. Read notices."
  ],
  [
    "What is the difference between margin and markup?",
    "Margin is a share of the selling price. Markup is a share of the cost."
  ],
  [
    "Do I need a course?",
    "Try free material first."
  ],
  [
    "Will AI replace business maths?",
    "It calculates. People still choose assumptions and check results."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
