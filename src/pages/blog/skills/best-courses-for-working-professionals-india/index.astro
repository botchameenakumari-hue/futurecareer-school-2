const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'wrong-question', label: 'Why "which course" is the wrong first question' },
  { id: 'self-learning-first', label: 'Try the free route first' },
  { id: 'four-layer-audit', label: 'The 4-Layer Course Audit' },
  { id: 'curriculum-currency', label: 'Layer 1: Curriculum currency' },
