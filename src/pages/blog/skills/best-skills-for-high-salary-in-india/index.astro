  },
  {
    skill: 'Cloud engineer (AWS/Azure/GCP)',
    fresher: 'Rs 3-8 LPA, higher with a certification plus real projects',
    midSenior: 'Rs 12-20 LPA mid-level, Rs 20-40 LPA senior; cloud security specialists reach Rs 28-80 LPA',
    signal: "India's cloud talent pool is projected to grow roughly 2.4x by 2025 at a 24% CAGR, yet demand still outpaces supply",
  },
  {
    skill: 'Cybersecurity analyst/engineer',
    fresher: 'Rs 4-7 LPA, Rs 8-12 LPA with certifications like CEH or CompTIA Security+',
    midSenior: 'Rs 8-18 LPA mid-level, Rs 20-50 LPA senior; CISOs report Rs 60L-1.2Cr',
    signal: 'NASSCOM estimates India will need roughly 1 million cybersecurity professionals by 2026',
  },
  {
    skill: 'Data analyst / BI analyst',
    fresher: 'Rs 3.5-6 LPA',
