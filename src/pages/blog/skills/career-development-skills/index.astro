const routeRows = [
  {
    route: 'Skill India Digital Hub',
    cost: 'Free courses, listed on the government platform',
    good: 'Sampling a skill at no cost, and finding apprenticeship and job links.',
    catch: 'Quality varies by course. Check the last update and whether it ends in a project.',
  },
  {
    route: 'SWAYAM and NPTEL',
    cost: 'Course content is free. The certificate needs a proctored exam, which carries a fee.',
    good: 'University-level material, and credit transfer where your institution has approved it under UGC or AICTE rules.',
