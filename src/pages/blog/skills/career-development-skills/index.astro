---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career development skills: how to pick the one your career is stuck on';
const description =
  'Career development skills work best when chosen by what is blocking you: no shortlists, no offers, no growth or a pay ceiling. Pick one and prove it.';
const canonical = 'https://futurecareerschool.com/blog/skills/career-development-skills/';
const publishedDateISO = '2026-09-29';
const publishedDateLabel = '29 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career strategist and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'why-lists-fail', label: 'Why a list of ten skills does not help' },
  { id: 'blocker-check', label: 'The Career Blocker Check' },
  { id: 'by-stage', label: 'Career development skills by career stage' },
  { id: 'foundation-floor', label: 'The foundation floor most people skip' },
  { id: 'data', label: 'What current data says, and what it does not' },
  { id: 'skill-stack', label: 'Core skill, multiplier and the human layer' },
  { id: 'ai-layer', label: 'Where AI changes the plan' },
  { id: 'learning-routes', label: 'Free first: the learning routes worth using' },
  { id: 'budget', label: 'Money and time budget' },
  { id: 'test-first', label: 'Test a skill before you commit' },
  { id: 'gates', label: 'The 3 Gates: proof that counts' },
  { id: 'mistakes', label: 'Mistakes that waste a year' },
  { id: 'related', label: 'Where this differs from nearby pages' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const blockers = [
  {
    badge: 'Blocker 1',
    title: 'No shortlists',
    symptom: 'You apply, and nothing comes back. Your CV says what you studied, not what you can do.',
    skill: 'One role-specific skill with a visible sample: a spreadsheet model, a small build, a writing piece, a case note.',
    watch: 'Adding five more generic skills to the CV makes it longer, not clearer.',
  },
  {
    badge: 'Blocker 2',
    title: 'Interviews, but no offers',
    symptom: 'You get calls, then a polite silence. You know the theory but freeze when asked what you actually did.',
    skill: 'Explaining your own decisions in plain words, plus depth in one tool you can open and use live.',
    watch: 'A communication course will not fix a proof gap. Fix the story with real work behind it.',
  },
  {
    badge: 'Blocker 3',
    title: 'Employed, but not growing',
    symptom: 'You do the same tasks every month. Your manager is happy, and nothing about your role gets bigger.',
    skill: 'A scope skill: reporting on your own numbers, owning a process, running a small project, using AI to cut repeat work.',
    watch: 'Waiting for the company to send you on training. Most plateaus break when you take one visible task upward.',
  },
  {
    badge: 'Blocker 4',
    title: 'Growing, but pay is capped',
    symptom: 'You are good at the job. The pay band, not your effort, is what limits you.',
    skill: 'A multiplier: selling and negotiation, domain plus AI, leading people, or a consulting-style skill that lets you price the outcome.',
    watch: 'Going deeper into the same task keeps you inside the same band. The ceiling moves when the kind of problem you solve changes.',
  },
];

const stageRows = [
  {
    stage: 'First job or first search',
    weekly: 'Long days of learning the basics of the job. Very little spare energy after work.',
    skill: 'One role skill you can show, written English for email and reports, spreadsheets.',
    mistake: 'Collecting course certificates before one finished sample exists.',
    proof: 'One project, internship task or sample that a stranger can open in two minutes.',
  },
  {
    stage: 'Early career, roughly the first few years',
    weekly: 'You own tasks now, but someone else sets the priorities.',
    skill: 'Data and reporting on your own work, one tool at real depth, clear updates to your manager.',
    mistake: 'Switching tools every few months and never getting deep in one.',
    proof: 'A before-and-after: what you changed, what improved, how you know.',
  },
  {
    stage: 'Mid career, roughly five to ten years in',
    weekly: 'Meetings, people, deadlines. Learning time comes from evenings and weekends.',
    skill: 'Stakeholder handling, a multiplier skill (sales sense, analytics, AI-assisted workflow design), people leadership if it suits you.',
    mistake: 'Treating a management title as the only way up when a specialist or advisory path fits you better.',
    proof: 'A process win, a team result or a client outcome you can describe with numbers.',
  },
  {
    stage: 'Returning after a break',
    weekly: 'Fragmented time. Short, repeatable study windows.',
    skill: 'One refreshed core skill, current tool fluency, and a clear one-line story for the gap.',
    mistake: 'Trying to rebuild everything at once and burning out in the first stretch.',
    proof: 'One small paid or volunteer piece of work done recently, plus an updated profile.',
  },
];

const dataCards = [
  {
    label: 'Global employer survey',
    text: 'The World Economic Forum reports that employers expect about 39% of workers\' core skills to change by 2030. Its Future of Jobs Report 2025 also finds that 63% of employers see skill gaps as the biggest barrier to business change, and that analytical thinking is the core skill most employers rank as essential.',
