const mistakeItems = [
  {
    num: '01',
    title: 'Choosing skills from a "top 10" list instead of from your blocker',
    body: 'Leadership, time management and teamwork appear on every list because they help everyone a little. None of them is why your applications are going unanswered. Diagnose first, then choose.',
  },
  {
    num: '02',
    title: 'Learning a skill for a title you have never tested',
    body: 'People spend months on data science or product management without spending one afternoon on the daily work. Read five real job posts, talk to one person in the role, and try one small task first.',
  },
  {
    num: '03',
    title: 'Treating soft skills as a course you can finish',
    body: 'Communication and leadership are proven in behaviour, not by a certificate. A short written update that your manager actually uses is better proof than a completion badge.',
  },
  {
    num: '04',
    title: 'Following the "everyone should learn coding" advice blindly',
    body: 'You will see this advice on student channels and forums. Coding is a strong core skill for some paths. For a nurse, an accountant or a teacher, a data, documentation or AI-workflow skill in your own field usually pays back faster.',
  },
  {
    num: '05',
    title: 'Ignoring the boring 80% of the target role',
