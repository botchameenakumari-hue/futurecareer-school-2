];

const costRows = [
  {
    skill: 'Advanced Excel + financial modelling',
    cost: 'Free (YouTube, CFI free tier) to Rs 15,000-25,000 for a structured modelling course',
    duration: '4-8 weeks for Excel basics, 3-6 months for real modelling depth',
    payoff: 'Recognised certification can lift pay 20-30%; modelling-literate analysts start Rs 8-15 LPA against Rs 3.5-6 LPA for Excel-only hires',
  },
  {
    skill: 'Tally Prime + GST practitioner course',
    cost: 'Rs 6,000-12,000 for a combined Tally + GST certificate',
    duration: '1-3 months (30-90 hours of actual training)',
    payoff: 'Near-universal requirement for accounts and audit-support roles; missing it filters you out before the interview stage',
  },
  {
    skill: 'Power BI / data analytics',
    cost: 'Rs 4,800-5,000 for the official PL-300 exam; Rs 10,000-25,000 for a full training track',
    duration: '6-10 weeks part-time for working proficiency',
    payoff: 'Certified Power BI professionals earn roughly 10-15% more than non-certified peers; data-literate commerce grads move into Rs 6-15 LPA analyst roles',
  },
  {
    skill: 'Digital marketing (Google certificate route)',
    cost: 'Roughly Rs 1,150-3,500 for the Google Digital Marketing & E-commerce certificate via Coursera',
    duration: 'Under 10 hours a week for about 5-6 months, or faster if you push pace',
    payoff: 'Freshers with a real certificate plus one campaign case study start around Rs 3.5-6 LPA; freelance income is possible before placement',
  },
  {
    skill: 'US CMA (for finance-heavy roles)',
    cost: 'USD 2,000-2,500 total (membership, entrance, exam, coaching)',
