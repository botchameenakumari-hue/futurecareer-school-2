---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Skills Required for Banking and Finance Careers in India";
const seoTitle = "Skills Required for Banking and Finance Careers in India";
const description = "Skills required for banking and finance careers in India: number sense, ethics, customer handling, spreadsheet skills and rule knowledge, with proof ideas and honest limits.";
const seoDescription = "Ethics and accuracy are the foundation. Speed comes later.";
const canonical = "https://futurecareerschool.com/blog/skills/skills-required-for-banking-and-finance-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which skills matter most in banking?",
    "Accuracy, ethics, customer handling, spreadsheets and rule knowledge."
  ],
  [
    "Do I need to be strong in maths?",
    "Basic number sense is needed. You can build it."
  ],
  [
    "Which exams are needed?",
    "Depends on the role. Verify notices."
  ],
  [
    "Is customer handling important?",
    "Yes, in most roles."
  ],
  [
    "How do I show ethics?",
    "Through consistent behaviour and clear answers in interviews."
  ],
  [
    "Can I practise at home?",
    "Yes, with budgets, schedules and role-plays."
  ],
  [
    "Is it stressful?",
    "Targets and deadlines can be tight."
  ],
  [
    "Will AI replace bank jobs?",
    "Routine processing shrinks. Trust and judgment remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="skills"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
