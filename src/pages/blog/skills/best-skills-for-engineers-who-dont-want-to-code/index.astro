const mistakeItems = [
  {
    num: '01',
    title: 'Treating "I don\'t want to code" as a confession instead of a skill decision',
    body: 'Disliking daily coding is not a career-ending flaw. It is information. Use it to point toward product, analysis, communication, or delivery skill groups instead of forcing five more years of a skill you already know you dislike.',
