  'https://futurecareerschool.com/blog/skills/how-long-does-it-take-to-learn-digital-marketing-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'not-one-skill', label: 'Why "digital marketing" is not one skill' },
  { id: 'channel-timelines', label: 'Timeline by channel: basics vs job-ready' },
  { id: 'seo-timeline', label: 'SEO: the slowest to prove, not the slowest to learn' },
  { id: 'paid-ads-timeline', label: 'Paid ads: fast to start, expensive to test' },
  { id: 'social-timeline', label: 'Social media: fastest basics, hardest to stand out' },
  { id: 'content-timeline', label: 'Content marketing: a writing skill wearing a marketing hat' },
  { id: 'email-crm-timeline', label: 'Email and CRM: the fastest real skill to build' },
  { id: 'course-vs-real', label: 'Course-duration claims vs what job-ready actually needs' },
  { id: 'theory-vs-proof', label: 'The gap between knowing the theory and being interview-ready' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol for your own timeline' },
  { id: 'fast-track', label: 'How to fast-track with real campaign experience' },
  { id: 'gates', label: 'The 3 Gates before you call yourself job-ready' },
  { id: 'mistakes', label: 'Mistakes that stretch the timeline for no reason' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const channelRows = [
  {
    channel: 'SEO',
    basics: 'A focused stretch of a few weeks to grasp keywords, on-page structure, and basic technical checks.',
    jobReady:
