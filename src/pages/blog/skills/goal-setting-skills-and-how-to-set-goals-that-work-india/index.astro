      margin: 0 !important;
      color: rgba(255, 255, 255, 0.82) !important;
      line-height: 1.7 !important;
      font-size: 15.5px;
    }

    .strand-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
