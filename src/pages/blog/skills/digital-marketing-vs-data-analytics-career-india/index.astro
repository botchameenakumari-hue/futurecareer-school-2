---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Digital marketing vs data analytics career India: the honest fit-first comparison';
const description =
  'Digital marketing vs data analytics career India compared on real daily work, personality fit, entry barrier, salary, and growth ceiling — plus where the two actually overlap.';
const canonical =
  'https://futurecareerschool.com/blog/skills/digital-marketing-vs-data-analytics-career-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-the-work-is', label: 'What the daily work actually looks like' },
  { id: 'fit-signals', label: 'Personality and skill fit signals' },
  { id: 'learning-curve', label: 'Learning curve and entry barrier' },
  { id: 'free-resources', label: 'How to start learning each for free' },
  { id: 'salary-reality', label: 'Salary reality: fresher to 5 years' },
  { id: 'growth-ceiling', label: 'The real career growth ceiling in each' },
  { id: 'overlap', label: 'Where the two actually overlap' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol for this decision' },
  { id: 'who-fits-dm', label: 'Who genuinely fits digital marketing' },
  { id: 'who-fits-da', label: 'Who genuinely fits data analytics' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'switching-later', label: 'Can you switch between them later?' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const workRows = [
  {
    aspect: 'Core daily task',
    dm: 'Plan and run campaigns across SEO, paid ads, social, and email; write or brief content; check performance dashboards; adjust targeting and budgets based on what is or is not converting.',
    da: 'Pull data with SQL, clean it in Excel or Python, build or maintain a dashboard in Power BI or Tableau, and answer a specific business question with a clear, defensible finding.',
  },
  {
    aspect: 'Where the day gets hard',
    dm: 'A campaign underperforms and three stakeholders have three different theories why, or a platform algorithm changes overnight and the numbers move without warning.',
    da: 'The data is missing, duplicated, or contradicts itself, and a stakeholder wants a confident number by end of day regardless of how messy the source is.',
  },
  {
    aspect: 'Main tools',
    dm: 'Google Ads, Meta Ads Manager, Google Analytics, SEO tools like Ahrefs or SEMrush, email platforms, Canva or a design tool, and increasingly AI copy and creative tools.',
    da: 'SQL, Excel, Power BI or Tableau, and Python (pandas) once the work goes beyond spreadsheet-sized data.',
  },
  {
    aspect: 'Who you talk to most',
    dm: 'Clients or brand stakeholders, designers, content writers, and sometimes sales — mostly conversations about audience, message, and budget.',
    da: 'Business teams, product managers, and leadership — mostly conversations about what a number means and what decision it should drive.',
  },
  {
    aspect: 'How your work gets judged',
    dm: 'Visible, public-facing numbers: click-through rate, cost per lead, conversion rate, engagement — often watched in near real time by whoever owns the budget.',
    da: 'A report or dashboard that gets reviewed, questioned, and sometimes overridden — success is being right and being trusted, not being fast.',
  },
];

const fitItems = [
  {
    label: 'Points toward marketing',
    title: 'You get energy from audience psychology, not just numbers',
    body: 'You naturally notice what makes people click, scroll past, or actually buy. Word choice, timing, and visuals interest you as much as the metric they produce. Data analytics can feel dry if the numbers exist without a story attached.',
  },
  {
    label: 'Points toward analytics',
    title: 'You want the answer to be provable, not persuasive',
    body: 'You would rather run a query twice and be certain than pitch a confident-sounding idea that turns out wrong. If "prove it with the data" feels satisfying rather than restrictive, that instinct fits analytics better than marketing.',
  },
  {
    label: 'Points toward marketing',
    title: 'You are comfortable being publicly, constantly measured',
    body: 'A marketing campaign\'s numbers are visible to everyone in the room the moment they update. If being watched in real time by a client or manager energises you rather than stresses you, that is a genuine marketing signal.',
  },
  {
    label: 'Points toward analytics',
    title: 'You prefer depth over constant context-switching',
    body: 'A single analytical question can take a focused stretch of quiet work to answer properly. If jumping between five channels, three stakeholders, and a content calendar in one day sounds exhausting rather than exciting, analytics rewards your preference for depth.',
  },
];

const learningRows = [
  {
    aspect: 'What "job-ready" actually requires',
    dm: 'Running real campaigns with real (even small) budgets, showing measurable results, and being able to explain what worked and why. A certificate alone rarely convinces a hiring manager without a campaign or client story behind it.',
    da: 'A working portfolio: a few real datasets cleaned and analysed, one or two dashboards, and comfort answering SQL questions live in an interview. Structured and testable, which makes "ready" easier to self-verify.',
  },
  {
    aspect: 'Typical time to interview-ready from zero',
    dm: 'Varies widely because the skill is judgment-based — some people build a credible small-campaign portfolio in a focused stretch of a few months; others need much longer because results depend on real budgets and real audiences, not just practice reps.',
    da: 'Many people reach interview-ready in roughly four to six months of consistent, focused study on SQL, Excel, and one BI tool, because the skill can be practiced and self-tested on public datasets without needing an ad budget.',
  },
  {
    aspect: 'Formal degree dependency',
    dm: 'Low. Marketing hires on a portfolio of real results (traffic grown, leads generated, ROAS improved) more than on a degree label, in agencies especially.',
    da: 'Low to moderate. No specific degree is required, and any graduate willing to learn SQL and a BI tool can compete, but formal quantitative training gives a head start on the technical interview round.',
  },
  {
    aspect: 'What makes the entry filter hard',
    dm: 'You cannot fully practice this in a vacuum — a portfolio needs a real audience, even a small one, or your "campaign" is just a simulation nobody can verify.',
    da: 'The skill itself is easy to start and technically demonstrable, but the market is crowded with people who have a certificate and no real project, so plain credentials rarely clear the interview bar alone.',
  },
];

const freeResourceItems = [
  {
    label: 'Digital marketing',
    title: 'Start free, then pay only for structure',
    body: 'Google\'s own Skillshop (Google Ads, Analytics certifications) and Meta Blueprint are free and directly test what employers actually check. Pair them with YouTube channels that show real campaign teardowns, not just theory, and practice on your own or a friend\'s small business page before spending on any paid bootcamp.',
  },
  {
    label: 'Data analytics',
    title: 'Public datasets before paid platforms',
    body: 'Kaggle datasets, Mode Analytics\' free SQL tutorial, and Google\'s free Data Analytics fundamentals videos let you practice SQL and dashboards at zero cost. Only pay for a structured course once you know exactly which gap free resources cannot close for you — usually structured feedback or a portfolio review, not the core skill itself.',
  },
  {
    label: 'Judging any paid course',
    title: 'What you are actually paying for',
    body: 'If a paid course covers material already free on YouTube or official documentation, the fee should buy something specific: expert feedback on your real project, a structured cohort, an accountability deadline, or a placement network. Check instructor credibility, how recent the syllabus is, and whether past learners show a real project or job outcome — not just a certificate photo.',
  },
];

const salaryRows = [
  {
    stage: 'Fresher, 0-1 years',
    dm: 'Roughly Rs 2.5-6 LPA, with the wide range driven by agency vs in-house vs startup, and whether the fresher has any proof of real campaign results.',
    da: 'Roughly Rs 3-6 LPA, with a strong SQL portfolio and one real dashboard project pushing candidates toward the top of that range.',
  },
  {
    stage: '2-5 years experience',
    dm: 'Roughly Rs 6-12 LPA for solid mid-level marketers managing budgets and channels directly; performance/growth marketing specialists with a strong ROI track record can land above this band.',
    da: 'Roughly Rs 6-15 LPA, with analysts who add Python and stronger statistics moving toward the top, and many transitioning into data science-adjacent roles from here.',
  },
  {
    stage: '5+ years, senior',
    dm: 'Roughly Rs 15 LPA and above for senior strategists, growth leads, or marketing managers; the higher end usually goes to people who can tie campaigns directly to revenue, not just traffic.',
    da: 'Roughly Rs 14-22 LPA and above for senior analysts and analytics managers; specialists who add machine learning or advanced statistics can push meaningfully past this.',
  },
  {
    stage: 'What moves the number most',
    dm: 'Proof that a campaign generated revenue or qualified leads, not impressions — attribution and ROI framing separate well-paid marketers from the rest.',
    da: 'Technical range (SQL plus Python plus statistics) combined with the ability to explain findings to a non-technical stakeholder in plain language.',
  },
];

const growthRows = [
  {
    signal: 'Typical promotion ladder',
    dm: 'Executive to senior executive to manager to head of marketing/growth, or a parallel move into agency leadership or founding your own marketing consultancy or agency once you have a client track record.',
    da: 'Junior analyst to senior analyst to analytics manager to head of analytics, or a lateral move into data science, business intelligence leadership, or product analytics.',
  },
  {
    signal: 'Ceiling driven by',
    dm: 'Your ability to tie marketing spend to revenue and lead a team or client roster, plus, for many, the option to go independent and build a personal client base or agency once you have proof of results.',
    da: 'Technical depth (statistics, Python, sometimes machine learning) plus the ability to influence business decisions, not just report on them.',
  },
  {
    signal: 'India-specific demand signal',
    dm: 'Industry estimates put roughly 2 million professionals currently employed in digital marketing in India, with projections of around 5 million digital marketing jobs by 2027 as more D2C, e-commerce, and SaaS brands build in-house teams.',
    da: 'Industry estimates project around 11.5 million new data-and-analytics-related jobs in India by 2030, with data analyst openings consistently ranked among the fastest-growing entry-to-mid roles on major job boards.',
  },
  {
    signal: 'Independent income path',
    dm: 'Realistic and common — freelance marketing, running a small agency, or consulting for multiple brands is a well-worn path once you have 2-3 verifiable results to show.',
    da: 'Less common as a solo freelance path early on, though senior analysts increasingly move into consulting or fractional analytics-lead roles once they have deep domain expertise.',
  },
];

const overlapItems = [
  {
    num: '01',
    title: 'Marketing analyst / growth marketer',
    body: 'Owns campaign performance end to end: sets up tracking, pulls the data, and decides where budget should move next. Needs enough SQL and spreadsheet skill to not depend on someone else for the numbers, plus enough marketing judgment to act on what the numbers show.',
  },
  {
    num: '02',
    title: 'Marketing data analyst',
    body: 'Sits closer to the analytics side but works exclusively on marketing questions: attribution modelling, customer lifetime value, campaign ROI, and channel mix. Heavier on SQL and statistics than a typical marketing executive, lighter on hands-on campaign execution than a typical data analyst.',
  },
  {
    num: '03',
    title: 'Performance marketing specialist',
    body: 'A marketer who has gone deep enough into platform data (Google Ads, Meta Ads, GA4) to essentially run their own analytics layer inside a narrower, paid-media-focused lane, often the highest-paid non-managerial marketing track.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Digital marketing rewards people who enjoy being watched and measured in real time and who get satisfaction from persuading an audience. Data analytics rewards people who enjoy sitting quietly with a stubborn dataset until the pattern becomes clear, and who prefer proof over persuasion. Both need real focus — the difference is whether your energy comes from audience reaction or from getting a number verifiably right.',
    note: 'If you dread the idea of a client watching your campaign numbers live on a call, that discomfort is a real signal, not something you will simply grow out of.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can your family runway absorb a fresher-level salary (Rs 2.5-6 LPA in either lane) for the first 1-2 years while you build real proof? Marketing proof often needs a real, even small, budget to be believable; analytics proof can be built almost entirely on your own time with public datasets.',
    note: 'If you have zero access to any budget or client to practice marketing on, that is a practical constraint worth weighing honestly before choosing that lane.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Both fields are growing in India, but the entry filter works differently. Analytics has a more standardised, testable interview process built around SQL and dashboards. Marketing hiring is judgment-heavy and depends more on a story of real results than on a repeatable technical test.',
    note: 'A wider, more standardised filter (analytics) is a different risk profile from a narrower, story-driven filter (marketing) — neither is automatically easier.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI tools now write ad copy, generate campaign variations, and produce first-draft data summaries in both fields. The safer position in marketing is becoming the person who understands audience psychology well enough to judge what the AI produced. The safer position in analytics is becoming the person who frames the right question and checks the AI\'s numbers before anyone acts on them.',
    note: 'The useful question in both lanes is not "will AI do this task," it is "which judgment call in this role still needs a human to own it."',
  },
];

const dmFitItems = [
  {
    label: 'Genuine fit',
    title: 'You like seeing an idea move an audience in real time',
    body: 'You get real satisfaction from watching a post, ad, or email actually change behaviour — more clicks, more replies, more sales. If dashboards without a "why did this work" story feel incomplete to you, this is a strong signal.',
  },
  {
    label: 'Genuine fit',
    title: 'You can hold ambiguity without needing a clean answer',
    body: 'Marketing rarely gives you a single provable cause. Two campaigns can look identical and get different results, and you have to form a reasonable theory and act on it anyway. If that uncertainty energises you rather than frustrates you, that fits.',
  },
  {
    label: 'Genuine fit',
    title: 'You want a path that can go independent later',
    body: 'If owning your own client roster, running a small agency, or freelancing across multiple brands appeals to you, marketing has a more well-worn, faster independent-income path than most analytics tracks.',
  },
];

const daFitItems = [
  {
    label: 'Genuine fit',
    title: 'You want your conclusion to survive being challenged',
    body: 'You would rather say "I do not know yet, let me check the data" than guess confidently. If being proven right by a query, not by persuasion, feels more satisfying, that instinct is the core of the job.',
  },
  {
    label: 'Genuine fit',
    title: 'You can sit with structured, repetitive precision without losing focus',
    body: 'Cleaning messy data and writing careful SQL joins is not glamorous. If you can stay accurate through unglamorous, detail-heavy work rather than needing constant creative variety, that is a real signal.',
  },
  {
    label: 'Genuine fit',
    title: 'You want a more standardised, self-testable entry path',
    body: 'If you would rather practice a skill against public datasets and know objectively whether you are ready, instead of needing a real client or budget to prove yourself, the analytics entry path suits how you like to prepare.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Picking data analytics only because the average salary number looks higher',
    body: 'Average salary comparisons hide the spread. A marketer with two verifiable campaign wins can out-earn an analyst with only a certificate and no real project, and vice versa. The average field-level number does not predict your individual outcome — your proof of work does.',
  },
  {
    num: '02',
    title: 'Assuming digital marketing has no real skill bar because "anyone can post on Instagram"',
    body: 'Running a personal Instagram account and running a client\'s paid acquisition budget are not the same skill. The real bar in marketing is tying spend to revenue, not posting content, and that bar has gotten harder as platforms and algorithms keep changing.',
  },
  {
    num: '03',
    title: 'Assuming a data analytics certificate alone will get you hired',
    body: 'The technical skill is learnable in months, which means the market has plenty of certificate-holders with no real project. A dashboard built on one messy, real dataset beats three completed course certificates with no live data behind them.',
  },
  {
    num: '04',
    title: 'Treating the two paths as permanently separate',
    body: 'A meaningful number of working professionals move between them — marketers who add SQL and Python step into marketing analytics, and analysts who add campaign and business context step into growth roles. The overlap lane is real and growing, not a rare exception.',
  },
  {
    num: '05',
    title: 'Ignoring how AI is reshaping the entry-level tasks in both fields',
    body: 'Generative AI tools now draft ad copy, generate campaign variants, and produce first-pass data summaries in minutes. Choosing either path and coasting on routine entry-level tasks alone is a weaker bet than it was a few years ago in both lanes, not just one.',
  },
];

const faqItems = [
  {
    q: 'Digital marketing vs data analytics career India: which pays more?',
    a: 'On average, industry salary trackers put data analysts a step ahead, with average pay often cited around Rs 6-6.5 LPA against roughly Rs 3 LPA for digital marketers. But averages hide a wide spread: senior growth marketers and performance marketing specialists with a strong ROI track record regularly match or beat analyst pay, and a marketer with real client results can out-earn a fresher analyst with only a certificate. Past the fresher stage, your proof of work moves the number more than the field label does.',
  },
  {
    q: 'Which is easier to learn, digital marketing or data analytics?',
    a: 'Data analytics has a more standardised, self-testable learning path — SQL, Excel, and one BI tool can be practiced against public datasets, and many people reach interview-ready in roughly four to six months of focused study. Digital marketing is not necessarily harder, but it is harder to practice in isolation, because a credible portfolio usually needs a real audience or budget, even a small one, to prove the results actually worked.',
  },
  {
    q: 'Do I need a technical or math background for data analytics in India?',
    a: 'Not a specific degree, but comfort with structured, logical thinking helps. No degree is mandatory, and any graduate willing to learn SQL, Excel, and a BI tool like Power BI or Tableau can compete for entry-level data analyst roles. Adding Python later widens both your skill range and your salary ceiling.',
  },
  {
    q: 'Is digital marketing a good career in India for someone who is not "creative"?',
    a: 'Yes, if the appeal is strategy and numbers rather than design. Roles like performance marketing, SEO strategy, and paid media management lean more on data interpretation, budget logic, and testing discipline than on visual creativity, which a design or content teammate usually handles. Many strong performance marketers describe themselves as analytical, not artistic.',
  },
  {
    q: 'Can a digital marketer move into data analytics later, or the other way around?',
    a: 'Yes, and it happens often through the marketing analytics lane. A marketer who adds SQL, basic Python, and attribution modelling can move into marketing analyst or growth marketer roles without abandoning marketing entirely. An analyst who adds campaign platform knowledge and business framing can move into marketing analytics from the data side. Full data science is a bigger jump for a marketer and usually needs 6-12 months of dedicated statistics and Python study plus real projects.',
  },
  {
    q: 'What is marketing analytics and is it a real career lane in India?',
    a: 'Marketing analytics is the overlap zone between the two fields — using data skills like SQL, dashboards, and attribution modelling specifically to answer marketing questions: which channel actually drives revenue, what a customer is worth over time, and where budget should move next. It is a genuine and growing lane in Indian D2C, e-commerce, and SaaS companies, not a vague hybrid title, and it often pays closer to the analytics band than the marketing one.',
  },
  {
    q: 'Which one is safer from AI in the long run?',
    a: 'Neither is being replaced wholesale, but the easy entry-level layer is shrinking in both. AI tools already draft ad copy, build campaign variants, and produce first-pass data summaries. In both fields, the safer position is becoming the person who frames the strategy or the question correctly, directs the AI tool, and checks its output before anyone relies on it — not the person who only does the routine task the AI can now do faster.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="skills"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Digital marketing vs data analytics career India comes down to one honest trade: digital
    marketing rewards people energised by audience psychology, fast iteration, and being publicly
    measured in real time, while data analytics rewards people who want provable, defensible answers
    from a quieter, more structured kind of focus.</strong>
    Neither is the "creative one" or the "technical one" in any simple way — good marketers read numbers
    constantly, and good analysts have to explain their findings persuasively. The real decision is
    about daily energy, entry-path shape, and the specific proof of work you are willing to build, not
    which field sounds more impressive on a resume.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Marketing work is judgment-heavy and publicly measured in real time; analytics work is structured, precision-heavy, and privately verified before it goes public.</li>
      <li>Data analytics has a more standardised entry path through SQL, Excel, BI tools, and public datasets; credible marketing proof usually needs a real audience, campaign, or budget.</li>
      <li>Typical salaries lean toward analytics, but the range is wide: a marketer with measurable results can outperform an analyst with only certificates.</li>
      <li><strong>The strongest overlap is marketing analytics,</strong> where campaign and customer context meet SQL, attribution, experimentation, and dashboards.</li>
      <li>Test both with a small campaign and a real dataset analysis before paying for a long course or changing careers.</li>
      <li>Domain knowledge plus AI is the multiplier in both lanes. Communication and measurable business outcomes can turn either skill set into specialist work, consulting, leadership, or ownership leverage.</li>
    </ul>
  </div>

  <p>
    If you are still weighing this against the wider question of which skill to build first, read
    <a href="/blog/skills/">the Skills category</a> for the broader decision-making guides before narrowing
    down to just these two lanes.
  </p>

  <p>
    If the pressure to decide is real — a course deadline, a job offer, or family expectations pushing
    you one way — a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you weigh this specific decision against your own situation, not a generic list.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer to digital marketing vs data analytics career India</h2>

  <p>
    There is no universal winner, and any article that hands you one has not actually looked at how
    differently these two jobs feel on a Tuesday afternoon.
  </p>

  <p>
    Digital marketing wins on reach and independence: it touches almost every business that sells
    online, the entry path does not depend on a specific degree, and it opens a genuinely well-worn road
    to freelancing or running your own small agency once you have real results to show.
  </p>

  <p>
    Data analytics wins on structure and provability: the skill is easier to self-test against public
    data, the entry filter is more standardised, and the technical range you build compounds into higher
    pay and a wider set of adjacent roles, including data science.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Both fields get oversold for opposite reasons. Digital marketing gets sold as "easy, just post
      content and get paid," which ignores how hard it actually is to prove real ROI on a real budget.
      Data analytics gets sold as "guaranteed high salary after a 3-month course," which ignores how
      crowded the entry-level certificate pool already is. The honest version: both have real demand,
      both have a real entry filter, and your actual fit and proof of work decide the outcome far more
      than the field you pick on paper.
    </p>
  </div>

  <h2 id="what-the-work-is">What the daily work actually looks like in each career</h2>

  <p>
    Most comparisons stop at job titles and salary charts before ever describing what a normal working
    day feels like. That is the part that should actually drive your decision.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Aspect of the work</th>
          <th>Digital marketing</th>
          <th>Data analytics</th>
        </tr>
      </thead>
      <tbody>
        {workRows.map((item) => (
          <tr>
            <td data-label="Aspect of the work"><strong>{item.aspect}</strong></td>
            <td data-label="Digital marketing">{item.dm}</td>
            <td data-label="Data analytics">{item.da}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    Notice the real difference is not "creative vs technical." Marketers use data constantly — every
    ad platform is a numbers dashboard — and analysts have to persuade people of their findings. The
    real difference is direction: marketing work looks outward at an audience and reacts to it in real
    time; analytics work looks inward at a dataset and defends a conclusion before it goes public.
  </p>

  <h2 id="fit-signals">Personality and skill fit signals worth taking seriously</h2>

  <p>
    A quiz result or a single personality label will not settle this. These four signals, drawn from how
    each job actually runs day to day, are more useful.
  </p>

  <div class="feature-grid">
    {fitItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    Notice these are about daily energy and comfort, not raw talent. Plenty of highly analytical people
    work in marketing, and plenty of persuasive, sociable people work in analytics leadership. The
    signals point at which day-to-day rhythm will drain you less over years, not which one you are
    "smart enough" for.
  </p>

  <h2 id="learning-curve">Learning curve and entry barrier: the part most comparisons skip</h2>

  <p>
    "Which is easier to learn" is the wrong question on its own — the two fields are hard to learn in
    different ways, and that difference changes how confident you can feel before you ever apply for a
    job.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Learning curve factor</th>
          <th>Digital marketing</th>
          <th>Data analytics</th>
        </tr>
      </thead>
      <tbody>
        {learningRows.map((item) => (
          <tr>
            <td data-label="Learning curve factor"><strong>{item.aspect}</strong></td>
            <td data-label="Digital marketing">{item.dm}</td>
            <td data-label="Data analytics">{item.da}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Data analytics is easier to self-verify: you either wrote the correct SQL query or you did not.
      Digital marketing is harder to self-verify because you need real conditions — an actual audience,
      an actual small budget — to know if your work genuinely converts, not just looks good in a
      portfolio deck. Neither of these makes one field "easier." It changes what kind of practice
      environment you need before you can honestly call yourself job-ready.
    </p>
  </div>

