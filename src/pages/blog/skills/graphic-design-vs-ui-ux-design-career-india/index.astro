  },
];

const fitItems = [
  {
    label: 'Points toward graphic design',
    title: 'You want to see a finished, polished visual object',
    body: 'You get satisfaction from a piece looking exactly right — the right typeface, the right spacing, the right colour story — and from that piece existing as a complete, shippable thing once it is done. Ongoing iteration based on user data can feel less satisfying than nailing the visual in one strong pass.',
  },
  {
    label: 'Points toward UI/UX',
    title: 'You want the design to be provably right, not just beautiful',
    body: 'You would rather test an assumption with five real users than trust your own instinct about what looks good. If "the design changed because the data said so" feels like progress rather than a loss, that instinct fits UI/UX better than graphic design.',
  },
  {
    label: 'Points toward graphic design',
    title: 'You want quicker, more visible creative wins',
    body: 'A logo, poster, or brand deck can go from blank canvas to finished, admired output in days. If you need that fast creative payoff to stay motivated, graphic design delivers it more often than product design cycles do.',
  },
  {
    label: 'Points toward UI/UX',
    title: 'You are comfortable being wrong in front of other people',
    body: 'Usability testing regularly proves your first idea did not work. If watching a real user struggle with your screen feels like useful information rather than a personal failure, that comfort with being publicly wrong is a real UI/UX signal.',
  },
];

const learningRows = [
  {
    aspect: 'What "job-ready" actually requires',
    gd: 'A tight portfolio of finished visual work — logos, branding projects, social or print campaigns — that shows range and consistency. Craft and taste are judged almost entirely by the eye, so the portfolio has to look genuinely professional, not just competent.',
    uiux: 'A case-study portfolio that shows your process: the problem, the research, the wireframes, the testing, and the final design with reasoning. Employers hire the thinking behind the screens as much as the screens themselves.',
