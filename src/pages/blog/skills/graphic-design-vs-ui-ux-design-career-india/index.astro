const workRows = [
  {
    aspect: 'Core daily task',
    gd: 'Design static visual assets: logos, brand identity, packaging, social creatives, print collateral, or marketing decks. Work is briefed, designed, revised, and shipped as a finished visual file.',
    uiux: 'Research how people use a product, then wireframe, prototype, and design screens for an app or website. Work is designed, tested with real users, and revised based on what the test shows, not just personal taste.',
