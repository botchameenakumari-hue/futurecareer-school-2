const gdFitItems = [
  {
    label: 'Genuine fit',
    title: 'You want your work to be visually judged, fast',
    body: 'You get real satisfaction from a design looking exactly right and from other people reacting to it immediately — a logo reveal, a poster, a campaign visual. If a long research-and-testing cycle before anything ships sounds slow and frustrating, this is a strong signal.',
