];

const overlapItems = [
  {
    num: '01',
    title: 'Brand and product designer',
    body: 'Owns both the visual identity and the product screens for a smaller company or startup that cannot yet afford separate specialists. Needs strong visual craft plus enough UX process discipline to design flows that actually work, not just look right.',
  },
  {
    num: '02',
    title: 'UI designer (visual-heavy UX role)',
    body: 'Sits inside a UX team but focuses more on the visual polish, design systems, and component libraries than on research — a natural landing spot for a strong graphic designer who adds UI craft without going fully into research-led UX.',
  },
  {
    num: '03',
    title: 'Marketing and growth designer',
    body: 'Designs landing pages, ad creatives, and onboarding flows where brand visual quality and basic conversion-focused UX thinking both matter — heavier on visual craft than a pure product designer, lighter on deep research than a pure UX role.',
  },
];

