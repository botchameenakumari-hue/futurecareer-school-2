  },
  {
    aspect: 'What makes the entry filter hard',
    gd: 'The market is saturated with visually competent generalists, so pure taste and speed increasingly need to be paired with a niche (packaging, motion, brand systems) to stand out.',
    uiux: 'The title is hyped enough that many bootcamp graduates apply with template-based case studies that look similar to a hundred others; a real, evidence-based case study with actual user testing behind it is what actually clears the interview bar.',
  },
];

const salaryRows = [
  {
    stage: 'Fresher, 0-1 years',
