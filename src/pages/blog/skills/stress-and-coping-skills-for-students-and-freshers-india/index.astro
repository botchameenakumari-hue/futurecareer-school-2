const description = "Stress and coping skills for students and freshers in India: planning, boundaries, rest, support and healthy routines, a practice plan and when to seek professional help.";
const seoDescription = "Small routines reduce load. Serious distress needs real help.";
const canonical = "https://futurecareerschool.com/blog/skills/stress-and-coping-skills-for-students-and-freshers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What are good coping skills?",
    "Planning, boundaries, rest, movement and talking to someone you trust."
  ],
  [
    "Is some stress normal?",
    "Yes. Persistent heavy stress needs attention."
  ],
  [
    "When should I seek professional help?",
    "If you feel overwhelmed for weeks or unsafe."
  ],
  [
    "What if I am worried about a friend?",
    "Stay with them and help them reach a trusted adult or professional."
  ],
  [
    "How do I say no?",
    "Use a polite sentence and offer an alternative time."
  ],
  [
    "Will exercise help?",
    "Short daily movement helps many people."
  ],
  [
    "Is this medical advice?",
    "No. It covers everyday habits only."
  ],
  [
    "Will AI help?",
    "For planning only. People matter more."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
