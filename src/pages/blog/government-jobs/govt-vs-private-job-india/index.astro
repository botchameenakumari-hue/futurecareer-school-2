---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Government job vs private job India: the honest trade-off, not the salary chart';
const description =
  'Government job vs private job India comes down to security versus speed. Real 7th CPC pay data, UPSC prep-years odds, pension rules, and how the calculus shifts by field.';
const canonical =
  'https://futurecareerschool.com/blog/government-jobs/govt-vs-private-job-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'structure-table', label: 'What actually differs, side by side' },
  { id: 'pay-reality', label: 'Pay reality: 7th CPC vs private salary bands' },
  { id: 'security-pace', label: 'Job security and daily pace' },
  { id: 'pension-benefits', label: 'Pension and retirement: NPS vs EPF' },
  { id: 'prep-years', label: 'The prep-years cost nobody puts in the brochure' },
  { id: 'runway-test', label: 'The 3-Runway Test before you commit to prep' },
  { id: 'who-fits-govt', label: 'Who genuinely benefits from a government job' },
  { id: 'who-fits-private', label: 'Who genuinely benefits from a private job' },
  { id: 'by-field', label: 'How the calculus changes by field' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const structureRows = [
  {
    aspect: 'Job security',
    govt: 'Near-total. Termination requires proven serious misconduct, and the process runs through departmental inquiries and appeals that can take years.',
    private: 'Conditional on business performance. Layoffs happen during slowdowns, restructuring, or when a role becomes redundant, even at large stable companies.',
  },
  {
    aspect: 'Pay growth mechanism',
    govt: 'Fixed annual increment of 3% of basic pay, plus a pay-commission revision roughly once a decade that resets the whole scale.',
    private: 'Performance-linked, with average appraisal hikes around 9.1% projected for 2026, and individual increments of 15-40% in fast-growing fields for strong performers.',
  },
  {
    aspect: 'Daily pace',
    govt: 'Process-driven and rule-bound. Decisions move through defined channels; individual output rarely changes your monthly pay.',
    private: 'Output and deadline-driven. Targets, review cycles, and client or market pressure shape the day far more directly.',
  },
  {
    aspect: 'Time off and hours',
    govt: 'Fixed hours, generous leave, and a public holiday calendar that typically runs noticeably longer than private-sector norms.',
    private: 'Hours track the role and sector; leave policy varies by company and is rarely as generous as the government holiday calendar.',
  },
  {
    aspect: 'Entry gate',
    govt: 'A competitive written exam and, for many services, an interview — the exam itself is the main filter, not your resume.',
    private: 'Resume, interview rounds, and demonstrated skill or portfolio quality decide entry; no single national exam gates most private roles.',
  },
];

const payRows = [
  {
    stage: 'Entry level',
    govt: 'Minimum basic pay across central government Pay Level 1 is Rs 18,000 a month under the 7th Pay Commission matrix. With Dearness Allowance at 60% (April 2026) and House Rent Allowance layered in, gross entry pay for a Level 1 post runs well above the basic figure, but most competitive-exam entrants land in Pay Level 6-10, which starts materially higher.',
    private: 'A fresh engineering graduate from a reasonable college typically starts around Rs 6-12 LPA in private tech roles; other fields vary widely by company tier, from services-company floors well below that to premium employers well above it.',
  },
  {
    stage: 'Annual growth',
    govt: 'Increments are fixed at 3% of basic pay each year, moving you one cell along your pay level in the matrix, regardless of individual performance.',
    private: 'Average projected appraisal hike for 2026 is 9.1%, with junior employees often seeing the highest increases as companies focus on retention; strong performers in high-demand skills can see far more.',
  },
  {
    stage: 'Structural reset',
    govt: 'Government pay does not track private-market inflation directly; it resets through pay commissions roughly once every ten years. The 7th CPC applied a 2.57 fitment factor in 2016, and an 8th Pay Commission was approved in principle in 2025, with a 25-34% hike under discussion, though terms of reference were still pending as of April 2026.',
    private: 'Private pay adjusts continuously through the job market — switching companies is the fastest lever, since internal appraisal caps rarely match what a competitive external offer can pay for the same skill.',
  },
];

const prepFacts = [
  {
    label: 'UPSC Civil Services',
    fact: 'Roughly 10.16 lakh candidates applied and 5.92 lakh appeared for one recent cycle; about 1,016 were finally selected — a success rate close to 0.17%. Only about 7% of successful candidates clear it on their first attempt; the rest take multiple attempts, commonly 3-4 or more.',
  },
  {
    label: 'Time actually spent',
    fact: 'A meaningful share of serious aspirants spend 6 to 12 years on repeated attempts before either clearing an exam or stepping away from the track altogether — years that, in a private career, would have carried three to four job switches and multiple full appraisal cycles.',
  },
  {
    label: 'What a private year buys instead',
    fact: 'One year in a private role at current appraisal trends adds roughly 9% to base pay through the standard cycle, and a job switch in a high-demand skill can add 20-40% in a single move — compounding differently than a flat exam-prep year with no income and no resume progression.',
  },
];

const runwayItems = [
  {
    num: '01',
    title: 'Money runway',
    body: 'Can your household genuinely absorb 1 to 3 years of zero or near-zero income without derailing rent, a sibling\'s education, or a parent\'s medical costs? Government exam prep is not a paid internship — coaching, books, and living costs run for years before a single rupee of salary shows up, if it shows up at all.',
    note: 'If the honest answer is "we would be in real financial trouble past year one," that is not a motivation problem — it is a runway problem, and it changes the decision regardless of how badly you want the post.',
  },
  {
    num: '02',
    title: 'Attempt runway',
    body: 'Most exams cap the number of attempts or the age at which you can sit them. Know your actual number of remaining attempts and the real odds at each stage — prelims, mains, interview — instead of treating the exam as a single pass/fail event you can retry indefinitely.',
    note: 'A 0.17% overall success rate does not mean each individual attempt is that unlikely for a well-prepared candidate at the mains stage, but it does mean the early stages filter out most people, and knowing where you are likely to fail changes how you should prepare.',
  },
  {
    num: '03',
    title: 'Backup runway',
    body: 'Are you building any parallel proof of work, skill, or income while you prepare, or is government prep your entire identity for years at a stretch? Aspirants who keep one adjacent skill alive — teaching, content, a part-time role, a certification — have a real re-entry path if the exam does not work out. Aspirants with zero backup often face the hardest re-entry of any career decision in this space.',
    note: 'This is not a hedge against ambition. It is the difference between a failed attempt costing you a year and a failed attempt costing you a decade of employability.',
  },
];

const govtFitItems = [
  {
    label: 'Genuine fit',
    title: 'You value certainty over ceiling',
    body: 'If a guaranteed monthly income, a pension structure, and near-total job security matter more to you than a chance at a much higher private ceiling, government roles deliver exactly what they promise, consistently, for decades.',
  },
  {
    label: 'Genuine fit',
    title: 'You can genuinely absorb a multi-year prep runway',
    body: 'People whose family finances, mental health, and support system can carry a real multi-year exam-prep window without it becoming a financial or emotional crisis are the ones who actually benefit from attempting the harder exams.',
  },
  {
    label: 'Genuine fit',
    title: 'You want authority, service, or a defined public role',
    body: 'Many government roles carry decision-making authority, local influence, or a service mandate that a private job of similar seniority simply does not offer at the same career stage.',
  },
];

const privateFitItems = [
  {
    label: 'Genuine fit',
    title: 'You want compounding pay tied to your own output',
    body: 'If you would rather be paid for what you build and can prove, not for tenure in a fixed matrix, private roles reward demonstrated skill and job switches far faster than any government pay scale can move.',
  },
  {
    label: 'Genuine fit',
    title: 'You want to start earning now, not after a multi-year filter',
    body: 'Private hiring runs on resume and interview performance, not a single national exam. If you need income sooner rather than later, or your family cannot support a multi-year unpaid prep window, this is the faster real door.',
  },
  {
    label: 'Genuine fit',
    title: 'You want mobility across companies, cities, and even countries',
    body: 'Private-sector skill is portable in a way a government post rarely is. Switching employers, relocating, or moving into a completely different industry is a normal private-career move; it is a much rarer government one.',
  },
];

const fieldItems = [
  {
    num: '01',
    title: 'Engineering: GATE-PSU route vs private tech',
    body: 'GATE-qualified PSU roles (NTPC, ONGC, BHEL, and similar) offer government-level security with meaningfully better starting pay than a typical Pay Level 1-6 clerical post, plus defined promotion timelines. Private tech pays faster at the top end and rewards continuous skill-building, but carries real layoff and AI-driven role-shrinkage risk at the junior layer, especially in service-heavy companies. The GATE exam itself is a real, survivable filter for engineers compared with UPSC-level odds — a strong reason engineering graduates often treat GATE-PSU as the realistic government lane, not the civil services exams.',
  },
  {
    num: '02',
    title: 'Commerce: banking and SSC exams vs private finance',
    body: 'Bank PO exams (IBPS PO, SBI PO) run large annual vacancy cycles — IBPS PO alone opened over 6,700 posts and SBI PO around 1,500 posts in a recent cycle — with SBI PO cost-to-company revised upward to roughly Rs 21.97 lakh, making bank PO one of the better-paying, higher-volume government entry points for commerce graduates. Private finance (financial analyst, corporate finance, FP&A) has no exam gate at all and pays a working salary from day one, but fresher pay for a plain financial analyst role often starts lower than a bank PO offer once perks and pension are counted.',
  },
  {
    num: '03',
    title: 'General/humanities: SSC CGL and state PSCs vs private generalist roles',
    body: 'SSC CGL and state Public Service Commission exams offer a genuinely wider door than UPSC civil services for humanities and general graduates, with far higher vacancy counts and comparatively better odds per attempt, even though pass rates are still competitive. Private generalist roles (operations, HR, sales, content, business development) have no exam gate and reward communication and proof of work, but pay ceilings without a specialised skill or credential tend to plateau earlier than in engineering or finance-adjacent private tracks.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating "government job vs private job" as one universal decision',
    body: 'The honest comparison changes completely by exam, by field, and by how much runway your specific household can absorb. A GATE-PSU decision for an engineer and a UPSC decision for a humanities graduate are not the same bet, even though both get filed under "government job."',
  },
  {
    num: '02',
    title: 'Counting only the salary number, not the pension and time-off value',
    body: 'A government salary that looks lower on paper often closes part of the gap once pension structure, job security, and leave days are priced in. A private salary that looks higher often has real deductions once you price in bonus variability, notice-period risk, and no defined-benefit pension.',
  },
  {
    num: '03',
    title: 'Starting multi-year exam prep without running the 3-Runway Test first',
    body: 'Ambition is not a plan. Money runway, attempt runway, and backup runway are the three things that actually determine whether a multi-year attempt is a smart bet or a slow-motion financial and emotional risk for your specific situation.',
  },
  {
    num: '04',
    title: 'Assuming private-sector instability means private jobs are always the riskier choice',
    body: 'Private-sector attrition and layoff risk are real, but so is the risk of spending years unemployed in exam prep with no fallback skill. Risk shows up differently in each path — it does not disappear on either side.',
  },
  {
    num: '05',
    title: 'Ignoring that AI and automation are reshaping both sides differently',
    body: 'Private entry-level roles in IT services and routine back-office work face real automation pressure. Government roles are comparatively insulated from AI-driven headcount cuts in the near term, but that insulation is a security argument, not a growth argument — it does not raise your ceiling.',
  },
];

const faqItems = [
  {
    q: 'Government job vs private job India: which pays more overall?',
    a: 'It depends on stage and role. At entry level, many private tech and finance roles pay more in raw salary than a Pay Level 1-6 government post, but a bank PO or GATE-PSU offer can match or beat an average private fresher offer once you add allowances. At senior levels, top private roles usually out-earn government pay scales significantly, since private growth is performance-linked while government growth is a fixed 3% annual increment plus periodic pay-commission resets. Once pension, job security, and leave value are priced in, the real gap narrows further in government\'s favour than the basic salary alone suggests.',
  },
  {
    q: 'Is a government job really more secure than a private job in India?',
    a: 'Yes, structurally. A government employee cannot be terminated without proven serious misconduct, and that process runs through formal inquiries and appeals that can take years. Private-sector job security depends on company performance, sector attrition trends, and individual role relevance — even large, stable companies restructure or reduce headcount during slowdowns.',
  },
  {
    q: 'How many years does serious UPSC or government exam preparation actually take?',
    a: 'For the toughest exams like UPSC Civil Services, a meaningful share of serious aspirants spend 6 to 12 years across multiple attempts, with about 93% of eventual successes coming after more than one attempt. Field-specific exams like GATE (for PSU jobs) or bank PO exams typically have shorter, more predictable prep windows of 6 months to 2 years, since the syllabus and competition structure are narrower than a national civil-services exam.',
  },
  {
    q: 'Does a government job still make sense with AI changing the job market?',
    a: 'Government roles are comparatively insulated from AI-driven headcount reduction in the near term, since public-sector hiring and retention decisions do not follow private profit-and-loss logic. That insulation is a real security advantage, but it is not a growth advantage — government pay scales do not compound with AI-driven productivity the way skilled private roles can. The safer long-term position in either path is still building a real, demonstrable skill, not assuming either sector is immune to change.',
  },
  {
    q: 'What is the difference between NPS and the pension private employees get?',
    a: 'Government employees who joined after January 2004 are on the National Pension System (NPS), a market-linked scheme, not the older guaranteed-pension structure. Private-sector employees typically build retirement savings through the Employees\' Provident Fund (EPF), with mandatory 12% contributions matched by the employer and government-set guaranteed returns. Both government and private employees can also voluntarily contribute to NPS on top of their primary retirement structure.',
  },
  {
    q: 'Should engineering, commerce, and humanities graduates think about this decision the same way?',
    a: 'No. Engineers usually have a stronger, faster government lane through GATE-PSU roles, which pay better and filter faster than UPSC-level exams. Commerce graduates have a genuinely large, well-paying door through bank PO exams, which run high-volume annual cycles. Humanities and general graduates face the toughest odds if they aim only at UPSC civil services, but often have better real odds through SSC CGL and state PSC exams, which have far higher vacancy counts and comparatively better per-attempt odds.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="government-jobs"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Government job vs private job India is really two separate questions stacked into one: do you
    want certainty over ceiling, and can your specific situation genuinely absorb the years a competitive
    government exam demands?</strong> The honest comparison is not "government is safe, private pays more" —
    real 7th Pay Commission data, current private salary trends, and government exam odds all point to a
    trade-off that changes depending on your field, your family's financial runway, and how much of your
    twenties you are willing to spend on a single filter before you know whether it works. Whichever side
    you lean toward, the fastest route to earlier financial freedom is picking the lane that matches your
    situation now, not the one that sounds most impressive at a family gathering.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Government pay grows through a fixed 3% annual increment plus a pay-commission reset roughly once a decade; private pay grows through performance appraisals averaging around 9.1% in 2026, with much higher gains for strong performers or job switchers.</li>
      <li>Government job security is close to absolute — termination requires proven serious misconduct through a multi-year process. Private security depends on business performance and sector attrition trends.</li>
      <li>The real hidden cost of chasing government roles through exams like UPSC is time: a meaningful share of serious aspirants spend 6-12 years across multiple attempts, against a success rate near 0.17% for civil services specifically.</li>
      <li>The calculus shifts sharply by field: engineers have a faster, better-paying government lane through GATE-PSU roles; commerce graduates have a large, high-volume door through bank PO exams; humanities graduates face the toughest odds at UPSC but better real odds through SSC CGL and state PSCs.</li>
      <li><strong>Run the money, attempt, and backup runway test on your specific situation before committing years to a government exam — ambition alone is not a plan.</strong></li>
      <li>Whichever side you pick, a real skill and proof-of-work portfolio built alongside it is what actually unlocks high-income opportunities and earlier financial freedom, not the job label alone.</li>
    </ul>
  </div>

  <p>
    This decision sits inside the wider <a href="/blog/government-jobs/">government jobs</a> conversation
    this site covers — sector comparisons, exam trade-offs, and what to do if an attempt does not work out.
  </p>

  <p>
    If the exam-vs-job decision is tangled up with a bigger career-direction question, a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career
    guidance</a> can help you map your specific runway and field against both paths before you commit years
    to either one.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer on government job vs private job India</h2>

  <p>
    There is no version of this comparison where one side wins outright. Government roles win decisively on
    security, pension structure, and predictable hours. Private roles win decisively on pay growth speed,
    mobility, and how fast a real skill can compound into higher income.
  </p>

  <p>
    What actually decides the right choice for you is not which list is longer — it is whether your specific
    financial runway, field, and risk tolerance line up better with a slow, secure ladder or a faster,
    less certain one.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Most comparisons on this topic pick a side based on family pressure or a single relative's story. The
      real answer sits in the boring middle: both paths have genuine entry costs (a multi-year exam filter
      for government, market competition and performance pressure for private), and your actual field and
      household runway decide which cost you can realistically pay.
    </p>
  </div>

  <h2 id="structure-table">What actually differs, side by side</h2>

  <p>
    Before the salary numbers, it helps to see the structural differences clearly — these are the parts that
    stay true regardless of which specific exam or company you are comparing.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>What differs</th>
          <th>Government job</th>
          <th>Private job</th>
        </tr>
      </thead>
      <tbody>
        {structureRows.map((item) => (
          <tr>
            <td data-label="What differs"><strong>{item.aspect}</strong></td>
            <td data-label="Government job">{item.govt}</td>
            <td data-label="Private job">{item.private}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="pay-reality">Pay reality: 7th CPC vs private salary bands</h2>

  <p>
    Salary comparisons on this topic tend to quote whichever number makes their preferred side look best.
    Here is what the structures actually say.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Stage</th>
          <th>Government pay structure</th>
          <th>Private pay structure</th>
        </tr>
      </thead>
      <tbody>
        {payRows.map((item) => (
          <tr>
            <td data-label="Stage"><strong>{item.stage}</strong></td>
            <td data-label="Government pay structure">{item.govt}</td>
            <td data-label="Private pay structure">{item.private}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Figures are directional, based on the 7th Pay Commission matrix, current Dearness Allowance rates, and
    current private salary and appraisal reporting at the time of writing. Verify current pay-level and
    company-specific figures before making a financial decision.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A government salary looks smaller on a monthly payslip than most people expect from a "secure job."
      What closes the gap is not the base pay — it is the pension structure, the near-zero termination
      risk, and the leave calendar, none of which show up in a simple LPA comparison.
    </p>
  </div>

  <h2 id="security-pace">Job security and daily pace</h2>

  <p>
    Security and pace are the two most misunderstood parts of this comparison, because people usually only
    hear the extreme version of each side.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">Government reality</div>
      <ul>
        <li>Termination requires proven serious misconduct, processed through formal departmental inquiries that commonly take years to resolve.</li>
        <li>Work moves through defined channels and approvals — individual output rarely changes your monthly pay or promotion timeline.</li>
        <li>Public holiday calendars typically run longer than private-sector norms, and leave policy is standardised and generous.</li>
      </ul>
    </div>
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">Private reality</div>
      <ul>
        <li>Security tracks company and sector health — projected overall attrition sits near 16.5% for 2026, with financial services and tech running higher.</li>
        <li>Targets, review cycles, and client or market pressure shape the day far more directly than in a government role.</li>
        <li>Leave and hours vary company to company; strong performers are rewarded fastest, but so is underperformance penalised faster.</li>
      </ul>
    </div>
  </div>

  <p>
    Neither pace is objectively better. A person who finds unstructured, output-driven pressure energising
    will find government pace frustratingly slow. A person who wants predictable hours and low ambiguity
    will find private pace exhausting, regardless of the pay.
  </p>

  <h2 id="pension-benefits">Pension and retirement: NPS vs EPF</h2>

  <p>
    This is one of the most misunderstood parts of the comparison, because the old "guaranteed government
    pension for life" story stopped applying to new entrants years ago.
  </p>

  <p>
    Government employees who joined after January 2004 are on the National Pension System (NPS), a
    market-linked scheme, not the older defined-benefit pension that retired employees still receive.
    Private-sector employees typically build retirement savings through the Employees' Provident Fund (EPF),
    with mandatory 12% contributions from both employee and employer, and government-set guaranteed returns.
    Both government and private employees can also voluntarily add NPS on top of their primary structure.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      The pension gap between government and private jobs is smaller than most families assume for anyone
      who joined government service after 2004. What government still offers reliably is job security and
      a standardised leave structure — not an automatically bigger retirement corpus.
    </p>
  </div>

  <h2 id="prep-years">The prep-years cost nobody puts in the brochure</h2>

  <p>
    The part of "government job vs private job India" that gets the least honest coverage is what it
    actually costs to attempt the harder government exams — not in rupees, but in years.
  </p>

  <div class="mistakes-list">
    {prepFacts.map((item) => (
      <div class="mistake-item">
        <div class="mistake-item__num">{item.label}</div>
        <div class="mistake-item__content">
          <p>{item.fact}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A 0.17% overall success rate for civil services does not mean you personally have a 0.17% chance —
      preparation quality, exam strategy, and attempt count all shift individual odds. But it does mean the
      exam filters out the overwhelming majority of serious, capable people, not just the unprepared ones.
      Treating years of prep as a low-risk plan because "I will study hard enough" ignores what the data
      actually shows about who gets filtered out and why.
    </p>
  </div>

  <h2 id="runway-test">The 3-Runway Test before you commit to prep</h2>

  <p>
    Before you commit a year, let alone several, to a government exam attempt, run yourself honestly through
    The 3-Runway Test — the three practical questions that decide whether a multi-year attempt is a smart
    bet for your specific situation, not just an ambitious one.
  </p>

  <div class="protocol-stack">
    {runwayItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <p>
    If you cannot answer all three honestly in your favour, that does not mean government roles are wrong
    for you — it means you should target the shorter, better-odds exams in your field (GATE, bank PO, SSC
    CGL, state PSC) instead of the longest, lowest-odds one by default.
  </p>

  <h2 id="who-fits-govt">Who genuinely benefits from a government job</h2>

  <div class="feature-grid">
    {govtFitItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="who-fits-private">Who genuinely benefits from a private job</h2>

  <div class="feature-grid">
    {privateFitItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
