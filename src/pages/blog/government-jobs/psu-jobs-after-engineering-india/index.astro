---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'PSU jobs after engineering India: GATE route, PSU-only exams, and the Maharatna gap';
const description =
  'PSU jobs after engineering India run through two doors: GATE-based recruitment and each PSU\'s own written exam. Maharatna vs Navratna vs Miniratna pay, perks, and career ladder compared.';
const canonical =
  'https://futurecareerschool.com/blog/government-jobs/psu-jobs-after-engineering-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'why', label: 'Why "PSU job" is not one decision' },
  { id: 'two-doors', label: 'Two doors into a PSU, not one' },
  { id: 'gate-door', label: 'Door 1: GATE-based PSU recruitment' },
  { id: 'own-exam-door', label: "Door 2: PSUs that run their own exam" },
  { id: 'ratna-tiers', label: 'Maharatna, Navratna, Miniratna: what the label actually changes' },
  { id: 'fit-check', label: 'The 3-Layer PSU Fit Check' },
  { id: 'ladder', label: 'The PSU career ladder, grade by grade' },
  { id: 'pay-perks', label: 'Pay, perks, and the pension myth' },
  { id: 'psu-vs-private', label: 'PSU pace vs private-sector engineering: the honest comparison' },
  { id: 'mistakes', label: 'Mistakes that cost PSU aspirants a year' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const doorCompare = [
  {
    label: 'Door 1: GATE-based recruitment',
    points: [
      'Your GATE score is the first, and often only, screening filter — no separate written test.',
      'One exam, one score, applied to every PSU whose cutoff you clear that recruitment cycle.',
      'Second stage varies by PSU: some stop at the score, others add a group discussion or interview.',
      'Score validity for M.Tech admission runs three years, but each PSU treats its own recruitment window as a separate, time-bound cycle.',
    ],
  },
  {
    label: "Door 2: PSU's own recruitment exam",
    points: [
      'The PSU designs and runs its own written test, usually 70% technical plus 30% reasoning and general aptitude.',
      'No GATE score required at all — this door stays open even if you skipped GATE or scored below PSU cutoffs.',
      'Selection typically adds a group discussion or group task, then a personal interview.',
      'Each PSU sets its own syllabus emphasis, so a SAIL paper and a BPCL paper are not interchangeable prep.',
    ],
  },
];

const gatePsuTiers = [
  {
    tier: 'Maharatna examples',
    names: 'IOCL, ONGC, NTPC, Coal India, BHEL, GAIL, Power Grid, SAIL, BPCL, HPCL',
    note: 'Most of the highest-profile GATE-recruiting names sit in this tier, which is exactly why their cutoffs run steep.',
  },
  {
    tier: 'Navratna examples',
    names: 'NALCO, RVNL, Container Corporation, NMDC, BEL',
    note: 'Still GATE-based in most cycles for engineering roles, with somewhat more reachable vacancy-to-applicant ratios than the top Maharatna names.',
  },
  {
    tier: 'Miniratna and defence-linked examples',
    names: 'BEML, defence R&D bodies like DRDO and BARC, several state-level and category II Miniratna companies',
    note: 'Recruitment mode varies more here — some use GATE, some run their own written exam, so check the specific notification rather than assuming a pattern.',
  },
];

const ownExamPsus = [
  'SAIL runs its own Management Trainee (Technical) exam across Chemical, Civil, Computer Science, Electrical, Instrumentation, Mechanical, and Metallurgical streams, separate from its GATE-based hiring in other cycles.',
  'BPCL, HAL, Coal India subsidiaries, NMDC, and Airports Authority of India have all run standalone written-exam cycles for Management Trainee or equivalent posts without requiring a GATE score.',
  'Food Corporation of India (FCI), ECIL, and several state power and irrigation corporations recruit engineers entirely through their own exam, with no GATE stage at all.',
  'A single PSU can genuinely use both doors in different years or for different posts, so always read that specific year\'s notification instead of assuming last year\'s recruitment mode still applies.',
];

const ratnaCriteria = [
  {
    tier: 'Maharatna',
    criteria: 'Must already hold Navratna status, plus an average annual turnover above Rs 25,000 crore, average net worth above Rs 15,000 crore, and average net profit above Rs 5,000 crore over the last three years, along with a listing on Indian stock exchanges.',
    power: 'Can approve a single project investment up to roughly Rs 5,000 crore, or 15% of net worth, without seeking central government sign-off.',
    count: '14 companies as of the current list, including recent addition Hindustan Aeronautics Limited.',
  },
  {
    tier: 'Navratna',
    criteria: 'Must first hold Miniratna status and score at least 60 out of 100 on a composite scale covering net worth, net profit, capital employed, manpower cost ratio, and other performance parameters.',
    power: 'Can approve project investment up to roughly Rs 1,000 crore, or 15% of net worth, without central government approval — a real jump in operational autonomy from Miniratna.',
    count: 'Around two dozen companies, spanning mining, transport, shipping, and infrastructure PSUs.',
  },
  {
    tier: 'Miniratna (Category I and II)',
    criteria: 'Must show profitability for three consecutive years. Category I needs a larger profit and net-worth base than Category II.',
    power: 'Category I can approve investment up to Rs 500 crore, or its own net worth, whichever is lower, per project. Category II is capped lower, around Rs 300 crore or 50% of net worth.',
    count: 'The largest group by count, covering most mid-sized and smaller profitable CPSEs.',
  },
];

const fitCheckItems = [
  {
    num: '01',
    title: 'Route fit',
    body: 'Can you realistically clear the branch-wise GATE cutoff for the PSUs you actually want, this cycle, with the study runway you actually have? If not, PSU-own-exam recruitment is not a downgrade — it is a completely separate, GATE-free door into the same sector.',
    note: 'Do not treat "GATE or nothing" as the only PSU decision. Most engineers never check whether their target PSU also runs a standalone exam that year.',
  },
  {
    num: '02',
    title: 'Tier fit',
    body: 'A Maharatna offer looks better on paper — steeper starting CTC, stronger brand recognition, wider perk basket. But a Navratna or Miniratna role can mean faster promotion timelines, a smaller applicant pool per vacancy, and a posting location closer to home. Compare the actual role, not just the label on the company name.',
    note: 'A Miniratna Category I engineering role with a shorter commute and real hands-on scope can outperform a distant Maharatna posting on a pure quality-of-work-life basis.',
  },
  {
    num: '03',
    title: 'Pace fit',
    body: 'PSU promotion runs on a structured grade ladder with fixed eligibility windows, not on how fast you personally ship results. If you want compressed, results-linked salary growth in your twenties, a PSU career will feel slow by design, whatever the job security looks like on paper.',
    note: 'This is not a flaw to fix. It is a genuinely different growth shape from a private-sector engineering role, and you need to want that shape, not just tolerate it. Whichever pace you pick, keep building a wider, high-income skill portfolio on the side — it is what actually unlocks earlier financial freedom, on top of whatever the grade ladder pays you.',
  },
];

const ladderRows = [
  { grade: 'E1 — Executive/Management Trainee', detail: 'Entry grade for fresh GATE or exam-recruited engineers. One to two years of structured training and probation before confirmation.' },
  { grade: 'E2-E3 — Assistant Manager / Deputy Manager', detail: 'First independent execution responsibility. Promotion from E1 typically follows a minimum service period plus a clean annual performance appraisal.' },
  { grade: 'E4-E5 — Manager / Senior Manager', detail: 'Usually reached eight to twelve years in, depending on the specific PSU\'s promotion policy and vacancy availability at that grade.' },
  { grade: 'E6-E7 — Deputy General Manager / General Manager', detail: 'Mid-to-senior leadership. Competition for these slots is real; not every E5 engineer reaches E7 on the same timeline.' },
  { grade: 'E8-E9 — Executive Director / Director (Board level)', detail: 'Functional director roles are filled through the Public Enterprises Selection Board (PESB), a separate central selection process layered on top of internal seniority, not a pure internal promotion.' },
  { grade: 'CMD (Chairman and Managing Director)', detail: 'Also a PESB-selected board position. Reaching E7-E8 does not automatically lead here — it depends on a fresh, competitive selection process even for internal candidates.' },
];

const pensionFacts = [
  'Most PSUs moved away from a defined-benefit government-style pension decades ago. What you actually get is a Contributory Provident Fund (CPF) or National Pension System (NPS) account, plus statutory gratuity — not the same guaranteed monthly pension a pre-2004 central government employee received.',
  'Dearness Allowance in most PSUs runs on the Industrial DA (IDA) pattern, revised periodically, layered on top of a basic pay that sits within a defined pay scale for each grade.',
  'House Rent Allowance is tiered by city classification, commonly around 24-30% of basic in metro postings and lower in smaller towns, alongside company-provided or subsidised housing at many plant and township locations.',
  'Medical coverage typically extends to the employee, spouse, and dependent parents at PSU-empanelled hospitals, plus Leave Travel Concession (LTC) for periodic family travel.',
];

const mistakeItems = [
  {
    num: '01',
    title: 'Assuming every PSU recruits only through GATE',
    body: 'A meaningful share of PSU vacancies, especially at SAIL, BPCL, Coal India subsidiaries, and several state-level corporations, run through a standalone written exam with no GATE requirement at all. Skipping GATE does not mean skipping PSU recruitment.',
  },
  {
    num: '02',
    title: 'Chasing "Maharatna" as a fixed hierarchy of desirability',
    body: 'Maharatna status reflects turnover, net worth, and profit scale — not whether a specific role, posting, or team fits you better than a Navratna or Miniratna alternative. A steeper brand name does not automatically mean a better daily job.',
  },
  {
    num: '03',
    title: 'Believing PSU employment guarantees the old-style government pension',
    body: 'Most PSU employees today build retirement savings through CPF or NPS plus gratuity, not a defined-benefit pension. Plan your long-term finances around what your specific PSU actually offers, not around what a grandparent\'s government job used to include.',
  },
  {
    num: '04',
    title: 'Ignoring the PESB layer at senior grades',
    body: 'Reaching a senior executive grade inside a PSU does not automatically fast-track you to a board-level director or CMD seat. Those positions run through a separate central selection process, and treating internal seniority as the only ladder rung creates a false sense of a guaranteed ceiling.',
  },
  {
    num: '05',
    title: 'Comparing PSU pace against private-sector pace without naming the trade-off honestly',
    body: 'A PSU career trades faster, results-linked salary jumps for a structured, lower-volatility path with strong job security. Neither is objectively better — but picking a PSU role while still expecting private-sector-speed promotions sets up years of quiet frustration.',
  },
];

const faqItems = [
  {
    q: 'What are the two main ways to get a PSU job after engineering in India?',
    a: 'You can enter through GATE-based recruitment, where a large group of PSUs use your GATE score as the primary screening filter, or through a PSU\'s own standalone recruitment exam, where the company designs and conducts its own written test with no GATE score required at all. Several PSUs, including SAIL, BPCL, and Coal India subsidiaries, have run both modes in different recruitment cycles, so always check the current year\'s notification rather than assuming a fixed pattern.',
  },
  {
    q: 'What is the difference between Maharatna, Navratna, and Miniratna PSUs?',
    a: 'The three categories reflect financial scale and operational autonomy granted by the Department of Public Enterprises, not job quality. Maharatna is the top tier, requiring average annual turnover above Rs 25,000 crore, net worth above Rs 15,000 crore, and net profit above Rs 5,000 crore over three years, with investment autonomy up to roughly Rs 5,000 crore per project. Navratna requires prior Miniratna status and a composite performance score of 60 or higher, with investment autonomy up to roughly Rs 1,000 crore. Miniratna Category I and II are smaller, consistently profitable PSUs with lower investment thresholds.',
  },
  {
    q: 'Does a Maharatna PSU always pay more than a Navratna or Miniratna PSU?',
    a: 'Usually, but not always, and not by as much as the labels suggest. Maharatna engineer-trainee packages are commonly reported in the higher range, with Navratna and Miniratna roles trailing somewhat, but the exact number depends on the specific PSU, your branch, and that year\'s pay revision. A Navratna or Miniratna role can still outperform a Maharatna offer on posting location, promotion speed, or day-to-day work scope.',
  },
  {
    q: 'Do PSU employees get a government pension?',
    a: 'Most PSU employees do not receive the older, defined-benefit government pension. Instead, they build retirement savings through a Contributory Provident Fund (CPF) or the National Pension System (NPS), along with statutory gratuity. Treat PSU retirement benefits as a strong, structured savings vehicle, not the same guaranteed pension a pre-2004 central government employee received.',
  },
  {
    q: 'How long does it take to reach a senior position in a PSU?',
    a: 'A fresh Executive or Management Trainee typically reaches Manager or Senior Manager grade around eight to twelve years in, depending on the specific PSU\'s promotion policy and vacancy availability at each grade. Reaching board-level positions such as Executive Director or CMD requires clearing a separate selection process run by the Public Enterprises Selection Board (PESB), which is not a guaranteed outcome of internal seniority alone.',
  },
  {
    q: 'Is a PSU job more secure than a private-sector engineering job?',
    a: 'Generally yes, because PSUs are government-owned or government-controlled and are far less likely to run sudden layoffs tied to short-term market swings. The trade-off is pace: PSU salary growth follows a structured grade ladder rather than results-linked jumps, so promotion and pay increases typically move slower than a strong private-sector engineering career can move.',
  },
  {
    q: 'Can I apply to a PSU without a GATE score?',
    a: 'Yes, for PSUs that run their own standalone recruitment exam, such as SAIL\'s Management Trainee exam, several Coal India subsidiaries, BPCL in select cycles, and organisations like FCI and ECIL. These recruitment drives use their own written test, typically covering technical subjects plus reasoning and general aptitude, followed by a group discussion or interview, with no GATE requirement at all.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="government-jobs"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>PSU jobs after engineering India run through two separate doors, and most engineers only prepare for one:</strong>
    GATE-based recruitment, where a single exam score screens you into dozens of public sector
    undertakings, and each PSU's own standalone written exam, which needs no GATE score at all but
    demands separate, company-specific preparation. On top of that, the PSU itself sits in one of
    three tiers — Maharatna, Navratna, or Miniratna — that changes real investment power, pay
    scale, and perk depth, not just the name on your offer letter. Get the route and the tier both
    wrong, and you can spend a year preparing for a door that was never fully open to you.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>GATE-based recruitment and a PSU's own written exam are two different, independently viable doors — skipping GATE does not mean skipping PSU jobs.</li>
      <li>Maharatna, Navratna, and Miniratna describe financial scale and autonomy, not the quality of a specific role. Compare posting, work scope, promotion pace, and branch fit.</li>
      <li>PSU growth follows a structured grade ladder, and retirement benefits commonly use CPF or NPS plus gratuity rather than the older guaranteed pension model.</li>
      <li><strong>The real decision is which recruitment door and work environment fit your branch and attempt runway—not simply "GATE or no GATE."</strong></li>
      <li>Keep building engineering proof while preparing. A current project, plant or design skill, software tool, and documented result protect you if recruitment is delayed or the exam does not convert.</li>
    </ul>
  </div>

  <p>
    This guide goes deep on PSU recruitment specifically. For the wider map of every government
    engineering route — including UPSC ESE, SSC JE, railway RRB posts, state PSC, and defence
    entries — read
    <a href="/blog/government-jobs/government-jobs-after-engineering-india/">government jobs after engineering India</a>
    first if you have not narrowed down to PSUs yet. For more government and PSU career guides,
    browse <a href="/blog/government-jobs/">government jobs</a>, or talk through your specific
    branch and PSU shortlist in a
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a> session.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="why">Why "PSU job" is not one decision</h2>

  <p>
    Ask five engineering students what a PSU job means, and you usually get one answer: "GATE score,
    then apply to a few companies, then wait." That picture is incomplete.
  </p>

  <p>
    A Public Sector Undertaking is any company where the central or a state government holds a
    majority stake — the ownership structure, not the industry, is what makes it a PSU. That single
    fact fans out into hundreds of companies across oil and gas, power, mining, defence
    manufacturing, banking-adjacent finance, ports, and heavy engineering, each running its own
    recruitment calendar, its own exam mode, and its own internal grade structure.
  </p>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad advice</p>
    <ul class="callout__list">
      <li>Only GATE gets you into a PSU, so a weak GATE score closes the door completely.</li>
      <li>Maharatna companies are simply "better jobs" than Navratna or Miniratna ones.</li>
      <li>A PSU job comes with the same pension a grandparent's government job had.</li>
      <li>Every PSU promotes engineers the same way, on the same rough timeline.</li>
    </ul>
    <p class="callout__footer">
      None of this survives contact with the actual recruitment notifications, DPE classification
      rules, and PSU HR policies once you look at them directly instead of relying on hallway
      talk.
    </p>
  </div>

  <h2 id="two-doors">Two doors into a PSU, not one</h2>

  <p>
    Before choosing a specific PSU, understand that you are choosing between two structurally
    different recruitment processes.
  </p>

  <div class="comparison-grid">
    {doorCompare.map((item) => (
      <div class="compare-card compare-card--teal">
        <div class="compare-card__label">{item.label}</div>
        <ul>
          {item.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="note-line">
    A single PSU can run either mode, or both, in different years or for different post categories.
    Always confirm the current year's exact recruitment mode on that PSU's own careers page before
    building a prep plan.
  </p>

  <h2 id="gate-door">Door 1: GATE-based PSU recruitment</h2>

  <p>
    Over 70 public sector undertakings across sectors like oil and gas, power, mining, and heavy
    engineering use GATE scores as their primary or first-stage recruitment filter instead of
    running a separate written exam of their own. This is the door most engineering students hear
    about first, and it genuinely is the fastest single-exam path into a strong-paying, stable PSU
    role for branches where GATE is a well-established recruitment channel.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Tier</th>
          <th>Common examples</th>
          <th>Recruitment reality</th>
        </tr>
      </thead>
      <tbody>
        {gatePsuTiers.map((item) => (
          <tr>
            <td data-label="Tier"><strong>{item.tier}</strong></td>
            <td data-label="Common examples">{item.names}</td>
            <td data-label="Recruitment reality">{item.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      GATE is not a low-effort backup exam for PSU entry. Core branches like Mechanical, Electrical,
      and Civil often carry the steepest PSU-shortlist cutoffs precisely because so many engineers
      chase the same handful of Maharatna names. A safe cutoff for a top PSU commonly sits well
      above what clears M.Tech admission alone, so treat PSU-level GATE prep as its own target, not
      an automatic side effect of preparing for a master's degree.
    </p>
  </div>

  <h2 id="own-exam-door">Door 2: PSUs that run their own recruitment exam</h2>

  <p>
    This is the door most engineers never check, and it is a real, viable route into public sector
    engineering roles without a GATE score at all.
  </p>

  <ul class="rich-list">
    {ownExamPsus.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <p>
    The pattern across most standalone PSU exams is similar: a computer-based test weighted roughly
    70% toward branch-specific technical questions and 30% toward reasoning and general aptitude,
    followed by a group discussion or group task for management-trainee-level posts, then a
    personal interview. But the syllabus emphasis, cutoff, and vacancy count are entirely
    PSU-specific, so a SAIL paper and a BPCL paper are not interchangeable preparation.
  </p>

  <p class="note-line">
    Check each target PSU's own recruitment notification and careers page for the current year's
    exact exam pattern, eligible branches, and vacancy count, rather than relying on a summary blog
    from a previous cycle.
  </p>

  <h3>A short prep checklist for whichever door you pick</h3>

  <p>
    Whether you go through GATE or a PSU's own exam, four things matter more than which door you
    picked: knowing the exact syllabus weightage for your branch, solving at least two to three
    previous years' papers of your specific target PSU (not a generic set), tracking each PSU's
    notification and application window on its own careers page, and preparing a short, honest
    answer for the interview question "why a PSU, and why this one" — panels ask this more often
    than aspirants expect, and a vague answer costs marks even when your technical prep is solid.
  </p>

  <h2 id="ratna-tiers">Maharatna, Navratna, Miniratna: what the label actually changes</h2>

  <p>
    Maharatna, Navratna, and Miniratna are not marketing titles. They are formal classifications
    assigned by the Department of Public Enterprises (DPE) based on financial scale, and each tier
    carries a genuinely different level of operational and investment autonomy from the central
    government.
  </p>

  <div class="protocol-stack">
    {ratnaCriteria.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.tier === 'Maharatna' ? '01' : item.tier === 'Navratna' ? '02' : '03'}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.tier}</div>
          <p><strong>Criteria: </strong>{item.criteria}</p>
          <p><strong>Autonomy: </strong>{item.power}</p>
          <div class="checkpoint__note">{item.count}</div>
        </div>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--amber">
    <p>
      Why this matters for you as a candidate, not just as an economics fact: a Maharatna's
      investment autonomy and financial scale usually translate into a wider perk basket, more
      internal project variety, and stronger brand recognition on a resume. But it does not
      automatically mean a better day-to-day job, a shorter commute, or faster individual
      promotion, which is exactly why the tier alone should never be your only filter.
    </p>
  </div>

  <p class="note-line">
    DPE periodically reviews and updates this classification list. Verify a specific PSU's current
    status directly on the DPE website before treating any tier assignment as permanent.
  </p>

  <h2 id="fit-check">The 3-Layer PSU Fit Check</h2>

  <p>
    With two recruitment doors and three ownership tiers in play, narrowing down your actual target
    list needs a structured filter, not gut instinct. Run your shortlist through The 3-Layer PSU
    Fit Check before committing a year of preparation to any single route.
  </p>

  <div class="protocol-stack">
    {fitCheckItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <p>
    If you are still unsure which door or which tier fits your branch and your family's financial
    runway, a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you work through this filter with an actual person, instead of guessing between a
    dozen PSU names alone.
  </p>

  <h2 id="ladder">The PSU career ladder, grade by grade</h2>

  <p>
    Most PSUs run a fairly consistent executive grade structure, commonly labelled E1 through E9,
    even though exact grade names and pay bands differ by company.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Grade</th>
          <th>What it typically means</th>
        </tr>
      </thead>
      <tbody>
        {ladderRows.map((item) => (
          <tr>
            <td data-label="Grade"><strong>{item.grade}</strong></td>
            <td data-label="What it typically means">{item.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A lot of PSU career content stops describing the ladder at "you get promoted every few
      years," which quietly implies the climb to the top is automatic. It is not. Board-level
      Director and CMD positions are filled through the Public Enterprises Selection Board (PESB),
      a separate, competitive central selection process layered on top of internal seniority. A
      strong E7 or E8 track record improves your odds; it does not guarantee the seat.
    </p>
  </div>

  <h2 id="pay-perks">Pay, perks, and the pension myth</h2>

  <p>
    PSU compensation is rarely a single number. It is a structured stack of basic pay, dearness
    allowance, house rent allowance, and a specific set of long-term benefits that differ
    meaningfully from what a pre-liberalisation government job used to include.
  </p>

  <ul class="rich-list">
    {pensionFacts.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <div class="highlight-box highlight-box--teal">
    <p>
      Reported entry-level packages commonly run higher at Maharatna PSUs than at Navratna or
      Miniratna companies, with the gap narrowing as engineers move up the grade ladder and
      allowances make up a larger share of total compensation. Always check the specific PSU's
      current pay-scale notification rather than relying on a generic average, since pay revisions
      and IDA adjustments happen periodically across the sector.
    </p>
  </div>

  <h2 id="psu-vs-private">PSU pace vs private-sector engineering: the honest comparison</h2>

  <p>
    This is the comparison most PSU content skips, and it matters more than the pay figure alone.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">What a PSU role genuinely gives you</div>
      <ul>
        <li>Meaningfully lower layoff risk, since PSU employment is tied to government ownership rather than short-term market swings.</li>
        <li>A predictable, structured promotion ladder with defined eligibility windows at each grade.</li>
        <li>A wider, more stable perk basket: medical coverage for family, housing support, LTC, and CPF/NPS-based retirement savings.</li>
        <li>Deep, hands-on exposure to large-scale infrastructure, energy, or manufacturing systems that few private employers can match.</li>
      </ul>
    </div>
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">What it genuinely costs you</div>
      <ul>
        <li>Salary growth tied to grade eligibility and vacancy availability, not to how fast you personally deliver results.</li>
        <li>Slower exposure to newer tools, stacks, or fast-moving product cycles compared with many private-sector engineering roles.</li>
        <li>Posting locations decided by the organisation, sometimes far from a metro or your home state.</li>
        <li>A hierarchical decision process that can feel slow if you are used to, or want, rapid individual ownership.</li>
      </ul>
    </div>
  </div>

  <p>
    Neither side of this comparison is universally correct. An engineer who values compounding
    income growth and fast personal ownership over the next five to seven years will likely find a
    strong private-sector or product-company role more rewarding. An engineer who values long-term
    stability, structured growth, and large-scale infrastructure exposure will likely find a PSU
    career genuinely satisfying, not just "safe by default."
  </p>

