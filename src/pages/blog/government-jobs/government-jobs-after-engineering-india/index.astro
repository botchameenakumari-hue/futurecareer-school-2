];

const salaryRows = [
  {
    path: 'GATE-PSU engineer (fresher, top PSUs)',
    range: 'Roughly Rs 10-15 LPA CTC',
    note: 'Reported figures vary by PSU, branch, and that year\'s pay revision; always check the specific PSU\'s current pay scale notification.',
  },
  {
    path: 'UPSC ESE officer (entry, Level 10)',
