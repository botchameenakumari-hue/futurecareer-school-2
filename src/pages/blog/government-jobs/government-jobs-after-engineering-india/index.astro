const defenceRoutes = [
  {
    num: '01',
    title: 'Short Service Commission (Technical) — Army, Navy, Air Force',
    body: 'Open to engineering graduates and final-year students in notified streams (Mechanical, Electrical, Electronics, Computer Science, IT, Civil, and more). There is no written exam; selection runs on your engineering marks, an SSB interview, and a medical test. Selected candidates are commissioned as officers after professional military training.',
    note: 'This is a service commitment, not just a job. Think about the uniformed lifestyle honestly before you apply, not only the officer rank and pay.',
