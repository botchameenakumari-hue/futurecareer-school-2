  { id: 'routes-map', label: 'Six real routes, one table' },
  { id: 'gate-psu', label: 'GATE to PSU: the fastest single-exam route' },
  { id: 'ese', label: 'UPSC ESE (IES): the highest ceiling, the hardest odds' },
  { id: 'ssc-je', label: 'SSC JE: no GATE, no interview, faster entry' },
