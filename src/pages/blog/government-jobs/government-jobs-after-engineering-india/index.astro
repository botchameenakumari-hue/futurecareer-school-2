  'Each PSU sets its own cutoff, vacancy count, and second-stage process (some stop at the GATE score, others add a group discussion or interview) for that specific recruitment year, so a single GATE score does not guarantee entry everywhere.',
];

const eseSteps = [
  {
    title: 'Preliminary exam',
    body: 'Two objective papers: General Studies and Engineering Aptitude, plus a branch-specific technical paper. This stage filters the applicant pool down hard before the real fight even begins.',
  },
  {
    title: 'Mains exam',
    body: 'Conventional, descriptive branch-specific papers worth 600 marks. This is where genuine subject depth, not just multiple-choice speed, decides who moves forward.',
  },
  {
    title: 'Personality test (interview)',
    body: 'Worth 200 marks, assessing suitability for a Group A or Group B engineering service. The final merit list combines Mains and interview marks only, not the prelims score.',
  },
];

const eseFunnel = [
  { stage: 'Appear for Prelims', count: 'Roughly 40,000-70,000 candidates in a typical cycle' },
  { stage: 'Qualify for Mains', count: 'Roughly 6,000-10,000 candidates' },
  { stage: 'Reach the interview stage', count: 'Roughly 1,000-1,500 candidates' },
  { stage: 'Finally selected', count: 'Roughly 700-1,200 candidates, depending on that year\'s vacancies' },
];

const railwayCompare = [
  {
    label: 'RRB JE (Junior Engineer)',
    points: [
      'Open to diploma holders and degree engineers alike.',
      'Two-stage CBT plus document verification and medical.',
      'Gross monthly pay commonly reported around Rs 55,000-65,000 once allowances are added.',
