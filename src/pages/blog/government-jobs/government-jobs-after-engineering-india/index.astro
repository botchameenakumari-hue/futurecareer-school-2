const checkpointItems = [
  {
    num: '01',
    title: 'Work style',
    body: 'Do you want a desk-and-design job (GATE-PSU, DRDO, DPSU), a policy-and-field administrative role (ESE), a faster technical post with defined shifts (SSC JE, RRB JE/SSE), or a uniformed, discipline-heavy life (SSC Tech)? Each route asks for a genuinely different daily rhythm.',
