---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Government job vs startup job stability India: what the failure and layoff data actually says';
const description =
  'Government job vs startup job stability India compared on real numbers: startup failure rates, funding-winter layoff data, ESOP payout reality, and a risk-fit test before you choose either.';
const canonical =
  'https://futurecareerschool.com/blog/government-jobs/government-job-vs-startup-job-stability-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'structure-table', label: 'What actually differs, side by side' },
  { id: 'failure-data', label: 'The failure and shutdown numbers' },
  { id: 'layoff-waves', label: 'Layoff waves and the funding-winter cycle' },
  { id: 'esop-reality', label: 'ESOPs: what a payout actually requires' },
  { id: 'what-startup-offers', label: 'What a startup job gives you that a government job cannot' },
  { id: 'risk-fit-check', label: 'The 4-Signal Startup Fit Check' },
  { id: 'who-fits-govt', label: 'Who genuinely benefits from a government job' },
  { id: 'who-fits-startup', label: 'Who genuinely benefits from a startup job' },
  { id: 'by-stage', label: 'How the risk changes by startup stage' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const structureRows = [
  {
    aspect: 'What your job security actually depends on',
    govt: 'Your post and your department. Termination requires proven serious misconduct, processed through a formal inquiry that can take years.',
    startup: 'Your company\'s cash runway. If the startup cannot raise its next round or reach profitability before the money runs out, your role can disappear regardless of your individual performance.',
  },
  {
    aspect: 'How pay grows',
    govt: 'A fixed 3% annual increment on basic pay, reset roughly once a decade through a pay commission.',
    startup: 'Cash CTC negotiated per hire, often below a stable mid-size company for the same skill, offset by an equity grant whose real value depends on the company eventually reaching a liquidity event.',
  },
  {
    aspect: 'What "failure" looks like',
    govt: 'Not applicable in the way it applies to a company — the employer does not go out of business.',
    startup: 'About 90% of Indian startups do not survive past five years, and a large share of the funded ones that do survive still go through at least one layoff round tied to funding cycles.',
  },
  {
    aspect: 'Responsibility and learning curve',
    govt: 'Defined by seniority and department rules; responsibility grows on a fixed, slow timeline regardless of individual capability.',
    startup: 'Often accelerated well beyond your job title in the first 12-18 months, because small teams cannot afford to keep responsibility narrow — the upside is faster skill-building, the downside is less structured mentorship.',
  },
  {
    aspect: 'Culture and process',
    govt: 'Rule-bound and process-driven; decisions move through defined channels regardless of urgency.',
    startup: 'Informal and fast-moving; decisions can change weekly, reporting lines can shift, and the job you were hired for can look different within a year.',
  },
];

const startupFacts = [
  {
    label: 'Survival past 5 years',
    fact: 'A study by the Institute of Business Value and Oxford Economics found roughly 90% of Indian startups fail within their first five years — a success rate near 10%, well below the global average of about 33%. Only about 20% of Indian startups survive past five years, and only around 8% make it past ten.',
  },
  {
    label: 'Why they actually fail',
    fact: 'Misreading market demand accounts for roughly 42% of startup failures in India, followed by a weak founding team (about 23%) and being outpaced by competitors (about 19%). Running out of cash before finding a working model is the mechanism behind most of these — the underlying decision, not the funding, usually fails first.',
  },
  {
    label: 'What this means for a job offer',
    fact: 'A startup job offer is not just a role — it is a bet on whether that specific company\'s model, founding team, and market timing work out inside a five-year window where the base rate of survival is roughly one in five.',
  },
];

const layoffFacts = [
  {
    num: '2022',
    title: 'The funding winter begins',
    body: 'Indian startup funding fell sharply from its 2021 peak as global capital tightened. Deal volume for the year that followed dropped from 5,114 deals in 2022 to 1,444 in 2023 — a roughly 72% fall in the number of companies getting funded at all.',
  },
  {
    num: '2023',
    title: 'The worst year on record',
    body: 'Total startup funding in India fell to a seven-year low, down roughly 60-62% from 2022 depending on the tracker. Late-stage funding — the money that keeps larger, more mature startups running — fell over 73%. More than 17,000 startup employees lost their jobs this year alone as companies cut costs to extend runway.',
  },
  {
    num: '2024',
    title: 'A partial recovery, but layoffs continued',
    body: 'Startups raised over $10 billion between January and November 2024, a 15% increase over the same period in 2023. Layoffs eased to around 9,000 employees for the year — a real improvement, but still a five-figure job-loss count in a single sector.',
  },
  {
    num: '2025',
    title: 'Layoffs down sharply, but not zero',
    body: 'Only seven Indian startups had reported layoffs in the tracked period of 2025, cutting about 1,602 roles combined — sharply down from 3,355 roles cut by 20 companies in the same period the year before. The pattern is improving, but the underlying mechanism has not changed: when a startup\'s funding or revenue plan breaks, headcount is still the fastest lever to pull.',
  },
];

const esopFacts = [
  {
    num: '01',
    title: 'Vesting first — and you have to survive to get there',
    body: 'The standard Indian structure is a 1-year cliff followed by vesting over roughly 4 years, about 25% a year. Under the Companies Act 2013, no ESOP can vest before one year from the grant date. If you leave, or the company lets you go, before your cliff, you get nothing — and layoffs during a funding crunch often hit people well before their equity has meaningfully vested.',
  },
  {
    num: '02',
    title: 'Vesting is not ownership — exercising costs real cash',
    body: 'Vested options only become shares once you exercise them, and exercising means paying the strike price plus a perquisite tax on the gain, in cash, at the moment you exercise — before you have sold anything or seen a rupee of that value. For someone in the 30% tax bracket, that tax bill alone can run into lakhs, which is why many employees simply do not exercise options from a company that has not shown a clear path to a liquidity event.',
  },
  {
    num: '03',
    title: 'Shares are illiquid until there is an actual liquidity event',
    body: 'Even after exercising, shares in an unlisted company cannot be freely traded. Their value is real on paper and worth nothing you can spend until the company goes public, gets acquired, or runs a company-initiated buyback — none of which are guaranteed, or timed to your convenience.',
  },
  {
    num: '04',
    title: 'Buybacks and IPO payouts do happen — but they are the exception, not the baseline',
    body: 'Indian startup employees monetized a record amount through ESOPs via IPOs in a recent year, and some large, well-funded startups have run buybacks worth tens of millions of dollars for vested-option holders. Treat these as proof the mechanism can work at scale for a company that succeeds — not as evidence that your specific ESOP grant, at your specific startup, is likely to pay out on your timeline.',
  },
];

const startupOffersItems = [
  {
    label: 'Real advantage',
    title: 'A faster, wider learning curve',
    body: 'Small teams cannot afford to keep your responsibility narrow. A person hired for one function often ends up doing adjacent work in sales, ops, hiring, or product within the first year — exposure a government post\'s fixed seniority ladder simply does not offer at the same career stage.',
  },
  {
    label: 'Real advantage',
    title: 'Broader ownership earlier',
    body: 'Where a government role assigns responsibility by rulebook and tenure, a startup role often hands you real decision-making authority — a budget, a hire, a launch — years before a comparable government or large-company track would.',
  },
  {
    label: 'Real advantage',
    title: 'Equity upside if the company actually works out',
    body: 'A government pay scale has a known ceiling. A startup that reaches a strong exit or IPO can turn an ESOP grant into a payout no government salary structure is designed to match — the honest caveat is that this only applies to the roughly one-in-five startups that survive long enough for it to matter.',
  },
];

const riskFitItems = [
  {
    num: '01',
    title: 'Personal runway signal',
    body: 'If your startup employer runs out of funding or has a bad quarter, how many months could your household absorb a sudden job search without real financial stress? Government pay removes this question almost entirely. Startup pay does not — even a well-funded startup can freeze hiring or cut a team overnight when its own runway tightens.',
    note: 'This is not about whether the startup looks stable today. It is about whether you personally have a buffer if it stops looking stable six months from now.',
  },
  {
    num: '02',
    title: 'Skill-transfer signal',
    body: 'If this specific startup shut down tomorrow, would the skills, title, and proof of work from your time there make you more hireable elsewhere, or were they too tied to one company\'s internal tools and processes? Roles with visible, portable proof — shipped products, managed budgets, client relationships — survive a shutdown far better than roles defined entirely by one company\'s internal systems.',
    note: 'Ask this before you join, not after the layoff email.',
  },
  {
    num: '03',
    title: 'Equity-literacy signal',
    body: 'Do you actually understand your ESOP grant\'s strike price, vesting schedule, and the tax you would owe to exercise it, or are you treating the number on the offer letter as guaranteed money? People who negotiate cash CTC as if the equity is a bonus, not a certainty, make better decisions than people who priced their lifestyle around an ESOP that has not vested yet.',
    note: 'If you cannot explain your own vesting cliff and exercise cost in one sentence, that is worth fixing before you accept the offer, not after.',
  },
  {
    num: '04',
    title: 'Uncertainty-tolerance signal',
    body: 'Startups change direction, reporting lines, and even your actual job description faster than most people expect. Some people find that energising. Others find it genuinely draining in a way no salary number fixes. Be honest about which one you are — this signal has ended more startup careers early than any funding crunch.',
    note: 'Neither answer is wrong. Picking the wrong environment for your actual temperament is the expensive mistake, not the environment itself.',
  },
];

const govtFitItems = [
  {
    label: 'Genuine fit',
    title: 'You want your income insulated from a single company\'s fate',
    body: 'A government post does not depend on your specific employer\'s funding round, revenue targets, or founder decisions. If that insulation matters more to you than upside, government roles deliver it consistently.',
  },
  {
    label: 'Genuine fit',
    title: 'You want predictable responsibility growth, not accelerated pressure',
    body: 'If you would rather responsibility grow on a known, rule-based timeline than be handed more than your title suggests in year one, a government track matches that preference structurally.',
  },
  {
    label: 'Genuine fit',
    title: 'You cannot currently absorb even a short unplanned job search',
    body: 'If your household has little to no buffer for a sudden gap in income, the near-total job security of a government post is not just a preference — it is the financially safer starting point until you build that buffer some other way.',
  },
];

const startupFitItems = [
  {
    label: 'Genuine fit',
    title: 'You want compounding proof of work, fast',
    body: 'If you would rather leave with a portfolio of shipped, visible outcomes than tenure in a fixed pay matrix, the accelerated scope of a startup role builds that proof faster than most structured environments.',
  },
  {
    label: 'Genuine fit',
    title: 'You have a real financial buffer or low fixed obligations right now',
    body: 'Startup risk is easiest to carry early — before a home loan, before dependents rely on your income alone, or while you have savings that can cover a real job search. The same risk lands very differently on someone with no financial cushion.',
  },
  {
    label: 'Genuine fit',
    title: 'You can evaluate equity like a financial instrument, not a lottery ticket',
    body: 'If you can read a term sheet, ask about strike price and vesting before accepting an offer, and treat ESOP value as a possibility rather than a guarantee, you are positioned to actually benefit from the upside instead of being surprised by the tax bill.',
  },
];

const stageItems = [
  {
    num: '01',
    title: 'Early-stage (seed to Series A): highest risk, highest learning speed',
    body: 'Cash pay is usually the lowest relative to market rate, and the company itself may not survive its next fundraise — early-stage failure is where most of the 90% five-year failure rate concentrates. In exchange, you get the widest scope, the most direct access to founders, and the largest ESOP percentage relative to company size, which only matters if the company eventually succeeds.',
  },
  {
    num: '02',
    title: 'Growth-stage (Series B to D): more stable, but still funding-dependent',
    body: 'Pay moves closer to market rate and the product usually has proven demand, but growth-stage startups are exactly where the biggest layoff waves of 2023-2024 concentrated, because they burn the most cash to hit growth targets and are the most exposed when late-stage funding tightens. Roles here are more structured than early-stage but still tied to the next funding round or a path to profitability.',
  },
  {
    num: '03',
    title: 'Late-stage and pre-IPO: closer to a large company, but not risk-free',
    body: 'Pay, process, and job structure start resembling an established private company, and ESOPs here have a much clearer, nearer-term path to a liquidity event through IPO or acquisition. The trade-off is a lower equity percentage per hire and a culture that has usually lost most of the fast, informal upside that made early-stage startup work distinctive in the first place.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating "startup" as one risk category',
    body: 'An early-stage startup with six months of runway and a late-stage, well-funded startup with a clear path to IPO carry completely different risk profiles, even though both get called "a startup job" in the same sentence.',
  },
  {
    num: '02',
    title: 'Pricing the ESOP grant as if it were guaranteed cash',
    body: 'Accepting a lower cash CTC because the ESOP number on the offer letter "makes up the difference" only works if the company survives to a liquidity event, you survive to your vesting cliff, and you have the cash to exercise when the time comes. Treat the equity as optionality, not income, until proven otherwise.',
  },
  {
    num: '03',
    title: 'Ignoring your own financial runway when judging the company\'s runway',
    body: 'People research a startup\'s last funding round in detail and never run the same math on their own household — how many months of expenses they could cover if that role disappeared tomorrow. Both runways matter; only one of them is usually discussed in the interview.',
  },
  {
    num: '04',
    title: 'Assuming government insulation means government roles are risk-free everywhere',
    body: 'Government job security protects your specific post, not your income growth. A stagnant government track with no skill development is its own kind of long-term risk — just a slower, quieter one than a startup shutdown.',
  },
  {
    num: '05',
    title: 'Deciding based on the last headline you read, not the current data',
    body: 'Startup layoffs peaked in 2023 and have fallen sharply since — 2025\'s numbers are a fraction of 2023\'s. Basing a decision today entirely on a 2023-era layoff story, or entirely on a single ESOP buyback success story, both skip the fuller picture the actual numbers show.',
  },
];

const faqItems = [
  {
    q: 'Government job vs startup job stability India: which is actually safer?',
    a: 'A government job is structurally safer for your individual income, because your post does not depend on your employer\'s funding or revenue. A startup job\'s stability depends entirely on that specific company\'s runway, funding cycle, and market fit — roughly 90% of Indian startups do not survive past five years, and even funded survivors often go through at least one layoff round tied to a funding crunch. If income insulation is your top priority, government roles deliver it more consistently than any individual startup can promise.',
  },
  {
    q: 'Are ESOPs at an Indian startup actually worth the lower cash salary?',
    a: 'It depends on the company\'s stage and your own financial buffer. ESOPs only pay out after you survive the 1-year cliff, the company reaches a liquidity event (IPO, acquisition, or buyback), and you have the cash to exercise your vested options and cover the tax on them. Late-stage, pre-IPO startups with a visible path to a liquidity event make the equity bet more reasonable than an early-stage startup with an unproven model. Treat any ESOP number as a possibility, not guaranteed income, when comparing offers.',
  },
  {
    q: 'How many Indian startups actually fail, and when?',
    a: 'A study by the Institute of Business Value and Oxford Economics found roughly 90% of Indian startups fail within their first five years, a success rate near 10% against a global average closer to 33%. Only about 20% survive past five years and around 8% past ten. Misreading market demand accounts for the largest share of failures, followed by weak founding teams and being outpaced by competitors.',
  },
  {
    q: 'What was the Indian startup funding winter, and is it over?',
    a: 'Starting around 2022, Indian startup funding fell sharply from 2021\'s peak, bottoming out in 2023 at a seven-year low with a roughly 60-62% drop from 2022 and deal volume down about 72%. More than 35,000 startup jobs were cut between the start of the funding winter and the recovery. Funding partially recovered in 2024, with over $10 billion raised between January and November, a 15% rise over the same period the year before, and layoffs have continued to ease through 2025 — but the underlying dependency on funding cycles has not gone away.',
  },
  {
    q: 'Is a startup job a good idea for a fresher, or only for experienced professionals?',
    a: 'Freshers with low fixed financial obligations and a genuine appetite for a fast, unstructured learning curve are often better positioned to absorb startup risk than someone with a home loan or dependents relying solely on their income. The trade-off is less structured mentorship than a large company\'s formal fresher program offers, so freshers considering a startup role should weigh whether they will get real skill development, not just long hours, from the specific team they are joining.',
  },
  {
    q: 'How can someone reduce the risk of taking a startup job without giving up the upside?',
    a: 'Check the company\'s funding stage and how many months of runway it likely has left, ask directly about the ESOP strike price and vesting schedule before accepting, keep a personal financial buffer sized to your own risk tolerance rather than the company\'s stated stability, and prioritise roles that build visible, portable proof of work over roles defined only by internal company tools. None of this removes the risk, but it keeps the decision informed instead of based on hope.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="government-jobs"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Government job vs startup job stability India is not a question of which side is "safer" in
    general — it is a question of whether your income should depend on a fixed post or on one specific
    company's funding runway.</strong> A startup job carries a genuinely different kind of risk than a job at
    an established private company: roughly 90% of Indian startups do not survive past five years, funding
    winters have cost the ecosystem more than 35,000 jobs since 2022, and even a real ESOP grant only pays out
    if you survive the vesting cliff, the company reaches a liquidity event, and you can afford the exercise
    tax. Here is what the actual data says, and how to weigh it against your own situation.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>A government post's security does not depend on your employer's business performance. A startup job's security depends almost entirely on that specific company's funding runway and revenue path — roughly 90% of Indian startups fail within five years.</li>
      <li>Startup layoffs are cyclical, not random: more than 35,000 jobs were cut in the funding winter that began in 2022, peaking at 17,000+ in 2023 alone, before easing to under 2,000 in the tracked part of 2025.</li>
      <li>An ESOP grant is optionality, not income. It requires surviving a 1-year cliff, the company reaching a liquidity event, and you having the cash to cover the exercise tax — most grants never clear all three steps.</li>
      <li>What a startup job genuinely offers that a government post structurally cannot is an accelerated learning curve, broader responsibility earlier, and real equity upside if the specific company works out.</li>
      <li>Whichever path you pick, the fastest way to cut your personal risk is building a genuine, high-income skill portfolio — portable proof of work that keeps you employable even if one specific employer's fate changes.</li>
      <li><strong>Run The 4-Signal Startup Fit Check below on your own runway, skills, equity literacy, and uncertainty tolerance before comparing offers on salary alone.</strong></li>
    </ul>
  </div>

  <p>
    This sits inside the wider <a href="/blog/government-jobs/">government jobs</a> conversation this site
    covers — sector comparisons, exam trade-offs, and honest reality checks before you commit years to one
    path. If you are comparing a government post against a stable, established private company rather than a
    startup specifically, the trade-offs are different — see
    <a href="/blog/government-jobs/govt-vs-private-job-india/">government job vs private job India</a> for
    that comparison.
  </p>

  <p>
    If this decision is tangled up with a bigger direction question — which field, which company stage, how
    much risk your specific household can carry — a session inside
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career
    guidance</a> can help you map it against your actual finances and skills before you sign an offer letter.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer on government job vs startup job stability India</h2>

  <p>
    A government job's stability is structural — it is built into how the post itself works, independent of
    how well any single office or department performs. A startup job's stability is conditional — it depends
    on whether that specific company keeps raising money or turns profitable before it runs out of cash.
  </p>

  <p>
    That difference is bigger than the gap between government and an established private company, because a
    large stable company's failure risk is usually low and slow-moving, while a startup's failure risk is
    genuinely high and can move fast — a funding round falling through can end a role within weeks, not years.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Most "government vs startup" conversations either romanticise startup upside or dismiss it entirely as
      reckless. Neither is accurate. The honest picture is that startup risk is real, measurable, and
      concentrated in specific, knowable places — funding stage, personal runway, and equity structure — not
      some vague, unknowable gamble.
    </p>
  </div>

  <h2 id="structure-table">What actually differs, side by side</h2>

  <p>
    Before the failure and layoff numbers, it helps to see the structural differences clearly — the parts
    that stay true regardless of which specific startup or government post you are weighing.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>What differs</th>
          <th>Government job</th>
          <th>Startup job</th>
        </tr>
      </thead>
      <tbody>
        {structureRows.map((item) => (
          <tr>
            <td data-label="What differs"><strong>{item.aspect}</strong></td>
            <td data-label="Government job">{item.govt}</td>
            <td data-label="Startup job">{item.startup}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="failure-data">The failure and shutdown numbers</h2>

  <p>
    "Startups are risky" gets said so often it stops meaning anything. Here is what the actual research says
    about how risky, and why.
  </p>

  <div class="mistakes-list">
    {startupFacts.map((item) => (
      <div class="mistake-item">
        <div class="mistake-item__num">{item.label}</div>
        <div class="mistake-item__content">
          <p>{item.fact}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A 90% five-year failure rate does not mean every startup job ends badly within five years — plenty of
      people move on to a second or third startup, or into an established company, well before their employer
      shuts down. It means the company you join is playing genuinely long odds, and your career plan should
      not assume it beats those odds by default.
    </p>
  </div>

  <h2 id="layoff-waves">Layoff waves and the funding-winter cycle</h2>

  <p>
    Startup job losses in India are not random — they track a specific, recurring cycle: funding tightens,
    companies extend runway by cutting headcount, funding eases, hiring picks back up, and the cycle repeats
    on the next downturn. Here is how that played out over the last few years.
  </p>

  <div class="protocol-stack">
    {layoffFacts.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <p class="note-line">
    Figures are directional, drawn from startup-layoff tracking and funding reports current at the time of
    writing. Different trackers use slightly different methodologies, so treat exact figures as approximate
    and verify current-year numbers before making a decision based on them.
  </p>

  <h2 id="esop-reality">ESOPs: what a payout actually requires</h2>

  <p>
    Equity is the part of a startup offer that gets talked about the most and understood the least. An ESOP
    grant is not deferred salary — it is a chain of conditions, and the payout only happens if every link in
    that chain holds.
  </p>

  <div class="protocol-stack">
    {esopFacts.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p>
      Ask three questions before you accept any offer with an ESOP component: what is my strike price, what
      would exercising cost me in tax at today's valuation, and has this company — or a comparable one at its
      stage — actually returned cash to employees before. If you cannot get a straight answer to all three,
      price the equity at zero when comparing the offer to a government or established-company alternative.
    </p>
  </div>

  <h2 id="what-startup-offers">What a startup job gives you that a government job cannot</h2>

  <p>
    None of this is an argument against startup jobs — it is an argument for weighing the real upside against
    the real risk instead of either one alone.
  </p>

  <div class="feature-grid">
    {startupOffersItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="risk-fit-check">The 4-Signal Startup Fit Check</h2>

  <p>
    Before you accept a startup offer over a government or stable-company one, run yourself honestly through
