  { service: 'Indian Defence Accounts Service (IDAS)', role: 'Audits and manages accounts for defence expenditure across the armed forces.' },
  { service: 'Indian Defence Estates Service (IDES)', role: 'Manages defence land, cantonments, and military estates.' },
  { service: 'Indian Ordnance Factories Service (IOFS)', role: 'Manages production and quality at India\'s ordnance factories.' },
  { service: 'Indian Postal Service (IPoS)', role: 'Runs India Post operations, from mail delivery to postal banking.' },
  { service: 'Indian Railway Traffic Service (IRTS)', role: 'Manages railway operations, traffic planning, and commercial policy.' },
  { service: 'Indian Trade Service (ITS)', role: 'Works on trade policy and export promotion, often under the Directorate General of Foreign Trade.' },
];

const laterCareerCards = [
  {
    label: 'Central deputation',
    title: 'Move into a central ministry, CBI, IB, or NIA',
    body: 'Both IAS and IPS officers regularly go on deputation to Delhi-based ministries or central agencies. For IPS officers, deputation to the CBI, Intelligence Bureau, or specialised central forces is common and often strengthens a case for later promotion.',
  },
  {
    label: 'International organisations',
    title: 'World Bank, IMF, ADB, AIIB, or UN agencies',
    body: 'Officers can be deputed to bodies like the World Bank, International Monetary Fund, Asian Development Bank, or United Nations agencies, usually after around 9 years of service, sometimes earlier in exceptional cases. Five or more years of UN deputation can carry a lifelong tax-free UN pension on top of Indian service benefits.',
  },
  {
    label: 'Post-retirement: corporate and consulting',
    title: 'Boards, advisory roles, and consulting firms',
    body: 'Retired officers commonly join corporate boards, government-relations teams, or consulting firms such as the large advisory networks, where policy fluency and regulatory experience are valued even without deep technical specialisation.',
