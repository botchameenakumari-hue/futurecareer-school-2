const ipsRows = [
  { rank: 'Assistant Superintendent of Police (ASP)', years: '0-2 years, on probation', note: 'District posting under a Superintendent, hands-on training in field policing and investigation.' },
  { rank: 'Superintendent of Police (SP)', years: '6-9 years', note: 'Runs a full district police force, the first major independent command.' },
  { rank: 'Deputy Inspector General (DIG)', years: '12-16 years', note: 'Links state headquarters to district forces, advises SPs on complex investigations, oversees specialised units.' },
  { rank: 'Inspector General (IG)', years: 'Around 18 years', note: 'Commands a zone made up of several ranges, or heads a specialised department.' },
  { rank: 'Additional Director General (ADG)', years: '25+ years', note: 'State-level command of a specialised wing such as crime branch, intelligence, or training.' },
  { rank: 'Director General of Police (DGP)', years: '30+ years', note: 'Heads a state\'s entire police force. Only one per state, decided by seniority, empanelment, and government selection, not automatic promotion.' },
