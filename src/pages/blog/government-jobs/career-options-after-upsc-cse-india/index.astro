const ifsSteps = [
  { num: '01', title: 'Third Secretary (roughly 2-4 years)', body: 'Your first foreign posting after training at the Foreign Service Institute and mandatory language training. A junior desk inside an embassy or high commission.' },
  { num: '02', title: 'Second Secretary (roughly 5-8 years)', body: 'Consulate or embassy work covering consular services and political or economic reporting back to Delhi.' },
  { num: '03', title: 'Under Secretary, MEA headquarters (roughly 9-12 years)', body: 'A home posting in Delhi at the Ministry of External Affairs, PMO, or a passport office, before rotating abroad again.' },
  { num: '04', title: 'First Secretary (roughly 13-15 years)', body: 'You run a functional wing inside a mission, such as the political, economic, or commercial desk.' },
  { num: '05', title: 'Counsellor (roughly 16-20 years)', body: 'Senior mission leadership, often acting as deputy head of mission at larger embassies.' },
  { num: '06', title: 'Ambassador, High Commissioner, or Permanent Representative (21+ years)', body: 'Most IFS officers become a head of mission somewhere between 24 and 30 years of service. Major postings like Washington, London, or Beijing go to the most senior officers; smaller missions come earlier.' },
];

const irsRows = [
  { grade: 'Assistant Commissioner', note: 'Entry grade after training, first independent charge of tax assessment or enforcement work.' },
  { grade: 'Deputy Commissioner', note: 'Wider jurisdiction, more complex cases, first real management responsibility.' },
  { grade: 'Joint Commissioner', note: 'Oversees multiple assessment units or a specialised investigation wing.' },
  { grade: 'Additional Commissioner', note: 'Senior regional charge, appellate and policy-implementation work.' },
  { grade: 'Commissioner', note: 'Heads a full commissionerate; a major administrative and revenue-target milestone.' },
