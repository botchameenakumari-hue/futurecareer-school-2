---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career options after UPSC CSE India: the real map once you clear it';
const description =
  'Career options after UPSC CSE India span IAS, IPS, IFS, IRS, and other Group A services. See how rank and DAF preference decide your service, cadre, and career trajectory.';
const canonical =
  'https://futurecareerschool.com/blog/government-jobs/career-options-after-upsc-cse-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'allocation', label: 'How service allocation actually works' },
  { id: 'rank-reality', label: 'What your rank realistically gets you' },
  { id: 'cadre', label: 'Cadre allocation: which state you serve in' },
  { id: 'ias-path', label: 'Career trajectory inside the IAS' },
  { id: 'ips-path', label: 'Career trajectory inside the IPS' },
  { id: 'ifs-path', label: 'Career trajectory inside the IFS' },
  { id: 'irs-path', label: 'IRS and the other Group A central services' },
  { id: 'group-b', label: 'Group B services and the state route' },
  { id: 'later-career', label: 'Deputation, global bodies, and later-career moves' },
  { id: 'mistakes', label: 'Mistakes to avoid when you fill your DAF' },
  { id: 'faq', label: 'FAQs' },
];

const vacancyRows = [
  { item: 'IAS (Indian Administrative Service)', figure: '180 posts' },
  { item: 'IPS (Indian Police Service)', figure: '150 posts' },
  { item: 'IFS (Indian Foreign Service)', figure: '55 posts' },
  { item: 'Central Services, Group A (IRS and others combined)', figure: '507 posts' },
  { item: 'Central Services, Group B', figure: '195 posts' },
];

const rankRows = [
  { service: 'IAS', rank: 'Roughly rank 78', note: 'General category, CSE 2025 cycle. Moves up or down each year with vacancies and category-wise reservation.' },
  { service: 'IFS', rank: 'Roughly rank 115', note: 'Closes after IAS in almost every cycle, since most toppers list IAS first on the DAF.' },
