---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Government exam preparation while working in India: the realistic plan';
const description =
  'Government exam preparation while working India: real weekly study-hour math, when to quit vs stay, leave strategy, notice-period timing, and honest odds vs full-time prep.';
const canonical =
  'https://futurecareerschool.com/blog/government-jobs/government-exam-preparation-while-working-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'quit-or-not', label: 'Should you quit your job first?' },
  { id: 'hours', label: 'Realistic study hours while working' },
  { id: 'weekly-blueprint', label: 'A weekly structure that survives a real job' },
  { id: 'leave-strategy', label: 'Using leave strategically' },
  { id: 'notice-period', label: 'Notice period and job timing around your exam' },
  { id: 'burnout', label: 'Avoiding burnout before it forces the decision for you' },
  { id: 'odds', label: 'Honest odds: working vs full-time prep' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const quitStay = {
  stay: [
    'This is your first serious attempt and you have not yet tested how much focused time you can actually protect.',
    'Your job genuinely allows 3-5 quality hours most weekdays, even if it takes negotiation to get there.',
    'Your household depends on this income, or a job gap would be hard to explain to future employers if the exam does not work out.',
    'You have not yet built a real routine — quitting before proving you can study consistently just removes the income cushion without fixing the discipline problem.',
  ],
  quit: [
    'You have already attempted at least once while working and know exactly where the extra hours would go.',
    'You have 18-24 months of expenses saved, separate from any exam or coaching cost.',
    'Your role is genuinely unpredictable — long hours, frequent travel, or on-call demands that make even 2 protected hours a day unrealistic most weeks.',
    'You are within striking distance on a specific, measurable gap (one paper, one stage, one skill), not starting the syllabus from zero.',
  ],
};

const hourRows = [
  {
    exam: 'SSC CGL / CHSL',
    weekday: '1.5-2.5 focused hours',
    weekend: '5-7 hours across both days',
    weeklyTotal: 'Roughly 15-20 hours',
  },
  {
    exam: 'IBPS / SBI PO or Clerk',
    weekday: '2-3 focused hours',
    weekend: '6-8 hours across both days',
    weeklyTotal: 'Roughly 18-23 hours',
  },
  {
    exam: 'State PSC',
    weekday: '2-3 focused hours',
    weekend: '6-9 hours across both days',
    weeklyTotal: 'Roughly 20-24 hours',
  },
  {
    exam: 'UPSC Civil Services',
    weekday: '3-4 focused hours',
    weekend: '8-10 hours across both days',
    weeklyTotal: 'Roughly 30-35 hours',
  },
];

const blueprintSteps = [
  {
    num: '01',
    title: 'Protect one deep-work block before work, not after it',
    body: 'Morning hours before your job starts are the only slot your employer cannot quietly eat into with a late meeting or an urgent ask. Even 60-90 minutes of full-attention study here, done daily, compounds faster than 3 tired hours squeezed in after 9pm.',
  },
  {
    num: '02',
    title: 'Use commute and micro-windows for review, not new learning',
    body: 'Audio revision, flashcards, and re-reading condensed notes work well in transit or short breaks. Save fresh, difficult material — a new topic, a mock test, a mains answer — for a block where you can actually concentrate.',
  },
  {
    num: '03',
    title: 'Load 60-70% of your weekly hours into the weekend',
    body: 'This is where working aspirants realistically catch up on volume: full-length mock tests, answer writing, revision of the week\'s topics, and anything that needs an uninterrupted 3-4 hour stretch.',
  },
  {
    num: '04',
    title: 'Build in one buffer day every couple of weeks',
    body: 'Work throws unpredictable weeks at everyone — a deadline, a late shift, a family event. A study plan with zero slack breaks the first time real life interferes, and then guilt about the missed day costs you more time than the day itself would have.',
  },
];

const leaveCards = [
  {
    label: 'Earned or privilege leave',
    title: 'The lever most working aspirants underuse',
    body: 'Most private-sector roles accrue earned leave monthly. Instead of taking single days off reactively, block 4-5 concentrated leave stretches a year around your actual weak points — a mock-test cycle, a mains answer-writing sprint, or the final fortnight before a prelims date.',
  },
  {
    label: 'Sabbatical or unpaid leave',
    title: 'Useful only with a specific, time-bound purpose',
    body: 'There is no legal entitlement to a sabbatical in India — it depends entirely on your employer\'s policy. Ask for it framed around a fixed window tied to a real exam stage, not an open-ended "I need time to study," which is far easier for an employer to decline.',
  },
  {
    label: 'Government or PSU study leave',
    title: 'A real, structured option if you already work in the public sector',
    body: 'Several state and central government service rules include formal study-leave provisions for employees preparing for departmental or competitive exams. If you already hold a government or PSU role, check your specific service rules before assuming this route does not exist for you.',
  },
  {
    label: 'Work-from-home or reduced-hours negotiation',
    title: 'Often easier to get than full leave, and just as valuable',
    body: 'A temporary shift to remote work or slightly reduced hours can hand back 5-8 hours a week without any income loss and without the harder conversation a full leave request usually triggers.',
  },
];

const noticeRows = [
  {
    scenario: 'You plan to resign only after clearing the exam',
    consideration: 'Keep your current notice period visible on your calendar against your exam\'s typical result and joining timeline. A 60-90 day notice period can genuinely delay your joining date if you resign only after results are out — many services expect joining within a fixed window.',
  },
  {
    scenario: 'You are considering resigning before results, to focus on a final stage',
    consideration: 'Do this only if the runway math already works (see the quit-or-stay section above). Resigning on hope, without savings or a fallback plan, is the single most common regret pattern working aspirants describe after a cycle that does not go their way.',
  },
  {
    scenario: 'Your current employer has a probation or bond clause',
    consideration: 'Some private-sector offers, and almost all PSU or bank training programmes, include a minimum service bond with a buyback clause. Read this before you assume you can exit cleanly the moment a government result arrives.',
  },
  {
    scenario: 'You are already a government or PSU employee applying for a different service',
    consideration: 'Check your current service\'s rules on permission to apply for another government post while employed — several services require a No Objection Certificate before you can even sit certain competitive exams.',
  },
];

const burnoutSigns = [
  {
    title: 'You are studying more hours but retaining less',
    body: 'This is the clearest early signal. When revision stops sticking, the fix is rest and consolidation, not another extra hour bolted onto an already packed day.',
  },
  {
    title: 'Your job performance starts visibly slipping',
    body: 'A missed deadline or a sloppy review is a warning, not just an inconvenience. If your income and reference depend on this job, protect it deliberately rather than letting exam prep quietly cannibalise it.',
  },
  {
    title: 'You have stopped taking any full day off in weeks',
    body: 'Sustainable preparation needs at least a half-day of genuine rest most weeks. Aspirants who treat every single day as a study day usually burn out mid-cycle, not near the finish line.',
  },
  {
    title: 'Sleep is the first thing being cut',
    body: 'Cutting sleep to add study hours is a false trade. Retention, focus, and mock-test performance all fall sharply on chronic short sleep — the extra hour rarely pays for itself.',
  },
];

const oddsRows = [
  {
    metric: 'UPSC Civil Services — recent cycle selection ratio',
    figure: 'Roughly 1,000 selections from over 5.7 lakh candidates who appeared — close to 0.1-0.17% overall.',
  },
  {
    metric: 'Typical UPSC timeline, full-time preparation',
    figure: 'Around 1.5 years to a first serious attempt for most full-time aspirants who start from a reasonable base.',
  },
  {
    metric: 'Typical UPSC timeline, while working',
    figure: 'Commonly 2-3 years, because weekly study volume runs lower and more of it happens on weekends.',
  },
  {
    metric: 'SSC CGL / IBPS PO, while working',
    figure: 'A focused working aspirant can realistically prepare in 6-12 months, since the syllabus and stages are shorter than UPSC.',
  },
  {
    metric: 'Share of successful UPSC candidates who cleared on their first attempt',
    figure: 'A small minority — most successful candidates needed multiple attempts, commonly 3-4 or more.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Copying a full-time aspirant\'s study plan wholesale',
    body: 'A timetable built for someone with 10 open hours a day will not survive contact with a job. Build your plan around your actual protected hours, not an aspirational number from a topper interview.',
  },
  {
    num: '02',
    title: 'Treating every weekday as a study day and burning out by month two',
    body: 'A plan with zero recovery time looks impressive on paper and collapses the first time work runs late or you get sick. Build the buffer in from week one.',
  },
  {
    num: '03',
    title: 'Quitting before testing your actual study capacity',
    body: 'If you have never tracked how many focused hours you genuinely manage in a working week, you do not yet have the data to decide whether quitting would even help.',
  },
  {
    num: '04',
    title: 'Ignoring the notice-period and bond-clause math until an offer is already on the table',
    body: 'Check your current contract terms early. Finding out about a service bond or a 90-day notice period after a result is a solvable problem that becomes a stressful one if you leave it too late.',
  },
  {
    num: '05',
    title: 'Studying in isolation with no way to check your answer quality',
    body: 'Working aspirants especially need a way to get mains answers, essays, or interview practice reviewed by someone else — a peer group, a mentor, or a structured programme — because self-review alone tends to miss the gaps that actually cost marks.',
  },
];

const faqItems = [
  {
    q: 'How many hours should I study daily while working for a government exam?',
    a: 'Most working aspirants realistically manage 1.5-4 focused hours on weekdays depending on the exam, plus 5-10 hours across the weekend. SSC and bank exams need less weekly volume than UPSC, which commonly needs 30-35 hours a week from a working aspirant.',
  },
  {
    q: 'Should I quit my job to prepare for a government exam full-time?',
    a: 'Only if you already have 18-24 months of expenses saved separately, have attempted at least once while working, and your current role genuinely leaves no room for a protected study block. If this is your first attempt or your finances are unclear, stay employed and test your real study capacity first.',
  },
  {
    q: 'How do I use leave strategically for government exam preparation?',
    a: 'Block 4-5 concentrated leave stretches a year around your actual weak points, such as a mock-test cycle or the final fortnight before your target exam date, rather than taking scattered single days off. Check whether your employer offers formal study leave, sabbatical, or work-from-home options before assuming full resignation is the only route.',
  },
  {
    q: 'Will resigning before results hurt my current job security?',
    a: 'It can, especially if your offer or current role includes a notice period or service bond. Review your contract terms and your realistic notice period against your exam\'s typical result-to-joining timeline before deciding when to resign.',
  },
  {
    q: 'Is it realistic to clear UPSC while working full-time?',
    a: 'Yes, a meaningful number of successful candidates each cycle are working professionals, but the timeline is usually longer — commonly 2-3 years compared to around 1.5 years for a full-time aspirant with a comparable starting base.',
  },
  {
    q: 'How do I avoid burnout while preparing for a government exam and working?',
    a: 'Watch for falling retention despite more study hours, slipping job performance, zero rest days, and cut sleep. Build a buffer day into your plan every couple of weeks and protect at least a half-day of genuine rest most weeks rather than treating every day as a study day.',
  },
  {
    q: 'Which government exams are more realistic to prepare for while working, compared to UPSC?',
    a: 'SSC CGL, SSC CHSL, IBPS PO, IBPS Clerk, and most state PSC exams have shorter syllabi and fewer stages than UPSC Civil Services, which makes them more realistic to prepare for in 6-12 months alongside a full-time job.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="government-jobs"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Government exam preparation while working in India is realistic, but only if you plan around your actual protected hours instead of copying a full-time aspirant's timetable.</strong>
    A working professional typically manages 15-35 focused study hours a week depending on the exam, needs a longer overall timeline than a full-time candidate, and has to make deliberate calls on leave, notice period, and burnout that a student or full-time aspirant never has to think about.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Most working aspirants realistically get 15-35 focused hours a week, not the 8-10 hours a day full-time aspirants describe in topper interviews.</li>
      <li>Quitting only makes sense with 18-24 months of savings, at least one prior attempt, and a genuinely unpredictable job that blocks even 2 protected hours a day.</li>
      <li>Leave works best when it is concentrated around specific weak points — a mock-test cycle, an answer-writing sprint — not scattered as single reactive days off.</li>
      <li>UPSC while working commonly takes 2-3 years versus roughly 1.5 years full-time; SSC and bank exams are realistic in 6-12 months alongside a job.</li>
      <li>Whether or not this specific attempt succeeds, the discipline, planning, and skill you build while preparing is portable — it strengthens your case for other high-income opportunities too, not just this one exam.</li>
      <li><strong>Track your real weekly study hours for a few weeks before deciding whether to quit — most aspirants decide with a guess, not with data.</strong></li>
      <li>Keeping the job protects more than salary: it preserves recent work proof, professional learning, and a fallback if highly competitive exam odds do not convert. Quit only when the evidence is unusually strong.</li>
    </ul>
  </div>

  <p>
    For the wider set of decisions inside this track — which exam to target, government versus private trade-offs, and what happens after an attempt does not work out — start with <a href="/blog/government-jobs/">Government Jobs</a>.
  </p>

  <p>
    If the pressure of this decision is affecting your job performance, your relationships, or your confidence in the plan itself, <a href="/services/career-counselling-and-career-guidance/">structured career guidance</a> can help you build a realistic runway and timeline around your specific job, savings, and exam target.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="quit-or-not">Should you quit your job to prepare full-time?</h2>

  <p>
    This is the question most working aspirants ask before they have the data to answer it. The honest version of the answer depends on your attempt history, your savings, and how much your specific job actually blocks study time — not on what worked for someone else.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">Stay employed if</div>
      <ul>
        {quitStay.stay.map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">Consider quitting if</div>
      <ul>
        {quitStay.quit.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A job is not just income during preparation. It is also your fallback if the exam does not work out on your first, second, or third attempt.
    </p>
    <p>
      Quitting removes that fallback at the exact moment you need it most — before you know the result. Treat that trade-off as real, not as a minor inconvenience.
    </p>
  </div>

  <h2 id="hours">Realistic study hours while working</h2>

  <p>
    The most common planning mistake is borrowing a study-hour target from a full-time aspirant's routine. A working aspirant's week is structurally different, and the plan needs to be built for that reality from the start.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Exam track</th>
          <th>Weekday</th>
          <th>Weekend</th>
          <th>Weekly total</th>
        </tr>
      </thead>
      <tbody>
        {hourRows.map((row) => (
          <tr>
            <td data-label="Exam track"><strong>{row.exam}</strong></td>
            <td data-label="Weekday">{row.weekday}</td>
            <td data-label="Weekend">{row.weekend}</td>
            <td data-label="Weekly total">{row.weeklyTotal}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    These are planning ranges based on patterns reported by working aspirants and exam-prep mentors, not a guarantee for any individual. Your actual capacity depends on commute time, job intensity, and how much of your weekend you can genuinely protect.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      Quality matters more than the raw number.
    </p>
    <p>
      A working aspirant who studies 4 fully-focused hours a day is often ahead of a full-time aspirant who logs 10 hours with frequent phone breaks. Protect concentration before you chase volume.
    </p>
  </div>

  <h2 id="weekly-blueprint">A weekly structure that survives a real job</h2>

  <p>
    A study plan only works if it can absorb a bad week without collapsing. Here is a structure that holds up against real job demands, not just an ideal week.
  </p>

  <div class="protocol-stack">
    {blueprintSteps.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <p class="note-line">
    How long you need this structure to run for is genuinely individual — some working aspirants are exam-ready in under a year on a shorter-syllabus exam, others need a couple of years on a longer one like UPSC. Judge by your own mock-test trend, not by someone else's calendar.
  </p>

  <h2 id="leave-strategy">Using leave strategically</h2>

  <p>
    Leave is the single biggest lever a working aspirant has, and also the most commonly wasted one. Scattered single days off rarely move the needle. Concentrated blocks around real weak points do.
  </p>

  <div class="feature-grid">
    {leaveCards.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    Sabbatical policy and formal study-leave provisions vary by employer and, for government or PSU roles, by service rules. Confirm your specific entitlements with your HR team or your service manual before building a plan around them.
  </p>

  <h2 id="notice-period">Notice period and job timing around your exam</h2>

  <p>
    This is the part most guides skip entirely, and it can genuinely cost you a joining window or create an awkward exit if you leave it unplanned.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Scenario</th>
          <th>What to check</th>
        </tr>
      </thead>
      <tbody>
        {noticeRows.map((row) => (
          <tr>
            <td data-label="Scenario"><strong>{row.scenario}</strong></td>
            <td data-label="What to check">{row.consideration}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad advice</p>
    <ul class="callout__list">
      <li>Just resign the day you get the offer letter, sort out the notice period later.</li>
      <li>Notice periods do not matter once you have a government job lined up.</li>
      <li>Bond clauses are rarely enforced, so ignore them.</li>
    </ul>
    <p class="callout__footer">
      None of this accounts for the actual joining-window rules many services set, or the buyback and legal cost some bond clauses genuinely carry. Read your own contract before assuming any of this applies to your situation.
    </p>
  </div>

  <h2 id="burnout">Avoiding burnout before it forces the decision for you</h2>

  <p>
    Burnout does not usually announce itself. It shows up as small performance drops in both your job and your preparation, weeks before it becomes an obvious crisis.
  </p>

  <div class="feature-grid">
    {burnoutSigns.map((item) => (
      <div class="feature-card">
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    If two or more of these signs are already showing up, the fix is not more discipline. It is a genuine rest block, followed by rebuilding your weekly plan around a number of hours you can actually sustain, not the number you wish you could sustain.
  </p>

  <h2 id="odds">Honest odds: working vs full-time prep</h2>

  <p>
    Working aspirants deserve the real numbers, not motivational framing. Here is what the data actually shows.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Figure</th>
        </tr>
      </thead>
      <tbody>
        {oddsRows.map((row) => (
          <tr>
            <td data-label="Metric"><strong>{row.metric}</strong></td>
            <td data-label="Figure">{row.figure}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Figures reflect recent published cycle data and commonly reported preparation-timeline patterns. Verify current vacancy numbers, attempt limits, and age criteria on the official exam body's website — <a href="https://upsc.gov.in/" target="_blank" rel="noopener noreferrer">upsc.gov.in</a> for UPSC, <a href="https://ssc.nic.in/" target="_blank" rel="noopener noreferrer">ssc.nic.in</a> for SSC, and <a href="https://www.ibps.in/" target="_blank" rel="noopener noreferrer">ibps.in</a> for bank exams — before planning around them.
  </p>

  <div class="highlight-box highlight-box--gold">
    <p>
      A longer timeline while working is not a weaker attempt. It is a different, still legitimate route to the same result.
    </p>
    <p>
      What actually separates successful working aspirants from unsuccessful ones is not raw hours — it is consistency, strategic use of leave, and honest tracking of what is and is not working.
    </p>
    <p>
      <strong>Treat this preparation period as building a high-income skill portfolio, not a single bet.</strong> The analytical thinking, discipline, and time-management proof you build while studying alongside a job carry over into every path afterward — the exam result decides which door opens first, not whether the effort was worth it.
    </p>
  </div>

  <h2 id="mistakes">Mistakes to avoid</h2>

  <div class="mistakes-list">
    {mistakeItems.map((item) => (
      <div class="mistake-item">
        <div class="mistake-item__num">{item.num}</div>
        <div class="mistake-item__content">
          <div class="mistake-item__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="next-step">What to do next</h2>

  <p>
    Before changing anything about your job, spend a couple of weeks simply tracking your real focused study hours against your job's actual demands. That data, not a general rule from an article, should decide your next move on leave, notice period, or quitting.
  </p>

  <p>
    Earlier financial freedom does not have to wait for exam results. Building a genuine, high-income skill portfolio alongside your preparation — not just banking on one outcome — keeps you unlocking better opportunities whichever way this specific attempt goes. If you want a second opinion on your runway, timeline, or whether quitting genuinely makes sense for your situation, a session inside <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a> can map it against your actual finances and skills, or start with the free <a href="https://futurecareerschool.com/services/assessments">career and skill assessments</a> if you are still unsure which route fits you best.
  </p>

  <p class="note-line">
    If you are weighing this decision against other exam options entirely, <a href="/blog/government-jobs/ssc-vs-bank-exams-which-to-prepare-india/">SSC vs bank exams: which to prepare for</a> and <a href="/blog/government-jobs/govt-vs-private-job-india/">government job vs private job India</a> cover the earlier decisions this plan depends on.
  </p>

  <h2 id="faq">FAQs on government exam preparation while working</h2>

  <div class="faq-list">
    {faqItems.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-item__q">{item.q}</summary>
        <div class="faq-item__a">{item.a}</div>
      </details>
    ))}
  </div>

  <p>
    If you are still deciding which government exam fits your background and timeline in the first place, <a href="/blog/government-jobs/banking-sector-career-india/">banking sector career India</a> and <a href="/blog/government-jobs/career-options-after-upsc-cse-india/">career options after UPSC CSE India</a> give a closer look at two of the most common working-professional targets.
  </p>

  <style>
    .lead-para {
      font-size: clamp(1.08rem, 1.65vw, 1.2rem);
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.82) !important;
      margin-top: 0 !important;
    }
    .lead-para strong {
      color: #fff;
    }

    .jump-nav {
