  { id: 'decision-framework', label: 'A decision framework if you can only pick one' },
  { id: 'switching-later', label: 'Can you switch tracks later?' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const examRows = [
  {
    aspect: 'What it actually is',
    ssc: 'A recruitment channel for central government departments — Income Tax, Central Excise/GST, Customs, CBI, Ministry of External Affairs, Audit and Accounts, and dozens of others — through SSC CGL (graduate-level, Group B/C posts) and SSC CHSL (12th-pass-level, Group C posts like LDC/JSA and DEO).',
