    }
    .strand-card:nth-child(2) { border-top-color: #e5b84a; }
    .strand-card:nth-child(3) { border-top-color: #a78bfa; }
    .strand-card__name {
      font-family: "Sora", sans-serif;
      font-weight: 800;
      font-size: 1rem;
