---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "What Skills Do You Have? Interview Answer for Freshers in India";
const seoTitle = "What Skills Do You Have? Interview Answer for Freshers";
const description = "What skills do you have? How freshers in India can answer with three matched skills and proof, what interviewers check and mistakes to avoid.";
const seoDescription = "Pick three skills that match the role, and prove each one.";
const canonical = "https://futurecareerschool.com/blog/interviews/what-skills-do-you-have-interview-answer-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How many skills should I name?",
    "Three that match the role."
  ],
  [
    "What if I have few skills?",
    "Name the ones you have with proof and say what you are learning."
  ],
  [
    "Should I include soft skills?",
    "Yes, with an example."
  ],
  [
    "Should I mention a weakness?",
    "Briefly, with what you are doing about it."
  ],
  [
    "How long should the answer be?",
    "Thirty to sixty seconds."
  ],
  [
    "Should I list every software tool?",
    "No. Mention the ones the role needs."
  ],
  [
    "Can I name skills from hobbies?",
    "Yes, if they connect to the work."
  ],
  [
    "Will AI tools help?",
    "For practice, but proof must be yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
