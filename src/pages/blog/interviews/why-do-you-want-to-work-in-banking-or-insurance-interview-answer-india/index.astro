---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Why Do You Want to Work in Banking or Insurance: Interview Answers in India";
const seoTitle = "Why Banking or Insurance? Interview Answers for Freshers in India";
const description = "Why do you want to work in banking or insurance: honest interview answer structures for India, what interviewers listen for and examples without exaggeration.";
const seoDescription = "A good answer links your real reasons, a small proof and what you will learn.";
const canonical = "https://futurecareerschool.com/blog/interviews/why-do-you-want-to-work-in-banking-or-insurance-interview-answer-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Why do you want to work in banking?",
    "Give one honest reason, one small proof and what you hope to learn."
  ],
  [
    "How do I answer for insurance?",
    "Link your interest in protecting people from risk to a real example you understand."
  ],
  [
    "Is it fine to mention job security?",
    "Mention it only with a work-related reason alongside."
  ],
  [
    "What proof can a fresher show?",
    "A project, a course, a conversation or a small explainer."
  ],
  [
    "How long should my answer be?",
    "About ninety seconds."
  ],
  [
    "What if I switched from another field?",
    "Say honestly what changed and what you did since."
  ],
  [
    "Should I mention salary?",
    "Not in this answer. Discuss it when the employer raises it."
  ],
  [
    "Can AI write my answer?",
    "AI can draft. Your reasons must be your own."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="interviews"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
