          <td data-label="Why it can beat it">Real feedback</td>
          <td data-label="Catch">Needs access</td>
        </tr>
        <tr>
          <td data-label="Alternative"><strong>Recording yourself</strong></td>
          <td data-label="Why it can beat it">Honest view</td>
          <td data-label="Catch">Feels awkward</td>
        </tr>
        <tr>
          <td data-label="Alternative"><strong>Reading employer pages</strong></td>
          <td data-label="Why it can beat it">Specific detail</td>
          <td data-label="Catch">Takes time</td>
