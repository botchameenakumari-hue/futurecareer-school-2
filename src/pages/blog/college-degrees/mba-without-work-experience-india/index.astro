---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'MBA without work experience India: who takes freshers, who does not';
const description =
  'MBA without work experience India is normal at IIMs, FMS, and XLRI BM/HRM, but ISB and XLRI GM want 2-3 years first. Real fresher data, IPM alternatives, and an honest wait-or-go test.';
const canonical = 'https://futurecareerschool.com/blog/college-degrees/mba-without-work-experience-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'who-accepts-freshers', label: 'Which B-schools actually accept freshers' },
  { id: 'who-wants-experience', label: 'Which institutes want work experience first' },
  { id: 'fresher-data', label: 'Fresher share at IIMs: the real numbers' },
  { id: 'tradeoffs', label: 'The real trade-offs of a no-experience MBA' },
  { id: 'peer-learning', label: 'Weaker peer learning, and what it costs you' },
  { id: 'placement-leverage', label: 'Thinner placement leverage vs experienced batchmates' },
  { id: 'ipm-alternative', label: 'The 5-year integrated MBA (IPM): a different route' },
  { id: 'should-you-wait', label: 'Should you work 1-2 years first?' },
  { id: 'gates', label: 'Pass The 3 Gates before you commit as a fresher' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const accepterRows = [
  {
    school: 'IIM Ahmedabad, IIM Calcutta, IIM Bangalore',
    stance: 'Fresher-friendly at the flagship level',
    reality: 'IIM Ahmedabad regularly admits close to a third of its batch as freshers; IIM Calcutta\'s 2024 batch had roughly 41% freshers. IIM Bangalore leans more toward experienced profiles, closer to 15% freshers. All three still require a strong 99+ percentile CAT score regardless of work history.',
  },
  {
    school: 'FMS Delhi',
    stance: 'No work experience required',
    reality: 'FMS does not mandate any prior work experience for its full-time MBA. Average work experience in the batch runs around 19-20 months, meaning a healthy mix of freshers and short-experience candidates gets in every year, largely on academics and the entrance test.',
