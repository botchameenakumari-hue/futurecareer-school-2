const requireExpRows = [
  {
    school: 'ISB Hyderabad',
    stance: 'Minimum 2 years required, no exceptions',
    reality: 'ISB\'s PGP explicitly requires a minimum of 24 months of full-time work experience by March 31 of the intake year. The average admitted student carries around 4 years, with experience ranging from 2 to 17 years. There is no fresher route into this program.',
  },
  {
    school: 'XLRI PGDM-GM (General Management)',
    stance: '3+ years of managerial experience required',
    reality: 'This track is built specifically for candidates with at least 3 years of managerial or supervisory experience by the admission cutoff date. It sits apart from XLRI\'s fresher-open BM and HRM programs and should not be confused with them.',
  },
  {
    school: 'Executive MBA and Fellow Programmes (FPM-style)',
    stance: '2-5+ years typically required',
    reality: 'Executive MBA formats at most institutes assume a working professional audience and are structured around case discussion drawn from real managerial experience. A fresher sitting in this format usually struggles to contribute, and most programs screen for exactly that reason.',
  },
  {
    school: 'IIM Bangalore, IIM Udaipur, IIM Amritsar (in practice)',
    stance: 'Open to freshers, but experience is heavily rewarded',
    reality: 'None of these officially bar freshers, but average incoming experience runs 27-29 months — among the highest across the IIM system outside ISB-style programs. A fresher applicant here is competing against a batch that skews experienced by design.',
  },
];

const tradeoffRows = [
  {
    factor: 'Case discussion quality',
    fresherReality: 'You bring theory, internships, and academic projects to a case discussion. That is real input, but it thins out fast in a 90-minute session built around a messy, ambiguous business problem that experienced classmates have actually lived through.',
  },
  {
    factor: 'Classroom diversity of perspective',
    fresherReality: 'A batch heavy with freshers tends to reason similarly — same exam prep, similar academic backgrounds, similar blind spots. A batch with a real spread of industries and functions surfaces angles no single fresher would think to raise.',
  },
  {
    factor: 'Summer internship competitiveness',
    fresherReality: 'Recruiters hiring for the 2-month summer internship between MBA years often shortlist harder on prior exposure to the function, especially in consulting and product roles. A fresher\'s pitch has to lean entirely on projects, competitions, and interview performance instead.',
  },
  {
    factor: 'Final placement leverage',
    fresherReality: 'Candidates entering with 2+ years of relevant pre-MBA experience are frequently eligible for lateral placement tracks that can carry a meaningfully higher starting offer than the standard fresher pool at the same institute.',
  },
  {
    factor: 'Confidence in the interview room',
    fresherReality: 'Being asked "tell me about a time you managed conflict at work" lands very differently for someone with two years of team friction to draw on versus someone reaching for a college group-project story. This is coachable, but it takes real preparation to close the gap.',
  },
];

const ipmRows = [
  {
    iim: 'IIM Indore',
    exam: 'IPMAT Indore (own exam)',
    note: 'Mathematics in Class 12 is compulsory here, unlike most other IPM-offering IIMs. Also accepts a small set of IIMs that use the same IPMAT Indore score.',
  },
  {
    iim: 'IIM Rohtak',
    exam: 'IPMAT Rohtak (own exam)',
    note: 'Open to Science, Commerce, and Humanities students. No compulsory Maths requirement.',
  },
  {
    iim: 'IIM Ranchi, IIM Sirmaur, IIM Amritsar, IIM Sambalpur, IIM Shillong, IIFT Kakinada',
    exam: 'IPMAT Indore score accepted',
