const publishedDateISO = '2026-09-29';
const publishedDateLabel = '29 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career strategist and writer';

const jumpLinks = [
  { id: 'answer', label: 'The short answer for BBA students' },
  { id: 'map', label: 'Best courses for BBA students, side by side' },
  { id: 'floor', label: 'The tool floor: Excel, SQL and Power BI first' },
  { id: 'lanes', label: 'Pick the add-on by your BBA specialisation' },
  { id: 'paid-value', label: 'What you pay for when the content is free' },
  { id: 'exams', label: 'CS, CMA, CA and CFA after a BBA' },
  { id: 'mba', label: 'MBA, CAT and IPM: when the degree is worth it' },
