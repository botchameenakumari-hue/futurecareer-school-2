const canonical = "https://futurecareerschool.com/blog/college-degrees/software-courses-for-civil-engineering-students-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which software should civil students learn?",
    "Drafting, structural analysis, BIM, scheduling and estimating tools, chosen by role."
  ],
  [
    "Do I need paid certificates?",
    "Not always. A worked project helps more."
  ],
  [
    "Which tool first?",
    "Read notices. Drafting is often first."
  ],
  [
    "Can I learn free?",
    "Many free lessons and student versions exist. Check terms."
  ],
  [
    "How long to be ready?",
    "About five hours a week for twelve weeks is a start."
  ],
  [
    "Is hand calculation still needed?",
    "Yes, to check software outputs."
  ],
  [
    "Are site skills important?",
    "Yes. Visit sites and take notes."
  ],
  [
    "Will AI change civil jobs?",
    "Routine drafting shrinks. Judgment and accountability remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
