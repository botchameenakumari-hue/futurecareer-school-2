const mistakeItems = [
  {
    num: '01',
    title: 'Choosing an MBA because "everyone eventually does one"',
    body: 'An MBA works as an accelerator for a direction you already have real conviction about. Used as a two-year pause button on a decision you have not made, it adds cost and debt without resolving the actual confusion.',
