  [
    "Which route suits physics?",
    "MSc entrance exams, integrated programmes and fellowships are common. Verify each one."
  ],
  [
    "Which route suits maths?",
    "MSc entrance exams and research routes are common. Verify each one."
  ],
  [
    "Which route suits chemistry?",
    "MSc entrance exams and research routes are common. Verify each one."
  ],
  [
    "Do I need coaching?",
    "Not always. Compare cost with free material."
  ],
  [
    "What if I do not clear?",
    "Keep a backup skill and other routes."
  ],
  [
    "How do I avoid fraud?",
    "Use only official pages."
  ],
  [
    "Will AI change preparation?",
    "It helps practice. Discipline remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
