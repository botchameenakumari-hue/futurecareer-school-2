  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Background',
    body: 'What did your undergraduate degree already train you to do well? Commerce gives you numbers and business language. Arts gives you communication and critical thinking. Science gives you data and method. Engineering gives you systems thinking. Pick a specialization that compounds this, not one that ignores it.',
    note: 'Starting a specialization with zero head start is not impossible, but it is a slower, harder climb than most people expect going in.',
  },
  {
    num: '02',
    title: 'Work style',
    body: 'Do you want a desk-and-data role, a people-and-culture role, a client-facing role, or a hybrid? Finance and analytics skew toward analytical desk work. HR and marketing skew toward people and communication. Operations and international business skew toward coordination, negotiation, and travel.',
    note: 'A specialization that fights your natural energy pattern will feel exhausting long after the excitement of getting in fades.',
  },
  {
    num: '03',
    title: 'Institute reality',
    body: 'The specialization label only pays off if the specific institute you attend places well into that function. A finance specialization at a weak institute usually loses to an operations specialization at a strong one.',
    note: 'Check the actual placement report for your shortlisted specialization at your shortlisted institute, not a five-year-old ranking article.',
  },
  {
    num: '04',
    title: 'Money reality',
    body: 'Can your family absorb one to two years of MBA fees plus lost income, or do you need a fresher-friendly, lower-cost route? A Tier-1 IIM changes this math completely; a Tier-3 private MBA with a weak placement record often does not.',
    note: 'Run the actual fee-to-likely-salary math for your shortlisted institute before you commit, not after.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Before spending two years and real money, do one small proof project in the specialization: a basic financial model for finance, a mock brand plan for marketing, a small process map for operations, or a simple dashboard for analytics.',
