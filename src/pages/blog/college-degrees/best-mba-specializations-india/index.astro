    salary: 'Not a salary track. Outcome depends entirely on the venture; most graduates take a job first to build capital and a network before founding.',
  },
];

const backgroundFitCards = [
  {
    label: 'Commerce (BCom, BBA)',
    title: 'Finance, marketing, or international business',
    body:
      'Your degree already covers accounting, economics, and business fundamentals. Finance and international business build directly on that; marketing adds the consumer and brand layer most commerce degrees skip.',
  },
  {
    label: 'Arts and humanities (BA)',
    title: 'HR, marketing, or international business',
    body:
      'Communication, critical thinking, and people-reading skills from an arts degree map cleanly onto HR and marketing. Do not assume you are shut out of finance or analytics either, if you can show real quantitative work.',
  },
  {
    label: 'Science (BSc)',
    title: 'Business analytics, operations, or healthcare-and-pharma-focused MBA',
    body:
      'A science background already trained you in data, method, and structured problem-solving. That transfers well into analytics and operations, and into healthcare-sector MBA tracks if your degree was in life sciences.',
  },
  {
    label: 'Engineering (BTech, BE)',
    title: 'Operations, analytics, product, or technology strategy',
