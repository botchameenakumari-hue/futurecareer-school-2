---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = '12 courses for arts students after 12th, ranked by real fit and pay';
const description =
  'The real courses for arts students after 12th: BA majors, BA LLB, BJMC, BFA, BSW, psychology, hotel management, animation, and skill certificates, compared by cost, entry route, and pay.';
const canonical =
  'https://futurecareerschool.com/blog/college-degrees/courses-for-arts-and-humanities-students-after-12th/';
const publishedDateISO = '2026-09-27';
const publishedDateLabel = '27 September 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career strategist and writer';
const heroImageUrl = '/images/blog/college-degrees/courses-for-arts-and-humanities-students-after-12th/courses-for-arts-and-humanities-students-after-12th-hero.webp';
const socialImageUrl = '/images/blog/college-degrees/courses-for-arts-and-humanities-students-after-12th/courses-for-arts-and-humanities-students-after-12th-social.jpg';

const jumpLinks = [
  { id: 'answer', label: 'The direct answer' },
  { id: 'routes', label: 'Courses for arts students after 12th, ranked' },
  { id: 'work-style', label: 'Choose by work style, not label' },
  { id: 'skill-courses', label: 'Skill courses worth stacking on top' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'budget', label: 'The college and course budget filter' },
  { id: 'self-learn', label: 'Self-learning vs a paid course' },
  { id: 'stacking', label: 'Why the combination pays, not the subject' },
  { id: 'mistakes', label: 'Mistakes that waste years and money' },
  { id: 'parents', label: 'What parents should check' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const routeRows = [
  {
    course: 'BA (major in Psychology, Economics, Political Science, English, History, Sociology)',
    entry: 'CUET UG for most central and many state universities; direct merit at some state colleges',
    reality:
      'The most flexible route and the one arts students default to. It pays only when you pick a major deliberately and add proof of work, not because the degree name alone opens doors.',
  },
  {
    course: 'BA LLB (5-year integrated law)',
    entry: 'CLAT UG for National Law Universities; CUET UG or private-university tests for others',
    reality:
      'A genuinely strong path when you like reading, argument, and structured thinking. The competition is two-stage: clearing CLAT is one hurdle, building a well-paying practice afterward is a separate, harder climb.',
  },
  {
    course: 'BJMC / BA in Journalism and Mass Communication',
    entry: 'CUET UG or the institute\'s own entrance test; some private colleges take direct admission',
    reality:
      'Good for writing- and media-inclined students, but newsroom hiring has shrunk while digital, brand, and content roles have grown. Treat this as a base, not a guarantee of a reporting job.',
  },
  {
    course: 'BFA (Bachelor of Fine Arts) and design-adjacent UG courses',
    entry: 'Portfolio-based entrance tests; NID and NIFT run their own separate national entrance exams',
    reality:
      'Portfolio quality matters more than the degree label. This path rewards visible work and scales well, since a strong portfolio can later grow into freelance work or a studio.',
  },
  {
    course: 'BSW (Bachelor of Social Work)',
    entry: 'Merit-based or entrance-test admission depending on the university; CUET UG at many central universities',
    reality:
      'A genuine route into NGO, CSR, and social-sector work. Pay stays modest at entry almost everywhere, so this needs a clear-eyed view of the sector\'s pay ceiling before committing years to it.',
  },
  {
    course: 'BA / BSc in Psychology',
    entry: 'CUET UG for most universities; a few private colleges run their own aptitude round',
    reality:
      'Strong when paired with genuine patience for years of further study. A bachelor\'s degree alone rarely qualifies you to practise clinically; the real career usually needs a master\'s and supervised registration.',
  },
  {
    course: 'BHM / Hotel Management',
    entry: 'NCHMCT JEE for the government institute network; direct or institute-specific tests elsewhere',
    reality:
      'A structured, hands-on route with real hospitality and travel-sector demand. Starting pay is modest at the operations level; the income growth comes from moving into management, F&B, or hotel-chain leadership over years.',
  },
  {
    course: 'Animation, VFX, and Multimedia diploma or BSc',
    entry: 'Portfolio or entrance test depending on the institute; no fixed national entrance exam',
    reality:
      'Hiring here is almost entirely portfolio-based. A weak-institute degree with no demo reel is close to worthless; a strong reel from a average-brand institute still gets interviews.',
  },
  {
    course: 'Government exam preparation track (UPSC, state PCS, banking, SSC)',
    entry: 'No formal course; usually paired with any BA degree while preparing separately',
    reality:
      'A valid option but the least scalable one here, since pay and role stay capped by a fixed structure. Clearing the prelims and mains is only the first hurdle; reaching top postings later is a separate, harder climb.',
  },
];

const workStyleCards = [
  {
    label: 'Language',
    title: 'You are strongest at reading, writing, and explaining',
    body: 'BA English, BJMC, law, and content-focused courses fit better when expression is your real advantage over people around you.',
  },
  {
    label: 'People',
    title: 'You like understanding behaviour and helping people directly',
    body: 'Psychology, social work, HR-adjacent courses, and counselling-track programs fit better when human contact energises you rather than drains you.',
  },
  {
    label: 'Creative',
    title: 'You want to make ideas visual or experiential',
    body: 'BFA, animation, design-adjacent courses, and media production fit better when you like both originality and repeated, disciplined output.',
  },
  {
    label: 'Structured',
    title: 'You like systems, service, and clear operational routines',
    body: 'Hotel management, BSW, and structured government-exam preparation fit better when you prefer defined processes over open-ended ambiguity.',
  },
];

const skillCourses = [
  {
    track: 'Design and UX',
    course: 'Google UX Design Professional Certificate (Coursera)',
    body: 'A structured, project-based entry point into UX with a portfolio built in. Judge it by the three case studies you finish, not the certificate name.',
  },
  {
    track: 'Design and UX',
    course: 'User Experience Research and Design Specialization, University of Michigan (Coursera)',
    body: 'Stronger on research method and evidence-based design decisions, useful once you already know you like the user-research half of UX work.',
  },
  {
    track: 'Writing and content',
    course: 'Content Strategy for Professionals Specialization, Northwestern University (Coursera)',
    body: 'Useful for arts students moving from academic writing into brand, marketing, and digital-content roles where structure and audience thinking matter more than literary style.',
  },
  {
    track: 'Digital marketing',
    course: 'Digital Marketing Specialization, University of Illinois (Coursera)',
    body: 'Covers analytics, SEO, and digital strategy fundamentals. Pair it with one real campaign you run yourself; the certificate alone does not get anyone hired.',
  },
  {
    track: 'Psychology fundamentals',
    course: 'Introduction to Psychology, Yale University (Coursera, audit free)',
    body: 'A genuinely well-regarded free course for testing real interest in the subject before committing three years and money to a psychology degree.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Fit',
    body: 'Ask what kind of daily work suits your real energy: reading and arguing, people work, visual work, or structured service routines. Choose the work style, not only the subject label.',
    note: 'A student who dislikes dense reading should not force law or a research-heavy MA only because it sounds respectable.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Check your family\'s financial runway, school quality, language confidence, and how much time you can realistically give to a slower entrance-exam or portfolio-building route.',
    note: 'A course can sound meaningful and still be wrong if the practical setup around you cannot support it.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Look at real placement reports, real job postings, and real entrance-exam cutoffs for the specific course and institute, not a relative\'s decade-old success story.',
    note: 'If you cannot name three real roles this course leads to, you are still choosing too vaguely.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'Ask how AI changes the field. Routine content, first-draft reporting, and template design work are already under pressure. Judgment, argument, taste, and client relationships hold up better.',
    note: 'Choose the version of the course where you end up owning a judgment call, not just producing a first draft.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Before enrolling, complete one small but real output: write a short brief, design a mock poster, attempt a mock CLAT or CUET paper, or shadow one day of the actual work.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'Explain in under two minutes why this specific course fits your work style and your family\'s financial runway, not why it sounds impressive at a family function.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of value',
    body: 'Show your mock attempt, brief, or design piece to someone already working in that exact lane and ask what is genuinely missing before you commit money or years.',
  },
];

const stackingRows = [
  {
    base: 'BA English or BJMC',
    multiplier: 'Content strategy plus one real published portfolio of writing samples',
    why: 'Newsroom hiring alone has shrunk. Writing plus digital strategy opens brand, content, and communications roles that are actually growing.',
  },
  {
    base: 'BA LLB',
    multiplier: 'A specialisation through an LLM after CLAT-PG (IP, tax, or tech law)',
    why: 'A generalist law degree caps out faster than most students expect. Specialisation is what firms pay a premium for, not the degree alone.',
  },
  {
    base: 'BA / BSc Psychology',
    multiplier: 'Research method training plus a genuine plan for a master\'s and supervised registration',
    why: 'A bachelor\'s in psychology alone rarely qualifies anyone to practise. The multiplier is the further study most students underestimate.',
  },
  {
    base: 'BFA or animation diploma',
    multiplier: 'A finished portfolio or demo reel with three to five strong pieces',
    why: 'Hiring managers in design and animation filter almost entirely on portfolio quality, not institute name.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Assuming arts only leads to UPSC or teaching',
    body: 'Law, psychology, design, mass communication, social work, hotel management, and animation are all real routes with real hiring behind them when taken seriously.',
  },
  {
    num: '02',
    title: 'Picking a course by its family reputation instead of its actual placement data',
    body: 'A BJMC, BSW, or BA degree from an unranked private college with no placement cell is a different bet than the same course at a well-regarded institute. Check the specific college\'s numbers, not the subject\'s general reputation.',
  },
  {
    num: '03',
    title: 'Taking an education loan for a course with no clear income path',
    body: 'Several of the courses on this list, especially BFA, BSW, BJMC, and animation diplomas, pay modestly at entry almost everywhere. A large loan against a course like this rarely clears its own EMI on a short timeline.',
  },
  {
    num: '04',
    title: 'Believing a certificate alone gets you hired in design, marketing, or analytics',
    body: 'Employers filter on one real, finished project far more than on a certificate name. Build the portfolio piece before you apply for roles, not after.',
  },
  {
    num: '05',
    title: 'Ignoring the entrance-exam or portfolio timeline until the final year',
    body: 'CLAT, NID, NIFT, and NCHMCT JEE all reward early, sustained preparation. Find out the actual exam pattern and eligibility in the first year of college planning, not the last semester of school.',
  },
];

const parentChecks = [
  {
    title: 'Ask what the actual daily work looks like',
    body: 'If nobody in the family can describe the real daily work behind a course name, the decision is still running on labels and assumptions.',
  },
  {
    title: 'Ask how the student will build proof early',
    body: 'For nearly every course on this list, visible work, writing, a portfolio, a mock brief, changes outcomes more than the degree certificate does on its own.',
  },
  {
    title: 'Ask what the full cost and realistic income timeline look like',
    body: 'Do not spend heavily on an average course if it leaves no room for tools, a portfolio, internships, or later upskilling.',
  },
  {
    title: 'Ask whether the route fits the student or only the family\'s comfort with the label',
    body: 'A familiar-sounding course becomes a risky bet fast when the fit is weak and the student has no real energy for the daily work involved.',
  },
];

const faqItems = [
  {
    q: 'What are the best courses for arts students after 12th?',
    a: 'The strongest options are BA with a deliberately chosen major (psychology, economics, political science, English), BA LLB, BJMC, BFA, BSW, hotel management, and animation, each paired with a modern skill like writing, design, research, or digital marketing. The single best course depends on your work style and how much entrance-exam or portfolio effort you can realistically put in, not a universal ranking.',
  },
  {
    q: 'Which courses for arts students after 12th need CUET UG?',
    a: 'Most central universities and many state universities now use CUET UG for BA, BSW, BA Psychology, and several BJMC programs. Law (through CLAT), design institutes like NID and NIFT, and hotel management (through NCHMCT JEE) run their own separate national entrance exams instead of CUET UG. Always check the specific university\'s current admission notice, since participation and subject requirements can change year to year.',
  },
  {
    q: 'Are courses for humanities students different from courses for arts students?',
    a: 'No. In India, "arts" and "humanities" describe the same 10+2 stream, so courses for humanities students and courses for arts students are the same list: BA majors, law, mass communication, psychology, social work, and the skill-first routes covered in this article.',
  },
  {
    q: 'Can arts students take a nursing course, and is a nursing course for arts students realistic?',
    a: 'Yes, for GNM and ANM diploma nursing. General Nursing and Midwifery (GNM, a roughly 3.5-year diploma) and Auxiliary Nurse Midwifery (ANM, a 2-year diploma) are generally open to students from any 10+2 stream, arts, commerce, or science, because Biology is not a mandatory subject for these diploma programs at most nursing colleges and state nursing councils. The usual baseline is a 10+2 pass with English as a subject and roughly 40-50% aggregate marks, with an age window of about 17 to 35 years, though exact cutoffs and any entrance test vary by state and college, so verify with the specific institution or state nursing council before applying. The direct 4-year B.Sc Nursing (Basic) degree is different: it typically requires 10+2 with Physics, Chemistry, and Biology (PCB) as compulsory subjects. An arts-stream student who wants a nursing degree without having taken PCB can still get there by completing GNM first, registering as a nurse, and then doing a 2-year Post-Basic B.Sc Nursing, a route that does not require PCB in 12th.',
  },
  {
    q: 'Do arts students need a paid course, or is self-learning enough?',
    a: 'It depends on the field. For writing, content, digital marketing, and basic design skills, a committed self-learner using free or low-cost resources like reputable YouTube channels, official documentation, and a well-reviewed Coursera or edX course can genuinely keep pace with a formal syllabus. For law, clinical psychology, and any nursing route, formal admission, supervised practice, or licensing is legally required, and self-learning cannot substitute for it.',
  },
  {
    q: 'How much should a family spend on a course for an arts student?',
    a: 'A useful starting heuristic is to keep any single course\'s total fee within roughly 10% of the family\'s total education budget, and go higher only when there is specific evidence, verified placement outcomes, accreditation, or scarce facilities, not general brand reputation. Spending well above that without such evidence is a common way families overpay for an average outcome.',
  },
  {
    q: 'Which courses for arts students after 12th pay the fastest?',
    a: 'Skill-first routes like digital marketing certifications and portfolio-based design or animation work usually produce a first paying opportunity faster, often within months of building real proof of work. Degree routes like BA LLB, psychology, and BJMC take longer to convert into income but generally offer a higher long-term ceiling once the right specialisation and proof of work are added.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="college-degrees"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  ogImage={socialImageUrl}
  ogImageWidth={1200}
  ogImageHeight={630}
  jsonLdExtras={[faqJsonLd]}
>
  <figure class="article-cover-visual">
    <img src={heroImageUrl} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" alt="Indian Class 12 student comparing arts-course options, creative work samples, and budget notes at a sunlit classroom desk" title="12 courses for arts students after 12th, ranked by real fit and pay" />
    <figcaption>The right arts course is a fit-and-proof decision, not a universal ranking handed down by someone else.</figcaption>
  </figure>
  <p class="lead-para">
    <strong>The best courses for arts students after 12th are BA with a deliberately chosen major, BA LLB,
    BJMC, BFA, BSW, psychology, hotel management, and animation, and the right one for you depends on your
    work style and entrance-exam readiness, not a single universal ranking.</strong>
    Every course here trades cost, time, and entrance-exam or portfolio difficulty for a different pay
    ceiling, and the one your cousin picked is not automatically the one that fits you.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Courses for arts students after 12th go far beyond BA-plus-UPSC: law, mass communication, design, psychology, social work, hotel management, and animation are all real, hireable routes.</li>
      <li>Courses for humanities students and courses for arts students are the same list in India, since arts and humanities describe the same 10+2 stream.</li>
      <li>A nursing course for arts students is realistic through GNM or ANM diploma nursing, which generally does not require Biology, though the direct B.Sc Nursing degree usually does.</li>
      <li>The stream alone does not create income. A course plus one visible skill on top, writing, design, research, or a digital tool, is what actually builds a <strong>high-value skill portfolio</strong> and moves you toward <strong>earlier financial freedom</strong>.</li>
      <li><strong>Run your shortlist through the 4-Checkpoint Protocol and the 3 Gates before you commit money or years to one course.</strong></li>
      <li>Test one course seriously with a small proof step, a mock entrance paper, a mock brief, a small portfolio piece, before you spend heavily or take a loan against it.</li>
    </ul>
  </div>

  <figure class="article-visual">
    <img src="/images/blog/college-degrees/courses-for-arts-and-humanities-students-after-12th/courses-for-arts-and-humanities-students-after-12th-at-a-glance-summary.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="At-a-glance map of arts courses after 12th across BA majors, law, media, design, social work, psychology, hospitality, and animation" title="At a glance: courses for arts students after 12th" />
    <figcaption>Compare routes by daily work, entry path, budget, and the skill you can make visible on top of the course.</figcaption>
  </figure>

  <p>
    For the wider picture of career paths after arts, not just courses, read
    <a href="/blog/career-options/career-options-in-arts/">career options in arts</a>. If you want a
    clearer read on your own strengths before shortlisting a course, a session with
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">structured
    career guidance</a> can turn this list into a plan built around your actual runway and timeline.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="answer">The direct answer before the list</h2>

  <p>
    Ask most families which course an arts student should take after 12th, and you get one of two
    answers: "just do BA and prepare for UPSC," or "arts does not really lead anywhere serious."
  </p>

  <p>
    Both answers skip the part that actually decides the outcome: which specific course, at which
    specific institute, paired with which specific skill.
  </p>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad framing</p>
    <ul class="callout__list">
      <li>Arts only really leads to a plain BA, UPSC prep, or teaching.</li>
      <li>Any BA degree is basically the same as any other BA degree.</li>
      <li>Creative or people-facing courses like BFA or BSW "do not count" as serious courses.</li>
      <li>A course is good simply because a relative says it worked out for someone they know.</li>
    </ul>
    <p class="callout__footer">
      None of this tells you what the daily work looks like, what a specific course actually costs, or
      which skill turns that course into real income.
    </p>
  </div>

  <p>
    Courses for arts students after 12th are wider than most families are told, and courses for humanities
    students describe the exact same list, since arts and humanities are the same 10+2 stream in India.
  </p>

  <h2 id="routes">Courses for arts students after 12th, ranked by real fit</h2>

  <figure class="article-visual">
    <img src="/images/blog/college-degrees/courses-for-arts-and-humanities-students-after-12th/courses-for-arts-and-humanities-students-after-12th-comparison-courses-arts-students-after.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="Comparison of arts-course entry routes and reality checks for BA, BA LLB, journalism, fine arts, and social work" title="Courses for arts students after 12th, ranked by real fit" />
    <figcaption>A course list becomes useful only when entry route and daily-work reality sit beside the name.</figcaption>
  </figure>

  <p>
    A random list of degree names does not help much. It is more useful to see each course next to its
    actual entrance route and an honest reality check.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Real entry route</th>
          <th>Reality check</th>
        </tr>
      </thead>
      <tbody>
        {routeRows.map((item) => (
          <tr>
            <td data-label="Course"><strong>{item.course}</strong></td>
            <td data-label="Real entry route">{item.entry}</td>
            <td data-label="Reality check">{item.reality}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Entry routes and exam names change. Verify current details on the
    <a href="https://cuet.nta.nic.in/" target="_blank" rel="noopener noreferrer">official CUET UG portal</a>,
    the <a href="https://consortiumofnlus.ac.in/" target="_blank" rel="noopener noreferrer">CLAT Consortium of NLUs</a>,
    the <a href="https://www.admissions.nid.edu/" target="_blank" rel="noopener noreferrer">NID admissions
    portal</a>, the <a href="https://www.nift.ac.in/admission" target="_blank" rel="noopener noreferrer">NIFT
    admissions page</a>, and the <a href="https://nchmjee.nta.nic.in/" target="_blank" rel="noopener noreferrer">
    NCHMCT JEE portal</a> before planning around any one of them.
  </p>

  <h2 id="work-style">Choose by work style, not by the course name</h2>

  <p>
    Many students pick a course because the name sounds respectable, then discover the daily work does not
    suit them at all. Work style is a better filter than label popularity.
  </p>

  <div class="work-style-grid">
    {workStyleCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--gold">
    <p>
      Liking a subject in school is not the same as liking the career it leads to.
    </p>
    <p>
      Test the actual output before you commit: write something, design something, argue something, or
      shadow a day of the real work.
    </p>
  </div>

  <h2 id="skill-courses">Skill courses worth stacking on top</h2>

  <p>
    A degree gives you a base. A genuinely well-chosen skill course on top is often what turns that base
    into a hireable, higher-paying profile.
  </p>

  <div class="proof-grid">
    {skillCourses.map((item) => (
      <div class="proof-card">
        <span class="proof-card__track">{item.track}</span>
        <p><strong>{item.course}.</strong> {item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    Judge the specific course, not the platform brand. Check the instructor's recent credibility, how
    recently the syllabus was updated, the depth of the projects, and whether past learners show real
    outcomes, before you pay for anything. Sample the subject with a free audit or a low-cost module first
    wherever the platform allows it.
  </p>

  <h2 id="checkpoint">Use The 4-Checkpoint Protocol before you pick one course</h2>

  <p>
    Nine or ten options is too many to compare in your head at once. The 4-Checkpoint Protocol narrows it
    down fast.
  </p>

  <div class="protocol-stack">
    {checkpointItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <h2 id="gates">Pass The 3 Gates before you commit money or years</h2>

  <p>
    The 4-Checkpoint Protocol above helps you compare courses on paper. The 3 Gates make you test the
    course in the real world before you spend a family's savings or several years of your life on it.
  </p>

  <div class="gates-block">
    <p class="gates-block__title">
      Do not lock in a multi-year plan or an education loan before passing all three gates.
    </p>
    <div class="gates-row">
      {gateItems.map((item) => (
        <div class="gate">
          <span class="gate__num">{item.num}</span>
          <span class="gate__name">{item.title}</span>
