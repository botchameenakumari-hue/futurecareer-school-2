const checkpointItems = [
  { num: '01', title: 'Your fit', body: 'Picture the same ordinary day for years: patients and shifts, a lab bench, a plant floor, or a desk with case forms. Ask to watch someone do it at work before you decide.', note: 'A pay range only helps if you stay in the work long enough to reach it.' },
  { num: '02', title: 'Your situation', body: 'Add up the whole fee, hostel and exam costs, and count how many years your family can wait before you earn. MBBS and BDS need the longest wait, and nursing and retail pharmacy the shortest.', note: 'A course you cannot afford to finish pays nothing.' },
