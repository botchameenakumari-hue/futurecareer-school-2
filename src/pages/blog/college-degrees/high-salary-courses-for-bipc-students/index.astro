const gateItems = [
  { num: 'Proof 1', title: 'Show it', body: 'Make one real piece for the course you lean towards: a patient handout in your own language, a one-page summary of a public drug safety notice, a small analysis of an open health dataset, or a de-identified practice case summary. Keep it in one folder or one profile you can share.' },
