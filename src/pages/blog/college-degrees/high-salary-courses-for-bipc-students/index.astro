  { role: 'Drug safety associate (pharmacy and life-science route)', overall: 'Rs 2.3 to 6 lakh a year', fresher: 'Rs 1.5 to 5 lakh', four: 'Rs 2.9 to 7 lakh', basis: 'About 3,000 salaries. Page updated 12 March 2025' },
