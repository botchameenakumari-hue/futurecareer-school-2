const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which software should architecture students learn?",
    "The tools named in your studio and in notices. Start with drafting, then modelling."
  ],
  [
    "Are paid courses needed?",
    "Not always. Free student tools and projects can be enough."
  ],
  [
    "Is rendering essential?",
    "It helps communicate. Design thinking matters more."
  ],
  [
    "How do I build a portfolio?",
    "Choose three strong projects and explain your reasoning."
  ],
  [
    "Should I learn sustainability?",
    "Yes, basics help in most practices."
  ],
  [
    "How long does it take?",
    "A focused three months for a first level."
  ],
  [
    "Can I freelance?",
    "With rules and a portfolio, for small work."
  ],
  [
    "Will AI replace architects?",
    "Routine drafts shrink. Design judgment remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
