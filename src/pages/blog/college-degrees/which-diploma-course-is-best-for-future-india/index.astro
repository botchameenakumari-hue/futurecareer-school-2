---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Which diploma course is best for future? Four tests before you enrol';
const seoTitle = 'Which Diploma Course Is Best for Future? How to Test One';
const description =
  'Which diploma course is best for future? No name is safe. Test approval, hands-on work, who pays and the step up, then compare six diploma families.';
const canonical =
  'https://futurecareerschool.com/blog/college-degrees/which-diploma-course-is-best-for-future-india/';
const publishedDateISO = '2026-11-15';
const publishedDateLabel = '15 November 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';
const salesHref =
  '/services/career-counselling-and-career-guidance/career-counselling-after-12th/';
const salesLabel = 'Get Career Counselling After 12th';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'this-week', label: 'Do this week' },
  { id: 'future-check', label: 'The future check: four tests for any diploma' },
  { id: 'evidence', label: 'What the latest data shows' },
  { id: 'families', label: 'Six diploma families, strongest scalability first' },
  { id: 'by-person', label: 'The better bet, person by person' },
  { id: 'step-up', label: 'The step-up that keeps a diploma alive' },
  { id: 'who-pays', label: 'Who pays, and how they judge you' },
  { id: 'pay', label: 'Pay and the real ceiling' },
  { id: 'ai', label: 'What AI changes for diploma jobs' },
  { id: 'checkpoint', label: 'Check before you commit' },
  { id: 'money', label: 'Money check before you pay' },
  { id: 'mistakes', label: 'Mistakes that cost years' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const futureChecks = [
  {
    name: 'Approval gate',
    ask: 'Is this diploma approved by the body that matters for the job it leads to?',
    good: 'An engineering diploma from a college on the AICTE approved list, or a health diploma that leads to a named council registration.',
    watch: 'A grand name from an institute that cannot show an approval letter in writing.',
  },
  {
    name: 'Hands-on core',
    ask: 'Will you work with tools, instruments, sites or patients in a way a chatbot cannot do for you?',
    good: 'Wiring a panel, running a lab test, reading a site drawing, with practice hours in a real workshop or ward.',
    watch: 'A "computer diploma" that is mostly typing, slides and theory. Software handles that part first.',
  },
  {
    name: 'Paid demand',
    ask: 'Who will spend money on this work in the next few years, and can you name them?',
    good: 'A government scheme, a hospital chain, a power utility, a factory floor.',
    watch: 'Demand that shows up only in a trend article, with no company or department behind it.',
  },
  {
    name: 'Step-up route',
    ask: 'Can this diploma lead to a degree or a senior role later without starting again?',
    good: 'Lateral entry (joining a B.Tech in the second year), a part-time degree after work experience, or a supervisor role.',
    watch: 'A certificate that ends at the certificate.',
  },
];

const evidenceRows = [
  {
    signal: 'Careers360, 23 April 2025, using AICTE data',
    shows: 'In 2024-25 India had 3,566 polytechnics, 59% of them private. About 33% of 9.7 lakh approved seats sat empty in 2022-23, down from 48% in 2017-18.',
    notShow: 'Which branches or colleges are the weak ones.',
  },
  {
    signal: 'Careers360, 16 September 2026, NCAHP regulations',
    shows: 'The 2026 regulations require 57 allied and healthcare professions to register, for five years at a time.',
    notShow: 'Registration has not started, and it does not say which diplomas will qualify.',
  },
  {
    signal: 'Cabinet approval of PM Surya Ghar (February 2024) and All India Radio News (23 September 2026)',
    shows: 'PM Surya Ghar aims at rooftop solar for 1 crore households. By 23 September 2026 it had reached over 51 lakh families, with 14.8 GW commissioned, and the government says it is creating local work for solar technicians.',
    notShow: 'It gives no count of jobs filled, and it does not say how many of them suit diploma holders.',
  },
  {
    signal: 'WEF Future of Jobs 2025, as reported by The Week',
    shows: 'India\'s fastest-growing roles are big data, AI and machine learning, and security management specialists. 30% of companies in India plan skills-based hiring by dropping degree requirements, against 19% worldwide.',
    notShow: 'Those top roles mostly ask for more than a three-year diploma.',
  },
];

const families = [
  {
    name: 'Computer, AI and data diplomas',
    scale: 'high',
    scaleLabel: 'Scalable',
    why: 'Work can be sold to clients in any city and later become a product. It scales only with proof, because AI takes entry tasks first.',
    holds: 'Data and AI roles are among the fastest-growing in India.',
    watch: 'High-paying roles usually ask for a degree or years of proof.',
    add: 'Learn SQL and Python, build one project a client could use, and plan lateral entry into a degree.',
  },
  {
    name: 'Electrical and electronics, with a solar and power layer',
    scale: 'mid',
    scaleLabel: 'Scalable with a business layer',
    why: 'You can own the work: installation plus a yearly service contract, at your own price. Some states ask for a licence.',
    holds: 'Power, solar and building wiring need people on site, and Junior Engineer posts are a second door.',
    watch: 'Entry pay is modest, and installation gets crowded where many small firms compete.',
    add: 'Learn solar installation, inverter and meter faults, and electrical safety.',
  },
  {
    name: 'Civil and construction diplomas',
    scale: 'mid',
    scaleLabel: 'Scalable with a business layer',
    why: 'Estimating, surveying and small contracting can be sold on your own. Income swings with the building cycle.',
    holds: 'Site work does not move to a laptop, and public works and municipal Junior Engineer posts hire from this branch.',
    watch: 'Pay depends on site years and a good first supervisor.',
    add: 'Learn estimating, drawing software and basic contract paperwork.',
  },
  {
    name: 'Mechanical and mechatronics diplomas',
    scale: 'low',
    scaleLabel: 'Not so scalable',
    why: 'Shop-floor pay climbs a fixed ladder, and owning a workshop needs machines and money first.',
    holds: 'Factories need people who can set up and fix machines, and automation adds new tasks.',
    watch: 'A plain mechanical diploma with no speciality starts low and can stay flat.',
    add: 'Take a PLC, CNC or maintenance planning skill, then use lateral entry for a design or lead role.',
  },
  {
    name: 'Allied health technician diplomas',
    scale: 'low',
    scaleLabel: 'Not so scalable',
    why: 'Hospitals set the pay ladder, and a lab or clinic of your own needs licences and capital. Demand is steady, but income grows slowly.',
    holds: 'Labs, imaging, operation theatres and dialysis need trained hands. Nursing (GNM) and D.Pharm already lead to a council registration.',
    watch: 'The 2026 registration rules for state-level boards are still pending, and starting pay is often low.',
    add: 'Ask which registration your diploma leads to, then add one instrument speciality and clear patient communication.',
  },
  {
    name: 'Private skill diplomas in digital work and design',
    scale: 'low',
    scaleLabel: 'Not so scalable as a certificate',
    why: 'The paper adds little. The skill under it can scale like the first family, but only through finished work clients can see.',
    holds: 'Only when a portfolio proves the skill.',
    watch: 'Many carry no approval, and the fee can be large for what free lessons teach.',
    add: 'Build three finished pieces for real people first, then decide if a paid course adds feedback you cannot get free.',
  },
];

const personCards = [
  {
    name: 'After Class 10: the polytechnic route',
    body: 'Choose the branch by the employer you can name, not by the label. A diploma gives you work years sooner, and a degree keeps more doors open.',
    watch: 'Pick a college with workshops and a lateral-entry record, not just a low fee.',
  },
  {
    name: 'After Class 12',
    body: 'Take an engineering or health technician diploma only if you want hands-on work. From commerce or arts, stay with approved health, design or digital diplomas, since engineering diplomas usually need science.',
    watch: 'Do not take a diploma only because a rank fell short, and skip any that promises a job without naming an approval.',
  },
  {
    name: 'Working adult, ITI holder or earlier diploma holder',
    body: 'Keep earning and add the step-up. AICTE revived a B.Tech for working professionals in October 2023, which needs one year of work experience and a home or workplace within 75 km (Careers360, 1 May 2025).',
    watch: 'Some state universities had not recognised it when Careers360 reported, so ask for the approval before you pay.',
  },
];

const mistakes = [
  {
    title: 'Choosing the diploma that sounds modern',
    body: 'By August 2025 Maharashtra had 1,03,115 first-year diploma admissions, its highest in ten years, and its minister credited AI, data science and robotics courses. A full seat is not a job, so ask what you will do in week one of the work.',
  },
  {
    title: 'Trusting a placement promise',
    body: 'Careers360 reported one government polytechnic in Ambala City placing 64% and then 56%, while a polytechnic for women in Faridabad reported 97 to 100% over five years. These counts include students who chose higher study, so ask for the last three batches by name.',
  },
  {
    title: 'Skipping the step-up until it is too late',
    body: 'Lateral entry and part-time degrees have rules on branch, marks and experience. Read them in your first year, not your last.',
  },
];

const faqItems = [
  {
    q: 'Which diploma course is best for future?',
    a: 'No diploma is safe by its name. Pick an approved one with hands-on work, an employer or scheme paying for it and a step-up to a degree. Today that points to electrical work with solar skills, health technician diplomas, civil and construction, and data or automation diplomas paired with a real project.',
  },
  {
    q: 'Is a diploma worth it in the age of AI?',
    a: 'It is worth it when most of the work is physical or on site, because desk-only diploma jobs carry more risk. Choose work with tools, sites or patients, and add one skill that checks AI output.',
  },
  {
    q: 'Is a diploma better than a degree for the future?',
    a: 'Neither wins on its own. A diploma starts earning sooner, and a degree keeps more doors open and often raises the ceiling later. The strongest plan is a diploma with lateral entry, or a degree with one trade skill and proof of work.',
  },
  {
    q: 'How do I check if a diploma is approved?',
    a: 'For engineering, look the college up on the AICTE approved-institutions list or ask the state technical board. For health diplomas, ask which council registration the course leads to, in writing. If an institute cannot show approval, walk away.',
  },
  {
    q: 'Can I get a government job after a diploma?',
    a: 'Yes, in some branches. SSC JE posts in civil, mechanical and electrical accept a three-year diploma, though the exact qualification and any experience rule depend on the department, so read the notice. The pay is Level 6 in the 7th pay matrix, and the 2026 notice (2 September 2026) listed about 1,700 posts with applications closing on 22 September 2026. Keep your trade skill running beside the exam, apply only on the official website, and know that no real job asks for money.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  canonical={canonical}
  category="college-degrees"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  salesHref={salesHref}
  salesLabel={salesLabel}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Which diploma course is best for future? None keeps its value by name, but an approved diploma with hands-on work, a named employer or scheme paying for it and a step up to a degree holds best.</strong>
    Right now that points to electrical work with a solar layer, health technician work, civil and construction, and data or automation diplomas backed by real proof.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>Answer:</strong> Pick the diploma whose work needs your hands, your presence or your judgment, and which a named employer or scheme is paying for.</li>
      <li><strong>Filter:</strong> Run the future check: approval, hands-on core, paid demand and a step-up route. A test you cannot answer is a warning.</li>
      <li><strong>Next step:</strong> Name who will pay you, read five live postings and ask for the approval in writing. A trade skill plus proof you can show is a <strong>high-income skill portfolio</strong>, the base for earlier financial freedom.</li>
    </ul>
  </div>

  <p>
    More on picking courses is in our <a href="/blog/college-degrees/">college and course guides</a>. If you want a second opinion on your marks, money and family, <a href="/services/career-counselling-and-career-guidance/career-counselling-after-12th/">career counselling after 12th</a> looks at all three together.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">Which diploma course is best for future? Pick the work, not the name</h2>

  <p>
    People ask this because they fear three wasted years, and the fear is fair: about one in three polytechnic seats stayed empty in 2022-23. A fashionable name will not protect you from that, but four checks can.
  </p>

  <p>
    Our guide on the <a href="/blog/college-degrees/best-diploma-courses-after-12th/">best diploma courses after 12th</a> lists fees and branches in full. The test here is whether a choice will still be worth it in five to ten years.
  </p>

  <h2 id="this-week">Do this week</h2>
  <p>A diploma is three years of your life. These steps test a choice before you pay the first fee.</p>
  <div class="week-box">
    <ol>
      <li><strong>Day 1.</strong> Ask the polytechnic for its approval letter in writing, then check the name on the official AICTE or state technical board list.</li>
      <li><strong>Day 2 and 3.</strong> Name who will pay for the work after the diploma. Read five live postings or notices in your district and write the employer, the pay line and what the post asks for.</li>
      <li><strong>Day 4.</strong> Find the step up. Write which degree entry route the diploma allows, which entrance test it needs and how many of last year's students took it.</li>
      <li><strong>Day 5 to 7.</strong> Visit the workshop or lab and ask to see the equipment students use. Compare two providers with the <a href="https://futurecareerschool.com/tools/course-provider-comparison/">course provider comparison</a>.</li>
    </ol>
    <p class="week-box__note">A fashionable course name is not a reason to join. If the approval or the equipment cannot be shown, keep looking.</p>
  </div>

  <h2 id="future-check">The future check: four tests for any diploma</h2>

  <p>
    Run any diploma through these four tests before you pay, and ask for the approval in writing.
  </p>

  <div class="route-grid">
    {futureChecks.map((item, i) => (
      <div class="route-card">
        <div class="route-card__top"><span class="route-card__n">{String(i + 1).padStart(2, '0')}</span></div>
        <h3>{item.name}</h3>
        <p class="route-row route-row--violet"><span>Ask</span>{item.ask}</p>
        <p class="route-row route-row--teal"><span>Good sign</span>{item.good}</p>
        <p class="route-row route-row--gold"><span>Watch out</span>{item.watch}</p>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">How to score a diploma</p>
    <p>
      Give one point for each test you can answer with a name or a document: an approval letter, a workshop you have seen, an employer or scheme you can name, and a written lateral-entry rule. Four points is a strong bet.
    </p>
    <p>
      Two points or fewer means keep looking. Before you pay, put the college through the <a href="/tools/course-provider-comparison/">free course provider comparison</a>, which lines up recognition, total cost, practical work and outcomes side by side.
    </p>
  </div>

  <h2 id="evidence">What the latest data shows, and what it does not</h2>

  <p>
    Each source is useful and none is complete, so the last column matters as much as the number.
  </p>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Source</th>
          <th>What it shows</th>
          <th>What it does not show</th>
        </tr>
      </thead>
      <tbody>
        {evidenceRows.map((row) => (
          <tr>
            <td data-label="Source"><strong>{row.signal}</strong></td>
            <td data-label="What it shows">{row.shows}</td>
            <td data-label="What it does not show">{row.notShow}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Sources, checked on 16 and 17 November 2026: <a href="https://news.careers360.com/polytechnic-courses-diploma-engineering-colleges-crisis-aicte-autonomy-vacant-seats-teacher-low-poly-admission-jobs-10th-12th" rel="noopener">Careers360 on polytechnic seats</a>, <a href="https://news.careers360.com/maharashtra-polytechnic-diploma-admissions-2025-record-intake-93-percent-deadline-extended-ai-data-science-courses" rel="noopener">Careers360 on Maharashtra admissions</a>, <a href="https://news.careers360.com/ncahp-new-rules-allied-health-sciences-paramedical-healthcare-courses-council-registration-medical-training-physiotherapy-nmc-ahp" rel="noopener">Careers360 on the NCAHP rules</a>, <a href="https://narendramodi.in/cabinet-approves-pm-surya-ghar-muft-bijli-yojana-for-installing-rooftop-solar-in-one-crore-households" rel="noopener">the cabinet approval of PM Surya Ghar</a>, <a href="https://newsonair.gov.in/indias-solar-capacity-rises-to-nearly-165-gw-as-pm-surya-ghar-empowers-over-51-lakh-families/" rel="noopener">All India Radio News on PM Surya Ghar</a> and <a href="https://www.theweek.in/news/jobs-and-career/2025/01/11/big-data-ai-machine-learning-india-fastest-growing-jobs-wef-report.html" rel="noopener">The Week on the WEF report</a>. Numbers change, so check again before you decide.
  </p>

  <h2 id="families">Six diploma families, strongest scalability first</h2>

  <p>
    Two questions decide a family: will the work still exist, and can your income grow past a fixed pay ladder? The future check answers the first, and the label on each card answers the second. We put the strongest room to grow first, so allied health sits low even though its demand is steady.
  </p>

  <div class="route-grid">
    {families.map((item, i) => (
      <div class="route-card">
        <div class="route-card__top">
          <span class="route-card__n">{String(i + 1).padStart(2, '0')}</span>
          <span class={`scale-chip scale-chip--${item.scale}`}>{item.scaleLabel}</span>
        </div>
        <h3>{item.name}</h3>
        <p class="route-row route-row--scale"><span>Why this rating</span>{item.why}</p>
        <p class="route-row route-row--teal"><span>Why it holds</span>{item.holds}</p>
        <p class="route-row route-row--gold"><span>Watch out</span>{item.watch}</p>
        <p class="route-row route-row--violet"><span>Add this</span>{item.add}</p>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take: the path that scales</p>
    <p>
      Pay in a diploma job rises one step at a time, and your employer sets each step. Owning a small service breaks that limit, because you set the price and can hire help. Examples are rooftop solar installation with yearly servicing, a wiring and repair service for housing societies, or costing work for small builders.
    </p>
    <p>
      Build it beside a job first. You need the trade skill, a licence where your state asks for one, a written scope and deposit for every job, and a steady way to find clients. Check current GST and Udyam rules on the official portals before you send your first invoice.
    </p>
    <p>
      A trade skill, proof of work and a way to sell it make a high-income skill portfolio, which is the base for earlier financial freedom.
    </p>
  </div>

  <h2 id="by-person">The better bet, person by person</h2>

  <div class="strand-grid">
    {personCards.map((card) => (
      <div class="strand-card">
        <div class="strand-card__name">{card.name}</div>
        <p>{card.body}</p>
        <div class="strand-card__watch"><span>Watch out</span>{card.watch}</div>
      </div>
    ))}
  </div>

  <h2 id="step-up">The step-up that keeps a diploma alive</h2>

  <p>
    A diploma is strongest as the first rung. Diploma holders can often enter the second year of a B.Tech through lateral entry, which usually needs a matching branch and minimum marks, so check the rules in your first year.
  </p>

  <p>
    The entry is normally through a state test. In Andhra Pradesh that test is AP ECET, and other states run their own, so read the current notice on the official site.
  </p>

  <p>
    If three years feels too long, an ITI trade with an apprenticeship is usually shorter.
  </p>

  <h2 id="who-pays">Who pays for diploma-based work, and how they judge you</h2>

  <p>
    Employers pay for a person who can do the job safely on day one: a factory for a machine fixed, a power or solar company for a clean installation, a hospital for a correct test, a builder for a site on schedule. Families and small businesses pay when you solve a problem they can see, such as a working solar line or a repaired panel. For a government post the payer is the selecting body, which checks exam rank, so selling skills matter mainly for your side route.
  </p>

  <p>
    They check the approval, a short trade test, photos or a log of real work, and one referee. The first sales skill is to say in one sentence what you fix, for whom, with one before-and-after example. Ask each happy client for one referral, and watch one number: how many enquiries become paid jobs.
  </p>

  <h2 id="pay">Pay and the real ceiling</h2>

  <div class="highlight-box highlight-box--teal">
    <p>
      <strong>Pay in India:</strong> <a href="https://ambitionbox.com/profile/diploma-trainee-engineer-salary" rel="noopener">AmbitionBox</a> shows diploma trainee engineers earning Rs 1.3 to 3.3 lakh a year in their first three years, with an average starting pay near Rs 1.3 lakh, based on about 19,700 salaries (page updated March 2025, checked on 16 November 2026). A government Junior Engineer post sits at Level 6 of the 7th pay matrix, with basic pay of Rs 35,400 to Rs 1,12,400 a month (<a href="https://career.aglasem.com/ssc/ssc-je" rel="noopener">AglaSem</a>, checked on 17 November 2026). Pay varies by city, employer and skill, so check current postings.
    </p>
  </div>

  <p>
    The private figure is a starting range, not a promise. The government figure is the pay band of the post, not what a first-year person takes home.
  </p>

  <p>
    A government seat is also a competitive exam, and promotion later is a second filter. Keep your trade skill and a few finished jobs running beside the exam, so an unsuccessful attempt costs you little.
  </p>

  <h2 id="ai">What AI changes for diploma jobs</h2>

  <p>
    A Cognizant and Pearson survey of 750 HR leaders in the US, UK and India, reported by <a href="https://www.deccanchronicle.com/nation/ai-takes-on-more-than-a-third-of-entry-level-work-in-india-new-study-shows-1964456" rel="noopener">Deccan Chronicle</a> in June 2026, found AI already does about 37% of entry-level tasks in India. Of the leaders, 96% expect entry roles to become jobs that supervise AI within five years. For a diploma holder, the work that stays is the work done in a place: on a site, in a lab or at a machine.
  </p>

  <div class="ladder">
    <div class="ladder-step">
      <div class="ladder-step__num">01</div>
      <div>
        <div class="ladder-step__title">Now: use AI as a tutor and a checker</div>
        <p>Ask it to explain a circuit, a test result or a drawing, then confirm the answer with your teacher or a standard.</p>
      </div>
    </div>
    <div class="ladder-step">
      <div class="ladder-step__num">02</div>
      <div>
        <div class="ladder-step__title">Next: put AI inside one real task</div>
        <p>Draft job reports, estimates or maintenance logs with AI help, then correct them yourself.</p>
      </div>
    </div>
    <div class="ladder-step">
      <div class="ladder-step__num">03</div>
      <div>
        <div class="ladder-step__title">Later: own the decision a tool cannot sign</div>
        <p>Move toward safety sign-off, fault diagnosis, supervising a team or running your own service. No path is guaranteed, and the risk is lowest where a person must be present.</p>
      </div>
    </div>
  </div>

  <h2 id="checkpoint">Check before you commit</h2>

  <p>
    Run the <strong>four questions</strong> first, then pass the <strong>three proofs</strong>: the questions test whether this diploma suits you, and the proofs show you can earn from it.
  </p>

  <div class="protocol">
    <div class="protocol-row">
      <div class="protocol-row__num">01</div>
      <div>
        <div class="protocol-row__title">Your fit: could you do this work on an ordinary Tuesday?</div>
        <p>Site work means heat and early starts, lab work means precision and shifts, and a machine shop means noise and safety rules. Visit a workshop, ward or site before you pay.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">02</div>
      <div>
        <div class="protocol-row__title">Your situation: can your life carry three years of this?</div>
        <p>Count the fee, travel, hostel and the earnings you give up. If money is tight, start with a government polytechnic.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">03</div>
      <div>
        <div class="protocol-row__title">Job market: who is hiring this diploma near you?</div>
        <p>Find five postings for the exact role in your city and note the employer, the qualification asked and the starting pay. If you cannot find five, demand may be thinner than the headline.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">04</div>
      <div>
        <div class="protocol-row__title">AI-proof: which part of the job needs you in the room?</div>
        <p>List the tasks software can draft, then the ones that need your hands, eyes or sign-off. More of the second list means a stronger bet.</p>
      </div>
    </div>
  </div>

  <div class="gates-block">
    <div class="gates-row">
      <div class="gate">
        <span class="gate__num">Proof 1</span>
        <span class="gate__name">Show it</span>
        <p>One real job you completed, such as a wired board, a lab result you explained or a site drawing you measured, with photos and a short note.</p>
      </div>
      <div class="gate">
        <span class="gate__num">Proof 2</span>
        <span class="gate__name">Say it</span>
        <p>Explain what you did and why in 30 seconds to 2 minutes, with no notes, in the language your customers speak.</p>
      </div>
      <div class="gate">
        <span class="gate__num">Proof 3</span>
        <span class="gate__name">Get it checked</span>
        <p>Show the work to a supervisor, a trainer or a client who would pay for it, and write down what they say was missing.</p>
      </div>
    </div>
  </div>

  <h2 id="money">Money check before you pay</h2>

  <p>
    Our strongest suggestion: keep a course or degree fee near a tenth of the family education budget, and treat spending above roughly a fifth as a caution that needs course-specific evidence. This does not apply to free or very cheap online courses, which need little budget care, and the same material sold as a university certificate can cost 30 to 100 times more.
  </p>

  <p>
    An illustration, not a real fee: on a Rs 3 lakh education budget, a tenth is Rs 30,000 and a fifth is Rs 60,000. Add up three years of fees, hostel and travel before you compare, and keep the rest for tools, workshop practice and a reserve. General information, not financial advice; get any loan terms in writing.
  </p>

  <p>
    Try free YouTube lessons first, and pay only for what they cannot give: workshops, supervised practice, a recognised approval and feedback on real work. Free lessons cannot replace an approval or council registration where the job needs one, so judge each course on its syllabus, workshop hours, refund terms and the outcomes of its last three batches.
  </p>

