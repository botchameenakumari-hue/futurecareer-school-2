const publishedDateISO = '2026-09-27';
const publishedDateLabel = '27 Sep 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'two-questions', label: 'The two searches hiding inside this one keyword' },
  { id: 'degree-path', label: 'Choosing your undergraduate path into CSE' },
  { id: 'entrance-exams', label: 'JEE, state CETs, and CUET: what actually gets you in' },
  { id: 'degree-fit', label: 'Which degree fits which student' },
  { id: 'already-enrolled', label: 'Already doing a CS/CSE degree? This is the real question' },
  { id: 'dsa', label: 'Course 1: Data structures and algorithms' },
  { id: 'system-design', label: 'Course 2: System design' },
  { id: 'cloud', label: 'Course 3: Cloud (AWS or Azure)' },
  { id: 'language-cs-fundamentals', label: 'Course 4: One language, deeply, plus real CS fundamentals' },
  { id: 'ai-ml', label: 'Course 5: AI and machine learning basics' },
  { id: 'higher-studies', label: 'Course 6: GATE and NPTEL, if you want a PSU or MTech route' },
  { id: 'stack-table', label: 'The full stack at a glance' },
  { id: 'how-to-pick', label: 'How to actually pick a course without wasting money' },
  { id: 'proof', label: 'A certificate is not proof. This is' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you commit' },
  { id: 'mistakes', label: 'Mistakes that quietly waste a CS degree' },
  { id: 'faq', label: 'FAQs' },
  { id: 'next-step', label: 'What to do next' },
];

const degreeRows = [
  {
    course: 'B.Tech / B.E. in CSE',
    duration: '4 years',
    entry: 'JEE Main (NITs/IIITs/GFTIs via JoSAA), JEE Advanced (IITs), or a state CET (MHT-CET, WBJEE, KCET, and others) for state colleges; BITSAT for BITS campuses',
    reality: 'The widest, most recognised route. Curriculum leans theory-heavy and often runs a year or two behind current industry tools, so the degree alone rarely produces a hireable profile without add-on skill-building.',
  },
  {
    course: 'BCA (Bachelor of Computer Applications)',
    duration: '3 years (a 4-year BCA(Hons) version exists at some universities)',
    entry: 'Mostly merit-based on Class 12 marks; a handful of universities run their own computer-aptitude entrance test',
    reality: 'Cheaper and faster than B.Tech, more applied and less math-heavy. Works well for software and web-development roles, but core-engineering and PSU doors that require a B.Tech/B.E. stay closed.',
  },
  {
    course: 'B.Sc Computer Science / B.Sc IT',
    duration: '3 years (4-year honours version at some universities under NEP)',
    entry: 'Merit-based at most state and private universities; CUET UG for many central universities',
    reality: 'Lighter fee, science-stream flavour with some pure-math and statistics depth. Recognised for higher study (MSc, MCA) and product-company hiring, but the brand pull is weaker than a B.Tech at most colleges.',
  },
  {
    course: '5-year integrated M.Tech / M.Sc in CS',
    duration: '5 years, one continuous programme',
    entry: 'JEE-based or institute-specific entrance depending on the university (some IITs and central universities run integrated CS programmes)',
    reality: 'Saves a year versus doing B.Tech then a separate master\'s, and often gives deeper research exposure. Locks you into one institute for five years before you know your actual interests inside CS.',
  },
];

const stackCards = [
  {
    num: '01',
    badge: 'Do this first, no exceptions',
    title: 'Data structures and algorithms (DSA)',
    body:
      'This is the one skill every hiring loop in software still tests, from a service company to a product company to a startup. It is also the fastest way to turn "I have a CS degree" into "I can actually solve a problem I have not seen before."',
    fitText: 'Every CS/CSE student, from first year onward — this is not optional the way a certificate is.',
    watchText: 'Watching solutions without writing your own code first teaches pattern recognition of the wrong kind.',
    tags: ['Free, high-quality routes exist', 'Tests logic, not memorisation', 'Non-negotiable for interviews'],
  },
  {
    num: '02',
    badge: 'The gap that separates juniors from seniors',
    title: 'System design',
    body:
      'DSA gets you through the first interview round. System design is what separates a junior developer from someone trusted to design how an actual product holds up under real traffic, failure, and scale — and it is asked from the SDE-2 level onward at most product companies.',
