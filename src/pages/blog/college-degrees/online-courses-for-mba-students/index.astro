const signalRows = [
  {
    signal: 'Curriculum currency',
    weak: 'Syllabus reads the same as a version posted three years ago; no named tools, only "industry best practices"',
    strong: 'Named current tools and workflows (e.g. specific Excel/Power BI functions, a named AI-assisted workflow) and a visible last-updated date',
  },
  {
    signal: 'Instructor proof',
    weak: '"Industry veteran" with no name, no LinkedIn, no independently checkable project history',
    strong: 'Named faculty or practitioner with a searchable, current work history outside the course platform',
  },
  {
    signal: 'Outcome claims',
    weak: 'A single "95% got a raise/promotion" line with no sample size or year attached',
    strong: 'A stated sample size, a named cohort year, and a split between assisted outcomes and independently verified ones',
  },
  {
    signal: 'What you actually build',
    weak: 'Only quizzes and multiple-choice assessments; nothing you could show an interviewer',
    strong: 'A capstone project, model, dashboard, or campaign you can walk someone through afterward',
  },
  {
    signal: 'Recognition where it counts',
    weak: 'A credential your target industry has never mentioned in a single job posting you have checked',
    strong: 'A credential that shows up by name in real job postings or is issued by a body (CFA Institute, PMI, Google, ASQ/IASSC) your target employers already recognise',
