];

const mistakeRows = [
  {
    num: '01',
    title: 'Collecting five unrelated certificates instead of going deep on one',
    body: 'A resume with a CFA Level 1 attempt, a random digital marketing badge, a Six Sigma certificate, and a data science certificate — with no project behind any of them — reads as indecision, not versatility.',
  },
  {
    num: '02',
    title: 'Choosing a course by brand name instead of by the specific syllabus',
    body: 'A "Coursera course" or "edX course" is not one thing. The specific instructor, syllabus, and capstone decide the value — not the platform logo on your LinkedIn.',
  },
  {
    num: '03',
    title: 'Starting CFA Level 1 without checking the real pass-rate and time cost',
    body: 'CFA Level 1 pass rates typically run in the 35-45% range and each level asks for roughly 300 hours of study. Starting it as a side project during a demanding MBA term, with no plan for the following two levels, often ends in a half-finished credential that adds little.',
  },
  {
    num: '04',
    title: 'Treating a certificate as the finish line instead of the starting line',
    body: 'The certificate gets you a line on a resume. The project, model, campaign, or dashboard you built while earning it is what actually gets discussed in an interview.',
