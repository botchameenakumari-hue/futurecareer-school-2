const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'why-mba-not-enough', label: 'Why the MBA alone often falls short' },
  { id: 'audit-first', label: 'Run the course audit before you enroll in anything' },
  { id: 'finance', label: 'Finance MBA: what to actually add' },
  { id: 'marketing', label: 'Marketing MBA: what to actually add' },
  { id: 'operations', label: 'Operations and supply chain: what to actually add' },
