const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'why-one-number-misleads', label: 'Why one MBA salary number misleads you' },
  { id: 'the-curve', label: 'The real curve: 0 to 15 years after an MBA' },
  { id: 'tier-by-tier', label: 'Tier by tier: how the curve actually splits' },
  { id: 'does-premium-hold', label: 'Does the MBA premium hold up 10-15 years out?' },
