const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Where can I start with AI as a student?",
    "With data basics, Python and statistics through free lessons."
  ],
  [
    "Do I need strong maths?",
    "Basic statistics and algebra help. Depth depends on the path."
  ],
  [
    "Can high school students learn AI?",
    "Yes, with data activities and no-code tools."
  ],
  [
    "Are free courses enough?",
    "They can be, with projects and review."
  ],
  [
    "Which language first?",
    "Python is common. Check what your course uses."
  ],
  [
    "How do I show skill?",
    "Share a project with limits stated."
  ],
  [
    "Is it okay to use AI for homework?",
    "Follow your institution policy and be honest."
  ],
  [
    "Will AI replace engineers?",
    "Routine tasks shrink. Judgment remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
