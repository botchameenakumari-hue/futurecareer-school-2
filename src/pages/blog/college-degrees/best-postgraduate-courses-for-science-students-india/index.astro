const checkpointItems = [
  {
    num: '01',
    title: 'Work style',
    body: 'Do you want the slow, deep, deliverable-light rhythm of a PhD, the exam-and-cohort structure of an MBA, the numbers-under-pressure grind of actuarial exams, or the faster, project-based rhythm of a certification? Each of these demands a genuinely different daily reality for years, not months.',
    note: 'A route with a great ceiling that fights how you actually like to work will not survive the years it needs from you.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can your family fund 2-6 years of low or no income for a PhD or actuarial qualification, or do you need real income inside a year? A CSIR-NET JRF or PMRF stipend removes most of that pressure for the PhD route specifically; most other academic routes do not.',
    note: 'The safer plan is the one your household can actually fund end to end, not the one with the most prestigious name.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Is there real, current hiring or fellowship data for this exact route, not a relative\'s decade-old success story? CSIR-NET cut-offs, GATE PSU intake, and current placement reports from your target institute are all checkable right now, before you commit.',
    note: 'Look at this cycle\'s actual cut-off or placement report before locking in a plan.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'Will this route still need you once AI tools get better at the routine parts of the work? Routine lab data entry, first-draft literature reviews, and basic report generation are already being automated in research settings. Original experimental design, regulatory judgment, and exam-tested actuarial reasoning are not.',
    note: 'Choose the version of the route where you end up owning an original result or a judgment call, not just producing a first draft.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Attempt one past CSIR-NET, GATE, JEST, or ACET paper under real time pressure, or build one small project in your target certification field, before committing years or fees to it.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'Explain in under two minutes why this specific route fits your subject background and your family\'s financial runway, not why it sounds impressive at a family function.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of value',
    body: 'Show your mock attempt or small project to someone already on that exact path, a PhD scholar two years in, a working actuary, or a data scientist, and ask what is genuinely missing before you commit.',
