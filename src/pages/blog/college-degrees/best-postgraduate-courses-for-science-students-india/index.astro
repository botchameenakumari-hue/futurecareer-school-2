  },
  {
    label: 'If you want industry or applied work',
    title: 'GATE Physics into an interdisciplinary M.Tech, or a data science pivot',
    body: 'A handful of IITs run M.Tech programs in applied optics, instrumentation, or materials science that accept MSc Physics graduates through GATE. If that seat does not come through, a Physics background in probability and modelling transfers cleanly into data science or quant-adjacent roles.',
  },
];

const chemistryCards = [
  {
    label: 'If you want research',
    title: 'MSc Chemistry, then CSIR-NET JRF in Chemical Sciences',
    body: 'This is the most direct route into a funded PhD at a CSIR lab, an IIT, or a university chemistry department, with the same Rs 37,000-42,000/month JRF/SRF stipend structure as the other CSIR-NET streams.',
  },
  {
    label: 'If you want industry',
    title: 'Pharma, regulatory affairs, or clinical research',
    body: 'A Chemistry postgraduate is a genuinely strong fit for regulatory affairs and quality roles in pharma and specialty chemicals, where a short regulatory affairs certification (RAC-style, or training in FDA/EMA/ICH guidelines) on top of the MSc is often worth more than a second academic degree.',
