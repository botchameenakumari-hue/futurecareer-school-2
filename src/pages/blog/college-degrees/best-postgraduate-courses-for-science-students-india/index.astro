];

const mistakeItems = [
  {
    num: '01',
    title: 'Assuming MSc is the only postgraduate option after a science degree',
    body: 'MSc is one route among at least seven genuinely different ones: M.Tech (for select subjects via GATE), PhD, MBA, actuarial science, data science, and industry certifications. Picking MSc by default because it is the familiar option, without comparing it to the others, is the single most common wasted year on this list.',
  },
  {
    num: '02',
    title: 'Starting a PhD without a funded fellowship lined up',
    body: 'A CSIR-NET JRF, GATE-linked assistantship, or PMRF removes most of the financial risk from a 4-6 year PhD. Starting one without any of these, on a departmental stipend alone, is a real financial strain most families underestimate going in.',
  },
  {
    num: '03',
    title: 'Treating GATE as engineering-only and skipping it as a science graduate',
    body: 'GATE runs papers in Physics, Chemistry, Mathematics, and Life Sciences specifically for MSc holders, not only engineering branches. Skipping GATE because it "sounds like an engineering exam" closes off a real M.Tech and PSU pathway that most science graduates never even check.',
  },
  {
    num: '04',
    title: 'Chasing an MBA without checking whether the institute tier actually pays off',
