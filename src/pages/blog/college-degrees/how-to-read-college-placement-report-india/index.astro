  { id: 'signal-1', label: 'Signal 1: Median vs average vs highest' },
  { id: 'signal-2', label: 'Signal 2: The denominator trick' },
  { id: 'signal-3', label: 'Signal 3: Package vs offer vs joining' },
  { id: 'signal-4', label: 'Signal 4: CTC vs in-hand' },
  { id: 'signal-5', label: 'Signal 5: The "100%" claim' },
  { id: 'signal-6', label: 'Signal 6: Branch and year spread' },
  { id: 'signal-7', label: 'Signal 7: Who verifies the number' },
  { id: 'red-flags', label: 'Red flags that mean the report is not trustworthy' },
