const canonical = "https://futurecareerschool.com/blog/college-degrees/job-oriented-courses-for-eee-and-electrical-engineering-students-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which courses help EEE students get jobs?",
    "Courses in automation, embedded systems, power systems, EV basics and data tools, chosen by target roles."
  ],
  [
    "Do I need paid certificates?",
    "Not always. Free lessons and projects often help first."
  ],
  [
    "Which is best for freshers?",
    "Read notices. PLC and embedded basics appear often."
  ],
  [
    "How long should I study?",
    "About five hours a week for twelve weeks is a start."
  ],
  [
    "Do online courses help?",
    "They help if you finish a project."
  ],
  [
    "Is coding needed?",
    "Basic programming helps in many roles."
  ],
  [
    "Is safety training important?",
    "Yes. Learn and follow it."
  ],
  [
    "Will AI change EEE jobs?",
    "Routine drafting shrinks. Safety and judgment remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
