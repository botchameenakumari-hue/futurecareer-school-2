];

const stackingRows = [
  {
    base: 'MA Economics or MA Public Policy',
    multiplier: 'Data visualisation and one statistical tool (R, Python, or advanced Excel)',
    why: 'Turns a pure research or theory profile into someone consulting firms and think tanks can actually deploy on live data, which is where the higher-paying roles sit.',
  },
  {
    base: '3-year LLB',
    multiplier: 'CLAT-PG and an LLM in a specific domain (IP, tax, or tech law)',
    why: 'A generalist LLB caps out faster than a specialised LLM. The specialisation, not the degree alone, is what firms pay a premium for.',
  },
  {
    base: 'PG Diploma in Journalism and Mass Communication',
    multiplier: 'One demonstrated digital or social-strategy skill, SEO, analytics reading, or short-form video editing',
    why: 'Newsroom hiring has shrunk while digital and brand-newsroom hiring has grown. The pivot skill is what keeps the journalism training relevant to where the jobs actually are now.',
