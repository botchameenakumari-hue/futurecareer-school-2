];

const mistakeItems = [
  {
    num: '01',
    title: 'Assuming BA only leads to UPSC prep or teaching',
    body: 'MBA, law, public policy, data analytics, and UX design all take a BA graduate directly, several without needing a specific undergraduate subject at all. Treating BA as a dead end before checking these routes wastes years that could have gone into building one of them.',
  },
  {
    num: '02',
    title: 'Chasing a prestige MA without checking placement reality outside the top 3 colleges',
