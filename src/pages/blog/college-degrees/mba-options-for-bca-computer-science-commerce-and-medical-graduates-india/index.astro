      color: #e5b84a;
      margin-bottom: 0.15rem;
    }

    .route-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }
    .route-card {
      border-radius: 16px;
      padding: 1.2rem 1.15rem 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-top: 3px solid #2dd4bf;
      background: rgba(255, 255, 255, 0.03);
