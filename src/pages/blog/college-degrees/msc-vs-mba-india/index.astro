];

const pivotSignals = [
  'Your real interest was always in how the science gets funded, sold, or scaled, not in generating the finding itself.',
  'You want a faster, more predictable income timeline than a multi-year PhD stipend allows.',
  'You are drawn to leading teams, making resourcing calls, or owning outcomes across functions rather than owning one narrow technical question.',
  'You have already tested management-adjacent work — a lab-to-market project, a college fest, a part-time analyst stint — and it energised you more than the lab bench did.',
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating "MSc vs MBA" as a prestige ranking instead of a fit question',
    body: 'Neither degree is objectively better. An MSc is not a consolation prize for people who could not get into a B-school, and an MBA is not an admission that the science did not work out. They train for genuinely different jobs.',
