const wastedRows = [
  {
    background: 'Chemistry or biology background',
    reality:
      'Not wasted — it becomes a real advantage in pharma, healthcare, agritech, or FMCG management, where MBAs who actually understand the underlying science are rare and get pulled into product, regulatory-strategy, or business-development roles that pure-commerce MBAs cannot credibly do.',
