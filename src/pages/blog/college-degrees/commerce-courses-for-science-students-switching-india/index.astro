        <tr>
          <td data-label="Option"><strong>BCom</strong></td>
          <td data-label="Why science students fit">Numeracy helps accounting and statistics</td>
          <td data-label="Check">College syllabus</td>
        </tr>
        <tr>
          <td data-label="Option"><strong>BBA</strong></td>
          <td data-label="Why science students fit">Analytical thinking helps</td>
          <td data-label="Check">Entrance routes</td>
        </tr>
        <tr>
          <td data-label="Option"><strong>Professional foundation exams</strong></td>
          <td data-label="Why science students fit">Logic and discipline</td>
          <td data-label="Check">Official eligibility</td>
        </tr>
        <tr>
