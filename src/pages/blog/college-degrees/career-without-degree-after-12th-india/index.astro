---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career without a degree after 12th India: 15 paths across tech, trades, and government exams';
const description =
  'A career without degree after 12th India is realistic in tech, trades, sales, and government roles — if you pick proof over hope. Real salary data, ITI to CS routes, and the honest trade-offs.';
const canonical =
  'https://futurecareerschool.com/blog/college-degrees/career-without-degree-after-12th-india';
const publishedDateISO = '2026-07-04';
const publishedDateLabel = '4 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'answer', label: 'The direct answer' },
  { id: 'reality-check', label: 'The reality check before you decide' },
  { id: 'paths', label: '15 real paths without a degree' },
  { id: 'tech', label: 'Tech and digital skill routes' },
  { id: 'trades', label: 'ITI, diploma, and technical trades' },
  { id: 'exams', label: 'Government and defence routes (no degree needed)' },
  { id: 'professional', label: 'Professional courses that start after 12th, not after a degree' },
  { id: 'business', label: 'Sales, freelancing, and business routes' },
  { id: 'salary-table', label: 'Salary reality across all 14 paths' },
  { id: 'degree-myth', label: 'The degree-only myth vs the degree-optional truth' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you skip college' },
  { id: 'gates', label: 'The 3 Gates before you are deep into it' },
  { id: 'parents', label: 'How to have this conversation with your parents' },
  { id: 'mistakes', label: 'Mistakes that turn "no degree" into "no income"' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const pathCards = [
  {
    tag: 'Tech',
    title: 'Full-stack or front-end web development',
    body: 'A 4-9 month bootcamp plus 3-5 deployed projects on GitHub is what gets non-CS candidates hired at ₹4-8 LPA in Indian product companies and startups. The portfolio and the deployed link matter more than the certificate.',
    fit: 'Fit: comfortable with logical, detail-heavy, screen-based work and steady daily practice.',
    caution: 'Watch out: a certificate with zero shipped project gets filtered out before the interview stage.',
  },
  {
    tag: 'Tech',
    title: 'UI/UX and product design',
    body: 'Hiring managers at Indian product companies say portfolio quality is the only credential that matters for design roles. Freshers with 3+ real case studies land ₹4-8 LPA; self-taught designers get hired at the same rate as design-degree holders.',
    fit: 'Fit: visual thinking, patience with feedback loops and revisions.',
    caution: 'Watch out: a portfolio of only concept mockups with no real client or dummy-brief problem behind it reads as thin.',
  },
  {
    tag: 'Digital',
    title: 'Digital marketing and performance marketing',
    body: 'A 4-7 month certificate costing roughly ₹10,000-1,00,000 gets freshers into ₹2.5-5 LPA entry roles; social-media-specific entry roles often start lower, around ₹15,000-25,000 a month. Stream does not matter here — practical skill in ads, SEO, and analytics does.',
    fit: 'Fit: comfortable testing, measuring, and adjusting instead of one "perfect" plan.',
    caution: 'Watch out: agencies pay less than in-house brand roles for the same work; ask about the actual budget you will manage before accepting an offer.',
  },
  {
    tag: 'Trades',
    title: 'ITI trades: electrician, fitter, COPA',
    body: 'ITI courses run 6 months to 2 years and cost ₹15,000-46,000. Electricians start around ₹15,000-25,000 a month and can reach ₹40,000+ with experience; government-sector ITI electrician roles (Railways, BHEL) often start higher, near ₹25,000+.',
    fit: 'Fit: hands-on work, comfortable with tools, machinery, or wiring rather than a screen all day.',
    caution: 'Watch out: pick the ITI trade by current demand in your state (electrician, wireman, and COPA rank highest), not by which one has the shortest waitlist.',
  },
  {
    tag: 'Trades',
    title: 'Polytechnic diploma (engineering)',
    body: 'A 3-year polytechnic diploma after 12th (or after 10th in some states) leads to junior engineer, site supervisor, or technician roles, and most polytechnic boards allow lateral entry into the second year of a B.Tech later if you change your mind.',
    fit: 'Fit: wants technical depth and a lateral-entry bridge back to a degree kept open.',
    caution: 'Watch out: verify the lateral-entry rule with your specific state board before assuming it applies everywhere.',
  },
  {
    tag: 'Government',
    title: 'SSC, state police, and central armed forces',
    body: 'SSC CHSL, SSC MTS, SSC GD Constable, RRB NTPC lower posts, state police constable, and India Post GDS are all open to 12th-pass candidates with no graduation requirement. 2026 saw large fresh vacancy drives across most of these categories.',
    fit: 'Fit: comfortable with a fixed, structured exam-prep timeline and stable government-service work culture.',
    caution: 'Watch out: exam competition is intense because so many candidates target the same posts; a narrow, disciplined prep plan beats spreading yourself across five exams at once.',
  },
  {
    tag: 'Government',
    title: 'NDA and Agniveer (defence)',
    body: 'NDA is a direct-entry officer route after 12th with PCM for boys aged roughly 16.5-19.5, with trained officers earning ₹70,000-90,000 a month post-training with allowances. Agniveer is a 4-year contract; only about 25% get absorbed into permanent service, the rest exit with a lump-sum package and preference in police/PSU recruitment.',
    fit: 'Fit: wants discipline-heavy structured service life and can meet the physical and medical standards.',
    caution: 'Watch out: Agniveer is not a permanent job by design — plan your post-4-year path before you sign up, not after.',
  },
  {
    tag: 'Professional',
    title: 'Company Secretary (CS)',
    body: 'CS has no degree requirement to start. You register for CSEET straight after 12th in any stream except Fine Arts, then clear the Executive and Professional levels plus 21 months of practical training — roughly 3-5 years total, similar timeline to a degree but ending in a professional qualification instead.',
    fit: 'Fit: steady with long study timelines, comfortable with law, compliance, and corporate governance content.',
    caution: 'Watch out: this is a serious multi-year commitment, not a shortcut — treat it with the same planning rigor as choosing a degree.',
  },
  {
    tag: 'Trades',
    title: 'Paramedical and allied health diplomas',
    body: 'DMLT, OT technician, and similar allied-health diplomas run 1-2 years after 12th PCB and lead directly to hospital, lab, and diagnostics-sector jobs without a full nursing or medical degree.',
    fit: 'Fit: interested in healthcare work but not committed to the years-long MBBS or nursing-degree track.',
    caution: 'Watch out: confirm the diploma is recognised by your state paramedical council before enrolling — unrecognised diplomas create licensing problems later.',
  },
  {
    tag: 'Business',
    title: 'Freelancing (writing, design, dev, marketing, video editing)',
    body: 'India already has 15 million+ registered freelancers, among the largest freelance bases in the world, with average annual freelance incomes reported around ₹20 lakh and roughly 23% crossing ₹40 lakh — though these figures skew toward experienced freelancers with strong niches, not day-one earners.',
    fit: 'Fit: comfortable with inconsistent early income while you build a client base and a proof-of-work portfolio.',
    caution: 'Watch out: the first 6-12 months are usually the leanest; have a runway plan, not just a skill, before going fully independent.',
  },
  {
    tag: 'Business',
    title: 'Sales and business development',
    body: 'Entry-level sales and BD roles hire on communication, follow-up discipline, and comfort with rejection more than degree pedigree. Strong performers move into account management, revenue operations, or customer success within 2-3 years, often outpacing peers who chose "safer" desk roles.',
    fit: 'Fit: resilient to rejection, genuinely likes talking to people and solving their problems.',
    caution: 'Watch out: pure commission-only roles with no fixed base carry real income risk in year one — read the compensation structure carefully before joining.',
  },
  {
    tag: 'Business',
    title: 'Content creation and creator economy',
    body: 'Realistic income is small until an audience compounds: under 10,000 subscribers typically earns ₹500-2,000 a month from ads; 10,000-50,000 subscribers can reach ₹3,000-15,000; only the 50,000-2,00,000+ tier starts approaching a stable income, mostly from brand deals rather than ad revenue.',
    fit: 'Fit: can sustain months of low or no income while building consistency and a real niche.',
    caution: 'Watch out: this is the highest-glamour, lowest-guarantee path on this list — treat it as a side build until the income is proven, not as a first full-time bet.',
  },
  {
    tag: 'Trades',
    title: 'Hospitality and hotel operations',
    body: 'Diploma and certificate routes into front office, food and beverage, and hotel operations start after 12th with no degree requirement, and can lead into revenue management, events, or corporate training roles within a few years for strong performers.',
    fit: 'Fit: comfortable with shift work, guest-facing pressure, and service-recovery situations.',
    caution: 'Watch out: entry pay is modest and weekend/shift work is standard — compare the real schedule against the brochure photos before committing.',
  },
  {
    tag: 'Trades',
    title: 'Apprenticeship under NAPS (earn while you learn)',
    body: 'The National Apprenticeship Promotion Scheme places 12th-pass candidates into paid, on-the-job apprenticeships with manufacturing, auto, retail, banking, and hospitality employers, usually 6-12 months, with a monthly stipend of roughly ₹9,000-15,000 and a real shot at conversion to a full-time role with the same employer.',
    fit: 'Fit: wants a structured employer-led route into a specific industry without paying course fees upfront.',
    caution: 'Watch out: not every apprenticeship converts to a permanent job — check the employer\'s actual conversion rate from past batches before assuming this one will.',
  },
  {
    tag: 'Tech',
    title: 'Data analytics and business intelligence (skill-first entry)',
    body: 'Short, practical certificate tracks in Excel, SQL, and Power BI are increasingly accepted for junior analyst and reporting roles when paired with 2-3 real dashboards or case studies, even without a formal analytics or statistics degree.',
    fit: 'Fit: likes finding patterns in numbers and explaining what they mean in plain language.',
    caution: 'Watch out: a certificate with no real dataset worked on is indistinguishable from a hundred other identical certificates — build with real or public data, not just course exercises.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Discipline',
    body: 'Can you actually sustain months of self-directed, unsupervised learning without the structure a campus and semester calendar normally provides? Skill-first and freelance routes demand more self-discipline per week than a degree timetable does, not less.',
    note: 'If you know you need external structure to stay consistent, pick a route with a fixed cohort, bootcamp schedule, or exam calendar rather than a fully self-paced one.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'What can your family actually fund and for how long? A ₹60,000-3 lakh bootcamp plus 6-12 months of no income is a very different bet from a ₹15,000 ITI course that starts placement drives within a year.',
    note: 'Write the real number down with your family, not the number that feels least awkward to say out loud.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Is there a specific, current, and named employer or client type hiring for this exact skill right now — or is the plan "learn it and see what happens"? 82% of Indian employers report difficulty finding candidates with the right skill sets, which cuts both ways: real demand exists, but only for demonstrated skill, not a course completion certificate alone.',
    note: 'Search current job postings for your target role before starting the course, not after finishing it.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'If this specific skill-first path does not work out within 12-18 months, what is the backup — a related degree still on the table, a different skill, or a government-exam track running in parallel? A no-degree bet without a backup plan turns one slow year into a multi-year setback.',
    note: 'The safer version of every path on this page keeps one honest exit ramp mapped before month one, not discovered in month twelve.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'One finished, shippable piece of work in your chosen lane — a deployed website, three real design case studies, a paid client project, or a cleared government-exam tier. Not a certificate alone.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'A 30-second to 2-minute explanation of what you built, why it matters, and what problem it solves for a hiring manager or client — rehearsed, not improvised under pressure.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of value',
    body: 'At least one real signal that someone outside your family will actually pay for this: a client payment, an internship offer, a freelance gig, or a recruiter response — not just encouragement from friends.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Choosing "no degree" as a rejection of study, not a choice of a different study path',
    body: 'ITI, CS, coding bootcamps, and government exam prep all demand serious, structured study — often for years. If the real motive is avoiding hard work rather than avoiding a specific degree format, no path on this page will fix that underlying problem.',
  },
  {
    num: '02',
    title: 'Copying a billionaire-dropout story instead of reading the base rate',
    body: 'Mukesh Ambani, Azim Premji, Ritesh Agarwal, and Nikhil Kamath dropped out and built massive companies — but this is survivorship bias in its purest form. Research cited by finance industry leaders shows college dropouts, on average, earn less and are more likely to be unemployed than graduates; for every founder who built a unicorn after leaving formal education, millions of others on the same path never reached stable income. Use these stories for permission to consider the option, never as a probability estimate.',
  },
  {
    num: '03',
    title: 'Picking a skill because it is trending on social media, not because you checked current job postings',
    body: 'A skill with zero live job postings or client demand in your target city or remote market is a hobby, not a career plan yet. Verify demand before you commit months to it.',
  },
  {
    num: '04',
    title: 'Skipping the family conversation and hoping the results will speak for themselves later',
    body: 'A degree gap without a clear explanation and visible activity reads as drift to both employers and relatives. A degree-optional path with a clear plan, a timeline, and visible progress reads as a decision. The story you tell matters as much as the plan itself.',
  },
  {
    num: '05',
    title: 'Treating the first attempt as the only attempt',
    body: 'Most skill-first, exam-first, and business-first paths take a real, sustained stretch of consistent work before real income shows up — the exact length varies by path and person. Quitting early because "nothing happened yet" is the single most common way a genuinely viable no-degree path gets abandoned too early.',
  },
];

const faqItems = [
  {
    q: 'Is it actually possible to build a career without a degree after 12th in India?',
    a: 'Yes, in several tracks: skill-first tech roles (web development, UI/UX, digital marketing, data analytics), ITI and polytechnic diploma trades, government and defence exams that accept 12th pass, professional courses like Company Secretary that start after 12th, and business routes like freelancing and sales. Each has different risk, timeline, and income patterns — the honest answer is "yes, if you pick one seriously and build real proof," not "yes, automatically."',
  },
  {
    q: 'Which career without a degree pays the most after 12th in India?',
    a: 'Full-stack development and UI/UX design currently show the strongest entry salaries for skill-first candidates, with freshers who build a genuine portfolio landing ₹4-8 LPA roles within 6-12 months of serious bootcamp-plus-project work. NDA-route defence officer pay (₹70,000-90,000 a month post-training) is also strong but requires a multi-year commitment and specific eligibility (PCM stream, age window, medical standards).',
  },
  {
    q: 'Do Indian employers actually hire people without a degree?',
    a: 'Increasingly, yes, for skill-demonstrable roles. Surveys cited by LinkedIn and Indian hiring platforms report more than 80% of employers saying they should prioritise skills over degrees, and 82% separately report difficulty finding candidates with the right practical skill sets — meaning real demand exists for people who can prove capability, especially in tech, design, sales, and digital roles. Degree requirements remain firm for regulated professions (medicine, law, chartered accountancy as a qualified professional, and government exams like UPSC civil services, which legally require a bachelor\'s degree).',
  },
  {
    q: 'Can I still get a government job without a degree after 12th?',
    a: 'Yes, for a wide range of posts: SSC CHSL, SSC MTS, SSC GD Constable, RRB NTPC lower posts, state police constable, India Post GDS, NDA, and Agniveer all accept 12th-pass candidates with no graduation requirement. UPSC civil services (IAS, IPS, IFS) is the major exception — a bachelor\'s degree is mandatory, and diploma holders are not eligible.',
  },
  {
    q: 'Is skipping a degree a bigger risk than the billionaire dropout stories suggest?',
    a: 'Yes, and this is worth saying plainly. Mukesh Ambani, Azim Premji, Ritesh Agarwal, and Nikhil Kamath are real examples, but they represent survivorship bias — the rare visible successes, not the base rate. Broader research shows college dropouts, on average, earn less and face higher unemployment risk than graduates. The honest planning question is not "could this work like it did for them" but "what specific, demonstrated skill and proof of work will make an employer or client choose me" — a much more answerable question than copying a billionaire narrative.',
  },
  {
    q: 'What should I tell my parents if I want to skip a degree for a skill-first path?',
    a: 'Bring a written plan, not just a feeling: the specific skill or exam track, the realistic timeline (usually 6-18 months before real income), the cost, the backup plan if it does not work, and one piece of evidence that this path is genuinely hiring right now — a job posting, a course placement report, or a freelance gig already lined up. Parents are usually not against the plan itself; they are against the absence of one.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="college-degrees"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>A career without degree after 12th India is realistic today, but only through a specific
    skill, exam, or trade track that you can prove — not through avoiding study altogether.</strong>
    Tech and digital skill routes, ITI and polytechnic trades, government and defence exams, professional
    courses like Company Secretary, and business routes like freelancing and sales all accept a 12th-pass
    candidate with zero degree requirement. What decides whether this works is not the absence of a
    degree. It is whether you build a real skill portfolio, one genuine piece of proof of work, and a
    plan for what happens if the first attempt does not land — the same discipline that moves anyone
    toward stronger income and earlier financial freedom, degree or no degree.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>A career without a degree can work, but only when you replace the degree signal with a strong skill portfolio and visible proof of work.</strong> A certificate alone is not enough.</li>
      <li>The clearest routes are digital work, ITI and polytechnic trades, selected government or defence exams, professional courses such as CS, and business paths such as sales or freelancing.</li>
      <li>Check the formal eligibility first: some routes remain degree-gated. UPSC Civil Services, for example, requires a bachelor's degree.</li>
      <li>Do not treat billionaire-dropout stories as normal outcomes. Choose a specific skill, a realistic income runway, and a backup education or employment plan.</li>
      <li>Build the complete stack: deep work skill, AI and digital fluency, communication, visible projects, outreach, and—where relevant—useful content or a professional reputation.</li>
    </ul>
  </div>

  <p>
    If you are still weighing this against a degree, a gap year, or a diploma more broadly, start with
    <a href="/blog/college-degrees/should-i-take-drop-year-after-12th/">should I take a drop year after 12th</a>
    or <a href="/blog/college-degrees/best-diploma-courses-after-12th/">best diploma courses after 12th</a>.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="answer">The direct answer to "career without degree after 12th India"</h2>

  <p>
    Yes, you can build a real career after 12th without a degree — but the honest version of that yes
    has conditions attached.
  </p>

  <p>
    It works when you pick one specific route (not five at once), build a genuine skill or clear an exam
    stage, and have real evidence — a project, a client, a job posting, or a passed exam tier — before you
    call the plan "working." It fails when "no degree" quietly becomes "no plan," and a year of vague
    exploration passes with nothing to show for it.
  </p>

  <p>
    Read <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    if you want a second, honest opinion on which of the routes below actually fits your situation before
    you commit months to one.
  </p>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad advice you will hear</p>
    <ul class="callout__list">
      <li>"Without a degree, no company will even look at your resume."</li>
      <li>"Just start a YouTube channel or become an influencer, degrees are outdated now."</li>
      <li>"Everyone successful today dropped out of college."</li>
      <li>"A degree is only a formality, it does not matter what you study."</li>
    </ul>
    <p class="callout__footer">
      None of this holds up against the real data. Some sectors still gate hard on a degree (government
      civil services, medicine, law). Others increasingly hire on proof of skill alone. The honest picture
      is route-specific, not a blanket yes or no.
    </p>
  </div>

  <h2 id="reality-check">The reality check before you decide</h2>

  <p>
    Before the list of paths, two numbers deserve your full attention, because they cut in opposite
    directions and both are true at once.
  </p>

  <div class="grid-two">
    <div class="card">
      <h3>The case for skill-first paths</h3>
      <ul>
        <li>Graduate unemployment in India sits at roughly 11.2%, more than three times the national average, and more than a third of graduates in their early twenties are unemployed.</li>
        <li>Only about 42.6% of Indian graduates are considered employable, according to the Mercer-Mettl India Graduate Skill Index, drawn from 2,700+ campuses and over a million students.</li>
        <li>82% of Indian employers say they struggle to find candidates with the right practical skills — meaning real, unmet demand exists for people who can prove capability.</li>
      </ul>
    </div>
    <div class="card">
      <h3>The case for caution</h3>
      <ul>
        <li>Employability still varies sharply by field: management graduates show roughly 78% employability, engineering around 71.5%, science around 58% — a degree is not uniformly weak.</li>
        <li>Broader research on college dropouts shows they earn less on average and face higher unemployment risk than graduates — the billionaire stories are the exception, not the norm.</li>
        <li>Some career paths (government civil services, medicine, chartered accountancy as a qualified member, law practice) legally require a degree — no amount of skill substitutes for the credential in these specific tracks.</li>
      </ul>
    </div>
  </div>

  <p>
    The honest takeaway is not "skip college" or "always go to college." It is: the market increasingly
    pays for demonstrated skill, but it still pays unevenly, and a few paths remain degree-gated no matter
    how skilled you are. Pick your route with that nuance in mind, not with a slogan.
  </p>

  <h2 id="paths">15 real paths without a degree after 12th</h2>

  <p>
    These are grouped by category so you can compare within a lane instead of across four unrelated
    ones. Every card includes a fit signal and a caution — read both before you commit.
  </p>

  <h3 id="tech">Tech and digital skill routes</h3>

  <div class="path-grid">
    {pathCards.filter((p) => p.tag === 'Tech' || p.tag === 'Digital').map((item) => (
      <div class="path-card">
        <div class="path-card__tag">{item.tag}</div>
        <div class="path-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="path-card__sub path-card__sub--fit">{item.fit}</div>
        <div class="path-card__sub path-card__sub--caution">{item.caution}</div>
      </div>
    ))}
  </div>

  <h3 id="trades">ITI, diploma, and technical trades</h3>

  <div class="path-grid">
    {pathCards.filter((p) => p.tag === 'Trades').map((item) => (
      <div class="path-card">
        <div class="path-card__tag">{item.tag}</div>
        <div class="path-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="path-card__sub path-card__sub--fit">{item.fit}</div>
        <div class="path-card__sub path-card__sub--caution">{item.caution}</div>
      </div>
    ))}
  </div>

  <h3 id="exams">Government and defence routes (no degree needed)</h3>

  <div class="path-grid">
    {pathCards.filter((p) => p.tag === 'Government').map((item) => (
      <div class="path-card">
        <div class="path-card__tag">{item.tag}</div>
        <div class="path-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="path-card__sub path-card__sub--fit">{item.fit}</div>
        <div class="path-card__sub path-card__sub--caution">{item.caution}</div>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Government exam routes look "safe" on paper, but the competition is brutal precisely because so
      many people believe the same thing. A narrow, disciplined prep plan for one or two exams beats
      spreading thin across five. And if you are eyeing UPSC civil services specifically, note the one
      hard exception on this whole page: a bachelor's degree is legally mandatory there, and diploma
      holders are not eligible to apply at all.
    </p>
  </div>

  <h3 id="professional">Professional courses that start after 12th, not after a degree</h3>

  <div class="path-grid">
    {pathCards.filter((p) => p.tag === 'Professional').map((item) => (
      <div class="path-card">
        <div class="path-card__tag">{item.tag}</div>
        <div class="path-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="path-card__sub path-card__sub--fit">{item.fit}</div>
        <div class="path-card__sub path-card__sub--caution">{item.caution}</div>
      </div>
    ))}
  </div>

  <h3 id="business">Sales, freelancing, and business routes</h3>

  <div class="path-grid">
    {pathCards.filter((p) => p.tag === 'Business').map((item) => (
      <div class="path-card">
        <div class="path-card__tag">{item.tag}</div>
