---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Restaurant, Catering and Food Business Careers in India: Roles and How to Start";
const seoTitle = "Restaurant, Catering and Food Business Careers in India";
const description = "Restaurant, catering and food business careers in India: roles, skills, safety rules to verify, a free-first plan, who pays and honest limits.";
const seoDescription = "Hygiene and consistency matter more than a big menu.";
const canonical = "https://futurecareerschool.com/blog/career-options/restaurant-catering-and-food-business-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How do I start in the food business?",
    "Learn the rules, work in a kitchen, cost dishes and test with small orders."
  ],
  [
    "Do I need a hotel management degree?",
    "Not always, but some employers prefer it. Read notices."
  ],
  [
    "Is it risky?",
    "Yes. Margins are thin, so test small and keep costs low."
  ],
  [
    "What licences are needed?",
    "They vary. Verify on official pages before starting."
  ],
  [
    "Can I run a home kitchen?",
    "Check local rules and food safety requirements officially."
  ],
  [
    "Which skills matter most?",
    "Consistency, hygiene, costing and teamwork."
  ],
  [
    "How do I find first customers?",
    "Offer tasting to friends, local offices and events, then ask for feedback."
  ],
  [
    "Will AI change restaurant jobs?",
    "Planning and ordering shrink. Taste and hospitality remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
