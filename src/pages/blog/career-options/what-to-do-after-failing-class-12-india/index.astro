  {
    num: "04",
    title: "Survival: what survives AI?",
    body: "Plain data entry and entry-level writing are what AI takes first. Trades, sales, local services and real analysis for a business last longer. Pick a lane whose first year builds those.",
  },
];

const gateItems = [
  {
    label: "Gate 1",
    title: "Proof of skill",
    body: "Finish one small piece of work in your chosen lane: a repaired device, a sold product, a short video, a simple app. Photograph or record how you did it.",
  },
  {
    label: "Gate 2",
    title: "Proof you can explain it",
    body: "Describe what you did and what it cost in two minutes. If an uncle or a shop owner cannot repeat it back, simplify.",
  },
