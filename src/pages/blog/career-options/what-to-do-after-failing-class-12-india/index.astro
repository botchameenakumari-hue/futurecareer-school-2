  },
  {
    n: "D",
    title: "Build skills and proof first, return to study later",
    body: "Best when exams are not working for you right now. Pair a real project with a bridge route so the door to a degree stays open.",
  },
];

const nios = [
  {
    fact: "Who can join",
    detail: "Secondary needs Class VIII passed and proof of age 14. Senior secondary does not allow direct admission, and you must have passed Secondary from a recognised board and be at least 15 on 31 July of the admission year.",
  },
  {
    fact: "Credit for what you passed",
    detail: "Learners from other boards can transfer up to two subjects passed in the last five years, if those subjects are in the NIOS scheme. Transfer of credit must be requested at admission, with the original marksheet.",
  },
  {
    fact: "Pass rule",
    detail: "A pass needs at least five subjects, including one or at most two languages, with at least 33 percent in the external exam and 33 percent in aggregate.",
  },
  {
    fact: "Exam timing",
    detail: "On-demand exams are held monthly at regional centres after the first public exam. You choose the date and subject, and you only sit the subjects still to clear.",
