const stageRows = [
  {
    route: "Government jobs",
    first: "A written-exam rank high enough to be called for the next round.",
    second: "A later stage such as a skill test, interview or document check, then a posting you may not choose.",
  },
  {
    route: "ITI to diploma to degree ladder",
    first: "A good ITI result and a seat under the state's limited lateral-entry quota.",
