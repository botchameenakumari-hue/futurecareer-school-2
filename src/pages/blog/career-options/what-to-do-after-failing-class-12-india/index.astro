  {
    fact: "Recognition",
    detail: "NIOS says its certificates have the same recognition as other boards, and the Association of Indian Universities has granted equivalence for higher studies. Part admission gives only a marksheet, not a certificate.",
  },
];

const diplomaRows = [
  {
    path: "Engineering diploma (polytechnic)",
    entry: "In the Nagaland directorate's rules, Class 10 with Maths and Science passed. Rules differ by state, and admission is by merit.",
    leads: "Three-year course. Diploma holders may enter the second year of engineering through lateral entry, which Nagaland caps at 10 percent of intake over the approved seats.",
  },
  {
    path: "ITI trade (CTS)",
    entry: "Most trades ask for Class 10, Dress Making for Class 8, with a minimum age of 14 and no upper limit, on the DGT page for NSTI Indore.",
    leads: "Most trades run one year, and Electronics Mechanic runs two. NCVT awards the National Trade Certificate after the exam, with 80 percent attendance.",
  },
  {
    path: "ITI then diploma then degree",
    entry: "A 2023 Tamil Nadu report said ITI completers can enter a second-year diploma directly, and diploma holders can join second-year engineering degrees.",
