---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "What to do after failing Class 12 in India: supplementary exam, NIOS, diploma and skill routes ranked by growth";
const seoTitle = "After Failing Class 12 in India: Supplementary, NIOS, Diploma, Careers";
const description =
  "Failed Class 12? See which result you have, how the supplementary exam and NIOS work, diploma and ITI routes through Class 10, and careers ranked by growth.";
const seoDescription =
  "Failed Class 12? Find out which result you have, how supplementary and NIOS work, the diploma and ITI route, and career options ranked by growth.";
const canonical = "https://futurecareerschool.com/blog/career-options/what-to-do-after-failing-class-12-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Allu Vagdevi";
const authorUrl = "https://futurecareerschool.com/about/allu-vagdevi/";
const authorRole = "Career researcher and writer";

const jumpLinks = [
  { id: "which-result", label: "First, which result do you have?" },
  { id: "four-routes", label: "Four ways forward" },
  { id: "supplementary", label: "The supplementary exam and repeat year" },
  { id: "nios", label: "NIOS: the open school route" },
  { id: "diploma-iti", label: "Diploma and ITI through Class 10" },
  { id: "bridge", label: "A bridge to a degree without Class 12" },
  { id: "routes", label: "Eight career lanes, strongest growth first" },
  { id: "two-stage", label: "Lanes that filter you twice" },
  { id: "parents", label: "Talking to your family" },
  { id: "money", label: "Money and fee traps" },
  { id: "checkpoint", label: "The 4-Checkpoint Protocol" },
  { id: "gates", label: "The 3 Gates" },
  { id: "mistakes", label: "Expensive mistakes" },
  { id: "next-step", label: "What to do next" },
  { id: "faq", label: "FAQs" },
];

const resultRows = [
  {
    result: "Compartment (failed one or two subjects)",
