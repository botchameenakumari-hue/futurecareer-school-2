];

const protocolItems = [
  {
    num: "01",
    title: "Biology: where did the marks go?",
    body: "Look at which subjects and which papers you lost. A pattern in one subject, in exam nerves or in practicals points to a fix. A pattern across everything points to a different route.",
  },
  {
    num: "02",
    title: "Context: time, money and home support",
    body: "Write down how many months and how much money your family can put into the next step. Ask whether anyone will pay for a repeat year, and check the cheapest legal route first.",
  },
  {
    num: "03",
