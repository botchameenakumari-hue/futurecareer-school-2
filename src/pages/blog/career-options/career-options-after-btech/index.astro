const salesSteps = [
  {
    title: 'Say who you help, in one sentence.',
    body: '"I help small plastic-moulding units cut rejected parts using simple process data." Narrow beats broad. A stranger should think: that is my exact problem.',
  },
  {
    title: 'Make one simple offer.',
    body: 'One problem, one fixed scope, one price band, one clear output. A confusing offer gets "let me think about it". A clear one gets a yes or a clean no.',
  },
  {
    title: 'Keep proof others can check.',
    body: 'One finished piece of work with a before and after. Remove the client name if you must. Proof is a case note, a model, a dashboard or a referral, not a list of courses.',
