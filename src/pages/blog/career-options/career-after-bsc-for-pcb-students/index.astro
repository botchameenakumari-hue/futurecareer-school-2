const title = 'Best Career After BSc for PCB Students: The Complete Options Chart';
const description =
  'Best career after BSc for PCB students, in one chart: MSc routes by subject, NET/JRF research, ICAR/DRDO/CSIR jobs, private-sector roles, and the honest salary reality.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/career-after-bsc-for-pcb-students';
const publishedDateISO = '2026-08-04';
const publishedDateLabel = '4 August 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'why-different', label: 'Why this decision is different' },
  { id: 'chart', label: 'The full BSc career chart' },
  { id: 'by-subject', label: 'MSc routes by BSc subject' },
  { id: 'research-track', label: 'The research track: NET, JRF, PhD' },
  { id: 'government-jobs', label: 'Government science jobs' },
