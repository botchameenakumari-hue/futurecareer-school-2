  },
  {
    route: 'Forensic science laboratories',
    detail:
      'State-level recruitment is the realistic BSc-level entry point — Uttar Pradesh\'s UPSSSC, for example, has recruited for around 208 Scientific and Lab Assistant posts open to BSc graduates in Chemistry, Biology, or Physics, with an age band roughly 21-40. Central and metro forensic labs (such as Delhi\'s FSL) more often ask for a master\'s degree, or Chemistry carried as a subject through all three years of the BSc, for their Junior Scientific Assistant and Scientific Officer grades.',
  },
  {
    route: 'State Pollution Control Boards (environmental testing)',
    detail:
      'Junior Lab Assistant and Scientific Assistant posts commonly accept a BSc in Science or Environmental Science, though the exact bar varies by state — some boards list "BSc, MSc" as acceptable qualifications rather than BSc alone, so a specific state\'s current notification is the only reliable source.',
  },
];

const privateSectorCards = [
