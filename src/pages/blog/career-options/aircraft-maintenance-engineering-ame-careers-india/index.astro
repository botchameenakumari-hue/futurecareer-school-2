        <tr>
          <th>Record</th>
          <th>Purpose</th>
          <th>Good habit</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Record"><strong>Task card</strong></td>
          <td data-label="Purpose">Lists steps for a job</td>
          <td data-label="Good habit">Sign each step only after doing it</td>
        </tr>
        <tr>
          <td data-label="Record"><strong>Defect report</strong></td>
          <td data-label="Purpose">Describes a fault found</td>
          <td data-label="Good habit">Write clearly with location and part</td>
        </tr>
        <tr>
          <td data-label="Record"><strong>Parts record</strong></td>
          <td data-label="Purpose">Tracks which part was fitted</td>
          <td data-label="Good habit">Copy numbers carefully</td>
        </tr>
        <tr>
          <td data-label="Record"><strong>Handover note</strong></td>
          <td data-label="Purpose">Informs the next shift</td>
          <td data-label="Good habit">State what is complete and what is open</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Practise neat, honest record keeping in any job you do now.
  </p>

