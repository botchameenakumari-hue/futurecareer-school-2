          <td data-label="Example">Check the part number twice</td>
        </tr>
        <tr>
          <td data-label="Risk"><strong>Distraction</strong></td>
          <td data-label="Habit that helps">Finish a step before answering a call</td>
          <td data-label="Example">Pause and note where you stopped</td>
