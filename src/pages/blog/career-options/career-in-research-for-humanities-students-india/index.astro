---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career in research for humanities students India: 5 lanes beyond the PhD track';
const description =
  'A career in research for humanities students India spans academia, policy think tanks, market research, UX research, and NGO/social-sector research. Real stipends, salaries, and entry routes.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/career-in-research-for-humanities-students-india';
const publishedDateISO = '2026-07-16';
const publishedDateLabel = '16 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'reframe', label: 'The mistake: treating research as one career' },
  { id: 'lanes', label: '5 research lanes for humanities graduates' },
  { id: 'academic', label: 'Academic research: NET-JRF to PhD' },
  { id: 'policy', label: 'Policy and think tank research' },
  { id: 'market', label: 'Market and consumer research' },
  { id: 'ux', label: 'UX research' },
  { id: 'social', label: 'Social-sector and NGO research' },
  { id: 'skill', label: 'The one skill that decides your pay in every lane' },
  { id: 'money', label: 'The real money math, lane by lane' },
  { id: 'test', label: 'Test a lane before you commit years to it' },
  { id: 'mistakes', label: 'Mistakes that waste years' },
  { id: 'faq', label: 'FAQs' },
];

const laneTable = [
  {
    lane: 'Academic research (NET-JRF, PhD, assistant professor)',
    bestFor: 'People who want deep subject mastery and are genuinely willing to spend 5-8+ years before stable income.',
    reality: 'JRF stipend is Rs 37,000/month for the first two years. Only the top 6% of NET-qualified candidates get a JRF slot at all. Assistant professor posts are scarce relative to PhD output.',
  },
  {
    lane: 'Policy and think tank research',
    bestFor: 'People who liked analysis, current affairs, and writing structured notes more than a narrow academic thesis.',
    reality: 'Entry-level policy analyst pay commonly runs Rs 5-9 LPA, but research-associate-level roles at smaller think tanks can start closer to Rs 2.5-4 LPA.',
  },
  {
    lane: 'Market and consumer research',
    bestFor: 'People who want faster corporate entry and are comfortable mixing surveys, interviews, and basic data reading.',
    reality: 'Entry-level market research analyst pay in India runs roughly Rs 5-8 LPA, rising to Rs 10-18 LPA by 3-6 years with quantitative skills like SQL.',
  },
  {
    lane: 'UX research',
    bestFor: 'People who like one-on-one interviews, usability testing, and translating human behaviour into product decisions.',
    reality: 'Entry-level UX researchers with under a year of experience earn roughly Rs 5.4 lakh a year on average; this climbs toward Rs 9.5 lakh by 1-4 years with a portfolio.',
  },
  {
    lane: 'Social-sector and NGO research (M&E)',
    bestFor: 'People who want research work with a visible social outcome, and can tolerate lower starting pay for mission-driven work.',
    reality: 'Entry-level roles often start around Rs 20,000-50,000 a month; monitoring-and-evaluation managers at larger NGOs later reach Rs 12-22 LPA.',
  },
];

const academicCards = [
  {
    label: 'Entry route',
    title: 'Clear UGC NET (with JRF) in your subject, then register for a PhD under a supervisor',
    body: 'You need a master\'s degree with at least 55% marks (50% for reserved categories). JRF is a two-part prize: it funds your PhD stipend and later gives you a direct route to try for assistant professor posts. Only the top 6% of NET-qualified candidates in your subject get a JRF slot in a given cycle, so most NET-qualifiers never get funded.',
  },
  {
    label: 'The money, honestly',
    title: 'JRF pays Rs 37,000 a month for two years, then Rs 42,000 in year three as SRF',
    body: 'Add a contingency grant of roughly Rs 10,000 a year for humanities and social science scholars, plus HRA where applicable. If you do not clear JRF, ICSSR doctoral fellowships pay less: Rs 20,000 a month plus Rs 20,000 a year contingency, for a two-year full term.',
  },
  {
    label: 'The bottleneck after the PhD',
    title: 'A PhD does not automatically convert into a teaching post',
    body: 'Government college assistant professor basic pay starts near Rs 57,700 (Level 10), roughly Rs 90,000-1.1 lakh gross with allowances once you get a post. Private college pay is commonly Rs 40,000-60,000 a month for the same role, and the number of PhD graduates each year in India comfortably exceeds the number of new permanent posts.',
  },
];

const policyCards = [
  {
    label: 'Entry route',
    title: 'Research associate or policy analyst at a think tank, consultancy, or government-facing NGO',
    body: 'A public policy master\'s helps but is not mandatory if you can show a real writing sample: a policy brief, a research note, or a short explainer on a live policy issue.',
  },
  {
    label: 'The money, honestly',
    title: 'Entry policy-analyst pay clusters around Rs 5-9 LPA, but research-associate roles pay less',
    body: 'Payscale-style averages for the broad "policy analyst" title in India sit close to Rs 5.9 LPA, while raw research-associate or research-assistant openings at smaller think tanks can start around Rs 2.5-4 LPA before you specialise.',
  },
  {
    label: 'How it compounds',
    title: 'Pay jumps once you own a sector, not a generic policy label',
    body: 'Analysts who build depth in one area (health policy, education, urban governance, climate) get pulled into consulting, multilateral projects, and government-relations roles that pay meaningfully more than a generalist stays at the same level.',
  },
];

const marketCards = [
  {
    label: 'Entry route',
    title: 'Research analyst or associate at a market research firm, consulting arm, or brand insights team',
    body: 'You can enter from any humanities background; a stream with some economics, psychology, or statistics exposure makes the transition faster because interpreting numbers is a daily part of the job.',
  },
  {
    label: 'The money, honestly',
    title: 'Entry pay runs roughly Rs 5-8 LPA, but the ceiling depends on how comfortable you get with data tools',
    body: 'Mid-level researchers (3-6 years) commonly earn Rs 10-18 LPA, and senior/lead roles cross Rs 20-35 LPA. The jump from entry to mid-level tends to track how far you move beyond pure qualitative fieldwork into quantitative survey design and basic tools like SQL or Excel-heavy analysis.',
  },
  {
    label: 'Honest take',
    title: 'Pure qualitative skill gets you in the door; quantitative skill gets you promoted',
    body: 'A humanities graduate who can run focus groups and write insight reports is employable at entry level. The people who move up fastest add one quantitative layer on top: survey statistics, dashboarding, or basic data querying.',
  },
];

const uxCards = [
  {
    label: 'Entry route',
    title: 'UX research intern, associate researcher, or a hybrid design-research role at a product company or agency',
    body: 'A portfolio of 2-3 real research studies (even unpaid or academic ones, if written up properly) usually matters more to hiring managers than a specific degree title.',
  },
  {
    label: 'The money, honestly',
    title: 'Entry-level UX researchers average roughly Rs 5.4 lakh a year in India, moving to about Rs 9.5 lakh by 1-4 years',
    body: 'The wider market range for the role runs from around Rs 7.5 lakh at the 25th percentile to nearly Rs 20 lakh at the 75th percentile once you have a stronger track record and are working at a larger product company.',
  },
  {
    label: 'What makes this lane different',
    title: 'It is the fastest of the five lanes to convert humanities training into a tech-sector salary',
    body: 'A background in anthropology, sociology, psychology, or literature is a genuine advantage here, because the core skill is reading people and behaviour accurately, not writing code.',
  },
];

const socialCards = [
  {
    label: 'Entry route',
    title: 'Programme associate, research fellow, or monitoring-and-evaluation (M&E) coordinator at an NGO, CSR foundation, or development consultancy',
    body: 'Additional training in development studies, statistics for social science, or a short M&E certification meaningfully strengthens a general humanities degree for this track.',
  },
  {
    label: 'The money, honestly',
    title: 'Entry pay is the lowest of the five lanes; the ceiling is higher than most people assume',
    body: 'Entry-level roles commonly start around Rs 20,000-50,000 a month. M&E managers at larger NGOs or CSR programmes later reach Rs 12-22 LPA, M&E directors reach Rs 22-45 LPA, and independent evaluation consultants can bill Rs 10,000-75,000+ per assignment day once established.',
  },
  {
    label: 'Honest take',
    title: 'Choose this lane because the mission genuinely matters to you, not because it sounds close to "research with meaning"',
    body: 'The people who last in social-sector research care about the outcome the data is used for. If mission does not carry you through the low early pay, the market and policy lanes pay better for similar research skills.',
  },
];

const skillCards = [
  {
    label: 'Human edge',
    title: 'Turning a messy pile of interviews, documents, or data into one clear, defensible finding',
    body: 'Every one of these five lanes pays for the same underlying move: synthesis. An AI tool can summarise a transcript. It cannot yet decide which finding actually matters to the decision the client, editor, or funder needs to make.',
  },
  {
    label: 'Urgent problem',
    title: 'Research work only pays well when it answers a real decision someone is stuck on',
    body: 'A think tank commissions a brief because a ministry needs a position by a deadline. A product team commissions a UX study because a launch decision is stuck. Research that does not connect to a real decision gets treated as a cost, not an asset, and gets paid accordingly.',
  },
  {
    label: 'Ceiling',
    title: 'The path from analyst to lead runs through owning a topic, not just doing more studies',
    body: 'In policy, market, and UX research alike, the jump in pay comes when you become the person other people go to for one specific area (a sector, a product category, a user segment), not when you simply accumulate years.',
  },
  {
    label: 'Depth',
    title: 'Every lane filters out people who treat research as passive reading',
    body: 'Academic research filters through the PhD itself. Market and UX research filter through fieldwork you can point to. Policy research filters through a real brief you wrote. There is no lane on this list where reading articles alone gets you hired.',
  },
  {
    label: 'Financial reality',
    title: 'The fastest route to earlier financial freedom is stacking a quantitative skill on top of your lane, not switching lanes every year',
    body: 'A humanities researcher who adds one hard skill (statistics, SQL, dashboarding, or a specific sector\'s domain knowledge) to strong synthesis and communication builds a genuine high-income skill portfolio, which raises pay faster than years of tenure in an unspecialised research role.',
  },
];

const moneyRows = [
  {
    item: 'Academic: JRF stipend, years 1-2',
    range: 'Rs 37,000/month, plus roughly Rs 10,000/year contingency grant for humanities and social sciences.',
  },
  {
    item: 'Academic: SRF stipend, year 3 onward',
    range: 'Rs 42,000/month, until thesis submission or the fellowship term ends, whichever is earlier.',
  },
  {
    item: 'Academic: ICSSR doctoral fellowship (if not JRF-funded)',
    range: 'Rs 20,000/month plus Rs 20,000/year contingency grant, for a two-year full term.',
  },
  {
    item: 'Academic: assistant professor entry pay (government college)',
    range: 'Basic pay near Rs 57,700 (Level 10), roughly Rs 90,000-1.1 lakh gross with allowances.',
  },
  {
    item: 'Policy research: entry analyst/associate pay',
    range: 'Roughly Rs 2.5-4 LPA at smaller think tanks up to Rs 5-9 LPA for analyst-titled roles.',
  },
  {
    item: 'Market research: entry analyst pay',
    range: 'Roughly Rs 5-8 LPA, rising to Rs 10-18 LPA by 3-6 years.',
  },
  {
    item: 'UX research: entry pay (under 1 year experience)',
    range: 'Roughly Rs 5.4 lakh average, moving toward Rs 9.5 lakh by 1-4 years.',
  },
  {
    item: 'NGO/social-sector research: entry pay',
    range: 'Roughly Rs 20,000-50,000/month, rising toward Rs 12-22 LPA at M&E manager level.',
  },
];

const testSteps = [
  {
    num: '01',
    title: 'Pick one lane and produce the smallest real output that lane actually rewards',
    body: 'For academic research, write one short literature review. For policy, write one one-page brief. For market or UX research, run three real interviews and write up the findings. For social-sector work, volunteer on one real M&E task with an NGO.',
  },
  {
    num: '02',
    title: 'Show it to one person actually doing that job, not a professor who has never left academia',
    body: 'A 20-minute honest conversation with a working policy analyst, market researcher, UX researcher, or M&E coordinator tells you more about the daily reality than a semester of reading about the field.',
  },
  {
    num: '03',
    title: 'Compare the output you produced against your own energy, not just the pay table',
    body: 'Two lanes can pay similarly and still feel completely different day to day. Academic research rewards long solitary depth. Market and UX research reward fast interviews and quick synthesis. Notice which one drained you and which one you wanted to keep doing.',
  },
  {
    num: '04',
    title: 'Give the test as long as it genuinely takes, not a fixed countdown',
    body: 'Some people know within a few weeks that a lane is not for them. Others need a couple of months of real exposure, including a slow week, before the picture is honest. Judge by evidence, not by a calendar.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating "research" as a single career instead of five very different jobs',
    body: 'An academic historian, a policy analyst, a UX researcher, and an NGO M&E officer do genuinely different daily work, for different pay, on different timelines. Picking "research" without picking a lane is not a decision.',
  },
  {
    num: '02',
    title: 'Committing to a PhD before testing whether you actually enjoy 5-8 years of narrow depth',
    body: 'A PhD is the longest, lowest-paying, and highest-commitment lane on this list. It rewards people who genuinely love sitting with one narrow question for years. Test that appetite with a real dissertation-style project before you commit.',
  },
  {
    num: '03',
    title: 'Assuming a JRF slot is guaranteed once you clear NET',
    body: 'Only the top 6% of NET-qualified candidates in a subject receive a JRF slot in a given cycle. Most NET-qualifiers do not get funded research, and plan your finances assuming you might be one of them.',
  },
  {
    num: '04',
    title: 'Staying purely qualitative when the market and UX lanes reward one added quantitative skill',
    body: 'The single biggest pay jump most humanities researchers leave on the table is refusing to learn basic survey statistics, SQL, or a dashboarding tool. It is a few weeks of real effort for a meaningfully higher ceiling.',
  },
  {
    num: '05',
    title: 'Picking the social-sector lane for the mission but ignoring the money math',
    body: 'Mission-driven work is real and valuable, but entry pay in this lane is the lowest of the five. Go in with your eyes open about the runway you need, not a vague sense that "it will work out."',
  },
];

const faqItems = [
  {
    q: 'What is the best career in research for humanities students in India?',
    a: 'There is no single best option; it depends on your tolerance for years of low pay versus faster corporate entry. Academic research (NET-JRF to PhD) pays the least early and takes the longest. Market research and UX research pay the most early and convert humanities training fastest into a corporate salary. Policy and social-sector research sit in between.',
  },
  {
    q: 'How much does JRF pay for humanities students in India?',
    a: 'JRF pays Rs 37,000 a month for the first two years, rising to Rs 42,000 a month in the third year as SRF, plus a contingency grant of roughly Rs 10,000 a year for humanities and social science scholars. Only the top 6% of NET-qualified candidates in a subject receive a JRF slot in a given cycle.',
  },
  {
    q: 'Can a humanities graduate become a UX researcher without a design degree?',
    a: 'Yes. UX research hires for the ability to read human behaviour accurately, which backgrounds like psychology, sociology, anthropology, and literature build directly. A portfolio of 2-3 real research studies matters more to most hiring managers than a specific degree title.',
  },
  {
    q: 'Is a PhD necessary for a research career in India?',
    a: 'Only for the academic research lane, where a PhD is the entry ticket for an assistant professor post. Policy research, market research, UX research, and NGO research all hire humanities graduates without a PhD, though a relevant master\'s degree strengthens most applications.',
  },
  {
    q: 'What does an entry-level market research analyst earn in India?',
    a: 'Entry-level market research analysts in India typically earn roughly Rs 5-8 lakh a year, rising to Rs 10-18 lakh by 3-6 years of experience, and Rs 20-35 lakh or more at senior or lead level, especially with added quantitative skills.',
  },
  {
    q: 'How much do NGO or social-sector research roles pay in India?',
    a: 'Entry-level NGO and development-sector research roles commonly start around Rs 20,000-50,000 a month. Pay improves substantially at monitoring-and-evaluation manager level, commonly Rs 12-22 lakh a year at larger NGOs or CSR programmes, and further at director level.',
  },
  {
    q: 'What skill matters most across every research career path?',
    a: 'Synthesis: the ability to turn a large amount of raw information (interviews, documents, survey data) into one clear, defensible finding that answers a real decision someone is stuck on. Every lane in this article pays for that same underlying move, even though the subject matter differs.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>A career in research for humanities students in India is not one path — it is at least five, and they pay very differently.</strong>
    Academic research through NET-JRF and a PhD, policy and think tank research, market research, UX research, and social-sector or NGO research all hire the same underlying humanities skill set, but on completely different timelines, stipends, and pay ceilings.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Academic research pays the least early (JRF is Rs 37,000/month) and takes the longest, but only 6% of NET-qualified candidates get a funded JRF slot in the first place.</li>
      <li>Market research and UX research convert humanities training into corporate salary the fastest, both starting around Rs 5-8 lakh a year at entry level.</li>
      <li>Policy research and social-sector/NGO research sit between the two: modest entry pay, but real long-term ceilings once you specialise in a sector.</li>
      <li>Every lane rewards the same core move — turning raw material into one clear, decision-useful finding — not passive reading.</li>
      <li>Picking the lane that matches your actual runway, then adding one quantitative skill on top of it, is what builds a genuine high-income skill portfolio and moves your own timeline to financial independence, not the research label alone.</li>
      <li><strong>Test a lane with one small real research output before committing years or a PhD to it; the daily work differs more across these five paths than the shared word "research" suggests.</strong></li>
      <li>Research income grows when subject depth is paired with AI-assisted methods, data or archival skill, clear writing, stakeholder communication, and visible outputs. Consulting, policy, education, content, and independent research services can widen the ceiling beyond one institution.</li>
    </ul>
  </div>

  <p>
    If you want the wider picture of what a humanities degree can lead to beyond research specifically, start with <a href="/blog/career-options/">Career Options</a>.
  </p>

  <p>
    If you are weighing a PhD, a career pivot, or which of these five lanes actually fits your energy and finances, <a href="/services/career-counselling-and-career-guidance/">structured career guidance built around exactly this kind of decision</a> can walk through your specific timeline and runway with you.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="reframe">The mistake: treating research as one career</h2>

  <p>
    Ask ten humanities students what "a career in research" means and you will get ten different pictures in their heads: a professor with a PhD, a policy wonk writing government briefs, a market researcher running focus groups, a designer interviewing users, or a field officer collecting survey data in a village.
  </p>

  <p>
    All five of those are real, current jobs in India today. None of them is what the other four actually look like day to day. Choosing "research" as a career without choosing a lane is like choosing "business" without choosing accounting, sales, or operations — technically true, practically useless.
  </p>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad advice</p>
    <ul class="callout__list">
      <li>If you like research, just do a PhD.</li>
      <li>Research careers are academic careers, full stop.</li>
      <li>Humanities research does not pay; switch to a "real" subject.</li>
      <li>Any research job is basically the same, just pick one.</li>
    </ul>
    <p class="callout__footer">
      None of that tells you the entry pay, the timeline, or the daily reality of the five very different lanes actually open to you.
    </p>
  </div>

  <h2 id="lanes">5 research lanes for humanities graduates</h2>

  <p>
    Here is the full picture before the detail. Compare by daily work and timeline first, pay second.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Lane</th>
          <th>Best for</th>
          <th>Reality check</th>
        </tr>
      </thead>
      <tbody>
        {laneTable.map((item) => (
          <tr>
            <td data-label="Lane"><strong>{item.lane}</strong></td>
            <td data-label="Best for">{item.bestFor}</td>
            <td data-label="Reality check">{item.reality}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="academic">Academic research: NET-JRF to PhD</h2>

  <p>
    This is the lane most people picture first when they hear "research career," and it is also the slowest and lowest-paying one early on.
  </p>

  <div class="work-style-grid">
    {academicCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    JRF and SRF stipend figures and eligibility rules can change between cycles. Verify current amounts on the <a href="https://ugcnet.nta.nic.in/" target="_blank" rel="noopener noreferrer">official UGC NET portal</a> and ICSSR fellowship terms on the <a href="https://icssr.org/doctoral-fellowship" target="_blank" rel="noopener noreferrer">official ICSSR website</a> before planning around them.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A PhD is a genuine calling for some people and a slow financial trap for others.
    </p>
    <p>
      The difference is not talent. It is whether you actually enjoy sitting with one narrow question for years, tested by real work, not by how much you liked your undergraduate seminar.
    </p>
  </div>

  <h2 id="policy">Policy and think tank research</h2>

  <p>
    This lane fits humanities graduates who liked the analysis, current affairs, and structured-writing part of academic work more than the narrow focus a PhD demands.
  </p>

  <div class="work-style-grid">
    {policyCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="market">Market and consumer research</h2>

  <p>
    A faster, more corporate entry point, useful if you want the income stability of a company role while still doing genuine research work.
  </p>

  <div class="work-style-grid">
    {marketCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="ux">UX research</h2>

  <p>
    Often the least obvious option to a humanities graduate, and frequently the best-paying one early on, because it sits inside the tech and product sector's pay bands.
  </p>

  <div class="work-style-grid">
    {uxCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="social">Social-sector and NGO research</h2>

  <p>
    A meaningful lane for people who want research that connects directly to a visible social outcome, with the clearest tolerance-for-lower-pay trade-off of the five.
  </p>

  <div class="work-style-grid">
    {socialCards.map((item) => (
      <div class="work-style-card">
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p>
      Entry pay here is genuinely the lowest on this list, next to a smaller think tank role.
    </p>
    <p>
      Choose this lane because the outcome itself matters to you, not because it sounds like a softer version of "helping people." The ceiling is real, but it takes years, not months, to reach it.
    </p>
  </div>

  <h2 id="skill">The one skill that decides your pay in every lane</h2>

  <p>
    Underneath the five very different job titles above, one skill decides who gets paid well in each of them.
  </p>

  <div class="feature-grid">
    {skillCards.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    If you want a structured way to check your own strengths against these five lanes instead of guessing, the <a href="/career-skills-compass/">Career &amp; Skills Compass</a> is a useful next step.
  </p>

  <h2 id="money">The real money math, lane by lane</h2>

  <p>
