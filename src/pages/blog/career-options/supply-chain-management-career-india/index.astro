---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Supply chain management career India: the real entry map, not the LinkedIn hype';
const description =
  'Supply chain management career India spans procurement, logistics, inventory, and demand planning. Real entry paths, salary data, and which certifications actually matter.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/supply-chain-management-career-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-scm-covers', label: 'What supply chain management actually covers' },
  { id: 'progression-ladder', label: 'The progression ladder, title by title' },
  { id: 'salary-by-experience', label: 'Real salary by experience level' },
  { id: 'industries-hiring', label: 'Which industries are actually hiring' },
  { id: 'entry-paths', label: 'Entry paths: B.Com, engineering, MBA, and no-degree routes' },
  { id: 'certifications', label: 'CSCP, CPIM, and which certification actually matters' },
  { id: 'why-growing', label: 'Why this field is genuinely growing, not overhyped' },
  { id: 'city-company', label: 'How city and company type change SCM pay' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you commit' },
  { id: 'roadmap', label: 'A realistic roadmap to your first SCM role' },
  { id: 'gates', label: 'The 3 Gates before you apply' },
  { id: 'mistakes', label: 'Mistakes that stall SCM career growth' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const scmBranches = [
  {
    badge: 'Function 1',
    title: 'Procurement and sourcing',
    body: 'You decide who the company buys from, negotiate contracts, manage vendor relationships, and control raw-material or service cost. This function sits closest to the money, which is why senior procurement roles carry real budget authority.',
    fit: 'You like negotiation, contract detail, and being the person who protects margin when input costs move against the company.',
    caution: 'Entry-level procurement work is heavy on approvals, purchase orders, and vendor follow-ups before it becomes strategic sourcing or category management.',
    tags: ['Closest to cost control', 'Negotiation-heavy'],
  },
  {
    badge: 'Function 2',
    title: 'Logistics and transportation',
    body: 'You move goods from factory to warehouse to customer, choosing carriers, managing freight cost, and fixing the delivery failures that show up as customer complaints. This is the function most visible to the outside world.',
    fit: 'You are comfortable with real-time problem solving, tracking shipments under pressure, and coordinating across transporters, warehouses, and customer-facing teams.',
    caution: 'Last-mile and transportation roles run on tight SLAs; the work is genuinely operational and can mean odd hours during peak seasons like festive sales.',
    tags: ['Fastest hiring in e-commerce', 'SLA-driven'],
  },
  {
    badge: 'Function 3',
    title: 'Inventory and warehouse management',
    body: 'You decide how much stock sits where, run warehouse management systems (WMS), and balance the cost of holding inventory against the cost of running out of it. Get this wrong and either cash gets stuck in stock or customers do not get their orders.',
    fit: 'You like systems, process discipline, and the kind of problem that has a measurable right answer once you have the data.',
    caution: 'Warehouse-floor exposure early in your career, including night shifts during peak periods, is common before you move into planning-level inventory roles.',
    tags: ['WMS/ERP skill required', 'Warehousing market growing ~19% CAGR'],
  },
  {
    badge: 'Function 4',
    title: 'Demand planning and forecasting',
    body: 'You predict what customers will buy, when, and how much, using historical sales data, seasonality, and increasingly, AI-assisted forecasting tools. Every other function downstream — procurement, inventory, logistics — runs on your forecast.',
    fit: 'You like working with numbers, spreadsheets, and forecasting tools, and you do not mind being the person whose predictions get checked against reality every month.',
    caution: 'This is one of the more analytically demanding SCM functions; weak Excel or basic statistics skill will genuinely slow you down here more than in other functions.',
    tags: ['Highest analytics premium', 'SQL/Python pays 30-50% more'],
  },
  {
    badge: 'Function 5',
    title: 'Vendor and supplier relationship management',
    body: 'You manage the ongoing relationship with suppliers after the contract is signed: performance tracking, quality issues, risk management, and renegotiation when circumstances change. This function decides whether a supply chain survives a disruption or breaks.',
    fit: 'You are comfortable holding suppliers accountable while keeping the relationship workable, and you can read risk before it becomes a crisis.',
    caution: 'This function usually opens up after a few years in procurement or category management rather than as a direct entry point.',
    tags: ['Risk management focus', 'Grows with seniority'],
  },
];

const progressionRows = [
  {
    title: 'Supply Chain Analyst / Logistics Coordinator',
    years: '0-2 years',
    work: 'Runs reports, tracks shipments, updates inventory records, coordinates with vendors and transporters, and handles the data entry and follow-up work that keeps the supply chain visible day to day. This is the entry gate for nearly everyone, regardless of which function you eventually specialise in.',
  },
  {
    title: 'Supply Chain / Procurement / Logistics Executive',
    years: '2-4 years',
    work: 'Owns a defined slice of the chain — a vendor category, a warehouse zone, a delivery region — with less supervision, and starts making small independent calls on cost, timing, and stock levels.',
  },
  {
    title: 'Supply Chain / Procurement / Operations Manager',
    years: '4-8 years',
    work: 'Manages a team, owns a full function such as inventory planning or regional logistics, and reports on cost, service level, and forecast accuracy directly to leadership. This is where SCM starts to look like a genuine management career rather than an operational job.',
  },
  {
    title: 'Senior Manager / Head of Supply Chain (single function)',
    years: '8-12 years',
    work: 'Owns end-to-end responsibility for one function — procurement, logistics, or planning — across a business unit or region, and carries real budget and vendor-contract accountability.',
  },
  {
    title: 'Director of Supply Chain / VP Operations',
    years: '12-18 years',
    work: 'Sets supply chain strategy across functions, manages senior managers, and is judged on total landed cost, service level, and how resilient the chain is to disruption, not just day-to-day execution.',
  },
  {
    title: 'Chief Supply Chain Officer (CSCO) / COO',
    years: '18+ years',
    work: 'Owns enterprise-wide supply chain strategy, reports to the CEO or board, and is directly accountable for how supply chain cost and resilience affect the company\'s overall margin and growth.',
  },
];

const salaryExperienceRows = [
  {
    stage: 'Entry-level, 0-2 years',
    range: 'Rs 3-6 LPA',
    context: 'Typical range for a Supply Chain Analyst or Logistics Coordinator role. Larger companies, GCCs, and graduates from stronger institutes tend to land closer to Rs 6-10 LPA even at entry level.',
  },
  {
    stage: 'Early career, 2-4 years',
    range: 'Rs 6-10 LPA',
    context: 'Executive-level SCM roles, once you can run a vendor category, a delivery zone, or an inventory segment with less supervision.',
  },
  {
    stage: 'Mid-career, 4-8 years',
    range: 'Rs 8-18 LPA',
    context: 'Manager-level territory across procurement, logistics, and planning. Specialisation, company size, and city meaningfully widen this band.',
  },
  {
    stage: 'Senior, 8-15 years',
    range: 'Rs 18-35 LPA',
    context: 'Senior Manager to Director band. Supply chain manager pay commonly sits around Rs 18-35 LPA; procurement manager roles run Rs 18-30 LPA; logistics director roles can reach Rs 30-50 LPA depending on company scale.',
  },
  {
    stage: 'Late career, 18+ years',
    range: 'Rs 40 LPA to Rs 1 crore+',
    context: 'VP or Head of Supply Chain roles commonly start around Rs 40 LPA and above. Chief Supply Chain Officer and COO roles at large enterprises can reach Rs 50 LPA to Rs 1 crore or more once bonus, stock, and performance pay are included.',
  },
];

const industryRows = [
  {
    industry: 'E-commerce and quick commerce',
    detail: 'Flipkart, Amazon India, Meesho, Zepto, Blinkit, and Swiggy Instamart are among the largest employers of supply chain talent in India right now. Last-mile delivery, warehouse automation, and demand-forecasting roles are growing fastest here because delivery speed is the actual product.',
  },
  {
    industry: 'Manufacturing (PLI-linked)',
    detail: 'Production-Linked Incentive schemes are pulling new manufacturing capacity into electronics, pharma, and auto components, and every new plant needs procurement, inbound logistics, and inventory planning staffed from scratch.',
  },
  {
    industry: 'FMCG and pharma',
    detail: 'Fast-moving consumer goods and pharmaceutical supply chains run on tight shelf-life and compliance constraints, which is why sector choice alone can shift pay by 30-50% for an otherwise identical role and experience level.',
  },
  {
    industry: '3PL and logistics service providers',
    detail: 'Third-party logistics companies, freight forwarders, and warehousing operators hire supply chain talent directly into operations and client-account roles, and are expanding fast as India\'s warehousing market grows from roughly USD 14 billion in 2024 toward USD 35 billion by 2029.',
  },
  {
    industry: 'IT, consulting, and SCM technology',
    detail: 'Accenture, Deloitte, Wipro, and Infosys hire supply chain professionals into consulting and technology-implementation roles for SAP, Blue Yonder, and Kinaxis systems, which pay a premium for people who combine SCM domain knowledge with a working technical skill.',
  },
];

const entryRows = [
  {
    route: 'B.Com / BBA (any specialisation)',
    detail: 'The most common entry route into a Supply Chain Analyst or Logistics Coordinator role. A commerce or business degree plus solid Excel skill and basic comfort with numbers is enough to get shortlisted for most entry-level SCM openings.',
  },
  {
    route: 'Engineering (mechanical, industrial, or production)',
    detail: 'A strong route into inventory, planning, and process-heavy SCM roles, especially in manufacturing. Industrial and production engineering backgrounds map directly onto operations and supply chain work without needing a separate management degree.',
  },
  {
    route: 'MBA / PGDM in Operations or Supply Chain Management',
    detail: 'Not required to enter SCM, but it meaningfully accelerates the move to manager-level roles, since it builds cross-functional business judgment beyond execution-level process knowledge. Many recruiters treat an MBA in operations as a fast-track signal for management-trainee programmes.',
  },
  {
    route: 'Diploma or postgraduate certificate in logistics/SCM',
    detail: 'A cheaper, faster alternative to a full MBA for people who already hold a bachelor\'s degree in another field and want a structured, SCM-specific credential without a two-year commitment.',
  },
  {
    route: 'No formal SCM degree, lateral entry',
    detail: 'Genuinely possible, especially into logistics coordination, warehouse operations, or procurement support roles, if you can show transferable proof: running a small business\'s inventory, handling vendor negotiation in a previous role, or basic working knowledge of Excel and a WMS or ERP tool.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Work style',
    body: 'Can you handle a job where a delayed truck, a stuck container, or a stockout becomes your emergency at 9pm, especially early in your career when you are closest to the operational floor? SCM at entry level is not a 9-to-5 desk job in most companies.',
    note: 'If unpredictable hours already drain you badly, lean toward planning or procurement functions over logistics or last-mile roles, which carry the sharpest operational pressure.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can you afford the entry-level pay band (Rs 3-6 LPA) for the 2-4 years it typically takes to reach manager-level compensation, or do you need a parallel income plan while you build toward that jump?',
    note: 'A parallel skill such as basic SQL, Excel-based forecasting, or WMS/ERP fluency protects your runway while you build toward the manager-level pay jump, and also directly raises your ceiling once you get there.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'India\'s logistics market is projected to grow from roughly USD 349 billion in 2025 to USD 592 billion by 2031, and the warehousing market alone is expected to nearly triple by 2029. Demand for supply chain professionals is broad across e-commerce, manufacturing, and 3PL, not scarce like a handful of prestige seats.',
    note: 'Broad demand is genuinely good news here. The honest constraint is not "will an SCM job exist" but "will your data fluency and cross-functional judgment clear the bar for the higher-paying manager and specialist tracks."',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI-assisted demand forecasting, automated warehouse systems, and route-optimisation software are already reshaping the manual, repetitive layer of SCM work — data entry, basic report generation, and simple route planning.',
    note: 'Treat SQL, Excel-based analytics, and at least basic WMS or ERP fluency as part of the job description from day one. SCM professionals who can direct and interpret what these tools produce are the ones whose roles stay valuable as the manual layer keeps shrinking.',
  },
];

const gateItems = [
  {
    num: '01',
    title: 'Proof of Skill',
    title2: 'Can you actually read and act on supply chain data, not just describe the theory?',
    body: 'Build or document one real example: a mock demand forecast built from public sales data, a vendor comparison sheet with real cost trade-offs, or a basic inventory reorder-point calculation. This is the concrete proof an interviewer can ask you to walk through live.',
  },
  {
    num: '02',
    title: 'Proof of Communication',
    title2: 'Can you explain a supply chain trade-off in plain language to someone who is not in operations?',
    body: 'Practice explaining, out loud, why a shipment was delayed, why a vendor was dropped, or why inventory is being held at a certain level, in language a sales or finance colleague can actually follow and accept.',
  },
  {
    num: '03',
    title: 'Proof of Value',
    title2: 'Has anyone outside your own head validated your judgment on a real case?',
    body: 'Show a real or practice forecast, vendor analysis, or inventory plan to someone already working in supply chain or logistics, and ask directly whether it would survive scrutiny in a real interview or a real operations review. Fix the gaps their questions expose.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Staying purely operational for years with no data or planning skill',
    body: 'Execution-heavy experience in logistics coordination or warehouse operations is valuable early on, but the pay ceiling for someone who never adds forecasting, procurement strategy, or basic analytics depth plateaus faster than a specialist\'s does.',
  },
  {
    num: '02',
    title: 'Chasing CSCP or an MBA before building any real operational judgment',
    body: 'A certification or a management degree opens doors, but interviewers for manager-level SCM roles test whether you have actually handled a real vendor negotiation, a real stockout, or a real delivery-cost crunch, not just whether you passed an exam.',
  },
  {
    num: '03',
    title: 'Ignoring SAP, WMS, or basic data-tool fluency because "that is an IT problem"',
    body: 'Warehouse and inventory work is being reshaped first by automated systems, but forecasting and procurement are next. An SCM professional who cannot work inside at least one ERP, WMS, or analytics tool is competing on exactly the layer of the job that is shrinking.',
  },
  {
    num: '04',
    title: 'Treating one function as the only real SCM career',
    body: 'A senior procurement lead, a demand-planning manager, or a logistics operations head at a large company can all out-earn a generic "supply chain manager" title elsewhere. Picking a function based on genuine fit, rather than the most familiar job title, usually pays off more.',
  },
  {
    num: '05',
    title: 'Switching functions every 1-2 years without going deep in any one',
    body: 'Moving between procurement, logistics, and planning every year or two prevents you from building the depth that unlocks manager and specialist-level pay in any single function. Pick a function by your third or fourth year and go deep before considering a switch.',
  },
];

const faqItems = [
  {
    q: 'What is a supply chain management career in India, step by step?',
    a: 'Most people start as a Supply Chain Analyst or Logistics Coordinator (0-2 years), move to a functional Executive role in procurement, logistics, or planning (2-4 years) once they can work with less supervision, then to a Manager role (4-8 years) once they own a full function and a small team. From there the path splits toward Senior Manager or Head of a single function (8-12 years), Director of Supply Chain or VP Operations (12-18 years), and eventually Chief Supply Chain Officer or COO (18+ years). Alongside this generalist ladder, deep specialisation in procurement, demand planning, or supply chain analytics can pay as well as or better than a generic manager track at senior levels.',
  },
  {
    q: 'What is the real supply chain management career India salary progression?',
    a: 'Entry-level Supply Chain Analysts typically earn Rs 3-6 LPA, with larger companies and stronger institutes paying closer to Rs 6-10 LPA. Executive-level roles (2-4 years) move to roughly Rs 6-10 LPA. Manager-level roles (4-8 years) commonly reach Rs 8-18 LPA. Senior Manager to Director-level roles (8-15 years) reach Rs 18-35 LPA, with logistics director roles going up to Rs 30-50 LPA at larger companies. VP or Head of Supply Chain roles start around Rs 40 LPA and above, and Chief Supply Chain Officer roles at large enterprises can reach Rs 50 LPA to Rs 1 crore or more with bonus and stock included.',
  },
  {
    q: 'Do you need an MBA to build a supply chain management career in India?',
    a: 'No. Most entry-level Supply Chain Analyst and Logistics Coordinator roles accept a B.Com, BBA, or engineering degree without an MBA. Where an MBA or PGDM in operations genuinely helps is speeding up the move from Executive to Manager-level roles, since many companies use it as a fast-track signal for management-trainee programmes, and it builds cross-functional business judgment that pure execution experience does not.',
  },
  {
    q: 'Is CSCP certification worth it for a supply chain career in India?',
    a: 'CSCP (Certified Supply Chain Professional, offered through ASCM/APICS) can raise earning potential by roughly 15-20% when it helps you change jobs or move into a role with multinational exposure, and certified professionals report pay meaningfully above non-certified peers. It is most worth pursuing once you already have some operational experience, are targeting MNCs or roles with global exposure, or are preparing for a senior management move. It is generally not the right first step for someone with 0-2 years of experience, where practical, provable operational judgment matters more than a credential.',
  },
  {
    q: 'Which industries hire the most for supply chain roles in India right now?',
    a: 'E-commerce and quick-commerce companies such as Flipkart, Amazon India, Meesho, Zepto, Blinkit, and Swiggy Instamart are currently among the largest employers of supply chain talent, driven by last-mile delivery and warehouse-automation growth. Manufacturing is expanding hiring on the back of Production-Linked Incentive schemes, FMCG and pharma pay a premium due to shelf-life and compliance complexity, and third-party logistics (3PL) providers are growing fast alongside India\'s warehousing market, which is projected to nearly triple by 2029.',
  },
  {
    q: 'Is supply chain management a good career choice in India, or is it overhyped?',
    a: 'The underlying market signal is genuinely strong, not manufactured hype: India\'s logistics market is projected to grow from roughly USD 349 billion in 2025 to USD 592 billion by 2031, warehousing is expanding at close to 19% CAGR, and e-commerce, manufacturing, and 3PL companies are actively adding headcount. The honest caveat is that entry-level pay and work hours are genuinely demanding, and the field rewards people who add data and planning skill on top of operational experience far more than people who stay purely execution-focused for a decade.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Career Options', item: 'https://futurecareerschool.com/blog/career-options' },
      { '@type': 'ListItem', position: 4, name: 'Supply Chain Management Career India', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={jsonLd}
>
  <p class="lead-para">
    A <strong>supply chain management career in India</strong> means one of five genuinely different
    jobs — procurement, logistics, inventory and warehouse management, demand planning, or vendor
    relationship management — sitting under one umbrella title, and picking the right one matters more
    than the title itself.
  </p>
  <p>
    This is not a trendy detour into a job that might not exist in five years. India's logistics market
    is projected to grow from roughly USD 349 billion in 2025 to USD 592 billion by 2031, warehousing
    is expanding at close to 19% CAGR, and e-commerce, manufacturing, and third-party logistics companies
    are actively hiring — not just posting openings they never fill. This is a genuine
    <strong>high-value skill portfolio</strong> decision, built on cross-functional judgment, data
    fluency, and visible proof of work, not a fallback path for people who could not get into finance
    or marketing.
  </p>
  <p>
    This is the honest map: what each SCM function actually looks like day to day, the real progression
    ladder and pay curve, which industries are hiring right now, the entry paths that actually work
    (degree and no-degree both), which certifications are worth the money, and why this field is growing
    for real reasons, not marketing spin.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>SCM covers five distinct functions: procurement, logistics, inventory/warehouse management, demand planning, and vendor management. Fit varies a lot by function.</li>
      <li>Real pay: roughly Rs 3-6 LPA entry-level, Rs 8-18 LPA at manager stage, Rs 18-35 LPA at senior manager/director stage, and Rs 40 LPA to over Rs 1 crore at CSCO/VP level.</li>
      <li>E-commerce, quick commerce, manufacturing (PLI-linked), FMCG/pharma, and 3PL/logistics providers are the industries hiring most right now.</li>
      <li>You do not need an MBA to enter SCM. B.Com, BBA, and engineering degrees all lead in; an MBA in operations mainly speeds up the move to manager-level roles.</li>
      <li>CSCP can raise pay by roughly 15-20% when changing jobs or targeting MNC exposure, but it is not the right first move for someone with 0-2 years of experience.</li>
      <li>The higher ceiling comes from supply-chain domain depth plus AI or analytics, negotiation, stakeholder communication, and measurable cost, inventory, service, or resilience improvements. Those results can support specialist consulting or operational leadership later.</li>
    </ul>
  </div>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Get a second opinion on your SCM career plan</a>
    <a class="btn-outline cta-assessment-lite" href="https://futurecareerschool.com/services/assessments">Use a free assessment as a quick first check</a>
  </div>

  <nav class="jump-nav" aria-label="Jump to section">
    <span class="jump-nav__label">Jump to section</span>
    <ul class="jump-nav__list">
      {jumpLinks.map((link) => (
        <li><a href={`#${link.id}`}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer</h2>
  <p>
    If you are mapping a supply chain management career in India, start by picking a function, not just
    a job title: procurement, logistics, inventory and warehouse management, or demand planning. Entry
    pay sits around Rs 3-6 LPA and climbs to Rs 8-18 LPA by the manager stage, then Rs 18-35 LPA at
    senior manager and director level. You do not need an MBA to get in — B.Com, BBA, and engineering
    graduates all enter through analyst and coordinator roles — but adding data and forecasting skill on
    top of operational experience is what actually separates a Rs 8 LPA manager from an Rs 18 LPA one.
  </p>

  <p>
    Before going further into salary detail, it helps to see this inside the wider
    <a href="/blog/career-options/">career options</a> landscape, since supply chain sits alongside
    other business-facing and operations-heavy paths worth comparing before you commit years to it. If
    you are still weighing this against other options, a
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    conversation can help you stress-test the fit before you build years of experience in one direction.
  </p>

  <h2 id="what-scm-covers">What supply chain management actually covers</h2>
  <p>
    "Supply chain management" is a job title that hides five genuinely different daily jobs. Picking the
    right one, based on which work actually suits you, matters more than chasing the SCM label itself.
  </p>
  <div class="track-grid">
    {scmBranches.map((branch) => (
      <div class="track-card">
        <span class="track-badge">{branch.badge}</span>
        <h3>{branch.title}</h3>
        <p>{branch.body}</p>
        <div class="sub-row sub-row--fit">
          <span class="sub-row-label">Best for</span>
          <p>{branch.fit}</p>
        </div>
        <div class="sub-row sub-row--caution">
          <span class="sub-row-label">Watch out</span>
          <p>{branch.caution}</p>
        </div>
        <div class="tag-row">
          {branch.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
  <div class="callout callout--teal">
    <p class="callout__eyebrow">Honest take</p>
    <p>
      Most people entering SCM do not choose a function on day one — they get placed into whichever
      team is hiring. That is fine for your first job. But by year three or four, deliberately steering
      toward the function that actually fits your working style pays off more than staying generalist
      indefinitely.
    </p>
  </div>

  <h2 id="progression-ladder">The progression ladder, title by title</h2>
  <p>
    Titles vary by company and function, but the shape of the climb is consistent across most Indian
    employers, from e-commerce startups to large manufacturers. Here is what each stage actually looks
    like, and roughly how long people spend there before moving up.
  </p>
  <div class="protocol-stack">
    {progressionRows.map((row) => (
      <div class="protocol-row">
        <span class="protocol-num">{row.years}</span>
        <div class="protocol-body">
          <h3>{row.title}</h3>
          <p>{row.work}</p>
        </div>
      </div>
    ))}
  </div>
  <p>
    Between roughly 8 and 12 years of experience is often where paths genuinely diverge: some SCM
    professionals see pay accelerate sharply as they take on single-function ownership tied directly to
    cost or service-level outcomes, while others plateau if they stay in execution-heavy, purely
    operational work without adding planning, analytics, or negotiation depth.
  </p>

  <h2 id="salary-by-experience">Real salary by experience level</h2>
  <p>
    Here is the honest pay curve across the core ladder, based on current market data across Indian
    employers of varying sizes and sectors.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Experience stage</th>
          <th>Typical total pay</th>
          <th>Context</th>
        </tr>
      </thead>
      <tbody>
        {salaryExperienceRows.map((row) => (
          <tr>
            <td data-label="Experience stage">{row.stage}</td>
