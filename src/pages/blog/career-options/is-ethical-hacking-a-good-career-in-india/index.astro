  { id: "short-answer", label: "The short answer" },
  { id: "routes", label: "Five ways to be paid for hacking, ranked by scale" },
  { id: "law", label: "The law: permission, scope and disclosure" },
  { id: "credentials", label: "CEH, eJPT, PNPT, OSCP: cost and reality" },
