<BlogPostLayout
  title={title}
  seoTitle={`Is YouTube a Good Career in India? Career or Lottery Verdict`}
  seoDescription={seoDescription}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
