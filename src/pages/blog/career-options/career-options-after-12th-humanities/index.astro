const title = 'Career options after 12th humanities: the first-year decision map';
const description =
  'Career options after 12th humanities, mapped by exam deadlines, maths gates and real pay: law, design, IPM, teaching, defence and media. Plan your next move.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/career-options-after-12th-humanities/';
const publishedDateISO = '2026-09-29';
const publishedDateLabel = '29 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career strategist and writer';

const jumpLinks = [
  { id: 'answer', label: 'The direct answer' },
  { id: 'doors', label: 'The entry doors and when they close' },
  { id: 'maths-gate', label: 'The maths gate humanities students miss' },
  { id: 'cuet-subjects', label: 'CUET subjects for a humanities BA' },
  { id: 'paths', label: 'Career options after 12th humanities, ordered by headroom' },
  { id: 'stack', label: 'Stack a skill on top of the path' },
  { id: 'pay', label: 'Arts career options with salary' },
  { id: 'denominator', label: 'Read the placement number properly' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'situations', label: 'Three situations, three plans' },
