    fix: 'Decide early. Practise Class 11 to 12 maths steadily, or choose another uniformed route such as CDS after graduation.',
  },
  {
    door: 'IPMAT',
    gate: 'Quantitative Ability is a large share of a 2-hour paper, and IIM Indore\'s version includes short-answer questions that reward speed.',
    fix: 'Try a full mock paper first. A big gap now means either a serious maths plan or a different management route after a BA.',
  },
  {
    door: 'CLAT',
    gate: 'Quantitative Techniques is only about 10% of the paper and stays at school level.',
    fix: 'This is one of the few competitive exams here where a maths-shy humanities student is not penalised heavily.',
  },
];

const cuetRows = [
  {
    target: 'BA (Hons) Political Science, History, Psychology',
    combo: 'One language plus three domain subjects; History, Political Science, Sociology, Psychology and Geography all count as humanities domains.',
    tip: 'Maths is not asked. Study the subjects you actually took in Class 12, because DU says you must appear in the subjects you studied.',
  },
  {
    target: 'BA (Hons) English',
    combo: 'English from the language list plus two or three domain subjects.',
    tip: 'A strong reading habit matters more than any single domain subject here.',
  },
  {
    target: 'BA (Hons) Economics',
    combo: 'One language plus Mathematics or Applied Mathematics plus two others.',
    tip: 'The exception. Maths is compulsory.',
  },
  {
    target: 'Programmes with extra tests',
    combo: 'DU Fine Arts and Music or Physical Education add a practical or performance test alongside CUET.',
    tip: 'Read each programme line in the DU bulletin, not just the department name.',
