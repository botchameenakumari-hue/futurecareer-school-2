  },
  {
    myth: '"CLAT is a Bar Council exam held in January."',
    truth: 'CLAT is run by the Consortium of NLUs. The 2027 admission test is on 6 December 2026.',
  },
  {
    myth: '"Delhi University takes UG students through DUET."',
    truth: 'DU undergraduate admission runs through CUET UG scores and its common seat allocation process.',
  },
  {
    myth: '"Arts students cannot join the armed forces after 12th."',
    truth: 'The Army wing of NDA takes any stream. Only the Air Force and Navy wings need Physics, Chemistry and Maths, and the Maths paper applies to everyone.',
  },
  {
    myth: '"Arts and humanities are different streams."',
    truth: 'In Indian school boards they describe the same Class 11 to 12 stream. Course names differ by university, not the stream.',
  },
  {
    myth: '"Any big salary range online is what I will earn."',
    truth: 'Pay depends on the college, the year, the role and your proof. Ask for a median with a denominator.',
  },
];

const aiRows = [
  {
    path: 'Law',
    pressure: 'First-pass research, summaries and standard drafts are already speeded up by AI tools.',
