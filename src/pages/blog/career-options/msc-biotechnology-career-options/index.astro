const staySignals = [
  'A dissertation, project, or internship you finished and were genuinely proud of, not merely relieved to submit.',
  'A real attempt at CSIR-NET, GATE, or DBT-BET already made, or one seriously in progress, not just an intention.',
  'You can sustain a JRF-level stipend for several years without derailing a more urgent family or personal financial goal.',
  'Your hesitation about industry sounds like "I would rather own one deep question than execute someone else\'s process," not "industry pays too slowly."',
