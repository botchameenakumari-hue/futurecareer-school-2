const canonical =
  'https://futurecareerschool.com/blog/career-options/best-career-for-analytical-thinkers-india';
const publishedDateISO = '2026-07-10';
const publishedDateLabel = '10 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career guidance lead';

