      </div>
      <div class="gate">
        <span class="gate__num">Gate 3</span>
        <span class="gate__name">Proof of adoption</span>
        <p>Show who uses it.</p>
      </div>
    </div>
  </div>

  <h2 id="mistakes">Expensive mistakes</h2>

  <div class="mistake-list">
    <div class="mistake">
      <div class="mistake__num">01</div>
      <div>
        <div class="mistake__title">Automating a bad process</div>
