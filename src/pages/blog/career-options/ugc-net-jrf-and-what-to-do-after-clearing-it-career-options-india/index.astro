const description = "UGC NET, JRF and career options after clearing it in India: lectureship, research, funding, PhD, other jobs and honest limits.";
const seoDescription = "Plan the PhD, teaching or other route before the result arrives.";
const canonical = "https://futurecareerschool.com/blog/career-options/ugc-net-jrf-and-what-to-do-after-clearing-it-career-options-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What can I do after clearing NET?",
    "Teaching, research and related roles. Read each notice."
  ],
  [
    "What is JRF?",
    "A fellowship route for research. Verify current terms on official pages."
  ],
  [
    "How long is the result valid?",
    "Rules change. Check the official notice."
  ],
  [
    "Can I switch to non teaching jobs?",
    "Often yes with added skills."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed positions."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
