---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Career options for blind and low-vision students in India: exams, tools and eight routes ranked by growth";
const seoTitle = "Career Options for Blind and Low Vision Students in India: Exams, Tools";
const description = "Career options for blind and low-vision students in India: CBSE and exam facilities, scribe rules, tools, quotas and eight routes ranked by growth.";
const seoDescription = "Career options for blind and low-vision students in India: exam facilities, scribe rules, tools, quotas and eight routes by growth.";
const canonical = "https://futurecareerschool.com/blog/career-options/career-options-for-blind-and-low-vision-students-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  {
    "q": "What are the best career options for blind students in India?",
    "a": "There is no single best one. Software and accessibility work, writing, teaching, law, customer support, music and your own online service are all routes where screen readers and other tools are used. Choose by fit, cost and proof of work, and test the field with a small project first."
  },
  {
    "q": "Can visually impaired students study engineering or MBBS?",
    "a": "Rules are decided case by case. The NMC's 2026 guidelines for candidates with benchmark disabilities describe a competency-based assessment and say no one is ruled out solely by category or percentage, only after reasonable accommodation is considered. Check the current guidelines and the college's facilities."
  },
  {
    "q": "What help does CBSE give blind and low-vision students?",
    "a": "A CBSE circular of 24 January 2017 lists a scribe, extra time (60 minutes on a three-hour paper), screen reading software with approval, alternative questions, enlarged print and no exam fees for Classes IX to XII. Ask your school for the current circular."
  },
  {
    "q": "Is there a reservation in government jobs for blind and low-vision candidates?",
    "a": "Yes. A DoPT order of 15 January 2018 reserves 4 percent of vacancies for benchmark disabilities, with 1 percent for blindness and low vision. It applies only to posts identified as suitable."
  },
  {
    "q": "Can I use my own scribe in competitive exams?",
    "a": "A DEPwD memorandum of 10 August 2022 says a candidate may choose their own scribe or ask the exam body for one, and the Supreme Court held on 3 February 2025 that denying a scribe or compensatory time is discrimination. Read the exam notice for the exact process."
  },
  {
    "q": "How much extra time do visually impaired candidates get?",
    "a": "It depends on the exam. CBSE gives 60 minutes on a three-hour paper in its 2017 circular, and the 2014 court order on UPSC prelims says compensatory time should not be less than 20 minutes per hour for scribe users."
  },
  {
    "q": "What is the difference between blindness and low vision?",
    "a": "A CBSE circular defines low vision as acuity not exceeding 6/18 or a field of vision between 10 and 40 degrees, and treats blindness as including total absence of sight. Certification decides which category applies to you."
  },
  {
    "q": "Which screen reader should I learn?",
    "a": "NVDA is free and open source, according to its maker NV Access, and JAWS is a paid option. EnAble India lists both as common tools. Try the one your target college or employer supports."
  },
  {
    "q": "Can visually impaired people work in IT?",
    "a": "Yes. EnAble India lists software developer, technical writer and database administrator among roles held by visually impaired professionals, and a 2017 article described a training centre that placed over 500 people, including in accessibility testing."
  },
  {
    "q": "Should I tell my employer about low vision?",
    "a": "Telling your employer lets them arrange tools and accommodations, and the law protects against discrimination. The main guide to career options for students with disabilities covers what to say and when."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Blind and low-vision students in India have real career options in software and accessibility work, writing, teaching, law, support roles, audio and their own services, and the right school and exam facilities can be requested early.</strong> Tools and proof of work matter most. The decisions that unlock high income opportunities start with learning your assistive technology early and building a high-income skill portfolio.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>Ask early for exam facilities.</strong> CBSE's 2017 circular recommends applying in Class IX and XI, and scribe and extra time rules are set out for competitive exams too.</li>
      <li><strong>Learn the tools.</strong> Screen readers, magnifiers and OCR are part of your career toolkit, and NVDA is free.</li>
      <li><strong>Build proof.</strong> One finished project is the start of a skill portfolio and a faster path to financial freedom.</li>
    </ul>
  </div>

  <p>
    This guide is part of our set of <a href="/blog/career-options/">career options for every stream and degree</a>. For other disabilities, read <a href="/blog/career-options/career-options-for-deaf-and-hard-of-hearing-students-india/">career options for deaf and hard of hearing students</a> and <a href="/blog/career-options/career-options-for-students-with-dyslexia-and-learning-disabilities/">for students with dyslexia and learning disabilities</a>.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      <li><a href="#terms">Blindness and low vision</a></li>
      <li><a href="#school">School exams</a></li>
      <li><a href="#entrance">Entrance and recruitment exams</a></li>
      <li><a href="#fields">Courses and fields</a></li>
      <li><a href="#tools">Tools</a></li>
      <li><a href="#routes">Eight routes</a></li>
      <li><a href="#money">Money and fees</a></li>
      <li><a href="#checkpoint">The 4-Checkpoint Protocol</a></li>
      <li><a href="#gates">The 3 Gates</a></li>
      <li><a href="#mistakes">Expensive mistakes</a></li>
      <li><a href="#next-step">What to do next</a></li>
      <li><a href="#faq">FAQs</a></li>
    </ul>
  </nav>

  <h2 id="terms">Blindness, low vision and the paper that unlocks help</h2>

  <p>
    Indian rules treat blindness and low vision as two different categories. A CBSE circular of 24 January 2017 defines low vision as visual acuity not exceeding 6/18, or a field of vision limited to between 10 and 40 degrees, and treats blindness as including total absence of sight.
  </p>
  <p>
    Most exam facilities and the government-job quota apply to benchmark disability, which means 40 percent or more of a specified disability, certified by a competent authority. The UDID card is the document most schemes now ask for, and the <a href="/blog/career-options/career-options-for-students-with-disabilities-india/">main guide to career options for students with disabilities</a> explains how to get it.
  </p>
  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Vision loss changes how you do some tasks, and it does not decide what you can become. The honest limit is that a few professions and posts have vision or fieldwork requirements, and the rest depend on tools, practice and an employer who knows how to make work accessible. Learn the tools early, because that is the biggest lever you control.
    </p>
  </div>

  <h2 id="school">School board exams: what CBSE provides</h2>

  <p>
    CBSE's circular of 24 January 2017 lists these facilities for visually impaired candidates. Boards update circulars, so ask your school for the version in force this year.
  </p>
  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Facility</th>
          <th>What the circular says</th>
          <th>What to do</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Facility"><strong>Scribe and extra time</strong></td>
          <td data-label="What the circular says">A scribe, extra time or both. For a three-hour paper the extra time is 60 minutes. The candidate may choose their own scribe, and the scribe should not hold qualifications in the subject.</td>
          <td data-label="What to do">Ask the school to record your choice during registration.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>Screen reading software</strong></td>
          <td data-label="What the circular says">Permitted, with prior Board approval, and a computer or typewriter may be used to write answers.</td>
          <td data-label="What to do">Apply for approval early and practise on the exam setup.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>Calculators</strong></td>
          <td data-label="What the circular says">The circular says calculators are not permitted in any Board examination.</td>
          <td data-label="What to do">Practise mental and written maths methods.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>Fees</strong></td>
          <td data-label="What the circular says">The circular says registration and examination fees are not charged from visually impaired students for Classes IX to XII.</td>
          <td data-label="What to do">Ask the school to confirm for your year.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>Question papers (Class X)</strong></td>
          <td data-label="What the circular says">Alternative questions replace those with visual input in English Communicative and Social Science. Enlarged print is available in Mathematics and Science.</td>
          <td data-label="What to do">State large print or alternative questions in your request.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>Science practicals (Class XII)</strong></td>
          <td data-label="What the circular says">Separate multiple-choice papers replace practicals in Physics, Chemistry and Biology, and the papers in those subjects and Mathematics carry no visual input.</td>
          <td data-label="What to do">Check how the practical marks are given in your subject.</td>
        </tr>
        <tr>
          <td data-label="Facility"><strong>How to apply</strong></td>
          <td data-label="What the circular says">Parents submit a request through the school with a medical certificate. The circular recommends applying in Class IX and XI, and only students recorded in those classes are considered.</td>
          <td data-label="What to do">Do not wait for Class X or XII.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="note-line">
    Source: CBSE circular dated 24 January 2017, read on 30 October 2026. The circular does not mention Braille or abacus use.
  </p>

  <h2 id="entrance">Entrance and recruitment exams: scribes and extra time</h2>

  <p>
    Competitive exams have their own rules, and the notice for each exam is the final word. These documents give a baseline.
  </p>
  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Document</th>
          <th>What it says</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Document"><strong>Court order on UPSC prelims for visually impaired candidates, 19 August 2014</strong></td>
          <td data-label="What it says">Compensatory time should not be less than 20 minutes per hour for candidates using a scribe. Candidates not using a scribe should get at least one extra hour on a three-hour paper. Candidates may choose the mode, including Braille, computer, large print or recorded answers, and low-vision candidates may ask for larger print.</td>
        </tr>
        <tr>
          <td data-label="Document"><strong>DEPwD Office Memorandum of 10 August 2022</strong></td>
          <td data-label="What it says">For persons with specified disabilities who have difficulty in writing, compensatory time of not less than 20 minutes per hour. A candidate may choose their own scribe or ask the exam body for one. The own scribe should be one step below the candidate's qualification.</td>
        </tr>
        <tr>
          <td data-label="Document"><strong>Supreme Court, Gulshan Kumar v. IBPS (3 February 2025)</strong></td>
          <td data-label="What it says">The Court said denying a scribe or compensatory time constitutes discrimination under the RPwD Act, 2016, and directed the ministry to revisit and re-notify the 2022 memorandum.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Practical steps: apply for the facility at the time of the exam application, attach the disability certificate in the format the notice asks for, and meet your scribe in advance. The 2022 memorandum allows meeting the scribe two days before the exam.
  </p>
  <p class="note-line">
    Facilities for candidates with 40 percent or more disability are in separate guidelines, which we did not read in full. Read the exam notice.
  </p>

  <h2 id="fields">Courses and fields: what to check</h2>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Field</th>
          <th>What published sources show</th>
          <th>What to check</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Field"><strong>Medicine (MBBS)</strong></td>
          <td data-label="What published sources show">The NMC's 2026 guidelines for admission of candidates with benchmark disabilities describe a competency-based, function-oriented assessment. They say no one is declared eligible or ineligible solely on category or percentage, and ineligibility must be decided after reasonable accommodation, with written reasons.</td>
          <td data-label="What to check">Read the current NMC guidelines and the counselling instructions, and ask for the functional assessment early.</td>
        </tr>
        <tr>
          <td data-label="Field"><strong>Software, data and accessibility testing</strong></td>
          <td data-label="What published sources show">EnAble India lists software developer, technical writer, database administrator and customer service among roles held by visually impaired professionals. A 2017 article described Nabet India training and placing over 500 visually impaired people, including in accessibility testing.</td>
          <td data-label="What to check">Check that the tools you need work with a screen reader and that the employer supports it.</td>
        </tr>
        <tr>
          <td data-label="Field"><strong>Banking and government posts</strong></td>
          <td data-label="What published sources show">Government reservation is 4 percent, with 1 percent for blindness and low vision, and it applies only to posts identified as suitable.</td>
          <td data-label="What to check">Read the identified-post list in each notice.</td>
        </tr>
        <tr>
          <td data-label="Field"><strong>Law, humanities and teaching</strong></td>
          <td data-label="What published sources show">These fields rely on reading, writing, argument and communication, which screen readers and recorded material support.</td>
          <td data-label="What to check">Check access to digital study material and the exam format.</td>
        </tr>
        <tr>
          <td data-label="Field"><strong>Music, performance and media</strong></td>
          <td data-label="What published sources show">Audio-led skills are a natural fit for some students, and success depends on talent and proof of work.</td>
          <td data-label="What to check">Build a recorded portfolio and test it with real audiences.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="tools">Tools worth learning early</h2>

  <p>
    Employers and colleges expect you to work with assistive technology, so learning it early is a real advantage.
  </p>
  <ul class="check-list">
    <li>A screen reader. NVDA is free and open source, according to its maker NV Access, and JAWS is a paid alternative; EnAble India lists both.</li>
    <li>A screen magnifier and large-font settings, if you have low vision.</li>
    <li>Scanner with OCR software to convert printed material to text.</li>
    <li>Keyboard shortcuts for the office, email and coding tools you will use.</li>
    <li>A note-taker or recording method that suits how you study.</li>
  </ul>
  <p>
    Practise on the same software your target college or employer uses. Ask whether their systems work with your tools before you accept an offer.
  </p>

  <h2 id="routes">Eight routes, strongest growth first</h2>

  <p>
    The routes are ordered by how far visible skill can lift income, with rank-based routes last. Each names who pays, the main hurdle and the next move.
  </p>
  <div class="route-grid">
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">01</span>
        <span class="chip chip--high">Scalable</span>
      </div>
      <h3>Software, data and accessibility work</h3>
      <p class="route-card__why">Screen-reader based work is common in software and testing roles, and clients pay for finished, working products. Accessibility testing is a field where lived experience is an asset.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Software firms, startups and clients who need accessible products.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>A live project, a clear explanation and test reports.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Entry-level coding tasks are the first that AI tools absorb. Aim for judgement work, such as testing and analysis for a real product.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Learn one language or an accessibility testing stack, build three projects for one industry and take small paid work. First sales skill: one line saying who your work helps.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">02</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Writing, content and communication</h3>
      <p class="route-card__why">Screen readers support writing and editing, and written work is easy to share as proof.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Brands, publishers and clients who need clear content.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Published pieces and client references.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>AI drafts basic text now, so your edge is knowledge, voice and reliability.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Pick a niche, build a portfolio and offer fixed-price packages.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">03</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Teaching, tutoring and training</h3>
      <p class="route-card__why">Tutoring and training can start with a few students and grow into your own batch.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Students, parents, schools and training firms.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Student results and recommendations.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Teaching jobs have their own qualification rules, such as the teacher eligibility tests.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Start with one subject and ask each student for a referral.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">04</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Law, policy and advocacy</h3>
      <p class="route-card__why">Reading, argument and speech are core, and tools support the reading load.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Firms, organisations and clients.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Moot or internship records and written work.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Law has its own degree and registration rules.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Build a track record in one area, such as disability or consumer law.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">05</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Customer support, operations and HR</h3>
      <p class="route-card__why">Phone and email work suit many assistive setups, and employers hire on communication and reliability.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>IT/ITES firms, banks and service companies.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Supervisor references and quality scores.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Pay starts modest. Ask about the first promotion step.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Move toward team lead, training or operations.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">06</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Own business and local services</h3>
      <p class="route-card__why">Audio, tuition, food, resale and online services can start small.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Local customers and online clients.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Repeat orders and word of mouth.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Do not borrow heavily before customers have paid you.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Start with one service, keep a customer list and ask for referrals.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">07</span>
        <span class="chip chip--mid">Scalable with a business layer</span>
      </div>
      <h3>Music, audio and media</h3>
      <p class="route-card__why">Audio skills can be a career or a side income.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Studios, schools, event organisers and audiences.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Recorded work and performance records.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>A narrow field where talent and proof count. Keep a skill that earns steadily.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Build a recorded portfolio and take small paid performances.</p>
    </div>
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">08</span>
        <span class="chip chip--low">Not so scalable</span>
      </div>
      <h3>Government and public-sector exams</h3>
      <p class="route-card__why">Selection is by ranked exams, and 1 percent of reserved vacancies are for blindness and low vision in identified posts.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Central and state departments, as each notice states.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Your exam rank and documents.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Two hard stages: a competitive written exam and a limited number of identified posts. Keep a parallel skill.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Read the identified-post list, practise with your scribe arrangement and set a review date with your family.</p>
    </div>
  </div>
  <div class="highlight-box highlight-box--teal">
    <p>
      <strong>The ownership path:</strong> a small online service, such as accessibility testing, transcription, tutoring or content writing, built on tools you already use.
    </p>
    <p>
      Write the price and what is included for every job. Keep a client list and add a partner when orders exceed your hours.
    </p>
  </div>

  <h2 id="money">Money, scholarships and fee traps</h2>

  <p>
    As a rule of thumb and not a research finding, keep a degree fee near a tenth of the family's total education budget, and treat spending above roughly a fifth as a serious caution. Reserve money for assistive technology, which is part of your career toolkit.
  </p>
  <p>
    Look for government scholarships for students with disabilities on the National Scholarship Portal, and check each scheme's conditions. Be careful with centres that promise guaranteed placement for a fee.
  </p>
  <p class="note-line">
    We give no salary figures because we found no dependable source. Read live job ads and ask people in the work.
  </p>

  <h2 id="checkpoint">The 4-Checkpoint Protocol for choosing a field</h2>

  <p>
    Test each route with <strong>The 4-Checkpoint Protocol</strong>: Biology, Context, Market and Survival.
  </p>
  <div class="protocol">
    <div class="protocol-row">
      <div class="protocol-row__num">01</div>
      <div>
        <div class="protocol-row__title">Biology: what can you do well with your tools?</div>
        <p>Try the real daily tasks with your assistive setup for a week. A realistic test is better than assumptions in either direction.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">02</div>
      <div>
        <div class="protocol-row__title">Context: time, money and home support</div>
        <p>Count the cost of assistive technology, travel and study material, and who will support you.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">03</div>
      <div>
        <div class="protocol-row__title">Market: do employers hire for this?</div>
        <p>Read ten notices or talk to three people already in the work. Note tools used and the accommodation they needed.</p>
      </div>
    </div>
    <div class="protocol-row">
      <div class="protocol-row__num">04</div>
      <div>
        <div class="protocol-row__title">Survival: what survives AI?</div>
        <p>Routine tasks shrink first. Pick work that needs judgement, domain knowledge and customer contact.</p>
      </div>
    </div>
  </div>

  <h2 id="gates">The 3 Gates: proof before commitment</h2>

  <p>
    <strong>The 3 Gates</strong> check that your effort turns into work other people rely on.
  </p>
  <div class="gates-block">
    <div class="gates-row">
      <div class="gate">
        <span class="gate__num">Gate 1</span>
        <span class="gate__name">Proof of skill</span>
        <p>Finish one small project using your own tools, and record how you did it.</p>
      </div>
      <div class="gate">
        <span class="gate__num">Gate 2</span>
        <span class="gate__name">Proof you can explain it</span>
        <p>Describe it in two minutes to someone outside the field.</p>
      </div>
      <div class="gate">
        <span class="gate__num">Gate 3</span>
        <span class="gate__name">Proof someone will pay</span>
        <p>Offer it to three people and note what they would pay.</p>
      </div>
    </div>
  </div>

  <h2 id="mistakes">Expensive mistakes</h2>

  <div class="mistake-list">
    <div class="mistake">
      <div class="mistake__num">01</div>
      <div>
        <div class="mistake__title">Waiting until Class X or XII to ask for facilities</div>
        <p>The CBSE circular recommends applying in Class IX and XI.</p>
      </div>
    </div>
    <div class="mistake">
      <div class="mistake__num">02</div>
      <div>
        <div class="mistake__title">Learning tools late</div>
        <p>Screen reader fluency takes practice. Start before college.</p>
      </div>
    </div>
    <div class="mistake">
      <div class="mistake__num">03</div>
      <div>
        <div class="mistake__title">Ignoring the identified-post list</div>
        <p>Reserved posts apply only where the post is identified as suitable.</p>
      </div>
    </div>
    <div class="mistake">
      <div class="mistake__num">04</div>
      <div>
        <div class="mistake__title">Paying for a placement promise</div>
        <p>No centre can guarantee a job. Ask for verified outcomes.</p>
      </div>
    </div>
    <div class="mistake">
      <div class="mistake__num">05</div>
      <div>
        <div class="mistake__title">Letting others choose for you</div>
        <p>Test the field yourself with a small project.</p>
      </div>
    </div>
  </div>

  <h2 id="next-step">What to do next</h2>

  <p>
    Get your UDID and disability certificate in order, ask your school or college for the facilities you will need, and begin practising with a screen reader or magnifier on a real task. Start one small project beside your studies.
  </p>
  <p>
    A specialist can look at your interests, tools and family situation with you. A sensible first step is <a href="/services/career-counselling-and-career-guidance/student-career-guidance/">student career guidance</a>. The aim is skills that pay well and an earlier path to financial freedom.
  </p>

