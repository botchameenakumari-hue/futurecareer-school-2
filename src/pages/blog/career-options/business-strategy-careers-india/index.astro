          <td data-label="Our read">Strong</td>
          <td data-label="Why">It builds trust.</td>
        </tr>
        <tr>
          <td data-label="Type of graduate"><strong>Targeting varied roles</strong></td>
          <td data-label="Our read">Good</td>
          <td data-label="Why">Entry is competitive.</td>
        </tr>
        <tr>
          <td data-label="Type of graduate"><strong>Generic frameworks</strong></td>
          <td data-label="Our read">Risky</td>
          <td data-label="Why">They add little.</td>
        </tr>
      </tbody>
    </table>
