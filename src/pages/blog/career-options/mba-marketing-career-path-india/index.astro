        <tr>
          <td data-label="Type of graduate"><strong>Customer insight work</strong></td>
          <td data-label="Our read">Strong</td>
          <td data-label="Why">It guides decisions.</td>
        </tr>
        <tr>
          <td data-label="Type of graduate"><strong>Digital skills with analytics</strong></td>
          <td data-label="Our read">Good</td>
          <td data-label="Why">Widely used.</td>
        </tr>
        <tr>
          <td data-label="Type of graduate"><strong>Roles with no measurement</strong></td>
          <td data-label="Our read">Risky</td>
          <td data-label="Why">Little growth.</td>
        </tr>
      </tbody>
    </table>
  </div>

