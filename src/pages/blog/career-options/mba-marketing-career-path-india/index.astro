          <td data-label="Number to watch">Leads or trials</td>
        </tr>
        <tr>
          <td data-label="Stage"><strong>Purchase</strong></td>
          <td data-label="Question">Did they buy?</td>
          <td data-label="Number to watch">Orders and revenue</td>
