  <h2 id="briefs">A one-page campaign brief that managers respect</h2>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Line</th>
          <th>What to write</th>
          <th>Check</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Line"><strong>Goal</strong></td>
          <td data-label="What to write">One measurable result</td>
          <td data-label="Check">Is there a number and a date?</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Audience</strong></td>
          <td data-label="What to write">Who exactly, in one sentence</td>
          <td data-label="Check">Could you find ten of them this week?</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Message</strong></td>
          <td data-label="What to write">One promise and one proof</td>
          <td data-label="Check">Is the proof real?</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Channels</strong></td>
          <td data-label="What to write">Two at most to start</td>
          <td data-label="Check">Can you afford to test both?</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Budget and test</strong></td>
          <td data-label="What to write">Small spend and a stop rule</td>
          <td data-label="Check">What result would make you stop?</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="mistakes2">Marketing mistakes that waste a fresher first year</h2>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Mistake</th>
          <th>What happens</th>
          <th>Better move</th>
        </tr>
      </thead>
      <tbody>
        <tr>
