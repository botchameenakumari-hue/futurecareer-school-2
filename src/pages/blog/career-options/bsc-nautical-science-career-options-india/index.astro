    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Check</th>
          <th>Why it matters</th>
          <th>How to verify</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Check"><strong>Course approval</strong></td>
          <td data-label="Why it matters">Only approved programmes lead to sea service eligibility</td>
          <td data-label="How to verify">Check the official approval list</td>
        </tr>
        <tr>
          <td data-label="Check"><strong>Sponsorship and placement claims</strong></td>
          <td data-label="Why it matters">Promises are often not guaranteed</td>
          <td data-label="How to verify">Ask for terms in writing and speak to past students</td>
        </tr>
        <tr>
          <td data-label="Check"><strong>Medical fitness</strong></td>
          <td data-label="Why it matters">Sea service has fitness standards</td>
          <td data-label="How to verify">Check the official standards before enrolling</td>
        </tr>
        <tr>
          <td data-label="Check"><strong>Total cost</strong></td>
          <td data-label="Why it matters">Fees, travel, equipment and gaps add up</td>
          <td data-label="How to verify">Ask for a full written cost list</td>
        </tr>
        <tr>
          <td data-label="Check"><strong>Alternatives if sea service does not start</strong></td>
          <td data-label="Why it matters">Plan B protects the family budget</td>
          <td data-label="How to verify">Ask what shore roles past students joined</td>
        </tr>
      </tbody>
    </table>
  </div>

