  <h2 id="cost">A cost and risk worksheet for families</h2>

  <p>
    Use this worksheet before paying any deposit. Fill every row from written quotes.
  </p>
  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Item</th>
          <th>Amount to ask for in writing</th>
          <th>Risk to check</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Item"><strong>Tuition and hostel</strong></td>
          <td data-label="Amount to ask for in writing">Total for each year</td>
          <td data-label="Risk to check">Refund rules if you withdraw</td>
        </tr>
        <tr>
          <td data-label="Item"><strong>Uniform, books and equipment</strong></td>
          <td data-label="Amount to ask for in writing">One-time and yearly costs</td>
          <td data-label="Risk to check">Compulsory purchase from one seller</td>
        </tr>
        <tr>
          <td data-label="Item"><strong>Medical and documents</strong></td>
