  { id: "mistakes", label: "Expensive mistakes" },
  { id: "next-step", label: "What to do next" },
  { id: "faq", label: "FAQs" },
];

const strands = [
  {
    name: "Dyslexia",
    body: "Mainly reading and spelling. Words are slow to decode, and spelling errors stay even when the person understands the idea well.",
    watch: "Reading-heavy exams and long written reports cost the most time. Listening, speaking and visual thinking are often not affected.",
  },
  {
    name: "Dysgraphia",
    body: "Mainly handwriting and getting thoughts onto paper. Writing is slow, tiring or hard to read, even when typing is easier.",
    watch: "Handwritten exams are the biggest barrier. A computer, voice typing or a scribe can change the result.",
  },
  {
    name: "Dyscalculia",
    body: "Mainly numbers: place value, arithmetic, reading graphs, remembering number facts.",
    watch: "Maths-heavy courses and timed calculation hurt. Many people still do well with a calculator, a spreadsheet and visual models.",
  },
];

const certSteps = [
  {
    n: "1",
    title: "Get assessed by the right specialist",
    body: "The Ministry of Social Justice guidelines (S.O. 76(E), 4 January 2018, amended by S.O. 4501(E) on 9 December 2020) say the NIMHANS Battery is used for the diagnostic test for specific learning disability. The amendment added a psychiatrist to the list that includes a paediatrician and a paediatric neurologist.",
