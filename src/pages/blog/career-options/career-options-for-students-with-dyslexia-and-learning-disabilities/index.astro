const examRows = [
  {
    body: "CBSE school boards",
    help: "The circular of 24 January 2017 lists dyslexic candidates among those who can use a scribe, extra time or both, and who can take one compulsory language instead of two in Class X. A later CBSE manual (December 2024) lists extra time, a scribe or reader, a computer or laptop without internet and basic calculators for eligible students, and asks you to upload a supporting disability document (PDF, up to 2 MB) on the portal.",
