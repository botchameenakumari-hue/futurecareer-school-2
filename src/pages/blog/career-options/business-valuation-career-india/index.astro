          <td data-label="Alternative"><strong>Equity research route</strong></td>
          <td data-label="Why it can beat it">Public company focus</td>
          <td data-label="Catch">Competitive</td>
        </tr>
        <tr>
          <td data-label="Alternative"><strong>Audit route</strong></td>
          <td data-label="Why it can beat it">Rule-based</td>
          <td data-label="Catch">Hours</td>
        </tr>
        <tr>
          <td data-label="Alternative"><strong>Corporate finance route</strong></td>
