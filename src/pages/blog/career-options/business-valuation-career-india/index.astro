          <td data-label="Skill used">Reading financial statements</td>
        </tr>
        <tr>
          <td data-label="Stage"><strong>Choose methods</strong></td>
          <td data-label="What happens">Pick approaches that suit the business</td>
          <td data-label="Skill used">Judgment about fit</td>
        </tr>
        <tr>
          <td data-label="Stage"><strong>Build the model</strong></td>
          <td data-label="What happens">Project cash flows and compare with peers</td>
          <td data-label="Skill used">Spreadsheet modelling</td>
        </tr>
        <tr>
          <td data-label="Stage"><strong>Test assumptions</strong></td>
          <td data-label="What happens">Change inputs and see the range</td>
          <td data-label="Skill used">Sensitivity analysis</td>
        </tr>
        <tr>
          <td data-label="Stage"><strong>Write the report</strong></td>
          <td data-label="What happens">Explain method, assumptions and limits</td>
          <td data-label="Skill used">Clear writing</td>
        </tr>
      </tbody>
    </table>
  </div>

