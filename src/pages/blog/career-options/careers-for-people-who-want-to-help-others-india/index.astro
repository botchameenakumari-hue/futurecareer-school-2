  { track: 'NGO & development-sector program work', credential: 'No fixed degree; MSW/MPH/development studies common', ceiling: 'Highest senior ceiling (Country Director, MEL Director)', risk: 'High funding precarity, FCRA and policy exposure, low entry pay' },
  { track: 'Public health & disaster response', credential: 'MPH (public health) or paramilitary-force entry (NDRF)', ceiling: 'Solid govt/multilateral ceiling; NDRF pay via central pay scale', risk: 'Field, outbreak, or disaster deployment risk; high responsibility' },
];

const aiPoints = [
  {
    label: 'Where AI is already doing the grunt work',
    body: 'Automated triage prompts, draft clinical or case-note documentation, diagnostic-image pre-screening, first-line mental-health chatbot check-ins, and welfare-scheme eligibility screening are exactly the repetitive layer of helping work that software now handles faster than a person working alone - the paperwork and pattern-matching layer, not the moment of actually caring for someone.',
  },
  {
    label: 'Where human judgment still gets paid',
    body: 'Physical touch and bedside presence, a real crisis judgment call, building enough trust that someone tells a therapist or caseworker the truth, sitting with a grieving family, and negotiating with a resistant community during a development project are not templated tasks - which is exactly why the World Economic Forum keeps empathy, service orientation, and care work on its list of durable, growing skills rather than shrinking ones.',
  },
];

const mistakeCards = [
