    tags: ['Justice + Scale signal', 'MSW preferred, not always mandatory', 'steady govt route via welfare posts'],
    tone: 'purple',
  },
  {
    badge: 'Track 5',
    title: 'NGO and development-sector program work',
    body: 'Entry-level NGO roles pay as little as Rs 12,000-25,000 a month, but the senior ceiling is real: a Programme Director at a large NGO can earn Rs 15-30 lakh a year, an MEL (monitoring, evaluation and learning) Director can clear Rs 22-45 lakh, and a Country Director at an international NGO can reach Rs 25-60 lakh a year.',
    tags: ['Scale + Justice signal', 'no fixed degree gate', 'funding-dependent, highest senior ceiling'],
    tone: 'teal',
  },
  {
    badge: 'Track 6',
    title: 'Public health, epidemiology and disaster response',
    body: 'Epidemiologists at NCDC or state surveillance units start around Rs 6-8.5 lakh a year, rising to Rs 12-18 lakh at ICMR or WHO India after real field experience. The parallel physical-response route through the NDRF pays an average near Rs 12.3 lakh a year, entered only through the paramilitary forces, not direct recruitment.',
    tags: ['Scale + Crisis signal', 'MPH or paramilitary-force entry', 'govt and multilateral pay scale'],
    tone: 'gold',
  },
];

const trackComparisonRows = [
  { track: 'Nursing & bedside clinical care', credential: 'GNM/B.Sc Nursing + state nursing council registration', ceiling: 'Solid govt ceiling with allowances; private ceiling far lower', risk: 'Physically and emotionally heavy, shift-based, ratio-driven overload' },
  { track: 'Allied health & rehabilitation', credential: 'BPT/BOT + state council registration (2021 Allied Health Act)', ceiling: 'Moderate; rises with private practice or specialisation', risk: 'Fragmented regulation, huge unmet demand, low starting pay' },
