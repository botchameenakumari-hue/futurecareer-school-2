const publishedDateISO = '2026-07-10';
const publishedDateLabel = '10 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career guidance lead';

const jumpLinks = [
