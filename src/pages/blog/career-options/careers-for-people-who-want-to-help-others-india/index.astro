const proofTable = [
  { track: 'Nursing & bedside clinical care', proof: 'One documented, anonymised patient-care case showing a measurable improvement in recovery, comfort, or safety - not a general "I am caring" claim.' },
  { track: 'Allied health & rehabilitation', proof: 'One rehab case log showing a real patient\'s functional improvement across a course of therapy, with before-and-after notes.' },
  { track: 'Counselling & clinical psychology', proof: 'One supervised, properly anonymised case summary or practicum log showing a documented therapeutic outcome - not a personality-test screenshot.' },
  { track: 'Social work & welfare casework', proof: 'One real case file or welfare-scheme enrolment drive with a documented before-and-after for a specific family or child, not a vague community-impact claim.' },
  { track: 'NGO & development-sector program work', proof: 'One programme or MEL report showing a real, measurable outcome - people reached, an indicator moved, funding secured - not an internship certificate.' },
  { track: 'Public health & disaster response', proof: 'One surveillance report, outbreak-response log, or disaster-deployment record with a documented action and outcome, not just "I was on the team."' },
];

const testItems = [
  { num: 'Check 1', title: 'Run the Proximity/Scale test for real', body: 'Spend real time doing hands-on, one-to-one support - shadow a nurse or counsellor, sit in on one family\'s casework - and separately spend real time on one systems-level task, like helping an NGO read a report or looking at one public-health dataset. Notice honestly which one you keep thinking about afterward.' },
  { num: 'Check 2', title: 'Run the Crisis/sustained test', body: 'Compare a short, intense burst of helping (a health camp, a relief drive) against a longer, slower one (regular shadowing with one caseworker or counsellor over several weeks). Notice which one you can genuinely imagine doing for years, not just once.' },
  { num: 'Check 3', title: 'Check the real weekly rhythm of one shortlisted track', body: 'Talk to someone actually doing the job - a nurse, a caseworker, an MEL manager, an epidemiologist - about what an ordinary week looks like, not the job title\'s reputation. A counselling role built mostly around case notes, referrals, and back-to-back reporting, with far less direct client conversation than the title implies, is a different job than it sounds like on paper.' },
  { num: 'Check 4', title: 'Build one small piece of track-specific proof', body: 'One case note, one small volunteering report, or one documented shadow-day log beats another stretch of assuming you would be good at this. Give it whatever amount of consistent effort genuinely fits your schedule - some people test this in a short stretch, others need longer, and both are normal.' },
