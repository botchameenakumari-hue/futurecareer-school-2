const publishedDateISO = '2026-07-06';
const publishedDateLabel = '6 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-the-job-is', label: 'What a financial analyst actually does' },
  { id: 'four-lanes', label: 'The 4 lanes: FP&A, equity research, corporate finance, credit' },
  { id: 'entry-qualifications', label: 'Entry qualifications: BCom, MBA, CFA' },
  { id: 'progression-ladder', label: 'The progression ladder, title by title' },
  { id: 'salary-by-experience', label: 'Real salary by experience level' },
  { id: 'salary-by-sector', label: 'Salary by sector and employer type' },
  { id: 'vs-investment-banking', label: 'Financial analyst vs investment banking: the hours' },
  { id: 'skills', label: 'The skills that actually get you hired' },
  { id: 'certifications', label: 'CFA, FMVA, and NISM: which one, and when' },
