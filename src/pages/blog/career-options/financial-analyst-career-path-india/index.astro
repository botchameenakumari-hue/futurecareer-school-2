  { id: 'gates', label: 'The 3 Gates before you apply' },
  { id: 'mistakes', label: 'Mistakes that stall people on this path' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const laneCards = [
  {
    badge: 'Lane 1',
    title: 'FP&A (Financial Planning & Analysis)',
    body: 'You work inside a company, building budgets, rolling forecasts, and variance reports that tell leadership whether the business is on track. You are the internal consultant translating raw numbers into a plan the CFO can act on.',
    fit: 'You like structure, recurring cycles (monthly close, quarterly forecast, annual budget), and explaining "why" a number moved to people who are not finance experts.',
    caution: 'FP&A is currently the single largest hiring function inside India\'s Global Capability Centres, which is good for openings but means the bar for Excel and storytelling skill keeps rising as more people compete for the same seats.',
    tags: ['Steadiest hours', 'Highest GCC demand'],
  },
  {
    badge: 'Lane 2',
    title: 'Equity research analyst',
    body: 'You study a handful of stocks or one sector deeply, build valuation models, and publish buy/sell/hold recommendations that investors and fund managers actually trade on. Earnings calls, sector news, and company filings are your daily raw material.',
    fit: 'You enjoy forming a strong, defensible opinion about a company\'s future and can handle being publicly wrong sometimes when the market moves against your call.',
    caution: 'Publishing research in India legally requires SEBI\'s NISM-Series-XV Research Analyst certification — this is not optional paperwork, it is a regulatory gate you must clear before your name goes on a report.',
    tags: ['Needs NISM certification', 'Sector specialisation'],
  },
  {
    badge: 'Lane 3',
    title: 'Corporate finance analyst',
    body: 'You sit inside a company\'s finance or strategy team evaluating capital projects, M&A targets, capital structure decisions, and internal investment cases — should we build the new plant, buy the smaller competitor, or refinance the debt.',
    fit: 'You want variety across projects rather than one repeating cycle, and you like being in the room when leadership actually decides where company money goes.',
    caution: 'Deal flow is lumpier than FP&A\'s calendar-driven rhythm — some quarters are quiet, others compress a quarter of work into three weeks around a live transaction.',
    tags: ['Project-based variety', 'M&A and capex exposure'],
  },
  {
    badge: 'Lane 4',
    title: 'Credit analyst',
    body: 'You evaluate whether a company, bank borrower, or bond issuer can actually repay what it owes, by digging into revenue quality, debt load, cash flow coverage, and repayment history, then assign or recommend a risk rating.',
    fit: 'You are comfortable being the person who says "no" or "not at this price" when a deal looks attractive to everyone else in the room, and you like methodical, evidence-first judgment calls.',
    caution: 'Credit analysis skews more procedural and compliance-heavy than equity research — the ceiling exists (rating agencies, bank credit risk teams, NBFC underwriting), but the day-to-day has less room for a strong personal market view.',
    tags: ['Rating agencies + banks + NBFCs', 'Risk-first mindset'],
  },
];

const entryRows = [
  {
    route: 'BCom / BBA / B.Sc Finance (bachelor\'s degree)',
    detail: 'The baseline entry qualification for almost every financial analyst opening in India. A finance, accounting, economics, or business degree plus strong Excel and financial-statement-reading skill is enough to get shortlisted for junior analyst and FP&A trainee roles at most companies.',
  },
  {
    route: 'MBA (Finance specialisation)',
    detail: 'Not required to enter, but it meaningfully accelerates the jump to senior analyst or manager-level FP&A and corporate finance roles, especially at larger companies and GCCs, because it signals broader business judgment beyond spreadsheet mechanics.',
  },
  {
    route: 'CFA (Chartered Financial Analyst)',
    detail: 'Globally recognised for equity research, asset management, and investment-decision roles. Three exam levels, roughly 300 study hours per level, and 4,000 hours of qualifying investment-decision work experience across at least 36 months before you can use the charter. Level 1 pass rates run roughly 35-45%.',
  },
  {
    route: 'NISM-Series-XV Research Analyst Certification',
    detail: 'A SEBI-mandated exam through the National Institute of Securities Markets. If your work involves preparing or publishing equity research reports in India, this is a legal requirement, not an optional credential.',
  },
  {
    route: 'FMVA (Financial Modeling & Valuation Analyst) or similar',
    detail: 'A practical, cheaper add-on (roughly Rs 20,000-80,000 in India, 120-200 study hours) that teaches the modelling mechanics faster than self-teaching. It signals day-one readiness on modelling tools but does not replace a defensible model an interviewer can actually question you on.',
  },
];

const progressionRows = [
  {
    title: 'Junior / Trainee Financial Analyst',
    years: '0-2 years',
    work: 'Data collection, basic variance analysis, maintaining existing models and reports, learning the company\'s chart of accounts and reporting calendar under supervision.',
  },
  {
    title: 'Financial Analyst',
    years: '2-4 years',
    work: 'Owns specific reports and models end to end, builds forecasts with light supervision, starts presenting findings to department heads rather than only to the senior analyst.',
  },
  {
    title: 'Senior Financial Analyst',
    years: '4-7 years',
    work: 'Leads complex analysis and cross-functional projects, builds the financial models leadership actually uses for decisions, mentors junior analysts, and starts shaping recommendations rather than only reporting numbers.',
  },
  {
    title: 'Finance Manager / FP&A Manager',
    years: '7-10 years',
    work: 'Owns a full planning cycle or a business unit\'s finance function, manages a small team of analysts, and translates the model into a narrative the CFO or business head can act on.',
  },
  {
    title: 'Associate Director / Director of Finance',
    years: '10-15+ years',
    work: 'Sets the financial planning agenda for a function or region, works directly with senior leadership on long-term strategy, and is judged on business outcomes as much as analytical accuracy.',
  },
];

const salaryExperienceRows = [
  {
    stage: 'Entry-level, under 1 year',
    range: 'Rs 3.5-6 LPA',
    context: 'Typical starting range at most Indian companies for a BCom/BBA/MBA fresher with strong Excel skill; can run higher with a modelling portfolio or internship on the resume.',
  },
  {
    stage: 'Early career, 1-4 years',
    range: 'Rs 5.5-9 LPA',
    context: 'Reasonable growth range once you have owned at least one full budgeting or forecasting cycle independently.',
  },
  {
    stage: 'Mid-career, 4-8 years',
    range: 'Rs 9-18 LPA',
    context: 'Senior Financial Analyst / early Finance Manager territory; GCCs and larger corporates commonly pay at the higher end of this band for candidates with CFA or a strong modelling record.',
  },
