    stage: 'Senior, 8-15 years',
    range: 'Rs 18-35 LPA',
    context: 'Finance Manager to Director-level FP&A or corporate finance roles; CFA charterholders with 8+ years of experience commonly cross Rs 40 LPA when equity research or asset management is part of the mix.',
  },
  {
    stage: 'Late career, 15+ years',
    range: 'Rs 35-70 LPA+',
