const reraSteps = [
  { num: "01", title: "Check what your state requires", body: "Registration is state by state. Each state's Real Estate Regulatory Authority (RERA) portal lists the agent form, the documents and the fee. Fees differ and the guides we read disagreed, so print none and read the portal." },
  { num: "02", title: "Do the training and exam if your state asks for it", body: "Maharashtra now requires agents to complete training, pass an exam and upload a certificate of competency to the regulator. Other states may add their own rules." },
  { num: "03", title: "Apply and wait for the certificate", body: "The authority is expected to issue the certificate within 30 days of a complete application, or the application is treated as registered if it is not rejected. Registration lasts five years and is renewed in the last 60 days before expiry." },
  { num: "04", title: "Show the number every time", body: "Display the certificate at your office. Quote your number, and the project's own registration number, on adverts, marketing and sale papers." },
  { num: "05", title: "Sell only registered projects", body: "Do not facilitate a sale in a project that needs registration and has none. Keep books and records for each project you work on, and give the person buying the information and documents they are entitled to." },
];

const reraFacts = [
  { label: "Penalty", detail: "An agent who breaks the registration or duty rules faces Rs 10,000 for each day the default continues, up to a total of 5% of the cost of the plot, apartment or building." },
  { label: "Maharashtra, May 2024", detail: "About 47,000 agents had registered since 2017. About 13,785 were cancelled for not renewing. About 20,000 more were suspended for a year for missing the certificate of competency, leaving about 13,000 valid. The regulator also warned developers against using unqualified agents." },
  { label: "Which projects", detail: "The Act asks for registration of projects above 500 square metres of land or eight apartments. States read this differently: Rajasthan's authority held in March 2022 that meeting either limit is enough. Ask your state authority about a small project." },
  { label: "Commission clause", detail: "In October 2024 MahaRERA issued an order on Clause 15A. Where a registered agent is involved, the agreement for sale can state the commission, taxes included, and who pays it. One adviser quoted by Outlook Money said it covers new and resale deals, and that it is not compulsory." },
];

