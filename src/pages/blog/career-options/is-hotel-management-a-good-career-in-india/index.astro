          <th>Real headroom</th>
        </tr>
      </thead>
      <tbody>
        {payCeilingRows.map((row) => (
          <tr>
            <td data-label="Stage"><strong>{row.stage}</strong></td>
            <td data-label="Typical experience">{row.years}</td>
