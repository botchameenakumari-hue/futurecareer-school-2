---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'BSc Career Options: What Your Subject Actually Opens Up';
const description =
  'BSc career options in India by subject: which exams accept your BSc, what MSc, NET, B.Ed, MBA and government routes need, and real pay. Find your next move.';
const canonical = 'https://futurecareerschool.com/blog/career-options/bsc-career-options/';
const publishedDateISO = '2026-09-29';
const publishedDateLabel = '29 September 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer on career options after BSc' },
  { id: 'subject-gate', label: 'Why your BSc subjects decide the doors' },
  { id: 'exam-gates', label: 'Which exams accept your BSc' },
  { id: 'calendar', label: 'The final-year calendar most students miss' },
  { id: 'seven-exits', label: 'Seven exits, ordered by growth headroom' },
  { id: 'three-vs-four', label: 'Three-year vs four-year BSc' },
  { id: 'myths', label: 'Options listed online that need a different degree' },
  { id: 'pay-reality', label: 'Real pay and the job-market backdrop' },
  { id: 'weekly-reality', label: 'What the first job actually feels like' },
  { id: 'money-runway', label: 'Should you spend on an MSc? The money math' },
  { id: 'ai-effect', label: 'What AI changes for BSc graduates' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'gates', label: 'The 3 Gates: proof that gets you hired' },
  { id: 'first-test', label: 'A first short test' },
  { id: 'mistakes', label: 'Expensive mistakes' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const examGateRows = [
  {
    exam: 'IIT JAM (MSc at IITs, plus NITs and IISc through result sharing)',
    needs: 'Paper-wise subject rules. Physics needs Physics for two years and Maths for one. Chemistry needs Chemistry all three years. Maths needs Maths for two years. Mathematical Statistics and Biotechnology are more flexible.',
    note: 'JAM 2026 ran on 15 February 2026 with seven papers, about 3,000 seats across 22 IITs and 2,300+ more through result-sharing institutes. A three-year BSc is accepted.',
  },
  {
    exam: 'CUET PG (MSc and other PG seats at central and many state universities)',
    needs: 'Any bachelor\'s degree, final-year students can apply, no age limit. Each university then sets its own subject rules.',
    note: 'The 2026 cycle took applications from 14 December 2025 to 14 January 2026, tests in March 2026, 157 subjects, up to four papers per candidate.',
  },
  {
    exam: 'NIMCET (MCA at NITs)',
    needs: 'A three-year degree with Mathematics or Statistics as a subject, and 60% (55% for SC/ST/PwD).',
    note: 'NIMCET 2026 was on 6 June 2026 for about 1,300 seats at 11 NITs and 2 IIITs. A BSc with maths is the natural entry.',
  },
  {
    exam: 'GATE',
    needs: 'You can appear from the third year of a BSc or after completing it.',
    note: 'Appearing is not the same as being hired. Engineering-post PSU advertisements and many M.Tech seats name BE/BTech, so read each notice before you plan around a GATE score.',
  },
  {
    exam: 'UGC NET and CSIR NET (JRF, Assistant Professor, PhD)',
    needs: 'A master\'s degree at 55% (50% for reserved categories), or a four-year bachelor\'s at 75%, and in the four-year case only for JRF and PhD.',
    note: 'A plain three-year BSc alone does not qualify. UGC NET June 2026 covered 105 subjects and the JRF age limit was 30.',
  },
  {
    exam: 'CAT and other MBA entrances',
    needs: 'A bachelor\'s degree with about 50% marks, and no age limit for CAT. Check the official eligibility document for your year.',
    note: 'Any BSc subject is accepted. The subject only matters later, for which MBA specialisation and which employer you can target.',
  },
  {
    exam: 'SSC CGL',
    needs: 'Most posts accept a degree in any subject. Junior Statistical Officer needs Statistics as a graduation subject or 60% in Maths at Class 12.',
    note: 'CGL 2026 was notified for 12,256 vacancies with Tier 1 from 30 September to 30 October 2026, as reported by exam-prep sites. Confirm on ssc.gov.in.',
  },
  {
    exam: 'IBPS PO and other bank exams',
    needs: 'A degree from a recognised university in any subject. IBPS PO 2026 asked for age 20-30 and had no attempt limit.',
    note: 'Any BSc works. The competition is huge, so treat it as one bet, not your whole plan.',
  },
  {
    exam: 'UPSC Indian Forest Service',
    needs: 'A bachelor\'s degree that includes at least one of Botany, Chemistry, Geology, Mathematics, Statistics, Physics, Zoology, Agriculture, Forestry, Veterinary Science or Engineering.',
    note: 'This is a science-degree gate that a BA graduate cannot use. Most BSc graduates qualify on paper.',
  },
];

const calendarRows = [
  { step: 'Final-year start (July to September)', action: 'Decide the exit you are testing. Check subject rules for JAM, CUET PG and NIMCET against your actual subject combination.' },
  { step: 'Autumn', action: 'JAM applications usually close in the autumn, months before the February test, so check the JAM site early. CAT is usually held in late November, and SSC CGL Tier 1 ran from 30 September to 30 October in 2026.' },
  { step: 'December to January', action: 'CUET PG applications opened on 14 December and closed on 14 January in the 2026 cycle.' },
  { step: 'February to March', action: 'JAM was held on 15 February 2026. CUET PG tests ran through March 2026. Final-year exams and practicals collide with both.' },
  { step: 'June', action: 'NIMCET was held on 6 June 2026. UGC NET June 2026 ran from 22 to 30 June for people who already hold a master\'s or a four-year degree.' },
  { step: 'After results', action: 'University-wise counselling, document verification and seat acceptance follow. Keep money and original documents ready.' },
];

const exitCards = [
  {
    badge: 'Fastest to income',
    title: 'A skill-stacked private job',
    body: 'Your BSc plus one multiplier skill, such as SQL and spreadsheets for analytics, GLP and documentation for QC, or clinical-research training, gets you hired without waiting two more years.',
    best: 'You have some proof already and money pressure at home.',
    watch: 'Without the multiplier skill, plain BSc entry roles cluster at the low end of the pay range.',
  },
  {
    badge: 'Credential route',
    title: 'MSc through JAM or CUET PG',
    body: 'The right move if your target role or research path names an MSc. A seat through a national exam at a public institute also keeps the cost low.',
    best: 'You want R&D, lab leadership, teaching at college level or a PhD later.',
    watch: 'Two more years and a second competitive stage. Seats at the best institutes are scarce, so keep a backup plan.',
  },
  {
    badge: 'Bridge',
    title: 'MBA or MCA as a pivot',
    body: 'MCA through NIMCET or a state entrance moves a maths-background BSc graduate into software. MBA through CAT moves you into business roles.',
    best: 'You already know the target role and the degree removes a real barrier.',
    watch: 'A private programme is not automatically a better job. Ask for the median placement and the denominator, not the highest package.',
  },
  {
    badge: 'Industry entry',
    title: 'Clinical research, regulatory, QC and lab-industry roles',
    body: 'Pharma, biotech, food and chemical companies hire life-science and chemistry graduates into QC, QA, documentation and clinical-research support.',
    best: 'You like structured, documented work and can be careful under audit.',
    watch: 'Shift work and slow pay growth without a specialisation. Documentation skill is the multiplier.',
  },
  {
    badge: 'Steady, gated',
    title: 'Teaching through B.Ed',
    body: 'School teaching needs a B.Ed. NCTE has proposed a one-year B.Ed for four-year degree holders, while three-year graduates are expected to stay on the two-year route.',
    best: 'You enjoy explaining and want a predictable schedule.',
    watch: 'Verify the final NCTE rules before you enrol. Private school pay is often modest, so tuition-based or online teaching can add a second income.',
  },
  {
    badge: 'Competitive lottery',
    title: 'Government exams',
    body: 'SSC, bank, state services, UPSC and the Forest Service accept BSc graduates, some only if a science subject is on your degree.',
    best: 'You will take real attempts and can protect a fallback skill alongside.',
    watch: 'Two hard stages: clearing the written exams, then a separate climb for the better posts. Years spent without proof cost the most.',
  },
  {
    badge: 'Long game',
    title: 'Research: MSc, NET or JRF, PhD',
    body: 'For people who genuinely like the lab or the desk. A funded PhD can lead to DRDO, ICMR, CSIR and university roles.',
    best: 'You enjoy slow, uncertain work and have a strong supervisor in mind.',
    watch: 'Entry is hard, then academic posts are a second hard filter. Not the place for someone who mainly wants money soon.',
  },
];

const subjectCards = [
  {
    label: 'Physics, Chemistry, Maths, Statistics, Electronics',
    title: 'The widest exam access',
    body: 'JAM has a paper for Physics, Chemistry, Mathematics and Mathematical Statistics. NIMCET opens MCA to maths-background BSc graduates. Statistics unlocks SSC Junior Statistical Officer and analytics jobs directly.',
    best: 'Maths or statistics on your marksheet is the single most valuable line for later switches.',
    watch: 'Pure-physics or pure-chemistry jobs in industry are fewer than the degree count suggests.',
  },
  {
    label: 'BSc Computer Science and IT',
    title: 'A job market that pays for proof',
    body: 'Hiring at entry level depends on your projects and interview performance more than on the bachelor\'s label. Our separate guide covers the job vs MCA vs MSc fork in detail.',
    best: 'You already build things and can show them.',
    watch: 'Software service roles at entry are crowded. Engineering-degree-only gates exist for some jobs and exams.',
    link: '/blog/career-options/career-after-bsc-computer-science/',
    linkLabel: 'BSc Computer Science guide',
  },
  {
    label: 'Botany, Zoology, Microbiology, Biotechnology, Life sciences',
    title: 'Lab, pharma and research routes',
    body: 'MSc routes, CSIR-NET and industry entry through QC, QA and clinical-research support. The PCB-based and biotechnology guides map these routes subject by subject.',
    best: 'You like lab discipline and are ready for an MSc or a documentation-heavy role.',
    watch: 'A biotechnology BSc without an MSc has a low ceiling in most labs.',
    link: '/blog/career-options/career-after-bsc-for-pcb-students/',
    linkLabel: 'BSc for PCB students guide',
  },
  {
    label: 'Geology, Environmental science, Agriculture-linked BSc',
    title: 'Fewer applicants, more specific gates',
    body: 'Geology has its own JAM paper. The Indian Forest Service accepts several of these subjects. Environmental consulting and impact assessment firms hire people with GIS and reporting skill.',
    best: 'You are happy with field work and travel.',
    watch: 'Openings are location-specific. Certificates in GIS or environmental reporting decide whether you get a call.',
    link: '/blog/career-options/environmental-science-career-options/',
    linkLabel: 'Environmental science career options',
  },
];

const mythRows = [
  {
    claim: 'ISRO scientist after BSc',
    reality: 'The ISRO Scientist/Engineer \'SC\' advertisement of August 2026 asked for a BE/BTech in Electronics, Mechanical or Computer Science with at least 65% marks. A BSc alone does not qualify for these posts.',
  },
  {
    claim: 'College lecturer after BSc',
    reality: 'Assistant Professor eligibility needs a master\'s degree with UGC NET. A four-year bachelor\'s at 75% opens JRF and PhD only, not the lecturer post.',
  },
  {
    claim: 'CSIR-NET straight after a three-year BSc',
    reality: 'CSIR-NET June 2026 accepted a master\'s degree, or a four-year BS at 75%, plus BE/BTech, B.Pharm and MBBS. A plain three-year BSc is not enough.',
  },
  {
    claim: 'PSU engineer through GATE',
    reality: 'You may sit GATE after the third year, but many engineering-post advertisements name BE/BTech. Read the specific notice, not the coaching brochure.',
  },
  {
    claim: 'Teacher in a government school',
    reality: 'It needs a B.Ed and the relevant teacher eligibility test. Check the current NCTE rules on the one-year and two-year routes.',
  },
];

const payRows = [
  { role: 'Lab technician or QC analyst (entry)', pay: 'About ₹2-4 LPA', source: 'Indeed India shows about ₹2.1 lakh a year for a lab technician. Naukri Campus shows ₹2-4 LPA.' },
  { role: 'Clinical research associate (entry)', pay: 'About ₹3-6 LPA', source: 'Naukri Campus, January 2025. Needs a clinical-research certificate or degree in most postings.' },
  { role: 'Environmental scientist (entry)', pay: 'About ₹3-6 LPA', source: 'Naukri Campus, January 2025.' },
  { role: 'School teacher (private)', pay: 'About ₹2-5 LPA', source: 'Naukri Campus, January 2025. Pay depends on school tier and city.' },
  { role: 'Software developer (entry, BSc CS or IT)', pay: 'About ₹4-8 LPA', source: 'Naukri Campus, January 2025. Upper end is for candidates with real project proof.' },
  { role: 'Junior research fellow', pay: 'About ₹3.3 lakh a year on job-board data', source: 'Indeed India. Official JRF stipends are set by the funding body, so check the current notification.' },
];

const checkpoints = [
  {
    num: '01',
    title: 'Biology check: how do you like to work?',
    body: 'Lab bench, screen, classroom, field or office? Energy for long documentation, shift work or travel? A BSc branches into all of these, so choose by your day, not by the label.',
  },
  {
    num: '02',
    title: 'Context check: what is your money and family runway?',
    body: 'Can the household carry two more years without your income? A student with a thin runway should test a skill-stacked job first and keep a national-exam MSc attempt as a parallel track.',
  },
  {
    num: '03',
    title: 'Market check: is there a painful problem behind the role?',
    body: 'Look for roles that fix cost, quality, risk or compliance for a company. Compliance documentation, data reporting and quality systems are steady examples for science graduates.',
  },
  {
    num: '04',
    title: 'Survival check: what stays valuable with AI around?',
    body: 'Routine report formatting and first-pass data cleaning are getting automated. Judgment in the lab, audit-ready documentation and clear explanation to non-experts are harder to replace.',
  },
];

const gateItems = [
  {
    num: '1',
    title: 'Proof of Skill',
    body: 'One finished piece: a lab report rewritten as a clear case note, a Python or Excel analysis of a public dataset in your subject, an environmental monitoring summary, or a lesson recording.',
  },
  {
    num: '2',
    title: 'Proof of Communication',
    body: 'A pitch you can say in thirty seconds to two minutes: who you are, what you can do, what you built. Record it once and listen back.',
  },
  {
    num: '3',
    title: 'Proof of Value',
    body: 'Show your work to three people who hire or supervise in the field, such as a QC head, an analyst or a school principal, and record what they said they would pay for.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Choosing an MSc just to delay the decision',
    body: 'Two more years without a target role is the most common expensive drift. An MSc should remove a specific barrier, not postpone the question.',
  },
  {
    num: '02',
    title: 'Missing the registration window of the entrance that suits your subject',
    body: 'CUET PG and JAM applications open months before your final results, and their tests collide with final-year practicals. Students who first read the notification after results have often lost that cycle.',
  },
  {
    num: '03',
    title: 'Trusting a listicle that names jobs without their eligibility gate',
    body: 'Lists that include ISRO scientist or college lecturer under plain BSc leave out the degree and exam rules. Read the recruiter\'s own notification first.',
  },
  {
    num: '04',
    title: 'Paying a private programme fee on the strength of a headline package',
    body: 'Ask for the median salary, how many students were eligible and how many were placed. A small group of high packages hides a much lower typical outcome.',
  },
  {
    num: '05',
    title: 'Letting the exam track eat every hour',
    body: 'Years of government preparation with no side skill leaves nothing to show if selection does not come. Keep one skill or proof asset alive alongside.',
  },
];

const faqItems = [
  {
    q: 'What are the best career options after BSc?',
    a: 'There is no single best. The strongest routes depend on your subject: an MSc through JAM or CUET PG for research and R&D, a skill-stacked private job for the fastest income, MCA or MBA as a deliberate pivot, teaching through B.Ed, or government exams with a fallback skill. Match the route to the subjects on your marksheet and the money you can spare.',
  },
  {
    q: 'Is a BSc enough to get a job?',
    a: 'Yes, for entry roles such as lab technician, QC analyst, junior data or software roles, clinical-research support and school teaching (with a B.Ed). Pay for plain BSc entry roles usually starts at the lower end, roughly ₹2-4 LPA in lab roles on job-board data, and rises faster when you add a skill that solves a company problem, such as data analysis or regulatory documentation.',
  },
  {
    q: 'Can I do an MSc in a different subject from my BSc?',
    a: 'Sometimes. IIT JAM and most university entrances set subject-wise rules. For example, JAM Physics needs Physics for two years and Maths for one, while Mathematical Statistics is more flexible. Check the brochure of each exam and the department rules for your target university before you plan a switch.',
  },
  {
    q: 'Which is better after BSc, MSc or a job?',
    a: 'An MSc is better when your target role or research path names it and you can get a seat at a public institute through a national exam. A job is better when you have a thin runway or already have proof of skill. Many people do both in sequence: a first job for a while to learn what work they like, then a funded or part-time master\'s.',
  },
  {
    q: 'Can BSc graduates appear for UPSC and government exams?',
    a: 'Yes. UPSC Civil Services, SSC CGL and bank exams accept a degree in any subject. The Indian Forest Service needs a bachelor\'s that includes a listed science subject. Junior Statistical Officer under SSC needs Statistics as a subject or 60% in Maths at Class 12. Read each notification for age limits and attempts.',
  },
  {
    q: 'Can I become a college lecturer with only a BSc?',
    a: 'No. Assistant Professor eligibility needs a master\'s degree with UGC NET. A four-year bachelor\'s with 75% can qualify for JRF and PhD admission, but not the Assistant Professor post.',
  },
  {
    q: 'What is the difference between a three-year and a four-year BSc?',
    a: 'A four-year bachelor\'s with 75% can sit UGC NET for JRF and PhD without a master\'s. The NCTE draft rules also propose a one-year B.Ed for four-year degree holders. Three-year graduates use JAM, CUET PG and a master\'s to reach the same doors. Universities are rolling the four-year format out at different speeds, so check what your own university offers.',
  },
  {
    q: 'What if I do not want to do an MSc?',
    a: 'Plan a skill-stacked job. Pick one target role, learn its core tool, build one piece of proof and apply to a narrow list of employers. Keep a national exam like CUET PG or NIMCET open as a parallel option because these have strict application windows that you cannot reopen later.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>BSc career options in India are decided less by the word "BSc" and more by the three subjects on your marksheet,
    because every real door after graduation, from JAM to NIMCET to the Forest Service, checks subjects before it checks
    anything else.</strong> The smart move is to match your subject to the exam or job that accepts it, add one skill that
    employers pay for, and build the proof of work that opens a higher income ceiling sooner.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>Answer:</strong> Career options after BSc fall into seven exits, and your subject combination, not the degree name, decides which ones are open.</li>
      <li><strong>Decision filter:</strong> Check the subject rule of each exam, then choose the exit that removes a real barrier for your target role, not the one that postpones the choice.</li>
      <li><strong>Next step:</strong> Match your subjects to the exam table below, add one <strong>high-income skill</strong> to the plan and start on the earliest registration window.</li>
    </ul>
  </div>

  <p>
    Many students hear "BSc has no scope" from relatives and "BSc has everything" from listicles. Both are wrong.
    The honest picture is narrower and more useful. If you want the parent map of all career articles first, see the
    <a href="/blog/career-options/">career options guides</a>. For paid, one-to-one help choosing between exits, our
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a> is built for exactly this decision.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer on career options after BSc</h2>

  <p>
    A three-year BSc, on its own, is an entry ticket, not a finished career. The doors above entry level need either a
    master's degree, a four-year degree with high marks, or a specific skill that companies pay for.
  </p>

  <p>
    That is why the questions students really type are not "what are BSc career options" but "which combination in BSc has more scope",
    "what can I do after BSc if I do not want to do MSc" and "is a BSc still worth it or worthless". Each of these has a
    narrow answer once you look at subjects, exams and money together.
  </p>

  <div class="highlight-box highlight-box--amber">
    <p><strong>The big picture in numbers.</strong> The Periodic Labour Force Survey 2025 put unemployment among graduates at about 11.2%, against
    a national rate of 3.1%, as reported by Forbes India. India Skills Report 2026 put employability of science graduates at 61%, against 70% for engineering and 56% for
    all graduates. A BSc is neither hopeless nor safe. What separates outcomes is what you add to it.</p>
  </div>

  <h2 id="subject-gate">Why your BSc subjects decide the doors</h2>

  <p>
    Most competing pages list the same ten courses for every BSc graduate. In practice, a physics-maths-chemistry graduate and a botany-zoology-chemistry graduate
    are standing in front of different gates. Here is how the subject groups differ.
  </p>

  <div class="subject-grid">
    {subjectCards.map((item) => (
      <div class="subject-card">
        <div class="subject-card__label">{item.label}</div>
        <div class="subject-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="card-subrow card-subrow--positive"><span class="card-subrow__label">Best for</span><span>{item.best}</span></div>
        <div class="card-subrow card-subrow--caution"><span class="card-subrow__label">Watch out</span><span>{item.watch}</span></div>
        {item.link && <p class="subject-card__link"><a href={item.link}>{item.linkLabel}</a></p>}
      </div>
    ))}
  </div>

  <p class="note-line">
    Nursing follows a separate licensing route. See <a href="/blog/career-options/career-after-bsc-nursing-india-scope/">career after BSc nursing</a> for that path.
  </p>

  <h2 id="exam-gates">Which exams accept your BSc</h2>

  <p>
    This is the table most BSc articles skip. Every exit below has a written eligibility rule. Read the rule against your marksheet before you spend on coaching.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Exam or route</th>
          <th>What your BSc must have</th>
          <th>Useful facts</th>
        </tr>
      </thead>
      <tbody>
        {examGateRows.map((item) => (
          <tr>
            <td data-label="Exam or route"><strong>{item.exam}</strong></td>
            <td data-label="What your BSc must have">{item.needs}</td>
            <td data-label="Useful facts">{item.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Dates and seat counts above come from the 2026 cycle. Notices for the next cycle appear on the official sites of
    <a href="https://exams.nta.nic.in/cuet-pg/" target="_blank" rel="noopener noreferrer">NTA CUET PG</a>,
    <a href="https://jam2026.iitb.ac.in/" target="_blank" rel="noopener noreferrer">IIT JAM</a>,
    <a href="https://nimcet.admissions.nic.in/" target="_blank" rel="noopener noreferrer">NIMCET</a> and
    <a href="https://ssc.gov.in/" target="_blank" rel="noopener noreferrer">SSC</a>. Verify before you apply.
  </p>

  <h2 id="calendar">The final-year calendar most students miss</h2>

  <p>
    Entrance exams for the next step start before you graduate. Students who wait for the final result to think about options often miss the window.
  </p>

  <div class="timeline">
    {calendarRows.map((item) => (
      <div class="timeline__row">
        <div class="timeline__step">{item.step}</div>
        <div class="timeline__action">{item.action}</div>
      </div>
    ))}
  </div>

  <p class="note-line">
    The pattern above follows the 2026 cycle. The exact dates for the next cycle change, so treat it as a rhythm to watch, not a fixed schedule.
  </p>

  <h2 id="seven-exits">Seven exits, ordered by growth headroom</h2>

  <p>
    We order these by how much the income and role ceiling can grow with skill and proof, not by prestige. The skill-stacked job leads because it can start earning earliest and compound,
    and the government and research routes come last because their pay bands and seat counts are structured and slow-moving.
  </p>

  <div class="exit-grid">
    {exitCards.map((item) => (
      <div class="exit-card">
        <span class="exit-card__badge">{item.badge}</span>
        <div class="exit-card__title">{item.title}</div>
        <p>{item.body}</p>
        <div class="card-subrow card-subrow--positive"><span class="card-subrow__label">Best for</span><span>{item.best}</span></div>
        <div class="card-subrow card-subrow--caution"><span class="card-subrow__label">Watch out</span><span>{item.watch}</span></div>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take on scalable paths</p>
    <p>
      A BSc graduate can build independent income too. Data analysis for small businesses, science tutoring taken online, environmental and
      lab-testing consulting, and scientific writing all scale by adding clients and packaged services, not by adding hours. Each needs visible proof and a real customer, so start the proof while you are still studying or in your first job.
    </p>
  </div>

  <div class="highlight-box highlight-box--teal">
    <p><strong>Two hard filters in one path.</strong> Research and teaching have two stages of competition. First, a national or state entrance to get the seat. Second, a separate climb for
    NET, JRF or a permanent post. Clearing one does not guarantee the other, so plan the fallback before the first attempt.</p>
  </div>

  <h2 id="three-vs-four">Three-year vs four-year BSc</h2>

  <p>
    National Education Policy changes are making the difference real, and most listicles ignore it.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">Three-year BSc</div>
      <ul>
        <li>Accepted for JAM, CUET PG, NIMCET and CAT</li>
        <li>UGC NET and CSIR NET need a master's degree first</li>
        <li>B.Ed route is expected to stay at two years</li>
        <li>Still the format at many universities</li>
      </ul>
    </div>
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">Four-year BSc (honours or research)</div>
      <ul>
        <li>UGC NET for JRF and PhD at 75% marks, without a master's</li>
        <li>CSIR NET also accepts a four-year BS at 75%</li>
        <li>NCTE draft rules propose a one-year B.Ed for four-year graduates</li>
        <li>One more year of fees and time, so it pays only if you want research or teaching</li>
      </ul>
    </div>
  </div>

  <p class="note-line">
    UGC announced the four-year rule for NET and PhD in April 2024. Final NCTE B.Ed regulations should be verified on the NCTE website before you plan around the one-year B.Ed.
  </p>

  <h2 id="myths">Options listed online that need a different degree</h2>

  <p>
    Some career lists put big names under "BSc careers". The rule of the recruiter, not the listicle, decides. These are the ones that trip students up most.
  </p>

