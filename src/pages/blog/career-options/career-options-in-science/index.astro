  { label: 'PayScale India: Data Analyst', href: 'https://www.payscale.com/research/IN/Job=Data_Analyst/Salary' },
  { label: 'PayScale India: Mechanical Engineer', href: 'https://www.payscale.com/research/IN/Job=Mechanical_Engineer/Salary' },
  { label: 'PayScale India: Pharmacist', href: 'https://www.payscale.com/research/IN/Job=Pharmacist/Salary' },
  { label: 'PayScale India: Biotechnologist', href: 'https://www.payscale.com/research/IN/Job=Biotechnologist/Salary' },
  { label: 'PayScale India: Food Technologist', href: 'https://www.payscale.com/research/IN/Job=Food_Technologist/Salary' },
  { label: 'PayScale India: Research Scientist', href: 'https://www.payscale.com/research/IN/Job=Research_Scientist/Salary' },
];

const faqItems = [
