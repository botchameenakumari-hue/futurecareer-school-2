---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Is journalism a good career in India? The honest read on pay and risk';
const description =
  'Is journalism a good career in India? Real pay across print, TV, and digital, the press-freedom risk field reporters carry, and who genuinely fits this path in 2026.';
const canonical = 'https://futurecareerschool.com/blog/career-options/is-journalism-a-good-career-india';
const publishedDateISO = '2026-08-17';
const publishedDateLabel = '17 August 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'pay-reality', label: 'What journalism actually pays in India' },
  { id: 'financial-crisis', label: 'Why the industry is under real financial stress' },
  { id: 'press-freedom', label: 'The safety and press-freedom risk, honestly' },
  { id: 'digital-shift', label: 'The digital and independent-journalism shift' },
  { id: 'ai-impact', label: 'Where AI is actually hitting the job' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol for this decision' },
  { id: 'who-fits', label: 'Who genuinely fits journalism' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const payRows = [
  {
