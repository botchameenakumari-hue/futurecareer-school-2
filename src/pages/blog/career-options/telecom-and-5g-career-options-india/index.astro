const seoDescription = "Telecom careers reward network basics, field reliability and troubleshooting.";
const canonical = "https://futurecareerschool.com/blog/career-options/telecom-and-5g-career-options-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What careers are there in telecom and 5G?",
    "Radio, core, transport, field operations, software and support roles."
  ],
  [
    "Is telecom a good career in India?",
    "It can be, with demand for network skills. Read notices and check conditions."
  ],
  [
    "Do I need an engineering degree?",
    "Many design roles ask for one. Field and support roles may differ."
  ],
  [
    "Which skills matter first?",
    "Networking basics, wireless basics and troubleshooting."
  ],
  [
    "Can I start a business?",
    "Some do small network services, following safety and licensing rules."
  ],
  [
    "Is field work risky?",
    "It can be. Safety training is essential."
  ],
  [
    "Are certificates needed?",
    "Check notices before paying."
  ],
  [
    "Will AI replace telecom roles?",
    "AI automates monitoring. Field work and responsibility remain human."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
