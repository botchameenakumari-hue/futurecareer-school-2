  {
    tier: 'Infosys (SE / Digital Specialist Engineer)',
    range: 'Rs 3.6-9 LPA',
    note: 'Base SE offers sit around Rs 3.6 LPA; Digital Specialist Engineer offers run higher for candidates cleared through a tougher bar.',
