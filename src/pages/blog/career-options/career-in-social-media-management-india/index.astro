---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career in social media management India: 3 real lanes, real pay, and what AI changed';
const description =
  'Career in social media management India spans agency, in-house, and freelance lanes with different pay and AI risk. Real salary data and a portfolio plan.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/career-in-social-media-management-india';
const publishedDateISO = '2026-07-14';
const publishedDateLabel = '14 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'myth', label: 'Why "social media manager" is really three different jobs' },
  { id: 'lanes', label: 'The 3 Lanes test: agency vs in-house vs freelance' },
  { id: 'lane-1', label: 'Lane 1: Agency social media manager' },
  { id: 'lane-2', label: 'Lane 2: In-house or brand-side social media manager' },
  { id: 'lane-3', label: 'Lane 3: Freelance or solo social media manager' },
  { id: 'entry', label: 'The real entry route: no degree, but no shortcuts either' },
  { id: 'skills', label: 'The skill stack that actually gets you hired' },
  { id: 'ai', label: 'How AI is actually changing this job' },
  { id: 'salary-table', label: 'Salary by lane and experience, side by side' },
  { id: 'freelance-pricing', label: 'What freelance social media management actually pays' },
  { id: 'demand', label: 'Why demand keeps climbing in India' },
  { id: 'portfolio', label: 'How to build proof of work with zero experience' },
  { id: 'mistakes', label: 'Mistakes people make chasing this career' },
  { id: 'test', label: 'A short test before you commit to a lane' },
  { id: 'faq', label: 'FAQs' },
];

const laneCards = [
  {
    badge: 'Lane 1',
    title: 'Agency social media manager',
    body: 'You handle multiple brand accounts at once inside a digital marketing or creative agency. Fastest way in for freshers - agencies hire junior talent far more readily than brand teams do, and you learn several industries in your first year instead of one. The trade-off is pace: tight deadlines, client reviews, and constant context-switching between accounts.',
    tags: ['Fastest entry point', 'Broadest skill exposure', 'Highest early burnout risk'],
    tone: 'teal',
  },
  {
    badge: 'Lane 2',
    title: 'In-house or brand-side manager',
    body: 'You own one brand\'s voice full-time, inside a company\'s marketing team. Usually needs 1-3 years of proven work before a company hires you directly, because you are trusted with their actual reputation from day one. Slower pace than an agency, deeper product knowledge, and a clearer path into a broader marketing or brand-strategy role over time.',
    tags: ['Needs prior proof', 'Deeper single-brand work', 'Clearer promotion ladder'],
    tone: 'gold',
  },
  {
    badge: 'Lane 3',
    title: 'Freelance or solo operator',
    body: 'You manage several small-business or personal-brand clients directly, set your own rates, and own the client relationship end to end. No one hands you clients - you find them, price your own work, and handle the business side alongside the creative side. Highest income ceiling per hour once you have 3-5 steady retainer clients, but the least stable in the first year.',
    tags: ['Self-sourced clients', 'Highest ceiling per client', 'Least stable at the start'],
    tone: 'blue',
  },
];

const entryProtocol = [
  {
    num: '01',
    title: 'Learn the actual platform mechanics, not just posting',
    body: 'Go past "how to post a Reel" and learn how each platform\'s algorithm actually ranks content, how ad managers work on Meta and Google, and how to read a basic analytics dashboard. Free platform certifications from Meta and Google, plus paid courses from Coursera, Udemy, upGrad, or Kraftshala, cover this without needing a college degree.',
  },
  {
    num: '02',
    title: 'Build 3 mock campaigns before you apply anywhere',
    body: 'Pick three real brands - one you love, one local business near you, one in an industry you know nothing about - and build a one-month content calendar, three sample posts, and a simple results hypothesis for each. This becomes your first portfolio piece before a single client exists.',
  },
  {
    num: '03',
    title: 'Land an internship or your first 1-2 discounted clients',
    body: 'Agency internship stipends in India commonly run Rs 5,000-15,000 a month - modest money, but the mentorship and real client exposure matter more than the stipend at this stage. If an internship is not available, offer a small local business a discounted first month in exchange for a testimonial and a case study you can show later.',
  },
  {
    num: '04',
    title: 'Pick one specialization before you go broad',
    body: 'A generalist who "does everything a bit" gets squeezed hardest by AI and by budget cuts. Pick one deeper skill early - paid ads and performance data, video and Reels production, or community and crisis management - and let that become the reason a brand hires you over someone who only posts.',
  },
  {
    num: '05',
    title: 'Choose your lane using the fit test below',
    body: 'Once you have one real portfolio piece and one specialization, run the 3 Lanes test below honestly against your own temperament, income needs, and appetite for instability - not against whichever lane sounds most impressive to explain at home.',
  },
];

const skillGroups = [
  {
    label: 'Content and copy',
    body: 'Writing captions, scripts, and hooks that stop a scroll in under two seconds, plus basic design sense in Canva or CapCut for Reels, carousels, and Stories that do not look templated.',
  },
  {
    label: 'Paid ads and analytics',
    body: 'Reading a Meta Ads Manager or Google Ads dashboard, understanding cost-per-result, and knowing when a post needs a paid boost versus when the content itself is the problem. This is the single highest-paying specialization in the field.',
  },
  {
    label: 'Community and reputation',
    body: 'Responding to comments and DMs in a brand\'s actual voice, spotting a small complaint before it becomes a public crisis, and knowing when to escalate to a human decision-maker instead of auto-replying.',
  },
  {
    label: 'Tools and workflow',
    body: 'Comfort with a scheduling tool (Buffer, Later, or a native platform planner), a basic AI writing or design co-pilot (ChatGPT, Canva Magic Studio), and a simple reporting sheet that turns raw numbers into one clear takeaway for a client or manager.',
  },
];

const aiPoints = [
  {
    label: 'What AI is already doing for you',
    body: 'A large majority of social media professionals now use AI tools daily or several times a week for first-draft captions, thirty-day content calendar outlines, and quick visual mockups. What used to take a full afternoon of blank-page writing now takes twenty minutes of editing an AI draft into something that actually sounds like the brand.',
  },
  {
    label: 'What AI is quietly removing from the job',
    body: 'The purely mechanical version of this role - write a caption, resize an image, schedule a post, repeat - is the part disappearing fastest. Companies are hiring fewer generalist mid-level coordinators who only did this routine work, because a junior person with AI tools can now produce the same output.',
  },
  {
    label: 'What AI is not close to replacing',
    body: 'Brand judgment during a public complaint, deciding whether a trending format actually fits a client\'s reputation, negotiating a client retainer, and reading whether a campaign genuinely moved sales versus just vanity likes - none of this is something an AI tool can be trusted to decide alone. This is where the real pay now concentrates.',
  },
];

const salaryRows = [
  { lane: 'Agency social media manager', entry: 'Rs 15,000-35,000/month (Rs 1.8-4.2 lakh/year)', mid: 'Rs 45,000-85,000/month (Rs 5.4-10 lakh/year)', senior: 'Rs 85,000-1,50,000/month; agency heads and associate directors report Rs 18-35 lakh/year in metro cities' },
  { lane: 'In-house or brand-side manager', entry: 'Rs 20,000-35,000/month, often after a proven agency or internship track record', mid: 'Rs 50,000-90,000/month, with growth tied to the brand\'s marketing budget', senior: 'Rs 90,000-1,60,000+/month as Head of Social or Brand Marketing Manager at larger companies' },
  { lane: 'Freelance or solo operator', entry: 'Rs 10,000-35,000/month per client while building 2-3 clients at once', mid: 'Rs 15,000-50,000/month per client across 3-5 retainer clients', senior: 'Rs 30,000-2,50,000/month per larger comprehensive-management client, before ad spend' },
];

const freelanceRows = [
  { stage: 'Organic-only management, small business', detail: 'Rs 10,000-35,000 a month per client - content calendar, posting, and basic community replies, no paid ads.' },
  { stage: 'Organic plus paid ad strategy', detail: 'Rs 15,000-1,50,000 a month in management fees, separate from the actual ad-spend budget the client pays to Meta or Google directly.' },
  { stage: 'Comprehensive management, larger accounts', detail: 'Rs 30,000-2,50,000 a month for full-funnel work - strategy, content, paid campaigns, and reporting for one client.' },
  { stage: 'Hourly or project-based work', detail: 'Rs 1,150-2,900 an hour for specialised freelancers, or Rs 15,000-50,000 as a flat project fee for a single deliverable like a platform launch or a campaign sprint.' },
];

const demandPoints = [
  {
    label: 'What the ad-spend numbers say',
    body: 'India\'s digital advertising spend crossed roughly Rs 40,800 crore in FY 2024-25, up close to 29% year-on-year, and social media plus online video together already account for well over half of that digital spend. Digital ad spend is forecast to keep climbing toward Rs 69,000+ crore by 2026, and social advertising is on track to overtake television as India\'s single largest ad format within the next few years.',
  },
  {
    label: 'What that growth means for hiring',
    body: 'Every rupee that shifts from a traditional ad format into social spend needs a real person planning, producing, and managing it - the budget growth converts fairly directly into agency and brand-side hiring demand, not just into bigger ad-tech contracts.',
  },
  {
    label: 'What is different about 2026 hiring specifically',
    body: 'Companies are not hiring more generalist "does a bit of everything" coordinators. They are hiring more junior coordinators for quality control and AI-output review, and more senior strategists who can direct a whole campaign and defend a budget in front of leadership - the flat middle is where growth has slowed.',
  },
];

const portfolioSteps = [
  {
    title: 'Grow one real account, even a small one',
    body: 'Pick your own niche or a hypothetical brand and post consistently for a stretch that genuinely fits your schedule - some people can show real movement in a few weeks, others need a couple of months. You do not need thousands of followers; you need a documented before-and-after and a clear reason behind every post.',
  },
  {
    title: 'Turn free or discounted work into a case study, not just a testimonial',
    body: 'A testimonial says a client liked you. A case study says exactly what you did, what number moved, and by how much. Document the starting point, the plan, and the result for every piece of free or discounted work you take on - this is what a hiring manager actually reads.',
  },
  {
    title: 'Build a simple portfolio site or one strong document',
    body: 'A basic personal site, a Notion page, or even a well-organised PDF works. Structure it the same way every time: the brand or niche, the goal, three to five sample posts, and the result, so a busy recruiter can scan it in under two minutes.',
  },
  {
    title: 'Show your process, not just your output',
    body: 'Anyone can post a pretty final graphic. Show the brief, the draft, the client feedback, and the final version for one or two pieces - it proves you can take direction and iterate, which matters more to an agency or brand than raw creative talent alone.',
  },
];

const mistakeCards = [
  {
    num: '01',
    title: 'Treating "social media manager" as one job with one salary number',
    body: 'Agency, in-house, and freelance pay differently, grow differently, and carry different day-to-day pressure. Comparing your offer or your rate against a single blended salary figure from a random search result leads to bad decisions in either direction.',
  },
  {
    num: '02',
    title: 'Skipping paid ads and analytics because organic content feels more creative',
    body: 'Organic content is where most beginners start and stay, but paid ads and performance data are where the real pay ceiling sits. A social media manager who can read a Meta Ads Manager dashboard and defend a cost-per-result number earns meaningfully more than one who can only write captions.',
  },
  {
    num: '03',
    title: 'Chasing follower count instead of a business outcome',
    body: 'A brand or client does not pay for likes - they pay for leads, sales, sign-ups, or brand recall they can measure. Every portfolio piece should show a business-relevant number, not just an engagement screenshot.',
  },
  {
    num: '04',
    title: 'Underpricing freelance work with no retainer clarity',
    body: 'New freelancers commonly undercharge and leave the scope vague - unlimited revisions, unclear deliverables, and no defined monthly cap. This burns you out fast and trains a client to expect more for less. Fix the scope and the price in writing before the first post goes live.',
  },
  {
    num: '05',
    title: 'Either ignoring AI tools completely or leaning on them with zero editing',
    body: 'Refusing AI tools slows you down against peers who have already folded them into a daily workflow. Publishing raw AI output with no brand-voice editing produces generic content that a trained eye - and increasingly, an audience - can spot instantly. The paying skill is the edit, not the raw generation.',
  },
];

const testItems = [
  { num: 'Check 1', title: 'Name your real income need honestly', body: 'A freelance lane can pay the most per hour, but it is also the least predictable in month one. If you cannot absorb a slow first stretch, the agency lane\'s steadier, lower starting pay is the more honest choice right now, not a lesser one.' },
  { num: 'Check 2', title: 'Test your tolerance for pace and pressure', body: 'Agency work means several client deadlines colliding in the same week. In-house work means slower cycles but higher stakes on one brand\'s reputation. Freelance work means you set the pace, but also chase the invoices. Be honest about which pressure actually energises you versus which one drains you.' },
  { num: 'Check 3', title: 'Pick one specialization and prove it once', body: 'Before applying anywhere or pricing a client, build one real example in your chosen specialization - a paid-ads case study, a video series, or a documented community-management save. One proven example beats five vague claims on a resume.' },
  { num: 'Check 4', title: 'Verify current platform and tool changes before committing months to one approach', body: 'Platform algorithms, ad-manager interfaces, and AI-tool capabilities shift often enough that year-old advice can be stale. Check what is currently working on your target platform before locking in a content strategy for a client or a job application.' },
];

const faqItems = [
  {
    q: 'What is the real scope of a career in social media management in India?',
    a: 'It splits into three genuinely different lanes - agency, in-house/brand-side, and freelance - each with its own pay ladder, pace, and entry route. Entry pay across all three sits roughly between Rs 15,000-35,000 a month, mid-career professionals commonly earn Rs 45,000-90,000 a month, and senior agency heads, brand marketing managers, or established freelancers with several retainer clients can cross Rs 1-2.5 lakh a month or more.',
  },
  {
    q: 'Do I need a degree to become a social media manager in India?',
    a: 'No formal degree is legally or practically required. What actually gets you hired is a real portfolio - documented campaigns, case studies, and results - built through free platform certifications, short courses, and a few pieces of real or mock client work. A marketing degree can help with foundational theory, but it does not substitute for proof of work in this field.',
  },
  {
    q: 'Is social media management a good career choice with AI on the rise?',
    a: 'Yes, with a condition: the purely mechanical part of the job - drafting captions, resizing images, scheduling posts - is shrinking fast because AI tools now do that in minutes. What is growing is demand for people who can direct AI output, defend a paid-ads budget, manage brand reputation during a crisis, and read whether a campaign actually moved sales. Pick a specialization instead of staying a pure generalist.',
  },
  {
    q: 'Agency vs in-house vs freelance - which pays better?',
    a: 'Agencies pay the most predictably at entry level and offer the fastest way in for freshers. In-house roles usually need 1-3 years of proven work first but offer a clearer promotion ladder into broader marketing roles. Freelance work has the highest income ceiling per client once you have 3-5 steady retainers, but the least income stability in your first year. There is no universally "better" lane - it depends on your income needs and tolerance for instability.',
  },
  {
    q: 'How do I build a social media management portfolio with zero experience?',
    a: 'Grow one real or hypothetical brand account consistently, offer one or two small businesses a discounted first month in exchange for a documented case study, and structure every piece of work the same way: the goal, what you did, and the measurable result. A short, well-documented portfolio with three to five real examples beats a long list of vague claims every time.',
  },
  {
    q: 'What tools do I need to learn for a career in social media management?',
    a: 'At minimum: a scheduling tool like Buffer or Later, Meta Ads Manager basics even if you never run large campaigns yourself, a design tool like Canva, and at least one AI writing or design co-pilot such as ChatGPT or Canva Magic Studio used as an editing starting point, not a final output.',
  },
  {
    q: 'How much do freelance social media managers charge in India?',
    a: 'Organic-only management for a small business commonly runs Rs 10,000-35,000 a month per client. Adding paid-ad strategy raises management fees to roughly Rs 15,000-1,50,000 a month, separate from the client\'s actual ad-spend budget. Comprehensive full-funnel management for larger accounts can reach Rs 30,000-2,50,000 a month per client, and specialised hourly work runs Rs 1,150-2,900 an hour.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>A career in social media management in India is not one job - it splits into three real lanes: agency, in-house brand-side work, and freelance or solo work</strong>, each with different pay, pace, and AI risk.
    Entry pay across all three lanes runs roughly Rs 15,000-35,000 a month, but the ceiling and the route to reach it look completely different depending on which lane you pick. Picking the wrong lane for your income needs and temperament - not "social media" being a weak field - is what actually derails most people here, and matching your real strengths to the right lane is what moves you toward a genuine high-income skill portfolio and <strong>earlier financial freedom</strong>, not a vague "I do social media" label.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>A career in social media management in India runs through three lanes - agency, in-house/brand-side, and freelance - not one fixed job description.</li>
      <li>No degree is required. A real portfolio of documented campaigns and results is what actually gets you hired or hired again.</li>
      <li>Entry pay sits near Rs 15,000-35,000 a month across most lanes; mid-career professionals commonly earn Rs 45,000-90,000 a month; senior agency heads, brand managers, and established freelancers can cross Rs 1-2.5 lakh a month.</li>
      <li>AI has already automated the purely mechanical part of the job - caption drafts, scheduling, basic visuals - which is shrinking generalist mid-level roles while growing demand for paid-ads, analytics, and reputation-management specialists.</li>
      <li>The next real step is choosing one lane and one specialization, then building one documented case study before applying anywhere.</li>
      <li>Do not stop at posting calendars. Combine customer and industry knowledge with AI-assisted production, creative judgment, analytics, communication, and proof of revenue or audience outcomes; that stack can scale into strategy, consulting, an agency, or owned media.</li>
    </ul>
  </div>

  <p>
    This guide breaks down what each lane actually pays, what AI has genuinely changed in the day-to-day work, and how to build real proof of work with zero prior experience. For the full option map across every field, see the <a href="/blog/career-options/">career options guides</a>.
  </p>

  <p>
    Structured <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance built around your actual timeline, budget, and specialization</a> can help you compare these three lanes against your specific situation, instead of guessing from one salary screenshot or one agency's job posting.
  </p>

  <nav class="jump-nav" aria-label="Jump to section">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="myth">Why "social media manager" is really three different jobs</h2>

  <p>
    Search "career in social media management India" and most results give you one job title, one salary figure, and a list of soft skills like "creativity" and "communication." That description could apply to a fresher posting Instagram Reels for a local bakery, a mid-career professional running paid campaigns for five accounts inside an agency, or a solo operator managing a founder's LinkedIn presence for Rs 40,000 a month. These are not the same job with a different title. They differ in who hires you, how fast you get paid, how stable your income is, and what skill actually moves your pay upward.
  </p>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">Where the single-job-title version goes wrong</p>
    <ul class="callout__list">
      <li>It quotes one blended salary number that mixes agency stipends, in-house corporate pay, and freelance retainers into one misleading average.</li>
      <li>It treats "posting content" as the whole job, when paid-ads strategy and analytics are where the real pay ceiling actually sits.</li>
      <li>It rarely explains that agencies hire freshers far more readily than in-house brand teams do, which changes your realistic first move.</li>
      <li>It skips how differently AI is reshaping each lane - a generalist agency coordinator faces very different pressure than a specialised in-house strategist.</li>
    </ul>
    <p class="callout__footer">
      A useful answer separates the three lanes first, then gives real numbers and a real entry route for each one - not one blended job description that hides more than it reveals.
    </p>
  </div>

  <h2 id="lanes">The 3 Lanes test: agency vs in-house vs freelance</h2>

  <p>
    Instead of asking "is social media management a good career," a sharper question is which of these three lanes actually fits your income needs, pace tolerance, and appetite for instability right now. Call it <strong>the 3 Lanes test</strong>.
  </p>

  <div class="tracks-grid">
    {laneCards.map((item) => (
      <div class:list={['track-card', `track-card--${item.tone}`]}>
        <div class="track-card__badge">{item.badge}</div>
        <div class="track-card__name">{item.title}</div>
        <p class="track-card__body">{item.body}</p>
        <div class="tag-row">
          {item.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="note-line">
    Most people who dismiss this career only picture the agency lane's fast pace and burnout stories, or the freelance lane's income instability, without testing whether one of the other two actually fits their real situation better.
  </p>

  <h2 id="lane-1">Lane 1: Agency social media manager</h2>

  <p>
    This is the fastest way into the field for a fresher. Digital marketing and creative agencies hire junior social media talent far more readily than brand-side companies do, because you are one of several people supporting several accounts, not the sole voice of one brand's reputation. In your first year, you commonly touch three to six different industries - a good, if exhausting, crash course in what actually works across different audiences.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Agency work moves fast and pays modestly at entry level - commonly Rs 15,000-35,000 a month. The trade-off is real: multiple client deadlines colliding in the same week, frequent context-switching, and a genuine burnout risk if you stay purely generalist for too long. The upside is unmatched: no other lane teaches you this many industries, tools, and client-handling patterns this quickly.
    </p>
  </div>

  <h2 id="lane-2">Lane 2: In-house or brand-side manager</h2>

  <p>
    Here you own one brand's voice, full-time, as part of a company's internal marketing team. Companies rarely hand this responsibility to someone with zero track record, because you are trusted with their actual public reputation from day one - most in-house hires already have one to three years of proven agency or freelance work behind them. The pace is slower and the stakes on any single post are higher, but the career path is clearer: strong in-house social media managers commonly move into broader brand marketing or marketing management roles over a few years.
  </p>

  <p class="note-line">
    If your longer-term goal is a marketing leadership role rather than staying purely in social media, in-house is usually the faster route there, once you have the entry-level proof this guide covers below.
  </p>

  <h2 id="lane-3">Lane 3: Freelance or solo social media manager</h2>

  <p>
    This lane has the highest income ceiling per client and the least built-in stability, especially in your first year. You find your own clients, set your own rates, and manage the business side - invoicing, contracts, scope creep - alongside the creative work. Many people who eventually run their own small social media agency start here, using freelance work as proof before hiring their first assistant.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      Freelance income only becomes genuinely stable once you have 3-5 steady retainer clients running at the same time - the first client rarely covers rent by itself. Treat your first two or three clients as proof-building, not as your final income plan.
    </p>
  </div>

  <h2 id="entry">The real entry route: no degree, but no shortcuts either</h2>

  <p>
    No college enforces a formal degree requirement for this field, and most job postings say so directly. What replaces the degree is a documented, checkable body of real work. Here is the entry route that actually holds up across all three lanes.
  </p>

  <div class="protocol-stack">
    {entryProtocol.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="skills">The skill stack that actually gets you hired</h2>

  <p>
    "Good with social media" is not a hireable skill by itself anymore. What actually gets you hired, and paid more once you are in, is a specific stack.
  </p>

  <div class="feature-grid">
    {skillGroups.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    You do not need to master all four groups before your first job. You need working knowledge of content and tools, plus real strength in one specialization - paid ads and analytics is the specialization with the widest pay gap between someone who has it and someone who does not.
  </p>

  <h2 id="ai">How AI is actually changing this job</h2>

  <p>
    AI adoption in this field is no longer a future trend - it is the current daily reality for the large majority of working social media professionals. The honest question is not "will AI take this job." It is which part of the job AI has already taken, and which part it genuinely cannot.
  </p>

  <div class="feature-grid">
    {aiPoints.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A purely generalist social media coordinator who only writes captions and schedules posts is the version of this job under the most real pressure right now. A social media professional who can direct AI output, defend an ad-spend decision with data, and manage a brand's reputation through an actual crisis is in a genuinely stronger position than a year ago - not a weaker one. Pick which one you are building toward.
    </p>
  </div>

  <h2 id="salary-table">Salary by lane and experience, side by side</h2>

  <p>
    Bringing all three lanes into one table makes the real spread easier to compare - and shows why one blended salary figure cannot answer "what does a career in social media management pay in India."
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Lane</th>
          <th>Entry level (0-2 yrs)</th>
          <th>Mid-career (3-5 yrs)</th>
          <th>Senior level (5-8+ yrs)</th>
        </tr>
      </thead>
      <tbody>
        {salaryRows.map((item) => (
