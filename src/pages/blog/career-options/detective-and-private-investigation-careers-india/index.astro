const canonical = "https://futurecareerschool.com/blog/career-options/detective-and-private-investigation-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is private investigation legal in India?",
    "Rules and licensing differ. Verify with a lawyer and official sources."
  ],
  [
    "Can I record people without consent?",
    "Not safely. Privacy and recording laws apply. Get legal advice."
  ],
  [
    "What skills matter?",
    "Research, documentation, observation, integrity and report writing."
  ],
  [
    "Which degrees help?",
    "Law, criminology, accounting, data and journalism all help."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed cases or licences."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
