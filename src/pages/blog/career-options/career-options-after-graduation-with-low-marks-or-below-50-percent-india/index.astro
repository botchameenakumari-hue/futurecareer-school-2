---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Career Options After Graduation With Low Marks or Below 50 Percent in India";
const seoTitle = "Career Options After Graduation With Low Marks or Below 50 Percent in India";
const description = "Career options after graduation with low marks in India: what marks block, skill routes, a plan and honest limits.";
const seoDescription = "Marks matter for some routes only; skill proof opens others.";
const canonical = "https://futurecareerschool.com/blog/career-options/career-options-after-graduation-with-low-marks-or-below-50-percent-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Can I get a job with low marks?",
    "Yes, in many skill based private roles. Some employers use cutoffs, so read notices."
  ],
  [
    "Which routes need marks?",
    "Check each notice for the eligibility line."
  ],
  [
    "Should I do a short course?",
    "If it fits a target role. Try free first."
  ],
  [
    "How do I explain low marks?",
    "Honestly, in three lines, with what you built since."
  ],
  [
    "Can I start my own service?",
    "Often yes, with a small pilot."
  ],
  [
    "Do entrance exams help?",
    "Some routes use exam scores. Verify eligibility."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed jobs."
  ],
  [
    "Will AI change this?",
    "It helps learning. Proof remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
