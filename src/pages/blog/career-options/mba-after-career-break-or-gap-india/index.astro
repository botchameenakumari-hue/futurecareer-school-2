        </tr>
        <tr>
          <td data-label="Type of graduate"><strong>MBA with no target role</strong></td>
          <td data-label="Our read">Risky</td>
          <td data-label="Why">Money can be lost.</td>
        </tr>
      </tbody>
    </table>
