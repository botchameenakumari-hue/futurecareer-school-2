const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which is better, biotechnology or pharmacy?",
    "It depends on your interest and the college. Compare syllabi and roles."
  ],
  [
    "Do both need a master degree?",
    "Often for research roles. Verify for the role you want."
  ],
  [
    "Is registration needed for pharmacy practice?",
    "Rules apply. Verify on the official page."
  ],
  [
    "Can I move from one to the other?",
    "Some routes exist. Check eligibility officially."
  ],
  [
    "Which has more lab work?",
    "Biotechnology usually has more; check each syllabus."
  ],
  [
    "Which suits patient-facing work?",
    "Pharmacy practice is patient-facing."
  ],
  [
    "Do I need NEET?",
    "Entry rules differ by course. Verify officially."
  ],
  [
    "Will AI affect both?",
    "Routine data work shrinks. Judgment and accountability remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
