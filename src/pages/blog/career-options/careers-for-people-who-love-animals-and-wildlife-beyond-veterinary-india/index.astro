const canonical = "https://futurecareerschool.com/blog/career-options/careers-for-people-who-love-animals-and-wildlife-beyond-veterinary-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Can I work with animals without being a vet?",
    "Yes, in conservation, animal care, education and support roles."
  ],
  [
    "Which degrees help?",
    "Zoology, life sciences, forestry, environmental science and others. Read notices."
  ],
  [
    "Is fieldwork physically demanding?",
    "Often. Test with short volunteer stints first."
  ],
  [
    "Is the pay low?",
    "It varies widely. Ask people in the field."
  ],
  [
    "How do I get first experience?",
    "Volunteer at shelters and local nature groups."
  ],
  [
    "Can I handle wild animals?",
    "Only with authorisation and training."
  ],
  [
    "Is tourism a good route?",
    "It can be, with responsible practices and proper training."
  ],
  [
    "Will AI change these roles?",
    "Routine records shrink. Fieldcraft remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
