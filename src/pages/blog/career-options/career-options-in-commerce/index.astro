  },
  {
    path: 'Insurance and risk roles',
    bestFor: 'Students who like products, advisory, underwriting, or customer-facing finance roles.',
    route: 'Degree plus product knowledge plus communication.',
    reality: 'This path is often ignored, but it can suit commerce students who explain risk well.',
  },
  {
    path: 'Business analyst',
    bestFor: 'Students who like systems, process, problem-solving, and business logic.',
    route: 'Commerce base plus Excel, documentation, SQL basics, dashboards, and clear writing.',
    reality: 'One of the best hybrid routes for commerce students who add tech.',
  },
  {
    path: 'Finance or data analyst',
    bestFor: 'Students who want numbers plus tools plus modern business reporting.',
