const noCaRows = [
  {
    path: 'Accounting and taxation',
    why: 'Good for students who still like finance detail but do not want the full CA route.',
  },
  {
    path: 'Finance and business analysis',
    why: 'Strong hybrid path for students who like numbers plus business decision-making.',
  },
  {
    path: 'Banking, insurance, and wealth roles',
