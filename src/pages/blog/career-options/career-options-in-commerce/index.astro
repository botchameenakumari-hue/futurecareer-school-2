const salaryDriverRows = [
  {
    driver: 'Role choice',
    effect: 'Some commerce paths have better leverage because they solve higher-value problems.',
  },
  {
    driver: 'Proof of work',
    effect: 'Visible proof helps you negotiate better than generic degree claims.',
  },
  {
    driver: 'Communication and trust',
    effect: 'Commerce careers reward people who can explain, persuade, and handle clients or stakeholders clearly.',
  },
  {
    driver: 'Tool leverage',
    effect: 'Excel, dashboards, AI use, automation, and reporting tools make you more productive and more valuable.',
  },
  {
