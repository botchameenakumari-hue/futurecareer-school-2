    effect: 'The biggest jumps often come from managing outcomes, clients, systems, or assets, not just doing tasks.',
  },
];

const mathFitRows = [
  {
    level: 'Comfortable with numbers and analysis',
    options: 'CA, CMA, finance analysis, business analysis, accounting, tax, audit, reporting-heavy roles.',
  },
  {
    level: 'Okay with practical maths but not advanced maths',
    options: 'Banking roles, operations, e-commerce, digital marketing analytics, insurance, relationship roles.',
  },
  {
    level: 'Not strong at maths but strong with people or communication',
    options: 'Sales, business development, HR, recruiting, client-facing finance support, entrepreneurship support roles.',
  },
];

const internshipTargets = [
  'Small CA firms, tax offices, and accounting service firms.',
  'SMEs that need operations, finance, or reporting help.',
  'Local businesses that need sales, digital marketing, or catalog support.',
  'Startups where one intern can touch multiple business functions.',
  'Family businesses where you can improve a real workflow and document the outcome.',
];

const mistakeRows = [
  {
    mistake: 'Choosing prestige over fit',
    fix: 'Ask what daily work you actually want to do before you chase the highest-status label.',
  },
  {
    mistake: 'Waiting until final year to build skills',
    fix: 'Start Excel, writing, presentation, AI use, and one proof project in the first year itself.',
  },
  {
    mistake: 'Doing a degree with no visible output',
    fix: 'Publish project work, dashboards, notes, mock case studies, or process breakdowns as proof.',
  },
  {
    mistake: 'Treating communication like an optional soft skill',
    fix: 'Practice spoken English, business writing, and short explanations every week.',
  },
  {
    mistake: 'Putting all hope into one exam route',
    fix: 'Keep one backup skill path growing in parallel so you do not lose years to one uncertain bet.',
  },
];

const faqItems = [
