  {
    path: 'Operations and entrepreneurship',
    why: 'Strong for students who think in systems and want business ownership or management exposure.',
  },
];

const degreeChoiceRows = [
  {
    route: 'BCom',
    bestFor: 'Students who want a broad commerce base and flexibility to add practical skills on top.',
    watchout: 'Do not assume the degree alone creates outcomes. You still need tools, projects, and visibility.',
  },
  {
    route: 'BBA or business-focused degree',
    bestFor: 'Students who like management, operations, business thinking, marketing, or sales-oriented roles.',
    watchout: 'A business degree without execution skills becomes theory-heavy very fast.',
  },
  {
    route: 'CA, CS, or CMA track',
    bestFor: 'Students who are genuinely aligned with formal professional work and exam stamina.',
    watchout: 'This is a time-heavy commitment. Do not enter only because the title sounds prestigious.',
  },
  {
    route: 'Degree plus skill-first stack',
    bestFor: 'Students who want both a degree and a faster practical path into the market.',
    watchout: 'This only works if the skill side is serious, visible, and consistent.',
  },
];

const workStyleRows = [
  {
    style: 'Quiet deep-work style',
    fit: 'Accounting, tax, finance analysis, compliance, internal reporting.',
  },
  {
    style: 'People-facing style',
    fit: 'Sales, banking relationship roles, wealth management, HR, recruiting, business development.',
  },
  {
    style: 'Systems and process style',
    fit: 'Operations, business analysis, supply chain, procurement, audit process work.',
  },
  {
    style: 'Growth and experimentation style',
    fit: 'Digital marketing, e-commerce, startup roles, entrepreneurship, marketplace growth.',
  },
];

const proofIdeas = [
  {
    track: 'Accounting or tax',
    idea: 'Create a sample GST or tax checklist, accounting workflow, or error-finding case summary.',
  },
  {
    track: 'Finance or analysis',
    idea: 'Build a company analysis sheet, dashboard, ratio breakdown, or business comparison deck.',
  },
  {
    track: 'Business analyst or operations',
    idea: 'Document one broken business process and redesign it with a cleaner workflow and metrics.',
  },
  {
    track: 'Sales or business development',
    idea: 'Write a mock outreach sequence, value pitch, objection sheet, and client conversation plan.',
  },
  {
    track: 'Digital marketing or e-commerce',
    idea: 'Create a mini campaign plan, landing page draft, ad angle list, and reporting dashboard.',
