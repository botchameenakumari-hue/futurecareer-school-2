    options: 'Sales, digital marketing, analytics, e-commerce, freelancing',
    logic: 'Best when you want faster proof, faster income, and lower dependence on college brand.',
  },
];

const skillRows = [
  {
    skill: 'Communication',
    why: 'Commerce careers reward people who explain numbers, decisions, and offers clearly.',
  },
  {
    skill: 'Excel and spreadsheets',
    why: 'Still one of the most practical tools across accounting, finance, operations, and business work.',
