    reality: 'Very strong path if you enjoy numbers and want an AI-resilient hybrid role.',
  },
  {
    path: 'Sales or business development',
    bestFor: 'Students with energy, persuasion, and comfort talking to people.',
    route: 'No need to wait for fancy credentials. Start by learning selling and showing outcomes.',
    reality: 'This is one of the fastest paths to income and growth if you can perform.',
  },
  {
    path: 'Digital marketing',
    bestFor: 'Students who like business, audience behavior, content, ads, and growth.',
    route: 'Skill-first path. Build campaigns, landing pages, and reporting proof.',
    reality: 'A very practical option when you want a portfolio-first route instead of exam-heavy routes.',
  },
  {
    path: 'E-commerce or marketplace operations',
    bestFor: 'Students who like online business, product movement, and process management.',
    route: 'Learn operations, spreadsheets, catalog work, ads, and conversion basics.',
    reality: 'Useful for commerce students who think like business operators.',
  },
  {
    path: 'Supply chain, procurement, or operations',
    bestFor: 'Students who like coordination, systems, vendors, and business movement.',
    route: 'Degree plus Excel, documentation, and process skills.',
    reality: 'This is a quiet but practical route for commerce students who like organised work.',
  },
  {
    path: 'HR or recruiting',
    bestFor: 'Students who enjoy people, interviews, screening, and coordination.',
    route: 'Communication, structured thinking, and people judgment matter a lot here.',
    reality: 'A better fit when you genuinely like people work, not just office work.',
  },
  {
    path: 'Entrepreneurship or family business',
