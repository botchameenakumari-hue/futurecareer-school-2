          <th>Why it can beat it</th>
          <th>Catch</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Alternative"><strong>HR operations route</strong></td>
          <td data-label="Why it can beat it">Process depth</td>
          <td data-label="Catch">Less advisory exposure</td>
        </tr>
        <tr>
          <td data-label="Alternative"><strong>Talent acquisition route</strong></td>
          <td data-label="Why it can beat it">Hiring focus</td>
          <td data-label="Catch">Narrower scope</td>
        </tr>
        <tr>
