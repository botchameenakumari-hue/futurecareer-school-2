    "With memos, small projects and conversations."
  ],
  [
    "Is CSR a stable field?",
    "It varies by employer. Read notices."
  ],
  [
    "Can I do research roles?",
    "Yes, with methods training and a portfolio."
  ],
  [
    "Should I hide my degree?",
    "No. Explain how it helps."
  ],
  [
    "Will AI change these roles?",
    "Routine analysis shrinks. Interpretation remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
