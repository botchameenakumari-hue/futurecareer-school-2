---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Fisheries Science and Aquaculture Careers in India";
const seoTitle = "Fisheries Science and Aquaculture Careers in India: Roles and Skills";
const description = "Fisheries science and aquaculture careers in India: farm, hatchery, research, quality and business roles, rules to verify, skills, a free-first plan and honest limits.";
const seoDescription = "Water quality records and farm discipline matter more than theory alone.";
const canonical = "https://futurecareerschool.com/blog/career-options/fisheries-science-and-aquaculture-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What can I do with a fisheries science degree?",
    "Farm, hatchery, testing, quality, research and extension roles."
  ],
  [
    "Do I need a licence to start a farm?",
    "Rules apply. Verify with the official fisheries office."
  ],
  [
    "Is aquaculture profitable?",
    "It varies with skill, site and market. Test small and keep records."
  ],
  [
    "What skills matter?",
    "Water quality, feed management and record keeping."
  ],
  [
    "How do I start free?",
    "Learn basics, visit a farm and set up a record sheet."
  ],
  [
    "Are government schemes available?",
    "Some exist. Verify on official pages."
  ],
  [
    "Is it risky?",
    "Yes. Disease, water and prices can change quickly."
  ],
  [
    "Will AI change this field?",
    "Data summaries shrink. Field judgment remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
