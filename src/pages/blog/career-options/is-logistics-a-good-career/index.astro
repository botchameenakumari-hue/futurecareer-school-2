const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Can you handle real-time pressure and problem-solving when a shipment, vendor, or delivery issue genuinely goes wrong, potentially outside standard working hours?',
    note: 'Logistics operations work rewards people comfortable with unpredictable, time-pressured problem-solving more than those seeking fully predictable daily routines.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can your situation support starting in a lower-paying operational role while you build the analytical and cross-functional skills needed to move upstream toward planning or management?',
    note: 'Logistics has a genuinely functional entry route without a specialised degree, but the realistic path to strong pay requires deliberate upward movement over a few years, not instant high income.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Are you aiming at a genuinely growing lane — supply chain planning, a specialised niche like international freight or cold-chain, or a leadership track — or a generic operations-floor role with no differentiation?',
    note: 'India\'s overall logistics sector is genuinely expanding, but the growth is concentrated in planning, analytics, and specialised niches more than in generic, undifferentiated operational execution.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'Given that automation is genuinely reducing demand for repetitive physical and manual-scheduling tasks, is your plan to build toward analytics, vendor management, and exception-handling judgment, or to compete purely on manual execution speed?',
    note: 'The most repetitive, manual-tracking-style tasks are the ones most exposed to automation over time — build toward judgment and analytical skill, not routine execution alone.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Complete a real internship or entry-level stint in warehouse, dispatch, or supply chain operations, not just classroom coursework, before committing to the field long-term.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'Explain, in under two minutes to someone with no logistics background, a specific operational problem you observed or solved and why it mattered. If this is difficult, the real daily work has not been tested yet.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of value',
    body: 'Talk directly to a working supply chain or logistics professional, not just a placement counsellor, and ask honestly what the realistic path from an entry role to a planning or management role actually looked like for them.',
