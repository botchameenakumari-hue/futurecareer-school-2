    q: 'What is the difference between logistics and supply chain management as careers?',
    a: 'Logistics operations typically refers to the execution side — warehousing, transportation, fleet and dispatch management — while supply chain management is the broader, more strategic discipline covering demand forecasting, procurement, inventory optimisation, and vendor relationships across the full goods-movement process. Supply chain roles generally sit further upstream, require more analytical skill, and carry a higher pay ceiling than purely operational logistics roles.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
