const roleComparison = {
  gold: [
    'Operations roles (warehouse, transportation, fleet management) run the physical movement and storage of goods day to day — hands-on, execution-focused work with real accountability for on-time delivery and cost control.',
    'Supply chain and planning roles (demand forecasting, procurement, inventory optimisation) sit further upstream, working with data and vendor relationships to decide what moves where and when, before execution happens.',
    'Logistics management and leadership roles oversee both, owning cost, service-level, and vendor-network decisions across a whole region or category, usually reached after solid operational or planning experience.',
  ],
  teal: [
    '"Is logistics a good career" gets asked as if it is one job, but a warehouse operations executive, a supply chain planner, and a logistics manager have different daily work, different automation exposure, and different pay ceilings — the honest answer depends on which lane you actually mean.',
    'India\'s logistics sector has genuinely grown fast with e-commerce and manufacturing expansion, but that growth has been uneven across these lanes — execution-heavy entry roles are more plentiful and more automation-exposed than planning and management roles.',
  ],
};

const salaryRows = [
  {
    stage: 'Fresher/entry-level operations executive, 0-2 years',
