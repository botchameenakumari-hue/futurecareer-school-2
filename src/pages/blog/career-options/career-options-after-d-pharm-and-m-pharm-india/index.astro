const canonical = "https://futurecareerschool.com/blog/career-options/career-options-after-d-pharm-and-m-pharm-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which jobs suit D.Pharm?",
    "Pharmacy roles, assistants in industry and further study. Verify registration rules."
  ],
  [
    "What can M.Pharm do?",
    "Industry, research, regulatory and teaching roles. Read notices."
  ],
  [
    "Do I need registration?",
    "Often yes for practice. Verify with the official council."
  ],
  [
    "Can I open my own store?",
    "Subject to licence and rules. Verify before investing."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed jobs or licences."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
