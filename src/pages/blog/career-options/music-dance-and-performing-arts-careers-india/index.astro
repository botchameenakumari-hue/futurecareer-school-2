const description = "Music, dance and performing arts careers in India: performance, teaching, production and digital routes, income models, a practice plan and honest limits.";
const seoDescription = "Plan several income streams. Few people live on performance alone at first.";
const canonical = "https://futurecareerschool.com/blog/career-options/music-dance-and-performing-arts-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Can I make a career in music or dance?",
    "Yes, though income is often built from several streams."
  ],
  [
    "Do I need formal training?",
    "Training helps. Read what organisers and schools expect."
  ],
  [
    "How do I get bookings?",
    "Share a reel and a rate card with local organisers and referrals."
  ],
  [
    "Is teaching a real option?",
    "Yes, and it often gives steady income."
  ],
  [
    "Can I earn online?",
    "Some do, with consistent content and an audience."
  ],
  [
    "Is it risky?",
    "Income can be uneven. Plan finances and keep a skills backup."
  ],
  [
    "What about family expectations?",
    "Share your plan with numbers and milestones."
  ],
  [
    "Will AI replace performers?",
    "Routine production shrinks. Live presence remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
