const dailyWorkRows = [
  {
    label: 'CA (practicing or in industry)',
    body: 'Reviewing ledgers and vouching transactions during audit season, drafting and filing GST and income tax returns, interpreting company law and accounting standards for a specific client situation, and eventually signing off financial statements that regulators and lenders rely on. Heavy on precision, rules, and deadline pressure, especially November to March.',
  },
  {
    label: 'CMA (inside a company)',
    body: 'Building product-wise or unit-wise cost sheets, tracking budget-versus-actual variance, working with operations teams to find where margins are leaking, and presenting internal reports that help management decide pricing, sourcing, or expansion. Heavy on internal analysis and cross-functional conversation with non-finance colleagues.',
  },
