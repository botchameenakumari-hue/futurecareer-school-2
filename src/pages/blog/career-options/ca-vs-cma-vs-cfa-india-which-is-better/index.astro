  },
];

const salaryRows = [
  {
    stage: 'Entry-level (fresher, right after qualifying)',
    ca: 'Rs 6-14 LPA depending on firm tier: Big 4 typically Rs 8.5-14 LPA, mid-size firms Rs 6-10 LPA, ICAI campus placement average around Rs 11.5-13 LPA.',
