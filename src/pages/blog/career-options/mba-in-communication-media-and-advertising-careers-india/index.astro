---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "MBA in Communication, Media and Advertising Careers in India";
const seoTitle = "MBA in Communication, Media and Advertising Careers in India";
const description = "MBA in communication, media and advertising careers in India: brand, media planning, public relations and content roles, skills, a free-first plan and honest limits.";
const seoDescription = "Show a portfolio of tested messages and clear numbers.";
const canonical = "https://futurecareerschool.com/blog/career-options/mba-in-communication-media-and-advertising-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What roles follow an MBA in communication and media?",
    "Brand, media planning, PR, content and account roles."
  ],
  [
    "Do I need a creative background?",
    "Not always. Strategy and numbers matter too."
  ],
  [
    "How do I build a portfolio?",
    "Create ideas for real causes and test small."
  ],
  [
    "Is a portfolio required?",
    "It is strongly helpful."
  ],
  [
    "Which skills matter?",
    "Writing, audience insight and measurement."
  ],
  [
    "Is it risky?",
    "Briefs and budgets can change fast. Build a range of skills."
  ],
  [
    "Can I start free?",
    "Yes, with a small real project."
  ],
  [
    "Will AI change the field?",
    "Routine copy shrinks. Strategy remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
