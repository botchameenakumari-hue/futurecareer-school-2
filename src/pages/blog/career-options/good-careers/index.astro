const faqItems = [
  {
    q: 'What actually makes a career "good"?',
    a: "There is no single measure. Use The 5-Axis Good-Career Test — income ceiling, security, growth trajectory, AI-resilience, and life-fit demand — and score any option against your own priorities, not a generic ranking. A career that scores high on pay but low on security or life-fit is not automatically bad, but it is only good for someone who has genuinely weighed that trade-off, not someone who saw the salary number and stopped reading.",
