    name: 'Skilled trades & field technical work',
    pills: [
      { axis: 'Income ceiling', level: 'Medium', tone: 'mid' },
      { axis: 'Security', level: 'High', tone: 'good' },
      { axis: 'Growth', level: 'Medium', tone: 'mid' },
      { axis: 'AI-resilience', level: 'High', tone: 'good' },
      { axis: 'Life-fit demand', level: 'Medium', tone: 'mid' },
    ],
    reality:
      "LinkedIn's Jobs on the Rise India 2025 report put Aircraft Maintenance Engineer and Robotics Technician in the top three fastest-growing roles nationally — real equipment fails in ways a model cannot fully anticipate, which keeps demand for hands-on judgment high.",
    fit: 'You want work that is close to physically impossible for AI to take over any time soon, and you do not need a desk to feel secure.',
    caution: 'Income growth here depends on eventually owning the customer relationship yourself, not only on getting technically better.',
  },
];

const weightingRows = [
  {
    num: '1',
    title: 'Weight income ceiling highest',
