  {
    label: 'Growth or platform PM',
    title: 'A second common entry lane',
    body: 'Some engineers move into product through growth, analytics, or platform teams first, where their technical fluency is a direct asset before they own a full roadmap.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Do you want a desk job with steady hours, a field or site-heavy role, an exam-heavy multi-year grind, or a fast-changing client-facing pace? GATE-PSU, UPSC ESE, consulting, and product management each demand a different daily rhythm.',
