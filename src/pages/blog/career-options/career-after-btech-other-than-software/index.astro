const publishedDateISO = '2026-07-04';
const publishedDateLabel = '4 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'why', label: 'Why "not software" feels like a smaller list' },
  { id: 'reality-check', label: 'What a B.Tech actually gave you' },
  { id: 'paths', label: '12 real paths, grouped by daily work' },
  { id: 'psu-gate', label: 'GATE and PSU jobs: the core-branch route' },
  { id: 'ese-upsc', label: 'UPSC ESE and civil services' },
  { id: 'mba-management', label: 'MBA and management roles' },
  { id: 'product-management', label: 'Product management' },
  { id: 'data-analytics', label: 'Data and business analytics' },
  { id: 'consulting', label: 'Management consulting' },
  { id: 'patent-technical', label: 'Patent law and technical writing' },
  { id: 'core-branch', label: 'Staying in core engineering' },
  { id: 'ms-abroad', label: 'MS abroad, M.Tech, and research' },
  { id: 'entrepreneurship', label: 'Building something of your own' },
  { id: 'other-routes', label: 'Defence, academia, and banking routes' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'salary-reality', label: 'Salary reality by path' },
  { id: 'ai-risk', label: 'Which paths AI actually threatens' },
  { id: 'parents', label: 'What to tell your parents or a placement-panicked mind' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const pathRows = [
  {
    path: 'GATE to PSU (core-branch)',
    bestFor: 'Students who liked their branch fundamentals and want stability plus a structured pay ladder.',
    reality: 'Entry CTC runs roughly Rs 12-20 LPA at top PSUs, but the GATE score bar for Mechanical and Electrical is genuinely tough, not a backup-plan exam.',
  },
  {
    path: 'UPSC ESE / civil services',
    bestFor: 'Students who want policy-level or administrative impact more than a lab, site, or product.',
    reality: 'Selection rate sits near 0.2-0.4%. A serious multi-year commitment, not a side attempt during placement season.',
  },
  {
    path: 'MBA and management roles',
    bestFor: 'Engineers who understand the technical side but want to sit closer to business decisions.',
    reality: 'Only pays off with a genuine business interest and a strong program or work-experience base first, not as an escape from a branch you dislike.',
  },
  {
    path: 'Product management',
    bestFor: 'Engineers who like translating a technical constraint into a decision a business can act on.',
