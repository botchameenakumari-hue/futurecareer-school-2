];

const patentTechnicalRows = [
  {
    path: 'Patent agent',
    detail: 'Requires clearing the Indian Patent Agent exam after a science or engineering degree. Entry-level pay of roughly Rs 15 LPA and above is realistic once qualified, because the pool of people with both technical depth and patent-drafting skill is small.',
  },
  {
    path: 'Technical writer',
    detail: 'IT, hardware, medical device, and industrial companies hire engineers who can explain a technical product in plain language through manuals, API docs, and knowledge bases.',
  },
  {
    path: 'IP and R&D support roles',
    detail: 'Larger engineering and pharma firms have internal IP cells that need someone who understands both the invention and the filing process.',
  },
];

const eseSteps = [
  {
    title: 'Confirm branch eligibility',
    body: 'UPSC ESE currently recruits through Civil, Mechanical, Electrical, and Electronics & Telecommunications engineering. If your branch is not one of these four, this specific exam is not your route; look at GATE-PSU or UPSC CSE instead.',
  },
  {
    title: 'Clear the Preliminary stage',
    body: 'Objective papers on General Studies and Engineering Aptitude, plus a branch-specific paper. This stage filters out the vast majority of the roughly 2-3 lakh applicants.',
  },
  {
    title: 'Clear the Mains',
    body: 'Conventional, written-answer papers in your specific engineering discipline. This is where genuine subject depth from your B.Tech years actually matters again.',
  },
  {
    title: 'Personality Test and allocation',
    body: 'Final interview, then allocation to services like the Indian Railways Service of Electrical Engineers, Central Public Works Department, or Indian Defence Service of Engineers, based on rank and preference.',
  },
];

const productManagementCards = [
  {
    label: 'Associate product manager',
    title: 'The rare direct-entry door',
    body: 'A handful of large product companies run APM programs that hire straight from campus, but these are a tiny fraction of total product roles and highly selective.',
  },
  {
    label: 'Engineer to PM',
    title: 'The far more common route',
    body: 'Most product managers in India spent 2-4 years first as a software engineer, business analyst, or in a customer-facing technical role, then moved sideways once they had proof of user and business judgment.',
  },
  {
    label: 'Domain-expert PM',
    title: 'Your non-software branch can be the edge here',
    body: 'A mechanical or electrical engineer who understands manufacturing, IoT hardware, or energy systems can become the product manager for a hardware-adjacent product faster than a pure software engineer with no domain context.',
