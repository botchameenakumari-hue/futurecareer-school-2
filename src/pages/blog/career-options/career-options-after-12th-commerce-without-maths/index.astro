---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career options after 12th commerce without maths: tests and deadlines';
const description =
  'Career options after 12th commerce without maths, planned around this admission cycle: DU seat data, CUET subject rules, and CA, CS, CMA, IPM and CLAT dates.';
const canonical = 'https://futurecareerschool.com/blog/career-options/career-options-after-12th-commerce-without-maths/';
const publishedDateISO = '2026-10-05';
const publishedDateLabel = '5 October 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';
const heroImageUrl = '/images/blog/career-options/career-options-after-12th-commerce-without-maths/career-options-after-12th-commerce-without-maths-hero.webp';
const socialImageUrl = '/images/blog/career-options/career-options-after-12th-commerce-without-maths/career-options-after-12th-commerce-without-maths-social.jpg';

const jumpLinks = [
  { id: 'stand', label: 'Where you stand today' },
  { id: 'lock', label: 'The subject-lock rule' },
  { id: 'doors', label: 'Which DU door each subject set opens' },
  { id: 'five-slots', label: 'One five-test set for three DU lines' },
  { id: 'seats', label: 'How DU commerce seats actually filled' },
  { id: 'read-line', label: 'How to read any CUET line' },
  { id: 'calendar', label: 'The calendar: October to July' },
  { id: 'tests', label: 'Which test for which path' },
  { id: 'pro', label: 'CA, CS and CMA: timing, not eligibility' },
  { id: 'plans', label: 'Three plans for this cycle' },
  { id: 'drop', label: 'Gap year or settle: the arithmetic' },
  { id: 'myths', label: 'Cycle myths checked against the bulletin' },
  { id: 'stack', label: 'The skill stack on top of the seat' },
  { id: 'ai', label: 'AI and these careers' },
  { id: 'money', label: 'Money and the college budget' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'gates', label: 'The 3 Gates' },
  { id: 'mistakes', label: 'Expensive mistakes this cycle' },
  { id: 'test', label: 'A short first test' },
  { id: 'parents', label: 'For parents' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const standCards = [
  {
    label: 'Class 12, results in 2027',
    title: 'Still in Class 12 with no maths',
    body: 'You are in the 2027 admission cycle, and every deadline below is yours. Your subject list is already fixed, so the only choices left are which tests to register for and in what order.',
  },
  {
    label: 'Passed in 2026, no seat',
    title: 'Missed DU or a target college this year',
    body: 'Delhi University closed its 2026-27 rounds with a spot round on 23 August 2026. The next real chance is a fresh CUET attempt in 2027, and the months in between need a plan that is not waiting.',
  },
  {
    label: 'Passed in 2026, seat in hand',
    title: 'Already admitted somewhere',
    body: 'The admission cycle is over for you. The open question is how to use the first year of the degree, and the skill-stack section below is written for that.',
  },
  {
    label: 'Applied Maths on the marksheet',
    title: 'Took Applied Mathematics, not full Mathematics',
    body: 'You hold a subject that Delhi University writes as "Mathematics/Applied Mathematics". That keeps BMS, BBA (FIA) and Business Economics possible, which a no-maths student cannot use.',
  },
];

const lockRows = [
  {
    programme: 'B.Com (Hons)',
    combo: 'Combination I: language + Mathematics/Applied Mathematics + two subjects from List B. Combination II: language + Accountancy/Book Keeping + two subjects from List B.',
    noMaths: 'Open through Combination II',
  },
  {
    programme: 'B.Com (General)',
    combo: 'Combination I: language + any three subjects from List B. Combination II: language + one subject from List B + the General Aptitude Test.',
    noMaths: 'Open through both lines',
  },
  {
    programme: 'BMS, BBA (FIA) and BA (Hons) Business Economics',
    combo: 'Language + Mathematics/Applied Mathematics + one subject from List B + the General Aptitude Test.',
    noMaths: 'Closed without a maths subject',
  },
];

const seatRows = [
  { college: 'Aditi Mahavidyalaya (W)', seats: '68', vacant: '20', share: '29.4%' },
  { college: 'Jesus & Mary College (W)', seats: '50', vacant: '10', share: '20.0%' },
  { college: 'Kalindi College (W)', seats: '58', vacant: '8', share: '13.8%' },
  { college: 'Bharati College (W)', seats: '151', vacant: '18', share: '11.9%' },
  { college: 'Maharaja Agrasen College', seats: '193', vacant: '21', share: '10.9%' },
  { college: 'Janki Devi Memorial College (W)', seats: '172', vacant: '17', share: '9.9%' },
  { college: 'Keshav Mahavidyalaya', seats: '192', vacant: '18', share: '9.4%' },
  { college: 'Acharya Narendra Dev College', seats: '125', vacant: '8', share: '6.4%' },
  { college: 'Atma Ram Sanatan Dharma College', seats: '174', vacant: '2', share: '1.1%' },
  { college: 'Hansraj College', seats: '260', vacant: 'none listed', share: '0%' },
  { college: 'Dyal Singh College', seats: '231', vacant: 'none listed', share: '0%' },
  { college: 'College of Vocational Studies', seats: '340', vacant: 'none listed', share: '0%' },
];

const calendarRows = [
  { when: '10 October 2026', what: 'CMA Foundation (December sitting): registration deadline, with a late-fee window to 17 October', status: 'Reported', note: 'Careers360 date page. Confirm on icmai.in.' },
  { when: '31 October 2026', what: 'CLAT 2027 registration closes. Exam on 6 December 2026. Any stream.', status: 'Reported', note: 'Consortium of NLUs notice, read through exam sites.' },
  { when: '31 October 2026', what: 'CS Executive Entrance Test (CSEET) registration for the February 2027 session', status: 'Conflicting', note: 'ICSI\'s own post shows 31 October. One coaching site shows 30 September. Confirm on icsi.edu.' },
  { when: '3 to 16 November 2026', what: 'ICAI exam-form window for the January 2027 sitting, only for those already registered', status: 'Reported', note: 'January registration closed on 1 September 2026.' },
  { when: '13 December 2026', what: 'CMA Foundation exam', status: 'Reported', note: 'Careers360 date page.' },
  { when: 'December 2026', what: 'NCHM JEE form opens for hotel management. Exam expected in April 2027.', status: 'Tentative', note: 'Requires Class 12 with English.' },
  { when: '1 January 2027', what: 'Reported last date to register for the May 2027 CA Foundation sitting, because of the four-month study rule', status: 'Reported', note: 'Confirm on icai.org.' },
  { when: 'First week of January 2027', what: 'CUET UG 2027 registration expected. NTA has not announced dates.', status: 'Tentative', note: 'Expected pattern, not a notice.' },
  { when: 'January to February 2027', what: 'NMIMS NPAT BBA registration and exam window', status: 'Tentative', note: 'Careers360, updated 31 August 2026.' },
  { when: 'February 2027', what: 'CSEET February session, in the middle of board-exam season', status: 'Reported', note: 'Check the exact date on icsi.edu.' },
  { when: 'Early May 2027', what: 'IPMAT 2027 expected. CUET UG exams expected from the second week of May. A CA Foundation sitting also falls in May.', status: 'Tentative', note: 'Three exams in the same month, so choose now.' },
  { when: 'Late June 2027', what: 'CUET UG 2027 result expected', status: 'Tentative', note: 'The 2026 result came on 23 June 2026.' },
  { when: 'July to August 2027', what: 'Delhi University seat matrix and seat-allocation rounds', status: 'Pattern', note: '2026 pattern: seat matrix 3 July, third round 3 August, spot round 23 August.' },
];

const testRows = [
  { path: 'DU B.Com (Hons) and B.Com', test: 'CUET UG, then DU\'s seat-allocation portal', maths: 'No. Accountancy replaces it for B.Com (Hons).', action: 'Fix your CUET subject set before registration opens.' },
  { path: 'DU BMS, BBA (FIA), Business Economics', test: 'CUET UG with Mathematics/Applied Mathematics, plus the General Aptitude Test', maths: 'Yes, and you must have studied it in Class 12.', action: 'If you did not, drop these from the plan today.' },
  { path: 'Other central and state universities', test: 'CUET UG scores, as accepted by each university', maths: 'Depends on each university.', action: 'Read each university\'s own programme line. 244 universities used CUET in 2026.' },
  { path: 'Integrated management (IPM)', test: 'IPMAT at IIM Indore and IIM Rohtak. IIM Amritsar and IIM Shillong set their own gates.', maths: 'Indore: no subject condition. Amritsar and Shillong: Mathematics required.', action: 'Decide in the first quarter of 2027 whether to prepare for IPMAT\'s two quant sections.' },
  { path: 'Private BBA', test: 'University or group tests such as NPAT, or marks-based admission', maths: 'Check each brochure.', action: 'Compare total fee with a B.Com plus skill route before paying.' },
  { path: 'Law (BA LLB, BBA LLB)', test: 'CLAT 2027 on 6 December 2026, and other law tests', maths: 'No. Any stream.', action: 'Registration closes on 31 October, so this is the first deadline.' },
  { path: 'Hotel management (BSc HHA)', test: 'NCHM JEE, expected April 2027', maths: 'No. English is the required subject.', action: 'Watch for the form in December.' },
  { path: 'CA, CMA and CS', test: 'CA Foundation, CMA Foundation and CSEET', maths: 'CA and CS: no stream condition. CMA: confirm Class 12 rules on icmai.in.', action: 'Timing matters more than eligibility. See the next section.' },
  { path: 'Design (B.Des)', test: 'UCEED, NID DAT and others', maths: 'No stream condition for the common routes.', action: 'Dates fall in December and January, so decide early if this interests you.' },
];

const mythRows = [
  {
    claim: '"Delhi University asks for 55 to 60 per cent in Class 12 for B.Com (Hons)"',
    fact: 'DU\'s 2026-27 Bulletin sets no minimum marks for B.Com (Hons). Merit comes from CUET scores, and the FAQ says Class 12 marks are used only to break ties.',
  },
  {
    claim: '"You can pick the Maths paper in CUET even if you did not study it"',
    fact: 'The Bulletin says it is mandatory to appear in CUET in those subjects in which you are appearing or have passed Class 12. A commerce student without maths cannot use Combination I.',
  },
  {
    claim: '"DU takes a separate entrance like DU JAT for commerce"',
    fact: 'DU admits through CUET scores and its seat-allocation system. A popular course page still lists DU JAT as a B.Com route, which is out of date.',
  },
  {
    claim: '"CA and CMA are maths-only courses"',
    fact: 'ICAI takes registrations from any stream after Class 10. CMA Foundation includes a business-maths paper that you learn inside the course. A ranking page that lists CA and CMA under "with maths" is wrong about CA and misleading about CMA.',
  },
  {
    claim: '"The first cutoff list is the price of admission"',
    fact: 'In the 27 colleges we could read, general-category B.Com (Hons) seats were 97.8 per cent filled by the spot round. Cutoffs show who got in first, not who can still get a good seat.',
  },
  {
    claim: '"One bad CUET day means a lost year"',
    fact: 'You need a plan with a fallback ready before the exam, not after. Several professional routes and law tests run on their own dates.',
  },
];

const planCards = [
  {
    tone: 'teal',
    title: 'Plan A: in Class 12 now, no maths',
    items: [
      'Choose a five-test CUET set that covers three DU lines at once (see the five-test set above).',
      'Mark the first dates: CLAT on 31 October if law interests you, CMA on 10 October if you want an early start.',
      'Decide by December whether the May 2027 CA Foundation sitting is realistic next to boards and CUET.',
      'Keep one skill project running that is not an exam.',
    ],
  },
  {
    tone: 'gold',
    title: 'Plan B: passed in 2026, no seat',
    items: [
      'Treat 2027 CUET as a fresh attempt, with the same subject-lock rule.',
      'Start one professional route now. CMA Foundation in December or CSEET in February can each start with Class 12 passed.',
      'Add a paid or project-based skill so the gap year has proof, not just attempts.',
      'Set a checkpoint date after the CUET result for what happens next.',
    ],
  },
  {
    tone: 'teal',
    title: 'Plan C: seat in hand',
    items: [
      'Pick one core skill and one multiplier for the first year.',
      'Use the vacation after year one for the first piece of paid or proof-bearing work.',
      'Keep CA, CS or CMA as a parallel option, since each can run alongside a B.Com.',
      'Read the sibling guide on commerce careers without maths for the rule-by-rule map.',
    ],
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Check how you work, not what sounds impressive. Some people thrive on long exam cycles and number work. Others do better in people-facing roles with shorter feedback loops.',
    note: 'Test: sit one full sample paper for each test you are weighing, then notice how you feel afterwards.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Board exams, family budget and the years your family can wait for income set how many tests you can carry. One exam done well beats three done badly.',
    note: 'Test: list every exam date from October to July and cross out the ones that collide.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Look for the paid problem at the end of the path. Accounting practice, GST filing, sales and marketing pay for results, whatever entrance test got you in.',
    note: 'Test: collect five live job or freelance posts for your target role and list what they ask for.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'Ask which tasks AI makes cheap and which human layer stays. Routine entry work shrinks. Judgement, trust and clear explanation hold their value.',
    note: 'Test: write down what you would still be paid for if a tool did the routine half.',
  },
];

const gateItems = [
  { num: 'Gate 1', title: 'Proof of Skill', body: 'Finish one piece before CUET results arrive: books for a small shop, a simple spreadsheet model, or a short report on a real business.' },
  { num: 'Gate 2', title: 'Proof of Communication', body: 'Present that piece in a thirty-second to two-minute pitch to a person outside the field, as a voice note or short video.' },
  { num: 'Gate 3', title: 'Proof of Value', body: 'Ask three people who work in the field, or three paying clients, whether it is useful, and write down their exact words.' },
];

const mistakeItems = [
  { num: '1', title: 'Registering for the Maths paper you never studied', body: 'DU\'s own rule ties each CUET subject to what you have studied or are appearing in. Choosing Maths "for the score" does not open Combination I.' },
  { num: '2', title: 'Choosing CUET subjects only by expected marks', body: 'A high score in a subject that matches no combination helps no one. Choose subjects that form a combination, then prepare them.' },
  { num: '3', title: 'Missing the four-month rule for CA', body: 'The registration date is set months before the exam. Register late and you lose a whole sitting without any warning.' },
  { num: '4', title: 'Stacking three entrances in the same month', body: 'May 2027 is expected to carry CUET, IPMAT and a CA Foundation sitting. Pick the ones that match your plan and drop the rest.' },
  { num: '5', title: 'Reading a first cutoff as a wall', body: 'Colleges with the highest cutoffs fill first, but 17 of the 27 colleges we read had under 2 per cent of B.Com (Hons) seats left by the spot round. Mid-ranked seats move.' },
  { num: '6', title: 'Paying a big private BBA premium out of fear', body: 'A B.Com at a good college plus a visible skill stack often costs far less and keeps CA, CS and CMA open.' },
  { num: '7', title: 'Trusting one page for a date', body: 'Sites copy each other, and ICSI\'s own post and a coaching site gave different CSEET dates when we checked. Confirm every deadline on the exam body\'s own notice.' },
];

const parentChecks = [
  { title: 'Ask for the exact line in the bulletin', body: 'For Delhi University, that is the programme-specific eligibility paragraph in the Bulletin of Information. A coaching page is not a substitute.' },
  { title: 'Ask which admission year the date belongs to', body: 'A date for the 2026-27 cycle does not apply to the child who finishes Class 12 in 2027. Check that every deadline is labelled for 2027-28.' },
  { title: 'Ask whether it is a subject gate or a test section', body: 'A Class 12 subject on the marksheet cannot be fixed. A timed section in a test can be practised.' },
  { title: 'Add up the whole year\'s cost', body: 'Count test fees, coaching, travel to exam centres and the college fee together, and compare the total with the family\'s education budget before saying yes to anything.' },
  { title: 'Keep one parallel route alive', body: 'A skill or a professional registration that continues even if one test goes badly protects the year.' },
];

const testSteps = [
  { title: 'Write down your subject list', body: 'Language, Accountancy, Business Studies, Economics, and whether Mathematics or Applied Mathematics is there.' },
  { title: 'Match it to the combination table', body: 'Circle every DU line you can use. Cross out every line that needs a subject you do not hold.' },
  { title: 'Sit one timed sample paper for the weakest subject', body: 'Use the public sample material. Note which topics cost marks, not just the total.' },
  { title: 'Build one small piece of proof', body: 'A set of books, a one-page market note or a mini campaign, finished and shown to two people.' },
  { title: 'Ask one direct question', body: 'Would you pay for this, or hire for this? Write down the answers.' },
  { title: 'Decide, then review', body: 'Review after a stretch of steady work. Some people need a few weeks and others a couple of months, and both are normal.' },
];

const faqItems = [
  {
    q: 'Can I get B.Com (Hons) at Delhi University after 12th commerce without maths?',
    a: 'Yes. DU\'s 2026-27 Bulletin lists a combination of one language from List A, Accountancy or Book Keeping, and two subjects from List B. Merit is based on the best CUET score from any valid combination. The Bulletin sets no minimum Class 12 marks for B.Com (Hons). Read the current Bulletin each year, because the lines can change.',
  },
  {
    q: 'Can I take the Maths paper in CUET if I studied commerce without maths?',
    a: 'Not for DU. The Bulletin says it is mandatory to appear in CUET in those subjects in which you are appearing or have passed Class 12. If you did not study Mathematics or Applied Mathematics, Combination I is not available to you.',
  },
  {
    q: 'Which CUET subjects should a commerce student without maths choose?',
    a: 'Choose subjects that form a valid DU combination: a language, Accountancy, and two more from List B such as Business Studies and Economics. If NTA keeps the five-test limit in 2027, adding the General Aptitude Test as the fifth test also covers B.Com (General) Combination II. Confirm the limits in the 2027 bulletin.',
  },
  {
    q: 'When will CUET UG 2027 registration open?',
    a: 'NTA has not announced dates. Exam sites expect registration in the first week of January 2027, exams from the second week of May and results in the last week of June. Treat these as expected, and check cuet.nta.nic.in.',
  },
  {
    q: 'I passed Class 12 in 2026 and got no seat. What should I do?',
    a: 'Delhi University\'s 2026-27 rounds ended with a spot round on 23 August 2026. Your next chance is CUET 2027. Use the months in between for one professional registration, such as CMA Foundation or CSEET, and one skill that produces proof, and set a decision date after the CUET result.',
  },
  {
    q: 'Is the CA Foundation registration deadline already gone?',
    a: 'For the January 2027 sitting, yes. Registration closed on 1 September 2026, as reported. For the May 2027 sitting, the reported last date is 1 January 2027 because of the four-month study rule. Check icai.org, since secondary pages disagree on exam-form dates.',
  },
  {
    q: 'Can I start CMA or CS while I am still in Class 12?',
    a: 'Registration rules differ by institute. ICAI allows registration after Class 10 for the Foundation. For CS, the CSEET asks for Class 12 passed or appearing. For CMA, confirm Class 12 timing on icmai.in before paying, because we could not verify it on the official page.',
  },
  {
    q: 'Is CLAT possible for commerce students without maths?',
    a: 'Yes. CLAT does not restrict stream, and registration for the December 2026 exam closes on 31 October, as reported. Its quantitative section is small and school-level, so it is a practice problem, not a subject gate.',
  },
  {
    q: 'Do I need maths for IPMAT?',
    a: 'IIM Indore\'s IPM document lists no subject condition, but two of the three sections test quantitative ability. IIM Amritsar and IIM Shillong require Mathematics. IPMAT 2027 is expected in early May, which is not yet confirmed.',
  },
  {
    q: 'Is a gap year for CUET worth it?',
    a: 'It adds a year, which is a one-third increase on a three-year degree before degree-based pay. It pays only if you have a specific target college, a realistic score gain and a parallel skill. Compare your own score with the target college\'s last two cutoff lists before you decide.',
  },
  {
    q: 'Can I do BBA after commerce without maths?',
    a: 'Many BBA programmes do not gate on maths, but Delhi University\'s BMS and BBA (FIA) do. Read each college\'s own eligibility line, and compare total fees against a B.Com plus skill route.',
  },
  {
    q: 'Is commerce without maths a good choice for a high income?',
    a: 'It can be. Income follows the skills you can show and explain, not the stream on your marksheet. Choose the path where you can build that proof, and compare its ceiling before you commit.',
  },
  {
    q: 'Where can I read the full rule-by-rule map for commerce without maths?',
    a: 'The sibling guide on career options in commerce without maths covers CA, CS, CFA, bank PO and actuarial eligibility rule by rule, plus how much of each exam is quantitative. The sections above cover what to do in the 2027 admission cycle.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  ogImage={socialImageUrl}
  ogImageWidth={1200}
  ogImageHeight={630}
  jsonLdExtras={[faqJsonLd]}
>
  <figure class="article-cover-visual">
    <img src={heroImageUrl} alt="An Indian Class 11–12 commerce student and parent compare college information, a ledger, calculator, and balance-sheet papers at a planning table." title="Career options after 12th commerce without maths: tests and deadlines" width="1600" height="900" loading="eager" fetchpriority="high" />
    <figcaption>Commerce without Maths is a subject-rule and deadline decision: compare the open doors, cost, tests, and evidence before committing.</figcaption>
  </figure>
  <p class="lead-para">
    <strong>Career options after 12th commerce without maths depend on a few tests and dates this year, not on a long list of courses.</strong>
    Only a few doors ask for a maths subject, and most others open through Accountancy, CUET or a registration you can plan. Get the order right now and you protect what a high-income skill portfolio needs most: a clean year.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Answer: Delhi University's 2026-27 Bulletin keeps B.Com (Hons) open through Accountancy and sets no minimum Class 12 marks, but BMS, BBA (FIA) and Business Economics need Mathematics or Applied Mathematics, and you can only sit CUET subjects you studied. Law, CA, CMA, CS and hotel management take any stream.</li>
      <li>Decision filter: pick tests that form a valid combination and do not collide in May 2027, when CUET, IPMAT and a CA Foundation sitting are all expected.</li>
      <li><strong>Next step: write your subject list, match it to the combination table below, and mark the first deadline. A clear plan plus one finished piece of proof is how a skill portfolio turns into higher income opportunities and earlier financial freedom.</strong></li>
    </ul>
  </div>

  <p>
    Most guides list courses. The harder part is the order: which test first, which subject set to register, and which deadline already closed. Every date below belongs to the admission cycle running right now, and each is marked as official, reported or still expected.
  </p>

  <p>
    For the full rule-by-rule map of what is open and closed without maths, read <a href="/blog/career-options/career-options-in-commerce-without-maths/">career options in commerce without maths</a>. More guides are in our <a href="/blog/career-options/">career options library</a>.
  </p>

  <p>
    For the wider list of commerce careers, see <a href="/blog/career-options/career-options-after-12th-commerce/">career options after 12th commerce</a>. If you want a plan built around your own marks, budget and timeline, <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">continuous career guidance</a> helps you choose the skill mix and proof that fits you, and the <a href="/career-skills-compass/">Career &amp; Skills Compass</a> helps you read your strengths first.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <figure class="article-visual">
    <img src="/images/blog/career-options/career-options-after-12th-commerce-without-maths/career-options-after-12th-commerce-without-maths-at-a-glance-summary.webp" alt="Summary card mapping commerce without Maths around subject-lock rules, DU routes, professional routes, deadlines, and the need for proof beyond exams." title="At a glance: Career options after 12th commerce without maths: tests and deadlines" width="1600" height="1000" loading="lazy" />
    <figcaption>Commerce without Maths is planned around the actual subject set, current admission rules, deadlines, cost, and one practical skill project.</figcaption>
  </figure>

  <h2 id="stand">Where you stand on 5 October 2026</h2>

  <p>
    Students and parents ask the same questions. Can I do B.Com (Hons) in Delhi University without maths? Which CUET subjects do I choose? I passed this year and got no seat, so what now?
  </p>

  <p>
    The answer depends on which of these four people you are.
  </p>

  <div class="situation-grid">
    {standCards.map((item) => (
      <div class="situation-card">
        <div class="situation-card__label">{item.label}</div>
        <div class="situation-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">A trap with dates</p>
    <ul class="callout__list">
      <li>Many guides mix 2026-27 dates with 2027-28 dates. The 2026 CUET exams ran from 11 to 31 May 2026, and the result came on 23 June 2026. Those dates do not apply to you if you finish Class 12 in 2027.</li>
      <li>Some popular course pages list salary ranges with no source, and one still lists DU JAT as a B.Com route, although DU's 2026-27 admission runs on CUET scores. An "updated" stamp on a coaching page is not proof that a rule is current.</li>
    </ul>
    <p class="callout__footer">
      Check each rule on the official notice, and treat every date below as the label says: official, reported or tentative.
    </p>
  </div>

  <h2 id="lock">The subject-lock rule that decides your options</h2>

  <p>
    This is the line most guides miss. Delhi University's 2026-27 Bulletin of Information says it is mandatory for the candidate to appear in CUET in those subjects in which they are appearing or have passed Class 12.
  </p>

  <p>
    In plain words, your CUET subjects are locked to your Class 12 subjects. A commerce student without maths cannot choose the Maths paper to open a maths line, even with strong practice.
  </p>

  <p>
    The Bulletin asks for Class 12 or its equivalent from a single recognised board, so CBSE, ICSE and state-board Intermediate students all start from the same rule.
  </p>

  <div class="highlight-box highlight-box--amber">
    <p>
      <strong>What this changes:</strong> the question is not "can I prepare maths in time". It is "which lines can I reach with the subjects I hold". Applied Mathematics counts in the same line as Mathematics, because DU writes it as "Mathematics/Applied Mathematics".
    </p>
  </div>

  <p class="note-line">
    Source: <a href="https://www.du.ac.in/uploads/2026/06012026_BOI_UG_compressed.pdf" target="_blank" rel="noopener noreferrer">University of Delhi Bulletin of Information, UG 2026-27</a> and the <a href="https://admission.uod.ac.in/userfiles/downloads/2026/17052026_Updated_FAQsUG%202026-final.pdf" target="_blank" rel="noopener noreferrer">DU UG admissions FAQs of 17 May 2026</a>. Programme lines can change each year, so read the 2027-28 Bulletin when it is published.
  </p>

