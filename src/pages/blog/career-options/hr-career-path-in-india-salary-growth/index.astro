---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'HR career path in India: the real salary growth ladder, not just job titles';
const description =
  'The HR career path in India salary growth story runs from recruiter to HRBP to HR manager to CHRO, but specialisation changes the math. Real pay data by level, branch, and certification.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/hr-career-path-in-india-salary-growth';
const publishedDateISO = '2026-07-16';
const publishedDateLabel = '16 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-hr-actually-does', label: 'What HR work actually looks like' },
  { id: 'progression-ladder', label: 'The progression ladder, title by title' },
  { id: 'salary-by-experience', label: 'Real salary by experience level' },
  { id: 'specialisation-branches', label: 'The 4 specialisation branches' },
  { id: 'specialisation-pays-more', label: 'Why specialists can out-earn generalist HRBPs' },
  { id: 'entry-qualifications', label: 'Entry routes: BBA, MBA-HR, and no-degree paths' },
  { id: 'certifications', label: 'SHRM, CHRP, and which certification actually matters' },
  { id: 'ai-impact', label: 'How AI and HR tech are changing the job' },
  { id: 'sector-differences', label: 'PSU, government, and startup HR pay differences' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you commit' },
  { id: 'roadmap', label: 'A realistic roadmap to your first HR role' },
  { id: 'gates', label: 'The 3 Gates before you apply' },
  { id: 'mistakes', label: 'Mistakes that stall HR salary growth' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const progressionRows = [
  {
    title: 'HR Executive / Recruiter',
    years: '0-2 years',
    work: 'Sourcing, screening, scheduling interviews, onboarding paperwork, HRIS data entry, and basic policy support under supervision. This is the entry gate almost everyone passes through, regardless of which specialisation they eventually pick.',
  },
  {
    title: 'HR Generalist',
    years: '2-4 years',
    work: 'Owns end-to-end HR for a small team or business unit: recruitment, onboarding, engagement activities, exit formalities, and first-level employee-relations issues, with less hand-holding from a senior HR leader.',
  },
  {
    title: 'HR Business Partner (HRBP)',
    years: '4-8 years',
    work: 'Partners directly with one or more business leaders on workforce planning, performance calibration, attrition analysis, and organisation-design decisions. This is where HR stops being purely administrative and starts influencing business calls.',
  },
  {
    title: 'HR Manager / Senior HRBP',
    years: '7-12 years',
    work: 'Owns HR strategy and execution for a function, region, or business unit, manages a small team of generalists or HRBPs, and carries real budget and headcount-planning accountability.',
  },
  {
    title: 'HR Director / AVP-HR',
    years: '12-18 years',
    work: 'Sets people strategy across multiple functions or business units, sits in senior leadership conversations, and is judged on retention, workforce cost, and organisational health metrics, not just process compliance.',
  },
  {
    title: 'CHRO / VP-HR',
    years: '18+ years',
    work: 'Owns enterprise-wide people strategy, reports to the CEO or the board, and is directly accountable for culture, leadership pipeline, M&A people-integration, and how the company\'s workforce cost scales with revenue.',
  },
];

const salaryExperienceRows = [
  {
    stage: 'Entry-level, 0-2 years',
    range: 'Rs 2.5-4.5 LPA',
    context: 'Typical range for an HR Executive or Recruiter role at most Indian companies. Staffing and consulting firms often sit at the lower end of this band; product companies and GCCs pay closer to the top.',
  },
  {
    stage: 'Early career, 2-4 years',
    range: 'Rs 4.5-7.5 LPA',
    context: 'HR Generalist territory, once you can run a full recruitment cycle, onboarding process, or basic engagement calendar without close supervision.',
  },
  {
    stage: 'Mid-career, 4-8 years',
    range: 'Rs 8-20 LPA',
    context: 'HRBP band. National average sits around Rs 12.5 LPA, with the middle 50% of HRBPs earning between roughly Rs 8.2-20.3 LPA depending on company size, sector, and city. Bangalore HRBPs average about 21% above the national figure.',
  },
  {
    stage: 'Senior, 7-15 years',
    range: 'Rs 18-35 LPA',
    context: 'HR Manager to HR Director band. AmbitionBox places typical HR Manager pay around Rs 8-18 LPA broadly, with strong performers at larger organisations crossing Rs 19 LPA well before Director-level titles.',
  },
  {
    stage: 'Late career, 18+ years',
    range: 'Rs 45 LPA to Rs 1-4 crore+',
    context: 'CHRO / VP-HR band. Broad market averages across all company sizes sit around Rs 45-78 LPA, but CHROs at large listed enterprises such as Infosys, the Tata Group, and HDFC Bank earn between roughly Rs 1 crore and Rs 4 crore a year including bonus and ESOPs.',
  },
];

const specialistBranches = [
  {
    badge: 'Branch 1',
    title: 'Talent Acquisition and recruitment',
    body: 'You own the hiring funnel end to end: sourcing strategy, employer branding, interview panels, offer negotiation, and increasingly, directing AI screening tools rather than manually reading every resume.',
    fit: 'You like the chase of finding the right person for a hard-to-fill role and can handle rejection, ghosting, and hiring-manager pressure without losing momentum.',
    caution: 'AI-driven resume screening is already automating the first-pass shortlisting layer in most large companies, which raises the bar on sourcing strategy and stakeholder management rather than removing the role.',
    tags: ['Fastest headcount growth', 'AI-tool fluency required'],
  },
  {
    badge: 'Branch 2',
    title: 'Learning & Development (L&D)',
    body: 'You design and run training, onboarding, leadership-development, and skill-building programmes, and increasingly build or curate digital and AI-assisted learning content instead of only running classroom sessions.',
    fit: 'You enjoy building structured programmes, presenting to groups, and can measure whether training actually changed behaviour, not just attendance numbers.',
    caution: 'Fresher L&D roles pay modestly (roughly Rs 4-14 LPA), and pay growth depends heavily on moving from logistics-and-delivery work into programme ownership and measurable business impact.',
    tags: ['Digital/AI learning pays 30-45% more', 'Presentation-heavy'],
  },
  {
    badge: 'Branch 3',
    title: 'Compensation & Benefits (C&B)',
    body: 'You design pay structures, run salary benchmarking, manage variable-pay and ESOP plans, and advise leadership on what the company can actually afford to pay without losing its best people.',
    fit: 'You are comfortable with spreadsheets, benchmarking data, and defending a pay decision with numbers rather than gut feel, and you do not mind being the person who says a raise request does not fit the band.',
    caution: 'This branch pays meaningfully above generalist HR at the same experience level, but it usually needs a stronger analytical or finance-adjacent foundation than a typical HR generalist path builds by default.',
    tags: ['Highest specialist ceiling', 'Finance-adjacent skill needed'],
  },
  {
    badge: 'Branch 4',
    title: 'HR Analytics / People Analytics',
    body: 'You build dashboards and models on attrition risk, hiring funnel efficiency, engagement drivers, and workforce cost, and translate that data into decisions leadership actually acts on.',
    fit: 'You like data work but also want it to matter to real people decisions, not just live in a report nobody reads.',
    caution: 'This is currently one of the fastest-growing and best-paid HR specialisations, growing at roughly 14.3% CAGR through 2030, but it demands genuine data and AI-tool skill on top of HR knowledge, not just curiosity about numbers.',
    tags: ['14.3% CAGR through 2030', 'AI/ML skill = 30-50% premium'],
  },
];

const specialistPayRows = [
  {
    role: 'Talent Acquisition Manager',
    range: 'Rs 8.5-19.5 LPA (avg ~13.5 LPA); top 10% cross Rs 31.8 LPA',
    note: 'VP/Head of Talent Acquisition roles reach Rs 165-204 LPA+ at large organisations, per the 2026 Keka and SHRM India HR Pay Pulse Report covering roughly 1.84 lakh data points.',
  },
  {
    role: 'L&D Specialist / Manager',
    range: 'Rs 4-14 LPA fresher; Rs 11.6 LPA average senior specialist',
    note: 'Digital and AI-enabled learning roles carry a 30-45% premium; leadership-development and enterprise-transformation-linked L&D roles carry a 25-40% premium over generic training delivery.',
  },
  {
    role: 'Compensation & Benefits Specialist / Manager',
    range: 'Rs 14-35 LPA specialist/manager band',
    note: 'Total Rewards Head or Director-level C&B roles at large companies can reach Rs 130-180 LPA. Hi-Tech, BFSI, and Bangalore-based roles carry an additional 25-45% premium.',
  },
  {
    role: 'HR Analyst / People Analytics',
    range: 'Rs 8.9 LPA entry (1-3 yrs) to Rs 20-50 LPA mid-senior',
    note: 'Analytics leadership roles in the Bangalore/Mumbai/Delhi NCR/Hyderabad GCC belt pay well above the national median; AI/ML and predictive-analytics skill adds a 30-50% premium on top of base HR analytics pay.',
  },
];

const entryRows = [
  {
    route: 'BBA / BA / B.Com (any specialisation)',
    detail: 'The most common entry route into an HR Executive or Recruiter role. A generalist bachelor\'s degree plus decent communication skill and basic MS Excel/HRIS familiarity is enough to get shortlisted for most entry-level HR openings in India.',
  },
  {
    route: 'MBA-HR / PGDM-HR',
    detail: 'Not required to enter HR, but it meaningfully speeds up the move to HRBP or HR Manager-level roles, because it signals broader business and people-strategy judgment beyond administrative HR tasks.',
  },
  {
    route: 'PGDHRM / one-year HR diploma',
    detail: 'A cheaper, faster alternative to a full MBA for people who already have a bachelor\'s degree in another field and want a structured HR-specific credential without a two-year commitment.',
  },
  {
    route: 'No formal HR degree, career switch',
    detail: 'Genuinely possible, especially into recruitment, L&D, or HR operations roles, if you can show transferable proof: managing a team, running training sessions, handling vendor negotiations, or building process documentation in a previous role.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Fit',
    body: 'Can you sit through recurring rounds of layoff conversations, performance-improvement-plan discussions, and salary-band disputes without it wearing you down over years? HR is one of the few functions where you regularly deliver news the other person does not want to hear.',
    note: 'If confrontation and delivering difficult news already drain you badly in small doses, lean toward L&D or HR analytics branches, which involve far less direct conflict than generalist HRBP or ER work.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can you afford the entry-level pay band (Rs 2.5-4.5 LPA) for the 2-4 years it typically takes to reach HR Generalist pay, or do you need a parallel income plan while you build toward HRBP-level compensation?',
    note: 'A parallel skill, such as basic Excel/data analysis, payroll software fluency, or a small side project in recruitment content, protects your runway while you build toward the HRBP pay jump.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'HR analytics is growing at roughly 14.3% CAGR through 2030, and India\'s Global Capability Centres continue to add large numbers of structured, well-paid HR roles each year. Demand for HR professionals overall is broad and steady, not scarce like a handful of prestige finance seats.',
    note: 'Broad demand is genuinely good news here. The honest constraint is not "will an HR job exist" but "will your business judgment, data fluency, and stakeholder-management skill clear the bar for the higher-paying branches."',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI-driven recruitment tools already screen resumes, shortlist candidates, and flag attrition risk faster than a human doing it manually. Indian IT and ITES companies are projected to hit roughly 84% AI adoption in recruitment by the end of 2026, and AI-linked job postings are growing 32% year-on-year.',
    note: 'Treat AI-tool fluency as part of the HR job description from day one, not an optional add-on. HR professionals who can direct, audit, and improve on AI output are the ones whose roles stay valuable as the manual, repetitive layer of the job keeps shrinking.',
  },
];

const gateItems = [
  {
    num: '01',
    title: 'Proof of Skill',
    title2: 'Can you actually run a full recruitment cycle or basic HR process end to end?',
    body: 'Build or document one real example: a job description you wrote, a screening scorecard you designed, an onboarding checklist you built, or an attrition trend you analysed in a spreadsheet. This is the concrete proof an interviewer can ask you to walk through live.',
  },
  {
    num: '02',
    title: 'Proof of Communication',
    title2: 'Can you explain a people decision in plain language to someone who disagrees with you?',
    body: 'Practice explaining, out loud, why a candidate was rejected, why a raise request does not fit the current pay band, or why a policy exists, in language a frustrated employee or hiring manager can actually accept.',
  },
  {
    num: '03',
    title: 'Proof of Value',
    title2: 'Has anyone outside your own head validated your judgment on a real case?',
    body: 'Show a real or practice HR decision, a job description, a training plan, or an analytics dashboard, to a working HR professional, and ask directly whether it would survive scrutiny in a real interview or a real business review. Fix the gaps their questions expose.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Staying purely generalist for 8+ years with no specialisation',
    body: 'Generalist HR experience is valuable early on, but the pay ceiling for a pure generalist without any depth in analytics, compensation, talent acquisition strategy, or L&D design plateaus faster than a specialised HRBP or branch expert\'s does.',
  },
  {
    num: '02',
    title: 'Collecting certifications without matching real work experience',
    body: 'An SHRM-CP or MBA-HR opens doors, but interviewers for HRBP and manager-level roles test whether you have actually handled a real attrition problem, a real restructuring, or a real pay-band dispute, not just whether you passed an exam.',
  },
  {
    num: '03',
    title: 'Ignoring AI-tool fluency because "that is a recruiter problem"',
    body: 'AI is reshaping recruitment first, but analytics, L&D content, and even compensation benchmarking are being reshaped next. An HR professional who cannot direct or audit AI output across at least one of these areas is competing on exactly the layer of the job that is shrinking.',
  },
  {
    num: '04',
    title: 'Treating CHRO as the only "real" HR success story',
    body: 'A senior Total Rewards Head, a VP of Talent Acquisition, or a Head of People Analytics at a large company frequently out-earns a CHRO at a smaller company. Chasing the CHRO title specifically, instead of chasing genuine specialisation depth and business impact, can mean leaving real money on the table.',
  },
  {
    num: '05',
    title: 'Switching specialisation branches every 1-2 years',
    body: 'Moving from recruitment to L&D to compensation every year or two prevents you from building the depth that unlocks the higher end of any single branch\'s pay range. Pick a branch by your third or fourth year and go deep before you consider switching again.',
  },
];

const faqItems = [
  {
    q: 'What is the HR career path in India, step by step?',
    a: 'Most people start as an HR Executive or Recruiter (0-2 years), move to HR Generalist (2-4 years) once they can run HR processes independently, then to HR Business Partner or HRBP (4-8 years) once they start advising business leaders directly. From there the path splits toward HR Manager or Senior HRBP (7-12 years) managing a small team, HR Director or AVP-HR (12-18 years) shaping strategy across functions, and eventually CHRO or VP-HR (18+ years) owning enterprise-wide people strategy. Alongside this generalist ladder, specialised branches in talent acquisition, learning and development, compensation and benefits, and HR analytics can pay as well as or better than the generalist track at senior levels.',
  },
  {
    q: 'What is the real HR career path in India salary growth curve?',
    a: 'Entry-level HR Executives and Recruiters typically earn Rs 2.5-4.5 LPA. Early-career HR Generalists (2-4 years) move to roughly Rs 4.5-7.5 LPA. HRBPs (4-8 years) average around Rs 12.5 LPA, with a typical range of Rs 8.2-20.3 LPA depending on company and city. HR Managers and Directors (7-15 years) commonly reach Rs 18-35 LPA. CHROs and VP-HR professionals (18+ years) average roughly Rs 45-78 LPA across the broad market, while CHROs at large listed enterprises such as Infosys, the Tata Group, and HDFC Bank earn between Rs 1 crore and Rs 4 crore including bonus and ESOPs.',
  },
  {
    q: 'Does an MBA in HR actually increase salary in India?',
    a: 'An MBA-HR or PGDM-HR is not required to enter HR, since most entry-level HR Executive and Recruiter roles accept any bachelor\'s degree. Where an MBA-HR genuinely helps is speeding up the move from HR Generalist to HRBP or HR Manager, because it signals stronger business and people-strategy judgment than administrative HR experience alone.',
  },
  {
    q: 'Is SHRM certification worth it for an HR career in India?',
    a: 'SHRM-CP and SHRM-SCP are globally recognised HR certifications, and professionals who hold SHRM certification report salaries roughly 14-15% higher than uncertified peers, with 88% saying it improved their promotion chances. It is most valuable for professionals trying to build broad HR credibility early on, or trying to signal strategic-level readiness for a Senior HRBP or Director-track move. CHRP is a Canada-specific HR credential and is generally less relevant for an India-based HR career than SHRM-CP/SCP, an MBA-HR, or specialised certifications in compensation, analytics, or learning design.',
  },
  {
    q: 'Which HR specialisation pays the most in India: generalist, talent acquisition, L&D, compensation, or analytics?',
    a: 'At the senior end, compensation and benefits and HR analytics tend to pay the most, because both combine HR knowledge with a scarce quantitative or data skill set. Total Rewards Heads can reach Rs 130-180 LPA at large companies, and VP/Head of Talent Acquisition roles can reach Rs 165-204 LPA+ at scale, both of which regularly outpace a mid-market CHRO\'s total compensation. HR analytics is currently the fastest-growing specialisation, expanding at roughly 14.3% CAGR through 2030. Generalist HRBP work remains the most common and flexible entry into senior HR leadership, but it is not automatically the highest-paying branch once you compare senior specialists against each other.',
  },
  {
    q: 'Will AI replace HR jobs in India?',
    a: 'AI is automating the repetitive, high-volume layer of HR work first, especially resume screening and initial candidate shortlisting, where AI adoption in recruitment is projected to reach roughly 84% among Indian IT and ITES companies by the end of 2026. It is not replacing HR professionals outright. The HR professionals who stay competitive are the ones who use AI to remove tactical drudgery and then spend the time saved on judgment-heavy work AI cannot easily replicate: reading office politics, handling a sensitive employee-relations case, or defending a compensation decision to a skeptical leadership team.',
  },
  {
    q: 'Can you become a CHRO without an MBA?',
    a: 'It is possible but uncommon at large, listed companies, where most CHROs carry an MBA or equivalent postgraduate HR qualification alongside 18-20+ years of progressively senior HR experience. It is more realistic at mid-size or smaller companies, where demonstrated business impact, specialisation depth, and leadership track record can outweigh the specific degree, though a postgraduate HR or business qualification still meaningfully widens the realistic set of CHRO opportunities available to you.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Career Options', item: 'https://futurecareerschool.com/blog/career-options' },
      { '@type': 'ListItem', position: 4, name: 'HR Career Path in India Salary Growth', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={jsonLd}
>
  <p class="lead-para">
    The <strong>HR career path in India</strong> runs from recruiter or HR executive to HR generalist,
    HRBP, HR manager, HR director, and eventually CHRO, and salary growth follows a fairly checkable
    curve once you can see it laid out honestly. What most guides skip is that specialisation, not just
    tenure, decides how high that curve actually climbs.
  </p>
  <p>
    This is a genuine <strong>high-value skill portfolio</strong> decision, not just a job title chase.
    An HR professional who can run a hiring funnel, read an attrition dashboard, defend a pay-band
    decision, or design a learning programme that actually changes behaviour becomes far harder to
    replace than one who only processes paperwork — and that combination of scarce judgment and visible
    proof of work is what actually unlocks the higher end of HR pay in India, not the degree name on your
    resume.
  </p>
  <p>
    This is the honest map: the real progression ladder title by title, real salary by experience level,
    the four specialisation branches that can out-earn a generic generalist track, which certifications
    genuinely help, and how AI and HR tech are already reshaping entry-level HR work.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>The core ladder runs HR Executive/Recruiter (0-2 yrs) to Generalist (2-4 yrs) to HRBP (4-8 yrs) to HR Manager (7-12 yrs) to Director/AVP (12-18 yrs) to CHRO/VP-HR (18+ yrs).</li>
      <li>Real pay: roughly Rs 2.5-4.5 LPA entry-level, Rs 8-20 LPA at HRBP stage, Rs 18-35 LPA at manager/director stage, and Rs 45 LPA to several crore at CHRO level depending on company size.</li>
      <li>Four specialisation branches — talent acquisition, L&D, compensation & benefits, and HR analytics — can pay as well as or better than the generalist track once you reach senior levels.</li>
      <li>SHRM-CP/SCP carries a real, measurable pay premium in the market; CHRP is a Canada-specific credential and matters far less for an India-based HR career.</li>
      <li>AI is already automating first-pass recruitment screening across most large Indian companies, which raises the bar on judgment and stakeholder work rather than removing HR roles outright.</li>
      <li>HR scales through business and people judgment, AI workflow design, communication, analytics, change leadership, and proof of better hiring, retention, performance, or workforce outcomes—not by staying a transaction processor.</li>
    </ul>
  </div>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Get a second opinion on your HR career plan</a>
    <a class="btn-outline cta-assessment-lite" href="https://futurecareerschool.com/services/assessments">Use a free assessment as a quick first check</a>
  </div>

  <nav class="jump-nav" aria-label="Jump to section">
    <span class="jump-nav__label">Jump to section</span>
    <ul class="jump-nav__list">
      {jumpLinks.map((link) => (
        <li><a href={`#${link.id}`}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer</h2>
  <p>
    If you are mapping the HR career path in India for salary growth, start with the core ladder:
    HR Executive or Recruiter, then HR Generalist, then HR Business Partner, then HR Manager, then
    HR Director, and eventually CHRO. Entry pay sits around Rs 2.5-4.5 LPA and climbs to Rs 8-20 LPA
    by the HRBP stage, then Rs 18-35 LPA at manager and director level. The part most people miss is
    that four specialised branches — talent acquisition, learning and development, compensation and
    benefits, and HR analytics — can pay as well as or better than a generic generalist track once you
    reach senior levels, so picking a lane by year three or four usually pays off more than staying a
    broad generalist for a decade.
  </p>

  <p>
    Before going further into salary detail, it helps to see this inside the wider
    <a href="/blog/career-options/">career options</a> landscape, since HR sits alongside other
    people-facing and business-facing paths worth comparing before you commit years to it.
  </p>

  <h2 id="what-hr-actually-does">What HR work actually looks like</h2>
  <p>
    Strip away the title and HR's core job is this: you make decisions about people — who gets hired,
    who gets paid what, who gets trained, who gets let go, and how the company treats all of them along
    the way — and you have to defend those decisions to people who often disagree with you.
  </p>
  <p>
    None of that is glamorous day to day. It is chasing hiring managers for interview feedback, updating
    HRIS records, explaining the same leave policy for the tenth time this month, and sitting through
    uncomfortable conversations you did not create but still have to deliver. The satisfying part —
    building a team that actually works, or fixing a broken hiring process — happens regularly enough to
    matter, but it sits on top of a lot of routine, people-heavy, sometimes emotionally draining work.
  </p>
  <div class="callout callout--teal">
    <p class="callout__eyebrow">Honest take</p>
    <p>
      If the appeal is being "the people person" more than the actual work of enforcing policy,
      defending pay decisions, and sitting through difficult conversations, this career will feel
      disappointing fast. Talk to two or three working HR professionals about their actual week before
      you commit years to chasing the title.
    </p>
  </div>

  <h2 id="progression-ladder">The progression ladder, title by title</h2>
  <p>
    Titles vary by company, but the shape of the climb is consistent across most Indian employers, from
    startups to large enterprises. Here is what each stage actually looks like, and roughly how long
    people spend there before moving up.
  </p>
  <div class="protocol-stack">
    {progressionRows.map((row) => (
      <div class="protocol-row">
        <span class="protocol-num">{row.years}</span>
        <div class="protocol-body">
          <h3>{row.title}</h3>
          <p>{row.work}</p>
        </div>
      </div>
    ))}
  </div>
  <p>
    Between roughly 10 and 13 years of experience is often where paths genuinely diverge: some HR
    professionals see pay accelerate sharply as they take on HRBP or manager-level scope tied directly
    to business outcomes, while others plateau if they stay in process-heavy, purely administrative work
    without adding strategic or specialised depth.
  </p>

  <h2 id="salary-by-experience">Real salary by experience level</h2>
  <p>
    Here is the honest pay curve across the core ladder, based on current market data across Indian
    employers of varying sizes.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Experience stage</th>
          <th>Typical total pay</th>
          <th>Context</th>
        </tr>
      </thead>
      <tbody>
        {salaryExperienceRows.map((row) => (
          <tr>
            <td data-label="Experience stage">{row.stage}</td>
            <td data-label="Typical total pay">{row.range}</td>
            <td data-label="Context">{row.context}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="callout callout--gold">
    <p class="callout__eyebrow">Honest take</p>
    <p>
      Do not pick your first HR role by headline pay alone. A generalist role at a company with a
      structured HR function that exposes you to hiring, engagement, and basic analytics builds a
      stronger case for your next move than a slightly higher-paying role where you spend two years
      only processing paperwork.
    </p>
  </div>

  <h2 id="specialisation-branches">The 4 specialisation branches</h2>
  <p>
    Every "HR" job posting hides one of several genuinely different daily jobs once you move past the
    generalist stage. Picking a branch by your third or fourth year, based on which work actually suits
    you, tends to pay off more than staying broad indefinitely.
  </p>
  <div class="track-grid">
    {specialistBranches.map((branch) => (
      <div class="track-card">
        <span class="track-badge">{branch.badge}</span>
