const salaryRows = [
  {
    stage: 'Fresher or coordinator-level (0-2 years)',
    range: 'Rs 7-9 LPA',
    note: 'Usually a project coordinator or associate PM title, not a standalone "Project Manager" title yet, regardless of industry.',
  },
  {
    stage: 'IT / software project manager, mid-experience',
    range: 'Rs 17-18 LPA average',
