];

const alternativeCards = [
  {
    badge: 'Entry-level',
    title: 'CAPM (Certified Associate in Project Management)',
    body: 'Issued by PMI, the same body behind PMP. Built for people with little or no project management experience who still want a recognised credential on a fresher or early-career resume.',
