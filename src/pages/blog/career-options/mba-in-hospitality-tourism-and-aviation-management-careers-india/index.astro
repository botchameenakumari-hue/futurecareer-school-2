const description = "MBA in hospitality, tourism and aviation management in India: roles, a budget check, a free-first plan and honest limits.";
const seoDescription = "Service roles reward people skills; check the cost against entry pay.";
const canonical = "https://futurecareerschool.com/blog/career-options/mba-in-hospitality-tourism-and-aviation-management-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is an MBA needed in hospitality?",
    "Not always. Many roles start with a degree or diploma. Check notices."
  ],
  [
    "What do tourism MBAs do?",
    "Tour planning, operations, sales and destination work."
  ],
  [
    "What about aviation management?",
    "Roles in airline and airport services. Verify entry routes."
  ],
  [
    "Is the work shift based?",
    "Often yes."
  ],
  [
    "How do I check a college?",
    "Ask alumni and review internship details."
  ],
  [
    "Can I start my own venture?",
    "Yes, with a pilot and checked licences."
  ],
  [
    "Is it worth the cost?",
    "Compare cost against typical entry roles."
  ],
  [
    "Will AI replace these roles?",
    "Routine desk work shrinks. Service skill remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
