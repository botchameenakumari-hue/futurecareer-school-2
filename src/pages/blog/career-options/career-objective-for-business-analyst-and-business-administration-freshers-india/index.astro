  <h2 id="examples">Pattern examples to adapt, not copy</h2>

  <p>
    These patterns show structure. Replace every detail with your own true facts.
  </p>
  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Target role</th>
          <th>Pattern</th>
