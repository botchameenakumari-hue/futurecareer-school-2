          <td data-label="Fill in with">Your process and your result</td>
        </tr>
        <tr>
          <td data-label="Target role"><strong>Business development trainee</strong></td>
          <td data-label="Pattern">Communicator who researched ten target accounts for a campus club, seeking to support outreach and partnerships</td>
          <td data-label="Fill in with">Your club and your numbers</td>
        </tr>
