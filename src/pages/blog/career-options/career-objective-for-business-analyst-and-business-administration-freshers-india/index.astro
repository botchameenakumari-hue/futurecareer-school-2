    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Line</th>
          <th>What to write</th>
          <th>Example prompt</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Line"><strong>Role</strong></td>
          <td data-label="What to write">The role you apply for</td>
          <td data-label="Example prompt">Business analyst or operations trainee</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Proof</strong></td>
          <td data-label="What to write">One thing you did</td>
          <td data-label="Example prompt">A project, course or internship</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Skill</strong></td>
          <td data-label="What to write">Two skills you bring</td>
          <td data-label="Example prompt">Spreadsheets, writing, process mapping</td>
        </tr>
        <tr>
          <td data-label="Line"><strong>Offer</strong></td>
          <td data-label="What to write">What you will do for the employer</td>
          <td data-label="Example prompt">Help the team clarify requirements and improve reports</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Customise the role and offer for each notice.
  </p>

