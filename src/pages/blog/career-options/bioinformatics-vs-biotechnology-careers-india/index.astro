          <td data-label="Biotechnology">Lab assistant, QC, production trainee</td>
          <td data-label="Bioinformatics">Data analyst, pipeline assistant, research assistant</td>
        </tr>
        <tr>
          <td data-label="Point"><strong>Bottleneck</strong></td>
          <td data-label="Biotechnology">Lab access and equipment</td>
          <td data-label="Bioinformatics">Coding practice and good datasets</td>
        </tr>
        <tr>
          <td data-label="Point"><strong>Remote work</strong></td>
          <td data-label="Biotechnology">Limited</td>
          <td data-label="Bioinformatics">Often possible</td>
        </tr>
      </tbody>
    </table>
