  <h2 id="trial">A two-week trial of each</h2>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Day</th>
          <th>Biotechnology trial</th>
          <th>Bioinformatics trial</th>
        </tr>
      </thead>
      <tbody>
