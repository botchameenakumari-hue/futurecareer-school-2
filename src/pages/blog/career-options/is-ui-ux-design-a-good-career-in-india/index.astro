  },
  {
    signal: 'Applying to every junior UI/UX opening with the same generic resume and templated case study',
    reality: 'Some individual junior postings at visible product companies now draw several hundred applicants. A generic application competing in that pool needs a specific reason to get noticed; volume alone does not work the way it did when the field was smaller.',
  },
];

const trackRows = [
  {
    track: 'UI/UX design (the broad, common entry title)',
    dailyWork: 'User flows, wireframes, interactive prototypes, usability testing, and design-system components, handed off to engineers with production-ready specs.',
    fitsWho: 'Someone drawn to how a product works and behaves, not just how it looks, and comfortable with research, testing, and iteration cycles tied to real user data.',
  },
  {
    track: 'Graphic design (brand, marketing, print, and digital assets)',
    dailyWork: 'Brand and campaign briefs, layout iterations, client revision rounds, and production-ready file handoff across print and digital formats.',
    fitsWho: 'Someone who enjoys visual problem-solving inside brand and marketing constraints more than interaction logic or usability testing. See graphic design vs UI/UX design career in India for the full skill-overlap comparison.',
  },
  {
    track: 'Product design (UI/UX plus business and metrics ownership)',
    dailyWork: 'Feature prioritisation with product managers, A/B test design, funnel and retention analysis, and design decisions tied directly to revenue or engagement numbers.',
