];

const checkpointItems = [
  {
    num: '01',
    title: 'Fit',
    body: 'UI/UX design rewards people who can sit with unglamorous research grunt work, transcribing user interviews, tagging usability-test recordings, writing research reports nobody reads carefully, and still care about getting the interaction detail right on the fortieth iteration of a form flow.',
