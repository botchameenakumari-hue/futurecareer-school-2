const digitalLadder = [
  {
    num: '01',
    title: 'Junior digital forensic analyst',
    body: 'Entry-level work: imaging drives, extracting call/chat logs, and running first-pass analysis under a senior analyst\'s review. Usually needs a CS/IT degree plus one entry-level certification (CHFI or equivalent), not a forensic science degree specifically.',
  },
  {
    num: '02',
    title: 'Digital forensic analyst / cyber forensic investigator',
    body: 'Owns full case investigations end to end: mobile and cloud forensics, malware triage, and writing reports built to survive cross-examination in court. This is where pay starts pulling well ahead of the government lab-science ladder.',
  },
  {
    num: '03',
    title: 'Senior analyst / forensic consultant',
    body: 'Leads complex, multi-device investigations for banks, fintechs, or law firms, and increasingly testifies or briefs legal teams directly. Deep specialisation, mobile forensics, cloud forensics, or malware reverse engineering, is what separates this rung from the one below it.',
  },
  {
    num: '04',
    title: 'Practice lead / independent consultant',
    body: 'Runs a forensic investigations practice inside a cybersecurity firm or works independently across corporate and legal clients. This is the closest thing this field has to an ownership path, and it exists almost exclusively on the digital side, not the government lab-science side.',
  },
];

const accountingLadder = [
  {
    num: '01',
