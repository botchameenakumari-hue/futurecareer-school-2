const publishedDateISO = '2026-09-13';
const publishedDateLabel = '13 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'track-map', label: 'The eight real tracks, at a glance' },
  { id: 'lab-track', label: 'Track 1: the government FSL ladder' },
  { id: 'digital-track', label: 'Track 2: digital and cyber forensics' },
  { id: 'accounting-track', label: 'Track 3: forensic accounting and fraud examination' },
