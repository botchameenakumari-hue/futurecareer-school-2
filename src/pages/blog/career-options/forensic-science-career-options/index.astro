const faqItems = [
  {
    q: 'What are the career options after studying forensic science in India?',
    a: 'Eight real tracks exist, not one: forensic biology/DNA and serology, digital and cyber forensics, forensic accounting and fraud examination, forensic toxicology, ballistics and firearms examination, questioned documents examination, forensic psychology, and forensic anthropology/odontology. Each has its own employer base, entry route, and pay scale, so "forensic science career options" is really a question of which of these eight tracks fits your background and goals, not a single job description.',
  },
