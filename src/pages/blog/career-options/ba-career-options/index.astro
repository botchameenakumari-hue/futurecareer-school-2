---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'BA career options in India: 3 lanes and what each costs in years';
const description =
  'BA career options in India fall into three lanes: work now, study more, or sit an exam. Real odds, pay, eligibility and a subject-wise map to pick yours today.';
const canonical = 'https://futurecareerschool.com/blog/career-options/ba-career-options/';
const publishedDateISO = '2026-09-29';
const publishedDateLabel = '29 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';
const heroImageUrl = '/images/blog/career-options/ba-career-options/ba-career-options-hero.webp';
const socialImageUrl = '/images/blog/career-options/ba-career-options/ba-career-options-social.jpg';

const jumpLinks = [
  { id: 'lanes', label: 'The 3 lanes after a BA' },
  { id: 'numbers', label: 'What the job numbers say about graduates' },
  { id: 'work-now', label: 'Lane 1: start working now' },
  { id: 'study-more', label: 'Lane 2: study one more degree' },
  { id: 'exam', label: 'Lane 3: the exam lane and its real odds' },
  { id: 'subject-map', label: 'Which lane your BA subject feeds' },
  { id: 'four-year', label: '3-year or 4-year BA: what changes' },
  { id: 'skill-stack', label: 'The skill layer that raises your pay' },
  { id: 'protocol', label: 'The 4-Checkpoint Protocol' },
  { id: 'cost-of-waiting', label: 'The cost of waiting, in rupees' },
  { id: 'mistakes', label: 'Expensive wrong turns' },
  { id: 'test', label: 'Test a lane before you commit' },
  { id: 'faq', label: 'FAQs' },
];

const laneTable = [
  {
    lane: 'Work now, add skills on the job',
    asks: 'A visible skill on top of the BA, and the nerve to apply before you feel ready.',
    firstIncome: 'Soonest. Offers can start within weeks of a solid portfolio.',
    catch: 'Entry pay is modest. Without a second skill you can sit at the same salary for years.',
  },
  {
    lane: 'Study one more degree (MA, MBA, LLB, B.Ed, PG diploma)',
    asks: 'Fees, one to three more years, and an entrance exam for most good seats.',
    firstIncome: 'Delayed by the length of the course.',
    catch: 'A second degree only pays if the seat, the institute and the placement record justify the fee.',
  },
  {
    lane: 'Competitive exam (UPSC, SSC, banking, teaching eligibility)',
    asks: 'Long, focused preparation and the ability to absorb a real chance of no result.',
    firstIncome: 'Unpredictable. Years for some, never for most.',
    catch: 'Very high stability if you get in, very low odds per attempt. You need a parallel plan.',
  },
];

const numberCards = [
  {
    label: 'Youth jobs',
    title: 'Unemployment among 15-29 year olds was 9.9% in 2025, and 13.6% in cities',
    body: 'That is the official Periodic Labour Force Survey figure released by the government for January to December 2025. The overall national rate is far lower, which tells you where the pressure sits: young, urban and freshly graduated.',
  },
  {
    label: 'Graduate reality',
    title: 'Graduate unemployment is roughly four times the national rate',
    body: 'Data for India\'s analysis of the 2023-24 PLFS puts graduate unemployment near 13%, against an overall rate of 3.2% that year. The same analysis finds 57% of graduate workers hold salaried jobs, so the degree does help once you are in. For 2025 the official report gives 6.5% for everyone educated to secondary level and above, and other outlets report higher graduate-only figures, so treat any single graduate number as a range.',
  },
  {
    label: 'Employability',
    title: 'Arts and humanities scored 55.55% on the India Skills Report 2026, commerce 62.81%',
    body: 'This is an industry employability survey, not a count of jobs. Read it as a signal that employers see a skills gap, not a verdict on your subject. Its own summary points to digital marketing, research and content roles as growing areas for arts graduates.',
  },
];

const roleRows = [
  {
    role: 'HR, talent acquisition and people operations',
    week: 'Screening calls, scheduling, onboarding paperwork, tracker updates. Mostly coordination and communication.',
    pay: 'Fresher pay on AmbitionBox runs roughly Rs 1.2-5 lakh a year for HR executives with 0-2 years of experience.',
  },
  {
    role: 'Digital marketing and social media',
    week: 'Posting calendars, ad reports, basic SEO, reading numbers in a dashboard, writing copy.',
    pay: 'Fresher range on AmbitionBox is about Rs 1.1-4.7 lakh a year. The top of the range goes to people who can show campaign results.',
  },
  {
    role: 'Content, editorial and UX writing',
    week: 'Research, drafting, editing, fact-checking. AI now writes the first draft, so your value is judgment and accuracy.',
    pay: 'Wide spread. Proof of published work moves you up the band faster than the degree label.',
  },
  {
    role: 'Research associate, market research, NGO and CSR programmes',
    week: 'Surveys, field visits, report writing, spreadsheets, donor or client updates.',
    pay: 'Often modest at the start. Data skills and clear writing separate the well-paid from the stuck.',
  },
  {
    role: 'Customer success, sales and operations',
    week: 'Calls, follow-ups, resolving problems, reporting. The boring 80% is repetition, so people skills and speed matter.',
    pay: 'Base pay is usually low but incentives can lift it. Good performers move to team lead roles.',
  },
];

const studyCards = [
  {
    label: 'MA',
    title: 'Worth it when you want NET, research or a subject-specific career',
    body: 'Many central universities admit to MA through CUET PG, run by the National Testing Agency. The catch: an MA taken only to delay the job decision adds two years without adding a market-facing skill.',
    fit: 'Best for: academia, research, a subject-bound career.',
    watch: 'Watch out: two more years with no income and no new skill.',
  },
  {
    label: 'MBA',
    title: 'The institute decides almost everything, not the degree',
    body: 'CAT 2026 is on 29 November, conducted by IIM Indore, and needs a bachelor\'s degree with at least 50% marks (45% for SC/ST/PwD). There is no age limit and final-year students can apply. Registration for this cycle closed on 22 September, so the next chance is the following cycle.',
    fit: 'Best for: management and sales-leadership careers.',
    watch: 'Watch out: a low-ranked private MBA on an education loan is one of the costliest mistakes on this list.',
  },
  {
    label: 'LLB',
    title: 'Three years after any degree, with a very wide gap between colleges',
    body: 'Most three-year LLB courses accept any graduate with about 45% marks (40% for reserved categories), and there is no upper age limit. Fees swing widely: Campus Law Centre at Delhi University lists about Rs 18,030 for the whole three years, while private colleges cost far more. Practising later needs the Bar Council of India\'s AIBE. CLAT PG (6 December 2026) is a later step, needed only if you want an LLM at a National Law University.',
    fit: 'Best for: courts, corporate legal teams, compliance.',
    watch: 'Watch out: early litigation income can be very low. Check the bar-council-approved status of the college.',
  },
  {
    label: 'B.Ed',
    title: 'The route to school teaching, and the rules are changing',
    body: 'A two-year B.Ed is the standard route after a three-year BA. The National Council for Teacher Education has proposed a one-year B.Ed for four-year degree holders and postgraduates from 2026-27, but the rules were still in draft when this was checked. A four-year integrated ITEP, entered through NCET, also exists. Confirm on ncte.gov.in and with your state which one is accepted for hiring.',
    fit: 'Best for: stable, structured school teaching.',
    watch: 'Watch out: private school pay can be well below government pay for the same work.',
  },
  {
    label: 'PG diploma',
    title: 'Journalism, media and digital media through the Indian Institute of Mass Communication',
    body: 'IIMC runs postgraduate diplomas in English, Hindi and regional-language journalism, radio and TV, advertising and public relations, and digital media, across Delhi and five regional campuses. Check the current prospectus for eligibility and entrance details.',
    fit: 'Best for: newsroom, PR and media careers with a recognised brand behind you.',
    watch: 'Watch out: many private "media diplomas" have no placement proof.',
  },
];

const oddsRows = [
  {
    exam: 'UPSC Civil Services (2025 cycle)',
    numbers: '9,37,876 applied, 5,76,793 appeared, 958 recommended (result on 6 March 2026).',
    reading: 'About 1 in 1,000 applicants. The 2026 cycle was notified in February 2026 with about 933 posts reported (check the notice).',
  },
  {
    exam: 'SSC CGL 2026',
    numbers: 'Vacancies revised from 12,256 to 10,731 (24 September 2026). Applicant counts are reported at over 28 lakh, which is not an official figure. Tier 1 runs from 30 September to 30 October 2026.',
    reading: 'Central government Group B and C posts, age 18-32 for general category. Pay levels run from Level 4 (Rs 25,500-81,100) up to Level 8 for Assistant Accounts and Audit Officers. On the reported applicant count, 10,731 posts is roughly 1 seat per 260 applicants, before Tier 2.',
  },
  {
    exam: 'IBPS PO 2026',
    numbers: 'The original notice listed 6,715 posts; a revision reported in late August 2026 took it to about 7,565, and some sites still quote 7,365. Any graduation; age 20-30 for general category.',
    reading: 'Starting basic pay is Rs 48,480 a month, before allowances. Confirm the final count on ibps.in, which was not reachable when this was checked.',
  },
  {
    exam: 'CTET (teaching eligibility)',
    numbers: 'Qualifying score is 60% (90 of 150) for general category and 55% for reserved categories. The certificate is valid for life.',
    reading: 'Paper 2 (classes 6-8) needs a B.Ed or equivalent alongside your BA, though final-year B.Ed students can appear. A BA alone does not qualify you. CTET or a state TET is now needed for teaching posts, following the Supreme Court\'s 2025 ruling on TET. It makes you eligible; it does not guarantee a post.',
  },
];

const funnelRows = [
  { stage: 'Applied', count: '9,37,876', share: 'Starting point' },
  { stage: 'Appeared in prelims', count: '5,76,793', share: '61.5% of applicants' },
  { stage: 'Qualified for mains', count: '14,161', share: '2.5% of those who appeared' },
  { stage: 'Called for interview', count: '2,736', share: '19.3% of mains qualifiers' },
  { stage: 'Recommended', count: '958', share: '35.0% of interviewed' },
];

const subjectRows = [
  {
    subject: 'History, Political Science, Sociology, Public Administration',
    doors: 'UPSC and State PSC syllabus overlap, NET route, law, policy and research roles.',
    watch: 'The overlap is real, but the odds are still about 1 in 1,000. Build a job or skill in parallel.',
  },
  {
    subject: 'Economics (and BA with maths)',
    doors: 'MA Economics, CAT-style quant, data and analyst roles, banking exams.',
    watch: 'Excel, SQL and one dashboard tool turn this from a subject into a hireable skill.',
  },
  {
    subject: 'Psychology',
    doors: 'MA Psychology, HR and people analytics, counselling roles, UX research.',
    watch: 'Clinical practice needs a specific recognised training route and registration. Check the Rehabilitation Council of India rules before assuming a BA is enough.',
  },
  {
    subject: 'English, Hindi and other languages',
    doors: 'Editing, publishing, content, translation, teaching English, corporate communication.',
    watch: 'Routine writing is the part AI is eating fastest. Aim for editing, research and interview-led work.',
  },
  {
    subject: 'Geography, Journalism and Mass Communication, Social Work',
    doors: 'Media and PR (IIMC-style diplomas), NGO and development roles, GIS and planning roles, civil services.',
    watch: 'Each needs one practical layer: a portfolio, a GIS tool or field experience.',
  },
];

const gates = [
  {
    num: 'Gate 1',
    title: 'Proof of Skill',
    body: 'One finished piece a stranger can inspect: a research note, a campaign report, a cleaned-up spreadsheet with a chart, an edited article.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of Communication',
    body: 'A clear pitch of 30 seconds to 2 minutes about what you do and for whom, spoken in English and, where it helps, your regional language.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of Value',
    body: 'Validation from three people who would pay or hire: a mentor, a team lead, a client. Their feedback tells you if the skill has a market.',
  },
];

const protocolSteps = [
  {
    num: '01',
    title: 'Biology: what work energy suits you',
    body: 'Do you do better with people all day or with long quiet research? Field work, desk work, remote work? A calls-heavy job drains some people and energises others. Choose the lane whose daily routine you can actually sustain.',
  },
  {
    num: '02',
    title: 'Context: your life stage and money',
    body: 'Family income, loans, marriage pressure, city, and the age limits on exams all matter. A UPSC aspirant with no income at 22 is in a very different position from one at 30.',
  },
  {
    num: '03',
    title: 'Market: is there a painful problem you can solve',
    body: 'Businesses pay for lead generation, hiring, compliance, reports, customer retention. Ask which of these problems your BA subject plus one skill can fix.',
  },
  {
    num: '04',
    title: 'Survival: how does AI change this path',
    body: 'Routine drafting, transcription and basic research summaries are getting automated. Judgment, interviewing, verification, negotiation and relationship work are not. Prefer lanes where your value is the human part.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Going full-time into an exam with no stopping rule',
    body: 'Set a written limit on attempts and money before you start. Attempts are counted officially (UPSC general category has six), and many candidates lose their entire early twenties without one.',
  },
  {
    num: '02',
    title: 'Taking an MBA loan for a low-ranked institute',
    body: 'If your fee is well above a tenth of what your family can spend on your whole education and security, ask what the seat does that a cheaper route cannot. Check the placement median, not the highest package.',
  },
  {
    num: '03',
    title: 'Collecting certificates instead of building proof',
    body: 'Ten saved courses do not equal one finished project. Low-cost options such as SWAYAM (courses from NPTEL, IGNOU, UGC and others, including humanities; a proctored exam carries a fee) are useful if you finish something with them.',
  },
  {
    num: '04',
    title: 'Doing a second degree only to delay the decision',
    body: 'A PG course with no skill layer often returns you to the same fork two years later, poorer and older.',
  },
  {
    num: '05',
    title: 'Letting one relative\'s government job decide your plan',
    body: 'Their route may have worked in a different year, state and rank. Compare the real numbers above, not the family story.',
  },
];

const testSteps = [
  'Pick two lanes and give each a real trial: apply to a few entry-level roles for one, and sit one full past paper under exam conditions for the other. Score it honestly.',
  'Talk to one person actually doing the job or holding the seat, and ask what a normal week looks like and what they wish they had known.',
  'Build one small proof piece for the lane you lean towards and show it to two people who could hire or advise you. When you message them, keep it to one specific observation about their work, a link to your proof, and one small question.',
  'Decide with what you learned. Some people know within a few weeks; others need a couple of months of real exposure. Both are normal.',
];

const faqItems = [
  {
    q: 'What are the best career options after BA in India?',
    a: 'They fall into three lanes: start working in HR, digital marketing, content, research or customer roles; study further through MA, MBA, LLB, B.Ed or a media diploma; or prepare for exams like UPSC, SSC CGL, IBPS PO and teaching eligibility. The best lane is the one that matches your finances, risk tolerance and subject, and most people combine two.',
  },
  {
    q: 'Which government jobs can I get after BA?',
    a: 'Any graduate can apply for SSC CGL, IBPS PO and other bank exams, state-level recruitment and the UPSC Civil Services Examination (age 21-32 for general category in 2026, with six attempts). Teaching roles need a B.Ed and often CTET or a state TET. Check each notification on the official site for current age limits and vacancies.',
  },
  {
    q: 'Can I do an MBA after BA?',
    a: 'Yes. CAT needs a bachelor\'s degree with at least 50% marks (45% for SC/ST/PwD) and has no age limit. The value depends on the institute, so compare the placement median and total fee before applying, and consider a job first if you want work experience for better interview shortlists.',
  },
  {
    q: 'Is a BA degree useless for getting a job?',
    a: 'No, but it is not enough alone. Graduates are far more likely to hold salaried jobs than less-educated workers, yet graduate unemployment is well above the national rate. A visible skill, one finished project and clear communication are what separate hired BA graduates from unhired ones.',
  },
  {
    q: 'What are the highest-paying careers after BA?',
    a: 'Paths with the highest ceilings are management after a strong MBA, law in corporate or independent practice, civil services and senior roles in data-led marketing or research. These are not typical outcomes. Pay depends on the institute, the employer, proof of work and years of experience.',
  },
  {
    q: 'Can BA graduates move into data analytics or IT-related roles?',
    a: 'Yes, in analyst-type roles. Excel, SQL, a dashboard tool and a couple of public projects are enough to apply for entry-level analyst jobs. Software engineering roles usually need deeper coding proof. BA Economics and BA with maths have a head start.',
  },
  {
    q: 'Can I become a teacher after BA?',
    a: 'Yes. Complete a B.Ed (two years for a three-year degree; a one-year route is proposed in draft NCTE rules for four-year degree holders from 2026-27), then clear CTET or your state TET and apply through government or private school hiring. CTET makes you eligible but does not guarantee a post.',
  },
  {
    q: 'Is an MA compulsory after BA?',
    a: 'No. An MA is needed for UGC NET Assistant Professor eligibility, university teaching and subject research. For corporate, media, HR, analyst and government exam routes, a BA is enough. If you do an MA, choose it for a specific door, not to delay the decision.',
  },
  {
    q: 'Which is better after BA: MBA or a government exam?',
    a: 'They answer different questions. A good MBA seat raises the ceiling if the institute is strong and the fee is manageable. A government exam gives stability but the odds are low (about 1 in 600 who sat the 2025 UPSC prelims were recommended). Many people work first, then pick one with real numbers.',
  },
  {
    q: 'What should I do while waiting for BA results?',
    a: 'Use the gap for one small proof piece, an internship or a short skill course, and start preparing for the entrance exam of your chosen lane. Waiting idle costs more than it looks; a year outside work can cost lakhs in earnings.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  ogImage={socialImageUrl}
  ogImageWidth={1200}
  ogImageHeight={630}
  jsonLdExtras={[faqJsonLd]}
>
  <figure class="article-cover-visual"><img src={heroImageUrl} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" alt="Indian graduate comparing three career directions at a home study desk with a laptop and notebook" title={title} /><figcaption>A practical way to compare BA career options: work now, study more or prepare for an exam.</figcaption></figure>
  <p class="lead-para">
    <strong>BA career options in India come down to three lanes: start working now, study one more degree, or sit a competitive exam.</strong>
    Your subject matters less than your money, your risk tolerance and one visible skill on top of the degree. That skill is what builds a high-value skill portfolio and opens higher-income opportunities sooner.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Career options after BA are work, study or exams. Most people do best by combining two: a job or skill plus one exam or course.</li>
      <li>The exam lane has the biggest headline and the worst odds: about 1 in 1,000 applicants were recommended in the 2025 UPSC cycle.</li>
      <li>Pick the lane you can afford to wait in, then build one piece of proof now. That proof is your first step towards earning more, earlier.</li>
    </ul>
  </div>

  <p>
    "What can I do after BA?" is one of the most common questions from arts graduates, and it usually comes wrapped in worry: <em>Is my degree weak? Do I have to do UPSC? Is an MA compulsory?</em> None of that has to decide your path. The honest answer is a comparison of what each lane costs you in years and rupees.
  </p>

  <p>
    Still choosing a stream after class 12? Read <a href="/blog/career-options/career-options-in-arts/">career options in arts</a>. Already holding a master's? Try <a href="/blog/career-options/career-options-after-ma-in-india/">career options after MA</a>. Already set on a course and want the pay-versus-cost ranking? See <a href="/blog/college-degrees/best-courses-after-ba-for-good-salary-india/">best courses after BA for good salary</a>. If you have a BA in hand and no plan yet, start by choosing your lane.
  </p>

  <p>
    If the lane decision feels stuck because of money, family pressure or too many options, <a href="/services/career-counselling-and-career-guidance/">continuous career guidance</a> can help you build a high-value skill portfolio and a plan aimed at higher-income opportunities and earlier financial freedom, fitted to your actual situation.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <figure class="article-visual"><img src="/images/blog/career-options/ba-career-options/ba-career-options-at-a-glance-summary.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="Summary card comparing the three BA career lanes: work now, study more or sit a competitive exam" title="At a glance: BA career options in India" /><figcaption>BA career options fall into three lanes: work now, study more or sit an exam.</figcaption></figure>

  <h2 id="lanes">The 3 lanes after a BA</h2>
  <figure class="article-visual"><img src="/images/blog/career-options/ba-career-options/ba-career-options-comparison-lanes-after.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="Comparison table showing what work, further study and competitive exams ask for and what each lane costs" title="The 3 lanes after a BA" /><figcaption>A list of 15 jobs hides the real decision: compare the lane, cost, first income and catch.</figcaption></figure>

  <p>
    A list of 15 jobs hides the real decision. Three structural choices sit under every list, and each asks something different from you. They are ordered by growth headroom, not by prestige: working with a skill layer can compound into consulting or freelance income, a second degree raises the ceiling only if the institute is strong, and exams cap out at fixed pay bands even when you win.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Lane</th>
          <th>What it asks of you</th>
          <th>First income</th>
          <th>The catch</th>
        </tr>
      </thead>
      <tbody>
        {laneTable.map((row) => (
          <tr>
            <td data-label="Lane"><strong>{row.lane}</strong></td>
            <td data-label="What it asks of you">{row.asks}</td>
            <td data-label="First income">{row.firstIncome}</td>
            <td data-label="The catch">{row.catch}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">The usual bad advice</p>
    <ul class="callout__list">
      <li>Do an MA, it keeps everything open.</li>
      <li>Prepare for UPSC, nothing else is respectable.</li>
      <li>Any MBA will fix your salary.</li>
      <li>Arts has no scope, switch fields.</li>
    </ul>
    <p class="callout__footer">
      Each of these ignores fees, odds and the years you lose.
    </p>
  </div>

  <h2 id="numbers">What the job numbers say about graduates</h2>
  <figure class="article-visual"><img src="/images/blog/career-options/ba-career-options/ba-career-options-stat-job-numbers-say-about.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="Stat panel showing youth, urban and graduate unemployment figures plus the share of graduate workers in salaried jobs" title="What the job numbers say about graduates" /><figcaption>Before choosing, know the ground you are standing on.</figcaption></figure>

  <p>
    Before choosing, know the ground you are standing on. The numbers are mixed, and honest.
  </p>

  <div class="work-style-grid">
    {numberCards.map((item, i) => (
      <div class={`work-style-card work-style-card--${(i % 3) + 1}`}>
        <div class="work-style-card__label">{item.label}</div>
        <div class="work-style-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    Sources: the government's <a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2246009&lang=1&reg=3" target="_blank" rel="noopener noreferrer">PLFS annual report for 2025</a>, <a href="https://www.dataforindia.com/graduate-employment/" target="_blank" rel="noopener noreferrer">Data for India's graduate employment analysis</a> and the India Skills Report 2026 as summarised by <a href="https://youthincmag.com/best-degrees-for-jobs-in-2026-what-the-india-skills-report-shows/amp" target="_blank" rel="noopener noreferrer">YouthInc</a>. Definitions differ between sources, so treat the figures as direction, not precision.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      The degree label is rarely why a BA graduate stays unemployed. The market cannot see what you can do. A graduate with a finished project, a clear pitch and one tool skill usually beats a graduate with a better mark sheet and nothing to show.
    </p>
  </div>

  <h2 id="work-now">Lane 1: start working now</h2>

  <p>
    This lane pays soonest and lets you learn on someone else's budget. It works best when you treat the first job as paid training with a plan, not as a place to sit.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Entry role</th>
          <th>What the week looks like</th>
          <th>Pay reality</th>
        </tr>
      </thead>
      <tbody>
        {roleRows.map((row) => (
          <tr>
            <td data-label="Entry role"><strong>{row.role}</strong></td>
