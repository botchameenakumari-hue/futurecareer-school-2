  .jump-nav__list a:hover { color: #e5b84a !important; }
  @media (max-width: 520px) {
    .jump-nav__list { columns: 1; }
  }

  /* ── Callout box ── */
  .callout {
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    margin: 1.4rem 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .callout--amber {
    background: rgba(229, 184, 74, 0.05);
    border-color: rgba(229, 184, 74, 0.2);
  }
  .callout__eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #e5b84a;
    font-weight: 700;
    margin: 0 0 0.6rem !important;
  }
  .callout__list {
    margin: 0 0 0.8rem 1.2rem !important;
  }
  .callout__list li {
    font-size: 14.5px !important;
    color: rgba(255, 255, 255, 0.68) !important;
    margin: 0.32rem 0 !important;
  }
  .callout__footer {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.48);
    font-style: italic;
    margin: 0 !important;
  }

  /* ── Rich numbered list ── */
  .rich-list {
    list-style: none;
    padding: 0 !important;
    margin: 1.2rem 0 !important;
    counter-reset: rl;
  }
  .rich-list li {
    counter-increment: rl;
    position: relative;
    padding: 1rem 1.2rem 1rem 3.4rem;
    margin: 0.55rem 0 !important;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    font-size: 15px !important;
    color: rgba(255, 255, 255, 0.7) !important;
  }
  .rich-list li::before {
    content: counter(rl);
    position: absolute;
    left: 0.9rem;
    top: 1rem;
    width: 22px;
    height: 22px;
    background: #e5b84a;
    color: #0a0f1e;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Track cards ── */
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.6rem 0;
  }
  .track-card {
    border-radius: 14px;
    padding: 1.35rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .track-card--exam  { border-color: rgba(229, 184, 74, 0.28); background: rgba(229, 184, 74, 0.05); }
  .track-card--degree{ border-color: rgba(100, 140, 255, 0.22); background: rgba(100, 140, 255, 0.04); }
  .track-card--skill { border-color: rgba(45, 212, 191, 0.28); background: rgba(45, 212, 191, 0.05); }
  .track-card__badge {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 700;
  }
  .track-card__name {
    font-size: 1.05rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.25;
  }
  .track-card__paths {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.42);
  }
  .track-card__body {
    font-size: 13.5px !important;
    line-height: 1.7 !important;
    color: rgba(255, 255, 255, 0.6) !important;
    margin: 0.1rem 0 0 !important;
  }
  .track-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }
  .tag {
    font-size: 11px;
    padding: 0.26rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.04);
  }
  .tag--good    { border-color: rgba(45, 212, 191, 0.3); color: #2dd4bf; background: rgba(45, 212, 191, 0.08); }
  .tag--caution { border-color: rgba(229, 184, 74, 0.3); color: #e5b84a; background: rgba(229, 184, 74, 0.08); }
  @media (max-width: 700px) {
    .tracks-grid { grid-template-columns: 1fr; }
  }

  /* ── Honest take box ── */
  .honest-take {
    border-left: 3px solid #e5b84a;
    padding: 1rem 1.25rem;
    background: rgba(229, 184, 74, 0.05);
    border-radius: 0 10px 10px 0;
    margin: 1.2rem 0;
  }
  .honest-take__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #e5b84a;
    font-weight: 700;
    margin: 0 0 0.5rem !important;
  }
  .honest-take p {
    font-size: 14.5px !important;
    color: rgba(255, 255, 255, 0.65) !important;
    margin: 0.45rem 0 !important;
    line-height: 1.78 !important;
  }

  /* ── Two-col facts ── */
  .two-col-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.2rem 0;
  }
  .fact-col {
    border-radius: 12px;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .fact-col--yes { border-color: rgba(45, 212, 191, 0.2); background: rgba(45, 212, 191, 0.04); }
  .fact-col--no  { border-color: rgba(255, 80, 70, 0.15); background: rgba(255, 80, 70, 0.04); }
  .fact-col__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 0.7rem;
  }
  .fact-col--yes .fact-col__label { color: #2dd4bf; }
  .fact-col--no  .fact-col__label { color: rgba(255, 100, 90, 0.85); }
  .fact-col ul { margin: 0 0 0 1rem !important; padding: 0 !important; }
  .fact-col li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.62) !important;
    margin: 0.32rem 0 !important;
    line-height: 1.55 !important;
  }
  @media (max-width: 580px) {
    .two-col-facts { grid-template-columns: 1fr; }
  }

  /* ── Decision grid ── */
  .decision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.2rem 0;
  }
  .decision-card {
    padding: 1.15rem 1.2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .decision-card--yes { border-color: rgba(45, 212, 191, 0.22); background: rgba(45, 212, 191, 0.04); }
  .decision-card--no  { border-color: rgba(255, 80, 70, 0.15);  background: rgba(255, 80, 70, 0.04); }
  .decision-card__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
  }
  .decision-card--yes .decision-card__label { color: #2dd4bf; }
  .decision-card--no  .decision-card__label { color: rgba(255, 100, 90, 0.85); }
  .decision-card ul { margin: 0 0 0 1rem !important; padding: 0 !important; }
  .decision-card li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.62) !important;
    margin: 0.32rem 0 !important;
    line-height: 1.55 !important;
  }
  @media (max-width: 580px) {
    .decision-grid { grid-template-columns: 1fr; }
  }

  /* ── Highlight box ── */
  .highlight-box {
    border: 1px solid rgba(229, 184, 74, 0.2);
    background: rgba(229, 184, 74, 0.05);
    border-radius: 12px;
    padding: 1.2rem 1.4rem;
    margin: 1.5rem 0;
  }
  .highlight-box p {
    font-size: 15px !important;
    color: rgba(255, 255, 255, 0.72) !important;
    margin: 0.35rem 0 !important;
    line-height: 1.82 !important;
  }
  .highlight-box--teal {
    border-color: rgba(45, 212, 191, 0.22);
    background: rgba(45, 212, 191, 0.04);
  }
  .highlight-box--amber {
    border-color: rgba(229, 184, 74, 0.22);
    background: rgba(229, 184, 74, 0.05);
  }

  /* ── Paths table ── */
  .table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0 0.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    -webkit-overflow-scrolling: touch;
  }
  .paths-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
    font-size: 13.5px;
  }
  .paths-table th {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.45);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.8rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    white-space: nowrap;
  }
  .paths-table td {
    padding: 0.78rem 1rem;
    color: rgba(255, 255, 255, 0.65);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: top;
    line-height: 1.52;
  }
  .paths-table tr:last-child td { border-bottom: none; }
  .paths-table tr:hover td { background: rgba(255, 255, 255, 0.025); }
  .paths-table strong { color: rgba(255, 255, 255, 0.9); }
  .risk { font-weight: 600; font-size: 12.5px; }
  .risk--low    { color: #2dd4bf; }
  .risk--medium { color: #e5b84a; }
  .risk--high   { color: rgba(255, 95, 80, 0.9); }
  .risk--none   { color: rgba(255, 255, 255, 0.35); font-style: italic; font-weight: 400; }

  /* ── 4-Checkpoint Protocol ── */
  .protocol-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.6rem 0;
  }
  .checkpoint {
    display: flex;
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.4rem 1.3rem;
    align-items: flex-start;
  }
  .checkpoint__num {
    font-size: 2.1rem;
    font-weight: 900;
    color: rgba(229, 184, 74, 0.22);
    line-height: 1;
    flex-shrink: 0;
    width: 52px;
    text-align: right;
    letter-spacing: -0.06em;
    padding-top: 0.1rem;
  }
  .checkpoint__title {
    font-size: 1.06rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 0.3rem;
  }
  .checkpoint__body > p {
    font-size: 14px !important;
    color: rgba(255, 255, 255, 0.58) !important;
    margin: 0.35rem 0 0.55rem !important;
    line-height: 1.7 !important;
  }
  .checkpoint__body ul {
    margin: 0.3rem 0 0.7rem 1.1rem !important;
  }
  .checkpoint__body li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.6) !important;
    margin: 0.3rem 0 !important;
    line-height: 1.6 !important;
  }
  .checkpoint__note {
    background: rgba(255, 255, 255, 0.04);
    border-left: 2px solid rgba(229, 184, 74, 0.35);
    padding: 0.55rem 0.9rem;
    border-radius: 0 8px 8px 0;
    font-size: 13px !important;
    color: rgba(255, 255, 255, 0.48) !important;
    font-style: italic;
    line-height: 1.65 !important;
    margin-top: 0.2rem !important;
  }
  @media (max-width: 500px) {
    .checkpoint { flex-direction: column; gap: 0.6rem; }
    .checkpoint__num { width: auto; text-align: left; font-size: 1.6rem; }
  }

  /* ── The 3 Gates ── */
  .gates-block {
    border: 1px solid rgba(45, 212, 191, 0.22);
    background: rgba(45, 212, 191, 0.04);
    border-radius: 14px;
    padding: 1.4rem 1.3rem;
    margin: 1.6rem 0;
  }
  .gates-block__title {
    font-size: 13.5px;
    color: #2dd4bf;
    font-weight: 700;
    margin: 0 0 1rem !important;
    line-height: 1.45;
  }
  .gates-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }
  .gate {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 0.95rem 1rem;
  }
  .gate__num {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(45, 212, 191, 0.7);
    margin-bottom: 0.18rem;
    font-weight: 700;
  }
  .gate__name {
    display: block;
    font-size: 0.94rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 0.4rem;
  }
  .gate p {
    font-size: 13px !important;
    color: rgba(255, 255, 255, 0.54) !important;
    margin: 0 !important;
    line-height: 1.6 !important;
  }
  @media (max-width: 580px) {
    .gates-row { grid-template-columns: 1fr; }
  }

  /* ── Skill levels ── */
  .skill-levels {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.4rem 0;
  }
  .skill-level {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .skill-level__header {
    padding: 0.7rem 1.2rem;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .skill-level__header--l1 { background: rgba(255, 255, 255, 0.04); color: rgba(255, 255, 255, 0.5); }
  .skill-level__header--l2 { background: rgba(229, 184, 74, 0.07);  color: #e5b84a; }
  .skill-level__header--l3 { background: rgba(45, 212, 191, 0.07);  color: #2dd4bf; }
  .skill-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0.6rem 1.2rem !important;
  }
  .skill-list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.42rem 0 !important;
    margin: 0 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 14px !important;
    color: rgba(255, 255, 255, 0.66) !important;
    line-height: 1.62 !important;
  }
  .skill-list li:last-child { border-bottom: none; }
  .skill-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-top: 0.44rem;
  }
  .skill-dot--white { background: rgba(255, 255, 255, 0.28); }
  .skill-dot--gold  { background: #e5b84a; }
  .skill-dot--teal  { background: #2dd4bf; }

  /* ── College grid ── */
  .college-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.2rem 0;
  }
  .college-card {
    border-radius: 12px;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .college-card--go    { border-color: rgba(45, 212, 191, 0.22); background: rgba(45, 212, 191, 0.04); }
  .college-card--pause { border-color: rgba(229, 184, 74, 0.22); background: rgba(229, 184, 74, 0.04); }
  .college-card h4 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.7rem !important;
  }
  .college-card--go h4    { color: #2dd4bf; }
  .college-card--pause h4 { color: #e5b84a; }
  .college-card ul { margin: 0 0 0 1rem !important; padding: 0 !important; }
  .college-card li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.62) !important;
    margin: 0.32rem 0 !important;
    line-height: 1.55 !important;
  }
  @media (max-width: 580px) {
    .college-grid { grid-template-columns: 1fr; }
  }

  /* ── FAQ ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 1.2rem 0;
  }
  .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .faq-item__q {
    display: block;
    padding: 0.95rem 1.2rem;
    font-size: 15px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    line-height: 1.4;
  }
  .faq-item__a {
    display: block;
    padding: 0.95rem 1.2rem;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.78;
  }

  /* ── Marks grid ── */
  .marks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.3rem 0;
  }
  .marks-card {
    border-radius: 12px;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .marks-card--matters { border-color: rgba(45, 212, 191, 0.22); background: rgba(45, 212, 191, 0.04); }
  .marks-card--does-not { border-color: rgba(229, 184, 74, 0.22); background: rgba(229, 184, 74, 0.04); }
  .marks-card__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
  }
  .marks-card--matters .marks-card__label { color: #2dd4bf; }
  .marks-card--does-not .marks-card__label { color: #e5b84a; }
  .marks-card ul { margin: 0 0 0 1rem !important; padding: 0 !important; }
  .marks-card li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.62) !important;
    margin: 0.38rem 0 !important;
    line-height: 1.58 !important;
  }
  @media (max-width: 620px) {
    .marks-grid { grid-template-columns: 1fr; }
  }

  /* ── Salary table note ── */
  .table-note {
    font-size: 12.5px !important;
    color: rgba(255, 255, 255, 0.35) !important;
    font-style: italic;
    margin: 0.5rem 0 1.5rem !important;
    line-height: 1.6 !important;
  }
  .salary-table td:nth-child(2),
  .salary-table td:nth-child(3) {
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
    font-size: 13px;
  }

  /* ── Steps stack (no-idea section) ── */
  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 1.4rem 0;
  }
  .step-item {
    display: flex;
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 1.25rem 1.3rem;
    align-items: flex-start;
  }
  .step-item__num {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e5b84a;
    flex-shrink: 0;
    width: 62px;
    padding-top: 0.12rem;
    line-height: 1.3;
  }
  .step-item__title {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }
  .step-item__body > p {
    font-size: 14px !important;
    color: rgba(255, 255, 255, 0.6) !important;
    margin: 0 !important;
    line-height: 1.72 !important;
  }
  @media (max-width: 500px) {
    .step-item { flex-direction: column; gap: 0.4rem; }
    .step-item__num { width: auto; }
  }

  /* ── Proof of work grid ── */
  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.4rem 0;
  }
  .proof-card {
    border-radius: 12px;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .proof-card__track {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #e5b84a;
    margin-bottom: 0.65rem;
  }
  .proof-card ul { margin: 0 0 0 1rem !important; padding: 0 !important; }
  .proof-card li {
    font-size: 13.5px !important;
    color: rgba(255, 255, 255, 0.62) !important;
    margin: 0.38rem 0 !important;
    line-height: 1.58 !important;
  }
  @media (max-width: 660px) {
    .proof-grid { grid-template-columns: 1fr; }
  }

  /* ── Hybrid stack (commerce + tech) ── */
  .hybrid-stack {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 1.4rem 0;
  }
  .hybrid-card {
    border-radius: 12px;
    padding: 1.2rem 1.3rem;
    border: 1px solid rgba(45, 212, 191, 0.15);
    background: rgba(45, 212, 191, 0.03);
  }
  .hybrid-card__combo {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 0.18rem;
  }
  .hybrid-card__why {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2dd4bf;
    font-weight: 700;
    margin-bottom: 0.55rem;
  }
  .hybrid-card > p {
