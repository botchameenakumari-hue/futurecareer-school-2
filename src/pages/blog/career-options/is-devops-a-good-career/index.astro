const oncallComparison = {
  gold: [
    'Roughly 7 in 10 DevOps and SRE roles in India carry some form of on-call rotation, which means a production alert can reach you outside working hours, on a weekend, or during a family event.',
    'A live incident is a genuinely different kind of pressure than a missed deadline — it is time-boxed, often visible to leadership in real time, and can carry blame dynamics that other engineering work does not.',
    'The tool surface is wide by design — Linux, networking, one or two clouds, Docker, Kubernetes, Terraform, CI/CD, observability — which creates a real risk of staying shallow across many tools instead of building depth in one.',
  ],
  teal: [
    'On-call load is a team and maturity signal, not a fixed feature of the job — teams with mature incident response, good runbooks, and a real on-call rotation schedule spread the load fairly; teams without them burn out whoever is closest to the pager.',
    'The people who avoid burnout usually build one visible skill deep enough to reduce their own toil — automating the alert they get paged for most often is a genuine career move, not just relief.',
    'This is exactly the kind of trade-off worth asking about directly in an interview: rotation size, average pages per week, and whether the team tracks and reduces toil, before accepting an offer, not after the first bad month.',
  ],
};

const aiComparison = {
  gold: [
    'Routine log analysis and first-pass alert correlation — AI-assisted observability tools now triage a large share of the noisy, low-value alerts that used to eat a DevOps engineer\'s morning.',
    'Boilerplate script and pipeline-config generation — tools like GitHub Copilot speed up writing a Terraform module or a CI/CD YAML file from a known pattern.',
    'First-draft infrastructure documentation and incident-summary write-ups — the repetitive documentation work that historically got skipped under deadline pressure.',
  ],
  teal: [
    'Deciding whether a production alert is a real incident, a noisy false positive, or expected traffic — judgment that needs someone who understands the specific system, not a generic pattern match.',
