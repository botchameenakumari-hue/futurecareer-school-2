    tier: 'Big 4 transaction advisory / valuation (analyst level)',
    range: 'Rs 6-12 LPA',
    note: 'Lower than front-office IB pay, but this is the realistic entry point for people using Big 4 as a lateral stepping stone rather than a final destination.',
  },
