---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career in investment banking India: how to start without an IIM tag';
const description =
  'A career in investment banking India how to start guide: real entry routes, bulge bracket vs boutique pay, actual work hours, and a roadmap for people not already at a top IIM.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/career-in-investment-banking-india-how-to-start';
const publishedDateISO = '2026-07-06';
const publishedDateLabel = '6 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-the-job-is', label: 'What investment banking work actually is' },
  { id: 'entry-routes', label: 'The 4 real entry routes' },
  { id: 'route-campus', label: 'Route 1: campus placement at a target B-school' },
  { id: 'route-ca', label: 'Route 2: CA to IB lateral' },
  { id: 'route-cfa', label: 'Route 3: CFA plus modelling skill' },
  { id: 'route-big4', label: 'Route 4: Big 4 transaction advisory as a side door' },
  { id: 'bb-vs-boutique', label: 'Bulge bracket vs boutique vs domestic bank' },
  { id: 'salary-reality', label: 'What analysts actually earn, by firm tier' },
  { id: 'work-hours', label: 'The real work hours, not the recruiter version' },
  { id: 'skills', label: 'The skills you actually need before you apply' },
  { id: 'ai-impact', label: 'How AI is changing the junior analyst job' },
  { id: 'networking', label: 'Networking and cold outreach that actually works' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you commit' },
  { id: 'roadmap', label: 'A realistic roadmap if you are not at a top IIM' },
  { id: 'gates', label: 'The 3 Gates before you apply anywhere' },
  { id: 'exit-options', label: 'What comes after 2-3 years' },
  { id: 'mistakes', label: 'Mistakes that stall people on this path' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const entryRouteCards = [
  {
    badge: 'Route 1',
    title: 'Campus placement at a target B-school',
    body: 'The highest-odds, most structured door. You do an MBA or PGP at an institute that IB desks actually recruit from, then sit through summer and final placement processes built specifically for finance roles.',
    fit: 'You can clear CAT/GMAT at a competitive percentile, can fund or get aid for a 1-2 year program, and are willing to bet 2 years of opportunity cost on one shot at the front-office door.',
    caution: 'Only a small number of institutes have real bulge-bracket and top-boutique recruiting relationships. An MBA from a college with no IB recruiter footprint does not open this door just because it is an MBA.',
    tags: ['Highest success rate', '2 year program + placements'],
  },
  {
    badge: 'Route 2',
    title: 'CA to IB lateral entry',
    body: 'You qualify as a Chartered Accountant, spend 2-4 years in Big 4 audit, tax, or valuation work, then move sideways into a domestic IB, boutique, or transaction advisory team once you have deal-adjacent experience and modelling skill.',
    fit: 'You are already on the CA track or have cleared it, and you are willing to spend a few years building deal exposure before the IB label shows up on your resume.',
    caution: 'A CA alone does not get you into deal teams. You need to actively add financial modelling, valuation, and M&A exposure on top of the accounting base, and often accept an Analyst-level title even after qualifying as a CA.',
    tags: ['Slower but reliable', '2-4 years to lateral in'],
  },
  {
    badge: 'Route 3',
    title: 'CFA plus a strong modelling portfolio',
    body: 'You clear CFA Level 1 or 2 while building a portfolio of stock pitches and DCF models, then use that combination as a credibility signal at boutique or domestic firms that hire on demonstrated skill rather than college brand.',
    fit: 'You are not going the MBA or CA route, and you can commit 300+ hours a level to CFA study while building real financial models on your own time.',
    caution: 'CFA alone rarely gets anyone hired. It works only when paired with actual modelling output an interviewer can look at — treat the charter as a supporting credential, not a golden ticket.',
    tags: ['Cheapest route', 'Needs a visible portfolio'],
  },
  {
    badge: 'Route 4',
    title: 'Big 4 transaction advisory as a side door',
    body: 'You join Deloitte, EY, KPMG, or PwC in Transaction Advisory Services (financial due diligence, valuation, or deal advisory) straight after graduation or CA, build genuine deal experience, then lateral into a bank or boutique from there.',
    fit: 'You did not clear a target B-school or want deal exposure faster than the CA-then-lateral path allows, and are comfortable that the first stop is advisory work, not a bank logo.',
    caution: 'Big 4 TAS work is deal-adjacent, not deal-leading. The lateral into IB still depends on you building modelling depth and making the jump within 2-4 years before the profile ages out of "junior lateral" territory.',
    tags: ['Faster deal exposure', '2-4 years to lateral in'],
  },
];

const bbVsBoutiqueRows = [
  {
    aspect: 'Who they are',
    bb: 'Global full-service banks with India desks or coverage teams: Goldman Sachs, JPMorgan, Morgan Stanley, Bank of America, Deutsche Bank, HSBC.',
    boutique: 'India-focused advisory specialists: Avendus Capital, Spark Capital, o3 Capital, Ambit, Centrum, JM Financial, Kotak Investment Banking.',
  },
  {
    aspect: 'What they do',
    bb: 'Full range: M&A advisory, equity and debt capital markets, trading, research, asset management, often for large multinational or cross-border deals.',
    boutique: 'Mostly M&A and capital-raising advisory, frequently concentrated in one or two sectors (technology, healthcare, consumer, financial services) where the firm has deep relationships.',
  },
  {
    aspect: 'Deal size and client base',
    bb: 'Large caps, multinational clients, cross-border and marquee transactions.',
    boutique: 'Mid-market and growth-stage Indian companies, family-owned businesses, and sector-specific clients that want a specialist over a generalist.',
  },
  {
    aspect: 'What the analyst experience feels like',
    bb: 'More structured training program, bigger deal teams, more layers between you and the client, stronger global brand for your resume.',
    boutique: 'Leaner teams mean more direct responsibility per analyst earlier, closer contact with senior bankers and clients, less formal training infrastructure.',
  },
  {
    aspect: 'Where pay lands',
    bb: 'Highest headline compensation, especially once bonus is included, but starts on a global pay scale that India offices only partly match.',
    boutique: 'Can match or occasionally exceed bulge-bracket base pay at senior levels because of leaner staffing, though junior boutique pay generally sits below BB India offices.',
  },
];

const salaryRows = [
  {
    tier: 'Bulge bracket (Goldman Sachs, JPMorgan, Morgan Stanley India offices)',
    range: 'Rs 18-22 LPA base + Rs 5-15 LPA bonus (Rs 25-35 LPA total)',
    note: 'Bonus typically runs about 20% of total comp at analyst level, rising sharply at VP and above. Mumbai offices sit at the higher end of this range.',
