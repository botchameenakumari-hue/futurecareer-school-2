const description = "Career options after B.Arch in India: practice, design, planning, construction and technology roles, registration to verify, skills, a free-first plan and honest limits.";
const seoDescription = "A portfolio and site understanding matter more than the degree alone.";
const canonical = "https://futurecareerschool.com/blog/career-options/career-options-after-b-arch-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What can I do after B.Arch?",
    "Practice, interior design, planning, construction management and design technology."
  ],
  [
    "Is registration required for practice?",
    "Rules apply. Verify on the official page."
  ],
  [
    "Do I need a master degree?",
    "Needed for some paths like planning. Verify."
  ],
  [
    "How important is the portfolio?",
    "Very important for firms."
  ],
  [
    "Can I move into construction?",
    "Yes, with site experience."
  ],
  [
    "Which software should I learn?",
    "Read notices and learn the most asked."
  ],
  [
    "Is it a good career?",
    "It suits people who enjoy design and site work. Check local demand."
  ],
  [
    "Will AI change architecture jobs?",
    "Routine visualisation shrinks. Design judgment remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
