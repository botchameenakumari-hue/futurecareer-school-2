const mistakeItems = [
  {
    num: '01',
    title: 'Treating "NGO job or UPSC" as the only two options',
    body: 'Families and even career counsellors default to this pair because those are the only two paths anyone talks about. Corporate government-affairs-style CSR leadership, BFSI research, and independent policy consulting quietly outpay both of them once you build real proof.',
