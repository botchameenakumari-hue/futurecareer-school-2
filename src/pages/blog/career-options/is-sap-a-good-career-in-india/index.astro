const jumpLinks = [
  { id: "short-answer", label: "The short answer" },
  { id: "tracks", label: "Eight SAP tracks, ordered by growth room" },
  { id: "s4-shift", label: "The 2027 deadline and the cloud shift" },
  { id: "who-hires", label: "Who hires, and what they test" },
  { id: "fresher", label: "The fresher reality, by background" },
  { id: "certificates", label: "Official credential or institute certificate" },
  { id: "pay", label: "Pay, with sources and dates" },
