const shiftRows = [
  { item: "Mainstream maintenance for SAP ERP 6.0 (ECC)", fact: "Runs to the end of 2027. From 17 October 2026 that is about 14 months after this guide was published.", src: "SAP support strategy page" },
  { item: "Extended maintenance", fact: "Optional, from 2028 to the end of 2030, with a premium of two percentage points on the maintenance base.", src: "SAP support strategy page" },
  { item: "Cloud transition option for very large customers", fact: "Announced January 2025 for 2031 to the end of 2033. SAP's CEO said it is not an extension of on-premises maintenance.", src: "The Register, 12 February 2025" },
  { item: "S/4HANA", fact: "SAP promised that at least one S/4HANA release stays in maintenance until 2040.", src: "SAP support strategy page (commitment of 4 February 2020)" },
  { item: "Customers not yet moved", fact: "61% of ECC customers had neither migrated nor bought S/4 licences, per a 2025 Gartner survey as cited. Gartner also expects about 40% to still run ECC in key areas in 2030.", src: "IntelligentCIO, 26 February 2026; The Register, 12 February 2025" },
];

const hirerRows = [
  { who: "Large IT services and consulting firms", test: "Module or language basics, a clear spoken explanation of one process, willingness to start in support or testing.", pay: "Often the first door for freshers; the first role is commonly support, testing or a junior build task. No official hiring count is published.", note: "Names seen in current listings include TCS, Capgemini, Deloitte and DXC." },
  { who: "Boutique SAP partners", test: "Depth in one module or product and project stories you can explain.", pay: "Smaller teams, wider responsibility sooner. Fewer fresher seats.", note: "Best place to learn a full cycle quickly, if you can get in." },
  { who: "In-house SAP teams and global captive centres", test: "Business knowledge of the company's own process plus system skill.", pay: "In our reading these teams lean toward experienced people; it is also the route for finance or plant staff who become their team's SAP point person.", note: "Manufacturers, pharma, banks and global captive centres run large SAP landscapes." },
  { who: "SAP Labs India", test: "Software engineering, not module configuration.", pay: "Developer roles for product building.", note: "SAP says more than 17,000 of its people work in India and the new Bengaluru campus, opened 5 August 2025, is designed for over 15,000." },
