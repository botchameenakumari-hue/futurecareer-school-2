const freelanceRows = [
  { gate: "Client system access", why: "SAP runs inside the client's own landscape. You work with the access the client grants, so you cannot practise on a live company system or show real client screens.", move: "Build a sanitised case note from a practice system. Keep client data out of every sample." },
  { gate: "Licences and product rules", why: "SAP software is licensed to the company that uses it. A solo consultant does not own the system they work on. Check the current terms for consultant access with the client's SAP contact before you promise anything.", move: "Position as a skill provider on the client's system, not as someone who supplies the system." },
  { gate: "Depth before independence", why: "Clients hire independents for one thing: they have done this exact job before. That usually means several full project cycles in one module.", move: "Do the employed cycles first. Go independent after you have two or three go-lives to point to." },
