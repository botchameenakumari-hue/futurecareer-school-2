const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What are ESG careers?",
    "Roles that measure, report and improve environmental and social effects of organisations."
  ],
  [
    "Is this a good career in India?",
    "It can be, but openings vary by sector. Read notices and verify current rules."
  ],
  [
    "Which skills help?",
    "Spreadsheets, report writing, regulation reading and energy basics."
  ],
  [
    "Do I need a science degree?",
    "Not always. Different roles need different backgrounds."
  ],
  [
    "How do freshers start?",
    "Do a small energy or waste review with real numbers."
  ],
  [
    "Are certifications necessary?",
    "Not always. Check notices before paying."
  ],
  [
    "What is greenwashing?",
    "Making environmental claims without evidence. Avoid it."
  ],
  [
    "Will AI replace ESG analysts?",
    "AI drafts. Verification and accountability remain human."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
