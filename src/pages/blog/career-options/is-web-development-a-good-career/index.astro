---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Is Web Development a Good Career in 2026? Pay, AI Risk, Verdict';
const description =
  'Is web development a good career with AI writing code now? Real India salary data by stack and experience, which web-dev roles AI is actually replacing, and an honest verdict.';
const canonical = 'https://futurecareerschool.com/blog/career-options/is-web-development-a-good-career';
const publishedDateISO = '2026-08-16';
const publishedDateLabel = '16 August 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'stack-reality', label: 'Frontend vs backend vs full-stack' },
  { id: 'salary-data', label: 'Real pay by stack and experience' },
  { id: 'ai-risk', label: 'What AI is actually replacing here' },
  { id: 'growth-scaling', label: 'How senior developers keep scaling' },
  { id: 'who-fits', label: 'Who this path genuinely fits' },
  { id: 'who-pause', label: 'Who should think twice' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'verdict', label: 'The verdict framework' },
  { id: 'alternatives', label: 'When a nearby path fits better' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const stackComparison = {
  gold: [
    'Frontend development (React, Vue, or similar) builds what users actually see and click — layout, interactivity, performance in the browser. It rewards people who care about how something looks and feels to use, not just whether it technically works.',
    'Backend development builds what users never see — servers, databases, APIs, business logic. It rewards people who enjoy systems thinking, data structure, and reliability under load more than visual polish.',
    'Full-stack developers work across both, trading some depth in either for broader project ownership — genuinely useful at smaller companies and startups, less differentiated at large product companies with dedicated specialist teams.',
  ],
  teal: [
    '"Is web development a good career" gets asked as if it is one job, but a frontend specialist, a backend specialist, and a full-stack generalist have different daily work, different AI exposure, and different pay ceilings — the honest answer depends on which lane you actually mean.',
    'Picking a lane deliberately, rather than drifting into "full-stack" by default because it sounds safer, changes how fast you build real depth and how differentiated your skill set looks to employers three years in.',
  ],
};

const salaryRows = [
  {
    stage: 'Fresher web developer, 0-1 years',
    range: 'Rs 3.5-6 LPA',
    reality: 'Service companies and smaller product startups sit at the lower end; a genuinely strong portfolio of shipped projects can push a fresher toward the upper end even without prior work experience.',
  },
  {
    stage: 'Mid-level developer, 2-4 years',
    range: 'Rs 7-14 LPA',
    reality: 'The widest band in the field — driven far more by depth in a specific stack and system-design ability than by years alone at this stage.',
  },
  {
    stage: 'Senior developer, 5-8 years',
    range: 'Rs 16-30 LPA',
    reality: 'Requires genuine ownership of architecture decisions, not just feature delivery — the jump from mid-level to senior is a skill jump, not a tenure milestone.',
  },
  {
    stage: 'Staff/lead engineer or engineering manager, 8+ years',
    range: 'Rs 30-55 LPA and above',
    reality: 'Concentrated at product companies, well-funded startups, and global capability centres — this tier requires either deep technical leadership or people-management ability layered on top of engineering skill.',
  },
  {
    stage: 'Freelance/contract web development, project-based',
    range: 'Rs 500-3,000+ per hour depending on stack, client geography, and specialisation',
    reality: 'A genuinely scalable income lane for developers with a track record and a specific in-demand skill, but income is inconsistent without deliberate client-pipeline building, unlike a salaried role.',
  },
];

const aiComparison = {
  gold: [
    'AI coding assistants now write a substantial share of routine boilerplate — CRUD forms, basic component scaffolding, common API integration patterns, straightforward styling — genuinely faster than a human typing it manually.',
    'Junior-level tasks that are narrow, well-specified, and pattern-matched from thousands of existing examples online are exactly what current AI coding tools handle best, which is shrinking the market for developers who only do that kind of work.',
    'Entry-level hiring at some companies has become more selective specifically because AI tools now cover a meaningful slice of what juniors used to be hired to do.',
  ],
  teal: [
    'System design, architecture trade-offs, debugging genuinely novel production issues, and translating ambiguous business requirements into a working technical plan remain squarely human work — AI tools assist here but do not replace the judgment involved.',
    'Someone still has to review, test, integrate, and take responsibility for AI-generated code in a real production system — that verification and integration role is growing, not shrinking, as more code gets AI-assisted.',
    'Overall demand for web development skill is not collapsing — it is bifurcating. Developers who only produce boilerplate face real pressure; developers who can architect, debug, and direct AI tools as a force-multiplier are becoming more valuable, not less.',
  ],
};

const growthCards = [
  {
    title: 'Move from feature-building to system design and architecture ownership',
    body: 'The clearest path from mid-level to senior pay is owning how a system is structured, not just shipping assigned features faster — this is also the layer of the job current AI tools cannot meaningfully replace.',
  },
  {
    title: 'Specialise in a genuinely scarce layer: performance, security, or infrastructure',
    body: 'Generalist full-stack developers are common; developers who can genuinely own web performance optimisation, application security, or DevOps/infrastructure are scarcer and command a real premium.',
  },
  {
    title: 'Build a public portfolio of real, working products, not just tutorials completed',
    body: 'A small number of genuinely shipped, real-world projects — even side projects with actual users — differentiates a developer far more than a long list of completed courses in a crowded junior market.',
  },
  {
    title: 'Learn to direct AI coding tools as a force-multiplier, not a threat to route around',
    body: 'Developers who can prompt, review, and integrate AI-generated code efficiently are shipping more, faster, and are more valuable to employers than those either ignoring AI tools entirely or blindly trusting their output.',
  },
  {
    title: 'Move toward freelance or contract work once you have a genuine specialisation and track record',
    body: 'Contract and freelance web development income scales with reputation and specificity, not tenure — a real path to high income opportunities for developers with a proven, narrow skill and a client pipeline.',
  },
];

const whoFitsItems = [
  {
    label: 'Genuine fit',
    title: 'You enjoy building things that are visibly used, and iterating when they break',
    body: 'Web development is fundamentally a build-test-fix-repeat discipline. If watching something you built actually work for real users is satisfying, and debugging does not drain you, that is a real signal.',
  },
  {
    label: 'Genuine fit',
    title: 'You are willing to keep learning continuously, because the tools genuinely do change fast',
    body: 'Frameworks, tooling, and now AI-assisted workflows shift meaningfully every few years in web development. This rewards people who treat continuous learning as normal, not an occasional burden.',
  },
  {
    label: 'Genuine fit',
    title: 'You want a path with multiple real entry routes: degree, bootcamp, or self-taught',
    body: 'Unlike many careers, web development has a genuinely functional self-taught and portfolio-based entry route alongside the formal degree route — useful if a traditional CS degree is not your situation.',
  },
];

const whoPauseRows = [
  {
    signal: 'You are entering web development assuming junior roles are as plentiful as they were five years ago',
    reality: 'AI coding tools have genuinely reduced demand for developers who only do narrow, boilerplate junior work. Entry now rewards a real portfolio and some depth, not just course completion certificates.',
  },
  {
    signal: 'You dislike continuous learning and want a stack you master once and use unchanged for a decade',
    reality: 'Web development tooling and best practices shift meaningfully every few years. A developer uncomfortable with ongoing relearning will feel a real, recurring friction in this field specifically.',
  },
  {
    signal: 'You are choosing "full-stack" by default because it sounds safer than picking a lane',
    reality: 'Genuine full-stack depth takes longer to build than surface-level full-stack familiarity. A shallow full-stack profile competes for less differentiated roles than a genuinely deep frontend or backend specialist.',
  },
  {
    signal: 'You are treating AI-panic headlines as a reason to avoid the field entirely',
    reality: 'The realistic picture is bifurcation, not collapse — routine boilerplate work is genuinely shrinking, while system design, debugging, and AI-tool direction are growing in value. The field is not disappearing; the floor for what counts as valuable work is rising.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Can you sit through long, focused debugging sessions without burning out, and stay comfortable with the field asking you to keep relearning tools every couple of years?',
    note: 'Web development rewards sustained focus and comfort with continuous, low-drama change more than raw intensity in short bursts.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Can your situation support a self-taught or bootcamp entry route if a formal CS degree is not available to you, including the real time investment building a portfolio takes before you are hireable?',
    note: 'Web development is one of the more genuinely accessible tech careers for non-traditional entry, but "accessible" still means real, sustained months of building, not a weekend.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Are you aiming at a specific, differentiated lane — frontend performance, backend systems, a specific framework ecosystem — or a generic "I can build websites" positioning competing in the most crowded, AI-exposed part of the market?',
    note: 'The generic junior-developer market is the most AI-exposed and most crowded slice of this field. Specificity is what protects pay and job security here.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'Given that AI tools now handle a real share of boilerplate work, is your plan to build the architecture, debugging, and AI-direction skills that remain durable, or to compete purely on typing speed and tutorial-level output?',
    note: 'The narrowest, most repetitive coding tasks are the most exposed to AI tools over time — build toward system-level judgment, not routine output volume.',
  },
];

const gateItems = [
  {
    num: 'Gate 1',
    title: 'Proof of skill',
    body: 'Build and actually deploy one real, working project — not a tutorial clone left on localhost — that a stranger could use without you explaining it first.',
  },
  {
    num: 'Gate 2',
    title: 'Proof of communication',
    body: 'Explain, in under two minutes to someone non-technical, what a specific bug you fixed actually was and why your fix worked. If this is difficult, the underlying understanding may still be shallow.',
  },
  {
    num: 'Gate 3',
    title: 'Proof of value',
    body: 'Get one honest code review or portfolio review from a working developer, not just an instructor or bootcamp mentor with an incentive to encourage you, and ask directly whether your current work is hireable yet.',
  },
];

const verdictYes = [
  'You have picked, or are close to picking, a specific lane — frontend, backend, or a genuine full-stack depth — rather than staying generically unspecialised.',
  'You are realistic about the AI evidence: routine boilerplate work is genuinely shrinking, and you are building toward system design, debugging, and AI-tool direction rather than competing on typing speed alone.',
  'You are comfortable with continuous learning as a normal, ongoing part of the job, not an occasional inconvenience.',
  'You have, or are actively building, a real portfolio of deployed, working projects — not just completed course certificates.',
];

const verdictNo = [
  'You are entering with the same junior-hiring expectations that existed before AI coding tools became mainstream, without adjusting your entry strategy.',
  'You want a technology career with minimal ongoing relearning, which web development specifically does not offer.',
  'You are avoiding a specific lane indefinitely, staying "full-stack" only because choosing feels risky, not because you have genuine cross-stack depth.',
  'You are treating a completed bootcamp or course alone, with no deployed portfolio project, as sufficient to be hireable.',
];

const alternativeCards = [
  {
    title: 'Data engineering, if you enjoy backend systems thinking more than user-facing product work',
    body: 'A genuinely different specialisation focused on data pipelines and infrastructure rather than web products specifically — worth comparing if the backend-systems side of development is the real draw, not the web layer itself.',
  },
  {
    title: 'DevOps or cloud infrastructure, if you found deployment and systems reliability more interesting than feature-building',
    body: 'A related but distinct specialisation focused on how applications run and scale in production, commanding a genuine premium and sitting further from routine AI-automatable coding work.',
  },
  {
    title: 'UI/UX design, if the visual and interaction side draws you more than the implementation logic',
    body: 'A genuinely different skill set focused on how something should look and behave, rather than how it is built — worth exploring directly if the appeal is more visual-creative than logic-and-systems.',
  },
  {
    title: 'Product management, if you found yourself more interested in what to build than how to build it',
    body: 'A path for developers who realise their real interest is deciding product direction and prioritisation, using technical fluency as a strength rather than as the core daily work.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Completing course after course without ever deploying a real, working project',
    body: 'Course-completion alone rarely convinces an employer. A small number of genuinely deployed, real projects demonstrates far more than a long list of certificates.',
  },
  {
    num: '02',
    title: 'Staying generically "full-stack" indefinitely instead of building real depth somewhere',
    body: 'Shallow familiarity across many tools competes for less differentiated, more AI-exposed roles than genuine depth in one lane. Pick a specific direction once your fundamentals are solid.',
  },
  {
    num: '03',
    title: 'Ignoring AI coding tools entirely, on principle, instead of learning to direct them',
    body: 'Developers who treat AI tools as an unfair shortcut to avoid, rather than a skill to learn to use well, are choosing to be less efficient than peers who have integrated them into a real workflow.',
  },
  {
    num: '04',
    title: 'Assuming the entire field is being replaced by AI and avoiding it altogether',
    body: 'The realistic evidence is bifurcation of the market, not collapse of the field — routine boilerplate work is genuinely shrinking, while system design, debugging, and AI-tool direction are growing in value.',
  },
  {
    num: '05',
    title: 'Spending heavily on an expensive bootcamp without checking its actual placement track record',
    body: 'A useful discipline: treat roughly 10% of your total education budget as the default starting benchmark for coaching or bootcamp spend, and check any shortlisted programme\'s real, verifiable placement outcomes before spending materially above that.',
  },
];

const faqItems = [
  {
    q: 'Is web development a good career in 2026 with AI writing code now?',
    a: 'Yes, but the honest picture is bifurcation, not a flat yes. AI coding tools now handle a real share of routine boilerplate — CRUD forms, basic scaffolding, common integration patterns — which is genuinely shrinking demand for developers who only do that narrow work. At the same time, system design, debugging genuinely novel issues, and directing AI tools as a force-multiplier remain squarely human skills, and developers who build toward that layer are seeing rising, not falling, value. The field is not disappearing; the floor for what counts as differentiated, valuable work is rising.',
  },
  {
    q: 'What is the salary of a web developer in India?',
    a: 'A fresher (0-1 years) typically earns Rs 3.5-6 LPA, rising to Rs 7-14 LPA at mid-level (2-4 years), where pay is driven more by stack depth and system-design ability than tenure alone. Senior developers (5-8 years) with genuine architecture ownership earn Rs 16-30 LPA, and staff engineers, tech leads, or engineering managers (8+ years) can reach Rs 30-55 LPA and above, concentrated at product companies and well-funded startups. Freelance and contract web development can pay Rs 500-3,000+ per hour depending on stack and specialisation, though income is less consistent than a salaried role.',
  },
  {
    q: 'Should I choose frontend, backend, or full-stack development?',
    a: 'It depends on what genuinely interests you more, not which sounds "safer." Frontend rewards people who care about how something looks and feels to use; backend rewards systems and data thinking; full-stack trades some depth in either for broader project ownership, which is genuinely useful at smaller companies but less differentiated at large product companies with dedicated specialist teams. Picking a specific lane deliberately, once your fundamentals are solid, builds real depth faster than staying generically full-stack by default.',
  },
  {
    q: 'Will AI replace web developers?',
    a: 'Not the field as a whole, but it is genuinely reshaping which parts of the job stay valuable. AI coding assistants now write a real share of routine, well-specified boilerplate faster than a human typing it manually, which is shrinking demand for developers who only do that kind of narrow work. System design, architecture trade-offs, debugging genuinely novel production issues, and reviewing or integrating AI-generated code responsibly remain human work that is growing in relative value, not shrinking.',
  },
  {
    q: 'Can I become a web developer without a computer science degree?',
    a: 'Yes — web development has one of the more genuinely functional self-taught and bootcamp entry routes in tech, alongside the formal CS degree route. What matters most for hiring is a real portfolio of deployed, working projects, not the credential path used to get there. This route still requires real, sustained months of building before you are genuinely hireable, not a weekend of tutorials.',
  },
  {
    q: 'Is full-stack development better than specialising in frontend or backend?',
    a: 'Not automatically. Genuine full-stack depth — real competence across both layers, not surface familiarity — is valuable, especially at smaller companies and startups where developers own more of a project end to end. But a shallow full-stack profile, chosen mainly because specialising feels risky, competes for less differentiated roles than a developer with genuine depth in one lane. The better question is whether you have real depth somewhere, not which label you use.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const relatedGuides = [
  { href: '/blog/career-options/is-devops-a-good-career', label: 'Is DevOps a good career? Real pay, growth, verdict' },
  { href: '/blog/career-options/is-ui-ux-design-a-good-career-in-india', label: 'Is UI/UX design a good career in India?' },
  { href: '/blog/career-options/is-data-engineer-a-good-career', label: 'Is data engineering a good career? Real pay, verdict' },
];
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Is web development a good career in 2026, with AI tools now writing a real share of code? Yes, but the
    honest answer has changed shape.</strong>
    The field is not collapsing under AI — it is bifurcating. Routine, well-specified boilerplate work is genuinely
    shrinking as AI coding assistants handle more of it, while system design, debugging genuinely novel problems,
    and directing AI tools as a force-multiplier are becoming more valuable, not less. Developers who build toward
    that second layer, rather than competing on typing speed alone, are still finding real
    <strong>high income opportunities</strong> and a genuine path to <strong>earlier financial freedom</strong>
    through a durable <strong>high-value skill portfolio</strong>.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Web development is not one job — frontend, backend, and full-stack have different daily work, different AI exposure, and different pay ceilings, and "is web development good" depends on which lane you mean.</li>
      <li>Pay runs from roughly Rs 3.5-6 LPA for a fresher to Rs 30-55 LPA+ for staff engineers or leads, with the widest, most skill-driven band sitting at mid-level (2-4 years).</li>
      <li>AI coding tools genuinely reduce demand for narrow, boilerplate junior work — but system design, debugging, and AI-tool direction are growing in value, not shrinking.</li>
      <li><strong>Building real depth in a specific lane — performance, security, infrastructure, or a genuine framework specialisation — is what turns a generic coding skill into a real high-value skill portfolio.</strong></li>
      <li>A real portfolio of deployed, working projects matters more for hiring today than course-completion certificates alone, especially at entry level.</li>
      <li>Pick a specific lane deliberately once your fundamentals are solid, rather than staying generically "full-stack" because choosing feels risky.</li>
    </ul>
  </div>

  <p>
    If you are also weighing this against adjacent tech paths, comparing
    <a href="/blog/career-options/is-devops-a-good-career">DevOps</a> or
    <a href="/blog/career-options/is-data-engineer-a-good-career">data engineering</a> against web development can
    help you see how differently the AI-exposure and pay-ceiling questions play out across tech careers before you
    commit to one.
  </p>

  <p>
    If you want a clearer read on whether systems-thinking or visual-interaction work genuinely fits your working
    style, use the <a href="/career-skills-compass/">Career &amp; Skills Compass</a> before committing to a
    specific stack.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer to "is web development a good career"</h2>

  <p>
    Web development remains a genuinely strong field in 2026, but the honest version of "is it good" has to
    account for what has actually changed: AI coding tools now do a real share of the routine work that used to be
    the default entry point into the field.
  </p>

  <p>
    The realistic read is bifurcation, not collapse. Generic, narrow, boilerplate-only coding is genuinely under
    pressure.
  </p>

  <p>
    Developers who build toward system design, real debugging skill, and effective use of AI tools as a
    force-multiplier are seeing rising demand and pay, not falling. The field has not disappeared — the bar for
    what counts as differentiated, valuable work has moved up.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      This is not the "learn to code, six figures guaranteed" pitch some bootcamp marketing still runs, and it is
      not the "AI is replacing all programmers" panic headline either. Both miss the real picture.
    </p>
    <p>
      Entry-level hiring genuinely has gotten more selective because AI tools now cover a meaningful slice of
      narrow junior work. At the same time, developers with real depth — architecture judgment, debugging skill,
      AI-tool fluency — are in a genuinely strong position. Both things are true at once.
    </p>
  </div>

  <h2 id="stack-reality">Frontend vs backend vs full-stack: pick a lane before researching further</h2>

  <p>
    Before pay, AI risk, or growth strategy, there is a structural question worth settling first, because it
    changes what the rest of this article's advice actually applies to for you.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">The three lanes</div>
      <ul>
        {stackComparison.gold.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">Why the distinction matters</div>
      <ul>
        {stackComparison.teal.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </div>

  <p>
    From here, the growth-strategy and AI-risk sections below apply to all three lanes, but the specific
    differentiation moves worth making differ meaningfully depending on which one you are actually building toward.
  </p>

  <h2 id="salary-data">Real pay by stack and experience</h2>

  <p>
    A single "web developer salary in India" figure hides more than it reveals, because a mid-level developer with
    real specialisation can out-earn a senior developer who has stayed generic.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Stage</th>
          <th>Typical range</th>
          <th>Reality</th>
        </tr>
      </thead>
      <tbody>
        {salaryRows.map((item) => (
          <tr>
            <td data-label="Stage"><strong>{item.stage}</strong></td>
            <td data-label="Typical range">{item.range}</td>
            <td data-label="Reality">{item.reality}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Ranges are directional, based on aggregated 2025-2026 salary-tracking data at the time of writing. Verify
    current figures against live listings for your specific city, stack, and company type before making a
    financial decision.
  </p>

  <h2 id="ai-risk">What AI is actually replacing here, and what it is not</h2>

  <p>
    This is the question every "is web development a good career" search is really circling in 2026, and it
    deserves a specific, evidence-based answer rather than a reflexive yes or no.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">What AI is genuinely replacing or compressing</div>
      <ul>
        {aiComparison.gold.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">What remains genuinely human work, and is growing in value</div>
      <ul>
        {aiComparison.teal.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="highlight-box highlight-box--amber">
    <p>
      The clearest way to think about this: AI tools have compressed the time it takes to produce routine code,
      which raises the bar for what counts as a differentiated, hireable skill set. A developer who only produces
      boilerplate is competing directly against a tool that does it faster and cheaper. A developer who can design,
      debug, and direct that same tool is more productive and more valuable than before, not less.
    </p>
  </div>

  <h2 id="growth-scaling">How senior developers keep scaling their income</h2>

  <p>
    Web development can plateau exactly like any other job — shipping assigned features indefinitely with no added
    specialisation has a real, moderate ceiling. But there is genuine headroom for developers who move
    deliberately.
  </p>

  <div class="employer-grid">
    {growthCards.map((item) => (
      <div class="employer-card">
        <div class="employer-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="who-fits">Who this path genuinely fits</h2>

  <div class="feature-grid">
    {whoFitsItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="who-pause">Who should think twice before choosing web development</h2>

  <p>
    This is the section most bootcamp marketing and "learn to code" ads skip, because it does not make for good
    enrolment copy. It is the section that saves wasted months and a wasted course fee.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Warning sign</th>
          <th>What is actually true</th>
        </tr>
      </thead>
      <tbody>
        {whoPauseRows.map((item) => (
          <tr>
            <td data-label="Warning sign"><strong>{item.signal}</strong></td>
