---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Career in public relations India: real pay, real entry routes, and what's changing";
const description =
  'A career in public relations India spans agency and in-house paths, real salary bands by experience and city, and how digital and influencer PR are reshaping entry-level work.';
const canonical = 'https://futurecareerschool.com/blog/career-options/career-in-public-relations-india';
const publishedDateISO = '2026-07-14';
const publishedDateLabel = '14 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-the-job-is', label: 'What PR work actually is' },
  { id: 'agency-vs-inhouse', label: 'Agency vs in-house: the real trade-off' },
  { id: 'entry-routes', label: 'The 3 real entry routes' },
  { id: 'career-ladder', label: 'The PR career ladder, title by title' },
  { id: 'skills', label: 'The skills that actually get you hired' },
  { id: 'salary-by-experience', label: 'What PR professionals actually earn' },
  { id: 'salary-by-city', label: 'Pay by city and agency type' },
  { id: 'digital-shift', label: 'How digital and influencer PR changed the job' },
  { id: 'ai-impact', label: 'What AI is actually doing to PR work' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol before you commit' },
  { id: 'gates', label: 'The 3 Gates before you apply anywhere' },
  { id: 'mistakes', label: 'Mistakes that stall people in PR' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const entryRouteCards = [
  {
    badge: 'Route 1',
    title: 'Mass communication or PR degree, then internship',
    body: 'A BA in Mass Communication, Journalism, or Public Relations, followed by a PG diploma or MA in Public Relations or Corporate Communication. This is the most structured route and the one most agencies still expect from freshers, mainly because it front-loads writing, media law, and campaign-planning training you would otherwise have to pick up on the job.',
    fit: 'You are choosing a degree now and want a direct, recognised path with placement support and campus internships built in.',
    caution: 'A degree alone does not get you hired. Agencies interview for writing speed and media instinct, not transcripts — treat the degree years as time to build a portfolio, not just credits.',
    tags: ['Most structured', '3-5 years total'],
  },
  {
    badge: 'Route 2',
    title: 'Lateral entry from journalism or content writing',
    body: 'Working journalists and content writers regularly move into PR because they already have the two hardest skills to teach: fast, accurate writing under deadline pressure, and an understanding of what a newsroom actually wants from a pitch.',
    fit: 'You already write professionally in journalism, content, or copywriting and want the more predictable pay and hours that agency or in-house PR tends to offer.',
    caution: 'Journalists sometimes struggle with the client-facing, sales-adjacent side of PR — pitching a story you do not personally believe in, managing a client\'s ego, and hitting KPIs tied to coverage volume rather than editorial judgment.',
    tags: ['Fastest for writers', 'No PR degree required'],
  },
  {
    badge: 'Route 3',
    title: 'Internal move from marketing or social media',
    body: 'People already working in marketing, social media management, or brand teams move sideways into PR and communications roles, especially in-house, once they have shown they can manage external stakeholders and protect a brand\'s narrative.',
    fit: 'You are inside a company already and want to move into communications without restarting your career from an internship.',
    caution: 'Marketing metrics (clicks, reach, conversions) and PR metrics (share of voice, sentiment, message pull-through) are genuinely different disciplines — expect a real learning curve on media relations specifically, not just a title change.',
    tags: ['No agency required', 'Works well in-house'],
  },
];

const careerLadderRows = [
  { title: 'PR intern / trainee', years: '0 years', work: 'Media list building, clipping and coverage tracking, drafting under supervision, event support.' },
  { title: 'Account executive / PR executive', years: '0-2 years', work: 'Drafting press releases and pitches, pitching journalists directly, basic social content, client status reports.' },
  { title: 'Senior executive / associate', years: '2-4 years', work: 'Owns smaller accounts or a portion of a large account, builds independent media relationships, drafts campaign plans.' },
  { title: 'Account manager / manager', years: '4-7 years', work: 'Owns client relationships, sets campaign strategy, manages junior staff, handles early-stage crisis situations.' },
  { title: 'Senior manager / AVP', years: '7-10 years', work: 'Multi-account or category oversight, new business pitching, senior client counsel, budget ownership.' },
  { title: 'Director / VP / Group Head', years: '10-15+ years', work: 'Practice leadership, C-suite client counsel, crisis command, agency or team P&L responsibility.' },
];

const salaryExperienceRows = [
  {
    stage: 'Fresher / intern (0-1 years)',
    range: 'Rs 2-4 LPA (agency); Rs 3-5 LPA (in-house, when hired directly)',
    note: 'Many agencies pay a stipend during a 3-6 month internship before converting to a full-time offer at the lower end of this band.',
  },
  {
    stage: 'Executive / account executive (1-3 years)',
    range: 'Rs 3.5-6 LPA',
    note: 'This is where most PR careers actually start earning a stable salary — the gap between agency and in-house pay is usually smallest at this stage.',
  },
  {
    stage: 'Senior executive / manager (3-6 years)',
    range: 'Rs 6-12 LPA',
    note: 'The band widens sharply here based on sector: fintech, healthcare, and tech clients tend to pay more than lifestyle or FMCG accounts at the same seniority.',
  },
  {
    stage: 'Senior manager / AVP (6-10 years)',
    range: 'Rs 12-20 LPA',
    note: 'In-house corporate communications roles at large or listed companies commonly sit at the top of this band, especially where investor relations overlaps with the role.',
  },
  {
    stage: 'Director / VP and above (10+ years)',
    range: 'Rs 20-50+ LPA',
    note: 'At this level, pay depends heavily on whether the role is agency leadership (linked to new-business billings) or a corporate communications head role reporting to a CEO or board.',
  },
];

const salaryCityRows = [
  {
    market: 'Mumbai and Delhi-NCR',
    detail: 'The two largest PR hubs — most agency head offices and the highest concentration of national media sit here, which also means the most competition for entry-level seats.',
    pay: 'Typically the top of every experience band above; cost of living also runs highest.',
  },
  {
    market: 'Bengaluru and Hyderabad',
    detail: 'Strong for tech, startup, and product PR specifically, with agencies and in-house teams built around fast-growing companies and investor-facing communication.',
    pay: 'Close to Mumbai/Delhi at mid-to-senior levels, especially for startup and tech-sector accounts.',
  },
  {
    market: 'Regional and tier-2 markets',
    detail: 'Regional PR now accounts for roughly 19% of industry revenue, up from about 10% three years ago, as brands push beyond metro-only coverage. Pay is lower, but so is competition for the first job.',
    pay: 'Usually the lower end of each experience band, with faster ownership of real client work.',
  },
];

const skillRows = [
  { skill: 'Writing under deadline', why: 'Press releases, pitches, statements, and briefing notes have to be accurate and fast — this is the single most tested skill in every PR interview.' },
  { skill: 'Media relationship building', why: 'A journalist who trusts you returns your calls. This is built slowly through relevant, non-spammy pitching, not a media list you bought or scraped.' },
  { skill: 'Crisis and issues handling', why: 'The work that actually separates a PR professional from a content writer — staying calm, accurate, and fast when a story turns negative.' },
  { skill: 'Digital and influencer literacy', why: 'Modern PR briefs routinely include an influencer or creator layer alongside traditional media, so understanding platforms, rates, and disclosure norms is now baseline, not a bonus.' },
  { skill: 'Measurement and reporting', why: 'Clients increasingly ask for share of voice, sentiment, and message pull-through data, not just a clipping count — basic spreadsheet and analytics comfort now matters.' },
  { skill: 'AI-tool direction', why: 'Using AI for first-draft releases, media list research, and monitoring, then checking the output for accuracy and tone before anything goes out under a client\'s name.' },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Fit',
    body: 'PR is a relationship-and-availability job before it is a writing job. Media calls happen at odd hours, launch events run late, and a crisis does not wait for your lunch break. Ask yourself honestly whether you can stay calm and responsive under that kind of always-on pressure, not just whether you enjoy talking to people.',
    note: 'If irregular hours and being reachable outside a 9-to-6 window genuinely drain you, PR agency life specifically will be harder than the job description suggests.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Entry-level PR pay (Rs 2-6 LPA) is on the lower end compared to several other communication-heavy careers at the same stage. Can you cover your costs on that pay for the first 2-3 years while you build the media relationships and portfolio that unlock the next salary jump?',
    note: 'A parallel skill — freelance content writing, basic social media management, or a digital marketing certificate — gives you income flexibility while your PR portfolio is still thin.',
  },
  {
    num: '03',
    title: 'Market',
    body: "India's PR industry grew 11% to roughly Rs 3,230 crore in the 2025-26 financial year and is projected to reach about Rs 4,500 crore by 2030, according to PRCAI's SPRINT industry report. Government and start-up client budgets have both grown sharply as a share of the total, while private corporate share has slipped slightly — a real market, but one where client mix keeps shifting under you.",
    note: 'A growing market does not guarantee an easy entry — mass communication colleges graduate far more people every year than the number of true entry-level agency seats.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI tools are already doing first-draft press releases, media list research, and coverage monitoring faster than a junior executive can. The PRCAI report also shows AI spending by communication teams rising from about 2% to 7% of revenue, mostly on content and research tasks.',
    note: 'Treat AI-tool fluency and judgment (catching a wrong fact or a wrong tone before it ships) as core PR skill, not an optional extra — this is what keeps the entry-level role valuable as the routine drafting work gets automated.',
  },
];

const gateItems = [
  {
    num: '01',
    title: 'Proof of Skill',
    title2: 'Can you write a real press release and a real media pitch, cold?',
    body: 'Pick a real (or realistic) company or product, write a one-page press release, and write three different pitch emails aimed at three different kinds of journalists (a business reporter, a lifestyle reporter, and a trade-publication reporter). This is the single most common test PR interviewers actually run.',
  },
  {
    num: '02',
    title: 'Proof of Communication',
    title2: 'Can you handle a hard question in under two minutes?',
    body: 'Write a short holding statement for a mildly negative hypothetical situation (a product recall, a late delivery, a public complaint) and practice saying it out loud, calmly, without sounding defensive. This is the skill that separates a junior PR hire from someone who can only write press releases.',
  },
  {
    num: '03',
    title: 'Proof of Value',
    title2: 'Has anyone outside your own head validated it?',
    body: 'Show your press release, pitches, and holding statement to a working PR professional, a journalist you know, or a communications lecturer, and ask them to poke holes in it honestly. Fix what they flag before your first real interview, not after.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating PR as "the glamorous events job"',
    body: 'Most of the actual week is writing, research, follow-up emails, and coverage tracking. People who join expecting red carpets and launch parties burn out fast when the real 80% of the job turns out to be spreadsheet-and-inbox work.',
  },
  {
    num: '02',
    title: 'Sending generic, mass-blast pitches',
    body: 'A pitch that clearly was not written for the specific journalist gets ignored, and repeat offenders get quietly blacklisted by beat reporters. Real media relationships are built one relevant, well-targeted pitch at a time, not through a scraped list of a thousand email addresses.',
  },
  {
    num: '03',
    title: 'Ignoring the digital and influencer layer',
    body: 'A PR professional who can only pitch traditional print and TV media is competing for a shrinking slice of client budgets. Influencer coordination, digital PR (earned links and online mentions), and social listening are now baseline expectations on most modern briefs.',
  },
  {
    num: '04',
    title: 'Skipping measurement skills',
    body: 'Clients increasingly want share of voice, sentiment trend, and message pull-through data, not just a clipping count in a PDF. PR professionals who cannot speak that data language get sidelined in client conversations by people who can.',
  },
  {
    num: '05',
    title: 'Never building a portfolio of real coverage',
    body: 'One unpaid internship with no documented outcomes (actual published coverage, actual pitch-to-placement examples) is a weak story in an interview. Track every piece of coverage you helped land, from day one, and keep the proof.',
  },
];

const faqItems = [
  {
    q: 'Is public relations a good career in India?',
    a: "Yes, with real conditions attached. India's PR industry grew 11% to about Rs 3,230 crore in FY26 and is projected to reach roughly Rs 4,500 crore by 2030, and communicators increasingly report PR playing a direct role in business outcomes. The trade-off is entry-level pay (Rs 2-6 LPA) that is lower than several other communication careers at the same stage, and a market where mass communication colleges produce more graduates every year than there are true entry-level agency seats. It is a good career for people who can write fast, build real relationships, and stay calm under pressure — not for people chasing a glamorous events job.",
  },
  {
    q: 'What is the starting salary for a career in public relations in India?',
    a: 'Fresh graduates and interns typically start around Rs 2-4 LPA at agencies, sometimes slightly higher (Rs 3-5 LPA) when hired directly in-house. By the account executive stage (1-3 years), pay usually moves to Rs 3.5-6 LPA. The range varies by city, sector, and whether the role is agency-side or in-house — fintech, healthcare, and tech accounts tend to pay more than lifestyle or FMCG accounts at the same level.',
  },
  {
    q: 'Should I start my PR career at an agency or in-house?',
    a: 'Most PR professionals in India start at an agency because it exposes you to multiple clients, sectors, and media contacts fast, which compresses the learning curve. In-house corporate communications roles often pay somewhat more at the same seniority and offer deeper focus on one organisation and brand, but the entry bar is usually a few years of proven agency or newsroom experience first. A common and sensible path is agency first, in-house later, once you have built a real media network and a portfolio of coverage.',
  },
  {
    q: 'Do I need a mass communication or PR degree to work in PR in India?',
    a: 'It helps but is not strictly mandatory. A BA in Mass Communication, Journalism, or Public Relations, followed by a PG diploma or MA in the field, is the most structured and commonly expected route, especially at larger agencies. That said, working journalists, content writers, and even marketing professionals regularly move into PR laterally, because strong writing, media instinct, and stakeholder management usually matter more to hiring managers than the specific degree on your resume.',
  },
  {
    q: "What's the difference between PR, digital marketing, and journalism as careers?",
    a: 'Journalism reports and analyses news independently for an audience. Digital marketing promotes a brand directly through owned and paid channels (ads, SEO, social content) that the brand fully controls. Public relations sits between the two: it earns coverage, trust, and reputation through third parties (journalists, influencers, industry voices) rather than paying for placement outright, and increasingly blends media relations with digital and influencer coordination in the same role.',
  },
  {
    q: 'Will AI replace public relations jobs in India?',
    a: 'AI is automating the routine layer of PR work — first-draft press releases, media list research, coverage monitoring, and basic sentiment tracking — rather than replacing the role outright. Indian communication teams have already increased AI spending from roughly 2% to 7% of revenue, mostly on content and research tasks, according to PRCAI\'s 2026 industry report. What stays valuable, and grows in importance, is judgment: catching a wrong fact or a wrong tone before it ships, handling a real crisis, and building genuine relationships with journalists and stakeholders that no automated tool can replicate.',
  },
  {
    q: 'How do I start a career in public relations in India with no experience?',
    a: "Build proof before you apply anywhere: write a real press release and three targeted media pitches for a real or realistic company, write a short crisis holding statement, and get a working PR professional or journalist to review your work honestly. Apply for internships at agencies or in-house communication teams while finishing a mass communication, journalism, or PR-related degree or diploma, and track every piece of coverage or measurable outcome you help produce from day one — that documented track record matters more in interviews than the internship title alone.",
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Career Options', item: 'https://futurecareerschool.com/blog/career-options' },
      { '@type': 'ListItem', position: 4, name: 'Career in Public Relations India', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={jsonLd}
>
  <p class="lead-para">
    A <strong>career in public relations in India</strong> means choosing between agency and in-house
    paths, learning to write and pitch under real deadline pressure, and increasingly, learning to run
    influencer and digital coverage alongside traditional media — starting pay is modest (Rs 2-6 LPA),
    but the ceiling stretches well past Rs 30-50 LPA at director and leadership level once you build
    real media relationships and a documented track record of coverage.
  </p>
  <p>
    This is a genuine skill-building career, not a glamour job. PR pays for a combination that is
    genuinely scarce — fast, accurate writing, real relationships with journalists and creators, and the
    judgment to stay calm when a story turns negative — and that combination is what actually unlocks
    higher income opportunities here, not the college name on your CV. Get the skill stack and the
    proof of coverage right, and this path can move you toward earlier financial freedom faster than the
    entry-level pay suggests. Chase only the internship title without building real relationships and
    writing speed, and you stay stuck at account-executive pay for years.
  </p>
  <p>
    Here is the honest map: what the job actually looks like day to day, agency versus in-house
    trade-offs, the three real entry routes, what PR professionals actually earn by experience and city,
    how digital and influencer PR have rewritten the job description, and what AI is already changing.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Agency PR teaches faster (multiple clients, multiple sectors) but pays less at entry; in-house PR usually pays more but expects prior agency or newsroom experience first.</li>
      <li>Three real entry routes exist: a mass communication or PR degree, a lateral move from journalism or content writing, or an internal move from marketing or social media.</li>
      <li>Realistic pay: Rs 2-6 LPA at entry, Rs 6-12 LPA by mid-career (3-6 years), and Rs 20-50+ LPA at director and leadership level, with meaningful variation by city and sector.</li>
      <li>India's PR industry grew 11% to about Rs 3,230 crore in FY26 and is projected to reach roughly Rs 4,500 crore by 2030, with government and start-up client budgets growing fastest.</li>
      <li>AI is automating first-draft writing, media research, and monitoring, not the relationship and judgment layer — treat AI-tool fluency as a baseline skill, not an optional extra.</li>
      <li>PR scales when domain knowledge, writing, people judgment, crisis handling, and measurable reputation outcomes become visible. A strong body of work and trusted network can lead to consulting, an agency, or specialist advisory income beyond one in-house role.</li>
    </ul>
  </div>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Get a second opinion on your PR plan</a>
    <a class="btn-outline cta-assessment-lite" href="https://futurecareerschool.com/services/assessments">Use a free assessment as a quick first check</a>
  </div>

  <nav class="jump-nav" aria-label="Jump to section">
    <span class="jump-nav__label">Jump to section</span>
    <ul class="jump-nav__list">
      {jumpLinks.map((link) => (
        <li><a href={`#${link.id}`}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer</h2>
  <p>
    If you are weighing a career in public relations in India, the honest starting point is this: pick
    agency or in-house based on what you need right now (speed of learning versus stability of pay), pick
    one of the three real entry routes below, and start building a portfolio of real writing and real
    coverage before your first interview. Entry pay is modest and the market is crowded with mass
    communication graduates, but the professionals who build genuine media relationships, learn the
    digital and influencer layer, and get comfortable directing AI tools rather than fearing them move
    up the pay ladder faster than the industry average suggests.
  </p>
  <p>
    If you want a wider view before narrowing in on PR specifically, the broader
    <a href="/blog/career-options/">career options</a> guides on this site cover adjacent
    communication-heavy paths, and if the pressure of choosing right now feels heavy,
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you map this against your actual constraints — money, family expectations, and timeline —
    instead of deciding on vibes alone.
  </p>

  <h2 id="what-the-job-is">What PR work actually is</h2>
  <p>
    Strip away the "media and events" branding and the job is this: you manage what gets said about a
    person, brand, or organisation, through people who are not on your payroll — journalists, editors,
    influencers, and industry voices — instead of through ads the brand pays for directly. That means
    writing press releases and media pitches, building and maintaining a real network of media contacts,
    planning and executing campaigns tied to a launch or a moment, monitoring coverage and sentiment, and
    stepping in fast when something goes wrong.
  </p>
  <p>
    None of that is as glamorous as it sounds in a job description. The actual week is dominated by
    drafting, redrafting because a client changed one line, cold-emailing journalists who do not reply,
    building and updating spreadsheets of coverage, and sitting in status calls. The "big win" moments —
    a front-page story, a trending influencer post, a well-handled crisis — happen occasionally and
    briefly. The boring 80% is what actually fills a PR professional's week, same as most communication-
    heavy careers.
  </p>
  <div class="callout callout--teal">
    <p class="callout__eyebrow">Honest take</p>
    <p>
      If the appeal is the word "PR" more than the actual daily grind of writing pitches and chasing
      journalists who do not respond, this is an expensive way to find that out. Write and pitch one real
      release before you commit years to chasing the title.
    </p>
  </div>

  <h2 id="agency-vs-inhouse">Agency vs in-house: the real trade-off</h2>
  <p>
    This is the single biggest early decision in a PR career, and it is not about which one is "better" —
    it is about what you need at your current stage.
  </p>
  <div class="compare-grid">
    <div class="compare-col compare-col--teal">
      <span class="compare-label">Agency</span>
      <ul>
        <li>Exposure to multiple clients and sectors at once, which compresses your learning curve fast.</li>
        <li>You build a broad media network quickly because you are pitching for several accounts simultaneously.</li>
        <li>Entry-level pay usually sits lower (roughly Rs 2-4 LPA), and hours can be unpredictable around launches and client deadlines.</li>
        <li>Career progression can move faster if you consistently bring in results, since agencies run more like performance-driven businesses.</li>
      </ul>
    </div>
    <div class="compare-col compare-col--gold">
      <span class="compare-label">In-house</span>
      <ul>
        <li>You work on one organisation's narrative in depth, with more context and continuity than any single agency account gives you.</li>
        <li>Pay tends to be somewhat higher at the same seniority, especially at large or listed companies, though entry-level in-house roles are less common than agency roles.</li>
        <li>You are often the only communications specialist in the room, with less day-to-day mentorship from peers who do the exact same job.</li>
        <li>Promotions and scope changes usually move slower than in an agency, and depend more on internal politics and budget cycles.</li>
      </ul>
    </div>
  </div>
  <p>
    A common and sensible pattern in India: start at an agency to build speed, media relationships, and a
    portfolio across a few sectors, then move in-house once you know which industry you actually want to
    specialise in and want steadier pay and deeper focus.
  </p>

  <h2 id="entry-routes">The 3 real entry routes</h2>
  <p>
    Every "how to get into PR" guide eventually reduces to three real doors. Pick based on where you
    actually stand today.
  </p>
  <div class="track-grid">
    {entryRouteCards.map((route) => (
      <div class="track-card">
        <span class="track-badge">{route.badge}</span>
        <h3>{route.title}</h3>
        <p>{route.body}</p>
        <div class="sub-row sub-row--fit">
          <span class="sub-row-label">Best for</span>
          <p>{route.fit}</p>
        </div>
        <div class="sub-row sub-row--caution">
          <span class="sub-row-label">Watch out</span>
          <p>{route.caution}</p>
        </div>
        <div class="tag-row">
          {route.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
  <p>
    If you are still comparing PR against other communication-heavy careers before committing,
    <a href="/blog/career-options/career-options-for-people-good-at-communication-india/">career options for people good at communication in India</a>
    covers the wider landscape, and
    <a href="/blog/career-options/journalism-vs-content-writing-career-india/">journalism vs content writing career India</a>
    is a useful direct comparison if you are weighing PR against those two paths specifically.
  </p>

  <h2 id="career-ladder">The PR career ladder, title by title</h2>
  <p>
    Titles vary between agencies, but the shape of the ladder is fairly consistent across the Indian PR
    industry:
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Typical experience</th>
          <th>What the work actually is</th>
        </tr>
      </thead>
      <tbody>
        {careerLadderRows.map((row) => (
          <tr>
            <td data-label="Title">{row.title}</td>
            <td data-label="Typical experience">{row.years}</td>
            <td data-label="What the work actually is">{row.work}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    The jump that matters most for pay is usually senior executive to account manager, around the 4-year
    mark — this is where you stop executing someone else's plan and start owning client strategy and
    campaign decisions directly.
  </p>

  <h2 id="skills">The skills that actually get you hired</h2>
  <p>
    Interviewers do not primarily test your degree. They test whether you can write fast, pitch
    convincingly, and stay calm under pressure. These are the skills that actually get checked:
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Skill</th>
          <th>Why it matters</th>
        </tr>
      </thead>
