const marketTailwindPoints = [
  'India’s food processing market was valued at roughly ₹30.5 lakh crore (about US$354.5 billion) in 2024 and is projected to reach roughly US$535 billion by the end of FY26, and roughly US$700 billion by 2030, per IBEF/Ministry of Food Processing Industries data.',
