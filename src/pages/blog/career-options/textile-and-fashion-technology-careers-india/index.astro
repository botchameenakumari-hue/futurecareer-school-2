---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Textile and Fashion Technology Careers in India";
const seoTitle = "Textile and Fashion Technology Careers in India: Roles and Skills";
const description = "Textile and fashion technology careers in India: production, quality, merchandising, design technology and sourcing roles, skills, a free-first plan and honest limits.";
const seoDescription = "Production knowledge and quality records set technologists apart.";
const canonical = "https://futurecareerschool.com/blog/career-options/textile-and-fashion-technology-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What jobs exist in textile and fashion technology?",
    "Production, quality, merchandising, design technology and sourcing."
  ],
  [
    "Do I need design skill?",
    "Not for all roles. Read notices."
  ],
  [
    "Is factory exposure important?",
    "Yes. Visit with questions."
  ],
  [
    "Can I start a small venture?",
    "Yes, with rules followed and small batches."
  ],
  [
    "Which skills matter?",
    "Specifications, quality checks and communication."
  ],
  [
    "Is it only for creative people?",
    "No. Technical and planning roles exist."
  ],
  [
    "How do I show skill?",
    "Share a spec sheet and an inspection report."
  ],
  [
    "Will AI change the field?",
    "Routine documentation shrinks. Quality judgment remains."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
