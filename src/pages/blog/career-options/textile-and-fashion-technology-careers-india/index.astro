        </tr>
        <tr>
          <td data-label="Defect"><strong>Wrong measurements</strong></td>
          <td data-label="Where seen">Garment size</td>
          <td data-label="How to record">Record the measure and tolerance</td>
        </tr>
        <tr>
          <td data-label="Defect"><strong>Loose threads and stains</strong></td>
          <td data-label="Where seen">Finished garment</td>
          <td data-label="How to record">Count and classify</td>
