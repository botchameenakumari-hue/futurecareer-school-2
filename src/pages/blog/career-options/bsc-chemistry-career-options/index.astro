const testSteps = [
  { title: "Pick two routes, not ten", body: "Run both through the 4-Checkpoint Protocol and set the rest aside." },
  { title: "Read ten live postings for each", body: "Write down the instruments, tests and rule names that repeat, such as HPLC, GC, UV, titration, ISO/IEC 17025 or GMP." },
  { title: "Make one piece of proof for each", body: "A calibration workbook, an SOP rewrite or a recorded lesson. Go at your own pace. Some people finish in a few weeks, others need a couple of months." },
  { title: "Ask three people who do the work", body: "One from each route and one who left it. Ask what the first year felt like and what the safety training was like." },
  { title: "Write down the MSc decision", body: "Does your target door name a master's? If yes, plan the public seat. If no, take the job and keep a national exam open." },
