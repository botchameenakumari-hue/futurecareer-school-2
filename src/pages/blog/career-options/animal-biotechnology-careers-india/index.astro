const description = "Animal biotechnology careers in India: dairy genetics, vaccines, diagnostics and research roles, ethics and rules to verify, skills and free-first steps.";
const seoDescription = "Animal biotech needs ethics, regulation awareness and careful lab or field records.";
const canonical = "https://futurecareerschool.com/blog/career-options/animal-biotechnology-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What is animal biotechnology?",
    "Applying biology to animal health, breeding and products."
  ],
  [
    "What careers are there?",
    "Diagnostics, vaccines, breeding support, dairy quality and research."
  ],
  [
    "Do I need to work with animals?",
    "Some roles do. Others use data. Rules and ethics apply."
  ],
  [
    "Is it a good career in India?",
    "It can be for people who like both biology and applied work. Check notices."
  ],
  [
    "Do I need a veterinary degree?",
    "Some roles do. Others accept science degrees. Check each notice."
  ],
  [
    "How do I start without lab access?",
    "Study theory, analyse public data and visit approved institutions."
  ],
  [
    "Can I start a business?",
    "Some do after experience, with licences verified."
  ],
  [
    "Will AI replace the work?",
    "AI helps analyse data. Welfare and field judgment remain human."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
