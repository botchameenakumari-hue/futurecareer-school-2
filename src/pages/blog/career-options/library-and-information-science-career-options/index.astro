---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Library and Information Science Career Options in India: The Real Path Map';
const description =
  "Library and information science career options in India go far past a librarian's desk: UGC-NET routes, government library pay scales, corporate knowledge management, and digital archiving, mapped by real ceiling and demand.";
const canonical =
  'https://futurecareerschool.com/blog/career-options/library-and-information-science-career-options';
const publishedDateISO = '2026-09-20';
const publishedDateLabel = '20 September 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'degree-map', label: 'What a BLIS/MLIS degree actually is' },
  { id: 'career-tracks', label: 'The real career tracks, ranked by ceiling' },
  { id: 'entry-routes', label: 'BLIS/MLIS entry routes and eligibility' },
  { id: 'ugc-net', label: 'UGC-NET for Library Science: the real gate' },
  { id: 'government-recruitment', label: 'Government and public library recruitment' },
  { id: 'pay-by-track', label: 'Real pay, track by track' },
  { id: 'ownership-path', label: 'The one path with no fixed ceiling' },
  { id: 'ai-effect', label: 'What AI is actually changing here' },
  { id: 'who-fits', label: 'Which track actually fits you' },
  { id: 'mistakes', label: 'Mistakes that waste the degree' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'related', label: 'Related reading' },
  { id: 'faq', label: 'FAQs' },
];

const careerTracks = [
  {
    badge: '01 - Highest ceiling',
    title: 'Corporate and special-library knowledge management',
    body: 'Law firms, consulting firms, pharma R&D, media houses, and BFSI companies hire information specialists to run internal knowledge bases, manage paid database and journal licensing, and build taxonomy and search systems for thousands of employees.',
