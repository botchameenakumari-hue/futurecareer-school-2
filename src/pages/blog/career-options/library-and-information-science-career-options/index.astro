const entryRows = [
  {
    stage: 'Bachelor of Library and Information Science (BLIS)',
    detail: 'A 1-year professional degree open to graduates of any discipline (a Bachelor\'s degree in any subject is the eligibility, not a specific stream). Some universities also run a 3-year integrated BLIS after Class 12.',
  },
  {
    stage: 'Master of Library and Information Science (MLIS)',
    detail: '1-2 years after a BLIS (or, at some universities, directly after any Bachelor\'s degree). This is the usual minimum qualification for librarian and information-officer posts, not just library-assistant roles.',
  },
  {
    stage: 'UGC-NET for Library and Information Science',
    detail: 'A national-level qualifying exam conducted by the NTA. Required for Assistant Professor (library science) posts and, at most universities, for university and college librarian posts specifically, alongside the MLIS.',
  },
  {
    stage: 'M.Phil / Ph.D in Library and Information Science',
    detail: 'Optional, but relevant for senior academic-library leadership roles and for anyone aiming at teaching library science itself at a university.',
  },
];

const payRows = [
  {
    track: 'School librarian / library-in-charge (entry)',
    pay: 'Roughly Rs 2-4 LPA',
  },
  {
    track: 'Library assistant / junior librarian (public, academic, or corporate library)',
    pay: 'Roughly Rs 2.2-4 LPA',
  },
