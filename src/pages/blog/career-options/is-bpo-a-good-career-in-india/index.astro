const bridgeRows = [
  { lever: "Communication", build: "Aim to be the clearest writer and speaker on your floor. Keep a folder of your best replies and call notes (remove customer details).", proof: "A short sample set and a scorecard history." },
  { lever: "Domain depth", build: "Pick the account you work on, such as banking, insurance, telecom or healthcare, and learn how that business actually makes and loses money.", proof: "One page on the top five reasons customers contact that process, and what would reduce them." },
