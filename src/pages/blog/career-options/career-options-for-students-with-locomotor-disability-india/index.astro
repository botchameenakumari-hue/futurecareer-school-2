const authorName = "Allu Vagdevi";
const authorUrl = "https://futurecareerschool.com/about/allu-vagdevi/";
const authorRole = "Career researcher and writer";

const faqItems = [
  {
    "q": "What are the best career options for students with locomotor disability in India?",
    "a": "There is no single best one. Software and data work, digital marketing, design and content, accounting, online teaching, your own service and customer support are routes where much of the work can be done at a desk or remotely. Choose by fit, access and proof of work."
  },
  {
    "q": "What help does CBSE give students with physical disabilities?",
    "a": "A CBSE circular of 24 January 2017 allows a scribe, compensatory time or both (60 minutes on a three-hour paper), the option of one compulsory language instead of two, and treats physiotherapy as equivalent to physical education. Apply through your school, preferably in Class IX or XI."
  },
  {
    "q": "Is there a reservation for locomotor disability in government jobs?",
    "a": "Yes. A DoPT order of 15 January 2018 reserves 1 percent of vacancies for locomotor disability, including cerebral palsy, leprosy cured, dwarfism, acid-attack victims and muscular dystrophy, within an overall 4 percent for benchmark disabilities. It applies only to posts identified as suitable."
  },
  {
    "q": "How much reservation is there in higher education?",
    "a": "The Act reserves 5 percent of seats in government and government-aided higher-education institutions for students with benchmark disabilities. Check each admission notice for the split and the certificate required."
  },
  {
    "q": "Can a person with locomotor disability study MBBS?",
    "a": "It is decided case by case. The Supreme Court said in October 2024 that a benchmark disability alone does not disqualify a candidate and that boards must record whether it prevents the course. The NMC's 2026 guidelines use a competency-based assessment. Read the current guidelines."
  },
  {
    "q": "Can I use a scribe in competitive exams?",
    "a": "A DEPwD memorandum of 10 August 2022 says a candidate with difficulty in writing may choose their own scribe or ask the exam body for one, and the Supreme Court held in February 2025 that denying a scribe is discrimination. Read the exam notice for the process."
  },
  {
    "q": "How accessible are Indian campuses and buses?",
    "a": "A Ministry of Social Justice and Empowerment document of 3 December 2022 reported 71 percent of government and aided schools as barrier-free and 5.73 percent of buses as fully accessible. Always visit and ask for the current access audit."
  },
  {
    "q": "Can wheelchair users work in IT?",
    "a": "Yes. Much IT work is desk-based, and many employers support remote or flexible set-ups. Check office access and commute for any role that needs you on site."
  },
  {
    "q": "Which careers should I avoid with a locomotor disability?",
    "a": "Avoid ruling fields in or out on assumption. Test roles with physical demands through shadowing and a short trial, and ask what adjustments exist."
  },
  {
    "q": "How do I get a disability certificate and UDID?",
    "a": "The main guide to career options for students with disabilities explains the certificate and UDID steps. Apply early, because many exam facilities need them."
  }
];

const faqJsonLd = {
