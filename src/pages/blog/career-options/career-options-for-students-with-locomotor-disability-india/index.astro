const seoTitle = "Career Options for Locomotor Disability and Wheelchair Users in India";
const description = "Career options for students with locomotor disability in India: access checks, CBSE and exam facilities, quotas and eight routes ranked by growth.";
const seoDescription = "Career options for locomotor disability and wheelchair users in India: access checks, exam facilities, quotas, eight routes.";
