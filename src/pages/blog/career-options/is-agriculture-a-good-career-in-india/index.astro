const aiComparison = {
  gold: [
    'Routine crop-monitoring tasks — satellite and drone-based yield estimation, pest and disease detection from images, and irrigation scheduling — are already handled by precision-farming platforms at scale, reducing the manual-scouting workload extension staff used to carry.',
