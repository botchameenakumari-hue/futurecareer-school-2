        <tr>
          <td data-label="Situation"><strong>Dropped from a squad</strong></td>
          <td data-label="Helpful response">Ask the coach for specific feedback and set one goal</td>
          <td data-label="Avoid">Quitting in anger</td>
        </tr>
        <tr>
          <td data-label="Situation"><strong>Poor match</strong></td>
          <td data-label="Helpful response">Write what went well and one thing to fix</td>
          <td data-label="Avoid">Dwelling for days</td>
        </tr>
        <tr>
          <td data-label="Situation"><strong>Injury layoff</strong></td>
          <td data-label="Helpful response">Follow medical advice and keep other fitness up</td>
          <td data-label="Avoid">Rushing back</td>
        </tr>
        <tr>
          <td data-label="Situation"><strong>Comparison with others</strong></td>
          <td data-label="Helpful response">Compare with your own last month</td>
          <td data-label="Avoid">Social media scrolling</td>
        </tr>
