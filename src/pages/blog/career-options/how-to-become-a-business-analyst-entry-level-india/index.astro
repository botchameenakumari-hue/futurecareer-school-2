---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'How to become a business analyst entry-level in India: what actually gets you hired';
const description =
  'How to become a business analyst entry-level in India: which degrees actually matter, which certification to skip until later, how to build proof with no BA job history, and how BA interviews really run.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/how-to-become-a-business-analyst-entry-level-india';
const publishedDateISO = '2026-07-21';
const publishedDateLabel = '21 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'already-decided', label: 'If you have not decided BA is the right fit yet' },
  { id: 'qualifications', label: 'What qualifications actually matter' },
  { id: 'certifications', label: 'Certifications worth it early vs later' },
  { id: 'proof-of-work', label: 'Build proof with no BA job history' },
  { id: 'mock-project', label: 'A mock project you can actually build' },
  { id: 'where-roles-exist', label: 'Where entry-level BA roles actually exist' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol' },
  { id: 'interview-prep', label: 'Interview prep specifics for BA roles' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'mistakes', label: 'Mistakes that stall entry-level BA candidates' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const qualificationRows = [
  {
    aspect: 'Degree background',
    detail:
      'Commerce, business administration, economics, and MBA graduates move in fastest, especially at consulting firms, banks, and large enterprises that recruit BAs directly from campus. But this is not a closed field — engineering graduates who prefer stakeholder-facing work over pure coding, and even science or arts graduates with strong communication and structured thinking, get hired regularly, especially in IT services.',
  },
  {
    aspect: 'Is a specific degree mandatory',
    detail:
      'No. Job postings for entry-level BA roles routinely accept "any graduate" alongside preferred fields. What most postings actually gate on is analytical thinking, MS Excel proficiency, communication skill, and some exposure to how a business process works — not the exact degree name on your certificate.',
  },
  {
    aspect: 'MBA — does it help',
    detail:
      'Yes, meaningfully, for speed of entry at consulting firms and larger enterprises that run campus BA hiring. But an MBA is not a requirement for every entry point — plenty of BAs enter through IT services or a junior operations role first and build the title over 1-2 years without ever doing an MBA.',
  },
  {
    aspect: 'Technical baseline expected',
    detail:
      'Employers now expect basic SQL, a documentation tool (Jira, Confluence), and comfort with a process-mapping tool (Visio or Lucidchart) even at entry level. You do not need to code, but "I only know Excel" is a weaker application than it was five years ago.',
  },
];

const certCards = [
  {
    label: 'Worth it early',
    title: 'IIBA ECBA (Entry Certificate in Business Analysis)',
    body:
      'ECBA is built specifically for people with no professional BA experience yet — there is no work-hour requirement to sit for it. It signals that you understand the BABOK vocabulary (requirements elicitation, stakeholder analysis, scope definition) before you have a job title to prove it. It will not replace a real project on your resume, but it is a legitimate way to show genuine intent when your resume otherwise has zero BA-labelled experience.',
  },
  {
    label: 'Not entry-level — skip for now',
    title: 'CBAP (Certified Business Analysis Professional)',
    body:
      'CBAP requires roughly 7,500 hours of documented, real business analysis work experience — that is several years into the role, not a fresher shortcut. Certified professionals do report meaningfully higher pay than non-certified peers, but that data describes experienced BAs, not people trying to land their first job. Chasing CBAP before you have a BA title is a wasted year of study aimed at the wrong gate.',
  },
  {
    label: 'Situational',
    title: 'Agile/Scrum credentials (CSPO, PSPO)',
    body:
      'Useful if the roles you are targeting sit inside Agile delivery teams, since a lot of entry-level BA work in product-adjacent companies runs through sprints and backlogs. Not universally necessary — an IT-services BA working on waterfall client projects may see less direct value from it than a BA aiming at a product company.',
  },
  {
    label: 'Overrated at entry level',
    title: 'Tool-only certificates with no project behind them',
    body:
      'A one-day certificate in Jira or Excel dashboards looks thin next to a real requirement document or process map you built yourself. Certification helps most when it sits behind a project, not instead of one.',
  },
];

const proofCards = [
  {
    label: 'Proof asset 1',
    title: 'A business requirement document (BRD) for a real, observable process',
    body:
      'Pick a process you can actually observe — a college club\'s event registration, a local shop\'s billing flow, a family business\'s order-to-delivery cycle. Write a BRD: current-state process, pain points, stakeholders, proposed future state, and clear, numbered requirements. This is the single most convincing proof-of-work asset for a first BA application because it is exactly the deliverable the job produces.',
  },
  {
    label: 'Proof asset 2',
    title: 'A current-state vs future-state process map',
    body:
      'Use a free tool like Lucidchart or diagrams.net to map how a process works today and how it should work after your proposed change. Employers reading a BA resume can evaluate this in thirty seconds — it proves you can turn a vague process into a structured visual, which is most of the job.',
  },
  {
    label: 'Proof asset 3',
    title: 'A set of user stories with acceptance criteria',
    body:
      'Take one requirement from your BRD and break it into 3-5 user stories written in the standard "As a [user], I want [goal], so that [benefit]" format, each with clear acceptance criteria. This shows you can translate a business need into something a development or operations team can actually build against.',
  },
  {
    label: 'Proof asset 4',
    title: 'A short stakeholder interview writeup',
    body:
      'Interview one real person — a shopkeeper, a small business owner, a college administrator, even a family member who runs something — about a problem in their workflow, and write up what you learned, what conflicting answers came up, and how you resolved the ambiguity. This directly demonstrates the hardest and most unteachable part of the job: extracting a clear requirement from a person who cannot articulate it clearly themselves.',
  },
];

const mockProjectSteps = [
  {
    number: '01',
    title: 'Pick a process with real friction, not a toy example',
    body:
      'Choose something with actual pain — a slow approval chain, a manual spreadsheet process, a confusing customer journey. A mock project on a genuinely annoying real-world process reads far stronger than a generic "e-commerce checkout" case study copied from a tutorial.',
  },
  {
    number: '02',
    title: 'Document the current state honestly, including the messy parts',
    body:
      'Map what actually happens today, including the workarounds and exceptions people use because the official process does not fully work. Interviewers can tell the difference between someone who observed a real process and someone who invented a clean, textbook one.',
  },
  {
    number: '03',
    title: 'Write the BRD and the user stories together',
    body:
      'Do not stop at the BRD. Convert at least one requirement into user stories with acceptance criteria, since that is the artifact BA-to-delivery-team handoff actually looks like, and it is what most interview case studies test directly.',
  },
  {
    number: '04',
    title: 'Add one measurable proposed outcome',
    body:
      'State what your proposed change should improve — fewer approval steps, shorter turnaround time, fewer data-entry errors — even as a rough estimate. A BA who cannot connect a requirement to a business outcome looks like a note-taker, not an analyst.',
  },
  {
    number: '05',
    title: 'Put it somewhere a recruiter can actually see it',
    body:
      'A simple document shared as a public link, a short write-up on LinkedIn, or a one-page PDF attached to your resume works. The proof does not need a fancy portfolio site — it needs to be findable and readable in under two minutes.',
  },
];

const whereRoleRows = [
  {
    sector: 'IT services and consulting',
    reality:
      'The single largest source of entry-level BA hiring in India. Roles here often carry titles like business systems analyst, functional consultant, or associate consultant, and typically sit between a client\'s business team and an internal development or delivery team. Domain exposure (banking, insurance, retail, healthcare projects) accumulates fast because these firms rotate analysts across client accounts.',
  },
  {
    sector: 'Banking and financial services',
    reality:
      'Banks and NBFCs hire BAs into roles tied to a specific product line — loans, cards, digital banking, compliance — and the work leans heavily on understanding regulation and internal process alongside requirement-gathering. Domain knowledge in banking compounds your value here faster than in most other sectors, but the entry bar for domain understanding is also higher.',
  },
  {
    sector: 'Product companies and startups',
    reality:
      'Fewer pure "business analyst" openings by title — this is where the role blends into product analyst or business systems analyst. Entry-level candidates usually need to already show SQL and dashboard comfort alongside requirement-gathering skill, because these companies expect a BA to be more self-sufficient with data than a large enterprise BA typically is.',
  },
  {
    sector: 'E-commerce, retail, and healthcare operations',
    reality:
      'Growing source of entry-level BA and process-analyst roles focused on operational efficiency — supply chain, fulfilment, claims processing. Less prestige-branded than banking or IT services, but often a faster route to real ownership of a process end to end as a fresher.',
  },
];

const checkpointItems = [
  {
    number: '01',
    title: 'Biology',
    body:
      'Business analysis rewards people who get energy from untangling what stakeholders actually mean underneath what they say, and who can sit through disagreement without needing an immediate clean answer.',
    note: 'If a meeting where three people describe the same problem three different ways sounds interesting rather than exhausting, that is a real signal.',
  },
  {
    number: '02',
    title: 'Context',
    body:
      'Fresher BA pay in India typically runs roughly Rs 3-5 LPA. Can your runway absorb that for a year or two while you build domain depth? Also check whether you have any realistic access to a live process, internship, or volunteer project to practice on — a BA portfolio is harder to build in total isolation than a purely technical one.',
    note: 'If you have zero access to any stakeholder-facing exposure right now, that is a practical constraint worth solving before you apply, not after.',
  },
  {
    number: '03',
    title: 'Market',
    body:
      'BA hiring at entry level is less standardised than a pure technical role — there is no single test everyone runs. It depends more on communication, a demonstrable requirement-gathering artifact, and some domain familiarity than on a repeatable technical filter.',
    note: 'That means your proof-of-work document often matters more than your degree name in getting past the first screen.',
  },
  {
    number: '04',
    title: 'Survival',
    body:
      'Generative AI tools already draft first-pass requirement documents and summarise stakeholder meetings. The safer entry-level position is becoming the person who can catch the requirement an AI-generated draft missed because you were actually in the room — not the person who only formats what a tool produced.',
    note: 'Treat AI tools as a first draft you correct, not a replacement for sitting in the actual conversation.',
  },
];

const interviewCards = [
  {
    label: 'Round 1',
    title: 'Screening call on communication and basic BA vocabulary',
    body:
      'Expect questions on what a BRD, user story, and stakeholder map are, plus a few "walk me through a time you resolved a misunderstanding" style behavioural questions. This round filters for clarity of speech and structured thinking more than technical depth.',
  },
  {
    label: 'Round 2',
    title: 'Case study or scenario exercise',
    body:
      'You will typically get a short, messy business situation and be asked to identify the real problem, the stakeholders, the assumptions, the risks, and a first-draft set of requirements or user stories. This is where your mock project practice pays off directly — the exercise format is close to what you built earlier.',
  },
  {
    label: 'Round 3',
    title: 'Technical or tool-familiarity check',
    body:
      'Increasingly common even at entry level: a light SQL question, a walkthrough of how you would document a requirement in Jira or Confluence, or a request to sketch a simple process map live. This round is usually easier to clear than it sounds if you have already practiced the mock project.',
  },
  {
    label: 'Round 4',
    title: 'Client-facing or stakeholder simulation',
    body:
      'Some firms, especially in IT services and consulting, run a role-play where you have to extract requirements from an interviewer playing a vague or difficult stakeholder. This tests exactly the skill your stakeholder-interview proof asset was built to demonstrate.',
  },
];

const gateItems = [
  {
    number: 'Gate 1',
    name: 'Entry gate',
    body: 'Do you have at least one real proof-of-work artifact — a BRD, a process map, or user stories — that you can talk through in detail, not just list on a resume?',
  },
  {
    number: 'Gate 2',
    name: 'Growth gate',
    body: 'Is the entry route you are targeting (IT services, banking, product) one that lets you build real domain depth over the first 1-2 years, not just repetitive documentation work?',
  },
  {
    number: 'Gate 3',
    name: 'Staying-power gate',
    body: 'Will you still want this work once the excitement of the "business analyst" title wears off and the daily reality is meetings, documentation, and reconciling disagreement?',
  },
];

const mistakeItems = [
  {
    number: '01',
    title: 'Studying for CBAP before you have a BA job',
    body:
      'CBAP needs roughly 7,500 hours of real BA experience to even sit for it. Spending months preparing for a credential you cannot yet qualify for is time better spent building one real proof-of-work document.',
  },
  {
    number: '02',
    title: 'Treating "any graduate" postings as a reason to skip building proof',
    body:
      'A broad degree requirement does not mean a low skill bar. It means the filter has moved from degree name to demonstrated communication and analytical thinking — which you still need to prove somehow.',
  },
  {
    number: '03',
    title: 'Submitting a resume with only tool certificates and no artifact',
    body:
      'A list of course certificates with no real BRD, process map, or user-story set behind them reads as passive learning, not applied skill. One real mock project beats three completed courses with nothing built.',
  },
  {
    number: '04',
    title: 'Ignoring domain knowledge because "BA skills transfer everywhere"',
    body:
      'The core BA skill does transfer across industries, but hiring managers in banking, healthcare, or insurance still weight candidates who show some understanding of that sector\'s specific processes and constraints. A generic mock project is fine to start; a domain-relevant one is stronger for a specific application.',
  },
  {
    number: '05',
    title: 'Preparing only for the case study round and skipping communication practice',
    body:
      'Technical case-study skill matters, but a meaningful share of BA interview time is spent on behavioural and communication assessment. Practising how you explain your mock project out loud, clearly and in under two minutes, is as important as the document itself.',
  },
];

const faqItems = [
  {
    question: 'How to become a business analyst entry-level in India with no experience?',
    answer:
      'Start by building at least one real proof-of-work artifact — a business requirement document, a process map, and a set of user stories for a real process you can observe. Pair that with an ECBA certification if you want extra signal, target IT services or banking for the widest entry-level hiring volume, and practice explaining your mock project clearly, since that is what most entry-level interviews actually test.',
  },
  {
    question: 'Do I need an MBA to become a business analyst in India?',
    answer:
      'No, but an MBA does open doors faster at consulting firms and large enterprises that run campus BA hiring. Commerce, business, and economics graduates also move in quickly, and a meaningful number of BAs enter through IT services or a junior operations role first, building the title over 1-2 years without an MBA.',
  },
  {
    question: 'Is CBAP worth it for someone trying to get their first BA job?',
    answer:
      'No, not yet. CBAP requires roughly 7,500 hours of documented business analysis work experience, which means it is designed for professionals several years into the field, not freshers. If you want a certification before your first job, ECBA is the entry-appropriate option — CBAP becomes worth pursuing only after you already hold a BA-titled role for a few years.',
  },
  {
    question: 'What is the best proof of work for an entry-level business analyst with no job history?',
    answer:
      'A business requirement document and a current-state vs future-state process map for a real, observable process — a college process, a family business, a local shop — is the strongest single asset, because it is exactly the deliverable the job produces. Adding a set of user stories with acceptance criteria and a short stakeholder-interview writeup makes the mock project cover most of what an interview case study will test.',
  },
  {
    question: 'Which sectors hire the most entry-level business analysts in India?',
    answer:
      'IT services and consulting firms hire the highest volume of entry-level BAs, often under titles like business systems analyst or associate consultant. Banking and financial services hire heavily into product-specific BA roles tied to regulation and process depth. Product companies and startups hire fewer pure BA titles and usually expect more self-sufficiency with data and tools even at entry level.',
  },
  {
    question: 'What does a business analyst interview actually test at entry level?',
    answer:
      'Most entry-level BA interviews combine a communication-focused screening round, a case study or scenario exercise where you identify problems, stakeholders, and requirements from a messy situation, a light technical or tool-familiarity check (SQL basics, Jira or Confluence, process mapping), and sometimes a stakeholder role-play that tests your ability to extract a clear requirement from a vague or difficult person.',
  },
  {
    question: 'How is this different from choosing between business analyst and data analyst as careers?',
    answer:
      'That is a separate, earlier decision. If you have not yet decided which of the two paths fits you, the business analyst vs data analyst career India comparison covers the daily-work, tools, salary, and long-term outcome differences between the two roles. This guide assumes you have already chosen business analyst and need the practical entry-level roadmap.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>How to become a business analyst entry-level in India comes down to four practical moves: prove you can gather and structure requirements even without a BA job title yet, skip the certifications that are not actually built for freshers, target the sectors that hire BAs in real volume, and prepare for an interview that tests communication and case-study thinking more than pure technical skill.</strong>
    None of this requires a specific degree. It requires evidence a hiring manager can actually see.
    Getting this sequence right is really about building a genuine <strong>high-income skill portfolio</strong> —
    requirement-gathering, structured communication, and stakeholder judgment — that moves you toward earlier
    financial freedom faster than a stack of certificates with nothing built behind them.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>No single degree is mandatory — commerce, business, and MBA backgrounds move fastest, but "any graduate" with strong communication and analytical thinking gets hired regularly, especially in IT services.</li>
      <li>ECBA is the entry-appropriate IIBA certification. CBAP needs roughly 7,500 hours of real BA work experience, so it is not a fresher credential — skip it until you already have a BA title.</li>
      <li>Build one real proof-of-work asset before you apply: a business requirement document and a process map for an observable real-world process, plus a set of user stories with acceptance criteria.</li>
      <li>IT services and consulting hire the highest volume of entry-level BAs; banking hires into product-specific roles with heavier domain depth; product companies expect more self-sufficiency with data even at entry level.</li>
      <li><strong>Run your entry plan through the 4-Checkpoint Protocol and the 3 Gates below before you commit months of study to the wrong preparation.</strong></li>
      <li>The scalable stack is domain knowledge plus AI-assisted analysis, process judgment, clear writing and speaking, stakeholder skill, and visible requirements or improvement proof. That can grow into product, consulting, operations, or specialist advisory work.</li>
    </ul>
  </div>

  <p>
    This guide sits inside <a href="/blog/career-options/">Career Options</a>, where you can find similar practical entry guides for other roles.
    If the decision pressure around this choice is real — a course deadline, an offer on the table, or family expectations pushing you a certain way —
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a> can help you weigh this specific move against your own situation instead of a generic checklist.
  </p>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Build your high-income skill portfolio with guidance</a>
    <a class="btn-outline cta-assessment-lite" href="https://futurecareerschool.com/services/assessments">Use a free assessment as a quick first check</a>
  </div>

  <section class="jump-nav" aria-labelledby="jump-nav-title">
    <p class="eyebrow">BA entry guide</p>
    <div class="jump-nav__top">
      <h2 id="jump-nav-title">What this guide covers</h2>
      <p>
        This is a practical entry-level roadmap for someone who has already decided business analyst is the target role and needs the qualifications, certifications, proof-of-work, hiring landscape, and interview reality that actually get you hired.
      </p>
    </div>
    <div class="jump-nav__grid">
      {jumpLinks.map((link) => (
        <a href={`#${link.id}`}>{link.label}</a>
      ))}
    </div>
  </section>

  <section id="short-answer">
    <p class="eyebrow">Reality first</p>
    <h2>The short answer to how to become a business analyst entry-level in India</h2>
    <p>
      There is no single certificate, degree, or course that hands you a business analyst job in India.
    </p>
    <p>
      What actually moves entry-level applications forward is narrower and more specific: a real artifact that proves you can gather a requirement and structure it clearly, applied toward the sectors that genuinely hire at your level.
    </p>
    <p>
      A commerce degree, an MBA, or even an engineering degree can all lead here.
    </p>
    <p>
      A certificate with nothing built behind it usually cannot.
    </p>

    <div class="callout callout--gold">
      <p class="callout__label">Honest take</p>
      <p>
        Most entry-level BA rejections do not happen because of the wrong degree. They happen because the resume has no evidence the person can actually do the core task — turning a vague ask into a clear, structured requirement.
      </p>
    </div>
  </section>

  <section id="already-decided">
    <p class="eyebrow">Before you go further</p>
    <h2>If you have not decided BA is the right fit yet</h2>
    <p>
      This guide assumes you already know you want business analysis specifically, not that you are still comparing it against a similar-sounding role.
    </p>
    <p>
      If you are still weighing business analyst against data analyst — the daily work, the tools, the entry-level salary bands, and where each path leads by the senior level — that is a different, earlier decision.
    </p>
    <p>
      The <a href="/blog/skills/business-analyst-vs-data-analyst-career-india/">business analyst vs data analyst career India comparison</a> covers that fit question directly.
    </p>
    <p>
      Come back here once you know business analysis is the lane you want, and this guide will walk you through the practical entry mechanics.
    </p>
  </section>

  <section id="qualifications">
    <p class="eyebrow">Entry filter</p>
    <h2>What qualifications actually matter for entry-level business analyst roles</h2>
    <p>
      Job postings for entry-level BA roles in India are wider on degree requirements than most students assume.
    </p>
    <p>
      The real filter has moved toward demonstrated communication, analytical thinking, and a working understanding of business process — not a specific major.
    </p>

    <div class="table-wrap">
      <table class="paths-table">
        <thead>
          <tr>
            <th>Aspect</th>
            <th>What actually matters</th>
          </tr>
        </thead>
        <tbody>
          {qualificationRows.map((row) => (
            <tr>
              <td data-label="Aspect"><strong>{row.aspect}</strong></td>
              <td data-label="What actually matters">{row.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note-line">
      Employers openly accept graduates from any field for junior BA roles. What separates a shortlisted resume from a rejected one is usually evidence, not the degree title.
    </p>
  </section>

  <section id="certifications">
    <p class="eyebrow">Credential clarity</p>
    <h2>Certifications worth it early vs later</h2>
    <p>
      One of the most common mistakes freshers make is picking the wrong certification for their stage.
    </p>
    <p>
      CBAP gets recommended constantly online because certified professionals genuinely do earn more. But CBAP is not built for freshers — it requires roughly 7,500 hours of documented, real business analysis experience before you can even sit the exam, which is years into the role, not a starting point.
    </p>
    <p>
      ECBA exists specifically for people without professional BA experience yet, which makes it the entry-appropriate credential if you want a certification at all before your first job.
    </p>

    <div class="reality-grid">
      {certCards.map((card) => (
        <article class="reality-card">
          <p class="mini-label">{card.label}</p>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>

    <div class="callout callout--teal">
      <p class="callout__label">What this means</p>
      <p>
        Skip CBAP until you already have a BA title. If you want a credential now, ECBA plus a real proof-of-work document beats either one alone.
      </p>
    </div>
  </section>

  <section id="proof-of-work">
    <p class="eyebrow">Get evidence</p>
    <h2>Build BA-relevant proof of work without prior BA experience</h2>
    <p>
      This is the part most entry-level guides skip, and it is the part that actually decides whether your resume clears the first screen.
    </p>
    <p>
      You do not need a real BA job to produce a real BA artifact. You need a real process to document.
    </p>

    <div class="skills-grid">
      {proofCards.map((card) => (
        <article class="skill-card">
          <p class="mini-label">{card.label}</p>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>

    <div class="highlight-box highlight-box--teal">
      <p>
        A simple rule helps here.
      </p>
      <p>
        Pick one real process, document it fully, and show it clearly.
      </p>
      <p>
        That single asset, explained well, beats a resume full of course completions with nothing built.
      </p>
    </div>

    <p>
      This is the actual building block of a high-income skill portfolio in this field: not the certificate,
      but requirement-gathering proof a hiring manager can read and question in under two minutes. That proof
      is what compounds into faster offers and better pay over the next few years, not the degree name on
      your resume.
    </p>
  </section>

  <section id="mock-project">
    <p class="eyebrow">Build it</p>
    <h2>A mock project you can actually build, step by step</h2>
    <p>
      A mock project sounds abstract until you break it into a sequence. Here is a realistic build order.
    </p>

    <div class="protocol-stack">
      {mockProjectSteps.map((step) => (
        <article class="checkpoint">
          <div class="checkpoint__num">{step.number}</div>
          <div class="checkpoint__body">
            <h3 class="checkpoint__title">{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="note-line">
      This does not need to be perfect or polished. It needs to be real, honest about the messy parts, and yours — interviewers can tell the difference between an observed process and an invented textbook one.
    </p>
  </section>

  <section id="where-roles-exist">
    <p class="eyebrow">Hiring landscape</p>
    <h2>Where entry-level business analyst roles actually exist</h2>
    <p>
      Not every sector hires BAs the same way, and knowing where the volume actually is saves you from applying into the wrong pool.
    </p>

    <div class="table-wrap">
      <table class="paths-table">
        <thead>
          <tr>
            <th>Sector</th>
            <th>Hiring reality</th>
          </tr>
        </thead>
        <tbody>
          {whereRoleRows.map((row) => (
            <tr>
              <td data-label="Sector"><strong>{row.sector}</strong></td>
              <td data-label="Hiring reality">{row.reality}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note-line">
      IT services and banking together account for most entry-level BA hiring volume in India. Product companies hire fewer pure BA titles but often pay better once you clear the higher self-sufficiency bar they expect.
    </p>
  </section>

  <section id="checkpoint">
    <p class="eyebrow">Decision framework</p>
    <h2>The 4-Checkpoint Protocol before you commit months to BA prep</h2>
    <p>
      If you are unsure whether to invest real time in this route, run it through the same filter used across other career decisions on this site.
    </p>
    <p>
      That filter is <strong>The 4-Checkpoint Protocol</strong>.
    </p>

    <div class="protocol-stack">
      {checkpointItems.map((item) => (
        <article class="checkpoint">
