const checkpointItems = [
  {
    num: '01',
    title: 'Fit',
    body: 'Can you handle the daily reality of this track — heads-down building versus infra firefighting versus stakeholder meetings versus long research cycles?',
    note: 'Do not choose a track whose actual daily work you already know you would hate.',
  },
  {
    num: '02',
