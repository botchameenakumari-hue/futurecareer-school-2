const mistakeItems = [
  { num: '01', title: 'Defaulting to "software developer" because it\'s the only track anyone described', body: 'It is the largest track, not the only one. Skipping the rest of this map because nobody showed it to you is an expensive accident, not a decision.' },
  { num: '02', title: 'Chasing the biggest number on a salary chart without checking the earlier gate', body: 'Quant pay looks incredible on a chart. It means very little if you have not honestly checked whether you can clear either of its two competitive stages.' },
  { num: '03', title: 'Treating "I know how to code" as a complete answer', body: 'On its own, that sentence describes a very large and growing pool of people. What you built, shipped, and can explain is the actual differentiator now.' },
