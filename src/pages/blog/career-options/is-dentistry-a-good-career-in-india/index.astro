const title = 'Is Dentistry a Good Career in India? NEET Cutoff, Oversupply, Real Pay';
const description =
  'Is dentistry a good career in India? The honest NEET-BDS-vs-MBBS cutoff gap, the real dental college oversupply, MDS competition, and what BDS graduates actually earn.';
const canonical = 'https://futurecareerschool.com/blog/career-options/is-dentistry-a-good-career-in-india';
const publishedDateISO = '2026-08-17';
const publishedDateLabel = '17 August 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'neet-cutoff', label: 'The NEET cutoff gap nobody says out loud' },
  { id: 'oversupply', label: 'The dental college oversupply problem' },
  { id: 'training-path', label: 'The BDS training path, start to registration' },
