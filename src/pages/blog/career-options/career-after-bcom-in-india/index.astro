    note: 'BCom graduates with 55%+ marks get direct entry into CS Executive, skipping Foundation and saving real time versus a non-graduate starting from scratch.',
  },
  {
    path: 'CMA (post-qualification)',
    range: 'Rs 7-10 LPA typical entry in costing and manufacturing-finance roles',
    note: 'BCom graduates go straight into CMA Intermediate without a Foundation exam, cutting the route to roughly 2.5-3 years post-graduation.',
  },
  {
    path: 'MBA (strong institute, post-BCom)',
    range: 'Rs 8-18 LPA at good private B-schools, considerably higher at top-tier IIMs',
    note: 'The institute and specialisation matter more than the MBA label itself; a weak-institute MBA on loan rarely justifies the cost inside three years.',
  },
  {
    path: 'Digital marketing (fresher to 2-3 years)',
    range: 'Rs 3.5-6 LPA in-house; freelance income can scale well beyond this with client depth',
    note: 'Portfolio of real, results-linked campaigns matters far more here than a certificate stack.',
  },
];

const recruiterRows = [
