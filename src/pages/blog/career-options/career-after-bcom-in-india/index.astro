    num: 'Gate 3',
    title: 'Proof of value',
    body: 'Show your mock attempt, dashboard, or campaign plan to someone already working in that lane — a working CA article, a bank PO, or a business analyst — and ask what is genuinely missing.',
  },
];

const salaryRows = [
  {
    path: 'First job straight after BCom (accountant, audit associate, process associate)',
    range: 'Rs 2.5-4.5 LPA',
    note: 'The most common outcome for a fresh BCom graduate with no further certification. College reputation, city, and basic tool skill (Tally, GST, Excel) shift this range more than the degree itself.',
