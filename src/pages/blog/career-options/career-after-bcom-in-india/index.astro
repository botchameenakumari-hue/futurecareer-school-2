    path: 'Business analyst or data analyst (fresher, with SQL/Power BI/Python)',
    range: 'Rs 3.5-7 LPA',
    note: 'Commerce graduates with demonstrated tool skill and one real project regularly beat generic-degree candidates who only list "Excel" on a resume.',
  },
  {
    path: 'Bank PO (IBPS/SBI, post-selection)',
    range: 'Roughly Rs 8-9 LPA CTC including allowances at PSU banks',
    note: 'IBPS PO 2026 notified 6,715 vacancies and SBI PO notified 1,500 vacancies; the exam is open to graduates of any stream, so competition is wide, not commerce-only.',
  },
  {
    path: 'SSC CGL, Income Tax Inspector track',
    range: 'Roughly Rs 65,000-75,000 in-hand per month in metro postings',
    note: 'Pay Level-7 under the 7th Pay Commission; SSC CGL 2026 notified 12,256 vacancies across posts, open to any graduate, not commerce-specific.',
  },
  {
    path: 'CA (post-qualification, first job)',
    range: 'Rs 7-12 LPA typical for Big Four or large corporates, higher at top firms',
