---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Career in content writing vs copywriting India: the honest pay-and-fit comparison';
const description =
  'Career in content writing vs copywriting India compared on real pay, entry path, freelance vs in-house patterns, and how AI is squeezing each differently in 2026.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/content-writing-vs-copywriting-career-india';
const publishedDateISO = '2026-07-14';
const publishedDateLabel = '14 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-the-work-is', label: 'What the daily work actually looks like' },
  { id: 'entry-path', label: 'Entry path: courses, portfolio, and first break' },
  { id: 'employers', label: 'Who actually hires for each' },
  { id: 'salary-reality', label: 'Salary reality: fresher to senior' },
  { id: 'freelance-vs-inhouse', label: 'Freelance vs in-house: two different money games' },
  { id: 'skill-overlap', label: 'Skill overlap and where they split' },
  { id: 'ai-impact', label: 'How AI is squeezing each, differently' },
  { id: 'checkpoint', label: 'The 4-Checkpoint Protocol for this decision' },
  { id: 'who-fits-content', label: 'Who genuinely fits content writing' },
  { id: 'who-fits-copy', label: 'Who genuinely fits copywriting' },
  { id: 'hybrid-paths', label: 'The hybrid roles nobody mentions' },
  { id: 'gates', label: 'The 3 Gates before you commit' },
  { id: 'switching-later', label: 'Can you switch between them later?' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const workRows = [
  {
    aspect: 'Core daily task',
    content: 'Research a topic in depth, then write a blog, guide, or article of 800-2,500+ words that informs, teaches, or builds trust with a reader over the length of the piece.',
    copy: 'Compress a product or offer into a headline, a landing page, an email, or an ad that gets one specific reaction — a click, a sign-up, a purchase — usually in far fewer words.',
  },
  {
    aspect: 'Where the day gets hard',
    content: 'A technical topic needs three rounds of research to get right, a keyword brief changes mid-draft, or a generic AI-drafted competitor article is already ranking for the exact same query.',
    copy: 'A client rejects five headline options in a row, an A/B test proves your favourite line actually lost, or a launch date set by someone else does not move no matter how unfinished the copy is.',
  },
  {
    aspect: 'Who you answer to',
    content: 'A content or marketing manager, an SEO lead, and an editorial calendar — success is measured by traffic, rankings, and time-on-page.',
    copy: 'A creative director, a brand manager, or a founder who wants the piece to sell — success is measured by click-through rate, conversion rate, and revenue, not readability alone.',
  },
  {
    aspect: 'Main output',
    content: 'Blog posts, long-form guides, whitepapers, case studies, newsletters, and product/knowledge-base content — usually unbylined or lightly credited inside a brand\'s content library.',
    copy: 'Ad headlines, landing pages, email sequences, taglines, sales pages, and social ad copy — short-form work built to be tested, split-run, and swapped out fast.',
  },
  {
    aspect: 'Where the ceiling comes from',
    content: 'Deep niche expertise (SaaS, fintech, healthcare), SEO and content-strategy skill, and the move from writer to content strategist or head of content.',
    copy: 'Persuasion craft that actually moves a metric, ownership of a brand\'s voice across campaigns, and the agency track from copywriter to senior copywriter to creative director.',
  },
];

const entryRows = [
  {
    route: 'Formal degree or course',
    content: 'No degree is required in most job listings. English, journalism, or mass communication degrees are treated as a plus, not a gate — a portfolio matters far more than the college name.',
    copy: 'Also no mandatory degree, but short, craft-specific courses (ad-school style programmes, copywriting bootcamps, MICA-style communications diplomas) give a genuinely faster route into agency hiring pools than a general degree does.',
  },
  {
    route: 'Portfolio expected before you get hired',
    content: '3-5 sample blog posts or a live portfolio/personal blog. You can create your own samples — no published clips required.',
    copy: 'A "book" of concept ads, headlines, and campaign ideas — often self-initiated spec work for real or fictional brands. Agencies hire almost entirely on the strength of this book, not on your resume.',
  },
  {
    route: 'Time to first paid assignment',
    content: 'Can start earning within weeks through freelance platforms, cold outreach to small businesses, or agency internships.',
    copy: 'Similar timeline for freelance micro-projects, but the more common route — a junior copywriter role at an agency — usually needs a stronger, more polished book and a portfolio review before the first paid role lands.',
  },
  {
    route: 'Gatekeeping and competition',
    content: 'Low barrier to entry means heavy competition for basic writing gigs at the bottom of the market, but far less competition for anyone who builds real subject-matter depth.',
    copy: 'Fewer large ad agencies exist compared to the number of companies that need blog content, so competition for well-known agency seats is sharper — but direct-to-brand freelance copywriting (landing pages, email funnels) has grown fast and needs no agency at all.',
  },
];

const employerRows = [
  {
    segment: 'Where content writers get hired',
    detail: 'Marketing agencies, SaaS and product companies, e-commerce brands, ed-tech firms, healthcare and fintech companies, and in-house marketing teams across nearly every industry. Content writing is a horizontal skill needed by almost any company with a website, so the employer pool is wide and spread out.',
  },
  {
    segment: 'Where copywriters get hired',
    detail: 'Creative and digital advertising agencies, brand and performance-marketing teams inside companies, D2C e-commerce brands running paid campaigns, and email/CRM marketing teams. The employer pool is narrower and more concentrated around agencies and brands that run active campaigns, not every company with a blog.',
  },
  {
    segment: 'Freelance and gig platforms',
    detail: 'Content writing has a mature, high-volume freelance market on Upwork, Fiverr, and direct client outreach, with over 15 million Indians earning some income through freelance work as of 2026. Copywriting freelance work is more project- and retainer-based — landing pages, email sequences, sales funnels — with fewer total gigs but a meaningfully higher per-project ceiling for anyone who can prove conversion results.',
  },
];

const salaryRows = [
  {
    stage: 'Fresher, 0-1 years',
    content: 'Roughly Rs 2.5-4.5 LPA at agencies and startups, often paid as Rs 15,000-22,000 a month; niche B2B or SaaS content roles can start higher for candidates with a strong writing sample.',
    copy: 'Roughly Rs 3-5 LPA at agencies for a junior copywriter role; entry-level pay depends heavily on the agency\'s size and client roster more than on the candidate\'s degree.',
  },
  {
    stage: '2-4 years experience',
    content: 'Rs 4-7 LPA on average; writers who specialise in a paying niche such as B2B SaaS, fintech, or technical documentation can reach Rs 6-18 LPA, well ahead of generalist writers at the same experience level.',
    copy: 'Rs 5-9 LPA for a mid-level agency copywriter taking on more creative input and client-facing responsibility; freelance conversion copywriters at this stage who can prove results often out-earn their agency-employed peers.',
  },
  {
    stage: '5+ years, senior',
    content: 'Senior content strategists and heads of content at product companies typically earn Rs 10-20 LPA, with niche specialists and AI-augmented senior writers commanding a further 20-35% premium over generalists.',
    copy: 'Senior copywriters and associate creative directors typically earn Rs 9-18 LPA and up, leading campaigns and shaping brand voice; creative directors sit meaningfully higher still, though openings at that level are limited to a small number of top agencies.',
  },
  {
    stage: 'Typical pay pattern',
    content: 'Mixed. Many content writers combine a salaried role with freelance projects, or work entirely on a freelance/retainer basis once they have a client base.',
    copy: 'Also mixed, but with a wider spread: in-house and agency copywriters are usually salaried, while freelance direct-response copywriters working on launches or funnels can charge project fees or day rates (roughly Rs 3,200-18,200 a day, depending on experience and niche) well above typical per-piece content rates.',
  },
];

const freelanceGrid = [
  {
    label: 'Content writing',
    title: 'A wider gig market — but a compressed per-piece rate',
    body: 'Content writing has the larger, more mature freelance market: blog posts, SEO articles, and product descriptions are outsourced constantly on Upwork, Fiverr, and through agency subcontracting. That volume is exactly where AI-assisted drafting has applied the most price pressure, so the per-piece rate for generic, undifferentiated content writing has been squeezed hardest — while writers with a real niche keep pricing power.',
  },
  {
    label: 'Copywriting',
    title: 'Fewer freelance gigs — but a much higher per-project ceiling',
    body: 'Agencies and brands tend to prefer in-house or long-retained freelance copywriters for consistency of voice across a campaign, so there are fewer one-off copywriting gigs floating around on generic freelance marketplaces. But when a copywriter can show a landing page or email sequence that measurably lifted conversions, that proof commands day rates and project fees well above what most content-writing gigs pay for comparable time.',
  },
];

const skillOverlapItems = [
  {
    label: 'Shared skill',
    title: 'Research and audience understanding',
    body: 'Both careers demand the ability to understand who is reading and what they actually need to hear, then build the piece around that — not around what the writer finds interesting to write.',
  },
  {
    label: 'Shared skill',
    title: 'Ruthless editing discipline',
    body: 'Cutting anything that does not serve the reader or the goal. A content writer and a copywriter are graded on the same core editing instinct, even though the acceptable length looks completely different.',
  },
  {
    label: 'Content-writing-specific',
    title: 'SEO and long-form structuring',
    body: 'Writing for a keyword and search intent, structuring a piece with headings a reader and a search engine can both follow, and sustaining a reader\'s attention across 1,500+ words. Copywriting rarely trains this muscle directly.',
  },
  {
    label: 'Copywriting-specific',
    title: 'Persuasion psychology and voice compression',
    body: 'Saying more in fewer words, building a hook in one line, and understanding the psychological trigger — urgency, social proof, fear of missing out — that actually moves someone to act. Content writing rarely demands this level of compression.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Biology',
    body: 'Content writing rewards people who get energy from deep, quiet research and building a long piece over hours or days. Copywriting rewards people who get energy from tight constraints, fast iteration, and pitching multiple options knowing most will get rejected.',
    note: 'If getting a headline rejected five times in a row sounds like a fun puzzle rather than a discouraging loop, that is a real signal toward copywriting.',
  },
  {
    num: '02',
    title: 'Context',
    body: 'Content writing usually lets you start earning something within weeks through freelance work, even if early income is inconsistent. Copywriting\'s more common route — a junior agency role — often needs a stronger, more polished portfolio built over a longer unpaid or low-paid stretch before the first real offer.',
    note: 'If your runway is tight, content writing\'s faster path to first income is a real practical advantage, not just a smaller ambition.',
  },
  {
    num: '03',
    title: 'Market',
    body: 'Content writing has a much wider, horizontal employer base but a large share of gig work at the bottom that AI has already commoditised. Copywriting has a narrower, more concentrated employer base, but the work that survives AI pressure — brand strategy and conversion-tested campaigns — pays a real premium.',
    note: 'A wider market (content writing) is not automatically the higher-paying one — read the salary and freelance sections above before assuming the bigger market wins.',
  },
  {
    num: '04',
    title: 'Survival',
    body: 'AI is pressuring both fields at their easiest layer. In content writing, that means routine, templated, keyword-stuffed blog posts a generic AI tool can now draft in seconds. In copywriting, that means templated ad variations, generic product descriptions, and basic email subject lines. In both, the safer position is the person who owns strategy, brand judgment, or a tested result an AI tool cannot claim credit for.',
    note: 'The real question is not "will AI take this job." It is "which part of this specific role still needs a human to own the strategic or persuasive judgment call."',
  },
];

const contentFitItems = [
  {
    label: 'Genuine fit',
    title: 'You enjoy going deep on one topic for hours',
    body: 'You would rather spend a full day understanding a complex subject well enough to explain it clearly than switch between five unrelated briefs in an afternoon. Content writing rewards sustained, patient research.',
  },
  {
    label: 'Genuine fit',
    title: 'You want a steadier, more predictable writing process',
    body: 'A content calendar, a brief, and a deadline you can usually negotiate suits you more than a launch date fixed by someone else\'s campaign timeline.',
  },
  {
    label: 'Genuine fit',
    title: 'You want to become known for what you know, not just how you write',
    body: 'Building real expertise in one niche — SaaS, fintech, health — appeals to you more than mastering the general craft of persuasion across many industries.',
  },
];

const copyFitItems = [
  {
    label: 'Genuine fit',
    title: 'You like working inside tight constraints',
    body: 'Fitting an entire idea into a six-word headline or a 40-character subject line feels like a fun puzzle to you, not a frustrating limitation.',
  },
  {
    label: 'Genuine fit',
    title: 'You can handle rejection without taking it personally',
    body: 'Pitching ten headline options and watching a creative director pick a completely different one — or watching an A/B test kill your favourite line — does not shake your confidence in the next attempt.',
  },
  {
    label: 'Genuine fit',
    title: 'You care more about what works than what sounds clever',
    body: 'You would rather ship the boring line that converts than the witty line that gets applause in the meeting and no clicks in the data. That instinct is hard to fake in a portfolio review.',
  },
];

const hybridItems = [
  {
    num: '01',
    title: 'Conversion copywriter / content-led copywriter for SaaS',
    body: 'Writes long-form educational content and the short, persuasive calls-to-action, landing pages, and email nurture sequences that sit around it — a growing, well-paid hybrid role at product companies that need both trust-building and conversion.',
  },
  {
    num: '02',
    title: 'Brand content writer at D2C companies',
    body: 'Writes both blog and educational content and product/ad copy for the same brand, since smaller D2C teams often cannot afford to hire a separate content writer and copywriter and need one person who can do both credibly.',
  },
  {
    num: '03',
    title: 'UX writer / product copywriter',
    body: 'Writes the microcopy inside an app or website — button labels, error messages, onboarding flows — which blends content writing\'s clarity discipline with copywriting\'s persuasion and compression skill, and is one of the fastest-growing writing-adjacent roles in Indian product teams.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Picking content writing only because "it seems easier to start," without building a real niche',
    body: 'Generic content writing is exactly the layer AI tools have commoditised fastest. Writers who stay generalists compete on price against AI-assisted output; writers who build depth in one paying niche keep real pricing power.',
  },
  {
    num: '02',
    title: 'Picking copywriting only for the "creative agency" glamour, without checking the actual rejection rate',
    body: 'Agency copywriting looks appealing from the outside, but the day-to-day reality involves far more rejected drafts than published campaigns. Talk to a working copywriter about how many concepts get killed before one ships, not just about the awards.',
  },
  {
    num: '03',
    title: 'Assuming a mass communication or advertising degree alone guarantees a hire',
    body: 'Both fields hire almost entirely on portfolio strength. Build real samples during your degree or alongside a job, not after you graduate and expect the degree to open the door on its own.',
  },
  {
    num: '04',
    title: 'Treating freelance income in either field as guaranteed because "freelancing is flexible"',
    body: 'Flexible does not mean stable. Freelance content income can swing from roughly Rs 25,000 to Rs 2 lakh a month depending on niche and client base; freelance copywriting income depends even more heavily on landing a small number of high-value retainer clients rather than many small gigs.',
  },
  {
    num: '05',
    title: 'Ignoring how differently AI is hitting each field',
    body: 'A 2026 industry survey of over 1,100 content firms and freelance writers called generative AI the most disruptive shift the content-writing industry has faced, with routine SEO writing declining fastest. Copywriting is not immune — templated ad variants and generic product descriptions face the same pressure — but strategy-heavy, brand-voice, and tested-conversion copy has held its value better than generic blog writing has.',
  },
];

const faqItems = [
  {
    q: 'Career in content writing vs copywriting India: which pays more?',
    a: 'It depends on the stage and the niche, not the label alone. At entry level they are close: content writers typically start at Rs 2.5-4.5 LPA and copywriters at Rs 3-5 LPA. Past 2-4 years, a content writer who builds a paying niche (SaaS, fintech, technical documentation) can reach Rs 6-18 LPA, roughly matching or beating a generalist copywriter\'s Rs 5-9 LPA. At the senior end, copywriting\'s agency ladder (senior copywriter to associate creative director to creative director) can outpace content writing\'s ladder for the small number of people who reach it, but content strategy and head-of-content roles at Rs 10-20 LPA are a more realistic senior ceiling for most content writers.',
  },
  {
    q: 'Which is easier to break into, content writing or copywriting, in India?',
    a: 'Content writing has a lower barrier to entry — no formal degree, freelance platforms that let you start earning within weeks, and a much wider pool of employers who need blog content. Copywriting\'s more common route, a junior agency role, usually needs a more polished portfolio ("book") built over a longer unpaid or low-paid stretch, since agencies are more concentrated and competitive than the broad market for content writers.',
  },
  {
    q: 'Do I need a specific degree for content writing or copywriting in India?',
    a: 'No degree is mandatory for either. English, journalism, or mass communication degrees help but are treated as a plus, not a gate — both fields hire almost entirely on the strength of a portfolio. Short, craft-specific copywriting courses can genuinely speed up agency hiring for copywriting specifically, more than a general degree does.',
  },
  {
    q: 'Is freelancing more realistic in content writing or copywriting?',
    a: 'Content writing has the larger, more mature freelance market — a much bigger volume of gigs on platforms like Upwork and Fiverr, part of a freelance economy that includes over 15 million Indians earning some freelance income as of 2026. Copywriting has fewer total freelance gigs but a meaningfully higher per-project ceiling: a freelance copywriter who can prove a landing page or email sequence lifted conversions can charge day rates or project fees well above typical content-writing rates.',
  },
  {
    q: 'Can a content writer become a copywriter later, or the reverse?',
    a: 'Yes, and the switch happens in both directions. Content writers moving into copywriting usually need to build a concept-driven portfolio of short, persuasive work, since agencies hire on creative craft and compression, not long-form samples. Copywriters moving into content writing usually need to build SEO fluency and the patience for longer research cycles, since their persuasion instincts transfer well but the long-form writing muscle needs separate practice.',
  },
  {
    q: 'Is AI going to replace content writers or copywriters first?',
    a: 'Neither is being replaced wholesale, but the easy, templated layer is shrinking fastest in content writing. A 2026 survey of over 1,100 content firms and freelance writers named generative AI the most disruptive shift the content-writing industry has faced, with routine, keyword-driven SEO articles declining in demand while new roles like AI content strategist and AI editor grow. Copywriting faces the same pressure on templated ad variants and generic product descriptions, but strategy-heavy, brand-voice, and conversion-tested campaign work has proven harder for generic AI tools to replicate convincingly.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Career in content writing vs copywriting India comes down to one honest split: content writing gives
    you a wider, faster-to-enter market and a huge freelance base, but its templated, keyword-driven bottom
    layer is exactly where AI has hit hardest; copywriting gives you a narrower, more competitive entry but a
    higher per-project ceiling once you can prove your words move a metric, not just read well.</strong>
    "Writer" sounds like one career here, but it is two genuinely different jobs with different daily work,
    different pay curves, and different AI exposure. Choosing between them with real numbers instead of
    guesswork — and building a genuine, provable <strong>skill portfolio</strong> in whichever lane fits — is
    what actually moves you toward stronger income and earlier financial freedom.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Entry pay is close: roughly Rs 2.5-4.5 LPA for content writing, Rs 3-5 LPA for copywriting at agencies.</li>
      <li>Content writing has the wider employer base and a much bigger freelance market (part of a freelance economy over 15 million Indians participate in), but generic, templated blog work is the layer AI has commoditised fastest.</li>
      <li>Copywriting has fewer entry points but a higher per-project ceiling for proven conversion work — freelance day rates can run Rs 3,200-18,200 depending on experience and niche.</li>
      <li>Content writers who build a paying niche (SaaS, fintech, technical writing) can reach Rs 6-18 LPA past 2-4 years, matching or beating generalist copywriters at the same stage.</li>
      <li><strong>The generalist version of either job is the one losing pricing power to AI. Niche depth in content writing and proven persuasion results in copywriting are what still command real pay.</strong></li>
      <li>Test your actual fit with one real long-form piece and one real short persuasive piece before committing months to either lane.</li>
      <li>Either path needs more than language: add domain depth, AI-assisted research and editing, audience judgment, client communication, distribution, and proof of traffic, trust, leads, or sales. That stack creates consulting, freelance, content-product, or agency leverage.</li>
    </ul>
  </div>

  <p>
    If you are still comparing this against other writing-adjacent or career-options paths, browse more
    <a href="/blog/career-options/">career options guides</a> before narrowing down to writing-based work
    specifically.
  </p>

  <p>
    If you want a second opinion on which of these actually fits how you think and work, a session with
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you weigh the trade-offs against your specific situation, income timeline, and family runway.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer to content writing vs copywriting career India</h2>

  <p>
    Most comparison articles treat "writer" as one job. It is not — content writing and copywriting sit on
    opposite ends of the same craft, and the split shows up in almost every practical decision you will make
    about this career.
  </p>

  <p>
    Content writing wins on a lower barrier to entry, a wider employer base, and a much bigger freelance market
    to start earning from quickly — but the generic, keyword-driven layer of that market is exactly where
    generative AI has applied the most price pressure since 2025.
  </p>

  <p>
    Copywriting wins on a higher per-project ceiling once you can prove your words move a real number — clicks,
    sign-ups, sales — but the more common entry route (an agency job) is more competitive, and the portfolio bar
    is steeper before your first real paid role.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Both fields get sold on the wrong pitch. Content writing gets marketed as "easy money working from
      anywhere," which undersells how brutal the price competition has become for anyone who stays a
      generalist churning out generic blog posts. Copywriting gets marketed as "creative glamour at an ad
      agency," which undersells how many concepts get rejected for every one that ships, and how much of the
      real market is now quiet, unglamorous conversion copy for D2C brands, not award-winning campaigns. The
      honest answer sits in the specific niche and specific proof you build, not the job title on your resume.
    </p>
  </div>

  <h2 id="what-the-work-is">What the daily work actually looks like in each career</h2>

  <p>
    Comparing content writing and copywriting by the word "writer" hides how differently the actual day plays
    out in each one.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Aspect of the work</th>
          <th>Content writing</th>
          <th>Copywriting</th>
        </tr>
      </thead>
      <tbody>
        {workRows.map((item) => (
          <tr>
            <td data-label="Aspect of the work"><strong>{item.aspect}</strong></td>
            <td data-label="Content writing">{item.content}</td>
            <td data-label="Copywriting">{item.copy}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    Notice the real split is not "who is the better writer." It is length, purpose, and what you are being
    graded on — informing and building trust over time in content writing, versus getting one specific reaction
    right now in copywriting — and that single difference shapes almost everything else about each career.
  </p>

  <h2 id="entry-path">Entry path: courses, portfolio, and your first break</h2>

  <p>
    Both fields skip the formal-degree gate that many careers still enforce, but they differ sharply in what
    actually gets you hired.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Entry factor</th>
          <th>Content writing</th>
          <th>Copywriting</th>
        </tr>
      </thead>
      <tbody>
        {entryRows.map((item) => (
          <tr>
            <td data-label="Entry factor"><strong>{item.route}</strong></td>
            <td data-label="Content writing">{item.content}</td>
            <td data-label="Copywriting">{item.copy}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A blog post you wrote for practice is a real content-writing sample the moment it exists. A copywriting
      "book" needs more deliberate construction — concept ads for brands you have never worked with, built
      purely to demonstrate craft — because agencies are judging your ability to sell an idea, not just your
      ability to string sentences together. That is a real, avoidable reason copywriting portfolios take
      longer to build.
    </p>
  </div>

  <h2 id="employers">Who actually hires for each career</h2>

  <p>
    Where you can realistically get hired matters as much as the job title itself.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Employer segment</th>
          <th>What it actually looks like</th>
        </tr>
      </thead>
      <tbody>
        {employerRows.map((item) => (
          <tr>
            <td data-label="Employer segment"><strong>{item.segment}</strong></td>
            <td data-label="What it actually looks like">{item.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="comparison-grid">
