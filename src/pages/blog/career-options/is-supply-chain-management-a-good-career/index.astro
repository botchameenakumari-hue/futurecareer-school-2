    ceilingNote: 'Execution-heavy logistics roles plateau faster than the other four functions unless you deliberately move into planning or network-design work.',
  },
  {
    fn: 'Inventory and warehouse management',
    exposure: 'Medium-high',
    exposureNote: 'Cycle counts, reorder triggers, and slotting are increasingly WMS-driven. Network design and safety-stock strategy are not.',
