const publishedDateLabel = '17 August 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'five-functions', label: 'Five functions, five different bets' },
  { id: 'ceiling-map', label: 'The Function Ceiling Map' },
  { id: 'pay-story', label: 'Real pay: staying put vs building range' },
  { id: 'best-function', label: 'Which function has the best ceiling' },
  { id: 'discipline-bet', label: 'Is SCM a good multi-decade bet' },
  { id: 'mobility-audit', label: 'The Mobility Audit' },
