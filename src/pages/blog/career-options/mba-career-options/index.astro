];

const sectorRows = [
  { inst: 'IIM Bangalore (2024-26)', consulting: '45%', finance: 'Not split out in the report', sales: 'Not split out in the report', note: '664 offers for 605 students.' },
  { inst: 'IIM Indore (2024-26)', consulting: '41%', finance: '20%', sales: '13%', note: '15% general management, operations and HR; 11% product and analytics.' },
  { inst: 'IIM Lucknow (2024-26)', consulting: '39%', finance: '17%', sales: '8%', note: '20% general management; 13% technology and analytics; 3% operations.' },
  { inst: 'IIM Calcutta (2024-26)', consulting: '38%', finance: '18.6%', sales: '9%', note: '21% general management; 13.3% IT and product.' },
  { inst: 'XLRI Jamshedpur (2024-26)', consulting: '36%', finance: '18% (BFSI)', sales: '12%', note: '15% IT services.' },
];

const feeRows = [
  { school: 'IIM Tiruchirappalli', fee: 'Rs 14.5 lakh', avg: 'Rs 19.27 LPA', ratio: '0.75x' },
  { school: 'IIM Ranchi', fee: 'Rs 19.2 lakh', avg: 'Rs 19 LPA', ratio: '1.0x' },
  { school: 'IIM Raipur', fee: 'Rs 20 lakh', avg: 'Rs 18 LPA', ratio: '1.1x' },
  { school: 'IMI Delhi', fee: 'Rs 23.54 lakh', avg: 'Rs 17 LPA', ratio: '1.4x' },
  { school: 'SIBM Bangalore', fee: 'Rs 21.4 lakh', avg: 'Rs 14 LPA', ratio: '1.5x' },
  { school: 'K.J. Somaiya Mumbai', fee: 'Rs 23 lakh', avg: 'Rs 12 LPA', ratio: '1.9x' },
  { school: 'ICFAI Hyderabad', fee: 'Rs 17.01 lakh', avg: 'Rs 9 LPA', ratio: '1.9x' },
