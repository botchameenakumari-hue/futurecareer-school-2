---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Data scientist vs software engineer salary in India: pay by employer type';
const seoTitle = 'Data Scientist vs Software Engineer Salary in India: By Employer';
const description =
  'Data scientist vs software engineer salary in India: both reach Rs 12 to 22 LPA at 3 to 5 years. Employer type and one skill decide the real gap.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/data-scientist-vs-software-engineer-salary-india/';
const publishedDateISO = '2026-11-15';
const publishedDateLabel = '15 November 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'pay-by-stage', label: 'Pay by career stage in 2026' },
  { id: 'this-week', label: 'Do this week' },
  { id: 'older-trackers', label: 'What salary trackers report at 1, 3 and 5 years' },
  { id: 'employer-type', label: 'Who hires you changes the number' },
  { id: 'premium', label: 'Where a data science premium really shows up' },
  { id: 'read-an-offer', label: 'How to read a salary number' },
  { id: 'scalability', label: 'Where each path stalls and which one scales further' },
  { id: 'who-pays', label: 'Who pays, and how they judge you' },
  { id: 'adjacent-roles', label: 'Adjacent roles with higher reported pay' },
  { id: 'ai-and-pay', label: 'How AI changes the pay gap' },
  { id: 'check-before-you-commit', label: 'Check before you commit' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'money-check', label: 'Money check before you pay' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'sources', label: 'Sources checked' },
  { id: 'faq', label: 'FAQs' },
];

const stageRows = [
  {
    stage: 'Entry level',
    swe: 'Rs 4 to 10 LPA (0 to 2 years)',
    ds: 'Rs 4.5 to 12 LPA (0 to 1 year)',
  },
  {
    stage: 'Early career',
    swe: 'Rs 12 to 22 LPA (about 3 to 5 years)',
    ds: 'Rs 8 to 16 LPA (1 to 3 years), then Rs 12 to 22 LPA (3 to 5 years)',
  },
  {
    stage: 'Senior',
    swe: 'Rs 25 to 40 LPA (6 years and above)',
    ds: 'Rs 25 to 40 LPA (6 to 9 years)',
  },
];

const trackerRows = [
  { stage: '1 year', swe: 'Rs 2 to 15 lakh', ds: 'Rs 2.4 to 21 lakh' },
  { stage: '3 years', swe: 'Rs 3 to 15 lakh', ds: 'Rs 4.3 to 25 lakh' },
  { stage: '5 years', swe: 'Rs 4.3 to 25.9 lakh', ds: 'Rs 5.6 to 32.9 lakh' },
];

const employerRows = [
  {
    stage: 'Fresher at an IT services company',
    swe: 'Rs 3.5 to 6 LPA. TCS pays about Rs 3.36 LPA to its entry trainee grade, and Infosys, Wipro and Accenture sit mostly at Rs 3 to 4 LPA.',
    ds: 'Rs 4.5 to 7 LPA.',
  },
  {
    stage: 'Fresher at a product company or GCC',
    swe: 'Rs 8 to 25 LPA for a first-level engineer (SDE-1).',
    ds: 'Rs 10 to 18 LPA at Indian product firms, Rs 12 to 22 LPA at GCCs, Rs 15 to 35 LPA at Big Tech India offices.',
  },
  {
    stage: 'Mid-career at an IT services company',
    swe: 'Rs 6.5 to 14 LPA (2 to 6 years).',
    ds: 'Rs 14 to 22 LPA (about 5 years).',
  },
  {
    stage: 'Mid-career at a product company or GCC',
    swe: 'Rs 18 to 45 LPA (2 to 5 years).',
    ds: 'Rs 22 to 38 LPA at Indian product firms, Rs 30 to 55 LPA at GCCs, Rs 50 to 80 LPA at Big Tech India offices (about 5 years).',
  },
];

const premiumRows = [
  {
    source: 'Quess Corp report, reported by Business Standard (April 2025)',
    says: 'AI and data science engineers in GCCs earn 25 to 40 percent more than traditional software engineers. At eight years of experience the top pay it quotes is up to Rs 50 lakh in Bengaluru, Rs 45 lakh in Hyderabad and Rs 41 lakh in Pune.',
    limit: 'It covers GCCs only, and "AI and data science engineer" is a specialised title, not every data scientist.',
  },
  {
    source: '1 Finance study, reported by Business Today (June 2026)',
    says: 'GCCs generally pay about 12 to 20 percent more than traditional IT services firms. AI and data science roles carry premiums of roughly 30 to 50 percent.',
    limit: 'The article gives the premium as a rough range and does not say which base pay it is measured against.',
  },
  {
    source: 'Quess Corp report, reported by IANS (April 2026)',
    says: 'Banking, financial services and insurance GCCs offer salary premiums of 1.5 to 2.5 times, and the report links them to a skills gap in AI and data roles.',
    limit: 'The article does not say which base the multiple is measured against, so treat it as a sign of scarcity, not a pay quote.',
  },
  {
    source: 'AIM Research GCC salary trends, summarised by Analytics India Magazine (March 2026)',
    says: 'Data scientists, AI and ML specialists and software architects form the top pay tier, all crossing Rs 50 LPA at senior levels. DevOps, cloud, full stack and UI or UX engineers sit in a meaningfully lower band.',
    limit: 'It is a summary of the report with no role-by-role medians, so it tells you the order of the tiers, not the exact gap.',
  },
];

const readOfferItems = [
  {
    label: 'Data scientist offer',
    title: 'Ask what the title really means',
    body: 'Some "data scientist" roles build models. Others build reports and dashboards under a bigger title. Ask what the last three projects of the team were, and whether a model ever ran live.',
  },
  {
    label: 'Software engineer offer',
    title: 'Ask what you will build',
    body: 'A first-level engineer role can mean building a product feature or supporting an old system for a client. Ask which stack you will use and how soon you will work on live code.',
  },
  {
    label: 'Both offers',
    title: 'Split the number',
    body: 'Ask how much of the package is fixed pay, how much is a yearly bonus that may vary, and how much is stock you receive in parts over several years. Compare fixed pay first, because that is what reaches your bank account every month.',
  },
];

const routeItems = [
  {
    chip: 'high',
    chipLabel: 'Scalable',
    title: 'Software engineer with a side route',
    why: 'An app or tool you build once can be sold again and again, so income is not tied to your hours. You also set the price.',
    grows: 'Take paid freelance projects first, then turn a need that keeps repeating into a small product.',
    watch: 'Selling and support take time away from coding, and a product with no buyers earns nothing.',
  },
  {
    chip: 'high',
    chipLabel: 'Scalable',
    title: 'Data scientist with a side route',
    why: 'Analysis and models sell as projects to firms with no data team, and a fixed-price package can be repeated. It starts narrower, because the value depends on one client\'s data and trust.',
    grows: 'Pick one industry, sell one fixed package, then automate the repeat steps so each job takes less time.',
    watch: 'A one-off report is the layer AI tools copy first, so keep ownership of a result the client uses.',
  },
  {
    chip: 'low',
    chipLabel: 'Not so scalable',
    title: 'Salaried job in either, with no side route',
    why: 'Pay follows one employer\'s band. A move from a services company to a GCC or product company lifts it, but you still earn one employer\'s pay.',
    grows: 'Change employer type, add one skill the market pays extra for, and keep a proof project running.',
    watch: 'The better employers mean two hard rounds: one as a fresher and one for the move at about three to five years.',
  },
];

const independentTips = [
  'Pick a narrow type of customer, such as clinics, small online shops or coaching centres, and one clear problem. A specific offer beats "I can do everything".',
  'Start with people you know and ask happy clients for a referral right after a good result. Warm introductions close faster than cold messages.',
  'Put scope, price and a deposit in writing before you start, and price any change request separately.',
  'Watch one number: how many enquiries turn into paid work.',
  'Check GST and Udyam (MSME) registration rules on the official portals once paid work grows, because thresholds change.',
  'Do not depend on one freelance platform. Keep a direct client list and a portfolio you own.',
];

const adjacentItems = [
  {
    label: 'Software plus ML',
    title: 'Generative AI engineer',
    body: 'A 1 Finance study reported by Business Today puts this role at about Rs 12 lakh at entry level, about Rs 25 lakh at 3 to 5 years and about Rs 60 lakh at 8 years and above. It sits where software skill meets model skill.',
  },
  {
    label: 'Data plus software',
    title: 'Data engineer',
    body: 'The same study lists data engineers at about Rs 42 lakh at 8 years and above. You build the pipelines that both data scientists and software teams depend on.',
  },
  {
    label: 'Software depth',
    title: 'Cloud and security engineer',
    body: 'The same study lists cloud computing at about Rs 45 lakh and cybersecurity at about Rs 55 lakh at 8 years and above. AIM Research puts cloud and DevOps in a lower GCC band, so sources differ and current postings should settle it.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Your fit',
    body: 'A software engineer spends the day building and fixing code that must run. A data scientist spends it cleaning messy data and explaining results that are never fully certain. Build a tiny version of each, such as a small app and a one-page analysis of a public dataset, and notice which one you finish and enjoy.',
    note: 'If you would quit within a year over the daily work, the higher pay band does not matter.',
  },
  {
    num: '02',
    title: 'Your situation',
    body: 'Both careers usually start at a services company near Rs 3.5 to 7 LPA. Work out whether your family can carry that while you build proof for a product company or GCC. If it cannot, a steady first offer with one project built beside the job is safer than a costly course.',
    note: 'Write down what you would take home each month for the first two years, and what you would spend.',
  },
  {
    num: '03',
    title: 'Job market',
    body: 'Software postings name a stack, such as Java, Python or JavaScript. Data science postings tend to ask for SQL, statistics and a cloud tool. Open a handful of live postings for each title in your city and list the skills that repeat.',
    note: 'Count how many postings welcome freshers. That tells you how open the door is today.',
  },
  {
    num: '04',
    title: 'AI-proof',
    body: 'In software, the routine layer is boilerplate code and simple tests. In data science it is routine charts and first-pass analysis. The pay stays with judgment: choosing what to build, checking the data and owning a result.',
    note: 'Ask: which part of this job would I still be paid for if AI did the first draft?',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Comparing a fresher software engineer with a senior data scientist',
    body: 'Most "data science pays double" claims compare different stages or different employers. Compare the same stage, the same employer type and the same city, or the number means nothing.',
  },
  {
    num: '02',
    title: 'Reading a Big Tech or GCC band as the normal offer',
    body: 'The high bands belong to a small number of employers with hard interviews. A services company is still the most common first employer in both careers.',
  },
  {
    num: '03',
    title: 'Paying for a bootcamp because of a pay screenshot',
    body: 'A course does not carry the salary in the screenshot. The offer depends on proof of work, how well you explain it, and the employer type you reach.',
  },
  {
    num: '04',
    title: 'Ignoring the shape of the pay package',
    body: 'A high total can include stock you receive later and a bonus that may vary. Compare fixed monthly pay before you compare the headline number.',
  },
  {
    num: '05',
    title: 'Judging the lane by the first offer alone',
    body: 'The first offer is one year of pay. The next two or three employers set the band you live in, so ask where each job could lead.',
  },
];

const faqItems = [
  {
    q: 'Data scientist vs software engineer salary in India: who earns more?',
    a: 'At the same stage they are close. Two 2026 salary guides give Rs 12 to 22 LPA for both careers at roughly three to five years and Rs 25 to 40 LPA at the senior stage. Data scientists show a higher top end in some trackers, and a data science premium appears mainly at GCCs and in AI-specialised roles.',
  },
  {
    q: 'What is the fresher salary for a data scientist and a software engineer in India?',
    a: 'At IT services companies, 2026 guides show Rs 3.5 to 6 LPA for software engineers and Rs 4.5 to 7 LPA for data scientists. At product companies and GCCs the bands rise to Rs 8 to 25 LPA for engineers and Rs 10 to 22 LPA for data scientists. Pay varies by city, employer and skill.',
  },
  {
    q: 'Does a data scientist earn more than a software engineer at TCS or Infosys?',
    a: 'Not by much at the entry grade. Business Today (February 2026) put TCS entry trainee pay at about Rs 3.36 LPA, with Infosys, Wipro and Accenture mostly at Rs 3 to 4 LPA. Infosys also offered Rs 7 to 21 lakh to freshers in specialist programmer roles (Business Today, December 2025), so the grade matters more than the title.',
  },
  {
    q: 'Do GCCs pay data scientists more than software engineers?',
    a: 'Often yes for AI and data science specialists. A Quess report said AI and data science engineers in GCCs earn 25 to 40 percent more than traditional software engineers. AIM Research also places data scientists, AI and ML specialists and software architects in the top pay tier at senior levels.',
  },
  {
    q: 'Is a machine learning or GenAI engineer paid more than a data scientist?',
    a: 'A 1 Finance study reported by Business Today puts generative AI engineers at about Rs 12 lakh at entry level, about Rs 25 lakh at 3 to 5 years and about Rs 60 lakh at 8 years and above. That role combines software and model skills. Compare current postings for the exact title, because titles are used loosely.',
  },
  {
    q: 'Can I trust the salary numbers on AmbitionBox, Glassdoor and similar sites?',
    a: 'Use them as ranges, not promises. They are built from salaries people report themselves, and the pages we checked were last updated in early 2025. Cross-check with live openings in your city and with people who work in the role.',
  },
  {
    q: 'Which career pays more if I do not have a computer science degree?',
    a: 'A computer science degree helps at the shortlisting stage, but employers pay for proof. Software interviews lean on coding and system design, and data science interviews lean on SQL, statistics and a project with a real finding. Build the proof for the lane you choose and check what your target employers ask for.',
  },
  {
    q: 'Should I choose data science or software engineering only for the salary?',
    a: 'No. The bands are close, and the gap inside each career between a strong and a weak performer is larger than the difference between the two careers. Choose the daily work you can sustain, then add one skill the market pays extra for, such as cloud, system design or applied AI.',
  },
  {
    q: 'Which of the two can earn more outside a job?',
    a: 'Both can, if you add a way to find clients. We rate both Scalable, with software first because an app or tool can be sold many times, while data work usually sells as projects. A salary alone stays inside one employer\'s band, so build proof of work and basic selling skill early.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Data scientist vs software engineer salary in India is close at each stage: two 2026 salary guides give both careers Rs 12 to 22 LPA (lakh rupees a year) at about 3 to 5 years and Rs 25 to 40 LPA at the senior stage.</strong>
    The bigger gap comes from who hires you, such as a services company, a product company or a GCC (a global company's own tech office in India), and from one extra skill in AI. Seeing that early tells you which employer type and which skill to aim for before you accept a first offer.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>At the same stage the pay bands match: Rs 12 to 22 LPA at roughly three to five years and Rs 25 to 40 LPA at the senior stage.</li>
      <li><strong>Employer type and AI-specialised skill move pay more than the title. A GCC or product company pays well above a services company for either job.</strong></li>
      <li>Both careers rate Scalable on our scale once you add a side route. Software comes first because an app can be sold many times, data work usually sells as projects, and a salary alone stays inside one employer's band.</li>
      <li>Pick the daily work you can stay with, then build one proof project. That portfolio decides which pay band you reach.</li>
    </ul>
  </div>

  <p>
    Compare more careers in our <a href="/blog/career-options/">career options guides</a>. If you already work in IT and an offer number confuses you, <a href="/services/career-counselling-and-career-guidance/career-coaching-for-it-professionals/">career coaching for IT professionals</a> can help you make the decisions that unlock high income opportunities, such as checking an offer.
  </p>

  <p>
    To see where your skills stand against either role today, try the free <a href="/career-skills-compass/">Career &amp; Skills Compass</a>.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="pay-by-stage">Data scientist vs software engineer salary in India: pay by career stage in 2026</h2>

  <p>
    Start with two salary guides published in 2026. One covers software engineers and one covers data scientists, so the stages do not line up perfectly.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Career stage</th>
          <th>Software engineer</th>
          <th>Data scientist</th>
        </tr>
      </thead>
      <tbody>
        {stageRows.map((item) => (
          <tr>
            <td data-label="Career stage"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer">{item.swe}</td>
            <td data-label="Data scientist">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Sources: OwnYourCareer software engineer salary page (dated July 2026 in its header and November 2026 in its summary) and the 360 Digital Transformation data scientist guide (27 September 2026), checked on 16 November 2026. Both combine job listings and salary sites, so they show typical advertised ranges, not medians. Pay varies by city, employer and skill.
  </p>

  <p>
    The two columns are almost the same at all three stages. That does not prove the two careers pay equally, because the guides use different methods. It does show that these 2026 guides do not support a claim that data science pays double.
  </p>

  <h2 id="this-week">Do this week</h2>
  <p>Do these before you accept an offer or pay for a course. Each step takes under an hour.</p>
  <div class="week-box">
    <ol>
      <li><strong>Day 1.</strong> Write the offer in rupees per month: fixed pay, variable pay, joining bonus and the notice period. Ask HR in writing for any line that is missing, then see what reaches your bank account with the <a href="https://futurecareerschool.com/tools/ctc-to-in-hand-salary-calculator/">CTC to in-hand salary calculator</a>.</li>
      <li><strong>Day 2 and 3.</strong> Read ten live postings for the role you want, five from services companies and five from product companies or GCCs (a global company's own tech office in India). Note the skills that appear in at least seven of the ten.</li>
      <li><strong>Day 4 to 6.</strong> Start one proof project with real data or a small working app. Write in three sentences what problem it solves and who could use it.</li>
      <li><strong>Day 7.</strong> Ask one person who works in the role you want what the first year was like. Ask what they would learn first if they started again.</li>
    </ol>
    <p class="week-box__note">Salary ranges on this page are directions, not offers. Check your own offer against live postings for your city and employer type.</p>
  </div>

  <h2 id="older-trackers">What salary trackers report at 1, 3 and 5 years</h2>

  <p>
    AmbitionBox publishes ranges built from salaries people report about their own jobs. These figures give a second view.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Experience</th>
          <th>Software engineer (reported range per year)</th>
          <th>Data scientist (reported range per year)</th>
        </tr>
      </thead>
      <tbody>
        {trackerRows.map((item) => (
          <tr>
            <td data-label="Experience"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer (reported range per year)">{item.swe}</td>
            <td data-label="Data scientist (reported range per year)">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Source: AmbitionBox software engineer page (updated 24 February 2025, built from about 5.8 lakh salaries) and data scientist page (updated in March 2025, built from about 45 thousand salaries). Checked on 16 November 2026.
  </p>

  <p>
    The bottom of both ranges is close at every stage. The top of the data scientist range is higher, but a top end shows what a few people reached, not what most people earn.
  </p>

  <h2 id="employer-type">Who hires you changes the number more than the job title</h2>

  <p>
    A services company, such as TCS or Infosys, builds software for other companies' clients. A product company sells its own app or platform, and a GCC is a global company's own tech office in India. Pay for one title swings widely across the three, which is why the proof of work that gets you into a better employer type matters more than the label.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Stage and employer</th>
          <th>Software engineer</th>
          <th>Data scientist</th>
        </tr>
      </thead>
      <tbody>
        {employerRows.map((item) => (
          <tr>
            <td data-label="Stage and employer"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer">{item.swe}</td>
            <td data-label="Data scientist">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Sources: OwnYourCareer software engineer salary page (2026 ranges), 360 Digital Transformation data scientist guide (27 September 2026) and Business Today on IT services fresher pay (9 February 2026). The year brackets differ between the two guides, so read the rows as direction, and note that the data scientist guide labels its Big Tech midpoint as total pay with stock. Treat the services rows as the common case and the GCC, product and Big Tech rows as strong to exceptional outcomes with harder interviews.
  </p>

  <p>
    At fresher level the two careers look similar inside one employer type. At mid-career the services row shows data scientists higher, but the year brackets differ, so read that as a direction only. The software engineer guide has no matching Big Tech row at this stage, so do not read the Big Tech line as proof of a data science advantage.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      The jump from a services company to a GCC or product company is larger than the difference between the two titles. Business Today reported in December 2025 that Infosys offered Rs 7 to 21 lakh to freshers in specialist programmer and digital specialist engineer roles. A fresher hired into a specialist grade like that can out-earn many freshers hired into the entry grade.
    </p>
  </div>

  <h2 id="premium">Where a data science premium really shows up</h2>

  <p>
    A premium for data and AI skill does exist in the reports. It is narrower than the headline claims, so read what each source can and cannot say.
  </p>

  <div class="source-grid">
    {premiumRows.map((item) => (
      <div class="source-card">
        <div class="source-card__label">{item.source}</div>
        <p class="route-row route-row--teal"><span>What it says</span>{item.says}</p>
        <p class="route-row route-row--gold"><span>What it does not tell you</span>{item.limit}</p>
      </div>
    ))}
  </div>

  <p>
    The pattern is the same in all four. The premium is tied to GCCs and to AI-specialised skill, and software architects reach the same top tier at senior levels.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      A general data scientist at a services company does not automatically get the premium. A software engineer who builds system design skill (software architects are in the top tier in the AIM report) or applied AI skill can reach the same band.
    </p>
  </div>

  <h2 id="read-an-offer">How to read a salary number before you accept it</h2>

  <p>
    A package figure is not the money that reaches your bank account. Ask three plain questions before you compare two offers.
  </p>

  <div class="feature-grid">
    {readOfferItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p><strong>An illustration, not a real offer.</strong> Offer A is a software engineer package of Rs 14 LPA: Rs 10 lakh fixed, Rs 2 lakh a bonus that may vary and Rs 2 lakh of stock released over four years. Offer B is a data scientist package of Rs 12 LPA, all fixed.</p>
    <p>Offer A looks Rs 2 lakh higher, yet its fixed pay is Rs 83,000 a month before tax against Rs 1 lakh a month for Offer B. Compare fixed pay first, then decide how much you trust the bonus and the stock.</p>
  </div>

  <p>
    If you are early in your career, our guide to <a href="/blog/job-search/salary-negotiation-for-freshers-india/">salary negotiation for freshers in India</a> shows how much room you really have to ask.
  </p>

  <h2 id="scalability">Where each path stalls, and which one scales further</h2>

  <p>
    Salary shows where you stand today, not how far you can go. Here are three routes, strongest scalability first, each with the reason for its rating.
  </p>

  <div class="route-list">
    {routeItems.map((item, i) => (
      <div class="route-card">
        <div class="route-card__top">
          <span class="route-card__n">{`0${i + 1}`}</span>
          <span class={`chip chip--${item.chip}`}>{item.chipLabel}</span>
        </div>
        <div class="route-card__title">{item.title}</div>
        <p class="route-card__why">{item.why}</p>
