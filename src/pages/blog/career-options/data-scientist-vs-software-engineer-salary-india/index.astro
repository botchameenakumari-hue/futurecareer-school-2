---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Data scientist vs software engineer salary in India: pay by employer type';
const description =
  'Data scientist vs software engineer salary in India is close at each stage. Employer type and one specialised skill decide the real gap. Pay bands inside.';
const canonical =
  'https://futurecareerschool.com/blog/career-options/data-scientist-vs-software-engineer-salary-india/';
const publishedDateISO = '2026-11-15';
const publishedDateLabel = '15 November 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'pay-by-stage', label: 'Pay by career stage in 2026' },
  { id: 'older-trackers', label: 'What salary trackers report at 1, 3 and 5 years' },
  { id: 'employer-type', label: 'Employer type moves pay more than the title' },
  { id: 'premium', label: 'Where a data science premium really shows up' },
  { id: 'read-an-offer', label: 'How to read a salary number' },
  { id: 'adjacent-roles', label: 'Adjacent roles that can pay more than both' },
  { id: 'who-pays', label: 'Who pays, and how they judge you' },
  { id: 'ai-and-pay', label: 'How AI changes the pay gap' },
  { id: 'check-before-you-commit', label: 'Check before you commit' },
  { id: 'beyond-salary', label: 'When pay stops being only a salary' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'money-check', label: 'Money check before you pay' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const stageRows = [
  {
    stage: 'Entry level',
    swe: 'Rs 4 to 10 LPA (0 to 2 years)',
    ds: 'Rs 4.5 to 12 LPA (0 to 1 year)',
  },
  {
    stage: 'Early career',
    swe: 'Rs 12 to 22 LPA (about 3 to 5 years)',
    ds: 'Rs 8 to 16 LPA (1 to 3 years), then Rs 12 to 22 LPA (3 to 5 years)',
  },
  {
    stage: 'Senior',
    swe: 'Rs 25 to 40 LPA (6 years and above)',
    ds: 'Rs 25 to 40 LPA (6 to 9 years)',
  },
];

const trackerRows = [
  { stage: '1 year', swe: 'Rs 2 to 15 lakh', ds: 'Rs 2.4 to 21.3 lakh' },
  { stage: '3 years', swe: 'Rs 3 to 15 lakh', ds: 'Rs 4.3 to 25 lakh' },
  { stage: '5 years', swe: 'Rs 4.3 to 25.9 lakh', ds: 'Rs 5.6 to 32.9 lakh' },
];

const employerRows = [
  {
    stage: 'Fresher at an IT services company',
    swe: 'Rs 3.5 to 6 LPA. TCS pays about Rs 3.36 LPA to its entry trainee grade, and Infosys, Wipro and Accenture sit mostly at Rs 3 to 4 LPA.',
    ds: 'Rs 4.5 to 7 LPA.',
  },
  {
    stage: 'Fresher at a product company or GCC',
    swe: 'Rs 8 to 25 LPA for a first-level engineer (SDE-1).',
    ds: 'Rs 10 to 18 LPA at Indian product firms, Rs 12 to 22 LPA at GCCs, Rs 15 to 35 LPA at Big Tech India (total pay with stock).',
  },
  {
    stage: 'Mid-career at an IT services company',
    swe: 'Rs 6.5 to 14 LPA (2 to 6 years).',
    ds: 'Rs 14 to 22 LPA (about 5 years).',
  },
  {
    stage: 'Mid-career at a product company or GCC',
    swe: 'Rs 18 to 45 LPA (2 to 5 years).',
    ds: 'Rs 22 to 38 LPA at Indian product firms, Rs 30 to 55 LPA at GCCs, Rs 50 to 80 LPA at Big Tech India (about 5 years, total pay with stock).',
  },
];

const premiumRows = [
  {
    source: 'Quess Corp report, reported by Business Standard (April 2025)',
    says: 'AI and data science engineers in GCCs earn 25 to 40 percent more than traditional software engineers. At eight years of experience the top pay it quotes is up to Rs 50 lakh in Bengaluru, Rs 45 lakh in Hyderabad and Rs 41 lakh in Pune.',
    limit: 'It covers GCCs only, and "AI and data science engineer" is a specialised title, not every data scientist.',
  },
  {
    source: '1 Finance study, reported by Business Today (June 2026)',
    says: 'GCCs generally pay about 12 to 20 percent more than traditional IT services firms. AI and data science roles carry premiums of roughly 30 to 50 percent.',
    limit: 'The article gives the premium as a rough range and does not say which base pay it is measured against.',
  },
  {
    source: 'Quess Corp report, reported by IANS (April 2026)',
    says: 'Banking, financial services and insurance GCCs offer salary premiums of 1.5 to 2.5 times, and the report links them to a skills gap in AI and data roles.',
    limit: 'The article does not say which base the multiple is measured against, so treat it as a sign of scarcity, not a pay quote.',
  },
  {
    source: 'AIM Research, GCC Salary Trends in India 2026 (March 2026)',
    says: 'Data scientists, AI and ML specialists and software architects form the top pay tier, all crossing Rs 50 LPA at senior levels. DevOps, cloud, full stack and UI or UX engineers sit in a meaningfully lower band.',
    limit: 'It is a summary of the report with no role-by-role medians, so it tells you the order of the tiers, not the exact gap.',
  },
];

const readOfferItems = [
  {
    label: 'Data scientist offer',
    title: 'Ask what the title really means',
    body: 'Some "data scientist" roles build models. Others build reports and dashboards under a bigger title. Ask what the last three projects of the team were, and whether a model ever ran live.',
  },
  {
    label: 'Software engineer offer',
    title: 'Ask what you will build',
    body: 'A first-level engineer role can mean building a product feature or supporting an old system for a client. Ask which stack you will use and how soon you will work on live code.',
  },
  {
    label: 'Both offers',
    title: 'Split the number',
    body: 'Ask how much of the package is fixed pay, how much is a yearly bonus that may vary, and how much is stock that vests over time. Compare fixed pay first, because that is what reaches your bank account every month.',
  },
];

const adjacentItems = [
  {
    label: 'Software plus ML',
    title: 'Generative AI engineer',
    body: 'A 1 Finance study reported by Business Today puts this role at about Rs 12 lakh at entry level, about Rs 25 lakh at 3 to 5 years and about Rs 60 lakh at 8 years and above. It sits where software skill meets model skill.',
  },
  {
    label: 'Data plus software',
    title: 'Data engineer',
    body: 'The same study lists data engineers at about Rs 42 lakh at 8 years and above. You build the pipelines that both data scientists and software teams depend on.',
  },
  {
    label: 'Software depth',
    title: 'Cloud and security engineer',
    body: 'The same study lists cloud computing at about Rs 45 lakh and cybersecurity at about Rs 55 lakh at 8 years and above. AIM Research puts cloud and DevOps in a lower GCC band, so sources differ and current postings should settle it.',
  },
];

const checkpointItems = [
  {
    num: '01',
    title: 'Your fit',
    body: 'Pay is not the daily work. A software engineer builds and fixes code that must run. A data scientist cleans data and explains uncertain results. Pick the work you can do for years, because the gap between a strong and a weak performer in either career is larger than the gap between the two careers.',
    note: 'If you would quit within a year over the daily work, the higher band does not matter.',
  },
  {
    num: '02',
    title: 'Your situation',
    body: 'Services-company freshers in both careers start in a similar low band, about Rs 3.5 to 7 LPA in the guides above. Can your family manage that while you build proof for a product company or a GCC? If not, a stable first offer plus a side project is safer than a costly course.',
    note: 'Do not borrow money for a course to chase a salary figure from a screenshot.',
  },
  {
    num: '03',
    title: 'Job market',
    body: 'The big pay jumps in the 2026 guides above come from moving to a product company, a GCC or Big Tech India, not from the job title. Check current openings in your city for both titles and read what skills they ask for before you choose.',
    note: 'Search the live job boards for both titles in your city and compare the posted skills.',
  },
  {
    num: '04',
    title: 'AI-proof',
    body: 'AI tools now do a lot of routine coding and basic analysis, so the easy entry tasks pay less over time in both careers. The pay premium in the reports above goes to people who can build and check AI systems or design larger systems. Choose the lane where you can do the part AI cannot do alone.',
    note: 'Ask: which part of this job will still need my judgment in a few years?',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Comparing a fresher software engineer with a senior data scientist',
    body: 'Most "data science pays double" claims compare different stages or different employers. Compare the same stage, the same employer type and the same city, or the number means nothing.',
  },
  {
    num: '02',
    title: 'Reading a Big Tech or GCC band as the normal offer',
    body: 'The high bands belong to a small number of employers with hard interviews. A services company is still the most common first employer in both careers.',
  },
  {
    num: '03',
    title: 'Paying for a bootcamp because of a pay screenshot',
    body: 'A course does not carry the salary in the screenshot. The offer depends on proof of work, how well you explain it, and the employer type you reach.',
  },
  {
    num: '04',
    title: 'Ignoring the shape of the pay package',
    body: 'A high total can include stock that vests later and a bonus that may vary. Compare fixed monthly pay before you compare the headline number.',
  },
];

const faqItems = [
  {
    q: 'Data scientist vs software engineer salary in India: who earns more?',
    a: 'At the same stage they are close. Two 2026 salary guides give Rs 12 to 22 LPA for both careers at roughly three to five years and Rs 25 to 40 LPA at the senior stage. Data scientists show a higher top end in some trackers, and a data science premium appears mainly at GCCs and in AI-specialised roles.',
  },
  {
    q: 'What is the fresher salary for a data scientist and a software engineer in India?',
    a: 'At IT services companies, 2026 guides show Rs 3.5 to 6 LPA for software engineers and Rs 4.5 to 7 LPA for data scientists. At product companies and GCCs the bands rise to Rs 8 to 25 LPA for engineers and Rs 10 to 22 LPA for data scientists. Pay varies by city, employer and skill.',
  },
  {
    q: 'Does a data scientist earn more than a software engineer at TCS or Infosys?',
    a: 'Not by much at the entry grade. Business Today reported in February 2026 that TCS pays its entry trainee grade about Rs 3.36 LPA, and Infosys, Wipro and Accenture start mostly at Rs 3 to 4 LPA. Infosys also hires freshers into specialised roles at Rs 7 to 21 lakh (Business Standard, December 2025), so the grade matters more than the title.',
  },
  {
    q: 'Do GCCs pay data scientists more than software engineers?',
    a: 'Often yes for AI and data science specialists. A Quess report said AI and data science engineers in GCCs earn 25 to 40 percent more than traditional software engineers. AIM Research also places data scientists, AI and ML specialists and software architects in the top pay tier at senior levels.',
  },
  {
    q: 'Is a machine learning or GenAI engineer paid more than a data scientist?',
    a: 'A 1 Finance study reported by Business Today puts generative AI engineers at about Rs 12 lakh at entry level, about Rs 25 lakh at 3 to 5 years and about Rs 60 lakh at 8 years and above. That role combines software and model skills. Compare current postings for the exact title, because titles are used loosely.',
  },
  {
    q: 'Can I trust the salary numbers on AmbitionBox, Glassdoor and similar sites?',
    a: 'Use them as ranges, not promises. They are built from salaries people report themselves, and the pages we checked were last updated in early 2025. Cross-check with current job postings in your city and with people who work in the role.',
  },
  {
    q: 'Which career pays more if I do not have a computer science degree?',
    a: 'A computer science degree helps at the shortlisting stage, but employers pay for proof. Software interviews lean on coding and system design, and data science interviews lean on SQL, statistics and a project with a real finding. Build the proof for the lane you choose and check what your target employers ask for.',
  },
  {
    q: 'Should I choose data science or software engineering only for the salary?',
    a: 'No. The bands are close, and the gap inside each career between a strong and a weak performer is larger than the gap between the two careers. Choose the daily work you can sustain, then add one skill the market pays extra for, such as cloud, system design or applied AI.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Data scientist vs software engineer salary in India is closer than most charts suggest: the 2026 guides we
    checked give almost the same bands at each career stage, and the bigger gaps come from where you work and which
    special skill you add.</strong>
    A fresher at a services company starts in a similar low band in both careers, and the bigger jumps come from moving
    to a product company, a global capability centre (GCC) or an AI-focused role. Knowing that is one of the
    decisions that unlock high income opportunities, and it moves you toward earlier financial freedom faster than
    picking a job title from a salary screenshot.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>Two 2026 salary guides show almost the same bands for both careers: Rs 12 to 22 LPA at roughly three to five years and Rs 25 to 40 LPA at the senior stage.</li>
      <li><strong>The extra pay goes to employer type (a GCC, product company or Big Tech India) and to AI-specialised skill, not to the title data scientist or software engineer.</strong></li>
      <li>Pick the daily work you can sustain, then build one high-value skill with proof of work, because that portfolio decides which pay band you reach.</li>
    </ul>
  </div>

  <p>
    For more comparisons like this, see our <a href="/blog/career-options/">career options guides</a>. If you already work in IT and want a second opinion on your next move, see <a href="/services/career-counselling-and-career-guidance/career-coaching-for-it-professionals/">career coaching for IT professionals</a>.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="pay-by-stage">Data scientist vs software engineer salary in India: pay by career stage in 2026</h2>

  <p>
    Start with two salary guides published in 2026. One covers software engineers and one covers data scientists, so the stages do not line up perfectly.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Career stage</th>
          <th>Software engineer</th>
          <th>Data scientist</th>
        </tr>
      </thead>
      <tbody>
        {stageRows.map((item) => (
          <tr>
            <td data-label="Career stage"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer">{item.swe}</td>
            <td data-label="Data scientist">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Sources: OwnYourCareer software engineer guide (labelled July 2026) and 360 Digital Transformation data scientist guide (read on 27 September 2026), checked on 15 November 2026. Both combine job listings and salary sites, so they show typical ranges, not medians. Pay varies by city, employer and skill.
  </p>

  <p>
    The two columns are almost the same at all three stages. That does not prove the two careers pay equally, because the guides use different methods. It does show that the old claim of data science paying double is not what these 2026 guides show.
  </p>

  <h2 id="older-trackers">What salary trackers report at 1, 3 and 5 years</h2>

  <p>
    AmbitionBox publishes ranges built from salaries people report about their own jobs. These figures give a second view.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Experience</th>
          <th>Software engineer (reported range per year)</th>
          <th>Data scientist (reported range per year)</th>
        </tr>
      </thead>
      <tbody>
        {trackerRows.map((item) => (
          <tr>
            <td data-label="Experience"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer (reported range per year)">{item.swe}</td>
            <td data-label="Data scientist (reported range per year)">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Source: AmbitionBox software engineer page (updated 24 February 2025, built from about 5.8 lakh salaries) and data scientist page (updated 15 March 2025, built from about 45.4 thousand salaries). Checked on 15 November 2026.
  </p>

  <p>
    The bottom of both ranges is close at every stage. The top of the data scientist range is higher, but a top end shows what a few people reached, not what most people earn.
  </p>

  <h2 id="employer-type">Employer type moves pay more than the job title</h2>

  <p>
    The same title pays very differently depending on who hires you. This is where the real gap sits, and it is why a <strong>high-value skill portfolio</strong> that gets you into a better employer type matters more than the label.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Stage and employer</th>
          <th>Software engineer</th>
          <th>Data scientist</th>
        </tr>
      </thead>
      <tbody>
        {employerRows.map((item) => (
          <tr>
            <td data-label="Stage and employer"><strong>{item.stage}</strong></td>
            <td data-label="Software engineer">{item.swe}</td>
            <td data-label="Data scientist">{item.ds}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Sources: OwnYourCareer software engineer guide (2025 to 2026 ranges), 360 Digital Transformation data scientist guide (27 September 2026) and Business Today on IT services fresher pay (9 February 2026). The experience brackets differ between the two guides, so read the rows as direction, not as an exact match.
  </p>

  <p>
    At fresher level the two careers look similar inside one employer type. At mid-career the services row shows data scientists higher, but the two guides use different year brackets, so read that as a direction. The jump from a services company to a GCC or a product company is larger than the gap between the two titles.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      An entry grade at a large services company pays about the same for both careers. Business Standard reported in December 2025 that Infosys also hired freshers for specialised technology roles at Rs 7 to 21 lakh. A software engineer hired into a grade like that can out-earn many data science freshers, so the grade you are hired into matters more than the job title.
    </p>
  </div>

  <h2 id="premium">Where a data science premium really shows up</h2>

  <p>
    A premium for data and AI skill does exist in the reports. It is narrower than the headline claims, so read what each source can and cannot say.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Source</th>
          <th>What it says</th>
          <th>What it does not tell you</th>
        </tr>
      </thead>
      <tbody>
        {premiumRows.map((item) => (
          <tr>
            <td data-label="Source"><strong>{item.source}</strong></td>
            <td data-label="What it says">{item.says}</td>
            <td data-label="What it does not tell you">{item.limit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    The pattern is the same in all four. The premium is tied to GCCs and to AI-specialised skill, and software architects reach the same top tier at senior levels.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      A general data scientist at a services company does not automatically get the premium. A software engineer who builds system design skill (software architects are in the top tier in the AIM report) or applied AI skill can reach the same band.
    </p>
  </div>

  <h2 id="read-an-offer">How to read a salary number before you accept it</h2>

  <p>
    A package figure is not the money that reaches your bank account. Ask three plain questions before you compare two offers.
  </p>

  <div class="feature-grid">
    {readOfferItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    If you are early in your career, our guide to <a href="/blog/job-search/salary-negotiation-for-freshers-india/">salary negotiation for freshers in India</a> shows how much room you really have to ask.
  </p>

  <h2 id="adjacent-roles">Adjacent roles that can pay more than both</h2>

  <p>
    Some of the highest figures in the reports belong to roles that sit between the two careers. They are worth knowing before you lock in a lane.
  </p>

  <div class="feature-grid">
    {adjacentItems.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <div class="feature-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    Source: 1 Finance study (Global Economic Outlook Report 2026, with Team Lease RegTech data), reported by Business Today on 12 June 2026. These are broad averages for experienced people, not offers for freshers.
  </p>

  <div class="comparison-grid">
    <div class="compare-card compare-card--teal">
      <div class="compare-card__label">If you lean to software engineering</div>
      <ul>
        <li>Build system design and cloud skill, the areas product-company interviews test.</li>
        <li>Add applied AI work, such as building features on top of language models, to reach the GCC premium.</li>
      </ul>
    </div>
    <div class="compare-card compare-card--gold">
      <div class="compare-card__label">If you lean to data science</div>
      <ul>
        <li>Move models from a notebook into something that runs live, because that is what GCCs and product firms pay extra for.</li>
        <li>Add a domain, such as banking or health, so you can explain what the model changes for the business.</li>
      </ul>
    </div>
  </div>

  <h2 id="who-pays">Who pays for data scientists and software engineers, and how they judge you</h2>

  <p>
    At a services company, a client pays the company and the company pays you from the project bill, so your pay follows the client contract and your grade. At a GCC or a product company, the parent business or its own customers pay, and they hire for work that earns or saves money directly.
  </p>

  <p>
    A software engineer is judged on coding and design interviews and on shipped work. A data scientist is judged on SQL and statistics interviews and on one project with a real finding. The first skill worth building for both is the ability to state your impact in one line with a number, such as time saved, errors cut or revenue helped, and to ask for the pay band before you negotiate.
  </p>

  <h2 id="ai-and-pay">How AI changes the pay gap</h2>

  <p>
    AI tools now write a lot of routine code and do basic analysis, so the easiest entry tasks in both careers are the ones under pressure. The pay premium in the sources above goes to the opposite end: people who build, run and check AI systems, or who design larger systems.
  </p>

  <p>
    Start by using AI inside your current work and keep a record of what you improved. Later, as more employers build AI features, move toward the roles that own the model or the system, because those are the roles the reports price higher. Tool use alone does not raise pay without visible proof and the judgment to check the output.
  </p>

  <h2 id="check-before-you-commit">Check before you commit: four questions, then three proofs</h2>

  <p>
    Salary is only one input, so run the four questions first and then pass the three proofs before you spend money or years on either lane.
  </p>

  <div class="protocol-stack">
    {checkpointItems.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <div class="gates-block">
    <p class="gates-block__title">
      Pass all three proofs in your chosen lane before you pay for a course or switch careers.
    </p>
    <div class="gates-row">
      <div class="gate">
        <span class="gate__num">Proof 1</span>
        <span class="gate__name">Show it</span>
        <p>
          For software engineering, ship one small working project that others can open. For data science, take one messy public dataset and write one finding that changes a decision.
        </p>
      </div>
      <div class="gate">
        <span class="gate__num">Proof 2</span>
        <span class="gate__name">Say it</span>
        <p>
          Explain the project in two minutes without notes, including what it saved or improved. Employers pay for the impact, not for the code alone.
        </p>
      </div>
      <div class="gate">
        <span class="gate__num">Proof 3</span>
        <span class="gate__name">Get it checked</span>
        <p>
          Show it to a working engineer or data professional and ask whether it would be shortlisted at their company. Use that answer, not your hope.
        </p>
      </div>
    </div>
  </div>

  <h2 id="beyond-salary">When pay stops being only a salary</h2>

  <p>
    Neither career is capped at one pay band. A salary has a ceiling set by your employer, and both careers also let you sell the skill directly.
  </p>

  <div class="highlight-box highlight-box--amber">
    <p>
      The scalable route in both careers is independent work: freelance projects, consulting for small firms, or a small product built on your skill. Software skills sell as products and projects, and data skills sell as analysis and automation for businesses that cannot afford a full team. It scales because you set the price and are not limited to one employer, but it needs proof of work and basic selling skill first.
    </p>
  </div>

