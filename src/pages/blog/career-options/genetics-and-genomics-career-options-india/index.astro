const description = "Genetics and genomics career options in India: lab, diagnostics, research and bioinformatics routes, what training you need, honest limits on hiring and ways to build proof early.";
const seoDescription = "Genetics careers: lab, diagnostics and bioinformatics routes that need higher study and honest expectations.";
const canonical = "https://futurecareerschool.com/blog/career-options/genetics-and-genomics-career-options-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is genetics a good career in India?",
    "It can be with higher study and a data or lab skill. Hiring is competitive."
  ],
  [
    "What jobs can I get after BSc genetics?",
    "Lab assistant, diagnostics and research assistant roles; higher study improves options."
  ],
  [
    "Is MSc necessary?",
    "For many technical roles, yes. Check notices."
  ],
  [
    "Can I do bioinformatics?",
    "Yes, with coding and public-data practice."
  ],
  [
    "Is genetic counselling the same?",
    "It needs separate training. Check requirements."
  ],
  [
    "Which skills help?",
    "Lab method, statistics and coding."
  ],
  [
    "Are there jobs abroad?",
    "Some, with higher study. Rules vary."
  ],
  [
    "Will AI replace geneticists?",
    "AI speeds analysis. Design and interpretation remain human."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
