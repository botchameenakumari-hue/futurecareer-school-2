---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "What to do after failing Class 10 in India: supplementary exam, repeat, NIOS, ITI and skill routes";
const seoTitle = "After Failing Class 10 in India: Supplementary, NIOS, ITI, Next Steps";
const description =
  "Failed Class 10? See which result you have, how the CBSE second exam, supplementary and NIOS work, ITI routes, and what to build while you clear it.";
const seoDescription =
  "Failed Class 10? Find which result you have, how the second exam, supplementary and NIOS work, ITI routes and what to build while you clear it.";
const canonical = "https://futurecareerschool.com/blog/career-options/what-to-do-after-failing-class-10-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const jumpLinks = [
  { id: "which-result", label: "Which result do you have?" },
  { id: "first-month", label: "The first month" },
  { id: "second-exam", label: "The CBSE second exam and supplementary" },
  { id: "private", label: "The private candidate route" },
  { id: "nios", label: "NIOS Secondary" },
  { id: "iti", label: "ITI and polytechnic: what a failed Class 10 allows" },
  { id: "routes", label: "Eight routes, strongest growth first" },
  { id: "age", label: "Skills at 15 or 16: what is realistic" },
  { id: "family", label: "Talking to your family" },
  { id: "money", label: "Money and scam warnings" },
  { id: "checkpoint", label: "The 4-Checkpoint Protocol" },
  { id: "gates", label: "The 3 Gates" },
  { id: "mistakes", label: "Expensive mistakes" },
  { id: "next-step", label: "What to do next" },
  { id: "faq", label: "FAQs" },
];

const resultRows = [
  {
    result: "Failed one or two subjects (compartment)",
    means: "In CBSE's 2026 scheme, as reported by All India Radio, a student with a compartment result can sit the second exam in the compartment category to clear the subject not passed.",
    next: "Ask your school for the second-exam form date and the subjects you are eligible to re-sit.",
  },
  {
    result: "Failed three or more subjects (essential repeat)",
    means: "All India Radio reported CBSE saying that students who miss three or more subjects in the first exam are not eligible for the second exam and are placed in Essential Repeat. The report does not say whether 'miss' means failing or being absent, so ask your school.",
    next: "Repeat Class 10, take a private route where the board allows it, or move to NIOS Secondary.",
  },
  {
    result: "Passed theory but missed internal or practical marks",
    means: "CBSE bye-law 40.1, as read by the Delhi High Court, asks for 33 percent in theory and in practical or internal assessment separately. Check whether that applies to the subject you failed.",
    next: "Ask the school which component you failed and whether the second exam covers it.",
  },
  {
    result: "State board or ICSE result",
    means: "Each board has its own supplementary rules, names and dates. The CBSE details above do not transfer.",
    next: "Read your own board's circular and ask the school office for the form deadline.",
  },
];

const monthSteps = [
  { n: "01", title: "Get the marksheet read line by line", body: "Find the exact subjects, marks and the word printed next to your result. Everything below depends on it." },
  { n: "02", title: "Tell one adult you trust", body: "Form deadlines for the second exam, supplementary and NIOS move quickly. One adult who knows can help you hit them." },
  { n: "03", title: "Pick the cheapest legal route to a pass", body: "Compare the second exam or supplementary, a repeat year and NIOS on cost, timing and how you learn best." },
  { n: "04", title: "Start one small skill project beside it", body: "A pass is the first goal. A small project keeps your confidence and builds a record people can see." },
];

const nios = [
  { fact: "Who can join Secondary", detail: "A learner needs Class VIII passed and proof of age 14, according to the NIOS regional centre FAQ." },
  { fact: "Credit for subjects you passed", detail: "Learners from other boards can transfer up to two subjects passed in the last five years, if those subjects are in the NIOS scheme. Ask at admission, with the original marksheet." },
  { fact: "Pass rule", detail: "Five subjects, with 33 percent in each external exam and 33 percent in aggregate, as the FAQ states." },
  { fact: "Exam timing", detail: "On-demand exams run monthly after the first public exam, so you choose when to sit a subject once you are ready." },
  { fact: "Cost anchor", detail: "The FAQ lists Rs 250 per theory subject and Rs 100 per practical for an on-demand exam. Check the current table before you pay." },
  { fact: "Recognition", detail: "NIOS says its certificates carry equal recognition with other boards, and the Association of Indian Universities has granted equivalence for higher studies. Check any specific school, college or exam you want." },
];

const itiRows = [
  { path: "ITI trades", entry: "The DGT page for NSTI Indore lists Class 10 for most trades, Class 8 for Dress Making, a minimum age of 14 and no upper age limit.", leads: "Most trades run one year. NCVT awards the National Trade Certificate after the exam." },
  { path: "Polytechnic diploma", entry: "Nagaland's rules ask for Class 10 passed, with Maths and Science for the engineering diploma. A failed Class 10 therefore blocks it until the pass is cleared.", leads: "A three-year diploma. Lateral entry to the second year of a degree exists, with Nagaland capping it at 10 percent of intake." },
  { path: "Tamil Nadu failed-student admission", entry: "A 2023 news report said students who fail Class 10 can join ITI or polytechnic courses on a Class 8 certificate in that state.", leads: "A ladder of ITI, then second-year diploma, then second-year degree, according to the same report. It is state specific." },
];

const routes = [
  {
    n: "01",
    name: "Clear the exam and continue school",
    scale: "mid",
    why: "A pass opens Class 11 in any stream, polytechnic and most ITI trades. It keeps the largest number of doors open for the least money.",
    pays: "A pass certificate is what colleges, employers and exams check first.",
    trust: "The second-exam or supplementary result and a clean marksheet.",
    watch: "Repeating the same preparation gives the same result. Change the teacher, the timetable or the method.",
    grow: "Choose a stream after the pass by looking at what you did well, then build a skill beside it.",
  },
  {
    n: "02",
    name: "NIOS Secondary at your own pace",
    scale: "mid",
    why: "On-demand exams let you clear subjects when ready, and transfer of credit can save subjects you already passed.",
    pays: "Admissions and employers that accept NIOS as equal to other boards.",
    trust: "The NIOS certificate and an equivalence letter where needed.",
    watch: "Self-study needs a routine. Without one, a flexible schedule slips.",
    grow: "Fix a weekly timetable and a target exam month, then pair it with a skill project.",
  },
  {
    n: "03",
    name: "ITI trades, including a Class 8 route in some states",
    scale: "mid",
    why: "Many trades ask only for Class 10, and ITI is a direct route to skilled work. Some state schemes accept Class 8.",
    pays: "Employers in electrical, electronics, fitter, machine and computer trades, and customers who need repair or installation.",
    trust: "The National Trade Certificate, workshop practice and a supervisor reference.",
    watch: "Seat rules differ by state and trade. Confirm the exact entry rule on the admission notice.",
    grow: "Add a second skill such as solar, CCTV or networking, then take small jobs.",
  },
  {
    n: "04",
    name: "Creative and digital skills built at home",
    scale: "mid",
    why: "Video editing, design, photo work and simple web or app building can start with a phone or a basic computer. Proof of work matters more than a certificate.",
    pays: "Local shops, creators and small firms first; later, direct clients.",
    trust: "Three finished pieces for one kind of client, with notes on how you made them.",
    watch: "AI tools now draft basic visuals and edits, so your edge is taste, reliability and speed. Do not stop studying for the pass.",
    grow: "Pick a niche, make a sample, offer it free to one local business and ask for a testimonial.",
  },
  {
    n: "05",
    name: "Family business or a local apprenticeship",
    scale: "mid",
    why: "Learning inside a shop, workshop or farm teaches pricing, customers and repeat orders. These lessons carry into your own business later.",
    pays: "Customers of that business. Pay at the start is small or in kind.",
    trust: "Visible work you handled and the owner's word.",
    watch: "Keep studying toward the pass. Paid work for a minor has legal limits, so check the local rules first.",
    grow: "Ask to handle one task end to end, such as billing or customer follow-up.",
  },
  {
    n: "06",
    name: "Sport, music, dance or another trained talent",
    scale: "low",
    why: "Some students put their energy into a talent that already shows results. Coaching, performance and teaching are real work.",
    pays: "Clubs, academies, schools and event organisers.",
    trust: "Results, certified coaching levels and performance records.",
    watch: "A narrow field with few top places. Keep the pass as a safety net.",
    grow: "Record your results and take a coaching or teaching qualification early.",
  },
  {
    n: "07",
    name: "Polytechnic diploma after clearing Class 10",
    scale: "mid",
    why: "A diploma gives technical skills in three years and a ladder toward a degree through lateral entry.",
    pays: "Technical employers and, later, your own workshop or contracting work.",
    trust: "Diploma marks, internships and project work.",
    watch: "You need the pass first. Admission is by merit and varies by state.",
    grow: "Prepare Maths and Science for the entrance, and visit one polytechnic before applying.",
  },
  {
    n: "08",
    name: "Government posts that accept Class 10 pass",
    scale: "low",
    why: "Some entry-level posts ask only for Class 10, so a cleared pass keeps these open. Selection is by ranked written exams.",
    pays: "Central and state departments, as each notice states.",
    trust: "Your exam rank and clean documents at verification.",
    watch: "Competition is heavy and age limits apply. Treat it as one option beside a skill, not the only plan.",
    grow: "Read two real notices to see the qualification and age line, then decide whether to prepare later.",
  },
];

const protocolItems = [
  { num: "01", title: "Biology: where did the marks go?", body: "Look at which subjects and which papers you lost. A pattern in one subject, in exam nerves or in practicals points to a fix. A pattern across everything points to a different route." },
  { num: "02", title: "Context: time, money and home support", body: "Write down how many months and how much money the family can put into the next step. Check the cheapest legal route first." },
  { num: "03", title: "Market: what do local employers ask for?", body: "Visit three local workplaces or collect ten notices. Note the qualification, whether they take apprentices and what a first job pays." },
  { num: "04", title: "Survival: what survives AI?", body: "Plain data entry and entry-level writing are what AI takes first. Trades, sales, local services and real analysis last longer. Pick a route whose first year builds those skills." },
];

const gateItems = [
  { label: "Gate 1", title: "Proof of skill", body: "Finish one small piece of work: a repaired device, a short video, a sold product, a simple page. Record how you did it." },
  { label: "Gate 2", title: "Proof you can explain it", body: "Tell a relative or a shop owner what you did in two minutes. If they cannot repeat it back, simplify." },
  { label: "Gate 3", title: "Proof someone will pay", body: "Offer it to three people and note what they would pay. One paying customer teaches more than a month of preparation." },
];

const mistakes = [
  { num: "01", title: "Hiding the result", body: "Form dates pass quickly. Tell one trusted adult early." },
  { num: "02", title: "Paying for a guaranteed pass", body: "No centre can guarantee a board result. Check every claim against the board's own circular." },
  { num: "03", title: "Repeating the same method", body: "If last year's method failed, change the teacher, the timetable or the board." },
  { num: "04", title: "Missing transfer of credit", body: "NIOS lets you carry up to two passed subjects, but you must ask at admission and within five years." },
  { num: "05", title: "Dropping study and skills together", body: "Keep the pass as the first goal and a small skill project beside it." },
];

const faqItems = [
  { q: "What should I do after failing Class 10?", a: "Find your exact result first. If you failed one or two subjects, use the second exam or supplementary. If you failed more, choose between a repeat year, a private route where allowed and NIOS Secondary. Start one small skill project beside it." },
  { q: "Is there a second board exam in CBSE Class 10?", a: "Yes, from 2026. Onmanorama reported that the first exam ran from 17 February to 11 March and the second from 15 to 21 May, and All India Radio reported that the first exam is mandatory. Confirm each year's rules with your school and the board." },
  { q: "How many students cleared the Class 10 second exam in 2026?", a: "Onmanorama reported that over 1.49 lakh students appeared in the compartment category and over 52 percent of them cleared. That leaves fewer than half who did not clear on that attempt, so keep a backup plan." },
  { q: "Can I apply as a private candidate after failing Class 10?", a: "A Careers360 page on the 2026-27 cycle lists candidates who failed Class 10 or 12 in any year from 2021 to 2026, and Essential Repeat candidates, as able to apply with full subjects. It reported an application window of 8 to 24 October 2026, so check the current CBSE notice for your year." },
  { q: "What is the difference between compartment and essential repeat?", a: "Compartment lets you re-sit the subject you did not pass. All India Radio reported CBSE saying students who miss three or more subjects in the first exam are not eligible for the second exam and are placed in Essential Repeat. The report does not say whether miss means fail or absent, so ask your school." },
  { q: "Can I join ITI after failing Class 10?", a: "Most ITI trades ask for Class 10 on the DGT page for NSTI Indore, though Dress Making asks for Class 8. A 2023 report said Tamil Nadu admits failed students to ITI on a Class 8 certificate. Check the admission notice for your trade and state." },
  { q: "Can I join a polytechnic after failing Class 10?", a: "Not until you clear it. Nagaland's rules, for example, ask for a Class 10 pass with Maths and Science. Clear the exam first, then apply." },
  { q: "Is NIOS valid after Class 10?", a: "NIOS says its certificates have equal recognition with other boards, and the Association of Indian Universities has granted equivalence. Confirm with the specific school or exam you want." },
  { q: "What is the minimum age for NIOS Secondary?", a: "The NIOS regional centre FAQ says Class VIII passed and age 14. Check the current prospectus for the admission year." },
  { q: "Can I transfer subjects I passed to NIOS?", a: "Yes, in some cases. The FAQ says learners from other boards can transfer up to two subjects passed in the last five years, if the subjects are in the NIOS scheme. Ask at admission." },
  { q: "Should I repeat Class 10 or switch to NIOS?", a: "Repeat in school if you failed one or two subjects, your school supports you and a fixed timetable helps. NIOS suits you if you need flexible timing or have passed several subjects. Compare the cost and the deadlines first." },
  { q: "How do I tell my parents I failed Class 10?", a: "Say the result plainly and bring a plan. Name the subjects, the earliest second-exam or NIOS date, and two next steps with costs. Ask one trusted adult to review the plan with you." },
  { q: "Can I work while I clear Class 10?", a: "Learning a skill or helping in a family business is common, but paid work for someone under 18 has legal limits. Check the local rules, and keep the pass as the first goal." },
  { q: "Will failing Class 10 stop me from a good career?", a: "No. A failed result is a setback you can clear, and many routes open after the pass. A cleared pass plus a visible skill is a strong base for earlier financial freedom." },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const chipLabel = { high: "Scalable", mid: "Scalable with a business layer", low: "Not so scalable" };
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-options"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>After failing Class 10 in India, the next step depends on your result: one or two subjects usually means a second or supplementary exam, and a wider fail means a repeat year or NIOS Secondary.</strong>
    A failed result does not close the road to a degree or a good income. The decisions that unlock high income opportunities start with clearing the pass and building one visible skill toward a high-income skill portfolio.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>Read the result exactly.</strong> Compartment, essential repeat and a missed practical lead to different steps, and form dates move fast.</li>
      <li><strong>Clear the pass by the cheapest legal route.</strong> Second exam or supplementary, a repeat year, or NIOS. Polytechnic needs the pass; many ITI trades do too.</li>
      <li><strong>Build one skill beside it.</strong> A small project is the start of a skill portfolio and a faster path to financial freedom.</li>
    </ul>
  </div>

  <p>
    This guide sits in our set of <a href="/blog/career-options/">career options for every stream and degree</a>. If you have cleared the pass and are choosing next steps, read <a href="/blog/stream-selection/career-options-after-10th/">career options after 10th</a>. For Class 12, see <a href="/blog/career-options/what-to-do-after-failing-class-12-india/">what to do after failing Class 12</a>.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="which-result">Which result do you have?</h2>

  <p>"Failed" covers four different situations, and the board decides which one you are in.</p>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Your result</th>
          <th>What the rules say</th>
          <th>Next move</th>
        </tr>
      </thead>
      <tbody>
        {resultRows.map((row) => (
          <tr>
            <td data-label="Your result"><strong>{row.result}</strong></td>
            <td data-label="What the rules say">{row.means}</td>
            <td data-label="Next move">{row.next}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Checked on 30 October 2026 against news reports of CBSE's clarification (All India Radio), Careers360 news and Onmanorama's report of the 18 July 2026 result. These are reports, not the circular itself. Boards change rules each year, so confirm with your school.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Failing a board exam at 15 or 16 feels like the end of the road, and it is not. What hurts most is waiting. A student who picks a route within the first few weeks usually loses far less time than one who waits to feel ready.
    </p>
  </div>

  <h2 id="first-month">The first month</h2>

  <div class="ladder">
    {monthSteps.map((r) => (
      <div class="ladder-step">
        <div class="ladder-step__num">{r.n}</div>
        <div>
          <div class="ladder-step__title">{r.title}</div>
          <p>{r.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="second-exam">The CBSE second exam and supplementary</h2>

  <h3>How the 2026 system worked</h3>

  <p>
    In 2026 the first exam ran from 17 February to 11 March and the second from 15 to 21 May, according to
    Onmanorama. Careers360 news reported 6,68,854 registrations in the compartment and improvement
    categories, of which 85,285 were compartment only.
  </p>

  <p>
    As reported by All India Radio, the first exam was mandatory. The compartment category let a student
    clear the subject not passed, and the improvement category allowed up to three main subjects. Careers360
    reported that the best score from the two exams goes on the final marksheet.
  </p>

  <h3>What the first results showed</h3>

  <p>
    Onmanorama reported that the second-exam result came on 18 July 2026. Over 1.49 lakh students appeared in
    the compartment category and over 52 percent of them cleared.
  </p>

  <p>
    Our reading of that figure is that fewer than half did not clear on that attempt. So keep a backup plan
    ready, such as NIOS, the private route or a repeat year, in case the second exam does not go your way.
  </p>

  <h3>What to ask your school</h3>

  <ul class="check-list">
    <li>Is my result compartment, essential repeat or something else?</li>
    <li>Which component did I fail: theory, practical or internal marks?</li>
    <li>What are the form deadline and the exam date this year?</li>
    <li>Can I attend extra classes for the subject?</li>
  </ul>

  <h3>When a repeat year makes sense</h3>

  <p>
    Repeat if you failed several subjects and need structured teaching. Change something concrete: the teacher, the study method or the timetable, so the second try is not a copy of the first.
  </p>

  <h2 id="private">The private candidate route</h2>

  <p>
    A private candidate studies without being a regular school student and sits the board exam. A Careers360
    page on the 2026-27 CBSE cycle lists Class 10 or 12 candidates who failed in any year from 2021 to 2026,
    and candidates whose 2026 result was Essential Repeat, as able to apply with full subjects.
  </p>

  <p>
    Candidates placed in compartment may apply only for the subject they failed. The same page reported an
    application window of 8 to 24 October 2026, with late fees until 30 October and exams in February 2027
    on a tentative date, so read the current CBSE notice for your year.
  </p>

  <p>
    Before you choose this route, ask your school whether it will hold your seat for Class 11 if you clear the
    exam in the next cycle. Also ask what it needs from you in the meantime.
  </p>

  <h2 id="nios">NIOS Secondary</h2>

  <p>
    For the paperwork behind NIOS recognition, read <a href="/blog/career-options/is-nios-valid-for-college-admission-and-government-jobs-india/">whether NIOS is valid for college admission and government jobs</a>.
  </p>

  <p>
    The National Institute of Open Schooling lets you study at your own pace and sit on-demand exams. This table follows its regional centre FAQ.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Topic</th>
          <th>What the NIOS FAQ says</th>
        </tr>
      </thead>
      <tbody>
        {nios.map((row) => (
          <tr>
            <td data-label="Topic"><strong>{row.fact}</strong></td>
            <td data-label="What the NIOS FAQ says">{row.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    Read on 30 October 2026 from a NIOS regional centre FAQ page. Ages, fees and deadlines change, so check the current NIOS table before you apply.
  </p>

  <h2 id="iti">ITI and polytechnic: what a failed Class 10 allows</h2>

  <p>
    Entry rules depend on the state and the trade. The table shows what published sources say.
  </p>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Path</th>
          <th>Entry rule in the sources</th>
          <th>Where it leads</th>
        </tr>
      </thead>
      <tbody>
        {itiRows.map((row) => (
          <tr>
            <td data-label="Path"><strong>{row.path}</strong></td>
            <td data-label="Entry rule in the sources">{row.entry}</td>
            <td data-label="Where it leads">{row.leads}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    For trade-by-trade detail, read our guides on <a href="/blog/college-degrees/iti-career-options/">ITI career options</a> and the <a href="/blog/college-degrees/polytechnic-diploma-after-10th-which-trade-to-choose/">polytechnic diploma after 10th</a>.
  </p>

  <h2 id="routes">Eight routes, strongest growth first</h2>

  <p>
    The routes are ordered by how far visible skill can lift income, with rank-based and narrow routes last. Each card names who pays, the main hurdle and the next move.
  </p>

  <div class="route-grid">
    {routes.map((r) => (
      <div class="route-card">
        <div class="route-card__top">
          <span class="route-card__n">{r.n}</span>
          <span class={`chip chip--${r.scale}`}>{chipLabel[r.scale]}</span>
        </div>
        <h3>{r.name}</h3>
        <p class="route-card__why">{r.why}</p>
        <p class="route-row route-row--teal"><span>Who pays you</span>{r.pays}</p>
        <p class="route-row route-row--violet"><span>What earns trust</span>{r.trust}</p>
        <p class="route-row route-row--gold"><span>Watch out</span>{r.watch}</p>
        <p class="route-row route-row--teal"><span>How it grows</span>{r.grow}</p>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p>
      <strong>The ownership path:</strong> a small service you can run from home or the neighbourhood, such as phone repair, tuition for younger children, photo editing or an online resale shop, once you are old enough and have your family's support.
    </p>
    <p>
      Write the price and what is included for every job. Keep a list of your customers, and ask each happy one for a referral.
    </p>
  </div>

  <h2 id="age">Skills at 15 or 16: what is realistic</h2>

  <p>
    You are still a school-age learner, so the goal is practice and proof, not a full-time job. Short projects, free samples for a family friend's shop and a simple portfolio are the right size.
  </p>

  <p>
    Selling is a skill you can start now. Learn who pays for your work, how to explain the price in one line and how to follow up politely after a no.
  </p>

  <h2 id="family">Talking to your family</h2>

  <p>
    Bring a plan, not an apology. Parents worry most when there is no plan.
  </p>

  <ul class="check-list">
    <li>Say the exact result: which subjects, which marks.</li>
    <li>Show the earliest second-exam, supplementary or NIOS date.</li>
    <li>Offer two options with costs.</li>
    <li>Ask for one thing: help with the form fee or an adult to review the plan.</li>
  </ul>

  <h2 id="money">Money and scam warnings</h2>

  <p>
    As a rule of thumb and not a research finding, keep the college or course fee near a tenth of the family's total education budget. After a failed exam, the cheapest legal route usually wins: a school form, an on-demand NIOS exam or a government ITI.
  </p>

  <p>
    Be careful with any centre that promises a pass, a fast-track certificate or direct admission for a fee. Check every claim against the board's circular and keep receipts.
  </p>

  <p class="note-line">
    We give no salary figures because we found no dependable source for these routes. Read live notices and ask people in the work.
  </p>

  <h2 id="checkpoint">The 4-Checkpoint Protocol for your route</h2>

  <p>
    Before a route takes a year or more, test it with <strong>The 4-Checkpoint Protocol</strong>: Biology, Context, Market and Survival.
  </p>

  <div class="protocol">
    {protocolItems.map((item) => (
      <div class="protocol-row">
        <div class="protocol-row__num">{item.num}</div>
        <div>
          <div class="protocol-row__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="gates">The 3 Gates: proof before commitment</h2>

  <p>
    <strong>The 3 Gates</strong> check whether your effort turns into work other people rely on. Run one small project through all three before you commit to a long course.
  </p>

  <div class="gates-block">
    <div class="gates-row">
      {gateItems.map((item) => (
        <div class="gate">
          <span class="gate__num">{item.label}</span>
          <span class="gate__name">{item.title}</span>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </div>

  <h2 id="mistakes">Expensive mistakes</h2>

  <div class="mistake-list">
    {mistakes.map((m) => (
      <div class="mistake">
        <div class="mistake__num">{m.num}</div>
        <div>
          <div class="mistake__title">{m.title}</div>
          <p>{m.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="next-step">What to do next</h2>

  <p>
    Get the marksheet read, choose one route to a pass and write down its first deadline. Start one small project beside it.
  </p>

  <p>
    A specialist can look at your marks, interests and family situation with you, which cuts the guesswork after a setback. A sensible first step is <a href="/services/career-counselling-and-career-guidance/career-counselling-for-dropouts/">career counselling for students who need a restart</a>, or <a href="/services/career-counselling-and-career-guidance/career-counselling-after-10th/">career counselling after 10th</a> once you have a pass.
  </p>

