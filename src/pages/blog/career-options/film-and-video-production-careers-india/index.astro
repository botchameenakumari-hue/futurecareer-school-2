const description = "Film and video production careers in India: direction, camera, editing, sound, production management and digital roles, skills, a free-first plan and honest limits.";
const seoDescription = "Make short films and finish them. A reel opens doors.";
const canonical = "https://futurecareerschool.com/blog/career-options/film-and-video-production-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How do I start in film?",
    "Make short films, assist on projects and build a reel."
  ],
  [
    "Do I need film school?",
    "Training helps but a strong reel and contacts matter. Read what employers expect."
  ],
  [
    "Which role should I choose?",
    "Try several, then deepen one craft."
  ],
  [
    "Do I need expensive equipment?",
    "No. Start with what you have and borrow or rent when needed."
  ],
  [
    "How do I get paid work?",
    "Offer services to local businesses and events."
  ],
  [
    "Is it stable?",
    "Often project-based. Plan finances and keep a skills backup."
  ],
  [
    "Do I need permissions?",
    "Yes, for locations, music and people on camera."
  ],
  [
    "Will AI replace filmmakers?",
    "Routine steps shrink. Story and taste remain."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
