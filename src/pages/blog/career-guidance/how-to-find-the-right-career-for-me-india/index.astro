const canonical =
  'https://futurecareerschool.com/blog/career-guidance/how-to-find-the-right-career-for-me-india';
const publishedDateISO = '2026-07-10';
const publishedDateLabel = '10 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'myth', label: 'Why a quiz or "follow your passion" keeps failing you' },
  { id: 'same-confusion', label: 'The same confusion at every life stage, not just after 12th' },
  { id: 'signal-stack', label: 'Meet the 4 Fit Signals' },
  { id: 'signal-1', label: 'Signal 1: Attention - what pulls focus without being asked' },
  { id: 'signal-2', label: 'Signal 2: Feedback - what people already trust you to do well' },
  { id: 'signal-3', label: 'Signal 3: Friction - what energises you vs quietly drains you' },
  { id: 'signal-4', label: 'Signal 4: Market - does the market actually pay for this now' },
  { id: 'market-check-how', label: 'How to actually run the Market Signal check' },
  { id: 'combine', label: 'Put all four signals together before you commit' },
  { id: 'worked-example', label: 'A worked example: scoring one real option' },
  { id: 'not-perfect', label: 'You do not have to get this right on the first try' },
  { id: 'experiment', label: 'A short first experiment before you commit years' },
  { id: 'checklist', label: 'Your signal-gathering checklist' },
  { id: 'mistakes', label: 'Mistakes people make chasing "the right career for me"' },
  { id: 'sources', label: 'Check the sources behind these numbers' },
  { id: 'faq', label: 'FAQs' },
];

const mythPoints = [
  {
    label: 'What a one-off quiz can actually tell you',
    items: [
      'A rough starting label based on how you answered a fixed set of questions on one particular day, in one particular mood.',
      'A vocabulary for talking about yourself - useful for conversation, weak as evidence on its own.',
      'A shortlist of occupations that share a broad theme, not a verdict on which one fits your specific life.',
    ],
  },
  {
    label: 'What it quietly leaves out',
    items: [
      'Whether real employers or clients currently pay for that exact combination of skill and interest right now.',
      'Whether you can tolerate the boring, repetitive 80% of the work, not just the appealing 20% the quiz description highlights.',
      'Whether the result would even repeat if you retook the same quiz a few weeks later - for some popular personality tools, it often does not.',
    ],
  },
];

const confusionPoints = [
  {
    label: 'It is not a 12th-grade problem anymore',
    body: "LinkedIn's 2026 India survey found that professionals from Gen Z to Baby Boomers report similar confusion about career direction, made worse by AI-led hiring changes - this is not a school-leaver problem that adults grow out of once they get a job.",
  },
  {
    label: 'Most careers were never actually chosen',
    body: 'Career coach Sandeep Anand\'s read on the Indian professional pattern is blunt and mostly accurate: many capable professionals entered a field through board-exam scores, took a first job through campus placement, and then rode the inertia of those early choices for a decade - never actually testing whether the field fit them.',
  },
  {
    label: 'A large share of graduates are already in the wrong lane',
    body: "Mercer Mettl's India Graduate Skill Index 2025 found overall graduate employability at just 42.6%, down from 44.3% a year earlier - and employability in non-technical fields like analytics, HR, and digital marketing fell from 48.3% to 43.5% over the same period. A separate review of India's higher-education mismatch found a large share of graduates sitting in a field that does not match their own tested strengths, with more than half ending up in low-skill roles that never needed the degree at all.",
  },
];

const signalDefinitions = [
  {
    signal: 'Attention Signal',
    measures: 'What pulls your focus without anyone assigning it to you.',
    weak: '"I think I would probably enjoy this."',
    strong: 'You lose track of time doing it, and a structured interest tool built on real research keeps placing you in the same zone across repeat attempts.',
  },
  {
    signal: 'Feedback Signal',
    measures: 'What other people already trust you to handle well, unprompted.',
    weak: '"I feel like I am decent at this."',
    strong: 'Several different people, on separate occasions, have specifically praised the same skill without you asking them to.',
  },
  {
    signal: 'Friction Signal',
    measures: 'Which tasks energise you and which quietly drain you, even when you are competent at both.',
    weak: '"I can do this if I have to."',
    strong: 'You choose to do the task again on your own time, without pay or pressure, and still feel steady afterward.',
  },
  {
    signal: 'Market Signal',
    measures: 'Whether real employers or clients currently pay for this exact combination, not just the general field name.',
    weak: '"Someone online said this field is booming."',
    strong: 'Real job postings, hiring data, or paying clients exist for the specific skill combination you are testing.',
  },
];

const marketCheckSteps = [
  {
    title: 'Write the exact combination, not the field name',
    body: 'Not "marketing" - "content strategy for a D2C skincare brand" or "process automation for a small logistics team." A vague field name almost always looks like it pays. A specific combination either shows real postings or it does not.',
  },
  {
    title: 'Pull 15-20 real job postings for that exact combination',
    body: 'Search LinkedIn Jobs, Naukri, and Indeed for your specific combination in the cities or remote setups you would actually accept. Note the skills, tools, and years-of-experience asks that repeat across postings - not just the first listing you open.',
  },
  {
    title: 'Check who is actually posting, not just how many posts exist',
    body: 'A combination with 40 postings from three staffing agencies re-posting the same role is weaker evidence than 12 postings from 12 different companies or direct clients.',
  },
  {
    title: 'Cross-check the real pay range against at least a few sources',
    body: 'Use the salary bands posted directly on job listings where visible, plus a salary-aggregator site as a second check. One inflated screenshot from social media is not a market signal. A pay range that repeats across independent sources is.',
  },
  {
    title: 'Message two working professionals already doing the exact role',
    body: 'Ask what the role actually pays at entry level in your city or remote setup, and what a realistic first year looks like day to day. One real conversation corrects more bad assumptions than an hour of scrolling job boards.',
  },
];

const signalChecklist = [
  {
    signal: 'Attention',
    action: 'Take the free O*NET Interest Profiler (about 20 minutes) and read your top result codes against real occupations on My Next Move - or run a structured career test like the career-choosing test for a second data point.',
  },
  {
    signal: 'Feedback',
    action: 'Message five people who have actually seen you work and ask the exact question in the Feedback Signal section above. Write down their answers word for word, not your summary of them.',
  },
  {
    signal: 'Friction',
    action: 'Look back at your last couple of weeks of tasks and sort them using the friction table above - which ones did you keep doing without being asked, and which ones did you keep avoiding?',
  },
  {
    signal: 'Market',
    action: 'Run the 5-step Market Signal check below on your top shortlisted option before you spend real money or time committing to it.',
  },
];

const attentionPoints = [
  {
    label: 'The research behind the Attention Signal',
    body: "Psychologist John Holland's RIASEC model - six broad interest types, tested and refined for more than 60 years - is the theory behind the free O*NET Interest Profiler, built and maintained by the US Department of Labor. Decades of research reviews on Holland's model have consistently linked a strong match between your interest type and your actual work environment to higher job satisfaction and longer retention, which is why the US Department of Labor, the military, and universities worldwide still use it.",
  },
  {
    label: 'Why this beats a generic personality label',
    body: "RIASEC measures interest, not raw ability or personality type - and interest-pattern tools like it have held up better as long-term satisfaction predictors than personality-only labels. The free O*NET Interest Profiler takes about 20 minutes, rates concrete work activities instead of abstract statements, and links your result to real occupation data through the My Next Move database - a stronger starting point than a 10-question personality quiz built for entertainment.",
  },
];

const feedbackPoints = [
  {
    label: 'Most people cannot see their own strongest signal',
    body: 'Gallup has measured this directly: across its workforce research, only about 3% of employees can strongly agree they clearly recognise and actively use their own strengths day to day. People routinely take their sharpest, most repeatable skill for granted precisely because it feels easy to them - which is exactly why it needs outside confirmation, not just self-reflection.',
  },
  {
    label: 'One trait research does back, but only one',
    body: "Across large meta-analyses spanning decades of workplace research, conscientiousness - reliability, follow-through, and organised effort - is the single Big Five trait that predicts job performance most consistently across almost every occupation studied. It is not a flashy trait and it rarely shows up in a fun quiz result, but multiple people independently telling you that you follow through, finish what you start, or can be trusted without checking up on you is real evidence, not a compliment to brush off.",
  },
];

const frictionRows = [
  { type: 'Deep focus on one hard problem for a long stretch', energises: 'People who need extended uninterrupted time', drains: 'People who need frequent variety and social contact' },
  { type: 'Constant context-switching between people and requests', energises: 'People who like variety and think out loud', drains: 'People who need to finish one thing before starting another' },
  { type: 'Repeating the same process with high precision', energises: 'People who find calm in structure and detail', drains: 'People who feel bored without novelty' },
  { type: 'Persuading or negotiating with someone who can say no', energises: 'People comfortable with friction and rejection', drains: 'People who find repeated rejection genuinely costly' },
  { type: 'Working mostly alone with little day-to-day feedback', energises: 'People who recharge in solitude', drains: 'People who need regular social confirmation to stay motivated' },
];

const marketPoints = [
  {
    label: 'The employability gap is real and it is widening in some fields',
    body: "India's overall graduate employability sits at 42.6% by Mercer Mettl's count, and non-technical employability specifically has fallen. Meanwhile the Wheebox-ETS India Skills Report 2026 shows overall employability climbing from 46.2% in 2022 to 56.35% in 2026 - both can be true at once: the market is getting more selective and more skill-literate at the same time, which raises the cost of guessing.",
  },
  {
    label: 'Even employed professionals feel behind',
    body: "LinkedIn's 2026 India data found that a majority of Indian professionals plan to look for a new role in 2026, yet 84% feel unprepared for an AI-shaped hiring process, and applicants per open role have more than doubled since early 2022. Feeling behind is now the norm, not a sign that something is uniquely wrong with you.",
  },
  {
    label: 'The skill map itself keeps moving',
    body: "The World Economic Forum's Future of Jobs Report 2025 puts 39% of workers' core skills at risk of changing by 2030 - down slightly from 44% in 2023, but still close to two in five. A career fit you confirm today still needs a market recheck every so often, not a one-time verdict you never revisit.",
  },
];

const combineRows = [
  { pattern: 'Strong Attention + strong Feedback, weak Market', meaning: 'A real hobby or side strength, not yet a career bet. Recheck the actual market for this specific combination before treating it as your main plan.' },
  { pattern: 'Strong Market, weak Attention and Feedback', meaning: 'A paycheck path. Usable as a bridge or a stabiliser, risky as a lifelong bet unless you can build real proof and genuine interest over time.' },
  { pattern: 'Strong Attention, weak Feedback', meaning: 'An untested interest. Build one small, checkable proof piece before you treat the interest as a real plan.' },
  { pattern: 'Strong Feedback, weak Friction fit', meaning: "The golden-handcuffs pattern - you are good at it, but the daily reality wears you down. Sustainable only with real boundaries, a hybrid role, or a planned exit, not sheer willpower." },
  { pattern: 'All four signals reasonably strong', meaning: 'Move. Build your first proof asset in this lane and treat it as the primary bet, while keeping one adjacent backup lane warm.' },
];

const workedExampleRows = [
  {
    signal: 'Attention',
    evidence: 'The O*NET Interest Profiler placed them in the same "Conventional + Enterprising" pattern twice, three weeks apart. They also noticed they kept reorganising a messy spreadsheet at their internship for fun, without anyone asking.',
    read: 'A real Attention signal, not a one-off quiz fluke.',
  },
  {
    signal: 'Feedback',
    evidence: 'Out of five people asked the exact Feedback question, three independently said some version of "you catch mistakes nobody else notices" - a manager, a classmate, and a client, on separate occasions.',
    read: 'A real Feedback signal on the same specific skill.',
  },
  {
    signal: 'Friction',
    evidence: 'They chose to rebuild a broken tracking sheet on a weekend without being asked, and still felt steady afterward instead of drained.',
    read: 'A real Friction fit, not just tolerance for the task.',
  },
  {
    signal: 'Market',
    evidence: 'The 5-step Market Signal check turned up 14 real postings for the exact combination in their target cities, from 11 different companies, with a pay range that repeated across independent sources.',
    read: 'A real Market signal for the exact combination, not just the general field name.',
  },
];

const experimentCards = [
  {
    badge: 'School and early explorers',
    body: 'The test is not a lifetime decision. Try one small, real activity tied to a shortlisted interest - a mini project, a school event you help run, one explanation video - and notice honestly whether you kept going without being told to.',
    link: { href: 'https://futurecareerschool.com/services/assessments/class-11-to-12', label: 'Class 11-12 assessments' },
  },
  {
    badge: 'College students and freshers',
    body: 'Multi-passionate and cannot narrow down? Test one interest cluster at a time instead of waiting for total certainty - one small project, one internship-style task, or one informational conversation with someone doing the actual work.',
    link: { href: 'https://futurecareerschool.com/services/assessments/graduates-and-early-professionals', label: 'Graduate and early-professional assessments' },
  },
  {
    badge: 'Working professionals and career changers',
    body: 'You do not need to quit first. Build one adjacent proof piece - a case note, a small side project, a documented process improvement - inside or beside your current role, at whatever weekly pace your job and life genuinely allow.',
    link: { href: 'https://futurecareerschool.com/services/assessments/working-professionals-and-career-changers', label: 'Working-professional assessments' },
  },
];

const mistakeCards = [
  {
    num: '01',
    title: 'Waiting for one quiz to hand you a verdict',
    body: "Popular personality tools built on the Myers-Briggs style framework have a well-documented reliability problem - research on the format has found that a large share of people get a different four-letter type when they retake the same test just weeks later. Treating any single quiz result as a final answer builds a plan on evidence that will not hold up on a second look.",
    fix: 'Do this instead: treat any single quiz as one input toward the Attention Signal only, then still gather Feedback, Friction, and Market evidence before you commit.',
  },
  {
    num: '02',
    title: 'Treating "I could see myself doing that" as proof',
    body: 'Imagining yourself in a role is not the same as testing your Attention, Feedback, Friction, or Market signal against it. A vivid daydream and a checked signal feel similar in your head and are completely different in what they predict.',
    fix: 'Do this instead: turn the daydream into one small, real task in that direction this week and see if you actually finish it without being pushed.',
  },
  {
    num: '03',
    title: 'Confusing a loud compliment for a tested skill',
    body: 'Gallup\'s own research found only about 3% of employees can strongly agree they actually recognise and use their strengths - most people either overrate a skill because it feels easy, or underrate it for the same reason. "Everyone says I am good at this" needs one real, checkable outcome behind it before you build a plan on it.',
    fix: 'Do this instead: run the five-person Feedback question from Signal 2 and only count a skill as confirmed once three or more answers name the same thing unprompted.',
  },
  {
    num: '04',
    title: 'Chasing the field everyone calls "booming" without checking your Friction fit',
    body: "Non-technical graduate employability in India dropped from 48.3% to 43.5% in a single year according to Mercer Mettl's data, partly because people chase a labelled field without checking whether the actual daily task mix fits how they work. A field can be genuinely growing and still be the wrong fit for your specific energy pattern.",
    fix: 'Do this instead: before chasing a "booming" label, run it through the friction table above and ask three people already working in it what an average Tuesday actually looks like.',
