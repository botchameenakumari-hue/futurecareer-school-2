---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Dual-Career Couples: How to Plan Two Careers Together in India";
const seoTitle = "Dual-Career Couples: How to Plan Two Careers Together in India";
const description = "Dual-career couples in India: how to plan relocation, childcare, study and job changes so both partners can grow, with a decision method and honest limits.";
const seoDescription = "Plan together with real numbers, not assumptions.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/dual-career-couples-how-to-plan-two-careers-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How do dual-career couples decide whose job comes first?",
    "By sharing goals, mapping tradeoffs and agreeing a fair rule that is reviewed."
  ],
  [
    "Is it fair to alternate priority?",
    "It can be. Agree the rule openly and review it."
  ],
  [
    "How do we handle childcare?",
    "Map tasks and costs, and plan a realistic week together."
  ],
  [
    "What if one partner wants a break?",
    "Agree a savings buffer and a return plan."
  ],
  [
    "Can we both change careers?",
    "Stagger changes and keep an income buffer."
  ],
  [
    "What about elders?",
    "Discuss care tasks and costs early."
  ],
  [
    "Should we get outside advice?",
    "Mentors or a qualified counsellor can help."
  ],
  [
    "Will AI change this planning?",
    "It speeds research. The decisions remain yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-guidance"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
