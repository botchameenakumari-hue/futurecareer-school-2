---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Myths About Choosing a Career in India and What to Do Instead";
const seoTitle = "Myths About Choosing a Career in India and What to Do Instead";
const description = "Myths about choosing a career in India: one right career, marks decide everything, passion first, and more, with what to check instead and a test for each belief.";
const seoDescription = "Test each belief with a small fact before it shapes a big decision.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/myths-about-choosing-a-career-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is there one right career for everyone?",
    "No. Several paths can fit, and people change."
  ],
  [
    "Do marks decide everything?",
    "They matter for some doors. Skills and proof matter for others."
  ],
  [
    "Should I follow passion only?",
    "Test passion with a small project and add skill."
  ],
  [
    "Is a famous course a guarantee?",
    "No. Ask alumni and verify outcomes."
  ],
  [
    "Can I switch careers later?",
    "Often yes, with a bridge project."
  ],
  [
    "How do I deal with family beliefs?",
    "Bring facts and invite a joint conversation."
  ],
  [
    "How do I test a belief?",
    "Use a small fact, trial or conversation."
  ],
  [
    "Can AI choose my career?",
    "It can help gather facts. The choice is yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-guidance"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
