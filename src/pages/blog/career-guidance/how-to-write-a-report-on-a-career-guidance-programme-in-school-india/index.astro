---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "How to Write a Report on a Career Guidance Programme in School";
const seoTitle = "How to Write a Report on a School Career Guidance Programme";
const description = "How to write a report on a career guidance programme held in a school in India: structure, what to record, a sample outline, follow-up steps and mistakes to avoid.";
const seoDescription = "A good report records what happened and what changes next.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/how-to-write-a-report-on-a-career-guidance-programme-in-school-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What should a school career guidance report include?",
    "Aim, plan, attendance, questions, feedback and next steps."
  ],
  [
    "How long should it be?",
    "Two or three pages are usually enough."
  ],
  [
    "Should I include photos?",
    "Only with school permission."
  ],
  [
    "Should I name students?",
    "Avoid it without permission."
  ],
  [
    "How do I write the aim?",
    "One or two clear lines."
  ],
  [
    "Who should read the report?",
    "The principal and the teachers involved."
  ],
  [
    "Can I use a template?",
    "Yes, adapt it to the programme."
  ],
  [
    "Can AI write the report?",
    "It can polish wording. The facts must come from your notes."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

