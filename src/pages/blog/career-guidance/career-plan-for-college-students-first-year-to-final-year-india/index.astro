---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Career Plan for College Students: First Year to Final Year in India";
const seoTitle = "Career Plan for College Students: First Year to Final Year in India";
const description = "Career plan for college students in India: what to do in each year, skills, projects, internships, placement season and honest limits.";
const seoDescription = "Do the right small thing each year instead of everything at the end.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/career-plan-for-college-students-first-year-to-final-year-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "What should I do in first year?",
    "Build study habits, explore clubs and basic skills."
  ],
  [
    "When should I do internships?",
    "Often from second or third year. Check college rules."
  ],
  [
    "How many projects do I need?",
    "A few well documented ones are enough."
  ],
  [
    "How do I prepare for placements?",
    "Practise aptitude, communication and interviews in the final year, and keep your proof ready."
  ],
  [
    "What if I start late?",
    "Start now with one skill and one project."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="career-guidance"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>College students who plan year by year often arrive at placement season with proof of skill, because the first year builds habits, the second year builds one skill, the third year builds projects and internships and the final year focuses on applications, so write what you will do each year, review it every term and adjust with real notices.</strong> The decisions that unlock high income opportunities include choosing a branch early and building a high-income skill portfolio of finished work, because AI can handle routine tasks but cannot take responsibility for your results.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li><strong>Short answer:</strong> Do the right small thing each year instead of everything at the end.</li>
      <li><strong>Evidence:</strong> This page quotes no statistics or pay figures and was not built from fetched sources. Ten live notices and two conversations, as set out below, are the best way to get current local evidence.</li>
      <li><strong>Growth:</strong> Clear proof and finished work support an earlier path to financial freedom.</li>
