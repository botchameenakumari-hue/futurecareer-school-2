const description = "Career awareness activities for secondary school students in India: classroom ideas, home tasks, a term calendar, how to measure what changed and mistakes to avoid.";
const seoDescription = "Awareness grows when students do small real tasks, not just listen.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/career-awareness-activities-for-secondary-school-students-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Which activities work for class 9 and 10?",
    "Worker interviews, job notice reading, interest maps and mini projects."
  ],
  [
    "How often should schools run them?",
    "A small activity every month is a good start."
  ],
  [
    "Do students need guest speakers?",
    "They help, with prepared questions."
  ],
  [
    "Where do facts come from?",
    "Official exam and institution pages."
  ],
  [
    "How do we avoid pressure?",
    "Present options and let students reflect."
  ],
  [
    "How can parents help?",
    "Share their work and listen."
  ],
  [
    "Can students run activities?",
    "Yes, with teacher guidance."
  ],
  [
    "Can AI help plan?",
    "It can draft ideas. Teachers must adapt them."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
