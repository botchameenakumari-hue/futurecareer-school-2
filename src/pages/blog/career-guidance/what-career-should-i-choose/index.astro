---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'What Career Should I Choose? The 5-Step Decision Ladder That Actually Ends the Indecision';
const description =
  'What career should I choose: a 5-step decision ladder - real shortlist, hard-constraint cut, weighted scoring, one cheap test, decide-by date - instead of waiting to feel certain.';
const canonical =
  'https://futurecareerschool.com/blog/career-guidance/what-career-should-i-choose';
const publishedDateISO = '2026-08-16';
const publishedDateLabel = '16 August 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'myth', label: 'Why "just pick something" and "wait until you are sure" both fail' },
  { id: 'ladder', label: 'Meet the 5-Step Decision Ladder' },
  { id: 'step-1', label: 'Step 1: Write the real shortlist, not the daydream list' },
  { id: 'step-2', label: 'Step 2: Cut by hard constraints before you judge appeal' },
  { id: 'step-3', label: 'Step 3: Score what survives against your own weighted criteria' },
  { id: 'step-4', label: 'Step 4: Run one cheap real-world test before you commit years' },
  { id: 'step-5', label: 'Step 5: Set a decide-by date and commit with a review checkpoint' },
  { id: 'traps', label: 'The 4 traps that keep this question open forever' },
  { id: 'no-shortlist', label: 'What if you do not have a shortlist at all' },
  { id: 'tie', label: 'How to break a tie between two options that both look right' },
  { id: 'mistakes', label: 'Mistakes people make trying to decide' },
  { id: 'sources', label: 'Check the sources behind these claims' },
  { id: 'faq', label: 'FAQs' },
];

const mythPoints = [
  {
    label: 'What "just pick something and figure it out" skips',
    items: [
      'Whether the option you grabbed under pressure survives contact with a real constraint - money, family, or a fixed timeline - once you are already six months in.',
      'Whether you actually compared it against your other real options, or just picked whichever one happened to come up first.',
      'Whether the appeal was ever tested against the real day-to-day work, or only against the idea of the work.',
    ],
  },
  {
    label: 'What "wait until you feel completely sure" skips',
    items: [
      'That certainty about an untested option is not evidence - it is usually just the absence of information that would complicate the picture.',
      'That every month spent waiting to feel sure is a month not spent gathering the one thing that would actually make you sure: a real test.',
      'That most career decisions are not one-way doors - they can be corrected later, which makes "waiting for certainty" a worse trade than it feels like in the moment.',
    ],
  },
];

const ladderSteps = [
  {
    num: '01',
    title: 'Write the real shortlist, not the daydream list',
    body: 'Separate what you are actually considering from what you are only curious about, and cap the real list at three or four options.',
    note: 'A shortlist of nine options is not a shortlist. It is the reason you still have not decided.',
  },
  {
    num: '02',
    title: 'Cut by hard constraints before you judge appeal',
    body: 'Screen out anything that fails a non-negotiable first - budget, family expectations, location, a minimum qualification, or a fixed timeline - before you let yourself get attached to it.',
    note: 'Judging appeal before constraints means falling for an option you were always going to have to drop.',
  },
  {
    num: '03',
    title: 'Score what survives against your own weighted criteria',
    body: 'List the four or five things that matter most to you, weight them, and score each surviving option against your own numbers instead of a vague gut feeling.',
    note: 'A weighted score you can defend beats a hunch you cannot explain to yourself at 2 a.m.',
  },
  {
    num: '04',
    title: 'Run one cheap real-world test before you commit years',
    body: 'Pick the top one or two options and test the actual work - not the idea of it - through a small project, a shadow day, a paid or unpaid trial task, or a direct conversation with someone three to five years ahead of you.',
    note: 'A test that costs a weekend can save you two years. Skipping it to save the weekend is the expensive choice.',
  },
  {
    num: '05',
    title: 'Set a decide-by date and commit with a review checkpoint',
    body: 'Pick a specific date, write down what you will do when it arrives, and commit to the option that is good enough on your own criteria - then schedule one honest review instead of leaving the door open forever.',
    note: 'A committed "good enough" choice with a review date consistently beats an open-ended search for the perfect one.',
  },
];

const trapCards = [
  {
    label: 'Choice overload from too many open options',
    body: 'Research on "overchoice" has repeatedly found that once a choice set grows past a handful of live options, decision confidence and satisfaction drop even as the options stay equally good on paper - more open tabs do not mean a clearer answer, they mean a heavier one.',
  },
  {
    label: 'Maximizing instead of satisficing',
    body: "Psychologist Herbert Simon's concept of satisficing - choosing the first option that clears your own bar instead of hunting for the mathematically best one - was later tested directly against maximizing by Barry Schwartz and colleagues, who found maximizers report lower decision satisfaction and more regret than satisficers, despite often ending up with objectively similar outcomes.",
  },
  {
    label: 'The sunk-cost pull toward a bad-fit option',
    body: 'Years already spent on a stream, a degree, or a first job create a psychological pull to keep going in that direction even when a fresh look says otherwise - classic sunk-cost reasoning, well documented across behavioural economics, that treats unrecoverable past cost as if it were still a real reason to continue.',
  },
  {
    label: 'A plan with no specific next action',
    body: 'A vague intention like "I will decide soon" rarely converts into action. Decades of implementation-intention research show that a concrete "if this date arrives, then I do this specific thing" plan produces dramatically higher follow-through than an open-ended goal on its own.',
  },
];

const shortlistCards = [
  {
    badge: 'School and early explorers',
    body: 'Your real shortlist is usually shorter than it feels - most students are actually choosing between two or three genuine contenders, with the rest being options a relative mentioned once. Write down only the ones you have taken a real step toward.',
    link: { href: 'https://futurecareerschool.com/services/assessments/class-11-to-12', label: 'Class 11-12 assessments' },
  },
  {
    badge: 'College students and freshers',
    body: 'If your shortlist keeps growing every time you talk to someone new, that is choice overload, not open-mindedness. Freeze the list for one week, then apply the Ladder to whatever is still on it.',
    link: { href: 'https://futurecareerschool.com/services/assessments/graduates-and-early-professionals', label: 'Graduate and early-professional assessments' },
  },
  {
    badge: 'Working professionals and career changers',
    body: 'Your shortlist likely includes staying put with real changes, not only leaving. Write "stay and reshape the role" down as a genuine option next to any external ones - dropping it before you compare is how good current roles get abandoned too early.',
    link: { href: 'https://futurecareerschool.com/services/assessments/working-professionals-and-career-changers', label: 'Working-professional assessments' },
  },
];

const scoringRows = [
  { criterion: 'Market demand in India right now', weight: '3', optionA: '4 (12)', optionB: '2 (6)' },
  { criterion: 'Fits my strongest current skill', weight: '3', optionA: '3 (9)', optionB: '5 (15)' },
  { criterion: 'Realistic income growth over 5 years', weight: '2', optionA: '4 (8)', optionB: '3 (6)' },
  { criterion: 'Fits my family and location constraints', weight: '2', optionA: '5 (10)', optionB: '4 (8)' },
  { criterion: 'Genuinely holds my attention day to day', weight: '1', optionA: '3 (3)', optionB: '4 (4)' },
];

const mistakeCards = [
  {
    num: '01',
    title: 'Treating a bigger shortlist as more thorough research',
    body: "Once a choice set grows past a handful of live options, added research on choice overload has found decision confidence tends to fall, not rise - more names on the list is more weight to carry, not more clarity gained.",
  },
  {
    num: '02',
    title: 'Scoring appeal before applying hard constraints',
    body: 'Falling for an option before checking whether it clears your basic constraints means you now have to break your own heart to drop it - screen for constraints first and appeal has nothing left to attach to unfairly.',
  },
  {
    num: '03',
    title: 'Letting years already invested make the decision for you',
    body: 'Sunk-cost reasoning treats time and money already spent as if they were still a reason to continue, when the only real question is which option is the better bet from today forward, regardless of what it cost to get here.',
  },
  {
    num: '04',
    title: 'Setting an intention instead of a specific plan',
    body: '"I will decide by the end of the month" without a specific date, a specific next action, and a specific trigger rarely gets kept. A vague goal and a bound plan feel similar to write down and behave completely differently in practice.',
  },
  {
    num: '05',
    title: 'Testing your feelings about the option instead of the option itself',
    body: 'Imagining how you would feel doing the job is not the same as testing whether you actually enjoy the real daily task mix. A vivid imagined version and a checked real version predict very different outcomes.',
  },
];

const faqItems = [
  {
    q: 'What career should I choose if I genuinely have no idea?',
    a: "Start one level earlier than this decision process: you need raw candidates before you can run a shortlist through it. Gather evidence about what actually holds your attention, what people already trust you to do well, and what the market pays for right now, then bring three real candidates back here to run through the 5-Step Decision Ladder.",
  },
  {
    q: 'What if I keep changing my mind about what career to choose?',
    a: 'Changing your mind before you have run a real test is normal and not a character flaw. Changing your mind after every small test, with no pattern building, usually means the tests were too small or too imagined to generate real signal - make the next one a real task with a real outcome, not another thought experiment.',
  },
  {
    q: 'Is it normal to not know what career to choose at 25 or 30?',
    a: "Yes. Career confusion shows up across age groups in India, not only among school leavers - most people who look certain from the outside have simply run more real tests than you have seen, not fewer doubts than you.",
  },
  {
    q: 'How long should it actually take to choose a career?',
    a: 'There is no fixed number, and treating this as an open-ended search is exactly what produces years of drift. Set your own decide-by date based on how much real testing you can realistically do before then, commit to whichever option clears your bar at that point, and schedule a review instead of promising yourself an indefinite search.',
  },
  {
    q: 'What if my shortlist has no clear winner even after scoring it?',
    a: 'A near-tie after honest scoring is common, not a sign you scored it wrong. Use the tie-break test: whichever option has the cheaper, faster real-world test available, or whichever is easier to reverse if it turns out wrong, is usually the better one to commit to first.',
  },
  {
    q: 'Should I choose a career based on what I am good at or what pays well?',
    a: "This decision process treats both as inputs to weight, not as a forced either-or. Put both on your own criteria list in Step 3 with honest weights for your situation, and let the scored total decide instead of arguing the two against each other in your head indefinitely.",
  },
  {
    q: 'What is the difference between this and taking a career aptitude test?',
    a: 'An aptitude or interest test can help generate candidates for your shortlist by showing you where your strengths and interests point. This process picks up from there - it is about the mechanics of actually deciding between real options you already have in front of you, not about generating new ones.',
  },
  {
    q: 'What if the people around me disagree with the option I am leaning toward?',
    a: "Their disagreement is real information worth adding to Step 3 as a weighted criterion if it matters to you - family and social expectations belong in your own scoring, not outside it. What it should not do is skip the process entirely and become the decision by itself, since it is one input among several, not a veto.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="career-guidance"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>What career should I choose starts with turning a foggy, open-ended question into a short, real list, then deciding through a repeatable process - not by waiting to feel certain or grabbing the first option under pressure.</strong>
    Most advice on this exact question either tells you to "just decide already" or to "wait until you know for sure." Both leave you stuck in different ways, and both quietly cost you years you could be spending building a real skill portfolio toward a higher income and earlier financial freedom. What actually moves people from stuck to decided is a short sequence: a real shortlist, a hard-constraint cut, a weighted score, one cheap real-world test, and a decide-by date you actually keep.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>"What career should I choose" is rarely a knowledge problem - it is usually a decision-process problem, and a repeatable process beats waiting for certainty or picking under pressure.</li>
      <li>The 5-Step Decision Ladder: real shortlist, hard-constraint cut, weighted scoring, one cheap real test, decide-by date with a review checkpoint.</li>
      <li>Research on choice overload shows that more open options usually lower decision confidence, not raise it - a shorter honest shortlist is the fix, not more research.</li>
      <li>"Good enough and committed" beats "perfect and still searching" - studies comparing satisficers and maximizers found maximizers end up less satisfied with their decisions, not more.</li>
      <li>Every year spent undecided is a year not spent building the high-income skill portfolio that actually compounds - weight growth headroom and AI-era durability in Step 3, not only current pay.</li>
      <li>If you do not have a real shortlist yet, that is a different, earlier problem - gather self-evidence first, then bring real candidates back to this process.</li>
    </ul>
  </div>

  <p>
    If you do not yet have real options to run through this process, the earlier-stage question - what actually pulls your attention, what people trust you to do well, what the market pays for - is answered in <a href="/blog/career-guidance/how-to-find-the-right-career-for-me-india/">how to find the right career for me in India</a>. If you already have a shortlist but are unsure which factors should carry the most weight, <a href="/blog/career-guidance/factors-to-consider-when-choosing-a-career/">which factor is important while choosing a career</a> breaks down the 8 factors this process asks you to score in Step 3.
  </p>

  <nav class="jump-nav" aria-label="Jump to section">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="myth">Why "just pick something" and "wait until you are sure" both fail</h2>

  <p>
    Ask "what career should I choose" out loud and you will usually get one of two answers: pick something and figure it out, or wait until you feel completely sure. Both sound like advice. Neither one is actually a process.
  </p>

  <div class="comparison-grid">
    {mythPoints.map((item) => (
      <div class:list={['compare-card', item.label.startsWith('What "just pick') ? 'compare-card--gold' : 'compare-card--teal']}>
        <div class="compare-card__label">{item.label}</div>
        <ul>
          {item.items.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="note-line">
    Neither impulse is stupid - both are trying to solve real discomfort. The problem is that neither one is a repeatable process you can run the same way the next time you face a hard choice.
  </p>

  <h2 id="ladder">Meet the 5-Step Decision Ladder</h2>

  <p>
    Instead of choosing between "decide fast" and "wait forever," run every real option through the same five-step sequence. Each step removes a specific kind of confusion, in order, so you are never trying to solve five problems at once.
  </p>

  <div class="protocol-stack">
    {ladderSteps.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
          <div class="checkpoint__note">{item.note}</div>
        </div>
      </div>
    ))}
  </div>

  <h2 id="step-1">Step 1: Write the real shortlist, not the daydream list</h2>

  <p>
    Most people carry two lists in their head at once: options they are actually taking real steps toward, and options they are merely curious about or someone else keeps mentioning. Confusing the two is one of the biggest reasons "what career should I choose" stays open for years.
  </p>

  <p>
    Write down only what you have taken a real, concrete step toward in the last few months - applied, researched seriously, spoken to someone in the field, or started learning a related skill. Anything you have only thought about does not belong on the real shortlist yet. Cap it at three or four items. If you genuinely have more than four, that is choice overload showing up early, and Step 2 will thin it fast.
  </p>

  <div class="tracks-grid">
    {shortlistCards.map((item) => (
      <div class="track-card track-card--teal">
        <div class="track-card__badge">{item.badge}</div>
        <p class="track-card__body">{item.body}</p>
        <div class="tag-row">
          <a class="tag" href={item.link.href}>{item.link.label}</a>
        </div>
      </div>
    ))}
  </div>

  <h2 id="step-2">Step 2: Cut by hard constraints before you judge appeal</h2>

  <p>
    Before you let yourself feel excited or unsure about any option, run each one through your non-negotiable constraints first: realistic budget or runway, family expectations you are not willing to fight, location limits, a minimum qualification or entrance exam you would need to clear, and any fixed timeline you are working against.
  </p>

  <p>
    Doing this after you have already fallen for an option is how good decisions get emotionally expensive - you end up having to talk yourself out of something you already wanted, instead of never getting attached to an option that was never going to survive your real constraints. Cut first. Feel later.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      A hard constraint is not the same as a fear. "My parents will not speak to me if I choose this" is a real constraint worth naming honestly. "I might not be good enough" is not a constraint - it belongs in Step 4 as something to test, not something to eliminate an option over before you have even tried.
    </p>
  </div>

  <h2 id="step-3">Step 3: Score what survives against your own weighted criteria</h2>

  <p>
    Once constraints have thinned the list, the remaining options usually look close on the surface - which is exactly when an unweighted gut feeling stops being reliable. List the four or five things that matter most in your specific situation, assign each one a weight from 1 to 3 based on how much it actually matters to you, then score each surviving option from 1 to 5 on each criterion and multiply by the weight.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Criterion</th>
          <th>Weight (1-3)</th>
          <th>Option A: score (weighted)</th>
          <th>Option B: score (weighted)</th>
        </tr>
      </thead>
      <tbody>
        {scoringRows.map((item) => (
          <tr>
            <td data-label="Criterion"><strong>{item.criterion}</strong></td>
            <td data-label="Weight">{item.weight}</td>
            <td data-label="Option A">{item.optionA}</td>
            <td data-label="Option B">{item.optionB}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note-line">
    In this worked example, Option A totals 42 and Option B totals 39 - close enough that the score alone should not be treated as a final verdict, but specific enough to show exactly where the two options actually diverge, which is more useful than a vague sense that "A feels a bit better." For the fuller breakdown of which factors are usually worth the most weight - pay, growth ceiling, stability, work-life balance, and more - see <a href="/blog/career-guidance/factors-to-consider-when-choosing-a-career/">which factor is important while choosing a career</a>.
  </p>

  <p>
    Two criteria are easy to skip and expensive to skip: growth headroom and AI-era durability. An option that pays well today but caps out fast, or where the most appealing part of the daily work is already the part software handles fastest, scores worse on a genuine high-income skill portfolio than an option with real room to specialise, consult, or build ownership leverage over time. Weight both explicitly instead of only scoring today's starting pay.
  </p>

  <h2 id="step-4">Step 4: Run one cheap real-world test before you commit years</h2>

  <p>
    A weighted score narrows the field. It does not tell you whether the actual daily work matches the appealing version in your head. Before committing years, run one deliberately cheap, real test on your top one or two options: a small paid or unpaid project, a shadow day with someone doing the actual job, a short course with a real deliverable at the end, or a direct, specific conversation with someone three to five years further along than you.
  </p>

  <p>
    The test should generate a real outcome you can evaluate, not just a feeling. Did you finish it and want to do more, or finish it relieved it was over? Did the person three years ahead describe a version of the work you still want, or one that quietly disappointed you? A cheap test that costs a weekend is dramatically less expensive than two years spent finding out the same thing the hard way.
  </p>

  <h2 id="step-5">Step 5: Set a decide-by date and commit with a review checkpoint</h2>

  <p>
    Pick a specific date - not "soon," an actual date on a calendar. Decide now what you will do when it arrives: commit to whichever surviving option scored highest and passed its real-world test, even if it is not a perfect 10 out of 10 on every criterion. Then schedule one honest review a set number of months later, rather than leaving the decision permanently open for revision.
  </p>

  <p>
    This single step is where most well-run decision processes still fail in practice, because a vague intention rarely survives contact with a busy week. Writing the specific date and the specific action down, in advance, is what actually converts a good process into a kept decision.
  </p>

  <h2 id="traps">The 4 traps that keep "what career should I choose" open forever</h2>

  <p>
    Most people who stay stuck on this question for years are not lacking information. They are caught in one of four well-documented decision traps, usually without realising it.
  </p>

  <div class="feature-grid">
    {trapCards.map((item) => (
      <div class="feature-card">
        <div class="feature-card__label">{item.label}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="no-shortlist">What if you do not have a shortlist at all</h2>

  <p>
    Everything above assumes you already have at least two or three real options in front of you. If you genuinely do not - if the honest answer to "what are you actually considering" is a blank page - you are facing a different, earlier problem, and running this process on an empty list will not fix it.
  </p>

  <p>
    You need raw candidates before you can run a decision process on them. Gathering evidence about what pulls your attention without being asked, what people already trust you to do well, which tasks energise rather than drain you, and what the market in India currently pays for is the earlier-stage work covered in <a href="/blog/career-guidance/how-to-find-the-right-career-for-me-india/">how to find the right career for me in India</a>. Come back to the 5-Step Decision Ladder once you have three real names to put on the list.
  </p>

  <h2 id="tie">How to break a tie between two options that both look right</h2>

  <p>
    Sometimes the weighted score in Step 3 comes back genuinely close, even after honest scoring. That is not a sign you did it wrong - some decisions are legitimately close calls. Two tie-breakers work better than re-scoring the same list over and over hoping for a clearer answer.
  </p>

  <p>
    First, whichever option has the cheaper, faster real-world test available should usually go first - you get real signal sooner, at lower cost, which is itself valuable information. Second, whichever option is easier to exit or correct if it turns out wrong should be weighted slightly higher when everything else is close - reversibility is a real, underrated factor that most gut-feeling decisions ignore entirely.
  </p>

  <h2 id="mistakes">Mistakes people make trying to decide</h2>

  <p>
    Most of what derails this decision is not picking the "wrong" field. It is a handful of process mistakes that show up again and again once you look for them.
  </p>

  <ol class="rich-list">
    {mistakeCards.map((item) => (
      <li>
        <strong>{item.title}.</strong>
        {' '}{item.body}
      </li>
    ))}
  </ol>

  <h2 id="sources">Check the sources behind these claims</h2>

  <p>Do not trust any single career article blindly, including this one. Check the primary sources and apply your own judgment.</p>
  <ul class="sources">
    <li>
      Iyengar and Lepper (2000) on choice overload and decision satisfaction.
      <a href="https://web.archive.org/web/20131130195656/http://www.columbia.edu/~ss957/articles/Choice_is_Demotivating.pdf" target="_blank" rel="noopener noreferrer">When Choice Is Demotivating: Can One Desire Too Much of a Good Thing?</a>
    </li>
    <li>
      Background on choice overload (overchoice) research.
      <a href="https://en.wikipedia.org/wiki/Choice_overload" target="_blank" rel="noopener noreferrer">Overview: choice overload</a>
    </li>
    <li>
      Herbert Simon's original concept of satisficing and bounded rationality.
      <a href="https://en.wikipedia.org/wiki/Satisficing" target="_blank" rel="noopener noreferrer">Overview: satisficing</a>
    </li>
    <li>
      Schwartz, Ward, Monterosso, Lyubomirsky, White, and Lehman (2002) comparing maximizers and satisficers.
      <a href="https://web.archive.org/web/20231222191322/https://sonjalyubomirsky.com/wp-content/themes/sonjalyubomirsky/papers/SWMLWL2002.pdf" target="_blank" rel="noopener noreferrer">Maximizing Versus Satisficing: Happiness Is a Matter of Choice</a>
    </li>
    <li>
      Sunk-cost reasoning in decision-making.
      <a href="https://en.wikipedia.org/wiki/Sunk_cost" target="_blank" rel="noopener noreferrer">Overview: sunk cost</a>
    </li>
    <li>
      Gollwitzer's implementation-intention research on turning intentions into kept plans.
      <a href="https://en.wikipedia.org/wiki/Implementation_intention" target="_blank" rel="noopener noreferrer">Overview: implementation intentions</a>
    </li>
    <li>
      Official Indian government career and job service.
      <a href="https://www.ncs.gov.in/" target="_blank" rel="noopener noreferrer">National Career Service</a>
    </li>
  </ul>

  <h2 id="faq">FAQs on what career to choose</h2>

  <div class="faq-accordion">
    {faqItems.map((item, index) => (
      <details open={index === 0}>
        <summary>{item.q}</summary>
