      text-transform: uppercase;
      color: rgba(45, 212, 191, 0.95) !important;
    }
    .key-takeaways ul {
      margin: 0 !important;
      padding-left: 1.15rem !important;
      display: grid;
      gap: 0.5rem;
    }
