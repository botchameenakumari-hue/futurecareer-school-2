          <td data-label="Output">A one-page note</td>
        </tr>
        <tr>
          <td data-label="Step"><strong>Collect</strong></td>
          <td data-label="Action">Use two or three free sources</td>
          <td data-label="Output">A list of options</td>
        </tr>
        <tr>
          <td data-label="Step"><strong>Compare</strong></td>
          <td data-label="Action">Check each option against notices and costs</td>
          <td data-label="Output">A shortlist of two</td>
        </tr>
        <tr>
          <td data-label="Step"><strong>Test</strong></td>
          <td data-label="Action">Run a small trial for each</td>
          <td data-label="Output">Trial notes</td>
        </tr>
        <tr>
          <td data-label="Step"><strong>Decide</strong></td>
          <td data-label="Action">Choose after the trials</td>
          <td data-label="Output">A written decision</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="data">Protecting your personal information</h2>

  <div class="table-wrap">
    <table class="paths-table paths-table--wide">
      <thead>
        <tr>
          <th>Situation</th>
          <th>Safer habit</th>
          <th>Why</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-label="Situation"><strong>A form asks for phone and email</strong></td>
          <td data-label="Safer habit">Share only what is needed and read the purpose</td>
          <td data-label="Why">Avoid spam and pressure calls</td>
        </tr>
        <tr>
