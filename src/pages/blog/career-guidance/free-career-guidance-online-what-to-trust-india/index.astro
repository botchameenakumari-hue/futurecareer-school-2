  <h2 id="routes">Seven routes, strongest growth first</h2>

  <div class="route-grid">
    <div class="route-card">
      <div class="route-card__top">
        <span class="route-card__n">01</span>
        <span class="chip chip--high">Scalable</span>
      </div>
      <h3>Use free guidance as input for your own small trial</h3>
      <p class="route-card__why">Test options cheaply.</p>
      <p class="route-row route-row--teal"><span>Who pays you</span>Yourself.</p>
      <p class="route-row route-row--violet"><span>What earns trust</span>Trial results.</p>
      <p class="route-row route-row--gold"><span>Watch out</span>Needs effort.</p>
      <p class="route-row route-row--teal"><span>How it grows</span>Add trials.</p>
