    margin: 0 !important;
  }

  .honest-take {
    margin: 1.6rem 0;
    padding: 1.25rem 1.35rem 1.2rem;
    border-left: 3px solid #e5b84a;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.025);
  }
