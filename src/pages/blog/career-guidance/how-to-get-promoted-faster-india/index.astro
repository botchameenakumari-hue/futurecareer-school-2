<BlogPostLayout
  title="How to get promoted faster in India: what actually moves the decision"
  description="How to get promoted faster in India: the sponsor gap, calibration timing, scope expansion, and how to tell if your promotion is delayed on purpose or genuinely not ready."
  canonical={canonical}
  category="career-guidance"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
