const description = "Career advice for single parents and caregivers in India: flexible work, income planning, support systems, learning in small steps and limits.";
const seoDescription = "Plan around care duties with small steps and honest limits.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/career-advice-for-single-parents-and-caregivers-balancing-work-and-care-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Can I work and care at the same time?",
    "Many people do, with planning and support. Start with a realistic weekly schedule."
  ],
  [
    "Which roles suit fixed hours?",
    "Roles with clear shifts and leave rules. Check written terms."
  ],
  [
    "How do I learn with little time?",
    "Use small daily blocks and free resources."
  ],
  [
    "How do I build income in layers?",
    "Combine a main source with a small side service."
  ],
  [
    "Where do I find support?",
    "Family, neighbours, community groups and official schemes. Verify on official pages."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
