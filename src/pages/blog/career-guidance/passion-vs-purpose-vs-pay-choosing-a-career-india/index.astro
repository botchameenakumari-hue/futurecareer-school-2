---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "Passion vs Purpose vs Pay: How to Choose a Career in India";
const seoTitle = "Passion vs Purpose vs Pay: How to Choose a Career";
const description = "Passion vs purpose vs pay in career choice in India: how to weigh all three, questions to ask, a simple scoring method, a plan and honest limits.";
const seoDescription = "Weigh all three honestly. Pay is not shameful and passion is not enough.";
const canonical = "https://futurecareerschool.com/blog/career-guidance/passion-vs-purpose-vs-pay-choosing-a-career-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is passion enough for a career?",
    "Not by itself. Pair it with income planning and skills."
  ],
  [
    "Is it wrong to choose by pay?",
    "No, but check that you can sustain the work."
  ],
  [
    "What if purpose and pay conflict?",
    "Look for roles that balance them or plan a staged path."
  ],
  [
    "Can the balance change over time?",
    "Yes. Review it every year or two."
  ],
  [
    "How do I test a career?",
    "Small tasks, volunteering and conversations."
  ],
  [
    "What if I do not know my passion?",
    "Try small experiments rather than waiting for certainty."
  ],
  [
    "Should family opinion count?",
    "Listen and share your scoring, then decide."
  ],
  [
    "Will AI choose for me?",
    "It can structure options. You decide."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
