          <td data-label="Limit">Changes with life stage</td>
        </tr>
        <tr>
          <td data-label="Test type"><strong>Subject skill quiz</strong></td>
          <td data-label="Usually measures">Knowledge in one area</td>
          <td data-label="Limit">Not a career verdict</td>
        </tr>
      </tbody>
    </table>
  </div>

