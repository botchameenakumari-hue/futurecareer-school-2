---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import BlogBottomCta from '../../../../components/BlogBottomCta.astro';
import LinkDirectorySection from '../../../../components/LinkDirectorySection.astro';

const primaryKeyword = 'LinkedIn profile tips for freshers India';
const canonical = 'https://futurecareerschool.com/blog/linkedin-networking/linkedin-profile-tips-for-freshers-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';
const assessmentsUrl = 'https://futurecareerschool.com/services/assessments';
const guidanceUrl = 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/';

const relatedDirectoryItems = [
  {
    href: '/blog/linkedin-networking/',
    title: 'More LinkedIn and Networking Guides',
    description: 'More profile, outreach, and referral guides for building real connections instead of cold applications.',
    note: 'More guides',
  },
  {
    href: '/blog/',
    title: 'All Blog Categories',
    description: 'Browse every article category and the latest published guides.',
    note: 'All categories',
  },
  {
    href: '/career-resources?topic=job-search',
    title: 'Job Search Resources',
    description: 'Resume, referral, and interview guides to pair with a stronger LinkedIn profile.',
    note: 'Related read',
  },
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Career Guidance Service',
    description: 'Stronger direction when a better profile alone is not converting into interviews.',
    note: 'Next step',
  },
  {
    href: '/career-skills-compass/',
    title: 'Career & Skills Compass',
    description: 'A free tool to shortlist skills worth adding to your profile before you apply.',
    note: 'Related read',
  },
];

const faq = [
  {
    q: 'What should my LinkedIn headline say if I am a fresher with no job title yet?',
    a: 'Skip "Student at [College]" or "Fresher | Actively looking for opportunities." Lead with your target role, your strongest 2-3 skills, and one proof point: for example, "Aspiring Data Analyst | SQL, Python, Power BI | Built 3 dashboards from real datasets." Recruiters search by role and skill keywords, not by the word "student," so front-load those in the first 60-70 characters.',
  },
  {
    q: 'How long should my About section be as a fresher?',
    a: 'Keep it under 200-250 words. Only the first two to three lines show before someone clicks "see more," so put your strongest, most specific line first — not your college name or degree. Structure it as: one-line hook, what you have built or done, your core skills, and a clear closing line inviting the right people to reach out.',
  },
  {
    q: 'I have no internship. What do I put in my Experience and Featured sections?',
    a: 'College projects, hackathons, freelance gigs, volunteer work, and student-body or club leadership roles all count as real experience if you describe the task and the outcome. Use the Featured section to pin links to your best 2-3 projects, a certificate, or a portfolio, so a recruiter sees proof without having to scroll.',
  },
  {
    q: 'How many people should I connect with as a fresher, and how fast?',
    a: 'There is no useful daily target. A slower list of people who actually reply beats a fast list of strangers who ignore you. Prioritize alumni from your college, people in your target role, and second-degree connections through your network, and send a one- or two-line note explaining why you are reaching out every time.',
  },
  {
    q: 'Should I send connection requests without a note to save time?',
    a: 'No. A blank request reads as mass-sent and gets ignored or quietly removed more often than a personalized one. A short note referencing something specific — a shared college, a post they wrote, a role you are targeting — takes under a minute and meaningfully changes whether the person accepts and remembers you.',
  },
  {
    q: 'Does turning on "Open to Work" actually hurt my chances?',
    a: 'Not by itself, but two choices matter. Use the "Recruiters only" visibility setting instead of "All LinkedIn members" so the green frame does not appear on your profile photo, and keep your headline focused on your role and skills instead of adding "#OpenToWork" or "Seeking opportunities" to it. The setting works quietly in the background; your headline and About section still do the actual convincing.',
  },
  {
    q: 'Do I need a fancy photo and banner to be taken seriously?',
    a: 'No. You need a clear, recent, front-facing photo with decent lighting and a plain or blurred background — a phone photo works fine. A custom banner is optional polish, not a requirement; a profile with a real photo and strong headline, About section, and Featured links outperforms a profile with a nice banner and nothing behind it.',
  },
  {
    q: 'How do I know if my profile is actually working?',
    a: 'Check two numbers over a couple of weeks after a change: profile views and search appearances, both visible on your own profile under "Analytics." If neither moves after you update your headline and About section, the keywords likely still do not match what recruiters in your target role are searching for, and it is worth revisiting them again.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'LinkedIn and Networking', item: 'https://futurecareerschool.com/blog/linkedin-networking' },
      { '@type': 'ListItem', position: 4, name: 'LinkedIn Profile Tips for Freshers India', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'LinkedIn profile tips for freshers in India: build a profile that gets found, not just finished',
    description:
      'LinkedIn profile tips for freshers India: fix the headline, structure the About section with real proof, showcase projects and internships, connect without spam, and use Open to Work without looking desperate.',
    datePublished: publishedDateISO,
    dateModified: publishedDateISO,
    mainEntityOfPage: canonical,
    inLanguage: 'en-IN',
    author: {
      '@type': 'Person',
      name: authorName,
      url: authorUrl,
      jobTitle: authorRole,
    },
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://futurecareerschool.com/favicon.svg',
      },
    },
    articleSection: ['LinkedIn and Networking', 'Job Search', 'Freshers', 'Proof of Work'],
    keywords: [
      primaryKeyword,
      'linkedin profile for freshers',
      'linkedin headline for students',
      'linkedin about section examples',
      'open to work linkedin',
      'how to network on linkedin without spamming',
      'linkedin optimization for freshers india',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="LinkedIn Profile Tips for Freshers India: What Recruiters Actually Search For"
  description="LinkedIn profile tips for freshers India: fix the headline, structure the About section with real proof, showcase projects, connect without spam, and use Open to Work the right way."
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <Nav activePage="blog" />

  <article id="linkedin-article">
    <header class="hero">
      <div class="hero-bg">
        <div class="orb orb-gold"></div>
        <div class="orb orb-teal"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/blog/linkedin-networking">LinkedIn and Networking</a>
          <span aria-hidden="true">&rsaquo;</span>
          <span aria-current="page">LinkedIn Profile Tips for Freshers India</span>
        </nav>

        <div class="hero-meta">
          <span class="pill hero-pill"><span class="pill-dot"></span>Profile that gets found</span>
          <span class="date-pill">Published: {publishedDateLabel}</span>
          <a class="date-pill date-pill--link" href={authorUrl}>By {authorName}</a>
        </div>

        <div class="hero-grid-main">
          <div class="hero-copy">
            <h1>LinkedIn profile tips for freshers in India: build a profile that gets found, not just finished</h1>
            <p class="line strong">
              LinkedIn profile tips for freshers in India start with one fact most guides skip: recruiters do not read your profile top to bottom, they search it by keyword, so a headline that says "Student at [College]" or "Fresher | Actively looking" gets skipped by the same search that would have found you.
            </p>
            <p class="line">You finished your profile. Photo up, education added, done. And still nothing.</p>
            <p class="line">No profile views. No messages. No idea if a recruiter has ever actually seen it.</p>
            <p class="line">That is not bad luck. It is usually a profile built to look complete, not to get found or to prove anything once someone lands on it.</p>
            <p class="line">Here is how to fix the headline, the About section, your proof, your outreach, and your Open to Work setting — in that order.</p>

          </div>

          <aside class="hero-board card">
            <div class="board-kicker">Why most fresher profiles go unseen</div>
            <div class="board-row">
              <span>1</span>
              <p>Headline says "student" or "fresher" instead of the role and skills recruiters search for.</p>
            </div>
            <div class="board-row">
              <span>2</span>
              <p>About section opens with college name instead of a specific, provable claim.</p>
            </div>
            <div class="board-row">
              <span>3</span>
              <p>No pinned proof — no Featured links to projects, certificates, or work samples.</p>
            </div>
            <div class="board-row">
              <span>4</span>
              <p>Connection requests sent blank, at volume, to strangers with no shared context.</p>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <section class="container section">
      <div class="key-takeaways">
        <p class="key-takeaways__label">The short version</p>
        <ul>
          <li>A profile recruiters can actually find is what turns your skill-building into real, higher-paying opportunities — an invisible profile means the best-fit roles never even reach you.</li>
          <li>Your headline and About section are search fields, not a bio — lead with your target role, skills, and one proof point, not "student" or "fresher."</li>
          <li>Recruiters filter with Boolean keyword search across titles, skills, and summaries, so vague labels like "hardworking" or "passionate" are invisible to that search.</li>
          <li>Projects, internships, and certifications only help if they are pinned in Featured and described with a real task and outcome, not left buried in the Education section.</li>
          <li>Connect with a one- or two-line note explaining why, not a blank request sent at volume — a smaller list of real replies beats a large list of strangers who ignore you.</li>
          <li>Turn on Open to Work using "Recruiters only" visibility, and keep your headline about your role and skills, not "#OpenToWork" — the setting should support your profile, not replace it.</li>
        </ul>
      </div>

      <div class="cta-pair">
        <a class="btn-gold pulse" href={guidanceUrl}>Get career guidance</a>
        <a class="btn-outline cta-assessment-lite" href={assessmentsUrl}>Free career and skill assessments</a>
      </div>

      <nav class="jump-nav" aria-label="Jump to section">
        <span class="jump-nav__label">Jump to section</span>
        <div class="jump-nav__grid">
          <a href="#how-recruiters-search">How recruiters actually search LinkedIn</a>
          <a href="#headline">Fix your headline first</a>
          <a href="#about-section">The About section that works with no experience</a>
          <a href="#proof">Showcasing projects, internships, and certifications</a>
          <a href="#connecting">Connecting strategically, not spam-connecting</a>
          <a href="#open-to-work">Using Open to Work without looking desperate</a>
          <a href="#photo-basics">Photo, banner, and the small stuff</a>
          <a href="#mistakes">Mistakes that quietly kill fresher profiles</a>
          <a href="#faqs">FAQs</a>
        </div>
      </nav>
    </section>

    <section id="how-recruiters-search" class="container section">
      <h2>How recruiters actually search LinkedIn (and why your profile is invisible to it)</h2>
      <p class="line">
        Most fresher profiles are written to be read. Recruiter tools are built to be searched. That mismatch is the real reason a "complete" profile gets zero views.
      </p>
      <p class="line">
        Recruiters using LinkedIn Recruiter typically build a keyword search across job titles, skills, summaries, and experience descriptions, then combine terms with AND, OR, and NOT to narrow a large pool down fast. A search for "data analyst" AND "SQL" AND "Excel" will surface a profile that uses those exact words — it will not surface a profile that only says "fresher looking for opportunities in analytics."
      </p>
      <p class="line">
        There is a second problem that even keyword-optimized profiles hit: search results are not ranked by how well you match. A strong-fit profile can sit on page 20 just as easily as page 2. That makes two things matter more than they seem to for a fresher: using the exact terms your target role is searched under, and building enough of a signal (activity, connections, a complete profile) that you also get found through means other than a cold keyword search.
      </p>
      <p class="line">
        This is also why the fresher-hiring surge in India right now works in your favor if your profile is built correctly. Entry-level hiring on LinkedIn in India rose sharply between 2023 and 2025, and postings for people with 0-3 years of experience have been growing faster than any other experience band in early 2026 — but that demand still routes through the same keyword-driven search. More openings do not help if your profile never surfaces in the search that finds them.
      </p>
      <p class="line">
        If this is part of a bigger job-search push, pair this profile fix with the broader <a href="/career-resources?topic=job-search">job search resources</a>, and if the confusion goes deeper than the profile — unclear target role, unclear direction — that is a decision problem <a href={guidanceUrl}>career guidance</a> is built to work through with you.
      </p>
    </section>

    <section id="headline" class="container section">
      <h2>Fix your headline first: what to write instead of "Student at X" or "Fresher | Actively looking"</h2>
      <p class="line">
        LinkedIn gives you 220 characters for a headline, but only the first 60-70 show up in most search results and on mobile. Whatever sits in that first stretch either gets you found or gets you skipped.
      </p>
      <p class="line">
        "Student at [College Name]" wastes that entire window on a fact nobody is searching for. "Fresher | Actively looking for opportunities" is worse — it tells a recruiter your status, not your value, and status is not a search field anyone filters by.
      </p>

      <div class="card highlight-card">
        <h3>A headline formula that actually gets searched</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Part</th>
                <th>What it does</th>
                <th>Example</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="Part">Target role</td>
                <td data-label="What it does">Matches the exact job-title keyword recruiters search for</td>
                <td data-label="Example">Aspiring Data Analyst</td>
              </tr>
              <tr>
                <td data-label="Part">2-3 core skills or tools</td>
                <td data-label="What it does">Matches skill-keyword filters layered on top of the role search</td>
                <td data-label="Example">SQL, Python, Power BI</td>
              </tr>
              <tr>
                <td data-label="Part">One proof point</td>
                <td data-label="What it does">Gives a human reader a reason to click through, not just a search hit</td>
                <td data-label="Example">Built 3 dashboards from real datasets</td>
              </tr>
              <tr>
                <td data-label="Part">Availability (optional)</td>
                <td data-label="What it does">Removes ambiguity for a recruiter deciding whether to reach out now</td>
                <td data-label="Example">Available from June 2026</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <p class="line">
        Put together: "Aspiring Data Analyst | SQL, Python, Power BI | Built 3 Dashboards From Real Datasets." That is one sentence, and it beats "Student at XYZ University" on every axis — searchable role, searchable skills, and a specific claim a human will actually stop on.
      </p>
      <p class="line">
        If you genuinely have no project or internship yet, do not fake one. Lead with the role and what you are actively learning instead: "Aspiring Data Analyst | Learning SQL & Python | Final-Year B.Com Student." That is still infinitely more searchable than "Student," and it is honest.
      </p>

      <div class="card honest-take">
        <p class="honest-label">Honest take</p>
        <p class="line">
          Your college name and degree still matter — just not in the first 70 characters. They belong in the Education section, where they are still fully visible and still searchable, just not burning your one shot at the headline.
        </p>
      </div>
    </section>

    <section id="about-section" class="container section">
      <h2>The About section structure that works when you have limited experience</h2>
      <p class="line">
        Only the first two to three lines of your About section show before someone has to click "see more." Most people never click. That means your first line is doing almost all the work, and starting it with "I am a final-year student pursuing B.Tech" wastes it on a fact your Education section already shows.
      </p>
      <p class="line">
        Use a five-part structure instead, and keep the whole section under roughly 200-250 words:
      </p>

      <div class="protocol-stack">
        <div class="protocol-row">
          <span class="protocol-num">1</span>
          <div class="protocol-body">
            <h3>A one-line hook</h3>
            <p>Open with your direction and a specific claim, not your college. "I build small data tools that turn messy spreadsheets into decisions" beats "I am a passionate and hardworking student" every time — it is specific, and it is provable.</p>
          </div>
        </div>
        <div class="protocol-row">
          <span class="protocol-num">2</span>
          <div class="protocol-body">
            <h3>What you have actually done</h3>
            <p>One to two sentences on your strongest project, internship, or piece of real work — task plus outcome, not just a title. "Built a dashboard for a college fest's ticket sales data that helped the team spot a pricing error before the event" is proof. "Worked on a project" is not.</p>
          </div>
        </div>
        <div class="protocol-row">
          <span class="protocol-num">3</span>
          <div class="protocol-body">
            <h3>Your core skills</h3>
            <p>List the specific tools, languages, or methods you can actually use, not vague traits. Skip "team player" and "quick learner" unless you back them with a specific example in the same line.</p>
          </div>
        </div>
        <div class="protocol-row">
          <span class="protocol-num">4</span>
          <div class="protocol-body">
            <h3>Practical logistics</h3>
            <p>State your location, whether you are open to relocating or remote work, and your realistic availability — "Available from June 2026" or "Available immediately." Recruiters filter on this and skip profiles that leave it ambiguous.</p>
          </div>
        </div>
        <div class="protocol-row">
          <span class="protocol-num">5</span>
          <div class="protocol-body">
            <h3>A clear closing line</h3>
            <p>Invite the right kind of contact: "Open to entry-level data or business analyst roles — feel free to connect or message me." A concrete ask outperforms a vague "let's connect!" sign-off.</p>
          </div>
        </div>
      </div>

      <p class="line">
        Notice what is missing from this structure: buzzwords. "Passionate," "driven," and "results-oriented" show up on thousands of fresher profiles with nothing behind them. A specific task and outcome does more convincing in five words than any adjective does in one sentence.
      </p>
    </section>

    <section id="proof" class="container section">
      <h2>Showcasing projects, internships, and certifications so they actually get seen</h2>
      <p class="line">
        Experience is not limited to a paid, full-time job title. College projects, hackathons, unpaid internships, freelance gigs, and student-club leadership roles all count as real experience — if you describe them with a task and an outcome instead of leaving them as a bare line item.
      </p>

      <div class="grid-two">
        <div class="card win-card">
          <h3>What to pin in Featured</h3>
          <ul>
            <li>Your 2-3 strongest projects, linked directly — a GitHub repo, a live dashboard, a design file, a Google Doc case study.</li>
            <li>A certificate that is genuinely relevant to your target role, not every certificate you have collected.</li>
            <li>A short write-up (even a LinkedIn post) explaining what a project solved and what you learned building it.</li>
          </ul>
          <div class="sub-row sub-row--fit">
            <span class="sub-row-label">Fit signal</span>
            <p>A recruiter can understand what you built and why it mattered in under 30 seconds without leaving your profile.</p>
          </div>
        </div>
        <div class="card warn-card">
          <h3>What quietly wastes the space</h3>
          <ul>
            <li>A project listed only by title with no description of the task or result.</li>
            <li>Every online course certificate you have ever completed, with no filter for relevance.</li>
            <li>Screenshots with no link back to the actual working project or repository.</li>
          </ul>
          <div class="sub-row sub-row--caution">
            <span class="sub-row-label">Watch out</span>
            <p>A Featured section crowded with low-relevance certificates buries your strongest proof instead of highlighting it.</p>
          </div>
        </div>
      </div>

      <p class="line">
        For each project or internship in your Experience section, use the same task-plus-outcome pattern from the About section: what you were asked to do, what you actually built or delivered, and one measurable or observable result where you have one. "Analyzed 3 months of sales data and flagged a discount pattern that was cutting margin" says more than "Data analysis internship" ever will.
      </p>
      <p class="line">
        If you are still building your first piece of real proof, a small, honest project beats waiting for the perfect internship offer. Pick one weekend-sized problem in your target field, finish it, and post about what you learned — some freshers need a couple of weeks to get something presentable, others need longer around exams, and both are fine as long as the project actually ships.
      </p>
      <p class="line">
        This is the point where the right skill mix, real proof of work, and market positioning meet. Two freshers with the same skill can get very different opportunities if only one of them makes that skill visible and easy to verify. A profile with pinned, provable work is what lets a recruiter searching for your skill actually find you — and consider you for a role that pays for what you can do, not just for a job title.
      </p>
    </section>

    <section id="connecting" class="container section">
      <h2>Connecting strategically: how to network without spam-connecting</h2>
      <p class="line">
        A blank connection request sent to a stranger reads as mass-sent, and it usually gets ignored, left pending, or quietly removed. A short, specific note takes under a minute and changes both whether someone accepts and whether they remember you afterward.
      </p>

      <div class="card highlight-card">
        <h3>A note that actually works, in three lines</h3>
        <ul>
          <li><strong>Line 1:</strong> Who you are and the specific, shared reason you are reaching out — same college, same target role, a post they wrote.</li>
          <li><strong>Line 2:</strong> One honest, specific thing you want — advice on breaking into a role, a quick question about their work, not a job ask on day one.</li>
          <li><strong>Line 3:</strong> A low-pressure close that makes it easy to say yes, even briefly.</li>
        </ul>
      </div>

      <p class="line">
        Example: "Hi Ritika, I saw you work in business analytics at [Company] and noticed we both studied at [College]. I am a final-year student trying to understand what an entry-level BA role actually looks like day to day — would you be open to a 10-minute chat sometime, no pressure if you are busy?" That is specific, low-effort to answer, and gives a real reason to accept.
      </p>

      <div class="grid-two">
        <div class="card win-card">
          <h3>Who to prioritize</h3>
          <ul>
            <li>Alumni from your college now working in your target role or company.</li>
            <li>People one connection away from you, where a mutual contact can make a quick introduction.</li>
            <li>People whose posts or comments you have genuinely engaged with first — a like or thoughtful comment for a few days before you ask to connect makes your name recognizable.</li>
          </ul>
        </div>
        <div class="card accent-violet-card">
          <h3>What to avoid</h3>
          <ul>
            <li>Sending the same copy-paste note to dozens of strangers in one sitting.</li>
            <li>Asking for a job or a referral in the very first message before any context exists.</li>
            <li>Connecting only with people your own age in the same situation — a network of only fellow freshers has less to offer you than a mix that includes people already in your target role.</li>
          </ul>
        </div>
      </div>

      <p class="line">
        A weekly reality check helps here: spending 15-20 minutes a few times a week on a handful of specific, personalized requests and genuine comments will out-perform an hour of mass-connecting once a month. Networking that works looks boring and steady, not viral.
      </p>
    </section>

    <section id="open-to-work" class="container section">
      <h2>Using "Open to Work" effectively, without it looking desperate</h2>
      <p class="line">
        Open to Work is a real signal recruiters filter by, and freshers should generally use it. The way you configure it decides whether it reads as intentional or desperate.
      </p>

      <div class="grid-two">
        <div class="card accent-teal-card">
          <h3>Do this</h3>
          <ul>
            <li>Set visibility to "Recruiters only," not "All LinkedIn members" — this shares your status with hiring professionals without putting a green frame on your photo for your entire network to see.</li>
            <li>Fill in the target roles, locations, and start date fields inside the Open to Work form accurately — this is what recruiters actually filter by, not the badge itself.</li>
            <li>Keep engaging normally: commenting on posts in your field, congratulating connections, sharing something you built. Visibility from real activity compounds with the Open to Work signal instead of relying on the badge alone.</li>
          </ul>
        </div>
        <div class="card warn-card">
          <h3>Skip this</h3>
          <ul>
            <li>Adding "#OpenToWork" or "Seeking opportunities" directly into your headline — it eats the same 60-70 characters your role and skills should be using.</li>
            <li>Using the "All LinkedIn members" visibility option unless you specifically want your college, past employers, or wider network to see the badge too.</li>
            <li>Treating the badge as the whole strategy. It signals status; it does not replace a headline, About section, or Featured proof that actually convinces someone to act on that status.</li>
          </ul>
        </div>
      </div>

      <p class="line">
        The badge should feel like one quiet setting among several, not the loudest thing on your profile. A recruiter who filters by "Open to Work" and lands on a profile with a sharp headline, a specific About section, and real proof pinned in Featured reads that as an organized job seeker. A recruiter who lands on a green-framed photo above an empty profile reads that as someone who has not done the work yet.
      </p>
    </section>

    <section id="photo-basics" class="container section">
      <h2>Photo, banner, and the small stuff that still counts</h2>
      <p class="line">
        None of this needs to be expensive or elaborate. It needs to be clear and current.
      </p>
      <div class="pilot-grid">
        <div class="card pilot-card">
          <span>Photo</span>
          <p>A recent, front-facing photo with decent lighting and a plain or blurred background. A phone photo in good light works fine — polish matters less than clarity and a real, recognizable face.</p>
        </div>
        <div class="card pilot-card">
          <span>Banner</span>
          <p>Optional. A plain, uncluttered banner or one related to your field is enough. Do not spend your limited profile-building time here before the headline and About section are done.</p>
        </div>
        <div class="card pilot-card">
          <span>Custom URL</span>
          <p>Set a clean linkedin.com/in/your-name URL from the default random string. It looks more finished on a resume and business card, and takes under a minute to change.</p>
        </div>
        <div class="card pilot-card">
          <span>Skills section</span>
          <p>List only skills you can actually defend in an interview, and pin your top three so they show first. A long list of unrelated skills dilutes the ones that matter for your target role.</p>
        </div>
      </div>
    </section>

    <section id="mistakes" class="container section">
      <h2>Mistakes that quietly kill fresher profiles</h2>
      <div class="grid-two">
        <div class="card warn-card">
          <h3>Expensive, common mistakes</h3>
          <ul>
            <li>Headline that only says "Student" or "Fresher | Actively looking," wasting the most-searched real estate on the profile.</li>
            <li>About section opening with college and degree instead of a specific, provable claim.</li>
            <li>Projects and internships listed as bare titles with no task or outcome described.</li>
            <li>Mass-sending blank connection requests, then wondering why nobody replies.</li>
            <li>Open to Work set to "All LinkedIn members" without realizing the badge is visible to everyone, including current professors or part-time employers.</li>
          </ul>
        </div>
        <div class="card win-card">
          <h3>What to do instead</h3>
          <ul>
            <li>Rewrite the headline around your target role, 2-3 skills, and one proof point.</li>
            <li>Open the About section with a specific hook, then task-plus-outcome proof, then skills, then a clear ask.</li>
            <li>Pin your 2-3 strongest projects in Featured with real links and short write-ups.</li>
            <li>Send fewer, more personal connection requests, and give it a real test — check profile views and search appearances after a couple of weeks of consistent small changes.</li>
            <li>Set Open to Work visibility to "Recruiters only" and let your profile content do the convincing.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="container section">
      <h2>Source-backed reality check</h2>
      <p class="line">Do not take any career article, including this one, on faith. Check primary sources and apply your own judgment.</p>
      <ul class="sources">
        <li>
          LinkedIn Recruiter's own help documentation on how Boolean keyword search scans job titles, summaries, skills, and experience descriptions.
          <a href="https://www.linkedin.com/help/recruiter/answer/a415295" target="_blank" rel="noopener noreferrer">LinkedIn Recruiter: Boolean search help</a>
        </li>
        <li>
