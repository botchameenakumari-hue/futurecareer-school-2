---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'UX design career path India: the real map, not the visual-polish myth';
const description =
  'UX design career path India: research, wireframing, prototyping, and testing, not just visuals. Real tools, portfolio rules, and entry paths inside.';
const canonical = 'https://futurecareerschool.com/blog/skill-roadmaps/ux-design-career-path-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'what-ux-actually-is', label: 'What UX design actually involves' },
  { id: 'tools', label: 'Tools worth learning' },
  { id: 'entry-paths', label: '3 real entry paths' },
  { id: 'portfolio', label: 'Portfolio strategy' },
  { id: 'certifications', label: 'Courses and certificates: worth it vs skip' },
  { id: 'learning-sequence', label: 'The build order' },
  { id: 'salary', label: 'What it actually pays' },
  { id: 'mistakes', label: 'Mistakes that stall the path' },
  { id: 'timeline', label: 'A realistic timeline' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const uxSkillItems = [
  {
    num: '01',
    title: 'User research',
    body: 'Talking to real users before drawing anything: interviews, surveys, contextual observation, and competitor teardown, used to find the actual problem instead of guessing at one.',
    tip: 'Practise on something small you already use daily. Interview four or five people about a real frustration and write a one-page problem summary before you sketch a single screen.',
  },
  {
    num: '02',
    title: 'Information architecture and wireframing',
    body: 'Structuring what exists on a screen and in what order, using low-fidelity wireframes to test the logic of a flow before anyone spends time on colour, type, or icons.',
    tip: 'Sketch three different navigation structures for the same problem on paper first. The skill is comparing structures quickly, not making one wireframe look polished.',
  },
  {
    num: '03',
    title: 'Prototyping',
    body: 'Turning a wireframe into something a real person can click through and react to, at whatever fidelity actually answers the question you are testing that week.',
    tip: 'Build one low-fidelity clickable prototype in a free tool before you touch a paid one. The habit of testing early matters more than the tool used to do it.',
  },
  {
    num: '04',
    title: 'Usability testing',
    body: 'Watching real people try to use what you built, without explaining it to them first, and writing down where they got stuck, confused, or gave up.',
    tip: 'Run a five-person usability test on any app on your phone with a friend or classmate. You will find more real problems in one honest test than in ten opinions from a group chat.',
  },
  {
    num: '05',
    title: 'Visual and interaction design',
    body: 'The part most beginners start with and most hiring managers weigh last: typography, spacing, colour, motion, and the small interaction details that make a tested structure feel trustworthy.',
    tip: 'Learn visual design after you can already justify a structure with research, not before. A beautiful screen built on an unvalidated structure still fails in testing.',
  },
];

const toolCards = [
  {
    badge: 'Design and prototyping',
    title: 'Screen design and clickable prototypes',
    body: 'Tools in this category let you build wireframes, high-fidelity screens, and interactive prototypes that a user can click through. Figma is the current market standard across most Indian product teams, but Adobe XD and Sketch still appear on some job descriptions, and the underlying skill (structure, states, and flow logic) transfers between all three.',
    fit: 'Learn one tool deeply rather than three tools shallowly. Employers care whether you can think in flows and states, not which tool you clicked through.',
    caution: 'Do not confuse tool fluency with design skill. A candidate who can operate every panel in a design tool but cannot explain a decision will still fail a portfolio review.',
    tags: ['One tool, deep', 'Market standard varies by team'],
  },
  {
    badge: 'Research and testing',
    title: 'Talking to and observing real users',
    body: 'Tools like Google Forms, Maze, or Lyssna support surveys and remote usability tests, while a notebook and five willing people can run the same test for free. The skill being tested in interviews is the research method, not the software license.',
    fit: 'Start with free or built-in tools. Paid research platforms become worth learning once you are doing this professionally, not while you are still building your first case studies.',
    caution: 'Skipping real user testing and relying only on personal opinion or AI-generated feedback is one of the fastest ways a portfolio gets flagged as shallow in a review.',
    tags: ['Method over software', 'Free options exist'],
  },
  {
    badge: 'Collaboration and handoff',
    title: 'Whiteboarding, documentation, and developer handoff',
    body: 'Tools like FigJam or Miro support brainstorming and journey mapping with a team, while clear developer handoff (spacing, states, component naming) is what actually gets a design shipped instead of stuck in translation between design and engineering.',
    fit: 'Practise documenting one project as if a developer who never spoke to you has to build it correctly from your file alone.',
    caution: 'Weak handoff habits are an unglamorous but very common reason a design gets built wrong or takes three extra rounds of clarification in a real job.',
    tags: ['Often skipped by beginners', 'Directly affects team trust'],
  },
];

const entryPathCards = [
  {
    badge: 'Structured, paid',
    title: 'Bootcamp or paid cohort program',
    body: 'A fixed-length, project-based program with mentorship and peer accountability. Good for people who need external structure and a forcing function to finish real projects on a schedule, since UX design has very few gatekeeping exams and it is easy to drift without deadlines.',
    fit: 'You learn better with deadlines, feedback loops, and a group, and you can afford the fee without derailing your finances.',
    caution: 'A bootcamp certificate does not replace a strong portfolio. Recruiters review the projects you shipped during the program, not the program name on your resume.',
    tags: ['Fastest structure', 'Fee-dependent'],
  },
  {
    badge: 'Free or low-cost',
    title: 'Self-taught, project-first route',
    body: 'Learning through free resources, structured online courses, and self-initiated projects, without a formal program. This is the most common route into UX design in India today because the barrier to entry is a laptop and consistency, not a specific degree.',
    fit: 'You are self-directed, can find and follow a real curriculum instead of random YouTube videos, and are willing to seek outside feedback instead of guessing whether your work is good.',
    caution: 'Without outside feedback, self-taught portfolios often repeat the same beginner mistakes for months. Get real critique from working designers early, not after you have built five projects the same wrong way.',
    tags: ['Lowest cost', 'Needs outside feedback'],
  },
  {
    badge: 'Formal, longest',
    title: 'Design degree or postgraduate program',
    body: 'A formal design education (from institutes such as NID, IDC-IIT Bombay, or a growing number of newer design schools) covering design theory, research methods, and studio practice over several years, alongside strong campus placement access at some institutes.',
    fit: 'You are choosing this at the undergraduate or early-career stage, want deep design theory alongside practice, and value the placement access and design community that a strong program brings.',
    caution: 'A design degree alone still does not skip the portfolio requirement. Design school graduates who coast on the institute name without strong individual case studies still get filtered out in interviews.',
    tags: ['Longest timeline', 'Strongest peer network'],
  },
];

const certRows = [
  {
    name: 'Google UX Design Professional Certificate',
    verdict: 'Worth it, conditionally',
    note: 'Builds three end-to-end portfolio projects as part of the course, which is the real value, not the certificate line on a resume. An Indian graduate survey reported strong positive career outcomes within six months of completion, but outcomes still depend on the quality of the projects you finish, not just enrollment.',
  },
  {
    name: 'Interaction Design Foundation (IxDF) courses',
    verdict: 'Worth it for depth',
    note: 'Strong for building real UX theory and research method knowledge at a relatively low cost, useful alongside hands-on project work rather than as a replacement for it.',
  },
  {
    name: 'Short paid "become a UX designer in weeks" ad-funnel courses',
    verdict: 'Skip or verify carefully',
    note: 'Many of these are marketing-led rather than curriculum-led. Check for a real syllabus, real mentor access, and real project outcomes before paying, not just testimonials in the ad itself.',
  },
  {
    name: 'A four-year design degree (NID, IDC-IIT Bombay, and similar)',
    verdict: 'Worth it for the right stage and budget',
    note: 'Strong for depth, studio culture, and placement access if you are choosing this at the right life stage and can afford the time and cost. It is not a requirement to enter UX design professionally.',
  },
  {
    name: 'Free self-study (YouTube, NN/g articles, free Coursera audits)',
    verdict: 'Fine as a foundation',
    note: 'Good for vocabulary and early exposure at zero cost. On its own it rarely produces a hire-ready portfolio without a structured project plan and outside feedback layered on top.',
  },
];

const sequenceItems = [
  {
    num: '01',
    title: 'Learn the vocabulary and mental model first',
    body: 'Before opening any design tool, understand what UX design actually solves for and how it differs from UI and visual design. A few solid articles and one structured course beat scattered videos here.',
  },
  {
    num: '02',
    title: 'Run one real research exercise',
    body: 'Interview a handful of real people about a genuine problem and write up what you learned. This becomes the foundation of your first case study, not an optional extra step.',
  },
  {
    num: '03',
    title: 'Wireframe before you touch visual design',
    body: 'Sketch and test the structure of a screen or flow in low fidelity. Getting the structure validated first saves you from polishing something that tests badly later.',
  },
  {
    num: '04',
    title: 'Build one clickable prototype and test it',
    body: 'Turn your validated wireframe into a prototype and run a small usability test on real people. Document what broke and what you changed because of it.',
  },
  {
    num: '05',
    title: 'Add visual design once the structure works',
    body: 'Apply typography, spacing, colour, and interaction polish to a structure you have already tested. This is the stage most beginners jump to first and should actually be near the end.',
  },
  {
    num: '06',
    title: 'Turn the project into a documented case study',
    body: 'Write up the problem, your research, the options you considered, the decision, and what you would measure to know it worked. This document is what a recruiter actually reviews.',
  },
];

const salaryRows = [
  { stage: 'Fresher (0-2 years)', range: 'Roughly Rs 2.5-6 LPA', note: 'Wide range driven by city, company brand, and portfolio strength more than by degree alone.' },
  { stage: 'Mid-level (2-5 years)', range: 'Roughly Rs 8-15 LPA', note: 'Growth here tracks shipped, measurable outcomes more than years of tenure by themselves.' },
  { stage: 'Senior (5+ years)', range: 'Roughly Rs 14-28 LPA', note: 'Requires ownership of full projects end to end and the ability to defend decisions to non-design stakeholders.' },
  { stage: 'Lead / Head of Design', range: 'Roughly Rs 25-45 LPA', note: 'Strategic and people-management scope, usually at funded startups or larger product companies, not agencies doing one-off visual work.' },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Starting with visual polish instead of research',
    body: 'A beautifully designed screen built on an unvalidated structure still fails a usability test and still reads as UI skill without UX judgment in a portfolio review.',
  },
  {
    num: '02',
    title: 'Collecting course certificates instead of finishing real case studies',
    body: 'A resume with several course completions and no documented project reads as intention. One well-explained real project outperforms a stack of unfinished courses.',
  },
  {
    num: '03',
    title: 'Padding the portfolio with too many shallow projects',
    body: 'Recruiters typically spend a few focused minutes on a portfolio. Three to five deeply explained case studies beat seven rushed ones every time.',
  },
  {
    num: '04',
    title: 'Skipping usability testing because it feels slow',
    body: 'Presenting a design as finished without ever watching a real person use it is the single fastest way an interviewer identifies a portfolio built on assumption, not evidence.',
  },
  {
    num: '05',
    title: 'Copying a popular case study format without the underlying thinking',
    body: 'Interviewers who review portfolios daily recognise a templated Medium-style case study instantly. The story and reasoning behind a decision matter more than matching a popular format.',
  },
];

const faqItems = [
  {
    q: 'What is the realistic UX design career path in India for a complete beginner?',
    a: 'Start by learning the vocabulary and mental model of UX versus UI and visual design, then run one real research exercise, wireframe and test a structure in low fidelity, build and test a clickable prototype, add visual design last, and turn the whole project into a documented case study. Repeat that sequence two or three times before applying anywhere, since a small set of deeply explained case studies matters more than a long list of shallow ones.',
  },
  {
    q: 'Do I need a design degree to become a UX designer in India?',
    a: 'No. A design degree from an institute like NID or IDC-IIT Bombay gives strong theory, studio practice, and placement access, but it is one of three real entry paths, not a requirement. Bootcamps and self-taught, project-first routes are common and effective when backed by a strong portfolio and real outside feedback.',
  },
  {
    q: 'How many case studies should a UX design portfolio have?',
    a: 'Most reviewers expect two to three strong case studies from a junior candidate, rising to three to five for more experienced designers. A small number of deeply explained projects, each showing the problem, your research, your reasoning, and the outcome, consistently beats a long list of shallow ones.',
  },
  {
    q: 'Is Figma the only tool I need to learn for a UX design career?',
    a: 'Figma is currently the most common design and prototyping tool on Indian job descriptions, but the underlying skill, thinking in flows, states, and structure, transfers to Adobe XD, Sketch, or whatever tool a specific employer uses. Learn one tool deeply and treat research tools and clear developer handoff as equally important, not optional extras.',
  },
  {
    q: 'Is the Google UX Design Certificate worth doing in India?',
    a: 'It is worth it conditionally. The real value is the three end-to-end portfolio projects built during the course, not the certificate line itself. Indian graduate outcome data has been positive, but results still depend on how much real effort and outside feedback go into the projects, not on enrollment alone.',
  },
  {
    q: 'What is the difference between UX design, UI design, and UX research as career paths?',
    a: 'UX design covers the full problem-to-solution process: research, structure, prototyping, and testing. UI design focuses specifically on the visual and interaction layer of a screen. UX research is a more specialised, insight-generating role that usually pays more per role but has fewer open positions than UX design. Most early-career UX designers do a version of all three before specialising.',
  },
  {
    q: 'How long does it realistically take to build a hire-ready UX portfolio in India?',
    a: 'There is no single honest number here. Someone with prior design, research, or product exposure can sometimes reach a hire-ready portfolio in a focused few months, while someone starting from zero, building research skill, tool fluency, and two or three deep case studies from scratch, more realistically needs closer to six months to a year. Judge your own pace against the build order above, not against a fixed course timeline.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Skill Roadmaps', item: 'https://futurecareerschool.com/blog/skill-roadmaps' },
      { '@type': 'ListItem', position: 4, name: 'UX Design Career Path India', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="skill-roadmaps"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={jsonLd}
>
  <p class="lead-para">
    A realistic <strong>UX design career path in India</strong> runs through research, wireframing,
    prototyping, and usability testing long before it runs through visual polish — most people who stall out
    or get filtered in interviews are strong at screen design and weak at everything that happens before it.
  </p>
  <p>
    UX design is often sold as "make apps look nice." That is UI design, and it is only one layer of the
    actual job. The role that gets hired, promoted, and paid well is the one that can find a real user
    problem, structure a solution, test it on real people, and only then make it look trustworthy.
  </p>
  <p>
    This matters for building a genuine <strong>high-value skill portfolio</strong>, not just clearing one
    interview. The skill mix, the visible proof of decisions you made and tested, and the ability to explain
    your reasoning to a non-designer are what raise your income ceiling over years — which is what moves this
    decision toward earlier financial freedom, not just a first offer.
  </p>
  <p>
    Below is the honest map: what UX design actually involves, the tools worth learning, three real entry
    paths (bootcamp, self-taught, design degree), how portfolio hiring actually works, which certifications
    are worth your time, a realistic build order, and current India salary data by stage.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>UX design is research, information architecture, wireframing, prototyping, and usability testing first — visual design comes last, not first.</li>
      <li>Learn one design tool deeply (Figma is currently the market standard in India) rather than several tools shallowly, and treat research and handoff skills as equally important.</li>
      <li>Three real entry paths exist: a paid bootcamp, a self-taught project-first route, or a formal design degree — none of them skip the portfolio requirement.</li>
      <li>Two to three deeply explained case studies for a junior candidate beat five to seven shallow ones; recruiters spend a few focused minutes per portfolio.</li>
      <li>India salary bands run roughly Rs 2.5-6 LPA for freshers up to Rs 25-45 LPA for lead and head-of-design roles, driven mostly by shipped, measurable outcomes.</li>
      <li>The scalable stack is user and domain knowledge plus AI-assisted research or production, communication, product judgment, and proof of better outcomes. It can grow into leadership, consulting, a studio, training, or design products.</li>
    </ul>
  </div>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Get structured guidance on your UX path</a>
    <a class="btn-outline cta-assessment-lite" href="https://futurecareerschool.com/services/assessments">Use a free assessment as a quick first check</a>
  </div>

  <p>
    This roadmap sits inside our wider <a href="/blog/skill-roadmaps/">skill roadmaps</a> guides, which walk
    through what to build first, what to build second, and how to get a first role or client for a specific
    skill direction.
  </p>

  <nav class="jump-nav" aria-label="Jump to section">
    <span class="jump-nav__label">Jump to section</span>
    <ul class="jump-nav__list">
      {jumpLinks.map((link) => (
        <li><a href={`#${link.id}`}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer</h2>
  <p>
    If you are mapping out a UX design career path for India, stop treating it as a list of screens to
    design and start treating it as a repeatable process: understand a real user problem through research,
    structure a solution through wireframes, test that structure in a rough prototype, only then apply visual
    design, and document the whole thing as a case study a stranger can follow. Tools, certificates, and job
    titles come after that process is real, not instead of it.
  </p>

  <h2 id="what-ux-actually-is">What UX design actually involves</h2>
  <p>
    Most beginners think UX design means making an app look clean. That is UI design, and it is the last of
    five layers, not the whole job. <a href="https://www.nngroup.com/articles/definition-user-experience/" target="_blank" rel="noopener">Nielsen Norman Group's definition of user experience</a>
    covers the full journey a person has with a product, not just the screen they see.
  </p>
  <div class="protocol-stack">
    {uxSkillItems.map((item) => (
      <div class="protocol-row">
        <span class="protocol-num">{item.num}</span>
        <div class="protocol-body">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <p class="protocol-note">{item.tip}</p>
        </div>
      </div>
    ))}
  </div>
  <div class="callout callout--teal">
    <p class="callout__eyebrow">Honest take</p>
    <p>
      Employers who separate UX design from UX research usually pay research more per role but hire fewer of
      them; UX design roles are more numerous but expect the designer to run at least lightweight research and
      testing themselves. Either way, the person who can only do the visual layer is the easiest to replace.
    </p>
  </div>

  <h2 id="tools">Tools worth learning</h2>
  <p>
    Tools change faster than skills do, so the goal is fluency in one solid tool per category, not a
    checklist of every brand name on a job description.
  </p>
  <div class="track-grid">
    {toolCards.map((tool) => (
      <div class="track-card">
        <span class="track-badge">{tool.badge}</span>
        <h3>{tool.title}</h3>
        <p>{tool.body}</p>
        <div class="sub-row sub-row--fit">
          <span class="sub-row-label">Focus on</span>
          <p>{tool.fit}</p>
        </div>
        <div class="sub-row sub-row--caution">
          <span class="sub-row-label">Watch out</span>
          <p>{tool.caution}</p>
        </div>
        <div class="tag-row">
          {tool.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
  <p>
    Want a structured, resource-style version of the same build order with practice project ideas? See the
    <a href="/career-resources/ux-ui-design-career-roadmap">UX/UI design career roadmap</a> for a companion
    reference you can work through alongside this guide.
  </p>

  <h2 id="entry-paths">3 real entry paths</h2>
  <p>
    Almost every real UX design story in India starts from one of three doors. Pick based on your budget,
    timeline, and how much external structure you actually need, not on which one sounds most impressive.
  </p>
  <div class="track-grid">
    {entryPathCards.map((path) => (
      <div class="track-card">
        <span class="track-badge">{path.badge}</span>
        <h3>{path.title}</h3>
        <p>{path.body}</p>
        <div class="sub-row sub-row--fit">
          <span class="sub-row-label">Best for</span>
          <p>{path.fit}</p>
        </div>
        <div class="sub-row sub-row--caution">
          <span class="sub-row-label">Watch out</span>
          <p>{path.caution}</p>
        </div>
        <div class="tag-row">
          {path.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>

  <h2 id="portfolio">Portfolio strategy</h2>
  <p>
    UX hiring in India, like most places, is portfolio-driven: a strong resume gets you a look, but the
    portfolio decides whether you get a call back. Most reviewers spend only a few focused minutes on a
    portfolio, so depth beats volume every time.
  </p>
  <ul>
    <li>Show two to three case studies as a junior candidate, and three to five once you have real work experience — not more.</li>
    <li>Structure every case study around the problem, your research, the options you considered, the decision you made, and the measured or observed outcome, not just the final screens.</li>
    <li>Include at least one project with real usability testing evidence, even informal testing on five people, since this is what separates a UX portfolio from a UI-only one.</li>
    <li>Get outside feedback from a working designer before you finish a project, not after you have already built the same mistake into three projects.</li>
    <li>Write like you are explaining your thinking to a hiring manager who has never seen the product, not like you are captioning a gallery of pretty screens.</li>
  </ul>
  <p>
    If you need starting problems rather than staring at a blank canvas, these produce genuinely testable
    case studies: redesign a booking flow on a government or transit app that frustrates you, simplify a
    confusing checkout on a small local e-commerce site with the owner's permission, design an onboarding
    flow for a regional-language first-time smartphone user, or fix a specific accessibility gap (contrast,
    tap targets, screen-reader labels) on a real product and document the before-and-after with real users.
  </p>
  <p>
    This is also where the holistic side of skill-building shows up, not just tool fluency: the right skill
    mix for your background, visible tested proof, and the ability to explain a decision to a non-designer
    stakeholder all move together. That stacked, defensible story is what widens your income ceiling over a
    career and moves you toward earlier financial freedom — a single polished screen with no reasoning behind
    it does not.
  </p>
  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Reviewers who look at portfolios daily can tell a templated, format-copied case study apart from real
      thinking almost immediately. The specific reasoning behind one decision matters more than matching a
      popular Medium-style structure.
    </p>
  </div>

  <h2 id="certifications">Courses and certificates: worth it vs skip</h2>
  <p>
    No single certificate or degree is required to work as a UX designer in India, which makes course choice
    genuinely confusing. The real filter is whether a course forces you to finish a real, defensible project.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Course or credential</th>
          <th>Verdict</th>
          <th>Why</th>
        </tr>
      </thead>
      <tbody>
        {certRows.map((row) => (
          <tr>
            <td data-label="Course or credential">{row.name}</td>
            <td data-label="Verdict">{row.verdict}</td>
            <td data-label="Why">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="highlight-box highlight-box--gold">
    <p>
      Treat any paid course, including the <a href="https://grow.google/certificates/ux-design/" target="_blank" rel="noopener">Google UX Design Certificate</a>,
      as a structured way to force yourself to finish real projects, not as the credential itself. The three
      case studies you build during a course matter far more to a hiring manager than the certificate line on
      your resume.
    </p>
  </div>

  <h2 id="learning-sequence">The build order</h2>
  <p>
    Sequence matters more than most self-taught roadmaps admit. Starting with visual design before research
    and structure is the single most common reason a beginner's portfolio reads as UI skill without UX
    judgment.
  </p>
