---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = "How to List Computer, Excel and Language Skills on a Resume in India";
const seoTitle = "How to List Computer, Excel and Language Skills on a Resume";
const description = "How to list computer, Excel and language skills on a resume in India: levels, wording, proof lines, examples and mistakes to avoid.";
const seoDescription = "Say what you can do with the tool, not just the tool name.";
const canonical = "https://futurecareerschool.com/blog/resume/how-to-list-computer-excel-and-language-skills-on-a-resume-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "How do I list computer skills?",
    "Name the tools and one thing you did with them."
  ],
  [
    "How do I list Excel skills?",
    "Name the functions you used and the result you built."
  ],
  [
    "How do I list languages?",
    "Give a level for speaking and writing."
  ],
  [
    "Should I use rating bars?",
    "No. Use words and evidence."
  ],
  [
    "How many skills should I list?",
    "Five to eight that match the role."
  ],
  [
    "Should I list basic skills like typing?",
    "Only if the role needs them."
  ],
  [
    "Where should the skills go?",
    "After education for freshers, or near the top if skills are the main selling point."
  ],
  [
    "Will AI tools write this for me?",
    "They help with phrasing, but the facts must be yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonical={canonical}
  category="resume"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
