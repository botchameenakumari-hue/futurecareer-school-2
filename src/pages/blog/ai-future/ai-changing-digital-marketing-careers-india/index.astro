---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'How AI Is Changing Digital Marketing Careers in India';
const description =
  'How AI is changing digital marketing careers in India: what AI now automates, which skills pay more, and how to build a career that AI cannot easily copy.';
const canonical = 'https://futurecareerschool.com/blog/ai-future/ai-changing-digital-marketing-careers-india';
const publishedDateISO = '2026-07-20';
const publishedDateLabel = '20 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career strategist and writer';

const jumpLinks = [
  { id: 'automated', label: 'What AI has already automated' },
  { id: 'rising', label: 'Skills becoming more valuable because of AI' },
  { id: 'data', label: 'The India data behind this shift' },
  { id: 'then-now', label: 'Building a career now vs 5 years ago' },
  { id: 'entering', label: 'If you are entering digital marketing now' },
  { id: 'working', label: 'If you are already working in marketing' },
  { id: 'gates', label: 'The 3 Gates before you bet on a lane' },
  { id: 'mistakes', label: 'Mistakes to avoid' },
  { id: 'next-step', label: 'What to do next' },
  { id: 'faq', label: 'FAQs' },
];

const automatedCards = [
  {
    label: 'First-draft content and copy',
    title: 'Blog outlines, product descriptions, social captions, and email drafts',
    body:
      'Generative AI tools now produce a usable first draft of routine content in seconds: product descriptions, social captions, newsletter drafts, and basic blog outlines. The task that used to take a junior writer half a day now takes minutes to draft, which is exactly why entry-level "just write the copy" roles are shrinking fastest.',
    caution:
      'Watch out: if your entire content skill is producing generic first drafts with no editing, brand judgment, or original research layered on top, this is the fastest-shrinking lane in digital marketing right now.',
  },
  {
    label: 'Ad copy variations and A/B testing',
    title: 'Headline and description variants for paid campaigns',
    body:
      'Writing ten headline variations for a Google or Meta ad set used to be manual, repetitive work. AI copy tools now generate dozens of variants instantly, and platforms auto-test combinations without a human choosing each pairing.',
    caution:
      'Watch out: generating variants is now trivial. Picking which variant actually fits the brand voice and the buyer psychology behind the offer is the part still worth paying a person for.',
  },
  {
    label: 'Basic SEO research',
    title: 'Keyword lists, topic clusters, and on-page checklists',
    body:
      'AI-assisted SEO tools can pull keyword volume, competitor gaps, and topic cluster suggestions faster than a person searching manually. Basic on-page audits, meta tag suggestions, and internal-linking checklists are now largely automated tasks.',
    caution:
      'Watch out: AI-generated keyword lists still need a person who understands search intent, business priorities, and which keywords are worth the effort. Treating the tool output as the finished strategy is a common, costly mistake.',
  },
  {
    label: 'Campaign bidding and budget optimization',
    title: 'Google Performance Max, Meta Advantage+, and automated bid strategies',
    body:
      'Machine-learning bidding systems from Google and Meta already decide, in real time, who sees an ad, at what price, and when. A media buyer manually adjusting bids hour by hour is largely obsolete; the platforms\' own algorithms outperform manual bidding on most standard campaigns now.',
    caution:
      'Watch out: campaign management has shifted from "set the bid" to "set the strategy, feed the system good data, and catch when the algorithm is optimizing for the wrong goal."',
  },
];

const risingCards = [
  {
    label: 'Strategy and positioning',
    title: 'Deciding what to say and why, before any tool writes a word',
    body:
      'AI tools are strong at producing content once someone tells them exactly what to produce. They are still weak at deciding what a brand should stand for, which audience segment actually matters this quarter, and which channel deserves the budget. That decision layer has become more valuable, not less, because execution got cheap.',
    fit: 'Best for people who can read a business problem and set direction, not just fill a content calendar.',
  },
  {
    label: 'Brand and creative judgment',
    title: 'Knowing what "on brand" actually means, and catching what is off',
    body:
      'AI-generated content can sound generic or slightly off-tone without someone catching it. The marketer who can look at ten AI-drafted headlines and immediately know which one actually fits the brand\'s voice and the moment is doing work a tool cannot do on its own.',
    fit: 'Best for people with a strong, trained sense of tone, audience, and taste built from real campaign experience.',
  },
  {
    label: 'Prompt-and-review workflows',
    title: 'Directing AI tools well, then editing what comes back',
    body:
      'Briefing an AI tool with the right context, constraints, and examples produces dramatically better output than a vague one-line prompt. Marketers who can write a sharp brief, review the output critically, and fix what is wrong are getting more done per hour than marketers who cannot.',
    fit: 'Best for people who treat AI as a fast first-draft partner, not a finished-product machine.',
  },
  {
    label: 'AI-output quality control',
    title: 'Fact-checking, brand-safety review, and catching AI errors before publish',
    body:
      'AI tools confidently produce wrong facts, outdated claims, and off-brand statements. Someone still has to check that AI-written copy is accurate, legally safe, and consistent with what the brand has said before. That review-and-accountability layer is a growing responsibility, not a shrinking one.',
    fit: 'Best for people who are detail-oriented and comfortable being the last check before something goes live.',
  },
  {
    label: 'Data interpretation and campaign judgment',
    title: 'Reading what the numbers mean, not just pulling the report',
    body:
      'AI tools can generate a performance report in seconds. Deciding why a campaign underperformed, what to test next, and how that connects to the business goal still needs a person who understands the market, not just the dashboard.',
    fit: 'Best for people who are comfortable with numbers but think in terms of decisions, not just metrics.',
  },
];

const thenNowRows = [
  {
    then: 'A fresher\'s early value was often "can write acceptable copy" or "can build a basic campaign."',
    now: 'A fresher\'s early value is "can direct AI tools well and catch what they get wrong," on top of the same basic campaign skill.',
  },
  {
    then: 'Career growth mostly rewarded output volume: more posts, more campaigns, more reports.',
    now: 'Career growth rewards judgment and outcomes: which campaigns actually moved revenue, not how many were shipped.',
  },
  {
    then: 'Specializing in one channel (SEO, or paid ads, or content) was often enough to build a stable career.',
    now: 'One channel skill plus data literacy and AI-tool fluency is closer to the real baseline for durable, higher-paying roles.',
  },
  {
    then: 'Manual reporting and campaign monitoring filled a meaningful share of a junior marketer\'s week.',
    now: 'That time is largely freed up by automation, which raises the bar on what a junior marketer is expected to produce with it.',
  },
];

const enteringCards = [
  {
    label: 'Treat AI-tool fluency as a baseline, not a bonus',
    body:
      'Knowing how to brief an AI writing, design, or ad tool well is becoming as basic an expectation as knowing how to use a spreadsheet. Build this early instead of treating it as an extra skill to pick up later.',
  },
  {
    label: 'Pick one channel and go deep, not five channels shallow',
    body:
      'Performance marketing (Google Ads, Meta Ads), SEO and content, or marketing analytics each reward real depth. A fresher who can run one channel properly, including the parts AI cannot fully automate, is more hireable than one with a shallow pass across everything.',
  },
  {
    label: 'Build proof that survives an AI-skeptical interviewer',
    body:
      'A portfolio piece where you only pasted an AI tool\'s output proves less than one where you can explain the brief you wrote, the options you rejected, and why you chose the final version. Keep the working notes, not just the finished asset.',
  },
  {
    label: 'Learn the numbers, not just the creative side',
    body:
      'Basic comfort with campaign data, conversion tracking, and simple analytics tools is no longer optional for a strong entry point. Marketers who can connect creative choices to actual numbers are harder to substitute.',
  },
];

const workingCards = [
  {
    label: 'If your role is mostly content drafting',
    body:
      'Move from producing first drafts toward owning content strategy, brand voice standards, and the editorial judgment that decides what actually gets published. Use AI to draft faster, but make your value the decisions around the draft.',
  },
  {
    label: 'If your role is mostly campaign execution',
    body:
      'Shift from manually managing day-to-day bids toward campaign strategy, budget allocation across channels, and diagnosing why automated bidding is or is not hitting the real business goal.',
  },
  {
    label: 'If your role is mostly SEO or basic analytics',
    body:
      'Build toward search-intent strategy, technical SEO judgment, and connecting search performance to revenue, rather than only running keyword reports AI tools now generate on their own.',
  },
  {
    label: 'If you manage a marketing team',
    body:
      'Push your team toward the prompt-and-review workflow deliberately: set standards for how AI output gets checked before it ships, and reward judgment and outcomes over raw output volume in how you evaluate performance.',
  },
];

const gateItems = [
  {
    title: 'Gate 1: Proof of judgment',
    body:
      'Show one example where you caught something an AI tool got wrong in a piece of marketing work, a factual error, an off-brand tone, or a badly targeted audience, and explain how you fixed it.',
  },
  {
    title: 'Gate 2: Proof of communication',
    body:
      'Explain, in plain language, why one campaign or content choice beats an obvious alternative. If you cannot explain the reasoning simply, the depth behind the choice is probably missing.',
  },
  {
    title: 'Gate 3: Proof of outcome',
    body:
      'Show one real result you contributed to, more leads, better conversion, lower cost per acquisition, or stronger engagement, not just activity like "posted content" or "ran a campaign."',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating "AI is taking marketing jobs" as one flat statement',
    body:
      'The honest picture is uneven: routine drafting and manual campaign monitoring are shrinking while strategy, brand judgment, and quality control are growing. Reacting to the headline instead of the specific task breakdown leads to bad career decisions.',
  },
  {
    num: '02',
    title: 'Assuming a digital marketing certificate alone guarantees a job',
    body:
      'Hiring is shifting toward proof over paper. A certificate gets you considered; visible campaign work, a portfolio with real reasoning behind it, and comfort with AI tools get you hired.',
  },
  {
    num: '03',
    title: 'Using AI output without checking it',
    body:
      'Publishing AI-generated copy or reports without review is exactly the failure mode that is making quality control such a valuable skill in the first place. Being the person who catches errors is a career advantage, not a chore.',
  },
  {
    num: '04',
    title: 'Chasing every new AI tool instead of building depth in one channel',
    body:
      'Tool literacy matters, but it does not replace understanding how a channel actually works. A marketer who deeply understands paid search strategy and uses AI well will usually beat a marketer who has tried twenty tools but understands none of them deeply.',
  },
  {
    num: '05',
    title: 'Ignoring the data and analytics side of marketing',
    body:
      'Creative skill alone is a weaker position than it used to be. Pairing creative judgment with the ability to read campaign data and connect it to business outcomes is what keeps a marketing career resilient.',
  },
];

const faqItems = [
  {
    q: 'Is AI actually replacing digital marketing jobs in India?',
    a: 'Not in a simple, flat way. AI has automated specific mechanical tasks, first-draft content, ad copy variations, basic keyword research, and campaign bidding, while demand for people who can direct AI tools, catch their mistakes, and set strategy has grown. Naukri\'s 2025 AI jobs report found Advertising and Marketing hiring rising alongside AI adoption, even as 41% of professionals in the field worried about AI reducing creativity in their work, which points to a shift in what the job demands, not a shrinking industry.',
  },
  {
    q: 'Which digital marketing tasks has AI automated the most?',
    a: 'First-draft content writing, ad copy variation generation, basic keyword and SEO research, routine performance reporting, and campaign bid optimization are the most automated tasks today. These share one trait: the inputs are predictable and the output can be specified clearly enough for an AI tool or an ad platform\'s own algorithm to handle reliably.',
  },
  {
    q: 'What digital marketing skills are becoming more valuable because of AI?',
    a: 'Strategy and positioning, brand and creative judgment, the ability to brief AI tools well and review their output critically, quality control on AI-generated work, and the ability to interpret campaign data and connect it to business outcomes are all gaining importance. These are the layers AI tools still cannot reliably do on their own.',
  },
  {
    q: 'Do I still need to learn digital marketing basics if AI can write content and ads?',
    a: 'Yes. AI tools work well when the person directing them already understands what good marketing looks like. Someone who does not understand audience targeting, brand voice, or campaign structure cannot judge whether an AI tool\'s output is actually good, which is exactly the skill gap that is costing people jobs right now.',
  },
  {
    q: 'Is it harder to build a digital marketing career in India now than five years ago?',
    a: 'The entry bar has changed shape rather than simply risen. Producing basic content or running a basic campaign is no longer enough on its own, since AI tools do a version of that instantly. What is rewarded now is judgment, data literacy, and AI-tool fluency layered on top of channel skill, which is a different, more demanding starting point than five years ago.',
  },
  {
    q: 'Which digital marketing roles pay the most because of AI skills?',
    a: 'Roles that combine channel expertise with AI-tool fluency and data literacy, performance marketing management, growth marketing, marketing analytics, and AI-aware content strategy, tend to command stronger pay than generalist content or social media roles, based on current Indian hiring data pointing to salary premiums for AI-skilled marketing professionals.',
  },
  {
    q: 'Should a fresher in India specialize in one marketing channel or stay a generalist?',
    a: 'Specializing in one channel, performance marketing, SEO and content, or analytics, while adding AI-tool fluency and basic data skills on top, tends to build a stronger, more hireable profile than staying a shallow generalist across everything.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="ai-future"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>How AI is changing digital marketing careers in India comes down to one clear split:</strong>
    the mechanical parts of the job, first-draft content, ad copy variations, basic SEO research, and
    campaign bidding, are now largely automated, while strategy, brand judgment, and the ability to
    direct and check AI output have become more valuable, not less. The question worth asking is not
    whether AI is coming for marketing jobs. It is which specific tasks in your role are shrinking and
    which ones are quietly becoming the reason you get hired, promoted, and paid more, since building
    the judgment layer on top of a marketing channel is what actually compounds into a
    <strong>high-income skill portfolio</strong> instead of a role AI keeps eroding underneath you.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>AI has automated first-draft content, ad copy variations, basic keyword research, routine reporting, and campaign bidding across Google and Meta.</li>
      <li>Strategy, brand and creative judgment, prompt-and-review workflows, and AI-output quality control are the skills gaining value and pay.</li>
      <li>India-specific hiring data shows Advertising and Marketing sector growth alongside rising AI adoption, with AI-skilled professionals commanding a real salary premium.</li>
      <li><strong>The skill that decides your outcome is not "do you use AI tools" but "can you brief them well, catch what they get wrong, and connect the work to a business result."</strong></li>
      <li>Whether you are entering digital marketing or already working in it, the practical move is the same: shift from execution-only tasks toward strategy, judgment, and review, and build visible proof of that shift.</li>
    </ul>
  </div>

  <p>
    If you want the broader parent topic first, start with <a href="/blog/ai-future/">AI and the
    Future of Work</a>.
  </p>

  <p>
    If this shift is creating real decision pressure about your next move, whether to specialize
    further, reskill toward AI-aware marketing roles, or change direction altogether, structured
    <a href="/services/career-counselling-and-career-guidance/">career counselling and career
    guidance</a> can help you map your specific situation instead of guessing from headlines.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="automated">What AI has already automated in digital marketing</h2>

  <p>
    These tasks share one trait: the inputs are predictable, and the correct output can be specified
    clearly enough for an AI tool, or an ad platform's own algorithm, to handle reliably.
  </p>

  <div class="career-grid">
    {automatedCards.map((item) => (
      <article class="career-card">
        <span class="career-card__label">{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
        <p class="career-card__caution">{item.caution}</p>
      </article>
    ))}
  </div>

  <p class="section-note">
    None of these tasks have disappeared entirely. They have shrunk as a share of what a marketer
    spends time on, which is exactly why entry-level roles built only around these tasks are getting
    harder to find.
  </p>

  <h2 id="rising">Digital marketing skills becoming more valuable because of AI</h2>

  <p>
    On the other side of the same shift, these skills are becoming more important, not less,
    precisely because AI is doing more of the routine work around them.
  </p>

  <div class="driver-grid">
    {risingCards.map((item) => (
      <article class="driver-card">
        <span class="driver-card__label">{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
        <p class="career-card__fit"><strong>Best for:</strong> {item.fit}</p>
      </article>
    ))}
  </div>

  <div class="highlight-box highlight-box--violet">
    <p>
      <strong>The common thread across every rising skill:</strong> someone still has to decide what
      should be said, catch what AI gets wrong, and be accountable for whether the work actually
      moves the business forward. AI tools do not carry that accountability. People do. Stacking
      these skills on top of one marketing channel, instead of chasing tool trends, is what builds a
      genuine high-income skill portfolio and moves you toward earlier financial freedom, not just a
      slightly safer job title.
    </p>
  </div>

  <h2 id="data">The India data behind this shift</h2>

  <p>
    A few concrete signals from Indian hiring data are worth naming directly instead of staying
    vague.
  </p>

  <div class="grid-two">
    <div class="card">
      <h3>What the numbers show</h3>
      <ul>
        <li>Naukri's 2025 "AI: Friend, Foe or Frenemy" report, based on responses from over 60,000 jobseekers, found 86% of Indian jobseekers view AI as a career enabler rather than a threat, but 41% of professionals in Advertising and Marketing specifically worried AI could reduce creativity in their work, the second-highest concern of any field measured.</li>
        <li>The same report found overall median salaries for AI-skilled roles running 53% higher than non-AI-skilled roles, with freshers who have AI skills seeing salary premiums up to 56%.</li>
        <li>Naukri's JobSpeak data for September 2025 recorded the Advertising and Marketing sector growing 22% year on year, with fresher hiring in the sector up 54% year on year in the same period.</li>
      </ul>
    </div>
    <div class="card">
      <h3>What this means in practice</h3>
      <ul>
        <li>Marketing is not a shrinking field in India. Hiring is expanding at the same time AI adoption is expanding, which supports a reshaping story rather than a job-loss story.</li>
        <li>The creativity-loss worry among marketing professionals is a more precise fear than blanket job loss, and it points directly at why brand judgment and creative direction are the skills worth protecting and building.</li>
        <li>Fresher hiring growth alongside a real AI-skills salary premium suggests entry-level marketing careers are still very much open, but increasingly reward AI-tool fluency layered on top of core marketing fundamentals, not fundamentals alone.</li>
      </ul>
    </div>
  </div>

  <p class="note-line">
    Put together, this data describes a marketing job market in India that is growing, not
    collapsing, while quietly resetting what a competitive marketing profile actually looks like.
  </p>

  <h2 id="then-now">Building a digital marketing career now vs 5 years ago</h2>

  <p>
    The entry bar has not simply gotten higher. It has changed shape.
  </p>

  <div class="then-now-grid">
    {thenNowRows.map((row) => (
      <div class="then-now-row">
        <div class="then-now-col then-now-col--then">
          <span class="then-now-label">Then</span>
          <p>{row.then}</p>
        </div>
        <div class="then-now-col then-now-col--now">
          <span class="then-now-label">Now</span>
          <p>{row.now}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="entering">If you are entering digital marketing now</h2>

  <p>
    Students and freshers face a different entry path than the one that existed even a few years
    ago, but a real path still exists.
  </p>

  <div class="skills-grid">
    {enteringCards.map((item) => (
      <article class="skill-card">
        <span class="skill-card__label">{item.label}</span>
        <p>{item.body}</p>
      </article>
    ))}
  </div>

  <p class="section-note">
    If you are still deciding whether digital marketing itself is the right entry point, or which
    broader career direction fits you, use the
    <a href="/career-skills-compass/">Career & Skills Compass</a> to check fit before committing
    time to one lane.
  </p>

  <h2 id="working">If you are already working in marketing</h2>

  <p>
    The practical move is the same across almost every role: shift from pure execution toward the
    judgment layer sitting just above it, inside the same channel you already know.
  </p>

  <div class="skills-grid">
    {workingCards.map((item) => (
      <article class="skill-card">
        <span class="skill-card__label">{item.label}</span>
        <p>{item.body}</p>
      </article>
    ))}
  </div>

  <h2 id="gates">The 3 Gates before you bet on a marketing lane</h2>

  <p>
    Whether you are protecting an existing role or choosing an entry point, test yourself against
    these three gates before treating any single marketing lane as safe from AI.
  </p>

  <div class="gates-block">
    {gateItems.map((item) => (
      <div class="gate">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="mistakes">Mistakes to avoid</h2>

  <div class="mistake-list">
    {mistakeItems.map((item) => (
      <article class="mistake-item">
        <div class="mistake-item__num">{item.num}</div>
        <div class="mistake-item__content">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      </article>
    ))}
  </div>

  <h2 id="next-step">What to do next</h2>

  <p>
    Do not treat this as a one-time decision you make and forget. Treat it as a lane you keep
    adjusting as AI tools and the market keep moving.
  </p>

  <div class="next-step">
    <p class="next-step__title">Better next moves</p>
    <ul class="next-step__list">
      <li>
        Read <a href="/blog/ai-future/skills-to-work-with-ai-instead-of-being-replaced/">Skills to
        work with AI instead of being replaced by it</a> for the broader, role-agnostic version of
        the same skill shift.
      </li>
      <li>
        Read <a href="/blog/ai-future/ai-tools-for-career-growth-india/">AI tools for career
        growth India</a> if you want practical tool categories to start using this week.
      </li>
      <li>
        Use the <a href="/career-skills-compass/">Career & Skills Compass</a> if you want a
        clearer read on your natural strengths before choosing a lane inside or outside marketing.
      </li>
      <li>
        If you want guided help mapping your specific situation, current role, skills, and
        timeline, use
        <a href="/services/career-counselling-and-career-guidance/">career counselling and career
        guidance</a>.
      </li>
    </ul>
  </div>

  <h2 id="faq">FAQs</h2>

  <div class="faq-accordion">
    {faqItems.map((item, i) => (
      <details open={i === 0}>
        <summary>{item.q}</summary>
        <div class="faq-a">{item.a}</div>
      </details>
    ))}
  </div>

  <style>
    .lead-para strong {
      color: rgba(255, 255, 255, 0.98);
    }

    .jump-nav {
      margin: 1.45rem 0 1.8rem;
      padding: 1.05rem 1.1rem 1.15rem;
      border-radius: 18px;
      border: 1px solid rgba(125, 211, 252, 0.18);
      background: linear-gradient(180deg, rgba(125, 211, 252, 0.08), rgba(255, 255, 255, 0.025));
    }
    .jump-nav__label {
      margin: 0 0 0.75rem !important;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 800;
      color: rgba(125, 211, 252, 0.92) !important;
    }
    .jump-nav__list {
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .jump-nav__list li {
      margin: 0 !important;
    }
    .jump-nav__list a {
      display: block;
      padding: 0.58rem 0.78rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.82);
      text-decoration: none;
      font-size: 13px;
      line-height: 1.3;
      font-weight: 700;
    }
    .jump-nav__list a:hover {
      border-color: rgba(125, 211, 252, 0.36);
      color: rgba(255, 255, 255, 0.96);
    }

    .driver-grid,
    .career-grid,
    .skills-grid {
      display: grid;
      gap: 0.95rem;
      margin: 1.4rem 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .driver-card,
    .career-card,
    .skill-card {
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.09);
