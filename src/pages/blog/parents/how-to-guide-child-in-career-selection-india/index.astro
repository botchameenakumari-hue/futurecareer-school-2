<BaseLayout
  title="How to Guide Child in Career Selection India: A Parent's Process"
  description="How to guide child in career selection India: use timing, open questions, assessments as one input, and a family scorecard instead of pressure or a pre-decided answer."
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Nav activePage="blog" />

  <article id="guide-article">
    <header class="hero">
      <div class="hero-bg">
        <div class="orb orb-gold"></div>
        <div class="orb orb-teal"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
