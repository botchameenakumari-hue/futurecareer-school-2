    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Career Change', item: 'https://futurecareerschool.com/blog/career-change' },
      { '@type': 'ListItem', position: 4, name: 'Second Career at 40 India', item: canonical },
    ],
  },
