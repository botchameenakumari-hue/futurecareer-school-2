const primaryKeyword = 'career switch tips for IT professionals India';
const canonical = 'https://futurecareerschool.com/blog/career-change/career-switch-tips-for-it-professionals-india';
const publishedDateISO = '2026-07-17';
const publishedDateLabel = '17 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';
const assessmentsUrl = 'https://futurecareerschool.com/services/assessments';
const guidanceUrl = 'https://futurecareerschool.com/services/career-counselling-and-career-guidance/';

const relatedDirectoryItems = [
  {
    href: '/blog/career-change/',
    title: 'More Career Change Articles',
    description: 'More decision frameworks for professionals planning a field, company, or role switch without losing income.',
    note: 'More guides',
  },
  {
    href: '/blog/career-change/it-to-non-it-career-switch-india',
    title: 'IT to non-IT career switch India',
    description: 'For IT professionals whose real question is leaving tech entirely, not switching companies or stacks.',
    note: 'Related read',
  },
  {
    href: '/blog/career-change/career-switch-from-it-to-management-india',
    title: 'Career switch from IT to management India',
    description: 'For IT professionals specifically weighing a move into delivery, product, or people management.',
