        '@type': 'ImageObject',
        url: 'https://futurecareerschool.com/favicon.svg',
      },
    },
    articleSection: ['Career Change', 'IT Careers', 'Skills'],
    keywords: [
      primaryKeyword,
      'notice period IT companies India',
      'IT bond clause India',
      'counter offer negotiation India',
      'IT lateral interview preparation',
      'switching tech stack India',
      'career change IT professional India',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
