const description = "Career advice for mainframe, COBOL, Oracle DBA and older stack professionals in India: stay, specialise or shift with checks and limits.";
const seoDescription = "Decide whether to deepen, modernise or shift on evidence.";
const canonical = "https://futurecareerschool.com/blog/career-change/legacy-technology-professionals-mainframe-cobol-oracle-and-older-stack-moving-forward-india/";
const publishedDateISO = "2026-10-30";
const publishedDateLabel = "30 October 2026";
const authorName = "Shivanshi Sehgal";
const authorUrl = "https://futurecareerschool.com/about/shivanshi-sehgal/";
const authorRole = "Career researcher and writer";

const faqItems = [
  [
    "Is legacy technology dead?",
    "Many large systems still run on it, but demand varies. Read current notices."
  ],
  [
    "Should I switch to cloud?",
    "Only if it fits your goals. Test with a small project."
  ],
  [
    "Can I move to data roles?",
    "Often yes with SQL and analysis skills. Build a project."
  ],
  [
    "Is consulting realistic?",
    "For experienced people with contacts, sometimes. Start with a pilot."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "How do I avoid fraud?",
    "Never pay for guaranteed placement."
  ],
  [
    "Will AI change this?",
    "It helps learning and planning. Judgement remains yours."
  ]
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
