const assessmentsUrl = 'https://futurecareerschool.com/services/assessments';

const faq = [
  {
    q: 'Should I specialize deeper or diversify at this stage of my career?',
    a: 'Run the two-question test before deciding either way. First: is your current specialty still growing in demand, or is it flattening because of automation, market saturation, or a shrinking function? Second: can you point to visible proof — a shipped result, a certification, a portfolio, a number you moved — that backs your specialty, or is your expertise mostly self-described? If demand is still strong and your proof is thin, specialize further and build the proof first. If demand is flattening or you already have strong proof in one area, adding one adjacent skill (the T-shaped move) usually protects you better than either narrowing further or scattering across unrelated areas.',
  },
  {
    q: 'Is taking a sabbatical bad for my resume or promotion chances in India?',
    a: 'It depends far more on how you frame the gap than on the gap itself. A sabbatical used for a specific, nameable outcome — a certification completed, a caregiving responsibility handled, a burnout genuinely addressed, a business idea tested — reads very differently in an interview or an internal review than an unexplained gap. Indian employers are more used to sabbaticals than they were a decade ago, and several large companies now have formal sabbatical policies for employees who have put in enough years of service. The resume risk comes from vagueness, not from the break itself.',
  },
  {
    q: 'Should I choose the individual contributor track or move into management?',
    a: 'Choose based on what you are actually good at and enjoy protecting, not on which one pays more on paper. If your best work is your own technical or functional output and the idea of your success depending on other people\'s output makes you uneasy, the individual contributor track is the honest choice, and many companies in India now offer a parallel technical ladder for exactly this reason. If you already find yourself unblocking teammates, wanting the whole project to succeed even when your own piece is done, and drawing energy from that, management is worth testing. Neither track is a downgrade; treat the choice as two different jobs, not two ranks of the same job.',
  },
  {
    q: 'How much financial runway do I need before making a big mid-career move?',
    a: 'For a job switch inside the same field, three to six months of expenses covers most of the real risk, since a comparable role is usually the fastest kind of move to close. For a sabbatical, a field pivot, or starting something independent, plan for six to twelve months of expenses plus a separate line for health insurance, since group cover from an employer usually stops the day you stop being an employee. Build the number from your actual monthly expenses times the realistic length of the gap, add a buffer on top, and treat that number — not a feeling of readiness — as the real go signal.',
  },
  {
    q: 'How is a mid-career strategy actually different from early-career career advice?',
    a: 'Early-career advice is mostly about finding a direction with limited information — what to learn, what role to try, how to get a first foothold. Mid-career decisions carry more weight per choice: a wrong pivot costs more months of income, family obligations narrow how much risk you can absorb, and your existing expertise and network are real assets that a bad move can waste instead of build on. The right approach shifts from broad exploration to deliberate positioning — protecting what already works, closing specific gaps on purpose, and making one or two concentrated bets instead of trying many small ones.',
  },
];

