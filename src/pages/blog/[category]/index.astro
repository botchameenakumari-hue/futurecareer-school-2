---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import LinkDirectorySection from '../../../components/LinkDirectorySection.astro';
import { BLOG_CATEGORIES, BLOG_BASE_PATH, BLOG_PUBLISHED_POSTS } from '../../../config/blog';

export function getStaticPaths() {
  return BLOG_CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const meta = BLOG_CATEGORIES.find((c) => c.slug === category);

if (!meta) {
  throw new Error(`Unknown blog category: ${String(category)}`);
}

const canonical = `https://futurecareerschool.com${BLOG_BASE_PATH}/${meta.slug}`;
const categoryPosts = BLOG_PUBLISHED_POSTS.filter((post) => post.categorySlug === meta.slug).sort((a, b) =>
  b.publishedAtISO.localeCompare(a.publishedAtISO)
);
const hasLivePosts = categoryPosts.length > 0;

const formatDate = (isoDate: string) =>
  new Intl.DateTimeFormat('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(new Date(isoDate));

const getCtaLabel = (href: string) => {
  if (href.includes('/services/assessments')) return 'Free career and skill assessments';
  if (href.includes('/services/career-counselling-and-career-guidance')) return 'Get Career Guidance';
  if (href.includes('/career-skills-compass')) return 'Find Skills';
  if (href.includes('/career-resources')) return 'Read Resources';
  if (href.includes('/services')) return 'View Services';
  return 'Read More';
};

const getCtaClass = (href: string, primary = false) =>
  href.includes('/services/assessments') ? 'btn-outline cta-assessment-lite' : primary ? 'btn-gold pulse' : 'btn-outline';

const categoryDirectoryItems = [
  {
    href: '/blog',
    title: 'Blog Home',
    description: 'Browse all article categories and the latest published guides.',
    note: 'All categories',
  },
  ...(meta.primaryCtaHref
    ? [
        {
          href: meta.primaryCtaHref,
          title: getCtaLabel(meta.primaryCtaHref),
          description: 'Open the next practical step if you are ready to act.',
          note: 'Next step',
        },
      ]
    : []),
  ...(meta.secondaryCtaHref
    ? [
        {
          href: meta.secondaryCtaHref,
          title: getCtaLabel(meta.secondaryCtaHref),
          description: 'Explore a nearby angle if you want more clarity before deciding.',
          note: 'Related read',
        },
      ]
    : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://futurecareerschool.com${BLOG_BASE_PATH}` },
      { '@type': 'ListItem', position: 3, name: meta.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${meta.title} | Blog | Future Career School`,
    description: meta.description,
    url: canonical,
    inLanguage: 'en-IN',
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
  ...(hasLivePosts
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: `${meta.title} Published Articles`,
          numberOfItems: categoryPosts.length,
          itemListElement: categoryPosts.map((post, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: `https://futurecareerschool.com${BLOG_BASE_PATH}/${post.categorySlug}/${post.slug}/`,
            name: post.title,
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${meta.title} | Blog | Future Career School`}
  description={meta.description}
  canonical={canonical}
  jsonLd={jsonLd}
  noindex={!hasLivePosts}
>
  <Nav activePage="blog" />

  <section id="cat-hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{meta.title}</span>
      </nav>
      <div class="pill hero-pill"><span class="pill-dot"></span>Category</div>
      <h1 class="hero-title">
        {meta.title}
        <span class="gold-text"> Articles</span>
      </h1>
      <p class="hero-sub">{meta.description}</p>

      <div class="hero-actions">
        {meta.primaryCtaHref && (
          <a class={getCtaClass(meta.primaryCtaHref, true)} href={meta.primaryCtaHref}>
            {getCtaLabel(meta.primaryCtaHref)}
          </a>
        )}
        {meta.secondaryCtaHref && (
          <a class={getCtaClass(meta.secondaryCtaHref)} href={meta.secondaryCtaHref}>
            {getCtaLabel(meta.secondaryCtaHref)}
          </a>
        )}
        <a class="btn-outline" href="/blog">All categories</a>
      </div>
    </div>
  </section>

  <section id="category-intents">
    <div class="container">
      <h2 class="section-title">Questions You Can Explore Here</h2>
      <p class="section-sub">Start here if you want practical answers around these questions and decisions.</p>
      <div class="intent card">
        <ul class="intent-list">
          {meta.primaryIntents.map((intent) => <li>{intent}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {hasLivePosts ? (
    <section id="category-posts">
      <div class="container">
        <h2 class="section-title">Published Articles in This Category</h2>
        <p class="section-sub">Start with the most relevant article, then move through the rest if you want deeper detail.</p>
        <div class="post-grid">
          {categoryPosts.map((post) => (
            <a class="post-item" href={`/blog/${post.categorySlug}/${post.slug}/`} aria-label={`Read ${post.title}`}>
              <div class="post-top">
                <span>{formatDate(post.publishedAtISO)}</span>
                <span>{post.readTimeMinutes} min read</span>
              </div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="post-link">Read article &rsaquo;</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section id="category-posts">
      <div class="container">
        <h2 class="section-title">More Guides Coming Soon</h2>
        <p class="section-sub">More practical guides for this category are on the way.</p>
        <div class="examples card">
          <div class="example-grid">
            {meta.exampleSlugs.map((slug) => (
              <code class="example">{`/blog/${meta.slug}/${slug}/`}</code>
            ))}
          </div>
          <p class="examples-note">Upcoming guides in this category.</p>
        </div>
      </div>
    </section>
  )}

  <LinkDirectorySection
    sectionId="category-related-links"
    title="Explore Related Reads and Next Steps"
    subtitle="Keep reading, or open the next page that helps you make a clearer move."
    items={categoryDirectoryItems}
    altBackground={true}
  />

  <Footer />
</BaseLayout>

<style>
  #cat-hero { padding: 140px 0 84px; position: relative; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.55); }
  .breadcrumb a:hover { color: rgba(255,255,255,.9); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 760px; margin-bottom: 1.8rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 1.6rem; }

  #category-intents,
  #category-posts { padding: 5.6rem 0; }
  #category-posts { background: rgba(255,255,255,.012); }
  .section-title { font-size: clamp(2rem, 4.2vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-align: center; }
  .section-sub { max-width: 820px; margin: 0 auto 2rem; color: rgba(255,255,255,.6); font-size: clamp(15px, 2vw, 17px); line-height: 1.75; text-align: center; }
  .intent, .examples { padding: 1.5rem; max-width: 920px; border-color: rgba(255,255,255,.10); margin: 0 auto; }
  .intent-title { font-family: "Sora", sans-serif; font-weight: 800; font-size: 13px; letter-spacing: .02em; color: #fff; margin-bottom: .9rem; }
  .intent-list { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
  .intent-list li { font-size: 13px; color: rgba(255,255,255,.62); padding-left: 1rem; position: relative; }
  .intent-list li::before { content: '>'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }

  .post-grid { display: grid; gap: .8rem; max-width: 920px; margin: 0 auto; }
  .post-item {
    display: block;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 12px;
    background: rgba(255,255,255,.03);
    padding: 1rem;
    transition: transform .2s, border-color .2s, background .2s;
  }
  .post-item:hover {
    transform: translateY(-2px);
    border-color: rgba(45,212,191,.34);
    background: rgba(45,212,191,.04);
  }
  .post-top {
    display: flex;
    gap: 10px;
    justify-content: space-between;
    flex-wrap: wrap;
    color: rgba(255,255,255,.45);
    font-size: 12px;
    margin-bottom: .5rem;
  }
  .post-item h3 {
    font-size: 1rem;
    line-height: 1.35;
    color: #fff;
    margin-bottom: .45rem;
  }
  .post-item p {
    color: rgba(255,255,255,.58);
    font-size: 13.5px;
    line-height: 1.7;
    margin-bottom: .55rem;
  }
  .post-link { font-size: 13px; font-weight: 800; color: var(--gold); }

  .example-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .example { display: block; font-size: 12px; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.10); color: rgba(255,255,255,.78); overflow-x: auto; }
  .examples-note { margin-top: 12px; color: rgba(255,255,255,.4); font-size: 13px; line-height: 1.6; }

  @media (max-width: 900px) { .example-grid { grid-template-columns: 1fr; } }
  @media (max-width: 680px) {
    #cat-hero { padding: 120px 0 72px; }
    #category-intents,
    #category-posts { padding: 4.8rem 0; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
  }
</style>
