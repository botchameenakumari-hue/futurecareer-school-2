---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_CATEGORIES, BLOG_PUBLISHED_POSTS } from '../../config/blog';

const hasPublishedPosts = BLOG_PUBLISHED_POSTS.length > 0;

const latestPosts = [...BLOG_PUBLISHED_POSTS]
  .sort((a, b) => b.publishedAtISO.localeCompare(a.publishedAtISO))
  .slice(0, 6);

const postCountsByCategory = new Map<string, number>();
for (const post of BLOG_PUBLISHED_POSTS) {
  postCountsByCategory.set(post.categorySlug, (postCountsByCategory.get(post.categorySlug) ?? 0) + 1);
}

const formatDate = (isoDate: string) =>
  new Intl.DateTimeFormat('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(new Date(isoDate));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Blog | Future Career School',
    description:
      'Career guidance articles and practical guides on careers, skills, job search, salary growth, assessments, and AI readiness.',
    url: 'https://futurecareerschool.com/blog',
    inLanguage: 'en-IN',
    publisher: {
      '@type': 'EducationalOrganization',
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
    },
  },
];
---

<BaseLayout
  title="Blog | Career Guidance Articles, Skill Roadmaps, and Job Strategy | Future Career School"
  description="Explore practical career guidance articles on career options, stream selection, skill roadmaps, salary growth, assessments, and AI readiness."
  canonical="https://futurecareerschool.com/blog"
  jsonLd={jsonLd}
  noindex={!hasPublishedPosts}
>
  <Nav activePage="blog" />

  <section id="blog-hero">
    <div class="hero-bg">
      <div class="orb orb-gold"></div>
      <div class="orb orb-teal"></div>
    </div>
    <div class="container hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Blog</span>
      </nav>
      <div class="pill hero-pill"><span class="pill-dot"></span>Practical articles by topic</div>
      <h1 class="hero-title">
        Practical Career Articles for
        <span class="gold-text"> Real Decisions</span>
      </h1>
      <p class="hero-sub">
        Explore practical guides on career options, stream selection, skill building, salary growth, assessments, and AI readiness.
        Start with the topic closest to the decision you are trying to make.
      </p>
      <div class="hero-actions">
        <a href="/services/career-counselling-and-career-guidance" class="btn-gold pulse">Career Guidance</a>
        <a href="/services/assessments" class="btn-outline">Assessments</a>
        <a href="/skill-finder" class="btn-outline">Skill Finder</a>
      </div>
    </div>
  </section>

  {hasPublishedPosts && (
    <section id="latest-posts">
      <div class="container">
        <div class="section-tag pill"><span style="color:var(--gold)">&#9673;</span>&nbsp;Latest Guides</div>
        <h2 class="section-title">Latest Published Articles</h2>
        <p class="section-sub">Start with these practical guides, then move deeper into each category.</p>

        <div class="post-grid">
          {latestPosts.map((post) => (
            <a
              class="post-card card"
              href={`/blog/${post.categorySlug}/${post.slug}/`}
              aria-label={`Read ${post.title}`}
            >
              <div class="post-card-top">
                <span class="post-tag">{post.categorySlug.replaceAll('-', ' ')}</span>
                <span class="post-date">{formatDate(post.publishedAtISO)}</span>
              </div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="post-meta">{post.readTimeMinutes} min read</div>
              <div class="post-link">Read article &rsaquo;</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="categories">
    <div class="container">
      <div class="section-tag pill"><span style="color:var(--teal)">&#9673;</span>&nbsp;Topics</div>
      <h2 class="section-title">Blog Categories</h2>
      <p class="section-sub">Browse by topic, then go deeper into the guides that match your current question.</p>

      <div class="cat-grid">
        {BLOG_CATEGORIES.map((cat) => (
          <a class="cat-card card" href={`/blog/${cat.slug}/`} aria-label={`Open ${cat.title} category`}>
            <div class="cat-title">{cat.title}</div>
            <div class="cat-desc">{cat.description}</div>
            <div class="cat-meta">{cat.primaryIntents.slice(0, 3).join(' · ')}</div>
            <div class="cat-live">{postCountsByCategory.get(cat.slug) ?? 0} live post(s)</div>
            <div class="cat-link">View category &rsaquo;</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  section { position: relative; overflow: hidden; }
  #blog-hero { padding: 140px 0 84px; }
  .hero-bg { position: absolute; inset: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-gold { width: 520px; height: 520px; top: -170px; left: -110px; background: radial-gradient(circle, rgba(229,184,74,.18), transparent 70%); }
  .orb-teal { width: 420px; height: 420px; top: -40px; right: -120px; background: radial-gradient(circle, rgba(45,212,191,.11), transparent 70%); }
  .hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.38); margin-bottom: 2rem; flex-wrap: wrap; }
  .breadcrumb a { color: rgba(255,255,255,.55); }
  .hero-pill { width: fit-content; margin-bottom: 1.6rem; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
  .hero-title { font-size: clamp(2.35rem, 5vw, 3.9rem); line-height: 1.04; letter-spacing: -.04em; color: #fff; max-width: 980px; margin-bottom: 1.25rem; }
  .hero-sub { font-size: clamp(15px, 1.9vw, 18px); color: rgba(255,255,255,.56); line-height: 1.8; max-width: 760px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  #latest-posts { padding: 5.5rem 0 2rem; }
  .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .post-card { padding: 1.35rem; border-color: rgba(255,255,255,.1); transition: transform .25s, border-color .25s, background .25s; }
  .post-card:hover { transform: translateY(-3px); border-color: rgba(45,212,191,.34); background: rgba(45,212,191,.04); }
  .post-card-top { display: flex; justify-content: space-between; gap: 10px; align-items: center; margin-bottom: .75rem; flex-wrap: wrap; }
  .post-tag { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: rgba(45,212,191,.95); }
  .post-date { font-size: 12px; color: rgba(255,255,255,.45); }
  .post-card h3 { color: #fff; font-size: 1.08rem; line-height: 1.35; margin-bottom: .6rem; }
  .post-card p { color: rgba(255,255,255,.58); font-size: 14px; line-height: 1.72; margin-bottom: .7rem; }
  .post-meta { font-size: 12px; color: rgba(255,255,255,.4); margin-bottom: .55rem; }
  .post-link { font-size: 13px; font-weight: 800; color: var(--gold); }

  #categories { padding: 3.3rem 0 7rem; background: rgba(255,255,255,.012); }
  .section-tag { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 1.25rem; }
  .section-title { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; text-align: center; }
  .section-sub { font-size: 16px; color: rgba(255,255,255,.55); max-width: 820px; margin: 0 auto 3rem; text-align: center; line-height: 1.75; }

  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.15rem; }
  .cat-card { padding: 1.6rem; display: flex; flex-direction: column; min-height: 100%; border-color: rgba(255,255,255,.10); transition: transform .25s, border-color .25s, background .25s; }
  .cat-card:hover { transform: translateY(-3px); border-color: rgba(229,184,74,.22); background: rgba(229,184,74,.02); }
  .cat-title { font-family: "Sora", sans-serif; font-weight: 900; letter-spacing: -.02em; margin-bottom: .55rem; color: #fff; }
  .cat-desc { color: rgba(255,255,255,.56); line-height: 1.7; font-size: 13.5px; margin-bottom: 1rem; }
  .cat-meta { font-size: 12px; color: rgba(255,255,255,.35); line-height: 1.6; margin-bottom: .9rem; }
  .cat-live { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: rgba(45,212,191,.88); margin-bottom: .65rem; }
  .cat-link { margin-top: auto; font-size: 13px; font-weight: 800; color: var(--gold); }

  @media (max-width: 980px) {
    .post-grid { grid-template-columns: 1fr; }
    .cat-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    #blog-hero { padding: 120px 0 72px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-gold, .hero-actions .btn-outline { justify-content: center; }
  }
</style>
