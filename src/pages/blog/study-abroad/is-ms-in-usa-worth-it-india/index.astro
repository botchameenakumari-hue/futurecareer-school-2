const faq = [
  {
    q: 'Is doing an MS in USA worth it for Indian students in 2026?',
    a: 'It depends entirely on the field, the university tier, and how you fund it. An MS in computer science, data science, or engineering from a well-ranked public university, funded mostly through savings or a manageable loan, still produces a strong return for most students within 3-6 years of working in the US or returning to India with US experience. An MS in a saturated field, from a low-ranked university, funded entirely through high-interest debt, is a weak bet — the degree cost and the H1B uncertainty combine to create real financial risk that a general "worth it" answer cannot capture.',
  },
  {
    q: 'How much does an MS in USA actually cost in total for Indian students?',
    a: 'All-in, over roughly two years, expect Rs 60-80 lakh at budget public universities in lower-cost cities, Rs 95 lakh to Rs 1.25 crore at mid-range public universities in bigger cities, and Rs 1.4 crore to Rs 1.8 crore or more at private and Ivy-tier universities in expensive metros. This includes tuition, housing, food, health insurance, and visa costs — not just the tuition figure shown on a university brochure.',
  },
  {
    q: 'What are the real odds of getting an H1B visa after an MS in USA?',
    a: 'As of the FY2027 cycle, the H1B lottery moved from a fully random draw to a wage-weighted selection process. Entry-level (Level I) wage positions, which is where most fresh MS graduates land, face roughly 15% selection odds. Odds rise with wage level: roughly 31% for Level II, 46% for Level III, and 61% for Level IV. This means a fresh graduate on OPT is now more exposed to lottery risk than someone with several years of US work experience already earning a higher wage band.',
  },
  {
    q: 'What can I realistically earn after an MS in USA before the H1B question even comes up?',
    a: 'During the Optional Practical Training window, average earnings for international graduates run roughly USD 70,000-98,000 a year, with computer science and data-heavy specializations often starting closer to USD 90,000-120,000 depending on the employer and city. STEM graduates get up to 36 months of OPT work authorization combined, while non-STEM graduates get 12 months only — which matters directly for how many H1B lottery attempts you get before your work authorization runs out.',
  },
  {
    q: 'Is it better to stay in India and build a career here instead of doing an MS in USA?',
    a: 'For a large share of Indian graduates, yes — particularly in fields where Indian employers now pay competitively for scarce skills, and where the MS does not unlock a role or salary tier that is otherwise unreachable. Staying in India avoids the loan burden, the visa lottery risk, and the multi-year separation from family, while still letting you build the same proof of work through a strong job, a portfolio, and targeted certifications. The honest comparison is not "US salary vs India salary" in isolation — it is total lifetime cost and risk against a specific outcome you can actually name, not a vague sense that abroad is automatically better.',
  },
  {
    q: 'What happens if I do not get selected in the H1B lottery after my OPT ends?',
    a: 'If your OPT and any STEM extension run out without an H1B selection, you generally have a short grace period before you must leave the US, unless another visa category applies to your situation (such as a change of status, a different sponsored visa, or continuing study). This is exactly why the H1B lottery odds are not a footnote — they are a real planning variable. Anyone treating a US MS as an automatic and unavoidable path to living and working in the US long-term is planning around hope, not a backup plan.',
  },
  {
    q: 'Are assistantships, scholarships, or on-campus jobs a realistic way to fund an MS in USA?',
    a: "Partially, and mostly at the PhD level rather than a standalone MS. Teaching and research assistantships that cover tuition and a stipend are common for PhD students but comparatively rare for terminal MS students outside a handful of research-heavy programs, so most MS applicants should not plan their budget around winning one. On-campus jobs are capped at 20 hours a week during the semester under F-1 visa rules and mainly cover incidental expenses, not tuition. University-specific merit scholarships exist and are worth applying for early, but treat any of these as a possible reduction to your total cost, not the baseline plan your loan and savings math should assume.",
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Study Abroad', item: 'https://futurecareerschool.com/blog/study-abroad' },
      { '@type': 'ListItem', position: 4, name: 'Is MS in USA Worth It India', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'Is MS in USA Worth It for Indian Students? The Real ROI Math',
    description:
      'Is MS in USA worth it India: real total cost by university tier, post-MS salary and OPT earning window, honest H1B lottery odds, and a clear-headed comparison against staying in India.',
    datePublished: publishedDateISO,
    dateModified: publishedDateISO,
    mainEntityOfPage: canonical,
    inLanguage: 'en-IN',
    author: {
      '@type': 'Person',
      name: authorName,
      url: authorUrl,
      jobTitle: authorRole,
    },
    publisher: {
      '@type': ['Organization', 'ProfessionalService'],
      name: 'Future Career School',
      url: 'https://futurecareerschool.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://futurecareerschool.com/favicon.svg',
      },
    },
    articleSection: ['Study Abroad', 'Higher Studies', 'Career Guidance', 'Financial Decision-Making'],
    keywords: [
      primaryKeyword,
      'MS in USA cost for Indian students',
      'H1B visa odds after MS',
      'MS in USA ROI',
      'should I do MS in USA or stay in India',
      'OPT salary international students',
      'MS in USA worth it or not',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
