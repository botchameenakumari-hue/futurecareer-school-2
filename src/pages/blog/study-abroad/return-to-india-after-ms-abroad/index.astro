---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'Return to India after MS abroad: the practical playbook for timing, jobs, and money';
const description =
  'Return to India after MS abroad, done right: time your move around OPT and visa windows, target Indian employers before you land, and set real salary and relocation expectations.';
const canonical = 'https://futurecareerschool.com/blog/study-abroad/return-to-india-after-ms-abroad';
const publishedDateISO = '2026-07-20';
const publishedDateLabel = '20 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career strategist and writer';

const jumpLinks = [
  { id: 'windows', label: 'The 3-Window Return Plan' },
  { id: 'opt-timing', label: 'Timing your move around OPT and visa rules' },
  { id: 'job-search', label: 'Job search strategy targeting India' },
  { id: 'employer-value', label: 'How Indian employers actually value a foreign MS' },
  { id: 'salary-reset', label: 'What the salary reset really looks like' },
  { id: 'relocation', label: 'The relocation logistics checklist' },
  { id: 'first-90', label: 'Your first 90 days back' },
  { id: 'mistakes', label: 'Mistakes that cost people a full salary cycle' },
  { id: 'source-check', label: 'Source check' },
  { id: 'next-step', label: 'Related reading' },
  { id: 'faq', label: 'FAQs' },
];

const windowCards = [
  {
    num: '01',
    title: 'Plan window: 6-12 months out',
    body: 'Runs from the point you decide to return through your last full semester. Lock your visa/OPT math, start building an India-facing network, and get your resume speaking Indian-market language instead of campus-recruiting language.',
  },
  {
    num: '02',
    title: 'Transition window: your final 90 days abroad',
    body: 'This is where OPT filing deadlines, exit timing, and your active India job search overlap. Most of the expensive mistakes on this page happen because this window was not planned as its own phase.',
  },
  {
    num: '03',
    title: 'Landing window: your first 90 days in India',
    body: 'Bank account conversion, tax residency status, shipment clearance, and closing out the job search all happen here. Treat it as a checklist stage, not something you figure out after you land tired and jet-lagged.',
  },
];

const optSteps = [
  {
    num: '01',
    title: 'Apply for OPT before you leave the country, even if you plan to return home',
    body: 'You can file up to 90 days before your program end date on your I-20. If you exit the US without having applied, you lose OPT eligibility entirely. This single rule catches more people than any other on this list.',
  },
  {
    num: '02',
    title: 'Choose your OPT start date based on your job search stage, not a default',
    body: 'You pick the start date within 60 days of your program end date. An earlier start lets you begin work sooner but starts your unemployment clock sooner too. A later start buys job-search time but delays your earliest possible start date.',
  },
  {
    num: '03',
    title: 'Track your 90-day unemployment clock like a hard deadline',
    body: 'Once OPT is active, F-1 status allows up to 90 cumulative days without qualifying employment. Miss that window without a job or a status change and your legal basis to stay evaporates, which forces a rushed, badly timed return instead of a planned one.',
  },
  {
    num: '04',
    title: 'Build in USCIS processing time, not the best-case estimate',
    body: 'Median processing for the OPT application (Form I-765) runs close to 90 days. File early and assume delays. A processing delay that eats into your unemployment clock before you have even started counts against you.',
  },
];

const jobSearchCards = [
  {
    label: 'Channel',
    title: 'India-specific job boards and referrals, not the US campus portal',
    body: 'Naukri, LinkedIn set to India location filters, and direct outreach to India-based hiring managers surface roles a US career center never will. Referrals from alumni already working in India move faster than cold applications on both sides.',
  },
  {
    label: 'Channel',
    title: 'India offices of the multinationals you are already interviewing with',
    body: 'If you are talking to a global consulting firm, bank, or tech company for a US role, ask directly whether an India-based transfer or a parallel India-hiring track exists. Internal referral into the India office is usually faster than restarting cold once you land.',
  },
  {
    label: 'Timing',
    title: 'Start the India-facing search 3-4 months before your planned landing date',
    body: 'Indian hiring cycles do not run on the same calendar as US campus recruiting. Roles you apply for from abroad give recruiters time to schedule video rounds around your timezone before you become one more resume in the domestic applicant pool.',
  },
  {
    label: 'Sector',
    title: 'Target sectors with a live demand-supply gap first',
    body: 'AI/ML, data science, and pharma currently have open, research-adjacent roles that specifically reward an international MS and a thesis or lab background. Generic software engineering hiring has tightened, so a general "I have an MS" pitch competes with far more candidates there.',
  },
];

const employerFactRows = [
  {
    signal: 'Typical foreign-degree salary premium',
    detail: 'Reported in the 20-40% range over an equivalent India degree at entry level, with consulting and finance running closer to 40-50% and academia closer to 25-35%.',
  },
  {
    signal: 'Credential recognition',
    detail: 'Most private-sector employers accept a foreign MS directly during hiring. Government roles and some PSU postings require formal AIU (Association of Indian Universities) equivalence, which is a separate, sometimes slow paperwork step worth starting early if a government track is even a possibility.',
  },
  {
    signal: 'What actually gets you shortlisted',
    detail: 'A named university and a general "MS in the US/UK" line rarely does the work alone. A specific thesis topic, a lab or research group name, or a specialization tied to a real open role gets read very differently than a generic line item.',
  },
  {
    signal: 'Where the degree carries the most weight',
    detail: 'Roles that explicitly ask for research depth or global-market exposure. AI/ML, data science, pharma R&D, and specialised finance/consulting roles are currently the strongest fits for a foreign MS pitch.',
  },
];

const salaryRows = [
  {
    path: 'Return immediately after MS, no work experience abroad',
    range: 'Roughly Rs 15-26 lakh per year for a UK MS in IT, engineering, or science roles; figures vary by university tier and specialization.',
  },
  {
    path: 'Return after 1 year of industry experience abroad',
    range: 'Roughly 30-45% higher landing salary in India than an immediate return with the same degree, based on reported UK industry-experience data.',
  },
  {
    path: 'Return after 2-3 years of work experience abroad',
    range: 'Roughly Rs 18-25 lakh+ reported for candidates with international work experience, against roughly Rs 8-12 lakh for a same-age fresher with no abroad work experience.',
  },
];

const relocationRows = [
  {
    task: 'Tax residency status',
    detail: "You become an Indian tax resident once you cross 182 days in India in a financial year (April-March). Higher earners with more than roughly Rs 15 lakh of India income can trigger resident-but-not-ordinarily-resident (RNOR) status even sooner. Work out your residency date on a calendar before you land, not after.",
  },
  {
    task: 'NRE/NRO account conversion',
    detail: 'Your NRE and NRO accounts need to convert to resident accounts within a reasonable period after your return, once you become a tax resident. Existing NRE fixed deposits can usually continue until maturity at their original NRE terms.',
  },
  {
    task: 'Foreign currency you are still holding',
    detail: 'An RFC (Resident Foreign Currency) account lets you hold USD, GBP, or EUR balances in India instead of forcing an immediate conversion, which matters if exchange timing affects what you actually walk away with.',
  },
  {
    task: 'Shipping your belongings',
    detail: 'Sea freight is cheaper and takes roughly 6-8 weeks; air freight is faster, roughly 1-2 weeks, at a real cost premium. Get quotes from at least two or three movers, and build a photographed inventory list before pickup for both insurance and customs purposes.',
  },
  {
    task: 'Customs on personal effects',
    detail: 'Returning students and professionals typically get a duty-free allowance on used personal effects, but the exact allowance and documentation rules change, so confirm current limits with your mover or a customs advisor rather than assuming last year\'s numbers still apply.',
  },
  {
    task: 'A landing-cost buffer',
    detail: 'Rental deposits, a starter set of furniture, transport, and the gap before your first India paycheck add up fast. Planning a dedicated settling-in buffer before you land avoids the awkward first month of paying for everything on a card meant for something else.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Treating the return date as a visa deadline instead of a planned decision',
    body: 'Letting the OPT unemployment clock force your exit date means you land with whatever offer exists that week, not the offer that actually fits your goals. Plan the transition window on purpose, months ahead.',
  },
  {
    num: '02',
    title: 'Applying to India roles only after landing',
    body: 'Recruiters take weeks to schedule and run interview loops. Starting your India-facing search only after you touch down adds a full avoidable cycle of unemployment on top of the one you may have already had abroad.',
  },
  {
    num: '03',
    title: 'Pitching the degree as a headline instead of a specific skill',
    body: 'A resume line that just says "MS from a US university" reads as generic. Naming the exact specialization, thesis, tools, or lab work you did is what turns a foreign degree from a credential into evidence a hiring manager can actually use.',
  },
  {
    num: '04',
    title: 'Expecting your US or UK salary math to translate directly',
    body: "A salary that felt modest abroad can still be a strong outcome in India once cost of living, family proximity, and career runway are weighed together. Comparing raw numbers across currencies without adjusting for cost of living produces a distorted, discouraging picture that does not match reality.",
  },
  {
    num: '05',
    title: 'Ignoring AIU equivalence until a government or PSU application asks for it',
    body: 'If there is any real chance you will apply to a government-linked role later, start the equivalence paperwork early. It is not needed for most private-sector hiring, but it is slow enough that starting it reactively usually means missing the application window it was meant for.',
  },
  {
    num: '06',
    title: 'Skipping the tax-residency calendar entirely',
    body: 'Crossing the 182-day threshold without planning for it can leave you filing as a resident for a year you expected to file as an NRI, with real consequences for how foreign income and remaining foreign accounts get taxed.',
  },
];

const faqItems = [
  {
    q: 'When should I start my job search if I plan to return to India after MS abroad?',
    a: 'Start the India-facing search roughly 3-4 months before your planned landing date, in parallel with any US-based search you are still running. Indian hiring cycles need time for recruiter screening, video interview rounds across time zones, and offer negotiation, and none of that speeds up because you have already landed.',
  },
  {
    q: 'Do I need to apply for OPT if I already know I am returning to India?',
    a: 'Apply anyway, before you leave the country. You can file up to 90 days before your program end date, and if you exit the US without having applied, you permanently lose OPT eligibility. Even a short OPT window can be worth using for interviews, an internal transfer conversation, or extra runway while you finalize your India plan.',
  },
  {
    q: 'How much salary reset should I actually expect when I return to India after MS abroad?',
    a: 'It depends heavily on whether you return immediately or after gaining industry experience abroad first. Immediate returnees with a foreign MS report landing roughly Rs 15-26 lakh a year depending on field and university tier, while candidates with 2-3 years of work experience abroad report closer to Rs 18-25 lakh+, against roughly Rs 8-12 lakh for a same-age fresher without abroad experience. Even a single year of industry experience abroad is reported to raise the India landing salary by roughly 30-45% compared to returning with no work experience at all.',
  },
  {
    q: 'Will Indian employers actually value my foreign MS, or is it just a marketing line?',
    a: 'Most private-sector employers accept a foreign MS directly and treat it as a real differentiator, with reported salary premiums in the 20-40% range over an equivalent India degree, higher in consulting and finance. Government and PSU roles are the exception; they usually require formal AIU equivalence, which is a separate, slower process worth starting early if that path is even a possibility.',
  },
  {
    q: 'What relocation logistics get missed most often when moving back to India after MS abroad?',
    a: 'Tax residency timing and NRE/NRO account conversion are the two most commonly missed. Crossing the 182-day residency threshold without planning for it changes how your remaining foreign income and accounts get taxed for that year, and it is far easier to plan around than to fix after the fact.',
  },
  {
    q: 'Is it better to work abroad for a year or two before returning, or come back right after graduation?',
    a: 'There is no universal answer, and it depends on visa runway, family situation, and how strong your India-facing offers already are. What the data does show is that even a short stretch of industry experience abroad tends to raise your landing salary and shortlist rate in India meaningfully, so if your visa situation allows it and a reasonable offer exists, a short work stretch first is often worth weighing seriously against an immediate return.',
  },
  {
    q: 'How do I negotiate an India salary using my abroad experience without overpricing myself?',
    a: 'Anchor the conversation on outcomes, not on currency conversion. Bring specific numbers, such as a project you led, the scale of data or budget you handled, or a measurable result from your abroad role, and let the Indian employer\'s band for that seniority level set the ceiling. Quoting your foreign salary directly, converted at face value, usually reads as out of touch with the local market and can work against you rather than for you.',
  },
  {
    q: 'Is reverse culture shock a real concern when returning to India after MS abroad?',
    a: 'Yes, and it is worth planning for the same way you plan for the paperwork. Traffic, bureaucracy, family dynamics, and a slower pace on some processes can feel jarring after a few years abroad, even for people who grew up in India. Giving yourself a genuine adjustment period in the first 90 days, rather than judging the whole decision from week two, prevents a temporary adjustment dip from being mistaken for a wrong decision.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="study-abroad"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>Once you have decided to return to India after MS abroad, the real work is not the decision anymore, it is the execution.</strong>
    That means timing your exit around OPT or visa rules so you do not get forced into a rushed departure, starting
    an India-facing job search while you are still abroad instead of after you land, and setting salary and
    relocation expectations based on real numbers rather than a US or UK paycheck converted at face value.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>File for OPT before you leave the country even if you are certain you are returning, or you lose eligibility permanently.</li>
      <li>Start applying for India roles roughly 3-4 months before your planned landing date, not after you touch down.</li>
      <li>Most private employers value a foreign MS directly, with reported premiums of 20-40%, but a specific thesis or specialization gets you shortlisted far more than the degree name alone.</li>
      <li><strong>Plan tax residency, bank account conversion, and shipping as their own checklist stage in the months before you land, not as something to figure out once you arrive.</strong></li>
      <li>The bigger goal behind all of this planning: a well-timed return converts your abroad degree into a real high-income skill portfolio in the Indian market, instead of losing months of income to an avoidable gap.</li>
      <li>If a loan is still running, model the EMI against India take-home pay before fixing the return date. A foreign salary converted into rupees is not the same as a sustainable repayment plan after taxes and living costs.</li>
    </ul>
  </div>

  <p>
    If you are still weighing the bigger decision, the <a href="/blog/study-abroad/">study abroad guidance library</a>
    covers the ROI and country-choice side of this. What follows here assumes that decision is already made, and
    focuses purely on getting the execution right.
  </p>

  <p>
    If your timeline, offer situation, or family constraints are genuinely complicated, or you are trying to decide
    between an immediate return and a short work stretch abroad first,
    <a href="/services/career-counselling-and-career-guidance/">career counselling and career guidance</a> can help
    you build a plan around your specific visa runway and target roles instead of generic advice.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="windows">The 3-Window Return Plan</h2>

  <p>
    Most of the stress around returning to India after MS abroad comes from treating it as one giant, vague
    "sometime in the next year" event instead of three distinct, sequential phases. The 3-Window Return Plan splits
    it into a plan window, a transition window, and a landing window, each with its own job.
  </p>

  <div class="checkpoint-list">
    {windowCards.map((item) => (
      <article class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__content">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      </article>
    ))}
  </div>

  <p class="section-note">
    The rest of this article walks through each window in order: what to do about your visa and OPT status, how to
    search for India roles while still abroad, how to read your own market value once offers start coming in, and
    what the relocation checklist actually looks like once you land.
  </p>

  <h2 id="opt-timing">Timing your move around OPT and visa rules</h2>

  <p>
    If you are on an F-1 visa in the US, your OPT status is the single biggest lever on when you can actually leave
    without burning a job offer or a legal deadline. Get this sequence wrong and the visa clock, not your own
    judgment, ends up deciding your return date.
  </p>

  <div class="checkpoint-list">
    {optSteps.map((item) => (
      <article class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__content">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">Read this carefully</p>
    <p class="callout__footer">
      If you are on a different visa route (UK Graduate Route, Canada PGWP, Australia's post-study work visa), the
      exact rules differ, but the underlying planning logic is identical: check your program's exact filing deadline
      and your allowed unemployment or job-search window months in advance, not in your final semester.
    </p>
  </div>

  <h2 id="job-search">Job search strategy targeting India</h2>

  <p>
    A job search built for US campus recruiting and a job search built for the Indian market are not the same
    search. Running only the first one and expecting India offers to appear once you land is the most common reason
    people spend an extra unplanned month or two unemployed after arriving.
  </p>

  <div class="career-grid">
    {jobSearchCards.map((item) => (
      <article class="career-card">
        <span class="career-card__label">{item.label}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>

  <p class="section-note">
    Video-round interviews across a US-India time gap are normal and expected by recruiters running international
    searches. Do not wait until you are physically in India to start these conversations; that delay is the one
    most easily avoided.
  </p>

  <h2 id="employer-value">How Indian employers actually value a foreign MS</h2>

  <p>
    The honest picture sits between two extremes: the degree is not an automatic fast pass, and it is not
    worthless either. Where it lands depends on the sector and on how specifically you present it.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Signal</th>
          <th>What the data and hiring pattern actually show</th>
        </tr>
      </thead>
      <tbody>
        {employerFactRows.map((row) => (
          <tr>
            <td data-label="Signal">{row.signal}</td>
            <td data-label="What the data and hiring pattern actually show">{row.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="honest-take-box">
    <p class="honest-label">Honest take</p>
    <p>
      A foreign MS opens doors that a domestic degree alone would not, especially in research-heavy or
      globally-facing roles. It does not replace the need to show what you actually did with it. "MS from a US
      university" and "MS focused on applied machine learning for supply chain forecasting, thesis published at
      [venue]" get read by two different hiring managers, even when they land on the same desk.
    </p>
    <p>
      Building a genuine high-income skill portfolio here means pairing the degree with proof of work,
      clear communication of your specialization, and market positioning for the specific sector that
      values it most — not leaning on the university name alone.
    </p>
  </div>

  <h2 id="salary-reset">What the salary reset really looks like</h2>

  <p>
    "Salary reset" is the right phrase, but it is easy to picture it as worse than the data actually shows,
    especially if you are only comparing raw currency numbers against your abroad stipend or salary without
    adjusting for cost of living.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Return path</th>
          <th>Reported India landing salary range</th>
        </tr>
      </thead>
      <tbody>
        {salaryRows.map((row) => (
          <tr>
            <td data-label="Return path">{row.path}</td>
            <td data-label="Reported India landing salary range">{row.range}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="section-note">
    These are reported ranges from industry sources, not guaranteed outcomes for your specific field, university, or
    negotiation. Treat the pattern as the useful part: work experience abroad, even a short stretch, consistently
    moves the number up, and sector choice moves it further than degree prestige alone.
  </p>

  <div class="highlight-box highlight-box--teal">
    <p>
      <strong>The number that actually matters is not the salary gap versus your abroad stipend.</strong> It is the
      real, adjusted comparison: rent, healthcare, family proximity, career runway, and take-home pay after cost of
      living on both sides. A number that looks like a step down in raw currency can be a step up once that full
      picture is on the table.
    </p>
  </div>

  <h2 id="relocation">The relocation logistics checklist</h2>

  <p>
    This is the part most return-focused advice skips entirely in favor of career talk. Get it wrong and it costs
    real money and time in your first few months back, independent of how good your job offer is.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Task</th>
          <th>What to actually do</th>
        </tr>
      </thead>
      <tbody>
        {relocationRows.map((row) => (
          <tr>
            <td data-label="Task">{row.task}</td>
            <td data-label="What to actually do">{row.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="section-note">
    Start this checklist 6-12 months before your intended move, not in your final month abroad. Tax residency
    planning and shipping quotes in particular need lead time that a rushed exit does not leave room for.
  </p>

  <h2 id="first-90">Your first 90 days back</h2>

  <p>
    Once you land, the landing window from The 3-Window Return Plan above becomes the active phase. Three things
    deserve priority in these first 90 days: converting your NRE/NRO accounts once your residency status is clear,
    closing out any interview loops you started while still abroad instead of letting them go cold, and giving
    yourself a real adjustment period before judging whether the return was the right call.
  </p>

  <p>
    A slower first month is normal, not a warning sign. Time zones, family dynamics, and a new commute all take
    real adjustment, and judging the whole decision from week two tends to produce a distorted read.
  </p>

  <div class="cta-inline">
    <a class="btn-gold pulse" href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">Get personalised career guidance</a>
    <a class="btn-outline" href="https://futurecareerschool.com/services/assessments">Free career and skill assessments</a>
  </div>

  <h2 id="mistakes">Mistakes that cost people a full salary cycle</h2>

  <div class="mistake-list">
    {mistakeItems.map((item) => (
      <article class="mistake-item">
        <div class="mistake-item__num">{item.num}</div>
        <div class="mistake-item__content">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      </article>
    ))}
  </div>

  <h2 id="source-check">Source check</h2>

  <p>
    Visa and immigration rules and NRI tax rules both change. Verify anything time-sensitive against the official
    source below before you act on it.
  </p>

  <div class="source-grid">
    <article class="source-card">
      <span class="source-card__label">USCIS</span>
      <h3>Optional Practical Training (OPT) for F-1 Students</h3>
      <p>The official filing window, timing rules, and unemployment limits for F-1 OPT status.</p>
      <a href="https://www.uscis.gov/working-in-the-united-states/students-and-exchange-visitors/optional-practical-training-opt-for-f-1-students" rel="noreferrer" target="_blank">Read the USCIS OPT rules</a>
    </article>
    <article class="source-card">
      <span class="source-card__label">Columbia ISSO</span>
      <h3>F-1 OPT (Optional Practical Training) After Your Degree Program</h3>
      <p>A university international-student office's walkthrough of OPT filing timing and processing expectations.</p>
      <a href="https://isso.columbia.edu/content/f-1-opt-optional-practical-training-after-your-degree-program" rel="noreferrer" target="_blank">Read the ISSO OPT guide</a>
    </article>
    <article class="source-card">
      <span class="source-card__label">Jamboree India</span>
      <h3>Job Prospects in India after MS Abroad</h3>
      <p>Reported hiring outcomes and shortlist rates for students returning to India after an MS abroad.</p>
      <a href="https://www.jamboreeindia.com/know-how/job-prospect-after-ms-abroad" rel="noreferrer" target="_blank">Read the Jamboree report</a>
    </article>
    <article class="source-card">
      <span class="source-card__label">LeapScholar</span>
      <h3>Job Opportunities in India After MS from the UK</h3>
      <p>Reported starting salary ranges for UK-MS graduates entering the Indian job market.</p>
      <a href="https://leapscholar.com/blog/job-opportunities-in-india-after-ms-from-the-uk/" rel="noreferrer" target="_blank">Read the LeapScholar data</a>
    </article>
    <article class="source-card">
      <span class="source-card__label">MBA Crystal Ball</span>
