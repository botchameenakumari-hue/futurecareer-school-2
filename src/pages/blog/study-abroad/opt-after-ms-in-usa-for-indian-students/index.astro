    keywords: [
      primaryKeyword,
      'OPT rules for Indian students',
      'STEM OPT extension eligibility',
      '90 day unemployment rule OPT',
      'OPT to H1B timeline',
      'E-Verify STEM OPT employer',
      'OPT filing window I-765',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
