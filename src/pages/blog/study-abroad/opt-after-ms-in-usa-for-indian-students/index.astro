const faq = [
  {
    q: 'How long can Indian students work in the US on OPT after an MS?',
    a: 'Every eligible F-1 graduate gets 12 months of standard post-completion OPT. If your degree is on the official STEM Designated Degree Program List and your employer is enrolled in E-Verify, you can apply for a further 24-month STEM OPT extension, taking your total work authorization to up to 36 months. Non-STEM graduates are capped at the 12-month window with no extension option.',
  },
  {
    q: 'When should I file my OPT application after finishing my MS?',
    a: 'USCIS accepts Form I-765 for post-completion OPT starting 90 days before your program end date, and no later than 60 days after it. USCIS also requires the application to reach them within 30 days of the date your Designated School Official (DSO) enters the OPT recommendation on your I-20. Given that processing commonly runs 90-120 days, most advisors recommend filing as close to the 90-day-early mark as your school allows, not waiting until graduation.',
  },
  {
    q: 'How many days of unemployment am I allowed on OPT before I fall out of status?',
    a: 'You get a maximum of 90 days of unemployment during the initial 12-month OPT period. If you move into the 24-month STEM OPT extension, you get an additional 60 days, for a combined cap of 150 days across the full 36-month window. USCIS and your school track unemployment days cumulatively, and crossing the limit puts your F-1 status at risk, so short employment gaps need to be reported and closely tracked, not ignored.',
  },
  {
    q: 'Does my employer need to do anything special to sponsor my STEM OPT extension?',
    a: 'Yes. To hire you under the 24-month STEM OPT extension, your employer must be enrolled in E-Verify and remain in good standing with the program, and must complete Form I-983, a formal training plan that lays out the specific knowledge and skills you will gain on the job. A standard 12-month OPT job has no E-Verify or I-983 requirement, which is one reason some employers are comfortable with initial OPT hires but hesitate before the STEM extension.',
  },
  {
    q: 'How does OPT connect to the H1B visa lottery?',
    a: 'OPT is your work authorization while you wait for, or attempt, the H1B lottery — it is not itself a path to long-term status. Your employer registers you during the H1B registration window (typically March), the lottery runs shortly after, and if selected, they file the full petition between April 1 and June 30 for an October 1 start. If your OPT or STEM OPT authorization is still valid when a cap-gap-eligible H1B petition is filed on your behalf, your work authorization automatically extends through the cap-gap period so you are not forced to stop working while the petition is pending.',
  },
  {
    q: 'Does the STEM OPT extension actually improve my odds of getting an H1B?',
    a: 'It does not change your odds on any single attempt, but it changes how many attempts you get. A non-STEM graduate on the 12-month track typically gets one, sometimes two, H1B lottery attempts before their authorization runs out. A STEM OPT graduate on the 36-month track can register across two or three H1B cycles instead of one, which meaningfully raises your cumulative chance of eventually being selected, even though each individual year still runs on the same wage-weighted selection system.',
  },
  {
    q: 'Can I travel internationally while on OPT or STEM OPT?',
    a: 'Yes, but it carries real risk and needs planning. You generally need a valid passport, a valid F-1 visa stamp, a properly endorsed I-20 with a recent travel signature from your DSO, and either a valid job offer letter or proof of current employment to re-enter smoothly. Travel during the gap after filing your I-765 but before approval is especially risky and is generally discouraged. Confirm your specific situation with your DSO before booking any international trip while your OPT status is pending or active.',
  },
  {
    q: 'Can I be self-employed or freelance on OPT?',
    a: 'Limited self-employment is allowed on standard OPT if you can show the work is directly related to your field of study and you can document it, for example through a registered business or contracts. The STEM OPT extension is stricter: it generally requires a formal employer-employee relationship with I-983 training plan obligations, which makes pure self-employment much harder to structure under the STEM extension specifically. Verify your exact situation with your DSO before relying on self-employment as your primary OPT plan.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://futurecareerschool.com/blog' },
      { '@type': 'ListItem', position: 3, name: 'Study Abroad', item: 'https://futurecareerschool.com/blog/study-abroad' },
      { '@type': 'ListItem', position: 4, name: 'OPT After MS in USA for Indian Students', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'OPT after MS in USA for Indian students: the rules that decide your timeline',
    description:
      'OPT after MS in USA for Indian students, explained end to end: 12-month OPT vs 24-month STEM OPT extension eligibility, filing windows, the 90/150-day unemployment limit, E-Verify sponsorship rules, and how OPT bridges into the H1B lottery.',
    datePublished: publishedDateISO,
    dateModified: publishedDateISO,
    mainEntityOfPage: canonical,
    inLanguage: 'en-IN',
    author: {
      '@type': 'Person',
      name: authorName,
