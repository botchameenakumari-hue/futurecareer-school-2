const checkpointItems = [
  {
    num: '01',
    title: 'Program requirement',
    body: 'Before anything else, check the actual admissions page of every program on your shortlist for whether they require, prefer, or simply accept each exam. A strong GRE score is worthless for a program that only reads GMAT scores, and vice versa. This single check eliminates most of the decision for the majority of applicants.',
