  { id: 'which-program-needs-which', label: 'Which programs actually require which exam' },
  { id: 'format-differences', label: 'How the exams are actually built' },
  { id: 'verbal-vs-quant', label: 'Verbal-strong vs quant-strong: which suits you' },
