];

const interviewPrepCards = [
  {
    label: 'Research the role and the company first',
    body: 'Know what the team actually does, not just the company\'s name recognition. Two or three specific, well-informed questions in an interview do more for you than generic enthusiasm.',
  },
  {
    label: 'Prepare the story behind your proof, not just the proof',
    body: 'Interviewers remember how you explain a project - what you decided, what went wrong, what you would do differently - more than the project itself. Practice saying it out loud, not just having it ready to show.',
  },
  {
    label: 'Practice the practical or technical round separately',
    body: 'If the role has a case study, coding round, or skills test, that needs its own practice block, separate from general interview questions. Do not assume general confidence transfers to a timed practical test.',
  },
  {
    label: 'Prepare for the honest fresher questions too',
    body: 'Reasons for any gap, why this role, and what you know about the company are asked in almost every first-job interview. A short, honest, specific answer beats a rehearsed-sounding one.',
  },
];

const offerCompareRows = [
  { factor: 'Role and skill fit', why: 'A role close to the skills you actually want to build compounds faster than a slightly higher starting number in an unrelated role' },
  { factor: 'Manager and learning environment', why: 'Who you report to in your first year shapes how much you actually learn more than the company brand does' },
  { factor: 'Growth path and review cycle', why: 'A clear review and promotion structure tells you when and how your pay is likely to move next, not just where it starts' },
  { factor: 'Job security and company stability', why: 'A slightly lower offer at a stable employer can beat a higher offer at a company with hiring or funding uncertainty' },
  { factor: 'Location and real cost of living', why: 'A higher number in an expensive city can leave less spare income than a moderate offer in a cheaper one - compare take-home against realistic costs, not the headline figure' },
];

const moneyMoves = [
  {
    label: 'Set a buffer before you set a budget',
    body: 'Move a small amount of your first few salaries into an emergency buffer before lifestyle spending grows to fill the new income. This single habit protects every other financial decision you make afterward.',
  },
  {
    label: 'Delay EMI-funded upgrades for a few months',
