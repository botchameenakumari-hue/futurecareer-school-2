  },
];

const skillDimensions = [
  {
    label: 'The right skill mix for your role and goals',
    body: 'Not every high-income skill fits every person or every role - match the skill to your actual target, not to whatever is trending this month.',
  },
  {
    label: 'Proof of work, not just a certificate',
