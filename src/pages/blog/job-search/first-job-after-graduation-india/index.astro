  },
  {
    badge: 'Referrals',
    body: 'A current employee vouching for you moves your resume past the automated filter and straight to a recruiter or hiring manager. Referred candidates get interviewed and hired at meaningfully higher rates than cold applicants, based on large employer datasets in the US and repeated globally.',
    fit: 'Fit: anyone willing to reach out to alumni, LinkedIn connections, or family-network contacts before applying cold.',
    watch: 'Watch out: a referral without any proof of skill behind it does not survive the actual interview.',
  },
  {
    badge: 'Direct outreach and company career pages',
    body: 'Applying straight through a company\'s own careers page, sometimes with a short note to a recruiter, skips the portal noise entirely and shows initiative recruiters notice.',
    fit: 'Fit: a shortlist of 15-25 companies you have researched and actually want to work for.',
    watch: 'Watch out: without a specific reason for reaching out, this reads as another generic application.',
  },
];

const campusPoints = [
  {
    label: 'What campus placements are genuinely good at',
    body: 'A structured, dated process with a known number of rounds, transparent shortlisting criteria, and companies that have already decided to hire freshers from your type of college. If your branch and CGPA clear the first filter, this is the lowest-effort path to an offer.',
  },
  {
    label: 'What campus placements quietly leave out',
    body: 'The number and quality of companies visiting a campus tracks the college\'s brand and location far more than the quality of individual students. A strong student at a college most recruiters skip gets the same thin shortlist as a weaker student at the same college, unless they also work an off-campus channel.',
  },
];

const offCampusRows = [
  { channel: 'Large job portals (Naukri, LinkedIn Jobs, Indeed, Apna)', bestFor: 'Volume and reach across every sector and city', watchOut: 'Most listings are screened by automated keyword matching before a human sees your resume' },
  { channel: 'National Career Service (ncs.gov.in)', bestFor: 'Government-listed openings, apprenticeships, and career centre support at no cost', watchOut: 'Fewer private-sector tech and startup listings than commercial portals' },
  { channel: 'Company career pages', bestFor: 'Roles not always cross-posted to portals, and a cleaner signal to the recruiter that you specifically chose them', watchOut: 'You have to already know which companies to target' },
  { channel: 'Niche and startup job boards, LinkedIn "open to work" posts', bestFor: 'Early-stage companies hiring faster than they can post formally everywhere', watchOut: 'Harder to verify legitimacy; check the company and role before sharing personal documents' },
];

const referralSteps = [
  {
    step: 'Find the connection',
    body: 'Search LinkedIn for alumni from your college, past interns at the company, or extended family and neighbourhood contacts working there. A weak connection who replies is worth more than a strong connection you never message.',
  },
  {
    step: 'Lead with proof, not a request',
    body: 'Send one message that includes a specific thing you built, wrote, or shipped, and the exact role you are targeting. "Can you refer me" with nothing else is easy to ignore. A clear, specific message with proof attached is easy to act on.',
  },
  {
    step: 'Make the ask small and specific',
    body: 'Do not ask someone to "help you get a job." Ask for one thing: forwarding your resume to the hiring manager, confirming whether the role is still open, or a 10-minute call about what the team actually needs. Small asks get said yes to.',
  },
  {
    step: 'Follow up once, then move on',
    body: 'One polite follow-up after a week is normal. Chasing repeatedly damages the relationship and rarely changes the outcome. Keep applying through other lanes while you wait.',
  },
];

const targetListLanes = [
  {
    num: '01',
    title: 'Lane 1: Referral-first companies',
    body: 'The 8-12 companies where you have any real connection, however distant. Message the connection before you formally apply, so your resume arrives with context attached.',
  },
  {
    num: '02',
    title: 'Lane 2: Off-campus portal applications',
    body: 'Roles you find on Naukri, LinkedIn, Indeed, Apna, and the National Career Service that match your target role and skill level closely enough that you would pass a 75%+ requirement match, not a rough guess.',
  },
  {
    num: '03',
    title: 'Lane 3: Direct company career-page applications',
    body: 'A researched shortlist of 15-25 companies you actually want to work for, applied to directly through their own careers page, ideally with one short line about why that specific company.',
  },
];

const funnelRows = [
  { channel: 'Cold application through a job portal', interviewRate: 'Roughly 2-8% of applications lead to an interview for a role that is not closely targeted', notes: 'A single corporate opening can draw over a hundred applications, most filtered by automated screening before a human reads them' },
  { channel: 'Targeted application (skills closely matched, tailored resume)', interviewRate: 'Meaningfully higher than a generic application, though still well under half', notes: 'Matching the listed skills and keywords closely improves your odds against automated filters' },
  { channel: 'Referral-backed application', interviewRate: 'Referred candidates are interviewed and hired at clearly higher rates than candidates sourced through other channels, in large employer datasets', notes: 'Referrals also tend to move faster once you are in the process' },
  { channel: 'Campus placement shortlist', interviewRate: 'Varies widely by college tier and company', notes: 'A known, dated process, but the number of companies visiting depends on your college\'s placement reputation' },
];

const shortlistPoints = [
  {
    label: 'Match the listed skills, in the listed language',
    body: 'Automated screening tools match keywords from the job description against your resume before a recruiter ever opens it. If the posting says "Excel" and you wrote "spreadsheet tools," you may not clear the filter. Mirror the exact terms the posting uses, where honest to do so.',
  },
  {
    label: 'One piece of proof beats ten bullet points of claims',
    body: 'A small project, a internship writeup, a case note, or a shipped piece of work you can link to or describe in one sentence is worth more than a long list of "responsible for" bullets with nothing to show for them. Recruiters skim; proof stops the skim.',
  },
  {
    label: 'A complete, current LinkedIn profile is now part of your application',
    body: 'Recruiters routinely check LinkedIn before or after a resume screen. A profile with a real headline, a short summary, and the same project proof as your resume closes the gap between "resume claims" and "verified elsewhere."',
  },
];

const mistakeCards = [
  {
    num: '01',
    title: 'Applying to hundreds of roles with one unchanged resume',
    body: 'A generic resume clears fewer automated filters than a resume tailored to the specific role\'s listed skills. Volume without targeting mostly produces a long list of silence, not a faster offer.',
  },
  {
    num: '02',
    title: 'Treating campus placements as the only plan',
    body: 'If your college is not visited by many recruiters, or your branch and CGPA sit outside the usual cutoff, campus alone is a thin plan. Off-campus portals and referrals do not wait for a placement calendar.',
  },
  {
    num: '03',
    title: 'Waiting to "feel ready" before reaching out for a referral',
    body: 'Most people underrate how willing a stranger-adjacent contact is to forward a resume when the ask is small and the message is specific. Waiting for total confidence usually just delays the highest-leverage channel available to you.',
  },
  {
    num: '04',
    title: 'Reading rejection as a verdict on your ability',
    body: 'A 2-8% interview rate on cold, untargeted applications means most qualified candidates get far more silence than replies. That ratio is a property of the funnel, not a scorecard on your worth.',
  },
  {
    num: '05',
    title: 'Ignoring the National Career Service and other government listings',
    body: 'Free, real openings exist on the government-run National Career Service portal alongside apprenticeship listings, and most graduates never check it because it is not the platform their friends talk about.',
  },
];

const timelineSteps = [
  {
    step: '12-6 months before graduation',
    body: 'Start building one piece of proof of work you can show - a project, an internship, a writeup - and get your resume into a first working draft. This is also the window to test-drive a skill outside your degree, in case your first job search needs a backup lane.',
  },
  {
    step: '6-2 months before graduation',
    body: 'Register for your campus placement cell if one exists, and open your off-campus and referral lanes at the same time - do not wait for campus season to end before starting the other two.',
  },
  {
    step: 'Final stretch and right after graduation',
    body: 'Keep all three lanes running weekly. This is also when interview volume usually goes up, so protect time to prepare instead of only applying.',
  },
  {
    step: 'If you already graduated without an offer',
    body: 'Nothing above changes - the timeline resets to "start now," not "start over." A gap on your resume is easier to explain with visible proof-of-work than with more silence.',
