const publishedDateLabel = '17 July 2026';
const authorName = 'Shivanshi Sehgal';
const authorUrl = 'https://futurecareerschool.com/about/shivanshi-sehgal/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'funnel-math', label: 'Why "just apply online" is not a strategy' },
  { id: 'timeline', label: 'When to start: a realistic search timeline' },
  { id: 'four-channels', label: 'The four real channels, ranked by leverage' },
  { id: 'campus', label: 'Campus placements: what they can and cannot give you' },
  { id: 'off-campus', label: 'Off-campus portals: doing them right' },
  { id: 'referrals', label: 'Referrals: the channel most freshers skip' },
  { id: 'target-list', label: 'Build your target list: The 3-Lane Application Split' },
  { id: 'realistic-math', label: 'Realistic application-to-offer math' },
  { id: 'get-shortlisted', label: 'What actually gets you shortlisted' },
  { id: 'interview-prep', label: 'Interview prep for your first job' },
  { id: 'multiple-offers', label: 'Comparing and negotiating offers' },
