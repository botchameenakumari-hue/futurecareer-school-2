---
import BlogPostLayout from '../../../../layouts/BlogPostLayout.astro';

const title = 'How to Get a Job Without Experience in India: Breaking the Catch-22';
const description =
  'How to get a job without experience in India, whether you are a fresh graduate or switching fields entirely: what counts as experience, how to frame the gap, and how to get useful before you get paid.';
const canonical =
  'https://futurecareerschool.com/blog/job-search/how-to-get-a-job-without-experience-india';
const publishedDateISO = '2026-07-20';
const publishedDateLabel = '20 July 2026';
const authorName = 'Allu Vagdevi';
const authorUrl = 'https://futurecareerschool.com/about/allu-vagdevi/';
const authorRole = 'Career researcher and writer';

const jumpLinks = [
  { id: 'short-answer', label: 'The short answer' },
  { id: 'catch-22', label: 'The catch-22, and why it is not personal' },
  { id: 'what-counts', label: 'What actually counts as "experience"' },
  { id: 'framing-gap', label: 'How to write around the experience gap in applications' },
  { id: 'portfolio', label: 'Build a portfolio that proves it, not just a resume line' },
  { id: 'target-strategically', label: 'Target roles and industries that do not gatekeep on experience' },
  { id: 'schemes', label: 'Apprenticeships and government schemes that count as real experience' },
  { id: 'get-useful-first', label: 'Get experience by being useful first' },
  { id: 'career-changer', label: 'If you are switching fields, not starting from zero' },
  { id: 'networking', label: 'Use LinkedIn and your network on purpose' },
  { id: 'interview-answers', label: 'Answering "why should we hire you with no experience"' },
  { id: 'mistakes', label: 'Mistakes that keep the gap open longer than it needs to be' },
  { id: 'first-90-days', label: 'Your first 90 days once you land the job' },
  { id: 'sources', label: 'Check the sources behind these claims' },
  { id: 'faq', label: 'FAQs' },
];

const experienceTypes = [
  {
    label: 'Academic and coursework projects',
    body: 'A capstone project, a final-year thesis with a real dataset or client, or a graded group project that produced something usable. What makes it count: a defined problem, your specific role in solving it, and a result you can describe in numbers or outcomes.',
  },
  {
    label: 'Personal projects',
    body: 'Something you built or ran on your own initiative, without anyone assigning it: a small app, a newsletter, a spreadsheet tool for a family business, a case study you wrote and published. What makes it count: it is finished, visible, and you can explain the decisions behind it.',
  },
  {
    label: 'Volunteer work',
    body: 'Organising an event, managing a college fest budget, running social media for an NGO, coordinating logistics for a community drive. What makes it count: structured responsibility, not just attendance, and a result the organisation can confirm.',
  },
  {
    label: 'Freelance or gig work',
    body: 'Paid or low-paid work done outside a formal employment contract: one client project on a freelance platform, tutoring, content writing for a local business, running ads for a shop owner you know. What makes it count: a real client, a real deliverable, and ideally one line of feedback you can quote.',
  },
  {
    label: 'Internships, even short or unpaid ones',
    body: 'A four-week internship counts as experience even if it did not lead to a job offer. What makes it count: naming the specific task you owned, not just the company name.',
  },
];

const gapFramingRows = [
  {
    weak: '"No prior work experience" or leaving the section blank',
    strong: '"Built and shipped [X] as an academic/personal project, working with [tool/process] to achieve [result]"',
  },
  {
    weak: 'Listing only degree, college name, and CGPA',
    strong: 'Listing 2-3 project or volunteer entries with the same structure a job entry would use: role, what you did, what happened',
  },
  {
    weak: 'A generic objective line ("Seeking an opportunity to grow and learn")',
    strong: 'A specific line naming the exact skill and the exact evidence for it ("Built three data-cleaning workflows in Excel and Python during coursework; looking to apply this to a junior analyst role")',
  },
  {
    weak: 'Apologising for the gap in a cover letter ("I know I lack experience, but...")',
    strong: 'Naming the transferable mechanism directly ("Three years managing customer complaints as a retail supervisor built the same conflict-resolution and escalation judgment this operations role needs")',
  },
];

const targetingCards = [
  {
    badge: 'Structured entry paths',
    title: 'Roles and programs built to onboard people without a track record',
    body: 'Graduate trainee programs, management trainee roles, campus-hire tracks reopened for off-campus applicants, and internship-to-full-time pipelines exist specifically because companies need a steady inflow of people they train from scratch. These roles judge you on aptitude and trainability, not a resume line.',
  },
  {
    badge: 'Skills-first sectors',
    title: 'Industries hiring faster than they can find "experienced" candidates',
    body: 'Sales, customer support, content and social media execution, data entry and operations, and junior digital marketing roles routinely hire people with no formal background, because the skill floor is teachable in weeks and demand for entry-level headcount is high.',
  },
  {
    badge: 'Smaller companies and startups',
    title: 'Employers who cannot afford to only hire the "experienced"',
    body: 'A 5-person startup or a small local business often needs someone who can do a job today more than they need a polished resume. They are far more likely to hire on a trial basis, a portfolio, or a referral than a large enterprise with a rigid experience filter in its applicant tracking system.',
  },
  {
    badge: 'Gig and freelance-adjacent entry',
    title: "India's gig and freelance layer as a genuine on-ramp, not a fallback",
    body: 'India already accounts for a large share of the global gig workforce, and platform-based gig and freelance work is projected to keep growing through 2030. A few completed gigs on a freelance platform, done well and documented, function as verifiable work history when you later apply for a full-time role in the same skill area.',
  },
];

const usefulFirstSteps = [
  {
    step: 'Do the smallest useful version of the job, unpaid, before you ask for the job',
    body: 'If you want a content role, write three sample pieces for a real business and send them unprompted. If you want a design role, redesign a real screen from an app you use and share the before/after. This is not "free work forever" — it is a two-to-five-hour proof asset that turns a cold application into a warm one.',
  },
  {
    step: 'Offer a specific, small trial before asking for a commitment',
    body: 'Instead of "please consider me," try "I noticed X on your site/process, and I think I can fix it in a week — can I show you?" A specific, bounded offer is easy for a busy owner or manager to say yes to, because it costs them nothing and shows them exactly what you can do.',
  },
  {
    step: 'Contribute to something visible before you need the credit',
    body: 'Answering questions in a community you actually use, fixing a documentation error in an open project, or helping run a college event you care about all create a public trail of contribution. This works because the goal is not "add a line to my resume" — it is genuinely being useful somewhere, which then happens to be provable.',
  },
  {
    step: 'Use cold outreach with a proof artifact attached, not a request for advice',
    body: 'A message that says "can I get your advice" asks the other person to do work. A message that says "I built this small thing related to your team\'s work, here is the link, would you have five minutes to tell me if I am close to what you need" gives them something concrete to react to, and converts into real conversations far more often.',
  },
];

const careerChangerSteps = [
  {
    num: '01',
    title: 'Pick one target role, not a vague new field',
    body: '"I want to move into tech" is not a plan. "I want a business analyst role at a mid-size company" is. A specific target tells you exactly which skills to build and which experience actually matters, instead of trying to prepare for every possible direction at once.',
  },
  {
    num: '02',
    title: 'Name your transferable skill by mechanism, not by label',
    body: 'Do not write "I have transferable skills." Name the exact mechanism: a teacher moving into corporate training already has curriculum design and audience-reading experience; an operations executive moving into project management already has vendor coordination and deadline-tracking experience. Specificity is what makes a hiring manager believe the transfer is real.',
  },
  {
    num: '03',
    title: 'Build 2-3 proof-of-work pieces in the new field before you apply widely',
    body: 'A short project, a documented small client engagement, or a certification paired with an applied output closes the credibility gap faster than explaining your career story in a cover letter ever will.',
  },
  {
    num: '04',
    title: 'Lean on your existing network for the introduction, not the job itself',
    body: 'A career changer usually still has a real professional network, even if it is in the old field. Referrals fill a large share of open roles in most companies, and a warm introduction from someone in your existing network into their contact in the new field routinely does more than another cold application.',
  },
];

const mistakeItems = [
  {
    num: '01',
    title: 'Applying to hundreds of roles with one unedited resume',
    body: 'Without experience, your application already has less to lean on. Sending the same generic resume to every posting wastes the one advantage you can control: showing you understood this specific role and this specific company.',
  },
  {
    num: '02',
    title: 'Treating unpaid proof work as a one-time favour instead of a repeatable tactic',
    body: 'One unpaid sample project done well can open one door. The people who build momentum treat this as a system: a handful of small proof pieces built deliberately for a handful of specific targets, not a single desperate gesture.',
  },
  {
    num: '03',
    title: 'Hiding older, "irrelevant" experience instead of translating it',
    body: 'A career changer who scrubs their resume of prior work looks like they are starting from zero. A career changer who translates that prior work into the mechanism the new role needs looks like someone bringing something extra, not someone starting over.',
  },
  {
    num: '04',
    title: 'Waiting for a "big enough" project before showing anything',
    body: 'A small, finished, explainable project beats an ambitious unfinished one every time someone actually looks. Perfectionism at this stage usually means zero proof exists when the opportunity to show it comes up.',
  },
  {
    num: '05',
    title: 'Giving up after one to two weeks of low response',
    body: 'A no-experience job search commonly takes longer to convert than a search with a strong resume already backing it, simply because more applications are needed to reach the smaller pool of employers open to training someone. Quitting in the first stretch is a common and avoidable failure point, not a sign the approach is wrong.',
  },
];

const portfolioItems = [
  {
    label: 'Right skill mix',
    body: 'Pick 2-3 skills that match the actual role you are targeting, not a long, unfocused list. A recruiter scanning a portfolio wants to see depth in what the job needs, not breadth in everything you have dabbled in.',
  },
  {
    label: 'Proof of work',
    body: 'Every skill claim needs a linked artefact: a live project, a writing sample, a spreadsheet model, a design file, a GitHub repository. A skill you cannot point to is just a word on a page.',
  },
  {
    label: 'Communication',
    body: 'Add one short line under each piece explaining the problem, what you did, and the result. A portfolio piece with no explanation makes the viewer guess, and most will not bother.',
  },
  {
    label: 'Market positioning',
    body: 'Frame the whole portfolio around one target role or industry, not "things I have made." A focused portfolio reads as intent; a scattered one reads as a hobby.',
  },
  {
    label: 'Personal fit',
    body: 'Choose projects that show how you actually work: what you research, how you make decisions, how you handle a constraint. This is what separates a portfolio that gets remembered from one that gets scrolled past.',
  },
  {
    label: 'Financial reality',
    body: 'A portfolio should cost time, not money you do not have. Free tools, free hosting, and one well-finished piece beat a paid course you cannot afford, or five unfinished ones.',
  },
];

const schemeItems = [
  {
    badge: 'Apprenticeship route',
    title: 'National Apprenticeship Promotion Scheme (NAPS) and industry apprenticeships',
    body: 'Government-backed apprenticeship programs place freshers into companies for a fixed stipend period, combining structured on-the-job training with a formal apprenticeship certificate. Completing one gives you a verifiable, documented period of real work, and many apprentices convert to a full-time offer with the same employer.',
  },
  {
    badge: 'Internship route',
    title: 'PM Internship Scheme and large-company internship pipelines',
    body: 'Government-run and large-company internship pipelines are built specifically to place first-time job seekers into real companies for a fixed term with a stipend. Treat any internship offer as a genuine experience-building step, and check the specifics (duration, stipend, deliverables) before assuming it is a dead end.',
  },
  {
    badge: 'Skilling route',
    title: 'Skill India Digital and sector skill council certifications',
    body: 'Short, often free or low-cost, government-recognised skilling programs exist across trades, IT, retail, and healthcare-adjacent roles. A certification alone rarely gets you hired, but pairing it with one applied project turns it into real, checkable proof.',
  },
];

const networkingSteps = [
  {
    step: 'Turn your LinkedIn profile into a proof page, not a résumé copy',
    body: 'Use the headline to state your target role and one proof point, not a generic student label. Add your strongest project or volunteer result to the "Featured" section so anyone visiting sees evidence in the first five seconds, not just a job title you do not have yet.',
  },
  {
    step: 'Message people two steps ahead of you, not only senior leaders',
    body: 'Someone who joined a company 1-2 years ago in the role you want remembers exactly what got them hired, and is far more likely to reply than a director. Ask one specific question about their day-to-day work, not "any tips for freshers."',
  },
  {
    step: 'Ask for a referral only after you have given them something to react to',
    body: 'A cold "can you refer me" is easy to ignore. A message with your proof project attached and a specific, small ask is easy to say yes to, and referrals fill a large share of open roles at most companies before the job is ever posted publicly.',
  },
  {
    step: 'Engage in public before you need anything, not only when you are job hunting',
    body: 'Commenting with real insight on posts in your target field, sharing your own project updates, and showing up consistently for a few months makes your eventual outreach land as familiar, not cold.',
  },
];

const interviewAnswerFramework = [
  {
    num: '01',
    title: 'Name the fear directly, then reframe it',
    body: 'Do not dodge the question. "I know I do not have formal work experience yet, but here is what I have built instead" signals confidence, not weakness.',
  },
  {
    num: '02',
    title: 'Give one specific proof story, not a list',
    body: 'Pick your strongest project, volunteer role, or freelance gig and walk through it in 60-90 seconds: the problem, what you did, the result. One well-told story beats five name-dropped activities.',
  },
  {
    num: '03',
    title: 'Connect the proof story to this specific role',
    body: 'Say explicitly what skill or judgment from that story transfers to the job in front of you. This is the step most freshers skip, and it is the one that actually answers the question.',
  },
  {
    num: '04',
    title: 'Close with your learning speed, backed by evidence',
    body: 'Instead of "I am a fast learner" (a claim everyone makes), point to a specific example: how long it took you to go from zero to a finished result on your proof project. A number is more convincing than an adjective.',
  },
];

const first90DaysItems = [
  {
    num: '01',
    title: 'Over-communicate in the first two weeks',
    body: 'Ask more questions than feels comfortable, confirm expectations in writing, and give your manager a short weekly update even if nobody asked for one. This is what turns "the new hire with no experience" into "the new hire who gets it" fastest.',
  },
  {
    num: '02',
    title: 'Find one small win you can finish and show within 30 days',
    body: 'A completed small task builds trust faster than a promised big one still in progress. Trust earned early buys you room to learn the harder parts of the job without anxiety.',
  },
  {
    num: '03',
    title: 'Start a private log of what you are learning and building',
    body: 'This becomes your next resume update, your next portfolio piece, and your next interview story, so the job itself keeps compounding your proof instead of just paying your bills.',
  },
  {
    num: '04',
    title: 'Treat this job as the second entry in a longer skill portfolio, not the finish line',
    body: 'The skills, judgment, and proof you build in your first 90 days are what let you negotiate your next move from strength instead of starting the no-experience search all over again.',
  },
];

const faqItems = [
  {
    q: 'How do I get a job in India with absolutely no experience?',
    a: 'Build proof that substitutes for a job history: a finished project, a documented volunteer role, or a small freelance engagement, then target roles and companies genuinely open to training entry-level hires, such as graduate trainee programs, sales, customer support, and smaller companies. Cold outreach with a proof artifact attached and referrals from your existing network both convert better than mass-applying with a blank resume.',
  },
  {
    q: 'Does volunteer work actually count as experience on a resume in India?',
    a: 'Yes, when it involved structured responsibility and a real result, not just attendance. Recruiter surveys have found a large share of hiring managers rate volunteer work as equally valuable to paid work experience, especially for entry-level roles, as long as it is described with the same specificity as a job entry: what you did, what tools or process you used, and what happened.',
  },
  {
    q: 'I am switching careers with years of experience in a different field. Does the "no experience" advice still apply to me?',
    a: 'Partly. You are not starting from zero the way a fresh graduate is, but you do have no relevant experience in the new field, which creates a similar credibility gap. The extra tool you have that a fresher does not is transferable skill, named by its exact mechanism rather than a vague claim, plus an existing professional network you can ask for warm introductions.',
  },
  {
    q: 'Should I do unpaid work to build experience, or is that a bad idea?',
    a: 'A small, bounded, unpaid proof project, done once or a few times for a specific target, is a reasonable tactic to break the experience catch-22. Open-ended unpaid work with no end date or ongoing "internships" that never convert to paid work are a different problem and are not what this tactic means. The goal is a two-to-five-hour proof asset, not a standing arrangement.',
  },
  {
    q: 'What kind of jobs or industries in India hire people with no experience?',
    a: 'Sales, customer support, content and social media execution, junior digital marketing, data entry and operations roles, and graduate trainee or management trainee programs are common entry points, because these roles are structured to train people rather than assume prior expertise. Smaller companies and startups are also more likely to hire on trial, portfolio, or referral than large enterprises using strict experience filters.',
  },
  {
    q: 'How long does a no-experience job search usually take in India?',
    a: 'It varies by role, city, and how targeted the applications are, but it commonly takes longer than a search backed by an existing job history, because a smaller pool of employers is genuinely open to training someone from zero. Consistency across weeks, not a burst of a few days, is what usually determines whether the search converts.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BlogPostLayout
  title={title}
  description={description}
  canonical={canonical}
  category="job-search"
  publishedAt={publishedDateISO}
  publishedLabel={publishedDateLabel}
  authorName={authorName}
  authorUrl={authorUrl}
  authorRole={authorRole}
  jsonLdExtras={[faqJsonLd]}
>
  <p class="lead-para">
    <strong>How to get a job without experience in India starts with a blunt truth: "experience" almost never
    means only paid, full-time work.</strong>
    Every listing asking for "1-2 years experience" is filtering for proof that you can do the job, and proof
    can come from a finished project, a documented volunteer role, a freelance gig, or coursework applied to a
    real problem. The second part of the fix is tactical: target the roles and employers who are actually built
    to train people from zero, and get useful to someone before you ask them to pay you.
  </p>

  <div class="key-takeaways">
    <p class="key-takeaways__label">The short version</p>
    <ul>
      <li>"Experience" is a proxy for proof, not a literal requirement for a past job title. Projects, volunteer work, freelance gigs, and coursework all count when described with the same structure a job entry would use.</li>
      <li>Rewrite the gap instead of apologising for it: name what you built, what tool or process you used, and what happened, in every application.</li>
      <li>Target entry-level-friendly roles and smaller employers deliberately, instead of applying the same way to every posting regardless of fit.</li>
      <li>Get useful first: a small, bounded, unpaid proof piece or a specific trial offer converts a cold application into a real conversation far more often than another resume in a pile.</li>
      <li>Career changers face the same catch-22 in a new field, but carry two extra tools freshers do not: transferable skill named by its exact mechanism, and an existing professional network for warm introductions.</li>
      <li><strong>Every proof piece you build now — a project, a gig, a portfolio piece — is also the first entry in a high-income skill portfolio that keeps paying off long after this one application</strong>, not a one-time fix for a single job.</li>
    </ul>
  </div>

  <p>
    This guide sits inside <a href="/blog/job-search/">job search strategy</a> at Future Career School, and it
    is built for two different situations that share the same underlying wall: fresh graduates with no job
    history yet, and people switching fields or returning after a break who have no experience specifically in
    the direction they are trying to move toward now.
  </p>

  <p>
    If the gap feels less like a tactics problem and more like a direction problem, a session with
    <a href="https://futurecareerschool.com/services/career-counselling-and-career-guidance/">career guidance</a>
    can help you figure out which target role and industry actually fit before you spend weeks building proof
    for the wrong one.
  </p>

  <nav class="jump-nav" aria-label="Article sections">
    <p class="jump-nav__label">Jump to section</p>
    <ul class="jump-nav__list">
      {jumpLinks.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <h2 id="short-answer">The short answer</h2>

  <p>
    You cannot get years of work experience without a job, and you cannot get a job that demands years of
    experience. That is the catch-22 everyone hits. It breaks in two places at once: widen your definition of
    what counts as proof of ability, and change where you are aiming your applications. A project, a volunteer
    role, or a small freelance job that you can explain clearly does most of the work a job title was supposed
    to do. And a graduate trainee program or a small company that needs someone useful today is a far easier
    door to open than a large enterprise filtering resumes by years of experience before a human ever reads
    them.
  </p>

  <h2 id="catch-22">The catch-22, and why it is not personal</h2>

  <p>
    "Entry-level" roles asking for prior experience is not a new complaint, and it is not evidence that you are
    doing something wrong. It is a structural filter: experience requirements are a cheap, fast way for a
    recruiter to reduce a large applicant pool, even when the requirement is not strictly necessary for the
    role. That filter hits two different groups the same way. A fresh graduate has never had a full-time job.
    Someone switching careers, or returning after a break, has had jobs, but none of them count as "relevant"
    for the new direction, which puts them back at the same starting line.
  </p>

  <div class="honest-take">
    <p class="honest-take__label">Honest take</p>
    <p>
      Recruiters know most "1-2 years required" entry-level postings are a soft filter, not a hard one. The
      candidates who get through it are not the ones who happen to have a job title that matches. They are the
      ones who make it easy for a recruiter to believe they can already do the job, using whatever proof they
      have. That is a solvable problem, not a permanent wall.
    </p>
  </div>

  <h2 id="what-counts">What actually counts as "experience"</h2>

  <p>
    Before you can write around the gap, you need an honest inventory of what you actually have. Most people
    underestimate this list because they are picturing a formal job offer letter as the only valid unit of
    experience. It is not.
  </p>

  <div class="rich-list">
    {experienceTypes.map((item) => (
      <div class="rich-list-item">
        <div class="rich-list-item__num">{item.label}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p class="note-line">
    Employer surveys have found a large share of hiring managers rate volunteer experience as equally valuable
    to paid work experience when it is structured and relevant, not because volunteering is fashionable, but
    because it demonstrates the same underlying things a job would: responsibility, follow-through, and a
    result someone else can confirm.
  </p>

  <h2 id="framing-gap">How to write around the experience gap in applications</h2>

  <p>
    Having the raw material from the section above is only half the job. Most people who do have a project or a
    volunteer role still describe it weakly, in a way that reads as filler instead of proof. The fix is
    structural: describe non-traditional experience with the exact same format you would use for a real job
    entry, not a softer, apologetic version of it.
  </p>

  <div class="table-wrap">
    <table class="paths-table">
      <thead>
        <tr>
          <th>Weak framing</th>
          <th>Stronger framing</th>
        </tr>
      </thead>
      <tbody>
        {gapFramingRows.map((item) => (
          <tr>
            <td data-label="Weak framing">{item.weak}</td>
            <td data-label="Stronger framing"><strong>{item.strong}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    The pattern underneath every strong version: name the action, name the tool or process, name the outcome.
    That is the same structure a recruiter expects from a job entry, and it works just as well on a project,
    a volunteer role, or a freelance gig, because what the recruiter is actually screening for is evidence of
    ability, not the specific container that evidence came in.
  </p>

  <h2 id="portfolio">Build a portfolio that proves it, not just a resume line</h2>

  <p>
    A resume tells a recruiter what to believe. A portfolio lets them check. If your target field has anything
    visual, written, technical, or analytical about it, a small, well-organised collection of your best work,
    hosted somewhere free (a personal site, a GitHub profile, a Behance page, even a well-structured Google
    Drive folder), does more to prove ability than another paragraph of claims.
  </p>

  <p>
    <strong>This is also where skill-building stops being about a single job and starts becoming a portfolio of
    high-income skills you keep owning.</strong> Building it well means thinking past "what looks impressive" and
    checking it against six things that decide whether skill-building actually pays off:
  </p>

  <div class="rich-list">
    {portfolioItems.map((item) => (
      <div class="rich-list-item">
        <div class="rich-list-item__num">{item.label}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <p>
    Treat the portfolio itself as a skill you are compounding, not a one-time task before you apply. The person
    who keeps adding one finished piece every few weeks is quietly building toward unlocking higher-income
    opportunities long after this specific job search ends, while the person who builds it once and stops stays
    stuck re-explaining the same three-month-old project in every interview.
  </p>

  <h2 id="target-strategically">Target roles and industries that do not gatekeep on experience</h2>

  <p>
    Applying the same way to every posting wastes effort you cannot afford to waste when you are already
    working from a weaker starting position. Some roles, industries, and company sizes are structurally built
    to hire people without a track record. Aim more of your effort there.
  </p>

  <div class="track-cards">
    {targetingCards.map((item) => (
      <div class="track-card">
        <div class="track-card__badge">{item.badge}</div>
        <div class="track-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <div class="highlight-box highlight-box--teal">
    <p>
      India's gig and freelance layer has grown into a real on-ramp rather than a last resort. Industry
      estimates put India's platform-based gig workforce on track to reach roughly 90 million workers by 2030,
      with gig hiring growing sharply in the past year. A few completed, well-documented freelance projects can
      function as verifiable early work history when you apply for a full-time role in the same skill area
      later.
    </p>
  </div>

  <h2 id="schemes">Apprenticeships and government schemes that count as real experience</h2>

  <p>
    Beyond direct hiring, India runs several formal routes designed specifically to turn a fresher with no
    experience into someone with a documented, verifiable work history. Check eligibility and current details on
    the official scheme pages before applying, since terms change, but treat all three as genuine experience
    paths, not consolation prizes.
  </p>

  <div class="track-cards">
    {schemeItems.map((item) => (
      <div class="track-card">
        <div class="track-card__badge">{item.badge}</div>
        <div class="track-card__title">{item.title}</div>
        <p>{item.body}</p>
      </div>
    ))}
  </div>

  <h2 id="get-useful-first">Get experience by being useful first</h2>

  <p>
    The fastest way through the catch-22 is often the least comfortable one: do a small, useful version of the
    job before anyone is paying you for it. This is not about working for free indefinitely. It is about
    creating a short, specific proof asset that removes the need for a stranger to trust your resume on faith.
  </p>

  <div class="protocol-stack">
    {usefulFirstSteps.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.step}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="callout callout--amber">
    <p class="callout__eyebrow">Where this tactic stops being useful</p>
    <ul class="callout__list">
      <li>If a "trial project" or "unpaid internship" has no end date, no defined deliverable, and no path to a paid role or a usable proof asset, it has stopped being a tactic and become open-ended free labour. Walk away.</li>
      <li>The goal is a bounded, two-to-five-hour piece of proof, or a short, defined trial with a clear finish line, not a standing arrangement that never converts.</li>
    </ul>
  </div>

  <h2 id="career-changer">If you are switching fields, not starting from zero</h2>

  <p>
    Career changers and people returning after a break face a version of the same wall, but the fix is not
    identical to a fresher's. You are not building your first piece of proof from nothing; you are
    re-pointing existing skill and existing relationships at a new target.
  </p>

  <div class="protocol-stack">
    {careerChangerSteps.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <p>
    If you are not sure which skill direction genuinely fits your background before you commit weeks to
    building proof in a new field, the <a href="https://futurecareerschool.com/career-skills-compass">Career and
    Skills Compass</a> is a useful place to check fit before you narrow to one target role.
  </p>

  <h2 id="networking">Use LinkedIn and your network on purpose</h2>

  <p>
    Most no-experience job seekers use LinkedIn as a job board and their network as a last resort. Both are
    underused as active tools. A weak network used well usually outperforms mass-applying to postings, because a
    referral gets a human to actually read your application instead of a filter discarding it first.
  </p>

  <div class="protocol-stack">
    {networkingSteps.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.step}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="interview-answers">Answering "why should we hire you with no experience"</h2>

  <p>
    This question, in some form, comes up in almost every entry-level interview. Freezing on it, or answering
    with a generic "I am hardworking and a fast learner," wastes the one moment you have to directly close the
    experience gap in front of the person deciding.
  </p>

  <div class="protocol-stack">
    {interviewAnswerFramework.map((item) => (
      <div class="checkpoint">
        <div class="checkpoint__num">{item.num}</div>
        <div class="checkpoint__body">
          <div class="checkpoint__title">{item.title}</div>
          <p>{item.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="mistakes">Mistakes that keep the gap open longer than it needs to be</h2>

  <div class="mistakes-list">
    {mistakeItems.map((item) => (
