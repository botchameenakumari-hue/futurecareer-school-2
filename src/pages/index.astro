    <div class="container philosophy-inner">
      <div class="phil-left">
        <div class="section-tag pill" style="display:inline-flex">
          <span style="color:var(--gold)">&#128161;</span>&nbsp;Why Skill Fit Matters
        </div>
        <h2 class="section-headline" style="text-align:left">
          &ldquo;Picking a Skill Is Like<br />
          <span class="gold-text">Getting Married.&rdquo;</span>
        </h2>
        <p class="phil-body">
