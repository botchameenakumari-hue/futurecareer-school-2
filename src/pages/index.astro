<script>
  document.documentElement.classList.add('js');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── hero staggered line reveal ──
  const lines = document.querySelectorAll('.stage .l');
  lines.forEach((el, i) => {
    el.style.setProperty('--d', (0.25 + i * 0.11) + 's');
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('go')));
  });

  // ── generic reveals ──
  const rvs = document.querySelectorAll('.rv');
  if ('IntersectionObserver' in window && !reduced) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    rvs.forEach((el) => io.observe(el));
  } else { rvs.forEach((el) => el.classList.add('in')); }

  // ── counters ──
  const run = (el) => {
    const t = parseFloat(el.getAttribute('data-count') || '0');
    const suf = el.getAttribute('data-suffix') || '';
    const fl = el.getAttribute('data-float') === 'true';
    const s = performance.now();
    const fmt = (v) => (fl ? v.toFixed(1) : Math.round(v).toLocaleString('en-IN'));
    const tick = (n) => {
      const p = Math.min((n - s) / 1700, 1);
      el.textContent = fmt(t * (1 - Math.pow(1 - p, 3))) + suf;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && !reduced) {
    const cio = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { run(e.target); cio.unobserve(e.target); } });
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));
  }

  // ── sticky audience image swap ──
  const panels = Array.from(document.querySelectorAll('[data-panel]'));
  const shots = Array.from(document.querySelectorAll('[data-pm]'));
  const caps = Array.from(document.querySelectorAll('[data-pmcap]'));
  if (panels.length && shots.length && 'IntersectionObserver' in window) {
    const pio = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const k = e.target.getAttribute('data-panel');
        shots.forEach((s) => s.classList.toggle('on', s.getAttribute('data-pm') === k));
        caps.forEach((c) => { c.hidden = c.getAttribute('data-pmcap') !== k; });
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    panels.forEach((p) => pio.observe(p));
  }

  // ── compass tabs ──
  const tabs = Array.from(document.querySelectorAll('.cx-t'));
  const panes = Array.from(document.querySelectorAll('.cx-p'));
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-selected', 'false'); });
    panes.forEach((p) => p.classList.remove('on'));
    t.classList.add('on');
    t.setAttribute('aria-selected', 'true');
    const pane = document.getElementById('cp-' + t.getAttribute('data-pane'));
    if (pane) pane.classList.add('on');
  }));

  // ── parallax + scroll rail ──
  const pars = Array.from(document.querySelectorAll('.par img'));
  const rail = document.getElementById('rail');
  let ticking = false;
  const frame = () => {
    const doc = document.documentElement;
    if (rail) {
      const max = doc.scrollHeight - doc.clientHeight;
      rail.style.transform = 'scaleX(' + (max > 0 ? doc.scrollTop / max : 0) + ')';
    }
    if (!reduced) {
      pars.forEach((img) => {
        const r = img.parentElement.getBoundingClientRect();
        const p = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight;
        img.style.transform = 'translate3d(0,' + (p * -60) + 'px,0)';
      });
    }
    ticking = false;
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
  document.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  frame();

  // ── mobile CTA bar ──
  const mb = document.getElementById('mb');
  const hero = document.getElementById('hero');
  const fin = document.getElementById('final-cta');
  if (mb && hero && fin && 'IntersectionObserver' in window) {
    let past = false, end = false;
    const upd = () => {
      const show = past && !end;
      mb.classList.toggle('show', show);
      mb.setAttribute('aria-hidden', show ? 'false' : 'true');
    };
    new IntersectionObserver((es) => { es.forEach((e) => { past = !e.isIntersecting; }); upd(); }, { threshold: 0 }).observe(hero);
    new IntersectionObserver((es) => { es.forEach((e) => { end = e.isIntersecting; }); upd(); }, { threshold: 0.15 }).observe(fin);
  }
</script>
