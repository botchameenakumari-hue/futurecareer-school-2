const profiles = [
  { k: 'A', h: 'The Perfect Plan', d: 'You want structure. You want to know the exact steps before you start. You’re analytical, risk-aware, and need a clear map or you don’t move. You’re not afraid of hard work — you’re afraid of wasted effort.', traits: ['Systematic', 'Risk-conscious', 'Detail-oriented'], strat: 'Linear skill build → proof portfolio → corporate/agency income ladder → freelance pivot at your Freedom Number threshold' },
  { k: 'B', h: 'The Passion Plan', d: 'You have a strong pull toward something — creative work, a cause, a craft. The trap: passion alone doesn’t pay. We show you how to monetise what you love by pairing it with a market-validated adjacent skill.', traits: ['Creative', 'Intrinsically motivated', 'Needs meaning'], strat: 'Passion × adjacent market skill → niche authority positioning → premium client pipeline that pays you for what you love' },
  { k: 'C', h: 'The Empire Builder', d: 'You think in systems. You want to build something — an agency, a brand, a product. You’re not here for a job. You need a path that converts your vision into a scalable income engine, not just a freelance career.', traits: ['Systems-thinker', 'High ambition', 'Builder mentality'], strat: 'T-shaped skill build → solopreneur phase → team leverage → Career Group Engine → multiple income streams' },
];

const gates = [
  { n: '1', h: 'Proof of Skill', p: 'You can do the thing. You have a portfolio piece, a project, a result that says “I know this.” Without this, you’re just claiming you can — and no one pays for claims.', tools: ['Portfolio project', 'Case study', 'Demo / sample'] },
  { n: '2', h: 'Proof of Communication', p: 'You can explain the thing — and you can speak to someone who needs it. This is where most skilled people fail. They build in silence and wonder why no one finds them.', tools: ['LinkedIn profile', 'Email outreach', 'Content signal'] },
  { n: '3', h: 'Proof of Value', p: 'You have a result someone paid for — and they’d pay again. This is when income becomes repeatable. One testimonial and one successful delivery unlocks a sustainable client pipeline.', tools: ['First paid client', 'Testimonial', 'Referral system'] },
];

