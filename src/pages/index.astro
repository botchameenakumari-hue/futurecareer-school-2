  .section-tag { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 1.25rem; align-items: center; gap: 6px; }
  .section-headline { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; color: #fff; margin-bottom: 1rem; }
  .section-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.55); max-width: 620px; margin: 0 auto 3rem; text-align: center; line-height: 1.7; }
  section > .container > .section-tag,
  section > .container > .section-headline { text-align: center; width: 100%; display: block; }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: #2dd4bf; animation: blink 2s ease-in-out infinite; flex-shrink: 0; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

  /* ══ HERO ══ */
  #hero { min-height: 100vh; display: flex; align-items: center; padding-top: 72px; position: relative; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .orb-1 { width: 700px; height: 700px; background: radial-gradient(circle, rgba(229,184,74,.1) 0%, transparent 70%); top: -150px; left: -150px; }
  .orb-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(45,212,191,.07) 0%, transparent 70%); bottom: 0; right: -100px; }
  .orb-3 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(229,184,74,.05) 0%, transparent 70%); top: 50%; left: 55%; }
  .grid-overlay { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 30% 50%, black 20%, transparent 75%); }

  .hero-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: flex-start;
    max-width: 900px; padding: 5rem 1.5rem 4rem;
  }
  .hero-pill { margin-bottom: 2rem; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }

  /* Big editorial headline — grid stacking so cycling text can NEVER clip */
  .hero-headline {
    font-size: clamp(1.8rem, 4vw, 3.1rem);
    font-weight: 800; line-height: 1.18;
    letter-spacing: -.035em; color: #fff;
    margin: 0 0 1.75rem;
    max-width: 100%;
  }
  .hero-line-top, .hero-line-bottom { display: block; }

  /* Grid stacking — all cycling phrases occupy the same cell,
     container sizes to the largest naturally, no overflow clip */
  .hero-cycle-wrap {
    display: grid;
    margin: .15em 0;
  }
  .hero-cycle-word {
    grid-column: 1; grid-row: 1;
    color: var(--gold); font-style: italic;
    opacity: 0; transform: translateY(14px);
    will-change: opacity, transform;
  }
  .hero-cycle-word:nth-child(1) { animation: cycleWord 10s ease-in-out infinite 0s; }
  .hero-cycle-word:nth-child(2) { animation: cycleWord 10s ease-in-out infinite 2.5s; }
  .hero-cycle-word:nth-child(3) { animation: cycleWord 10s ease-in-out infinite 5s; }
  .hero-cycle-word:nth-child(4) { animation: cycleWord 10s ease-in-out infinite 7.5s; }
  @keyframes cycleWord {
    0%   { opacity: 0; transform: translateY(14px); }
    5%   { opacity: 1; transform: translateY(0); }
    22%  { opacity: 1; transform: translateY(0); }
    27%  { opacity: 0; transform: translateY(-14px); }
    100% { opacity: 0; transform: translateY(-14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cycle-word { animation: none; opacity: 0; transform: none; }
    .hero-cycle-word:first-child { opacity: 1; }
  }

  .hero-sub { font-size: clamp(15px, 1.8vw, 18px); color: rgba(255,255,255,.6); line-height: 1.75; margin-bottom: 2rem; max-width: 560px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .hero-cta { font-size: 15px; padding: 14px 26px; }

  /* Identity chip row */
  .hero-identity {
    display: flex; align-items: stretch;
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px; overflow: hidden;
    margin-bottom: 2rem; flex-wrap: wrap;
  }
  .hid-chip {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 28px; font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,.6);
    transition: background .2s, color .2s; text-decoration: none;
  }
  .hid-chip:hover { background: rgba(255,255,255,.07); color: #fff; }
  .hid-chip--gold { background: rgba(229,184,74,.04); }
  .hid-chip--gold:hover { background: rgba(229,184,74,.1); color: var(--gold); }
  .hid-level { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.28); display: block; }
  .hid-chip--gold .hid-level { color: rgba(229,184,74,.45); }
  .hid-sep { width: 1px; background: rgba(255,255,255,.07); align-self: stretch; flex-shrink: 0; }

  .hero-trust { display: flex; flex-direction: column; gap: 8px; }
  .trust-item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.45); }

  /* ══ STATS ══ */
  #stats-band { padding: 2rem 0; background: rgba(229,184,74,.04); border-top: 1px solid rgba(229,184,74,.1); border-bottom: 1px solid rgba(229,184,74,.1); }
  .stats-inner { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; }
  .stat-item { display: flex; flex-direction: column; align-items: center; padding: 1rem 3rem; }
  .stat-row { display: flex; align-items: baseline; }
  .stat-word { font-family: "Sora", sans-serif; font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: var(--gold); line-height: 1; }
  .stat-lbl { font-size: 12px; color: rgba(255,255,255,.45); margin-top: 4px; text-align: center; }
  .stat-div { width: 1px; height: 48px; background: rgba(255,255,255,.08); }

  /* ══ SEARCH INTENT ══ */
  #search-intent { padding: 6rem 0; }
  .si-intro { margin-bottom: 3rem; }
  .si-list { display: flex; flex-direction: column; }
  .si-item {
    display: grid;
    grid-template-columns: 1fr 1.8fr auto;
    align-items: start;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255,255,255,.06);
  }
  .si-item:first-child { border-top: 1px solid rgba(255,255,255,.06); }
  .si-q {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    font-weight: 800; color: #fff; line-height: 1.2;
    border-left: 3px solid var(--gold); padding-left: 1.25rem;
    margin: 0;
  }
  .si-a { font-size: 15px; color: rgba(255,255,255,.55); line-height: 1.8; margin: 0; }
  .si-link { font-size: 13px; font-weight: 700; color: var(--gold); white-space: nowrap; padding-top: 4px; text-decoration: none; transition: opacity .2s; }
  .si-link:hover { opacity: .7; }

  /* ══ AUDIENCE ══ */
  #audience { padding: 6rem 0; }
  .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 3rem; }
  .audience-card { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09); border-radius: 20px; padding: 2rem; display: flex; flex-direction: column; position: relative; transition: transform .3s, border-color .3s; }
  .audience-card:hover { transform: translateY(-4px); border-color: rgba(229,184,74,.2); }
  .audience-card-featured { border-color: rgba(229,184,74,.25); background: linear-gradient(135deg, rgba(229,184,74,.06), rgba(255,255,255,.02)); }
  .featured-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #e5b84a, #f5d98c); color: #080c18; font-size: 11px; font-weight: 700; padding: 4px 14px; border-radius: 999px; white-space: nowrap; }
  .aud-level { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--gold); margin-bottom: .6rem; }
  .aud-icon-wrap { font-size: 2.5rem; margin-bottom: 1rem; }
  .audience-card h3 { font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: .75rem; }
  .aud-desc { font-size: 14px; color: rgba(255,255,255,.55); line-height: 1.7; margin-bottom: 1.25rem; }
  .aud-block-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--gold); margin: .1rem 0 .8rem; }
  .aud-list { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.5rem; }
  .aud-list li { font-size: 13px; color: rgba(255,255,255,.65); padding-left: 16px; position: relative; line-height: 1.5; }
  .aud-list li::before { content: '\2192'; position: absolute; left: 0; color: var(--teal); }
  .aud-actions { margin-top: 2rem; display: flex; justify-content: center; gap: .8rem; flex-wrap: wrap; }

  #guidance-expectations {
    padding: 6rem 0;
    background: radial-gradient(900px 280px at 15% -5%, rgba(248,113,113,.08), transparent 72%), radial-gradient(900px 280px at 85% -5%, rgba(229,184,74,.1), transparent 72%), rgba(255,255,255,.015);
  }
  .expect-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 1080px; margin: 0 auto; }
  .expect-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid rgba(255,255,255,.13);
    background: linear-gradient(165deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
    box-shadow: 0 14px 36px rgba(0,0,0,.22);
  }
  .expect-card-not { border-color: rgba(248,113,113,.2); }
  .expect-card-is { border-color: rgba(229,184,74,.28); background: linear-gradient(135deg, rgba(229,184,74,.08), rgba(255,255,255,.02)); }
  .expect-card h3 { font-size: 1.22rem; color: #fff; margin-bottom: .85rem; letter-spacing: -.01em; }
  .expect-card h3 em { font-style: italic; }
  .expect-list { list-style: none; display: flex; flex-direction: column; gap: .65rem; }
  .expect-list li { font-size: 14px; color: rgba(255,255,255,.72); padding-left: 1.2rem; position: relative; line-height: 1.74; }
  .expect-card-not .expect-list li::before { content: '-'; position: absolute; left: 0; color: #f87171; font-weight: 700; }
  .expect-card-is .expect-list li::before { content: '+'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }

  /* ══ SKILL & COURSE FINDER ══ */
  #skill-finder { padding: 6rem 0; position: relative; }
  .sf-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .sf-orb { width: 800px; height: 600px; background: radial-gradient(ellipse, rgba(45,212,191,.05) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 50%; position: absolute; filter: blur(120px); }

  /* Biology Quick Check */
  .bc-box {
    margin: 2.5rem 0 3rem; padding: 1.75rem 2.25rem;
    border-color: rgba(255,255,255,.09);
    position: relative; z-index: 1;
  }
  .bc-box-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    color: rgba(255,255,255,.35); display: flex; align-items: center; gap: 8px;
    margin-bottom: 1.5rem;
  }
  .bc-qs { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; }
  .bc-divider { display: none; }
  .bc-q { display: flex; gap: 1rem; align-items: flex-start; }
  .bc-num {
    font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.5rem;
    color: rgba(255,255,255,.1); line-height: 1; flex-shrink: 0; min-width: 32px;
  }
  .bc-q-text { font-size: 14px; color: rgba(255,255,255,.6); line-height: 1.65; margin-bottom: .9rem; }
  .bc-q-text strong { color: rgba(255,255,255,.85); }
  .bc-q-note { font-size: 12.5px; color: rgba(255,255,255,.5); line-height: 1.6; }
  .bc-opts { display: flex; flex-wrap: wrap; gap: .5rem; }
  .bc-opt {
    font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 8px;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .bc-opt--teal { background: rgba(45,212,191,.08); color: var(--teal); border: 1px solid rgba(45,212,191,.2); }
  .bc-opt--blue { background: rgba(96,165,250,.08); color: #60a5fa; border: 1px solid rgba(96,165,250,.2); }
  .bc-opt--gold { background: rgba(229,184,74,.08); color: var(--gold); border: 1px solid rgba(229,184,74,.2); }
  .bc-opt--purple { background: rgba(167,139,250,.08); color: #a78bfa; border: 1px solid rgba(167,139,250,.2); }
  .bc-sep { font-size: 11px; color: rgba(255,255,255,.25); align-self: center; padding: 0 2px; }
  .bc-cta-note {
    margin-top: 1.5rem; font-size: 13px; color: rgba(255,255,255,.35); text-align: center;
    border-top: 1px solid rgba(255,255,255,.06); padding-top: 1rem;
  }
  .sf-intro {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .sf-intro-title {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: #fff;
    margin-bottom: .75rem;
  }
  .sf-intro-copy {
    font-size: 14px;
    line-height: 1.75;
    color: rgba(255,255,255,.52);
  }

  /* 5-card grid: 3 on top row, 2 centred on bottom */
  .sf-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
    margin-top: 0;
    position: relative; z-index: 1;
  }
  .sf-card { grid-column: span 2; }
  .sf-card:nth-child(4) { grid-column: 2 / span 2; }
  .sf-card:nth-child(5) { grid-column: 4 / span 2; }

  /* Card base */
  .sf-card {
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; overflow: hidden;
    transition: border-color .3s, box-shadow .3s, transform .3s;
  }
  .sf-card:hover { transform: translateY(-4px); box-shadow: 0 24px 60px rgba(0,0,0,.45); }

  /* Thinking style accents */
  .sf-card--systems { --sf-accent: #60a5fa; }
  .sf-card--people  { --sf-accent: var(--gold); }
  .sf-card--visual  { --sf-accent: #a78bfa; }
  .sf-card--executor { --sf-accent: var(--teal); }
  .sf-card--builder { --sf-accent: #f472b6; }

  .sf-card[open] { border-color: color-mix(in srgb, var(--sf-accent) 35%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--sf-accent) 12%, transparent); }

  /* Face (summary) */
  .sf-card-face { padding: 1.75rem 1.75rem 1.5rem; cursor: pointer; list-style: none; display: block; }
  .sf-card-face::-webkit-details-marker { display: none; }

  .sf-type-badge {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
    color: var(--sf-accent);
    background: color-mix(in srgb, var(--sf-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sf-accent) 25%, transparent);
    border-radius: 999px; padding: 4px 12px;
    display: inline-block; margin-bottom: 1.1rem;
  }
  .sf-icon { font-size: 2rem; display: block; margin-bottom: .75rem; }
  .sf-card-title { font-size: 1.15rem; font-weight: 800; color: #fff; margin-bottom: .5rem; letter-spacing: -.02em; }
  .sf-card-hook { font-size: 13.5px; color: rgba(255,255,255,.5); line-height: 1.6; margin-bottom: 1rem; }
  .sf-preview-skills { font-size: 11.5px; color: rgba(255,255,255,.3); margin-bottom: 1.1rem; letter-spacing: .02em; }

  .sf-expand-hint { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--sf-accent); opacity: .65; transition: opacity .2s; }
  .sf-card[open] .sf-expand-hint { opacity: 0; height: 0; overflow: hidden; margin: 0; }
  .sf-arrow { transition: transform .3s; flex-shrink: 0; }
  .sf-card[open] .sf-arrow { transform: rotate(180deg); }

  /* Reveal panel */
  .sf-reveal {
    padding: 1.5rem 1.75rem 1.75rem;
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .sf-section-label {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
    color: rgba(255,255,255,.3); margin-bottom: .9rem; margin-top: 1.5rem;
  }
  .sf-section-label:first-child { margin-top: 0; }

  /* Skills list */
  .sf-skills { display: flex; flex-direction: column; gap: 0; margin-bottom: .25rem; }
  .sf-skill-row {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: .6rem 0; border-bottom: 1px solid rgba(255,255,255,.05);
  }
  .sf-skill-row:last-child { border-bottom: none; }
  .sf-skill-name { font-size: 13px; color: rgba(255,255,255,.75); font-weight: 500; flex: 1; }
  .sf-demand { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 6px; white-space: nowrap; flex-shrink: 0; }
  .sf-dem--fire  { background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.2); }
  .sf-dem--rising{ background: rgba(45,212,191,.1); color: var(--teal); border: 1px solid rgba(45,212,191,.2); }
  .sf-dem--stable{ background: rgba(255,255,255,.05); color: rgba(255,255,255,.45); border: 1px solid rgba(255,255,255,.1); }

  /* IMS bars */
  .sf-ims-block { margin-bottom: .25rem; }
  .sf-ims-rows { display: flex; flex-direction: column; gap: .7rem; }
  .sf-ims-row { display: grid; grid-template-columns: 72px 1fr auto; align-items: center; gap: .75rem; }
  .sf-ims-l { font-size: 12px; font-weight: 600; color: rgba(255,255,255,.5); }
  .sf-bar-wrap { height: 5px; background: rgba(255,255,255,.07); border-radius: 999px; overflow: hidden; }
  .sf-bar-fill { height: 100%; border-radius: 999px; transition: width .8s ease; }
  .sf-ims-note { font-size: 11px; color: rgba(255,255,255,.3); white-space: nowrap; }

  /* Course Phases */
  .sf-phases { display: flex; flex-direction: column; gap: .75rem; margin-bottom: .25rem; }
  .sf-phase { border-radius: 10px; padding: .9rem 1.1rem; }
  .sf-phase--free    { background: rgba(45,212,191,.05); border: 1px solid rgba(45,212,191,.12); }
  .sf-phase--taste   { background: rgba(229,184,74,.05); border: 1px solid rgba(229,184,74,.12); }
  .sf-phase--commit  { background: rgba(167,139,250,.05); border: 1px solid rgba(167,139,250,.12); }
  .sf-phase-tag {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: .4rem; display: block;
  }
  .sf-phase--free .sf-phase-tag    { color: var(--teal); }
  .sf-phase--taste .sf-phase-tag   { color: var(--gold); }
  .sf-phase--commit .sf-phase-tag  { color: #a78bfa; }
  .sf-phase p { font-size: 12.5px; color: rgba(255,255,255,.5); line-height: 1.65; }

  /* Level chips + CTA */
  .sf-level-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.25rem; margin-top: 1.5rem; }
  .sf-lvl-chip {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    padding: 4px 10px; border-radius: 6px;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.4);
  }
  .sf-lvl--1 { border-color: rgba(45,212,191,.2); color: var(--teal); background: rgba(45,212,191,.06); }
  .sf-lvl--2 { border-color: rgba(229,184,74,.2); color: var(--gold); background: rgba(229,184,74,.06); }
  .sf-lvl--3 { border-color: rgba(167,139,250,.2); color: #a78bfa; background: rgba(167,139,250,.06); }

  .sf-cta { display: flex; width: 100%; justify-content: center; font-size: 13px; padding: 11px 20px; }


  /* ══ PHILOSOPHY ══ */
  #philosophy { padding: 6rem 0; position: relative; }
  .philosophy-bg { position: absolute; inset: 0; }
  .phil-orb-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(229,184,74,.07) 0%, transparent 70%); top: -100px; right: -100px; border-radius: 50%; position: absolute; filter: blur(80px); }
  .phil-orb-2 { width: 300px; height: 300px; background: radial-gradient(circle, rgba(45,212,191,.05) 0%, transparent 70%); bottom: 0; left: 0; border-radius: 50%; position: absolute; filter: blur(80px); }
  .philosophy-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .phil-body { font-size: 16px; color: rgba(255,255,255,.6); line-height: 1.8; }
  .phil-body strong { color: rgba(255,255,255,.85); }
  .ims-card { padding: 2rem; }
  .ims-header { margin-bottom: 1.75rem; }
  .ims-title { font-size: 1rem; font-weight: 800; color: #fff; display: block; }
  .ims-sub { font-size: 12px; color: rgba(255,255,255,.4); margin-top: 4px; display: block; }
  .ims-items { display: flex; flex-direction: column; }
  .ims-connector { width: 2px; height: 24px; background: rgba(255,255,255,.08); margin: 0 11px; }
  .ims-item { display: flex; align-items: flex-start; gap: 14px; }
  .ims-circle { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; flex-shrink: 0; }
  .ims-i { background: rgba(229,184,74,.15); border: 1px solid rgba(229,184,74,.3); color: #e5b84a; }
  .ims-m { background: rgba(45,212,191,.15); border: 1px solid rgba(45,212,191,.3); color: #2dd4bf; }
  .ims-s { background: rgba(139,92,246,.15); border: 1px solid rgba(139,92,246,.3); color: #a78bfa; }
  .ims-label { font-size: 13px; font-weight: 700; color: #fff; }
  .ims-desc { font-size: 12px; color: rgba(255,255,255,.45); line-height: 1.6; margin-top: 3px; }
  .ims-footer { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.07); font-size: 12px; color: rgba(255,255,255,.4); font-style: italic; }

  /* ══ PROCESS ══ */
  #process { padding: 6rem 0; }
  .steps-track { position: relative; margin-top: 2.6rem; }
  .steps-line { display: none; }
  .steps-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem; max-width: 1060px; margin: 0 auto; }
  .step {
    text-align: left;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.14);
    background: linear-gradient(160deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
    box-shadow: 0 16px 34px rgba(0,0,0,.24);
    padding: 1.15rem 1.15rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .8rem .9rem;
    align-items: center;
  }
  .step:nth-child(odd) { border-left: 3px solid rgba(229,184,74,.82); }
  .step:nth-child(even) { border-left: 3px solid rgba(45,212,191,.82); }
  .step-num {
    font-size: 10px;
    font-weight: 800;
    color: #111827;
    letter-spacing: .1em;
    margin-bottom: 0;
    grid-column: 1;
    grid-row: 1;
    padding: 5px 8px;
    border-radius: 999px;
    background: linear-gradient(135deg, #e5b84a, #f5d98c);
  }
  .step-icon {
    font-size: 1.25rem;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(229,184,74,.1);
    border: 1px solid rgba(229,184,74,.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    grid-column: 1;
    grid-row: 2;
  }
  .step-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: .55rem; grid-column: 2; grid-row: 1; line-height: 1.5; }
  .step-desc { font-size: 13px; color: rgba(255,255,255,.76); line-height: 1.72; margin-bottom: .65rem; grid-column: 2; grid-row: 2; }
  .step-outcome {
    font-size: 11px;
    font-weight: 700;
    color: rgba(45,212,191,.85);
    background: rgba(45,212,191,.08);
    border: 1px solid rgba(45,212,191,.2);
    border-radius: 10px;
    padding: 7px 10px;
    grid-column: 2;
    grid-row: 3;
    display: inline-block;
  }

  /* ══ PROFILES ══ */
  #profiles { padding: 6rem 0; }
  .profiles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 3rem; }
  .profile-card { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 2rem; transition: transform .3s, border-color .3s; }
  .profile-card:hover { transform: translateY(-4px); border-color: rgba(229,184,74,.15); }
  .profile-card-gold { border-color: rgba(229,184,74,.2); background: linear-gradient(135deg, rgba(229,184,74,.05), rgba(255,255,255,.02)); }
  .profile-emoji { font-size: 2.5rem; margin-bottom: .75rem; }
  .profile-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: rgba(255,255,255,.3); margin-bottom: .4rem; }
  .profile-name { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: .75rem; }
  .profile-desc { font-size: 14px; color: rgba(255,255,255,.55); line-height: 1.7; margin-bottom: 1.25rem; }
  .profile-traits { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1.5rem; }
  .profile-traits span { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: rgba(255,255,255,.6); }
  .profile-strategy { background: rgba(229,184,74,.04); border: 1px solid rgba(229,184,74,.1); border-radius: 10px; padding: 12px 14px; }
  .ps-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: rgba(229,184,74,.5); margin-bottom: 5px; }
  .ps-text { font-size: 13px; color: rgba(255,255,255,.6); line-height: 1.6; }
  .profiles-cta-wrap { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-top: 3rem; }
  .profiles-cta-text { font-size: 15px; color: rgba(255,255,255,.5); }

  /* ══ GATES ══ */
  #gates { padding: 6rem 0; position: relative; }
  .gates-bg { position: absolute; inset: 0; }
  .gates-orb { width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(45,212,191,.06) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 50%; position: absolute; filter: blur(80px); pointer-events: none; }
  .gates-journey { display: flex; align-items: flex-start; justify-content: center; margin: 3rem 0; position: relative; z-index: 1; flex-wrap: wrap; }
  .gate-node { display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 260px; }
  .gate-arrow { display: flex; align-items: center; padding: 0 1rem; padding-top: 24px; }
  .gate-circle { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: "Sora", sans-serif; font-size: 1.25rem; font-weight: 800; margin-bottom: 1.25rem; flex-shrink: 0; }
  .gate-c1 { background: rgba(229,184,74,.12); border: 2px solid rgba(229,184,74,.3); color: #e5b84a; }
  .gate-c2 { background: rgba(45,212,191,.12); border: 2px solid rgba(45,212,191,.3); color: #2dd4bf; }
  .gate-c3 { background: rgba(139,92,246,.12); border: 2px solid rgba(139,92,246,.3); color: #a78bfa; }
  .gate-content h3 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: .6rem; }
  .gate-content p { font-size: 13.5px; color: rgba(255,255,255,.5); line-height: 1.7; margin-bottom: 1rem; }
  .gate-tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .gate-tools span { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: rgba(255,255,255,.55); }
  .gates-question { margin-top: 3rem; position: relative; z-index: 1; }
  .gq-inner { display: flex; align-items: center; gap: 1.5rem; padding: 2rem; border-radius: 16px; flex-wrap: wrap; justify-content: center; text-align: center; }
  .gq-icon { font-size: 2rem; }
  .gq-inner p { font-size: 15px; color: rgba(255,255,255,.65); flex: 1; min-width: 200px; line-height: 1.7; margin: 0; }

  /* ══ AI WINDOW ══ */
  #ai-window { padding: 6rem 0; }
  .ai-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; padding: 3rem; border-radius: 24px; }
  .ait-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.35); margin-bottom: 1.25rem; }
  .ait-rows { display: flex; flex-direction: column; gap: 14px; }
  .ait-row { display: flex; align-items: center; gap: 10px; }
  .ait-skill { font-size: 12px; color: rgba(255,255,255,.6); width: 170px; flex-shrink: 0; }
  .ait-risk-bar { flex: 1; height: 6px; background: rgba(255,255,255,.06); border-radius: 999px; overflow: hidden; }
  .ait-fill { height: 100%; border-radius: 999px; }
  .ait-high { background: linear-gradient(90deg, #dc2626, #f87171); }
  .ait-med { background: linear-gradient(90deg, #d97706, #fbbf24); }
  .ait-low { background: linear-gradient(90deg, #059669, #34d399); }
  .ait-pct { font-size: 11px; font-weight: 700; width: 36px; text-align: right; }
  .ait-red { color: #f87171; }
  .ait-yellow { color: #fbbf24; }
  .ait-green { color: #34d399; }

  /* ══ GROUP ENGINE ══ */
  #group-engine { padding: 6rem 0; }
  .ge-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .ge-diagram { position: relative; width: 300px; height: 300px; margin: 0 auto; }
  .ge-center-node { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #e5b84a, #f5d98c); color: #080c18; font-family: "Sora", sans-serif; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; z-index: 2; box-shadow: 0 0 40px rgba(229,184,74,.3); }
  .ge-lines { position: absolute; inset: 0; z-index: 1; }
  .ge-ring { position: absolute; inset: 0; }
  .ge-node { position: absolute; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 999px; font-size: 11px; font-weight: 600; color: rgba(255,255,255,.6); padding: 5px 12px; white-space: nowrap; z-index: 2; }
  .ge-n1 { top: 0; left: 50%; transform: translateX(-50%); }
  .ge-n2 { top: 22%; right: 0; transform: translateY(-50%); }
  .ge-n3 { bottom: 22%; right: 0; transform: translateY(50%); }
  .ge-n4 { bottom: 0; left: 50%; transform: translateX(-50%); }
  .ge-n5 { bottom: 22%; left: 0; transform: translateY(50%); }
  .ge-n6 { top: 22%; left: 0; transform: translateY(-50%); }

  /* ══ ADDED SECTIONS ══ */
  #guidance-in-practice,
  #guidance-difference,
  #proof-and-trust { padding: 6rem 0; }
  #guidance-in-practice {
    background: radial-gradient(1000px 320px at 50% -10%, rgba(45,212,191,.08), transparent 72%), linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.005));
  }
  #guidance-difference { background: rgba(255,255,255,.01); }
  #proof-and-trust { background: linear-gradient(180deg, rgba(229,184,74,.04), rgba(255,255,255,.005)); }
  .practice-pointer {
    margin: 0 auto 1.5rem;
    max-width: 1040px;
    padding: 1.5rem 1.6rem;
    border: 1px solid rgba(45,212,191,.24);
    background: linear-gradient(145deg, rgba(45,212,191,.09), rgba(255,255,255,.02));
    box-shadow: 0 12px 30px rgba(0,0,0,.2);
  }
  .practice-pointer-title {
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: .8rem;
    letter-spacing: -.01em;
  }
  .practice-pointer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .6rem .9rem;
  }
  .practice-pointer-list li {
    color: rgba(255,255,255,.78);
    font-size: 13.5px;
    line-height: 1.65;
    padding-left: 1rem;
    position: relative;
  }
  .practice-pointer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .58rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }
  .mini-grid.six-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .mini-card {
    padding: 1.4rem;
    border: 1px solid rgba(255,255,255,.12);
    border-top: 3px solid rgba(229,184,74,.72);
    background: linear-gradient(155deg, rgba(255,255,255,.04), rgba(255,255,255,.015));
    box-shadow: 0 14px 34px rgba(0,0,0,.24);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .mini-card:hover {
    transform: translateY(-3px);
    border-color: rgba(229,184,74,.34);
    box-shadow: 0 22px 44px rgba(0,0,0,.32);
  }
  .mini-card h3 {
    font-size: 15px;
    color: #fff;
    margin-bottom: .55rem;
    line-height: 1.45;
    letter-spacing: -.01em;
  }
  .mini-card p {
    font-size: 13.5px;
    color: rgba(255,255,255,.72);
    line-height: 1.75;
    max-width: 38ch;
  }
  .compare-stack { display: grid; gap: .95rem; max-width: 1040px; margin: 0 auto; }
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    overflow: hidden;
    padding: 0;
  }
  .compare-col {
    padding: 1.1rem 1.2rem;
    border-right: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02);
  }
  .compare-col:last-child { border-right: 0; }
  .compare-col-gold { background: linear-gradient(135deg, rgba(229,184,74,.11), rgba(255,255,255,.01)); }
  .compare-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .09em;
    color: rgba(255,255,255,.45);
    margin-bottom: .35rem;
    font-weight: 700;
  }
  .compare-col p { font-size: 13.5px; color: rgba(255,255,255,.72); line-height: 1.75; max-width: 40ch; }
  .compare-col-gold p { color: #fff; font-weight: 600; }
  .trust-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; max-width: 980px; margin: 0 auto; }
  .trust-card {
    padding: 1.35rem;
    border: 1px solid rgba(229,184,74,.22);
    background: linear-gradient(150deg, rgba(255,255,255,.04), rgba(255,255,255,.015));
    box-shadow: 0 12px 30px rgba(0,0,0,.2);
  }
  .trust-card h3 { font-size: 16px; color: #fff; margin-bottom: .45rem; line-height: 1.4; }
  .trust-card p { font-size: 13.5px; color: rgba(255,255,255,.72); line-height: 1.7; }

  /* Design intensity pass: stronger readability and scannability */
  #search-intent .si-list { gap: 1.1rem; }
  #search-intent .si-item {
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.12);
    background: linear-gradient(155deg, rgba(255,255,255,.045), rgba(255,255,255,.018));
    box-shadow: 0 14px 34px rgba(0,0,0,.23);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  #search-intent .si-item:hover {
    transform: translateY(-3px);
    border-color: rgba(229,184,74,.3);
    box-shadow: 0 22px 44px rgba(0,0,0,.3);
  }
  #search-intent .si-q {
    font-size: clamp(1.02rem, 1.6vw, 1.16rem);
    line-height: 1.5;
  }
  #search-intent .si-a {
    font-size: 14px;
    color: rgba(255,255,255,.78);
    line-height: 1.82;
  }
  #search-intent .si-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-weight: 700;
    margin-top: .5rem;
  }
  #search-intent .si-link::after {
    content: '';
    width: 20px;
    height: 1px;
    background: currentColor;
    opacity: .65;
  }

  #audience .section-sub { max-width: 860px; }
  #audience .audience-grid { gap: 1.2rem; }
  #audience .audience-card {
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.14);
    box-shadow: 0 16px 36px rgba(0,0,0,.26);
    overflow: hidden;
    position: relative;
  }
  #audience .audience-card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, rgba(45,212,191,.92), rgba(229,184,74,.92));
  }
  #audience .aud-level {
    display: inline-block;
    width: fit-content;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid rgba(229,184,74,.22);
    background: rgba(229,184,74,.08);
  }
  #audience .aud-list li {
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.025);
    border-radius: 10px;
    padding: .48rem .6rem .48rem 1.34rem;
  }
  #audience .aud-actions {
    justify-content: center;
    margin-top: 1.6rem;
  }

  #guidance-expectations .expect-grid {
    gap: 1rem;
    max-width: 1100px;
  }
  #guidance-expectations .expect-card {
    border-radius: 18px;
    box-shadow: 0 12px 30px rgba(0,0,0,.22);
  }
  #guidance-expectations .expect-card h3 {
    font-size: 1.24rem;
  }
  #guidance-expectations .expect-list li {
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    background: rgba(255,255,255,.02);
    padding: .56rem .64rem .56rem 1.36rem;
    line-height: 1.72;
  }

  #guidance-in-practice .mini-grid.six-grid { gap: 1.05rem; }
  #guidance-in-practice .mini-card {
    border-radius: 16px;
    border-top-width: 4px;
  }
  #guidance-in-practice .mini-card h3 { font-size: 15.5px; }
  #guidance-in-practice .mini-card p { color: rgba(255,255,255,.78); }

  #guidance-difference .compare-row {
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: 0 10px 24px rgba(0,0,0,.2);
  }
  #guidance-difference .compare-col { padding: 1.18rem 1.3rem; }

  #proof-and-trust .trust-grid { gap: 1.05rem; }
  #proof-and-trust .trust-card { border-radius: 14px; }

  /* ══ SERVICES CTA ══ */
  /* ══ FAQ ══ */
  #faq { padding: 6rem 0; }
  .faq-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 3rem; max-width: 960px; margin-left: auto; margin-right: auto; }
  .faq-item {
    background: linear-gradient(160deg, rgba(255,255,255,.045), rgba(255,255,255,.015));
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color .2s, transform .2s;
  }
  .faq-item:hover { transform: translateY(-1px); }
  .faq-item[open] { border-color: rgba(229,184,74,.2); }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 1.25rem 1.5rem;
    font-size: 15px;
    font-weight: 650;
    color: #fff;
    cursor: pointer;
    list-style: none;
    user-select: none;
    line-height: 1.5;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-arrow { flex-shrink: 0; color: rgba(255,255,255,.4); transition: transform .3s; }
  .faq-item[open] .faq-arrow { transform: rotate(180deg); color: var(--gold); }
  .faq-a { padding: 1rem 1.5rem 1.25rem; font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.82; border-top: 1px solid rgba(255,255,255,.06); }

  /* ══ FINAL CTA ══ */
  #final-cta { padding: 7rem 0; text-align: center; position: relative; }
  .fcta-bg { position: absolute; inset: 0; }
  .fcta-orb { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
  .fcta-orb-1 { width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(229,184,74,.12) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%,-50%); }
  .fcta-orb-2 { width: 400px; height: 300px; background: radial-gradient(ellipse, rgba(45,212,191,.06) 0%, transparent 70%); bottom: 0; right: 0; }
  .fcta-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .fcta-eyebrow { font-size: 13px; font-weight: 600; color: rgba(255,255,255,.5); margin-bottom: 1.75rem; gap: 10px; }
  .fcta-headline { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -.04em; color: #fff; line-height: 1.1; margin-bottom: 1.25rem; }
  .fcta-sub { font-size: clamp(15px, 2vw, 17px); color: rgba(255,255,255,.5); max-width: 560px; line-height: 1.7; margin-bottom: 2.5rem; }
  .fcta-actions { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .fcta-btn { font-size: 16px; padding: 16px 32px; border-radius: 14px; }
  .fcta-trust { display: flex; align-items: center; gap: .75rem; margin-top: 1.5rem; font-size: 13px; color: rgba(255,255,255,.35); flex-wrap: wrap; justify-content: center; }
  .fcta-dot { color: rgba(255,255,255,.2); }

  /* ══ RESPONSIVE ══ */
  @media (max-width: 1024px) {
    /* hero-cycle-wrap is display:block, no min-width needed at any breakpoint */
    .si-item { grid-template-columns: 1fr; gap: 1rem; }
    .si-link { padding-top: 0; }
    .audience-grid, .profiles-grid, .expect-grid { grid-template-columns: 1fr; }
    /* skill finder — collapse 6-col grid to 4-col (2 cards per row) */
    .sf-grid { grid-template-columns: repeat(4, 1fr); }
    .sf-card { grid-column: span 2; }
    .sf-card:nth-child(4) { grid-column: span 2; }
    .sf-card:nth-child(5) { grid-column: 2 / span 2; }
    .sf-ims-row { grid-template-columns: 64px 1fr; }
    .sf-ims-note { display: none; }
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-line { display: none; }
    .ai-inner, .ge-inner, .philosophy-inner { grid-template-columns: 1fr; }
    .faq-grid { grid-template-columns: 1fr; }
    .mini-grid.six-grid { grid-template-columns: repeat(2, 1fr); }
    .practice-pointer-list { grid-template-columns: 1fr; }
    .compare-row { grid-template-columns: 1fr; }
    .compare-col { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.08); }
    .compare-col:last-child { border-bottom: 0; }
    .trust-grid { grid-template-columns: 1fr; }
    .gate-arrow { display: none; }
    .gates-journey { flex-direction: column; align-items: center; gap: 2rem; }
  }
