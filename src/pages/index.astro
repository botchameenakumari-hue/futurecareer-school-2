---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ComparisonMatrix from '../components/bofu/ComparisonMatrix.astro';
import LinkDirectorySection from '../components/LinkDirectorySection.astro';
import { WHATSAPP_BOOKING_URL } from '../config/site';
import { BOFU_INTERNAL_LINKS, BOFU_PAYMENT_LINKS } from '../config/bofu';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Future Career School",
    "url": "https://futurecareerschool.com",
    "logo": "https://futurecareerschool.com/favicon.svg",
    "description": "India's practical career guidance platform helping students, freshers, and working professionals build high-value skills, market readiness, and an earlier financial freedom roadmap.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "13-420, Durga Nagar, Arilova",
      "addressLocality": "Visakhapatnam",
      "addressRegion": "Andhra Pradesh",
      "postalCode": "530040",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+91-78159-27259",
      "contactType": "customer service",
      "availableLanguage": ["English", "Hindi", "Telugu"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Future Career School",
    "url": "https://futurecareerschool.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://futurecareerschool.com/career-resources?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Future Career School?",
        "acceptedAnswer": { "@type": "Answer", "text": "Future Career School provides career counselling and career guidance for students, freshers, and working professionals in India. We start with practical clarity and, if needed, continue with guidance for high-value skill building, market readiness, and an earlier financial freedom roadmap." }
      },
      {
        "@type": "Question",
        "name": "Who is this guidance for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Guidance is usually split into two practical paths: one for students, freshers, and early-career people who still need stronger direction, and one for working professionals who need stronger leverage, pivots, or income-growth decisions." }
      },
      {
        "@type": "Question",
        "name": "How does the guidance work?",
        "acceptedAnswer": { "@type": "Answer", "text": "You start with practical assessment-led clarity on your strengths, work style, and market fit. Then we guide your next steps for skill building, portfolio proof, communication, and tech leverage with personalized support." }
      },
      {
        "@type": "Question",
        "name": "What is the Freedom Number?",
        "acceptedAnswer": { "@type": "Answer", "text": "Your Freedom Number is the income level at which your career gives you genuine life choice — not just financial survival. We help you calculate it precisely and reverse-engineer the skill and income path to reach it." }
      },
      {
        "@type": "Question",
        "name": "Is career guidance available online or only in Visakhapatnam?",
        "acceptedAnswer": { "@type": "Answer", "text": "All sessions are fully online. We work with students, freshers, and working professionals across every state in India." }
      }
    ]
  }
];

const homeGuidanceDirectoryItems = [
  {
    href: '/services/career-counselling-and-career-guidance/',
    title: 'Career Counselling and Guidance',
    description: 'Broader help with stream, course, skill, and next-step decisions when one choice affects everything else.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-guidance/',
    title: 'Career Guidance',
    description: 'Practical direction for people who need clearer next steps, stronger trade-offs, and better skill choices.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-counselling/',
    title: 'Career Counselling',
    description: 'Clarity-first support when the decision feels personal, confusing, or emotionally heavy.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerCounsellingOnline,
    title: 'Career Counselling Online',
    description: 'For people who want practical online career counselling without waiting for a local offline option.',
  },
  {
    href: '/services/career-counselling-and-career-guidance/career-coach-near-me/',
    title: 'Career Coach Near Me',
    description: 'Online career coaching across India for people who want real guidance, not just local proximity.',
  },
  {
    href: BOFU_INTERNAL_LINKS.careerGuidanceOnline,
    title: 'Career Guidance Online',
    description: 'For people who want practical online career guidance without waiting for a local offline option.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12th,
    title: 'Career Guidance After 12th',
    description: 'For stream, course, degree, and next-step decisions after school.',
  },
  {
    href: BOFU_INTERNAL_LINKS.after12thOnline,
    title: 'Career Guidance After 12th Online',
    description: 'For students and parents who want after-12th guidance online from anywhere in India.',
  },
  {
    href: BOFU_INTERNAL_LINKS.students,
    title: 'Student Career Guidance',
    description: 'For school students, college students, freshers, recent graduates, and postgraduates who need stronger direction.',
  },
  {
    href: BOFU_INTERNAL_LINKS.workingProfessionals,
    title: 'Working Professional Career Guidance',
    description: 'For pivots, salary growth, stagnation, and stronger long-term leverage.',
  },
];

const homeAssessmentDirectoryItems = [
  {
    href: '/services/assessments/',
    title: 'Free Career Assessments',
    description: 'Free career and skill assessments across school, college, graduate, and professional stages.',
  },
  {
    href: '/services/assessments/class-10-and-below/',
    title: 'Class 10 and Below Assessment',
    description: 'Stream-fit, strength-mapping, and early direction before Class 11 choices harden.',
  },
  {
    href: '/services/assessments/class-11-to-12/',
    title: 'Class 11 to 12 Assessment',
    description: 'Course-fit, degree direction, and after-school decision support before bigger commitments.',
  },
  {
    href: '/services/assessments/graduates-and-early-professionals/',
    title: 'Graduates and Early Professionals Assessment',
    description: 'Free clarity on fit, skill direction, employability, and market-ready next steps.',
  },
  {
    href: '/services/assessments/working-professionals-and-career-changers/',
    title: 'Working Professionals and Career Changers Assessment',
    description: 'Free input for pivots, salary growth, role fit, and stronger leverage decisions.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-10th/',
    title: 'Career Aptitude Test After 10th',
    description: 'A focused free aptitude test for students choosing a stream after Class 10.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-10th/',
    title: 'Stream Selector Test After 10th',
    description: 'A focused free stream quiz for Science, Commerce, or Arts decisions after Class 10.',
  },
  {
    href: '/services/assessments/stream-selector-test-after-12th/',
    title: 'Stream Selector Test After 12th',
    description: 'A focused free quiz for course and path direction after Class 12.',
  },
  {
    href: '/services/assessments/career-aptitude-test-after-12th/',
    title: 'Career Aptitude Test After 12th',
    description: 'A focused free aptitude test for students choosing a degree, course, or training path after Class 12.',
  },
];
---

<BaseLayout
  title="Career Guidance for Every Growth Stage | Future Career School"
  description="Confused about which career to choose? Stuck after college or early career? Salary not growing? Practical career counseling and guidance for students, freshers, and professionals focused on high-value skill building and early financial freedom."
  jsonLd={jsonLd.slice(0, 2)}
>
  <Nav />

  <!-- ═══════════════════════════════════════
       HERO — EDITORIAL FULL-WIDTH
  ═══════════════════════════════════════ -->
  <section id="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>

    <div class="hero-inner container">
      <div class="hero-pill pill animate-up">
        <span class="pill-dot"></span>
        Career guidance for students, freshers, and professionals
      </div>

      <h1 class="hero-headline animate-up" style="animation-delay:.08s">
        <span class="hero-line-top">If you're</span>
        <span class="hero-cycle-wrap" role="text" aria-label="navigating a career challenge">
          <span class="hero-cycle-word" aria-hidden="true">confused about direction</span>
          <span class="hero-cycle-word" aria-hidden="true">stuck after graduation</span>
          <span class="hero-cycle-word" aria-hidden="true">hitting a salary ceiling</span>
          <span class="hero-cycle-word" aria-hidden="true">worried about AI</span>
        </span>
        <span class="hero-line-bottom">&mdash;&thinsp;we guide your next move.</span>
      </h1>

            <p class="hero-sub animate-up" style="animation-delay:.18s">
        Career guidance that goes beyond generic advice.
        We help you choose the right skill path, build proof of work, and execute a roadmap toward earlier financial freedom.
        Practical clarity first, then focused execution support that helps you move faster with fewer wrong turns.
      </p>

      <div class="hero-actions animate-up" style="animation-delay:.28s">
        <a
          href="/services/career-counselling-and-career-guidance"
          class="btn-gold pulse hero-cta"
        >
          Get Career Guidance
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/services/assessments" class="btn-outline">
          Get Free Career and Skill Assessments
        </a>
      </div>

      <!-- Stage identity chips -->
      <div class="hero-identity animate-up" style="animation-delay:.38s" role="navigation" aria-label="Career stage navigation">
        <a href={BOFU_INTERNAL_LINKS.students} class="hid-chip">
          <span class="hid-level">Students</span>
          School, College, and Early-Career
        </a>
        <span class="hid-sep" aria-hidden="true"></span>
        <a href={BOFU_INTERNAL_LINKS.workingProfessionals} class="hid-chip">
          <span class="hid-level">Professionals</span>
          Working Professional
        </a>
      </div>

      <div class="hero-trust animate-up" style="animation-delay:.48s">
        <div class="trust-item">
          <svg width="14" height="14" fill="none" stroke="#2dd4bf" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          All assessments, resources, skill-finder, and course-finder tools are free
        </div>
        <div class="trust-item">
          <svg width="14" height="14" fill="none" stroke="#2dd4bf" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Fully online &mdash; every city in India
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       STATS BAND
  ═══════════════════════════════════════ -->
  <section id="stats-band">
    <div class="container stats-inner">
      <div class="stat-item">
        <div class="stat-row stat-row--text"><span class="stat-word">Practical clarity</span></div>
        <span class="stat-lbl">High-leverage decisions before expensive wrong turns</span>
      </div>
      <div class="stat-div"></div>
      <div class="stat-item">
        <div class="stat-row stat-row--text"><span class="stat-word">Scoped to you</span></div>
        <span class="stat-lbl">Higher-value skill direction, proof of work, and stronger income growth</span>
      </div>
      <div class="stat-div"></div>
      <div class="stat-item">
        <div class="stat-row stat-row--text"><span class="stat-word">India-wide</span></div>
        <span class="stat-lbl">Online across India with free career and skill assessments</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SEARCH-INTENT — EDITORIAL Q&A
  ═══════════════════════════════════════ -->
  <section id="search-intent">
    <div class="container">
      <div class="si-intro">
        <div class="section-tag pill" style="display:inline-flex">
          <span style="color:var(--gold)">&#128172;</span>&nbsp;Real Questions, Real Answers
        </div>
        <h2 class="section-headline" style="text-align:left;display:block;max-width:600px">
          Core Career Questions for<br /><span class="gold-text">Real Skill and Income Growth</span>
        </h2>
      </div>
      <div class="si-list">
        <div class="si-item">
          <h3 class="si-q">Which career path and skill direction fits me best?</h3>
          <p class="si-a">We map your natural inclinations, current strengths, work style preferences, and market readiness together. Then we identify which path can stay sustainable and also support high-value income growth over time.</p>
          <a href="/services/assessments" class="si-link">Explore free assessments &rarr;</a>
        </div>
        <div class="si-item">
          <h3 class="si-q">My degree alone is not leading to strong income outcomes. What now?</h3>
          <p class="si-a">A degree is a credential, not a career. What creates income is a T-shaped skill stack &mdash; your existing knowledge plus one real-world, market-validated skill that employers and clients pay a premium for. Practical Fit Check narrows it down to the right one for you in a single session.</p>
          <a href="/services/assessments" class="si-link">Start with free career tests &rarr;</a>
        </div>
        <div class="si-item">
          <h3 class="si-q">How do I upskill for early financial freedom through high-value skills?</h3>
          <p class="si-a">For professionals, we focus on holistic skill growth: core skill depth, transferable skills, business communication, and tech-enabled execution. The goal is early financial freedom through high-value skill stacking and stronger income optionality.</p>
          <a href="/services/career-counselling-and-career-guidance" class="si-link">See counseling and guidance services &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WHO WE HELP — AUDIENCE
  ═══════════════════════════════════════ -->
    <section id="audience">
    <div class="container">
      <div class="section-tag pill">
        <span style="color:var(--teal)">&#9689;</span>&nbsp;Who We Work With
      </div>
      <h2 class="section-headline">
        Get Career Guidance for <span class="gold-text">Every Growth Stage.</span>
      </h2>
      <p class="section-sub">
        Different life stages, shared foundations: practical assessments, high-value skill building, market readiness, and an early financial freedom roadmap.
        We guide students, freshers, and working professionals.
        All assessments, resources, skill-finder, and course-finder tools are free.
      </p>

      <div class="audience-grid">
        <article class="audience-card">
          <div class="aud-level">Student or Pre-Career</div>
          <div class="aud-icon-wrap">&#127891;</div>
          <h3>School &amp; College Students</h3>
          <p class="aud-desc">
            Early direction, stream awareness, and first clarity before pressure turns into expensive wrong turns.
            You're choosing streams, courses, and early skill direction.
            We help you avoid expensive mistakes and start building practical proof early.
          </p>
          <div class="aud-block-label">This is for you if...</div>
          <ul class="aud-list">
            <li>You're in school or college and don't know which path to commit to.</li>
            <li>You're a fresher, recent graduate, or postgraduate and still do not know which skill direction is worth serious effort.</li>
            <li>You picked a stream or degree without knowing if it suits your thinking style.</li>
            <li>You want to start building skills but don't know which one is worth it.</li>
          </ul>
          <div class="aud-block-label">What we provide</div>
          <ul class="aud-list">
            <li>Student career guidance: Early direction and stream awareness.</li>
            <li>Strength and work-style mapping before major decisions.</li>
            <li>Free assessments and free resources before paid commitments.</li>
            <li>Early portfolio and communication skill building.</li>
            <li>Tech + AI readiness, including no-code options when relevant.</li>
          </ul>
        </article>

        <article class="audience-card">
          <div class="aud-level">Working Professional</div>
          <div class="aud-icon-wrap">&#128142;</div>
          <h3>Working Professionals</h3>
          <p class="aud-desc">
            For stagnation, AI pressure, skill under-leverage, career pivots, and earlier financial freedom through stronger skill stacking.
            If you feel under-leveraged, we help you build strategic upskilling plans for stronger positioning, better compensation, and multiple income streams.
          </p>
          <div class="aud-block-label">This is for you if...</div>
          <ul class="aud-list">
            <li>You're ready to upskill toward stronger compensation and high-value opportunities.</li>
            <li>You want to go independent but are afraid to leave the security of a salary.</li>
          </ul>
          <div class="aud-block-label">What we provide</div>
          <ul class="aud-list">
            <li>Professional career guidance: Career positioning for earlier financial freedom.</li>
            <li>Holistic skill growth: domain depth + transferable strengths.</li>
            <li>Income-multiplication planning and optional income-stream design.</li>
            <li>Tech leverage for automation, efficiency, and scale.</li>
          </ul>
        </article>
      </div>
      <div class="aud-actions">
        <a href={BOFU_PAYMENT_LINKS.students} class="btn-gold">Get Student Career Guidance</a>
        <a href={BOFU_PAYMENT_LINKS.workingProfessionals} class="btn-outline">Get Working Professional Career Guidance</a>
      </div>
    </div>
  </section>

  <LinkDirectorySection
    sectionId="home-guidance-directory"
    title="Career Guidance for Different Situations"
    subtitle="Explore the guidance option that fits your current decision, stage, or pressure."
    items={homeGuidanceDirectoryItems}
    altBackground={true}
  />

  <LinkDirectorySection
    sectionId="home-assessment-directory"
    title="Free Career Assessments by Stage"
    subtitle="Choose the free assessment that matches your stage, whether you need stream clarity, aptitude signals, or career-direction input."
    items={homeAssessmentDirectoryItems}
  />

  <section id="guidance-expectations">
    <div class="container">
      <div class="section-tag pill">
        <span style="color:var(--teal)">&#9675;</span>&nbsp;Clear Expectations
      </div>
      <h2 class="section-headline">
        What Guidance <span class="gold-text">Is and Isn't</span>
      </h2>
      <p class="section-sub">
        We would rather be clear than vague.
        This is what career guidance here is meant to do, and what it is not meant to pretend to do.
      </p>

      <div class="expect-grid">
        <div class="expect-card card expect-card-not">
          <h3>What Guidance Is <em>Not</em></h3>
          <ul class="expect-list">
            <li>A shortcut that works without effort on your part</li>
            <li>A placement service or guaranteed job outcome</li>
            <li>Generic advice you could find on YouTube</li>
            <li>A fixed curriculum the same for everyone</li>
            <li>A quick-fix for years of career drift</li>
            <li>Something that replaces your own execution</li>
            <li>A rigid, fixed-length programme you're locked into</li>
          </ul>
        </div>

        <div class="expect-card card expect-card-is">
          <h3>What Guidance <em>Is</em></h3>
          <ul class="expect-list">
            <li>A structured approach tailored to <strong>your biology, market, and timeline</strong></li>
            <li>Clarity on the exact skill and career path worth your next serious phase of effort</li>
            <li>A practical way to choose the skill path that matches your fit, market demand, and long-term upside</li>
            <li>A realistic income target with a roadmap that helps you close the gap step by step</li>
            <li>A strategic roadmap you <em>actually execute</em>, not just a PDF plan</li>
            <li>Honest feedback even when it's not what you want to hear</li>
            <li>Sessions that end when your goals are met, not when we want more revenue</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="guidance-in-practice">
    <div class="container">
      <div class="section-tag pill">
        <span style="color:var(--gold)">&#9673;</span>&nbsp;Execution Path
      </div>
      <h2 class="section-headline">
        How Career Guidance Works <span class="gold-text">in Practice</span>
      </h2>
      <p class="section-sub">
        A practical 6-step path from confusion to stronger skill direction, market readiness, and earlier financial freedom.
      </p>
      <div class="practice-pointer card">
        <h3 class="practice-pointer-title">What this includes</h3>
        <ul class="practice-pointer-list">
          <li>Initial Psychometric Assessment &amp; Career Counseling</li>
          <li>Personalised Long-Term Career Plan</li>
          <li>High-value skill selection &amp; decision leveraging</li>
          <li>Guidance path recommendation based on your goals and profile</li>
          <li>Collective upskilling &amp; peer accountability</li>
        </ul>
      </div>
      <div class="mini-grid six-grid">
        <article class="mini-card card">
          <h3>1. Psychometric and Fit Mapping</h3>
          <p>Map strengths, work-style, and profile fit before major commitments.</p>
        </article>
        <article class="mini-card card">
          <h3>2. High-Value Skill Selection</h3>
          <p>Choose skills based on market demand, role fit, and long-term leverage.</p>
        </article>
        <article class="mini-card card">
          <h3>3. Proof-of-Work Portfolio</h3>
          <p>Build practical output that improves real-world credibility.</p>
        </article>
        <article class="mini-card card">
          <h3>4. Curated Learning Path</h3>
          <p>Use focused resources and roadmap-based upskilling.</p>
        </article>
        <article class="mini-card card">
          <h3>5. Positioning and Communication</h3>
          <p>Improve profile clarity, communication, and interview readiness.</p>
        </article>
        <article class="mini-card card">
          <h3>6. Income Optionality Planning</h3>
          <p>Build pathways for stronger compensation and additional income options.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="skill-finder">
    <div class="sf-bg"><div class="sf-orb"></div></div>
    <div class="container">

      <div class="section-tag pill">
        <span style="color:var(--teal)">&#128269;</span>&nbsp;Skill Direction
      </div>
      <h2 class="section-headline">
        Find the Skill That Fits <span class="gold-text">How You Actually Think</span>
      </h2>
      <p class="section-sub">
        Most people pick skills based on what's trending on LinkedIn. That's backwards.
        The right skill starts with how your brain naturally works &mdash; then gets validated
        against real market demand and income potential.
      </p>

      <!-- Orientation Quick Check -->
      <div class="bc-box card">
        <div class="bc-box-label">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          Quick orientation check &mdash; practical self-evaluation before major decisions
        </div>
        <div class="bc-qs">
          <div class="bc-q">
            <span class="bc-num">01</span>
            <div class="bc-q-body">
              <p class="bc-q-text">Look at the combination that keeps showing up in your best work: your <strong>natural inclinations</strong>, <strong>academic performance patterns</strong>, <strong>work-style preference</strong>, and the kind of <strong>tech leverage path</strong> you can realistically sustain, whether that means coding deeply or using no-code tools with strong execution.</p>
              <p class="bc-q-note">The goal is not to force yourself into one label. The goal is to spot the pattern that gives you stronger performance, better consistency, and more room to build high-value skills.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="sf-intro">
        <h3 class="sf-intro-title">Skill paths mapped to the way you naturally work</h3>
        <p class="sf-intro-copy">These profiles are meant to sharpen your thinking, not trap you in one label. The goal is to notice where your natural strengths keep repeating.</p>
      </div>

      <!-- 5 Thinking Style Cards -->
      <div class="sf-grid">

        <!-- Card 1: Analytical Thinker -->
        <details class="sf-card sf-card--systems">
          <summary class="sf-card-face">
            <div class="sf-type-badge">Logic &middot; Systems</div>
            <div class="sf-icon" aria-hidden="true">&#9881;&#65039;</div>
            <h3 class="sf-card-title">Analytical Thinker</h3>
            <p class="sf-card-hook">Numbers, data, structured logic &mdash; math and patterns don't intimidate you. You like understanding <em>how</em> things work under the hood.</p>
            <div class="sf-preview-skills">Data &middot; Software Dev &middot; Cloud &middot; Finance &middot; Cybersecurity</div>
