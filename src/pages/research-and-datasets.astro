---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PLANNED_DATASET_REGISTRY, PUBLISHED_EDITORIAL_DATASETS, RESEARCH_REGISTRY_META, RESEARCH_REPORT_REGISTRY } from '../config/researchRegistry';
import { CAREER_CATALOGUE_META, CAREER_DATABASE_PRIORITY_KEYS, CAREER_DATABASE_READINESS } from '../config/careerRouteDataset';

const title = 'Research and Dataset Registry | Future Career School';
const description = 'A transparent registry showing which Future Career School datasets are published and which research outputs still require first-party data and consent.';
const canonical = 'https://futurecareerschool.com/research-and-datasets/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav /><main class="registry-page"><div class="registry-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Research and datasets</span></nav>
    <p class="eyebrow">TRANSPARENT DELIVERY REGISTRY · {RESEARCH_REGISTRY_META.version}</p>
    <h1>What has actually been published?</h1>
    <p class="lead">This page separates working products from planned research. It is deliberately boring: an empty status is safer than a polished page that implies evidence we do not have.</p>
    <div class="registry-callout"><b>Current rule:</b> editorial datasets may describe the school’s own content when their provenance and limits are attached. Research reports require first-party responses or records, consent where applicable, a documented method and enough evidence to support the claim. See the <a href="/data-policy/">data and research policy</a>.</div>
    <section><h2>Published editorial datasets</h2><div class="registry-grid">{PUBLISHED_EDITORIAL_DATASETS.map((item) => <article class="status-card status-card--published"><span class="status">Published · editorial</span><h3>{item.label}</h3><p>{item.note}</p><a href={item.url}>Open dataset</a></article>)}</div></section>
    <section><h2>Career catalogue verification gate</h2><div class="registry-callout"><b>Status:</b> {CAREER_CATALOGUE_META.recordStatus}. The {CAREER_CATALOGUE_META.owner.toLowerCase()} owns the editorial catalogue, but it is not published as a definitive admissions, licensing, salary or labour-market database. The verification queue contains {CAREER_DATABASE_READINESS.priorityCount} priority routes. Before publication, every material record needs eligibility, routes, costs, regulation, AI-impact notes, primary sources, a last-verified date and a named verifier. The queue is a work order, not proof that those records are verified. <a href="/datasets/career-route-catalogue-2026/">Read the catalogue scope and download the editorial data</a>.</div><details class="queue-details"><summary>Show the first 50 route keys in the verification queue</summary><ol>{CAREER_DATABASE_PRIORITY_KEYS.map((key) => <li><code>{key}</code></li>)}</ol></details></section>
    <section><h2>Original benchmark reports</h2><p class="section-note">{RESEARCH_REPORT_REGISTRY.length} report slots remain unpublished. This is a delivery status, not a research result.</p><div class="registry-table-wrap"><table><thead><tr><th>Item</th><th>Status</th><th>What is still required</th></tr></thead><tbody>{RESEARCH_REPORT_REGISTRY.map((item) => <tr><td>{item.label}</td><td><span class="status status--blocked">Not published</span></td><td>{item.blocker}</td></tr>)}</tbody></table></div></section>
    <section><h2>Original public-dataset workstream</h2><p class="section-note">{PLANNED_DATASET_REGISTRY.length} original dataset slots remain unpublished. The published editorial dataset cards above are separate and are not being counted as survey evidence.</p><div class="registry-table-wrap"><table><thead><tr><th>Item</th><th>Status</th><th>What is still required</th></tr></thead><tbody>{PLANNED_DATASET_REGISTRY.map((item) => <tr><td>{item.label}</td><td><span class="status status--blocked">Not published</span></td><td>{item.blocker}</td></tr>)}</tbody></table></div></section>
    <p class="updated">Registry version {RESEARCH_REGISTRY_META.version}. Status changes only when the underlying evidence, ownership and publication conditions are met.</p>
  </div></main><Footer />
</BaseLayout>
<style>
  .registry-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.registry-shell{max-width:1050px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.registry-page a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.eyebrow{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.registry-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.lead{max-width:800px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.registry-callout{margin:1.5rem 0;padding:1rem 1.1rem;border:1px solid rgba(229,184,74,.4);border-radius:14px;background:rgba(229,184,74,.08);line-height:1.7;color:rgba(255,255,255,.78)}.registry-page section{margin:2rem 0}.registry-page h2{color:#fff;margin-bottom:.7rem}.section-note,.updated{color:rgba(255,255,255,.64);line-height:1.7}.registry-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.8rem}.status-card{padding:1rem;border:1px solid rgba(18,154,141,.35);border-radius:14px;background:rgba(18,154,141,.06)}.status-card h3{color:#fff;margin:.55rem 0}.status-card p{color:rgba(255,255,255,.7);line-height:1.6}.status{display:inline-flex;padding:.2rem .5rem;border-radius:999px;background:rgba(18,154,141,.2);color:#9ff3e6;font-size:.75rem;font-weight:700}.status--blocked{background:rgba(229,184,74,.16);color:#f7d88c}.registry-table-wrap{overflow-x:auto}.registry-table-wrap table{width:100%;min-width:720px;border-collapse:collapse}.registry-table-wrap th,.registry-table-wrap td{padding:.7rem;border:1px solid rgba(255,255,255,.14);text-align:left;vertical-align:top;line-height:1.55}.registry-table-wrap th{color:#fff;background:rgba(18,154,141,.16)}.registry-table-wrap td{color:rgba(255,255,255,.7)}
</style>
