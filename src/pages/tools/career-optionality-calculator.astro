---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CareerOptionalityCalculator from '../../components/CareerOptionalityCalculator.astro';

const title = 'Career Optionality Calculator | Compare Reversible Career Choices';
const description = 'A transparent career-planning worksheet for comparing transferable skills, reversibility, testability and formal requirements.';
const canonical = 'https://futurecareerschool.com/tools/career-optionality-calculator/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE DECISION WORKSHEET</p><h1>Career Optionality <span>Calculator</span></h1><p class="lead">Compare how many choices a path appears to preserve before you make an expensive or hard-to-reverse commitment.</p><p class="tool-limits"><b>Boundary:</b> this is an editorial planning signal, not a promise about employability, income or future demand.</p></section>
    <section class="container tool-shell"><CareerOptionalityCalculator /></section>
    <section class="container tool-explainer"><h2>What optionality means here</h2><div class="explainer-grid"><article><h3>Transferable evidence</h3><p>A skill is more useful when you can demonstrate it in more than one setting, not merely list it.</p></article><article><h3>Reversible decisions</h3><p>Staged, low-cost commitments leave more room to learn before you lock in time or money.</p></article><article><h3>Clear rules</h3><p>Optionality cannot compensate for missing eligibility, recognition, licensing or safety requirements.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
