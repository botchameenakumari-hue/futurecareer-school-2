---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import StudentBusinessFeasibilityCalculator from '../../components/StudentBusinessFeasibilityCalculator.astro';
const title = 'Student Business Idea Feasibility Calculator | Future Career School';
const description = 'Stress-test a student business idea with your own price, cost, sales and time assumptions, then run a 14-day test before spending more.';
const canonical = 'https://futurecareerschool.com/tools/student-business-idea-feasibility-calculator/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav /><BusinessPerspectiveNote /><main class="sbf-page"><div class="sbf-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Student business idea feasibility calculator</span></nav>
    <p class="eyebrow">DECISION TOOL · USE YOUR OWN NUMBERS</p><h1>Test a student business idea before committing more</h1>
    <p class="lead">A list of business ideas is easy to generate and hard to evaluate. Enter a small set of assumptions, see the unit economics, and use the 14-day worksheet to learn from real conversations and paid tests.</p>
    <StudentBusinessFeasibilityCalculator />
    <section class="notes"><h2>What this calculator does not know</h2><p>It cannot know whether people will buy, whether your numbers are realistic, or whether the work fits your studies and responsibilities. It only makes the arithmetic of your assumptions visible.</p><p><a href="/career-skills-compass/skills/">Build a skill you can demonstrate</a> · <a href="/services/assessments/entrepreneurial-aptitude-test/">Try the entrepreneurial aptitude assessment</a> · <a href="/tools/education-cost-payback-planner/">Compare the education decision separately</a></p></section>
  </div></main><Footer />
</BaseLayout>
<style>
  .sbf-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(229,184,74,.12),transparent 35%),#080c18}.sbf-shell{max-width:1180px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.notes a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.eyebrow{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.sbf-page h1{max-width:900px;font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff;line-height:1.05}.lead{max-width:850px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.notes{margin-top:2rem;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:16px;color:rgba(255,255,255,.75);line-height:1.7}.notes h2{color:#fff}
</style>
