---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import InternshipReadinessPlanner from '../../components/InternshipReadinessPlanner.astro';

const title = 'Internship Readiness Planner | Prepare Evidence and Questions';
const description = 'Build a practical internship-preparation plan around evidence, communication, opportunity checks and safety.';
const canonical = 'https://futurecareerschool.com/tools/internship-readiness-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE PREPARATION TOOL</p><h1>Internship Readiness <span>Planner</span></h1><p class="lead">Turn a vague application into evidence, a specific learning goal, and a safer opportunity check.</p><p class="tool-limits"><b>Boundary:</b> this does not guarantee selection or judge employers. Verify the role, terms, supervisor and safety yourself.</p></section>
    <section class="container tool-shell"><InternshipReadinessPlanner /></section>
    <section class="container tool-explainer"><h2>A credible application needs more than a resume</h2><div class="explainer-grid"><article><h3>Show a sample</h3><p>One truthful, inspectable piece of work is easier to discuss than a long list of certificates.</p></article><article><h3>Name the learning goal</h3><p>Explain what you want to practise and how the opportunity connects to your current evidence.</p></article><article><h3>Check the opportunity</h3><p>Confirm identity, supervision, hours, terms, safety and any request for money or sensitive documents.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
