---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import StudentParentCareerIntake from '../../components/StudentParentCareerIntake.astro';
import ParentStudentAgreement from '../../components/ParentStudentAgreement.astro';

const title = 'Student–Parent Career Guidance Intake | Free Private Worksheet';
const description = 'A free browser-local student–parent career guidance intake that turns different concerns into one evidence-led next step. No sign-up or data upload.';
const pageUrl = 'https://futurecareerschool.com/tools/student-parent-career-intake/';
---

<BaseLayout title={title} description={description} canonical={pageUrl}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote />
  <main>
    <section class="tool-hero container">
      <p class="eyebrow">FREE PRIVATE WORKSHEET</p>
      <h1>Student–Parent <span>Career Guidance Intake</span></h1>
      <p class="lead">Before a career conversation becomes an argument, separate the student’s question from the family’s constraint and agree on one small piece of evidence to collect.</p>
      <p class="tool-limits"><b>Private by design:</b> this worksheet runs in your browser. It does not request names, marks, contact details or family notes, and it does not upload your answers.</p>
    </section>
    <section class="container tool-shell" aria-label="Student and parent intake worksheet">
      <StudentParentCareerIntake />
      <ParentStudentAgreement />
    </section>
    <section class="container tool-explainer">
      <h2>What this intake is-and is not</h2>
      <div class="explainer-grid">
        <article><h3>It helps you prepare</h3><p>Use it to name the decision, the student’s own question, the family concern and the evidence that would make the next conversation fairer.</p></article>
        <article><h3>It does not make the choice</h3><p>The suggested link only points to a relevant next assessment, finder or conversation guide. Check official rules and talk to a qualified person when the decision needs expert advice.</p></article>
        <article><h3>It does not collect research data</h3><p>The browser-local worksheet is not a survey and its entries are not treated as first-party research or shared with counsellors.</p></article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
