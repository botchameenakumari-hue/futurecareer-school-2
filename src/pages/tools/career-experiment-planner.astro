---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import CareerExperimentPlanner from '../../components/CareerExperimentPlanner.astro';

const title = 'Career Experiment Planner | Test a Direction in 30 Days';
const description = 'Build a low-cost career experiment with a concrete output, evidence question, weekly actions and a review decision.';
const canonical = 'https://futurecareerschool.com/tools/career-experiment-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE CAREER EXPERIMENT TOOL</p><h1>Career Experiment <span>Planner</span></h1><p class="lead">Test the work before committing to a course, role or identity.</p><p class="tool-limits"><b>Boundary:</b> this creates a learning test, not a career-fit score, income forecast or placement guarantee.</p></section>
    <section class="container tool-shell"><CareerExperimentPlanner /></section>
    <section class="container tool-explainer"><h2>Use evidence before making an expensive decision</h2><div class="explainer-grid"><article><h3>Make the work visible</h3><p>A concrete output reveals more than a job title or a list of attractive skills.</p></article><article><h3>Keep the test small</h3><p>Choose public, dummy or consented inputs and a scope you can finish without taking an irreversible risk.</p></article><article><h3>Review honestly</h3><p>Interest, friction, feedback and constraints all matter; one experiment is a signal, not a verdict.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
