---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import LifeSkillsWorkbook from '../../components/LifeSkillsWorkbook.astro';
import { WHO_SOURCE } from '../../data/lifeSkillsWorkbook.mjs';

const title = "Life Skills PDF Workbook for Students: 10 WHO Life Skills";
const description = "Free life skills PDF workbook for students. Choose from the 10 WHO life skills, answer reflection questions, follow a 7-day activity and download one PDF.";
const pageUrl = "https://futurecareerschool.com/tools/life-skills-workbook-pdf/";

const faqItems = [
  {
    q: "What are the 10 life skills by the World Health Organisation?",
    a: "The ten core life skills are self-awareness, empathy, critical thinking, creative thinking, decision making, problem solving, effective communication, interpersonal relationship skills, coping with stress and coping with emotions. The workbook above follows this order, with notes, questions, a 7-day activity and a short question-and-answer section for each skill.",
  },
  {
    q: "Is this life skills PDF free, and is my data saved anywhere?",
    a: "The workbook is free and asks for no name, email or phone number. What you type is kept only in this browser on this device, and the PDF is made on your device without any upload. If you use a shared computer, press Clear my answers before you leave.",
  },
  {
    q: "Can I include only some of the skills in the PDF?",
    a: "Yes. Tick the skills you want in Step 1 and only those pages appear on screen, in the PDF and in the printout. You can change the selection later and download again.",
  },
  {
    q: "What is the importance of life skills for students in India?",
    a: "Life skills help with choices that come early, such as stream and course, and with daily work like exams, interviews, group projects and hard talks at home. Marks show what you know, while life skills show how you handle people, choices and pressure. They support every career, but they do not make a career scalable by themselves.",
  },
  {
    q: "Can I use this as life skills notes or as questions and answers for class?",
    a: "The definitions, reasons and short questions and answers are written in our own words, so you can use them as revision notes. Your teacher or board may define a skill differently or ask for set wording, so check your syllabus before you copy anything into an exam answer.",
  },
  {
    q: "How long does the 7-day activity take?",
    a: "Each day is one small step that fits into a normal day, and we do not set a number of hours. If you miss a day, carry on from where you stopped and tick the days as you finish them.",
  },
  {
    q: "Can I write my answers in Telugu or Hindi and still download the PDF?",
    a: "Yes, the PDF keeps Telugu and Hindi letters in their correct shapes by drawing those lines as pictures. That text cannot be selected or copied from the PDF, and a small font file loads only when you press Download PDF with it. Other scripts use the fonts on your device, so check the file or press Print this page and choose Save as PDF.",
  },
  {
    q: "How is this different from the life skills self-assessment?",
    a: "The self-assessment gives a score across five everyday areas, such as organisation, people and boundaries, and digital judgement. This workbook follows the ten WHO life skills, has no score, and asks you to write answers and practise for seven days. Many people take the self-assessment first and use the result to decide which skills to tick here.",
  },
  {
    q: "Does finishing the workbook prove that I have these skills?",
    a: "No. The rating is your own view, and writing an answer is not the same as using a skill with other people. Ask someone you trust for honest feedback after the 7 days and look for one real situation where you used the skill.",
  },
  {
    q: "Is the section on coping with stress medical advice?",
    a: "No, it is general reflection and practice. If stress or low mood is heavy, lasts for weeks or affects sleep and eating, talk to a doctor, a counsellor or a trusted adult. In India you can call the toll-free government helpline Tele-MANAS on 14416 or 1-800-891-4416.",
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Life Skills PDF Workbook for Students',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    inLanguage: 'en-IN',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    publisher: { '@type': 'Organization', name: 'FutureCareerSchool', url: 'https://futurecareerschool.com/' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} jsonLd={jsonLd}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote serviceBanner={true} />
  <main>
    <section class="tool-hero container">
      <p class="eyebrow">FREE PRIVATE WORKBOOK</p>
      <h1>Life Skills PDF Workbook <span>for Students</span></h1>
      <p class="lead">This life skills PDF workbook is a free worksheet where students and young adults pick from the ten core life skills named by the World Health Organization, answer reflection questions on the page and download one combined PDF.</p>
      <p class="lead lead--second">Each skill has a plain definition, notes on why it matters in study and work in India, three questions, one 7-day practice activity and a short question-and-answer section.</p>
      <p class="tool-limits"><b>Private by design:</b> your answers stay in this browser. The workbook asks for no name or contact details and does not upload anything.</p>
      <p class="tool-limits">Want a scored first read on five everyday areas before you start? Take the <a href="/services/assessments/life-skills-self-assessment/">life skills self-assessment</a>. This workbook has no score and follows the ten WHO life skills.</p>
    </section>

    <section class="container tool-shell" aria-label="Life skills workbook">
      <LifeSkillsWorkbook />
    </section>

    <section class="container tool-explainer" id="how-to-use">
      <h2>How to use the workbook</h2>
      <ol class="how-steps">
        <li><b>Choose your skills.</b> Start with two or three that matter most this term, or tick all ten if you want the full set.</li>
        <li><b>Read the notes.</b> The meaning and the India study and work note take a few minutes per skill.</li>
        <li><b>Answer the three questions.</b> Write in your own words. A short honest answer is better than a long polished one.</li>
        <li><b>Start the 7-day practice.</b> Tick each day when you finish it, and note one real moment where you used the skill.</li>
        <li><b>Download or print.</b> The PDF holds exactly what is on screen, so you can keep it, share it with a teacher or parent if you choose, or review it after a month.</li>
      </ol>
      <p>The workbook is for writing and practising. To read longer examples of each skill first, use the <a href="/blog/skills/10-core-life-skills-by-who-examples-and-practice-india/">guide to the 10 core life skills by WHO</a>.</p>
    </section>

    <section class="container tool-explainer" id="who-source">
      <h2>Where the ten life skills come from</h2>
      <p>The World Health Organization describes life skills as "{WHO_SOURCE.definition}".</p>
      <p>The ten skill names in this workbook follow the list that CBSE publishes as laid down by WHO, in its note <a href={WHO_SOURCE.listUrl} rel="noopener noreferrer" target="_blank">Life Skills Education</a>.</p>
      <p>Source for the WHO definition and programme: <a href={WHO_SOURCE.url} rel="noopener noreferrer" target="_blank">WHO, Programme on Mental Health, Life skills education for children and adolescents in schools (WHO/MNH/PSF/93.7A.Rev.2)</a>. The definitions, questions, activities and answers in this workbook are our own wording, not a copy of WHO or CBSE text.</p>
    </section>

    <section class="container tool-explainer" id="growth">
      <h2>Life skills and career growth</h2>
      <p>Life skills are not a career route, so they carry no growth mark of their own. They help in every route, and they count most when you pair them with one skill that someone is willing to pay for.</p>
      <p>When you judge any career you are considering, judge it for growth. Mark it Scalable, Scalable with a business layer or Not so scalable, and write the risk beside the mark.</p>
      <div class="route-card">
        <h3>Route example: teaching life skills to others <span class="scale-tag">Scalable with a business layer</span></h3>
        <p>Workshops or mentoring on these skills for schools, colleges or families can grow into a small service. The payer is usually a school, a college or a family, and they check references, proof from past sessions and whether you can work with their age group.</p>
        <p>The risk is crowding: many trainers offer general talks, so a narrow audience, proof of what changed and a way to find, follow up and earn referrals decide whether anyone pays. Nothing here promises income.</p>
      </div>
    </section>

    <section class="container tool-explainer" id="what-it-is">
      <h2>What the workbook does and does not do</h2>
      <div class="explainer-grid">
        <article><h3>It is a practice sheet</h3><p>It helps you think, write and try small actions on ten skills, and gives you one PDF to keep or print.</p></article>
        <article><h3>It is not a test or a diagnosis</h3><p>Your rating is your own view. It does not measure you against others, predict success or say what you should study.</p></article>
        <article><h3>It does not replace help</h3><p>It is not medical advice. For heavy stress, low mood or a problem at home, talk to a doctor, a counsellor or a trusted adult.</p></article>
      </div>
    </section>

    <section class="container tool-explainer" id="faq">
      <h2>Life skills PDF workbook: questions and answers</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item" open>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tool-hero{padding:2rem 1.25rem 2rem}.tool-hero h1{max-width:850px;overflow-wrap:anywhere}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.lead--second{font-size:1rem}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-limits a,.tool-explainer a{color:#f3cf70;font-weight:700}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem}.tool-explainer:last-of-type{padding-bottom:5rem}.tool-explainer h2{margin-top:0}.tool-explainer p,.tool-explainer li{line-height:1.7;max-width:820px;overflow-wrap:anywhere}.how-steps{padding-left:1.3rem;display:grid;gap:.6rem}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}.route-card{max-width:820px;margin-top:1rem;padding:1rem 1.1rem;border:1px solid rgba(229,184,74,.4);border-radius:14px;background:rgba(229,184,74,.07)}.route-card h3{margin:.1rem 0 .5rem}.scale-tag{display:inline-block;margin-left:.3rem;padding:.15rem .55rem;border-radius:999px;border:1px solid rgba(18,154,141,.6);color:#9ff3e6;font-size:.78rem;font-weight:700;vertical-align:middle}.faq-list{display:grid;gap:.7rem;max-width:820px}.faq-item{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:13px;padding:1.1rem 1.3rem}.faq-item summary{font-size:1rem;font-weight:700;color:#fff;cursor:pointer;list-style:none;overflow-wrap:anywhere}.faq-item summary::-webkit-details-marker{display:none}.faq-item p{margin:.7rem 0 0}@media(max-width:720px){.tool-hero{padding-top:1.5rem}.explainer-grid{grid-template-columns:1fr}.faq-item{padding:1rem}}
</style>
