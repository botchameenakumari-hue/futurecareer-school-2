---
import CareerGuidanceBookletPage from '../../components/CareerGuidanceBookletPage.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import { OFFICIAL, STATE_SITES, STATE_SITES_SEEN_ON } from '../../data/careerGuidanceBooklet.mjs';

const title = 'Career Guidance After 12th PDF: Free Personal Booklet';
const description = 'Free career guidance after 12th PDF you build yourself: pick your stream, marks, budget and priority, then download a booklet or a blank worksheet.';
const pageUrl = 'https://futurecareerschool.com/tools/career-guidance-after-12th-pdf/';

const faqs = [
  {
    q: 'Is there a free career guidance after 12th PDF I can download?',
    a: 'Yes. Choose your stream, marks band, budget band, city type and what matters most, and the page builds a booklet you can download as a PDF with no sign-up. A blank worksheet PDF is also on the page for anyone who wants to fill it in by hand.',
  },
  {
    q: 'What is a career guidance booklet, and what is inside this one?',
    a: 'A career guidance booklet is a short set of pages that helps you compare routes and decide what to check next. This one holds your shortlist of routes with growth marks and risks, a worksheet to compare routes, questions for parents, teachers and counsellors, a 30-day plan and a decision page.',
  },
  {
    q: 'Is this a career guidance book PDF for after 12th, like a printed guide?',
    a: 'It is not a book, and it does not copy one. It is a booklet that is made fresh from your answers, using the routes in our career chart after 12th, so the pages fit your stream instead of listing everything for everyone.',
  },
  {
    q: 'How is this different from the career chart after 12th and its PDFs?',
    a: 'The career chart is a reference: every route for science, commerce and arts in one place, with four fixed PDFs. The booklet is personal: it picks routes for your stream and answers, then adds a worksheet and a plan. Use the chart when you want the full picture, and this booklet when you want to start deciding.',
    link: { href: '/blog/career-options/career-chart-after-12th/', label: 'Open the career chart after 12th' },
  },
  {
    q: 'Will the booklet tell me which career to choose?',
    a: 'No. It does not score you or predict what suits you. It sorts the routes in our chart by the answers you give, shows the risk beside each one and leaves the choice to you and your family.',
  },
  {
    q: 'Does the booklet give exam dates, fees and cut-offs?',
    a: 'No, and that is on purpose. Dates, fees and cut-offs change every year and differ by state and college, so the booklet names the official site to open and leaves boxes for you to write what you find. Always trust the current official notice over any booklet.',
  },
  {
    q: 'What does my marks band change?',
    a: 'It removes no route. If your marks are not out, or are below 60 percent, at least two of your five routes are ones that do not depend on one national rank, and otherwise at least one is. This puts a Plan B on the page early, and it is not a prediction of any seat.',
  },
  {
    q: 'My family already wants one route, such as MBBS or engineering. What happens?',
    a: 'Pick it in the route-in-mind box and it goes to the top of your shortlist with its growth mark, its risk and its checks. You then see it next to other routes your stream can enter, which makes it easier to talk about a second plan.',
  },
  {
    q: 'Can I send my result to my parents on WhatsApp?',
    a: 'Yes. Press Copy my result for WhatsApp, then paste it into any chat, or press Open WhatsApp with my result. The text holds your routes and three dated steps, and it leaves out your name and your worry line.',
  },
  {
    q: 'I live in Andhra Pradesh or Telangana. Does the booklet help with state exams?',
    a: 'It lists the state sites to open for AP EAPCET, TG EAPCET and state health counselling. Dates, ranks and seat lists change every year, so the booklet gives none of them. Open the site, read the current notice and write what you find on the worksheet.',
  },
  {
    q: 'Is my information sent anywhere, and do I have to type my name?',
    a: 'Your answers stay in this browser, and the PDF is made on your own device. The name box is optional and only shows on the cover. If you use a shared computer, press Clear my data before you leave.',
  },
  {
    q: 'Can I print it in black and white, or get a blank worksheet?',
    a: 'Yes. The PDF uses dark text, plain tables and ruled lines, and each growth mark is written in words, so it reads well without colour. Use Download the blank worksheet or Print the blank worksheet for a copy with no personal answers.',
  },
  {
    q: 'Can I type my worry in Telugu or Hindi and still get a PDF?',
    a: 'Yes, the PDF keeps Telugu and Hindi letters in their correct shapes by drawing those lines as pictures. That text cannot be selected or copied from the PDF, and a small font file loads only when you press a PDF button with it. Other scripts use the fonts on your device, so check the file or choose Print and then Save as PDF.',
  },
];

const page = {
  stage: 'after12',
  title, description, pageUrl,
  appName: 'Career Guidance After 12th PDF Booklet Builder',
  breadcrumbLabel: 'Career guidance after 12th PDF',
  eyebrow: 'FREE PERSONAL BOOKLET WITH PDF',
  h1: 'Career Guidance After 12th PDF',
  h1Span: 'free booklet from your answers',
  lead: [
    'This career guidance after 12th PDF is a free booklet you build on this page: choose your stream, marks band, budget band, city type and what matters most, and download a personal shortlist of degree and exam routes with a worksheet and a 30-day plan.',
    'A blank worksheet PDF is also here for paper, and every page prints in black and white. The routes come from our career chart after 12th, so each one carries a growth mark and its risk.',
  ],
  serviceLink: { before: 'Want to talk your shortlist through with a person? Read about', href: '/services/career-counselling-and-career-guidance/career-guidance-after-12th/', label: 'career guidance after 12th', after: '.' },
  stepsTitle: 'How to build your booklet',
  steps: [
    { h: 'Choose your stream', p: 'Pick the stream you studied. The list changes at once, and routes the chart opens only in some colleges are shown in a separate table. Not sure how it works? Press Try an example first.' },
    { h: 'Add marks, budget and place', p: 'Pick the nearest band for each. If your marks are not out, choose Not out yet and come back when they are.' },
    { h: 'Say what matters most', p: 'Choose one priority. If your family already has a route in mind, pick it and it moves to the top with its risk.' },
    { h: 'Read your next three steps', p: 'The result at a glance shows your routes and three steps with dates. Copy it and send it to a parent on WhatsApp.' },
    { h: 'Read the cards and the checks', p: 'Each route shows its growth mark, the risk to read first, the entry route in the chart and the official sites to open.' },
    { h: 'Download or print', p: 'Download your booklet as a PDF or print it. Use the blank worksheet if you would rather write by hand.' },
  ],
  insideTitle: 'What is inside the booklet',
  inside: [
    { h: 'Your next three steps', p: 'Three steps with dates in the next ten days: read one official notice, write the real fee with your parents, and talk to one person.' },
    { h: 'Your shortlist', p: 'Five routes with a growth mark, the risk to read first, a basic sales and marketing step, the length, the entry route and the official sites to open.' },
    { h: 'Other routes for your stream', p: 'A table of every other route your stream can enter, each with its mark, so nothing from the chart is hidden.' },
    { h: 'Route comparison worksheet', p: 'Ruled boxes for the total fee, years, the entry exam and the date of the notice you read, what worries you and your second plan.' },
    { h: 'Questions to ask', p: 'Separate lists for parents, teachers and counsellors, with space for the answers.' },
    { h: '30-day plan', p: 'Four blocks, written by what you finish: narrow the list, check the rules, talk to people, then try one task and decide.' },
    { h: 'Decision page', p: 'The route you choose for now, your second plan, one next step with a date and a review date.' },
  ],
  changesTitle: 'How your answers change the list',
  changesIntro: 'Your answers reorder the booklet. They never delete a route, because routes outside your top five are listed in a table.',
  changes: [
    { h: 'Stream', p: 'It decides which routes appear. This is read from the Who can enter column of our career chart, and routes the chart opens only in some colleges go to a check-college table.' },
    { h: 'Well-known routes', p: 'Up to two routes that most families already talk about for your stream stay on the list with their risk beside them, such as MBBS for PCB or B.Tech for PCM. If your priority is earning sooner or fewer exam hurdles, only the ones that fit are kept.' },
    { h: 'Marks band', p: 'It removes nothing. With marks below 60 percent or not out yet, at least two of your five routes are ones that do not depend on one national rank. With higher marks, at least one is.' },
    { h: 'Budget band', p: 'It sets the money check illustration and flags routes the chart calls costly. It does not change the order.' },
    { h: 'City type', p: 'It changes the questions and the 30-day plan, for example by adding hostel or rent to the cost check for a seat in another city.' },
    { h: 'What matters most', p: 'It sets the order. Start earning sooner uses the shorter end of each length in the chart, steady pay uses chart text that says stable or steady, growth uses the growth mark, and fewer exam hurdles uses the entry route.' },
    { h: 'A route in mind', p: 'It goes first, whatever else you chose.' },
  ],
  marksTitle: 'Every route carries a growth mark and its risk',
  marksIntro: 'Career choices should be judged for growth as well as for status, so each route in the booklet is marked Scalable, Scalable with a business layer or Not so scalable, with the risk beside it.',
  limitsTitle: 'What the booklet does not do',
  limits: [
    { h: 'It does not know dates, fees or cut-offs', p: 'They change every year and differ by state and college. The booklet points to the official site and leaves boxes for you to fill in.' },
    { h: 'It is not a test or a counsellor', p: 'There is no score, and it cannot say what suits you. It sorts routes from our chart by the answers you give.' },
    { h: 'A missing route may still exist', p: 'The shortlist uses the routes in our career chart after 12th. If you have heard of one that is not there, check it on the official site and write it on the worksheet.' },
    { h: 'See a person before you pay', p: 'Talk to a teacher, a school counsellor or the college office if your family cannot agree, if a fee is above a fifth of the budget, or if anyone asks for money to promise a seat. No honest college or agent can promise a seat.' },
    { h: 'Typed text shows in the PDF', p: 'Your name and your worry line appear in the file. Do not type a phone number, email address, ID number or health detail.' },
  ],
  checks: {
    intro: 'Use these four questions and three proofs together on each route before you pay a fee or lock a choice.',
    questions: [
      { h: 'Your fit', p: 'Can you do the first-year work of this degree day after day, not only like the job title? Try a chapter or a small task from year one before you apply.' },
      { h: 'Your situation', p: 'Write the total fee, the years, who will pay and what happens if the seat is in another city. A route that fits on paper can fail on money.' },
      { h: 'Job market', p: 'Open current job listings for the roles this degree leads to and write what they ask for. Note the site and the date you looked.' },
      { h: 'AI-proof', p: 'Ask which tasks in this field software already does. Subject knowledge with communication and judgement lasts longer than routine work.' },
    ],
    proofs: [
      { h: 'Show it', p: 'Finish one small real task that looks like the work, such as a spreadsheet for a shop, a design piece, a short lab write-up or a mock case, and keep it.' },
      { h: 'Say it', p: 'Explain in a minute why this route fits you, what it costs and what your second plan is. If you cannot, the shortlist needs more work.' },
      { h: 'Get it checked', p: 'Show the worksheet to a teacher or to someone who works in the field, and ask what they would check first.' },
    ],
  },
  moneyLead: 'A degree fee is the biggest cost in this choice, so check the money before you fall for a college name.',
  moneySafety: 'This is general information, not financial advice. Get every fee and every loan term in writing, and apply only on the official website, because nobody can sell you a guaranteed seat.',
  chartBox: {
    h: 'Want the full chart and its PDFs?',
    p: 'Our career chart after 12th lists every route for science, commerce and arts in one place, with seat odds, fee examples and dates, and has four fixed PDFs to download. This booklet builder is the personal version: it picks from the same routes for your answers.',
    href: '/blog/career-options/career-chart-after-12th/',
    label: 'Open the career chart after 12th',
  },
  faqTitle: 'Career guidance after 12th PDF: common questions',
  faqs,
  sourcesIntro: 'Route names, entry routes, lengths and risks come from our career chart after 12th. The official sites below are where you confirm every rule, date and fee.',
  sources: [
    { label: 'FutureCareerSchool career chart after 12th', url: 'https://futurecareerschool.com/blog/career-options/career-chart-after-12th/', supports: 'The routes, who can enter, entry routes, lengths, risks and growth marks used in the booklet. Last updated by us in October 2026.' },
    ...['nta', 'cuet', 'josaa', 'clat', 'icai', 'upsc', 'nchm'].map((k) => OFFICIAL[k]),
    ...STATE_SITES.map((x) => ({ label: x.label, url: x.url, supports: x.supports, checked: STATE_SITES_SEEN_ON + (x.status === 'opened' ? ', page opened' : ', address seen in search results, page not opened') })),
  ],
  sourcesNote: 'Rules change. Where an official notice differs from the booklet, the notice is right. The booklet states no exam dates, fees or pay figures.',
  related: [
    { href: '/services/assessments/stream-selector-test-after-12th/', label: 'Stream selector test after 12th', why: 'a short test to read before you rank routes.' },
    { href: '/tools/course-entrance-exam-finder/', label: 'Course entrance exam finder', why: 'find the entrance exam behind a course you shortlisted.' },
    { href: '/tools/education-cost-payback-planner/', label: 'Education cost and payback planner', why: 'put your own fee figures through a stress test.' },
    { href: '/tools/student-parent-career-intake/', label: 'Student and parent career intake', why: 'put the student view and the family view side by side.' },
    { href: '/tools/career-counselling-form/', label: 'Career counselling form', why: 'prepare one question for a counselling session.' },
  ],
};
---

<CareerGuidanceBookletPage page={page}>
  <BusinessPerspectiveNote slot="note" serviceBanner={true} />
</CareerGuidanceBookletPage>
