---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import InformationalInterviewPlanner from '../../components/InformationalInterviewPlanner.astro';

const title = 'Informational Interview Planner | Research a Career Before Committing';
const description = 'Prepare a respectful informational interview, ask better career questions and turn what you learn into a small next experiment.';
const canonical = 'https://futurecareerschool.com/tools/informational-interview-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE CAREER RESEARCH TOOL</p><h1>Informational Interview <span>Planner</span></h1><p class="lead">Learn what the work is actually like before paying for a course, choosing a route or changing direction.</p><p class="tool-limits"><b>Boundary:</b> one person’s experience is not a universal rule. Verify eligibility, costs and current requirements from official sources.</p></section>
    <section class="container tool-shell"><InformationalInterviewPlanner /></section>
    <section class="container tool-explainer"><h2>Use conversations as evidence, not permission</h2><div class="explainer-grid"><article><h3>Ask about the work</h3><p>Explore the ordinary tasks, constraints and trade-offs behind a job title.</p></article><article><h3>Protect the person’s time</h3><p>Make a small, specific request and never ask for confidential information.</p></article><article><h3>Run a next test</h3><p>Turn one insight into a small task or source check before making a costly commitment.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
