---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import ResumeEvidenceBuilder from '../../components/ResumeEvidenceBuilder.astro';

const title = 'Resume Skills Evidence Builder | Free Private Tool';
const description = 'Build a truthful resume bullet from one real skill example, with a private browser-local worksheet and no invented numbers.';
const canonical = 'https://futurecareerschool.com/tools/resume-skills-evidence-builder/';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav />
  <BusinessPerspectiveNote />
  <main class="tool-page"><div class="tool-shell">
    <p class="eyebrow">PRIVATE SKILL-EVIDENCE TOOL</p>
    <h1>Turn a real skill into <span>resume evidence</span></h1>
    <p class="lead">A resume should show what you did, where you did it and what changed—not just repeat “hardworking” or “good communication.” Build one defensible example at a time.</p>
    <ResumeEvidenceBuilder />
    <section class="tool-notes"><h2>Use the bullet as a draft, not a fact generator</h2><p>Read the bullet aloud and remove anything you could not explain in an interview. Keep the file, link, feedback or process note that supports it. If you have no measured result, describe the concrete change without inventing a percentage.</p><p><a href="/services/assessments/skill-portfolio-tracker/">Track the skill and proof project</a> · <a href="/services/assessments/interview-readiness-self-assessment/">Practise explaining the example</a></p></section>
  </div></main>
  <Footer />
</BaseLayout>

<style>
  .tool-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(229,184,74,.12),transparent 35%),#080c18}.tool-shell{max-width:1080px;margin:0 auto}.tool-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.tool-page h1 span{color:#e5b84a}.lead{max-width:800px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.tool-notes{margin-top:2rem;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:16px;color:rgba(255,255,255,.75);line-height:1.7}.tool-notes h2{color:#fff}.tool-notes a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}
</style>
