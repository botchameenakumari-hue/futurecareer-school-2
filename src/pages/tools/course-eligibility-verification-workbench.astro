---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CourseEligibilityVerificationWorkbench from '../../components/CourseEligibilityVerificationWorkbench.astro';
import { COURSE_FINDER_VERIFICATION_QUEUE } from '../../config/courseEligibilityFinder';
const title = 'Course Eligibility Verification Workbench | Future Career School';
const description = 'Prepare browser-local evidence packets for course and entrance-rule review. This tool does not verify or publish admission data.';
const canonical = 'https://futurecareerschool.com/tools/course-eligibility-verification-workbench/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main><section class="tool-hero container"><p class="eyebrow">EDITORIAL REVIEW TOOL · NOT ADMISSION DATA</p><h1>Course eligibility <span>verification workbench</span></h1><p class="lead">Prepare a review packet for one of the 15 queued course routes: capture the exact notice, reviewer, date, checked fields and unresolved conflicts before anyone considers a definitive claim.</p><p class="tool-limits"><b>Private by design:</b> drafts stay in this browser unless you export them. This tool does not verify sources, change the finder or publish a record.</p></section><section class="container tool-shell"><CourseEligibilityVerificationWorkbench queue={COURSE_FINDER_VERIFICATION_QUEUE} /></section><section class="container tool-explainer"><h2>Publication gate</h2><p>A draft is not evidence. The course finder remains source-mapped editorial content until each material rule is checked against the current authority or institute notice by a named reviewer. See the <a href="/data-policy/">data policy</a>.</p></section></main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:780px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:780px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1100px}.tool-explainer{padding:2rem 1.25rem 5rem;max-width:1000px}.tool-explainer h2{margin-top:0}.tool-explainer p{line-height:1.7}.tool-explainer a{color:#0b8579;text-decoration:underline}
</style>
