---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StudyAbroadReadinessPlanner from '../../components/StudyAbroadReadinessPlanner.astro';

const title = 'Study Abroad Readiness Planner | Verify the Full Route';
const description = 'Plan a study-abroad decision around official sources, total cost, visa conditions, support and a backup or return route.';
const canonical = 'https://futurecareerschool.com/tools/study-abroad-readiness-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE STUDY-ABROAD PLANNER</p><h1>Study Abroad Readiness <span>Planner</span></h1><p class="lead">Evaluate the whole decision—not only the university offer or the destination’s marketing.</p><p class="tool-limits"><b>Boundary:</b> this does not verify admission, visa, employment, migration or costs. Use current official sources.</p></section>
    <section class="container tool-shell"><StudyAbroadReadinessPlanner /></section>
    <section class="container tool-explainer"><h2>Make an international study decision reviewable</h2><div class="explainer-grid"><article><h3>Verify the route</h3><p>Separate institution claims from current government, regulator and visa conditions.</p></article><article><h3>Map the full cost</h3><p>Include deposits, living, travel, insurance, currency movement and a contingency—not only tuition.</p></article><article><h3>Keep a backup</h3><p>A return, lower-cost or staged route protects the decision if funding or work assumptions change.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
