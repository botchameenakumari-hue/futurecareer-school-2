---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CareerDecisionJournal from '../../components/CareerDecisionJournal.astro';

const title = 'Career Decision Journal | Private Career Experiment Worksheet';
const description = 'A private browser-local career decision journal for recording a hypothesis, running a small experiment and reviewing evidence.';
const canonical = 'https://futurecareerschool.com/tools/career-decision-journal/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container">
      <p class="eyebrow">FREE PRIVATE DECISION TOOL</p>
      <h1>Career Decision <span>Journal</span></h1>
      <p class="lead">Turn a vague career worry into a hypothesis, one small test, and a dated review.</p>
      <p class="tool-limits"><b>Important:</b> this is a reflection and planning worksheet. It does not predict suitability, validate your skills, or replace official eligibility and financial checks.</p>
    </section>
    <section class="container tool-shell"><CareerDecisionJournal /></section>
    <section class="container tool-explainer"><h2>Use the journal responsibly</h2><div class="explainer-grid"><article><h3>Test daily work</h3><p>Choose an output someone can inspect, not only more reading or a personality label.</p></article><article><h3>Record limits</h3><p>A short experiment can reveal useful friction, but it cannot prove long-term fit or income.</p></article><article><h3>Protect sensitive information</h3><p>Do not enter health, financial, employer-confidential or identifying information.</p></article></div></section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
