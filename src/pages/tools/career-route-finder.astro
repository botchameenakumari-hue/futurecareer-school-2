---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CareerRouteFinder from '../../components/CareerRouteFinder.astro';
import { CAREER_CATALOGUE_META, CAREER_ROUTE_RECORDS } from '../../config/careerRouteDataset';

const title = 'Career Route Finder | Search Career Paths by Work and Skills';
const description = 'Search an editorial catalogue of career routes by work, skills, stage and entry route. Compare starting points without a generic career ranking.';
const canonical = 'https://futurecareerschool.com/tools/career-route-finder/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav />
  <main class="crf-page"><div class="crf-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-skills-compass/">Career &amp; Skills Compass</a><span aria-hidden="true">›</span><span aria-current="page">Career route finder</span></nav>
    <p class="eyebrow">{CAREER_ROUTE_RECORDS.length} editorial route records · no sign-up</p>
    <h1>Find career routes worth investigating</h1>
    <p class="lead">Search for the kind of work you want to test, then compare a few possible routes. This is a starting-point finder, not a “best career” verdict and not a live job or salary database.</p>
    <CareerRouteFinder routes={CAREER_ROUTE_RECORDS} />
    <section class="notes"><h2>How to use the shortlist</h2><ol><li>Pick two or three routes that describe the work, not just an attractive title.</li><li>Read the entry route and regulation note before paying for a course.</li><li>Run the suggested first test and record what you enjoyed, avoided and could improve.</li></ol><p><a href="/career-skills-compass/transition/">Use the broader career-transition route</a> · <a href="/datasets/career-route-catalogue-2026/">Inspect the catalogue and provenance</a> · <a href="/data-policy/">Read the data policy</a></p><p class="source-note">{CAREER_CATALOGUE_META.provenance} {CAREER_CATALOGUE_META.disclaimer}</p></section>
  </div></main>
  <Footer />
</BaseLayout>
<style>
  .crf-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.crf-shell{max-width:1240px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.notes a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.eyebrow{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.crf-page h1{max-width:850px;font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff;line-height:1.05}.lead{max-width:850px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.notes{margin-top:2rem;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:16px;color:rgba(255,255,255,.75);line-height:1.7}.notes h2{color:#fff}.notes li+li{margin-top:.45rem}.source-note{font-size:.82rem;color:rgba(255,255,255,.52)}
</style>
