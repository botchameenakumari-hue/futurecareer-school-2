---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ScholarshipApplicationPlanner from '../../components/ScholarshipApplicationPlanner.astro';

const title = 'Scholarship Application Planner | Verify Funding and Documents';
const description = 'Create a scholarship application checklist for eligibility, official sources, documents, deadlines and remaining funding needs.';
const canonical = 'https://futurecareerschool.com/tools/scholarship-application-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE FUNDING PLANNER</p><h1>Scholarship Application <span>Planner</span></h1><p class="lead">Prepare the evidence and documents before a funding deadline—not after an agent’s promise.</p><p class="tool-limits"><b>Boundary:</b> this does not list or verify scholarships and cannot predict an award. Use the current official scheme notice.</p></section>
    <section class="container tool-shell"><ScholarshipApplicationPlanner /></section>
    <section class="container tool-explainer"><h2>Keep funding decisions evidence-led</h2><div class="explainer-grid"><article><h3>Verify the scheme</h3><p>Save the issuing body, current notice, deadline, eligibility and correction process from an official source.</p></article><article><h3>Prepare readable proof</h3><p>Match every criterion to a document and keep copies of what you submit.</p></article><article><h3>Plan the gap</h3><p>Do not commit to a course assuming an award is guaranteed, renewed, or enough to cover the full cost.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
