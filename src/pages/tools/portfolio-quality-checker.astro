---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PortfolioQualityChecker from '../../components/PortfolioQualityChecker.astro';

const title = 'Portfolio Quality Checker | Find Missing Career Evidence';
const description = 'Check whether your portfolio explains context, process, artifacts, feedback, outcomes and limitations clearly.';
const canonical = 'https://futurecareerschool.com/tools/portfolio-quality-checker/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE PORTFOLIO CHECKER</p><h1>Portfolio Quality <span>Checker</span></h1><p class="lead">Replace “I have projects” with proof another person can understand and inspect.</p><p class="tool-limits"><b>Boundary:</b> this checks how clearly work is presented. It does not judge talent, predict hiring, or validate the work.</p></section>
    <section class="container tool-shell"><PortfolioQualityChecker /></section>
    <section class="container tool-explainer"><h2>What a useful case study shows</h2><div class="explainer-grid"><article><h3>Context</h3><p>Who had the problem, what was the goal, and what constraints shaped the work?</p></article><article><h3>Decisions</h3><p>What did you try, change, reject, and learn during the process?</p></article><article><h3>Evidence</h3><p>What can a reader inspect, who gave feedback, and what remains uncertain?</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
