---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CourseCostPlanner from '../../components/CourseCostPlanner.astro';

const title = 'Course Cost Planner | Estimate Tuition and Full Education Cost';
const description = 'Estimate tuition, recurring living costs, setup costs and the funding gap before committing to a course or college.';
const canonical = 'https://futurecareerschool.com/tools/course-cost-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE PLANNING CALCULATOR</p><h1>Course Cost <span>Planner</span></h1><p class="lead">See the full cost before you enrol—not only the tuition number shown in a brochure.</p><p class="tool-limits"><b>Boundary:</b> this uses only your assumptions. It is not a provider quote, loan calculator or promise about affordability.</p></section>
    <section class="container tool-shell"><CourseCostPlanner /></section>
    <section class="container tool-explainer"><h2>Use it before paying</h2><div class="explainer-grid"><article><h3>Collect the real inputs</h3><p>Use a current fee notice and ask about hostel, transport, exams, equipment, refund rules and mandatory extras.</p></article><article><h3>Keep uncertain money separate</h3><p>Do not count an unconfirmed scholarship, future salary or hoped-for part-time income as guaranteed funding.</p></article><article><h3>Compare the route</h3><p>Run the same assumptions for a lower-cost alternative and record what evidence justifies the difference.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
