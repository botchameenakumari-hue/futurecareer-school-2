---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import StudyTimetableMaker from '../../components/StudyTimetableMaker.astro';
import { SCALE, SCALE_RULE } from '../../config/scalability.mjs';

const title = 'Study Timetable Maker: Free Planner with PDF and Print';
const description = 'Free study timetable maker for students. Add subjects, exam dates and school hours, then edit a weekly grid and daily plan, print it or save a PDF.';
const pageUrl = 'https://futurecareerschool.com/tools/study-timetable-maker/';

const steps = [
  { h: 'List your subjects', p: 'Type each subject, then pick how confident you are (1 to 5) and how much it counts (1 to 5). Add an exam date for a subject only if it differs from the last exam date.' },
  { h: 'Set the dates', p: 'Choose a start date and your last exam date. Copy exam dates from your official date sheet, and make the timetable again if the dates change.' },
  { h: 'Enter your week', p: 'Set wake-up time, bedtime and the study hours you can really give on weekdays and weekends. Add school, tuition, meals and sport as fixed blocks so nothing is planned on top of them.' },
  { h: 'Choose how you study', p: 'Pick a session length, a break length, your spaced revision gaps, a rest day and a mock-test day. Press Make my timetable.' },
  { h: 'Edit, tick off, print', p: 'Press any session to change its subject, day or time, or delete it. Tick sessions as you finish them, then download the PDF or print the weekly grids.' },
];

const rules = [
  { h: 'Free time', p: 'Your free time is the gap between waking and bedtime, minus every fixed block. Sleep and fixed blocks are never used for study.' },
  { h: 'Time for each subject', p: 'Each subject gets a priority: (6 minus confidence) plus how much it counts. Study time is shared in that proportion among the subjects whose exam is still ahead, and a subject with an exam within 7 days counts double. While other subjects are waiting, one subject gets at most two sessions a day.' },
  { h: 'Spaced revision', p: 'After a study session, short revision passes are placed on the gap days you choose, 1, 3 and 7 days later by default. Each pass is a quarter of the time you studied that subject that day, from 15 to 45 minutes. If a gap lands on a rest or catch-up day, the pass moves to the next study day.' },
  { h: 'Final revision', p: 'In the last days before each subject\'s exam, its sessions turn into final revision instead of new study. That is about a fifth of the days before the exam, at least 2 and at most 7 days. With 4 to 7 days left it is 1 day, and with fewer than 4 days there is none.' },
  { h: 'Rest, catch-up and mock days', p: 'Plans of 8 days or more keep your weekly rest day empty. Plans of 10 days or more get one empty catch-up day for every 14 days, for anything you missed. Plans of 14 days or more get a weekly mock test from day 8, with a review of about a third of the test length.' },
  { h: 'Exam days', p: 'On an exam day the planner uses only the hours and start time you set, so you can study for the next paper. It never plans a session for a subject on or after its own exam day.' },
];

const limits = [
  'It does not know your syllabus, your teachers or your exam pattern. You decide what to study in each session, and you can type a short note on any session.',
  'It does not predict marks or rank. Confidence and importance are your own judgments, and the timetable is only as good as they are.',
  'It does not know your exam dates. Copy them from your official notice, and check the notice again before you rely on a date.',
  'It plans up to 12 subjects, up to 120 days and up to 10 study hours a day. For a longer plan, make a second one after the first.',
  'It does not replace sleep, meals, movement or a day off. The planner refuses a sleep window shorter than your minimum.',
  'It is not medical or counselling advice. It cannot tell you whether you are coping well.',
];

const differences = [
  { h: 'This planner', p: 'It builds a dated plan from your subjects, exam dates and free hours, and gives you something to print or save.' },
  { h: 'Study habits self-assessment', p: 'It asks about how you plan, focus, learn, revise and rest, and shows which habit to fix first. Take it before you plan if you are not sure why your last timetable failed.', href: '/services/assessments/study-habits-self-assessment/', label: 'Take the study habits self-assessment' },
  { h: 'Time management self-assessment', p: 'It looks at how you use time in general, not only for exams. Take it after a few weeks of following a timetable to see what changed.', href: '/services/assessments/time-management-self-assessment/', label: 'Take the time management self-assessment' },
];

const marks = [
  { mark: SCALE.high.label, meaning: 'Income and reach can grow through skills, proof of work and paid projects, not only through hours worked.', risk: 'It needs steady learning and visible proof. A title or certificate alone does not make an option scalable.', step: 'Name who pays, how they find and trust you, one piece of proof and a simple follow-up habit.' },
  { mark: SCALE.mid.label, meaning: 'A job or degree is the way in, and a consulting practice, studio, clinic, agency or product on top can make it scalable. Engineering through JEE is an example.', risk: 'The entrance ladder is crowded, and a branch degree alone is not scalable. Without a business layer, growth stays tied to one employer or to your hours.', step: 'Plan the business layer early: who would pay, how they would find and trust you, and what proof you can show.' },
  { mark: SCALE.low.label, meaning: 'Growth is capped by seats, hours or a single employer. MBBS and BDS through NEET are examples, along with NDA, government exams, integrated law, pilot training, merchant navy and pure research.', risk: 'Competition at several levels, few seats, many years before pay grows, and few people reaching the top. Effort alone does not guarantee a result.', step: 'Write a second route and keep a skill running that can grow on its own.' },
];

const sources = [
  { name: 'US Centers for Disease Control and Prevention, sleep and health pages', url: 'https://www.cdc.gov/healthy-schools/sleep/', supports: 'Recommended hours of sleep differ by age, so the planner lets you set your own minimum and refuses a window below it. The planner\'s default of 8 hours is our choice, not a figure from this source.', status: 'Appeared in a web search on 22 November 2026. We did not open the page, so check the age ranges there yourself.' },
  { name: 'Dunlosky and others (2013), Improving Students\' Learning With Effective Learning Techniques, Psychological Science in the Public Interest, volume 14, issue 1', url: 'https://journals.sagepub.com/doi/10.1177/1529100612453266', supports: 'The general finding that spreading study over several days and testing yourself are useful study methods, which is why the planner adds spaced revision. The 1, 3, 7 gaps are a common habit and are not taken from this paper.', status: 'The paper appeared in a web search on 22 November 2026 (a copy of the journal page was listed). We did not open it, so read it before you quote it.' },
  { name: 'Tele-MANAS, Ministry of Health and Family Welfare', url: 'https://telemanas.mohfw.gov.in/', supports: 'Tele-MANAS (14416) as a free national mental health helpline run by the health ministry. Other pages on this site give the same line.', status: 'Appeared in a web search on 22 November 2026 and is already linked from other pages here. We did not open it for this page, so confirm the number there.' },
  { name: 'National Testing Agency (NTA)', url: 'https://nta.ac.in/', supports: 'Where national entrance tests such as JEE Main and NEET UG publish official notices and dates. Your school board has its own official website for its date sheet.', status: 'Linked from other pages on this site. We did not open it for this page, so check dates there before you enter them.' },
];

const faqs = [
  { q: 'What is a study timetable maker?', a: 'A study timetable maker is a tool that turns your subjects, exam dates and free hours into a plan of study sessions. This one gives you a weekly grid and a day-by-day plan that avoid your school, tuition and meal times, and that you can edit, print or save as a PDF.' },
  { q: 'How do I make a study timetable for my exams with this planner?', a: 'List your subjects with how confident you are and how much each counts, set your start date and last exam date, and enter your wake-up time, bedtime, study hours and fixed blocks. Then press Make my timetable. You can press any session afterwards to change it.' },
  { q: 'Is it free, and is my information sent anywhere?', a: 'It is free to use. Your entries and your timetable stay in this browser, the PDF is built on your own device and nothing is sent to this site. Press Clear my data when you finish on a shared computer.' },
  { q: 'How does it decide how much time each subject gets?', a: 'Each subject gets a priority: (6 minus confidence) plus how much it counts. Study time is shared in that proportion, so a weak subject that counts for a lot gets the most. The hours table under your timetable shows the result for each subject.' },
  { q: 'What is spaced revision, and what do the 1, 3, 7 gaps mean?', a: 'Spaced revision means coming back to a topic after a pause instead of studying it once. With gaps of 1, 3 and 7, a short revision pass is placed 1, 3 and 7 days after you studied a subject. These gaps are a common habit and not a proven best schedule, so you can type your own, such as 2, 5, 10, or leave the box empty.' },
  { q: 'Can I make a board exam study timetable as a PDF?', a: 'Yes. Enter your exam dates from your official date sheet, make the timetable and press Download PDF. You get an A4 landscape file with a summary page, one weekly grid for each week and a day-by-day list with tick boxes.' },
  { q: 'Can I use it for a daily study timetable for class 10, class 12, NEET or JEE?', a: 'Yes, because you enter your own subjects, dates and hours. The planner does not know any exam pattern, syllabus or date, so copy dates from your official notice and decide what to study in each session. For national tests, the National Testing Agency website lists notices.' },
  { q: 'How many hours a day should I study?', a: 'There is no official number that suits everyone. The planner lets you set up to 10 hours a day, shows a gentle note above 8 hours, and never plans inside the sleep time you protect. If you feel worn out, lower the hours and talk to a teacher, parent or counsellor.' },
  { q: 'Can I change the timetable after it is made?', a: 'Yes. Press a session in the grid or Edit in the day list to change its subject, day or time, add a note, tick it done or delete it. On a computer you can also drag a session to another day. Making the timetable again replaces your edits, and the page asks before it does.' },
  { q: 'What if it says there is not enough time?', a: 'That means your exam dates, study hours, fixed blocks and rest day leave too little free time for your subjects. Add study hours, free up a fixed block, change the rest day or move the start date earlier, then make the timetable again.' },
  { q: 'Can I type subject names in Telugu or Hindi?', a: 'Yes, you can type in any language, and the PDF keeps Telugu and Hindi letters in their correct shapes by drawing those names as pictures. That text cannot be selected or copied from the PDF, and a small font file loads only when you press the download button with it. Other scripts use the fonts on your device, so check the file or choose Print and then Save as PDF.' },
  { q: 'How is this different from the study habits and time management tests?', a: 'Those tests ask questions about your habits and give you scores. This planner builds a dated timetable you can follow, print and tick off. Take the study habits self-assessment to find which habit to fix first, then use this planner to act on it.', link: { href: '/services/assessments/study-habits-self-assessment/', label: 'Open the study habits self-assessment' } },
  { q: 'Can I print a weekly study planner?', a: 'Yes. Press Print and choose A4 landscape if your printer asks. The printout holds only your timetable: a summary page, one weekly grid for each week and the day-by-day list.' },
  { q: 'Can a teacher or parent use it?', a: 'Yes, for one student at a time. Sit with the student, enter the subjects and fixed blocks together, and let the student choose the confidence marks. Nothing is stored on our side, so keep the PDF if you want a copy.', link: { href: '/tools/student-mentoring-form-and-report/', label: 'Open the student mentoring form and report' } },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Study Timetable Maker',
    description,
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any modern web browser',
    isAccessibleForFree: true,
    inLanguage: 'en-IN',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    publisher: { '@type': 'Organization', name: 'FutureCareerSchool', url: 'https://futurecareerschool.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://futurecareerschool.com/' },
      { '@type': 'ListItem', position: 2, name: 'Career resources', item: 'https://futurecareerschool.com/career-resources/' },
      { '@type': 'ListItem', position: 3, name: 'Study timetable maker', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} jsonLd={jsonLd}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote serviceBanner={true} />
  <main>
    <section class="tool-hero container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Study timetable maker</span></nav>
      <p class="eyebrow">FREE PRIVATE PLANNER WITH PDF</p>
      <h1>Study Timetable Maker <span>with weekly grid, revision days and PDF</span></h1>
      <p class="lead">This study timetable maker turns your subjects, exam dates and free hours into a weekly grid and a day-by-day plan that you can edit, print or download as a PDF. Weaker and heavier subjects get more time, and your school, tuition and meal times stay clear.</p>
      <p class="lead lead--small">Not sure which subjects to push, or what comes after the exams? A <a href="/services/career-counselling-and-career-guidance/career-counselling-for-school-students/">career counsellor for school students</a> can help you decide.</p>
      <p class="tool-jump"><a href="#stm-tool">Start the planner</a><a href="#how-to-use">How to use it</a><a href="#faq">Questions</a></p>
      <p class="tool-limits"><b>Private by design:</b> it runs in your browser, asks for no name or contact details and uploads nothing.</p>
    </section>

    <section class="container tool-shell" aria-label="Study timetable maker">
      <StudyTimetableMaker />
    </section>

    <section class="container tool-section" id="how-to-use">
      <h2>How to use the timetable maker</h2>
      <ol class="step-grid">
        {steps.map((s) => (<li><h3>{s.h}</h3><p>{s.p}</p></li>))}
      </ol>
    </section>

    <section class="container tool-section" id="how-it-works">
      <h2>How the timetable is made</h2>
      <p>These are the planner's own rules, written out so you can check them. They are not exam rules.</p>
      <div class="explainer-grid">
        {rules.map((r) => (<article><h3>{r.h}</h3><p>{r.p}</p></article>))}
      </div>
    </section>

    <section class="container tool-section" id="limits">
      <h2>What the planner does not do</h2>
      <ul class="plain-list">
        {limits.map((l) => (<li>{l}</li>))}
      </ul>
    </section>

    <section class="container tool-section" id="exam-stages">
      <h2>Class 10, class 12, NEET and JEE: what to enter</h2>
      <p>The planner has no built-in exam facts, so it fits any board or entrance test. Enter the subjects or papers you study, the dates from your official notice and the hours you can truly give.</p>
      <p>Mark confidence honestly: 1 for a subject that scares you, 5 for one you could teach. For how much a subject counts, use the share of marks or the number of chapters it carries, as you understand them from your own syllabus.</p>
      <p>If you are preparing for an entrance test beside school, add its subjects as separate rows and give the hours you can spare on weekdays and weekends. Use the mock-test day for full timed papers.</p>
    </section>

    <section class="container tool-section" id="next-steps">
      <h2>Habits come first, then the plan</h2>
      <div class="explainer-grid">
        {differences.map((d) => (<article><h3>{d.h}</h3><p>{d.p}</p>{d.href && <p><a href={d.href}>{d.label}</a></p>}</article>))}
      </div>
      <p>If exam pressure is making sleep, food or mood worse, use the <a href="/services/assessments/exam-stress-self-assessment/">exam stress self-assessment</a>. For study methods that work beyond timetables, read the guide to <a href="/blog/skills/study-skills-for-students-how-to-improve-india/">study skills for students</a>.</p>
    </section>

    <section class="container tool-section" id="care">
      <h2>Look after yourself while you study</h2>
      <p>The planner keeps your sleep window free and shows a gentle note when a day gets long. It cannot see how you feel, so tell a teacher, parent or counsellor if the plan is too heavy.</p>
      <p>If exam worry feels too big, Tele-MANAS (14416) is a free national mental health helpline run by the health ministry. This is not medical advice; talk to a doctor or counsellor.</p>
    </section>

    <section class="container tool-section" id="growth-marks">
      <h2>Keep time for a skill beside your exams</h2>
      <p>A timetable full of exam subjects can leave no room to build a skill that grows. Add one subject row called, for example, Coding practice or Drawing practice, and give it a confidence and a weight like any other subject.</p>
      <p>{SCALE_RULE}</p>
      <div class="marks-wrap">
        <table class="marks-table">
          <thead><tr><th scope="col">Mark</th><th scope="col">What it means</th><th scope="col">Risk to write down</th><th scope="col">Basic sales and marketing step</th></tr></thead>
          <tbody>
            {marks.map((m) => (<tr><td data-label="Mark"><b>{m.mark}</b></td><td data-label="What it means">{m.meaning}</td><td data-label="Risk to write down">{m.risk}</td><td data-label="Basic sales and marketing step">{m.step}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p>The marks describe a route, not a student, and none of them promises a result or an income.</p>
    </section>

    <section class="container tool-section" id="sources">
      <h2>Sources and what they support</h2>
      <p>We name each source and say plainly whether we opened it. Where we did not, check the page yourself before you rely on it.</p>
      <ul class="source-list">
        {sources.map((s) => (
          <li>
            <b>{s.name}</b><br />
            <a href={s.url} target="_blank" rel="noopener noreferrer">{s.url}</a><br />
            <span><b>Supports:</b> {s.supports}</span><br />
            <span><b>Status:</b> {s.status}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="container tool-section" id="faq">
      <h2>Study timetable maker: common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" open>
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tool-hero{max-width:1050px;padding:2rem 1.25rem 1rem}
  .tool-hero h1{max-width:850px;overflow-wrap:anywhere}.tool-hero h1 span{color:var(--gold,#e5b84a)}
  .breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.7);font-size:.85rem;margin-bottom:1.2rem}.breadcrumb a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}
  .lead{max-width:780px;font-size:1.05rem;line-height:1.6}.lead--small{font-size:.95rem}.lead a{color:#f3cf70;font-weight:700}
  .tool-jump{display:flex;flex-wrap:wrap;gap:.5rem;margin:.9rem 0}.tool-jump a{display:inline-flex;align-items:center;min-height:44px;padding:.4rem .9rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;color:#f3cf70;font-weight:700;text-decoration:none}.tool-jump a:focus-visible{outline:3px solid #e5b84a;outline-offset:2px}
  .tool-limits{max-width:780px;font-size:.9rem;line-height:1.6;color:var(--muted,#c3cbca)}
  .tool-shell{max-width:1050px}
  .tool-section{max-width:1050px;padding:1.5rem 1.25rem;scroll-margin-top:90px}.tool-section h2{margin-top:0}.tool-section p,.tool-section li{line-height:1.7;max-width:820px}
  .tool-section a{color:#f3cf70;font-weight:700}
  .step-grid{list-style:none;margin:1rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:1rem;counter-reset:step}
  .step-grid li{counter-increment:step;padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}
  .step-grid li::before{content:counter(step);display:inline-grid;place-items:center;width:1.9rem;height:1.9rem;margin-bottom:.4rem;border-radius:50%;background:#0b766d;color:#fff;font-weight:800}
  .step-grid h3{margin:.1rem 0 .3rem}.step-grid p{margin:0}
  .explainer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem}
  .explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}.explainer-grid p{margin-bottom:.4rem;line-height:1.65}
  .plain-list{padding-left:1.2rem}.plain-list li{margin-bottom:.5rem}
  .marks-wrap{margin:1rem 0;max-width:100%}
  .marks-table{width:100%;border-collapse:collapse;font-size:.92rem}
  .marks-table th,.marks-table td{padding:.7rem;border:1px solid rgba(255,255,255,.2);text-align:left;vertical-align:top;line-height:1.55}
  .marks-table th{background:rgba(18,154,141,.22)}
  .source-list{list-style:none;margin:1rem 0 0;padding:0;display:grid;gap:.8rem}
  .source-list li{padding:.8rem 1rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;max-width:none;overflow-wrap:anywhere}
  .faq-list{display:grid;gap:.7rem;margin-top:1rem;padding-bottom:3rem}
  .faq-item{padding:.8rem 1rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.03)}
  .faq-item summary{cursor:pointer;font-weight:700;line-height:1.5;min-height:44px;display:flex;align-items:center}
  .faq-item summary:focus-visible{outline:3px solid #e5b84a;outline-offset:3px}
  .faq-item p{margin:.3rem 0 .2rem;line-height:1.7;max-width:none;overflow-wrap:anywhere}
  @media(max-width:720px){
    .tool-hero{padding-top:1.5rem}
    .marks-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    .marks-table,.marks-table tbody,.marks-table tr,.marks-table td{display:block;width:100%}
    .marks-table tr{margin-bottom:1rem;border:1px solid rgba(255,255,255,.2);border-radius:12px;overflow:hidden}
    .marks-table td{border:0;border-bottom:1px solid rgba(255,255,255,.1)}
    .marks-table td::before{content:attr(data-label);display:block;margin-bottom:.15rem;font-size:.75rem;font-weight:700;color:#f3cf70}
  }
</style>
