---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import CareerCounsellingForm from '../../components/CareerCounsellingForm.astro';

const title = 'Career Counselling Form: Free Fillable PDF and IT Version';
const description = 'Fill in a career counselling form before your session, then download a PDF or print a blank copy. Has an IT career counselling form version. Private.';
const pageUrl = 'https://futurecareerschool.com/tools/career-counselling-form/';

const steps = [
  { title: 'Pick the version', text: 'Use the general form for school, college and most work situations. Switch to the IT / tech professional form if you work in or want to move within technology.' },
  { title: 'Write the decision first', text: 'Put one decision or question in the first box. Then fill the other boxes with a few lines each, and leave blank what you do not know yet.' },
  { title: 'Add up to three options', text: 'Name each option, pick a growth mark and write the main risk. If you are unsure of the mark, leave it as Not rated yet and ask the counsellor to rate it with you.' },
  { title: 'Download or print', text: 'Download your filled PDF, or a blank PDF to write by hand, or use the print buttons. Each copy ends with a blank session summary page to fill in during or after the session.' },
  { title: 'Take it to the session', text: 'Share the form with the counsellor before the session if they ask for it. Afterwards, write one next step with a date and a review date.' },
];

const faqs = [
  { q: 'What is a career counselling form?', a: 'A career counselling form is a set of written questions you answer before a counselling session. It helps you arrive with your decision, your current situation, your strengths, your limits, the evidence you have and the questions you want answered. It is your own preparation, not a test and not a counsellor report.' },
  { q: 'Is this career counselling form free, and is my information sent anywhere?', a: 'The form is free to use. Your answers stay in this browser, the PDF is built on your own device, and the form does not ask for your name or contact details. If you use a shared computer, press Clear my answers before you leave.' },
  { q: 'What changes in the IT career counselling form?', a: 'The IT career counselling form swaps the prompts for ones that suit technology work: your role and stack, work that is visibly strong, proof you can show, notice period, loans, savings runway and weekly learning time. The stage list and the example options also change. It is the same page and the same PDF, so you can switch back and keep your answers.' },
  { q: 'Can I use this as an invitation letter for career counselling?', a: 'The page writes a short booking note from your answers that you can copy and send to a counsellor to ask for a session. A school or college that is inviting a counsellor to speak at a programme needs a different letter, with the date, time, venue, audience, topic, duration and a named contact. This form does not write that letter.' },
  { q: 'Is there a career counselling report sample?', a: 'We do not show a sample counsellor report, because a real report depends on a real conversation and real evidence. Instead, the last page of the PDF is a blank session summary with the parts a useful written summary should hold: the real question, the evidence to collect, the options with a growth mark and a risk, one next step with a date, and a review date. Ask any counsellor what written summary you will receive.' },
  { q: 'Can I print a blank career counselling form?', a: 'Yes. Use Download blank form (PDF) or Print blank form. Both give ruled spaces under the same prompts as the version you have selected, plus the session summary page.' },
  { q: 'Do I have to fill every box?', a: 'No. Start with the decision and the evidence you can bring, then add what you can. A blank box is useful information for the counsellor, because it shows what you still need to find out.' },
  { q: 'Can I write in Hindi, Telugu or another language?', a: 'Yes, you can type in any language, and the PDF keeps Telugu and Hindi letters in their correct shapes by drawing those lines as pictures. That text cannot be selected or copied from the PDF, and a small font file loads only when you press the download button with it. Other scripts use the fonts on your device, so check the file or choose Print my form and then Save as PDF.' },
  { q: 'Will the form tell me which career to choose?', a: 'No. It does not score you or predict what suits you. It helps you and a counsellor spend the session on your real question, your evidence and your limits instead of starting from nothing.' },
  { q: 'I am a school student and my parents are involved. Which form should we use?', a: 'Use this form for your own preparation. For a conversation that separates the student question from the family concern, use the student and parent career intake.', link: { href: '/tools/student-parent-career-intake/', label: 'Open the student and parent career intake' } },
  { q: 'How is this different from the career decision journal?', a: 'This form gets you ready for one counselling session and ends with a PDF that has a blank summary page. The career decision journal comes later: it records one small experiment and a review date so you can test an option you have chosen.', link: { href: '/tools/career-decision-journal/', label: 'Open the career decision journal' } },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Career Counselling Form',
    description,
    url: pageUrl,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    provider: { '@type': ['Organization', 'ProfessionalService'], name: 'Future Career School', url: 'https://futurecareerschool.com' },
    inLanguage: 'en-IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} jsonLd={jsonLd}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote serviceBanner={true} />
  <main>
    <section class="tool-hero container">
      <p class="eyebrow">FREE FILLABLE FORM WITH PDF</p>
      <h1>Career Counselling Form <span>with PDF and printable blank</span></h1>
      <p class="lead">This career counselling form is a free worksheet you fill in on this page before a counselling session, then download as a PDF or print. It covers your decision, current stage, strengths, limits, questions and the evidence you can bring.</p>
      <p class="tool-limits"><b>Private by design:</b> the form runs in your browser. It does not ask for your name or contact details, and it does not upload your answers.</p>
    </section>
    <section class="container tool-shell" aria-label="Career counselling form">
      <CareerCounsellingForm />
    </section>

    <section class="container tool-steps">
      <h2>How to use the form</h2>
      <ol class="step-list">
        {steps.map((s) => <li><b>{s.title}.</b> {s.text}</li>)}
      </ol>
    </section>

    <section class="container tool-steps" id="it-career-counselling-form">
      <h2>The IT career counselling form</h2>
      <p>Switch to the IT / tech professional form inside the tool above. It is the same form with prompts written for people who work in technology, so you do not need a second download.</p>
      <ul class="step-list">
        <li>Stage choices run from student or fresher to senior lead, between jobs and moving into IT from another field.</li>
        <li>The prompts ask for your stack, work that is visibly strong, proof you can show without client secrets, notice period, loans, savings runway and weekly learning time.</li>
        <li>The example options table lists common IT routes, each with a Scalable, Scalable with a business layer or Not so scalable mark and its main risk.</li>
      </ul>
    </section>

    <section class="container tool-explainer">
      <h2>What the form does and does not do</h2>
      <div class="explainer-grid">
        <article><h3>It is preparation</h3><p>It helps you name one decision, gather your evidence and write your questions, so the session starts from your real situation. The marks on your options push you to judge each one for growth, not only for status.</p></article>
        <article><h3>It is not a test or a report</h3><p>It gives no score and does not say what suits you. It is not a counsellor report, and the session summary page is blank for you to fill in.</p></article>
        <article><h3>It does not replace official checks</h3><p>Confirm eligibility, fees, dates and registration rules on the official source before you act. Do not enter employer secrets, ID numbers, account numbers or private health details.</p></article>
      </div>
      <p class="explainer-links">Ready to talk it through with a counsellor? Read <a href="/blog/career-guidance/what-is-career-counselling/">what career counselling is and how it works</a>, or use the service link under the form.</p>
      <p class="explainer-links">Other worksheets do other jobs. The <a href="/tools/student-parent-career-intake/">student and parent career intake</a> is for a family talk, and the <a href="/tools/career-decision-journal/">career decision journal</a> is for testing one option after the session.</p>
    </section>

    <section class="container tool-faq" id="faq">
      <h2>Career counselling form: common questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item" open>
            <summary>{faq.q}</summary>
            <p>{faq.a}{faq.link && <> <a href={faq.link.href}>{faq.link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tool-hero{padding:2rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}
  .tool-steps{max-width:1050px;padding:1rem 1.25rem}.tool-steps h2{margin-top:0}.tool-steps p,.step-list li{line-height:1.7;max-width:820px}.step-list{padding-left:1.2rem}.step-list li{margin-bottom:.6rem}
  .tool-explainer{padding:2rem 1.25rem 2rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}.explainer-grid p,.explainer-links{line-height:1.65}.explainer-links a{color:#f3cf70;font-weight:700}
  .tool-faq{max-width:1050px;padding:1rem 1.25rem 5rem}.tool-faq h2{margin-top:0}.faq-list{display:grid;gap:.7rem}.faq-item{padding:.8rem 1rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.03)}.faq-item summary{cursor:pointer;font-weight:700;line-height:1.5;min-height:44px;display:flex;align-items:center}.faq-item p a{color:#f3cf70;font-weight:700}.faq-item p{margin:.3rem 0 .2rem;line-height:1.7;overflow-wrap:anywhere}
  @media(max-width:720px){.tool-hero{padding-top:1.5rem}.explainer-grid{grid-template-columns:1fr}}
</style>
