---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import SkillToServiceMapper from '../../components/SkillToServiceMapper.astro';

const title = 'Skill-to-Service Mapper | Test a Useful First Offer';
const description = 'Map a skill to a narrow audience, concrete deliverable, proof artifact and safe first service experiment.';
const canonical = 'https://futurecareerschool.com/tools/skill-to-service-mapper/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE WORK EXPERIMENT TOOL</p><h1>Skill-to-Service <span>Mapper</span></h1><p class="lead">Move from “I know this skill” to one small, testable way of helping someone.</p><p class="tool-limits"><b>Boundary:</b> this creates an offer hypothesis, not a client, income or outcome guarantee.</p></section>
    <section class="container tool-shell"><SkillToServiceMapper /></section>
    <section class="container tool-explainer"><h2>Build proof before making a promise</h2><div class="explainer-grid"><article><h3>Start narrow</h3><p>A specific audience and deliverable make feedback more useful than a broad “I can help with anything” offer.</p></article><article><h3>Protect information</h3><p>Use public, dummy or explicitly consented data, and keep sensitive work outside an experiment until access rules are clear.</p></article><article><h3>Test usefulness</h3><p>Observe whether the output solves a real problem; do not treat one positive reaction as proof of demand.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
