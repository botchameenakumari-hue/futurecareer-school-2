---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import CareerChangeRunwayCalculator from '../../components/CareerChangeRunwayCalculator.astro';

const title = 'Career Change Runway Calculator | Plan a Safer Transition';
const description = 'Estimate a career-change runway from savings, essential costs, reliable income and transition costs using your own assumptions.';
const canonical = 'https://futurecareerschool.com/tools/career-change-runway-calculator/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <BusinessPerspectiveNote />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE TRANSITION PLANNER</p><h1>Career Change <span>Runway Calculator</span></h1><p class="lead">Understand the financial gap before treating a career change as a leap.</p><p class="tool-limits"><b>Boundary:</b> this is a simple planning estimate, not financial advice or a recommendation to leave a job.</p></section>
    <section class="container tool-shell"><CareerChangeRunwayCalculator /></section>
    <section class="container tool-explainer"><h2>Use runway as a guardrail</h2><div class="explainer-grid"><article><h3>Use reliable income</h3><p>Exclude uncertain freelance, bonus or hoped-for future income from the safe case.</p></article><article><h3>Protect obligations</h3><p>Keep debt, taxes, healthcare, dependants and an emergency reserve visible.</p></article><article><h3>Test before escalating</h3><p>Build evidence through a project or conversation before making an irreversible move.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
