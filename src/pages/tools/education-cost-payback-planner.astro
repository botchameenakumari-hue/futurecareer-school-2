---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import EducationPaybackPlanner from '../../components/EducationPaybackPlanner.astro';
const title = 'Education Cost and Payback Planner | Future Career School';
const description = 'A private browser-based planner that separates direct education cost, opportunity cost and possible payback using your own figures.';
const canonical = 'https://futurecareerschool.com/tools/education-cost-payback-planner/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav /><main class="tool-page"><div class="tool-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Education payback planner</span></nav>
    <p class="eyebrow">PRIVATE BROWSER-BASED PLANNING TOOL</p><h1>What will this study route really cost?</h1>
    <p class="lead">Enter the numbers your family is actually considering. This planner separates tuition and living costs from the income you may give up while studying, then shows whether your own surplus assumption produces a payback period.</p>
    <EducationPaybackPlanner />
    <section class="tool-notes"><h2>Use it as a stress test</h2><p>Run the route three times: with your expected income, a lower starting income and a delayed start. Compare the result with a lower-cost course, a work-first route and the family’s emergency buffer.</p><p><a href="/blog/parents/how-much-to-spend-on-child-education-india/">Read the education-spend guide</a> · <a href="/blog/career-options/career-chart-after-12th/">Compare routes after 12th</a></p></section>
  </div></main><Footer />
</BaseLayout>
<style>
  .tool-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.tool-shell{max-width:1080px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.tool-notes a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.eyebrow{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.tool-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.lead{max-width:800px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.tool-notes{margin-top:2rem;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:16px;color:rgba(255,255,255,.75);line-height:1.7}.tool-notes h2{color:#fff}
</style>
