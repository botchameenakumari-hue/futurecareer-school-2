---
import CareerGuidanceBookletPage from '../../components/CareerGuidanceBookletPage.astro';
import BusinessPerspectiveNote from '../../components/BusinessPerspectiveNote.astro';
import { OFFICIAL } from '../../data/careerGuidanceBooklet.mjs';
import { PDF_FILES } from '../../config/careerChartAfter10th.mjs';

const title = 'Career Guidance After 10th PDF: Free Stream Booklet';
const description = 'Free career guidance after 10th PDF: tick what you enjoy, say if you need to earn soon, then download a stream, diploma and ITI booklet or a blank sheet.';
const pageUrl = 'https://futurecareerschool.com/tools/career-guidance-after-10th-pdf/';

const faqs = [
  {
    q: 'Is there a free career guidance after 10th PDF to download?',
    a: 'Yes. Tick what you enjoy, answer two questions about your situation, add your marks band, budget band and place, and the page builds a booklet you can download as a PDF with no sign-up. A blank worksheet PDF is on the page too.',
  },
  {
    q: 'What is in the career guidance booklet after 10th?',
    a: 'It holds a shortlist of routes that fit your answers, such as a science, commerce or arts group, a polytechnic diploma, an ITI trade, open schooling or a skill-first stack. Each route shows its subjects, what it opens, what it closes, its growth mark, its risk and a first move, followed by a worksheet, questions to ask and a 30-day plan.',
  },
  {
    q: 'Can the booklet tell me which stream to take?',
    a: 'No. It gives a first lean, not a verdict, using the same questions as the decision flow in our career chart after 10th. Test the route it points to with the checks in the booklet and with a teacher before you lock a subject group.',
  },
  {
    q: 'How is this different from the career chart after 10th and its PDFs?',
    a: 'The career chart is a reference with every route mapped and five fixed PDFs. The booklet is personal: you pick what you enjoy and your situation, and it builds a shortlist with a worksheet and a plan. Use the chart for the whole map and this booklet to start choosing.',
    link: { href: '/blog/stream-selection/career-chart-after-10th/', label: 'Open the career chart after 10th' },
  },
  {
    q: 'I do not know what I enjoy. What should I do?',
    a: 'Tick the one or two things you go back to when nobody is checking, even if you are unsure. You can also take the stream selector test first and then come back here with its result.',
    link: { href: '/services/assessments/stream-selector-test-after-10th/', label: 'Open the stream selector test after 10th' },
  },
  {
    q: 'My family needs me to earn within a few years. What changes?',
    a: 'The booklet adds the ITI trade and the polytechnic diploma to your list, because the chart shows them as the routes that reach work soonest. It also puts the skill-first stack beside them. Each still carries its risk, and a certificate alone is not proof of skill.',
  },
  {
    q: 'Does it only help me pick a stream?',
    a: 'No. The stream choice is one part. The booklet also covers a polytechnic diploma, an ITI trade, open schooling through NIOS and a skill-first stack that runs beside any route, because a stream is not the only way forward after Class 10.',
  },
  {
    q: 'What does my marks band change?',
    a: 'It removes no route and changes no order. It changes one check: with marks below 60 percent or not out yet, the booklet tells you to ask the school or institute what minimum it set last year, and with higher marks it asks whether a minimum in Maths and Science applies.',
  },
  {
    q: 'Is my information sent anywhere, and must I type a name?',
    a: 'Your answers stay in this browser and the PDF is made on your own device. The name box is optional and shows only on the cover. On a shared computer, press Clear my data before you leave.',
  },
  {
    q: 'Can my parents fill it in with me, or can I print a blank worksheet?',
    a: 'Yes to both. Use the blank worksheet for a family talk on paper, or build the booklet together and read the questions for parents. If you want the student view and the family view side by side, the student and parent career intake does that.',
    link: { href: '/tools/student-parent-career-intake/', label: 'Open the student and parent career intake' },
  },
  {
    q: 'Can I write my worry in Telugu or Hindi and still get a PDF?',
    a: 'Yes, the PDF keeps Telugu and Hindi letters in their correct shapes by drawing those lines as pictures. That text cannot be selected or copied from the PDF, and a small font file loads only when you press a PDF button with it. Other scripts use the fonts on your device, so check the file or choose Print and then Save as PDF.',
  },
];

const page = {
  stage: 'after10',
  title, description, pageUrl,
  appName: 'Career Guidance After 10th PDF Booklet Builder',
  breadcrumbLabel: 'Career guidance after 10th PDF',
  eyebrow: 'FREE STREAM AND ROUTE BOOKLET WITH PDF',
  h1: 'Career Guidance After 10th PDF',
  h1Span: 'free stream and route booklet',
  lead: [
    'This career guidance after 10th PDF is a free booklet you build on this page: tick what you enjoy, say whether your family needs you earning soon, and download a shortlist that compares streams, a polytechnic diploma, an ITI trade, open schooling and a skill-first route.',
    'Each route shows the subjects, what it opens and closes, its growth mark and its risk. A blank worksheet PDF is also here for paper, and every page prints in black and white.',
  ],
  serviceLink: { before: 'Want to talk it through with a counsellor? Read about', href: '/services/career-counselling-and-career-guidance/career-guidance-after-10th/', label: 'career guidance after 10th', after: '.' },
  stepsTitle: 'How to build your booklet',
  steps: [
    { h: 'Tick what pulls you', p: 'Choose up to three things you go back to when nobody is checking, such as Maths and Physics, Biology, business, people and design, or working with tools.' },
    { h: 'Answer two questions about your situation', p: 'Say whether your family needs you earning within about 1 to 3 years, and whether you can work through Maths for two more years.' },
    { h: 'Add marks, budget, place and priority', p: 'Pick the nearest band for each, and choose one priority. If your marks are not out, choose Not out yet.' },
    { h: 'Read each card', p: 'A card shows the subjects, what the route opens and closes, who it suits, the risk and a first move you can try this month.' },
    { h: 'Download or print', p: 'Download the booklet as a PDF or print it. Use the blank worksheet for a talk with your family on paper.' },
  ],
  insideTitle: 'What is inside the booklet',
  inside: [
    { h: 'Your shortlist', p: 'Up to five routes that fit your answers. Each shows its subjects, length, entry in the chart, what it opens and closes, its growth mark, the risk and a first move.' },
    { h: 'A skill layer beside any route', p: 'The skill-first stack gets its own card, because proof of work raises the ceiling of whichever route you pick.' },
    { h: 'Other routes to know about', p: 'A table of the remaining routes from the chart, each with its mark and entry rule, so you can see what you did not choose.' },
    { h: 'Subject and school worksheet', p: 'Ruled boxes for the fee, the years, the school or institute rule you checked, what worries you and your second plan.' },
    { h: 'Questions and a 30-day plan', p: 'Questions for parents, teachers and counsellors, then four blocks of steps described by what you finish.' },
    { h: 'Decision page', p: 'The route you choose for now, your second plan, one next step with a date and a review date.' },
  ],
  changesTitle: 'How your answers change the booklet',
  changesIntro: 'Your answers pick and order the routes. Routes that did not make your top five are still listed in a table.',
  changes: [
    { h: 'What pulls you', p: 'This follows the decision flow in our career chart after 10th. Maths and Physics points to PCM, Biology to PCB, both to PCMB, business to commerce, people and design to arts, tools to ITI, and machines and drawings to a diploma.' },
    { h: 'Earning soon', p: 'If your family needs you earning within about 1 to 3 years, ITI and diploma are added. If you cannot attend regular school, open schooling goes first.' },
    { h: 'Maths', p: 'It only affects commerce. Yes shows commerce with Maths, No shows commerce without Maths, and Not sure shows both.' },
    { h: 'Marks band', p: 'It removes nothing and changes no order. It changes the wording of one check about the minimum marks a school or institute sets.' },
    { h: 'Budget and place', p: 'Budget sets the money check illustration. Place adds a hostel or rent question when you may study away from home.' },
    { h: 'Priority and a route in mind', p: 'Priority sets the order: earn sooner uses the years to first work in the chart, growth uses the growth mark, and keep doors open uses how few doors a route closes. A route you pick goes first.' },
  ],
  marksTitle: 'Every route carries a growth mark and its risk',
  marksIntro: 'A stream is the first step of a long path, so each route in the booklet is marked Scalable, Scalable with a business layer or Not so scalable, with the risk beside it.',
  limitsTitle: 'What the booklet does not do',
  limits: [
    { h: 'It does not know your school', p: 'Which groups a school offers, its minimum marks and its seats change by school and year. Ask the school office and write the answer in the worksheet.' },
    { h: 'It is not a test or a counsellor', p: 'There is no score, and what you enjoy is not the same as what you are good at. It gives a first lean that you test with a small task and with people who know you.' },
    { h: 'Rules differ by state', p: 'Diploma and ITI entry, lateral entry and apprenticeship rules differ by state, board and year. The booklet points to the official site for each.' },
    { h: 'Typed text shows in the PDF', p: 'Your name and your worry line appear in the file. Do not type a phone number, email address, ID number or health detail.' },
  ],
  checks: {
    intro: 'Use these four questions and three proofs together on each route before you pay a fee or lock a subject group.',
    questions: [
      { h: 'Your fit', p: 'Which subject do you go back to when nobody is checking? Do one chapter, or one small job in a workshop, and see whether you want to keep going.' },
      { h: 'Your situation', p: 'Write what your family can spend, how soon you need to earn, and how far you can travel to school or an institute. The right route on paper can be wrong for now.' },
      { h: 'Job market', p: 'Look at what the work after this route asks for, using current job listings or by asking someone who does it. Write the site and the date.' },
      { h: 'AI-proof', p: 'Ask which tasks in this field a tool can already do. A subject or trade skill together with communication, digital fluency and judgement lasts longer than routine work.' },
    ],
    proofs: [
      { h: 'Show it', p: 'Before you lock a group, finish one small task that resembles it: a page of problems, a lab observation, a small budget for a shop, a drawing or a simple repair.' },
      { h: 'Say it', p: 'Explain in a minute to a parent why this route fits you, where it leads and what you will test next.' },
      { h: 'Get it checked', p: 'Show your worksheet to a teacher, a senior who took the route, or a person who does the work, and ask what you may be missing.' },
    ],
  },
  moneyLead: 'Fees for school groups, diploma and ITI seats differ widely, and the stream you pick sets up the fees of the degree that follows.',
  moneySafety: 'This is general information, not financial advice. Get every fee in writing, check that a diploma or technical institute is approved before you pay, and apply only on the official website.',
  chartBox: {
    h: 'Want the full map and its PDFs?',
    p: `Our career chart after 10th maps every route with a decision flow, the years to first work and ${PDF_FILES.length} fixed PDFs to download: all routes, science, commerce, arts, and diploma with ITI. This booklet builder is the personal version: it picks from the same routes for your answers.`,
    href: '/blog/stream-selection/career-chart-after-10th/',
    label: 'Open the career chart after 10th',
  },
  faqTitle: 'Career guidance after 10th PDF: common questions',
  faqs,
  sourcesIntro: 'Routes, entry rules, lengths and risks come from our career chart after 10th. The official sites below are where you confirm the rule for your own state, board and school.',
  sources: [
    { label: 'FutureCareerSchool career chart after 10th', url: 'https://futurecareerschool.com/blog/stream-selection/career-chart-after-10th/', supports: 'The routes, entry notes, lengths, what each route opens and closes, the decision flow and the growth marks used in the booklet. Last updated by us in October 2026.' },
    ...['nios', 'dgt', 'nats', 'aicte', 'nta', 'icai'].map((k) => OFFICIAL[k]),
  ],
  sourcesNote: 'Rules change. Where an official notice differs from the booklet, the notice is right. The booklet states no fees or pay figures.',
  related: [
    { href: '/services/assessments/stream-selector-test-after-10th/', label: 'Stream selector test after 10th', why: 'a short test to read before you rank routes.' },
    { href: '/services/assessments/confused-about-career-after-10th-test/', label: 'Confused about career after 10th test', why: 'for when none of the routes feels right yet.' },
    { href: '/tools/student-parent-career-intake/', label: 'Student and parent career intake', why: 'put the student view and the family view side by side.' },
    { href: '/blog/stream-selection/which-stream-to-choose-in-11th/', label: 'Which stream to choose in 11th', why: 'a longer read on the stream decision.' },
    { href: '/tools/course-cost-planner/', label: 'Course cost planner', why: 'add up the full cost of a course you shortlisted.' },
  ],
};
---

<CareerGuidanceBookletPage page={page}>
  <BusinessPerspectiveNote slot="note" serviceBanner={true} />
</CareerGuidanceBookletPage>
