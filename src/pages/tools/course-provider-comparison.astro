---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CourseProviderComparison from '../../components/CourseProviderComparison.astro';

const title = 'Course Provider Comparison | Verify a Course Before Paying';
const description = 'Compare recognition, total cost, practical work, feedback and outcome evidence before paying a course provider.';
const canonical = 'https://futurecareerschool.com/tools/course-provider-comparison/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav activePage="tools" />
  <main>
    <section class="tool-hero container"><p class="eyebrow">FREE DUE-DILIGENCE TOOL</p><h1>Course Provider <span>Comparison</span></h1><p class="lead">Ask the same questions of every provider before a deadline or sales call turns uncertainty into a payment.</p><p class="tool-limits"><b>Boundary:</b> this does not rank providers or verify their claims for you. Use current official sources and written answers.</p></section>
    <section class="container tool-shell"><CourseProviderComparison /></section>
    <section class="container tool-explainer"><h2>What to compare</h2><div class="explainer-grid"><article><h3>Recognition</h3><p>Check what the programme is formally recognised for and what progression or licence it actually supports.</p></article><article><h3>Learning evidence</h3><p>Ask what learners make, who reviews it, and whether feedback is specific enough to improve the work.</p></article><article><h3>Outcome claims</h3><p>Separate dated, comparable evidence from testimonials, guarantees and marketing language.</p></article></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .tool-hero{padding:5rem 1.25rem 2rem}.tool-hero h1{max-width:850px}.tool-hero h1 span{color:var(--gold,#e5b84a)}.lead{max-width:760px;font-size:1.15rem;line-height:1.7}.tool-limits{max-width:760px;font-size:.9rem;line-height:1.6;color:var(--muted,#b9c2c1)}.tool-shell{max-width:1050px}.tool-explainer{padding:2rem 1.25rem 5rem}.tool-explainer h2{margin-top:0}.explainer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.explainer-grid article{padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:14px}.explainer-grid h3{margin-top:0}@media(max-width:720px){.tool-hero{padding-top:3rem}.explainer-grid{grid-template-columns:1fr}}
</style>
