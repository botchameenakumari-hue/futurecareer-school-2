---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CourseEligibilityFinder from '../../components/CourseEligibilityFinder.astro';
const title = 'Course and Entrance Exam Finder After 12th | Future Career School';
const description = 'Filter broad after-12th course routes by stream, subjects and entrance exam, with dated official starting sources and clear eligibility limits.';
const canonical = 'https://futurecareerschool.com/tools/course-entrance-exam-finder/';
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Nav /><main class="tool-page"><div class="tool-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/career-resources/">Career resources</a><span aria-hidden="true">›</span><span aria-current="page">Course and entrance exam finder</span></nav>
    <p class="eyebrow">INTERACTIVE COURSE AND EXAM SCREENING TOOL</p><h1>Which courses and entrance exams fit your Class 12 subjects?</h1>
    <p class="lead">Choose your stream, subject combination and—if you already have one in mind—an entrance exam. The finder narrows the research list; it does not replace the current institute or counselling notice.</p>
    <CourseEligibilityFinder heading="Filter courses by stream, subjects and entrance exam" />
    <section class="tool-notes"><h2>Use this as a research shortlist</h2><p>Open the dated official source on every route that interests you. Eligibility can change by institute, state, category, age, marks and admission year.</p><p><a href="/tools/commerce-without-maths-course-finder/">Commerce without Maths</a> · <a href="/tools/mpc-pcm-course-finder/">MPC / PCM</a> · <a href="/tools/bipc-pcb-course-finder/">BiPC / PCB</a> · <a href="/blog/career-options/career-chart-after-12th/">Full after-12th chart</a></p></section>
  </div></main><Footer />
</BaseLayout>
<style>
  .tool-page{min-height:70vh;padding:4rem 1.2rem;background:radial-gradient(circle at 20% 0%,rgba(18,154,141,.12),transparent 35%),#080c18}.tool-shell{max-width:1080px;margin:0 auto}.breadcrumb{display:flex;gap:.55rem;flex-wrap:wrap;color:rgba(255,255,255,.55);font-size:.85rem;margin-bottom:2.5rem}.breadcrumb a,.tool-notes a{color:#8de4d8;text-decoration:underline;text-underline-offset:2px}.eyebrow{color:#e5b84a;font-size:.8rem;font-weight:800;letter-spacing:.12em}.tool-page h1{font-size:clamp(2rem,5vw,4rem);margin:.65rem 0 1rem;color:#fff}.lead{max-width:780px;font-size:1.15rem;line-height:1.7;color:rgba(255,255,255,.76)}.tool-notes{margin-top:2rem;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:16px;color:rgba(255,255,255,.75);line-height:1.7}.tool-notes h2{color:#fff}
</style>
